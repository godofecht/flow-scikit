# Kernel approximation for flow-scikit.
# Implements RBFSampler, Nystroem, AdditiveChi2Sampler.

import "lib/scikit/matrix.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function sqrt(x: f64) -> f64
    function exp(x: f64) -> f64
    function fabs(x: f64) -> f64
    function cos(x: f64) -> f64
    function sin(x: f64) -> f64
    function log(x: f64) -> f64
    function rand() -> i32
    function srand(seed: u32) -> void
    function printf(fmt: string, ...) -> i32
}

# ============================================================================
# RBFSampler
# ============================================================================

export struct RBFSampler {
    random_weights: ptr<ptr<f32> >,
    offset: ptr<f32>,
    gamma: f32,
    n_components: i32,
    n_features: i32,
    fitted: bool
}

export function rbf_sampler_fit(n_features: i32, gamma: f32, n_components: i32, seed: i32) -> RBFSampler {
    srand(seed)

    let weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        weights[c] = array_new_f32(n_features)
        for j in 0 to n_features {
            let r1: f32 = ((rand() % 10000) as f32) / 10000.0
            let r2: f32 = ((rand() % 10000) as f32) / 10000.0
            let u1: f32 = r1
            if u1 < 0.0000000001 { u1 = 0.0000000001 }
            let z: f32 = sqrt((-2.0 * log((u1) as f64)) as f64) as f32 * cos((6.28318 * r2) as f64) as f32
            weights[c][j] = z * sqrt((2.0 * gamma) as f64) as f32
        }
    }

    let offset: ptr<f32> = array_new_f32(n_components)
    for c in 0 to n_components {
        offset[c] = ((rand() % 10000) as f32) / 10000.0 * 6.28318
    }

    return RBFSampler {
        random_weights: weights,
        offset: offset,
        gamma: gamma,
        n_components: n_components,
        n_features: n_features,
        fitted: true
    }
}

export function rbf_sampler_transform(model: RBFSampler, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    let scale: f32 = sqrt((2.0 / (model.n_components as f32)) as f64) as f32

    for i in 0 to n {
        for c in 0 to model.n_components {
            let mut dot: f32 = 0.0
            for j in 0 to model.n_features {
                dot = dot + matrix_at(X, i, j) * model.random_weights[c][j]
            }
            matrix_set(result, i, c, scale * cos((dot + model.offset[c]) as f64) as f32)
        }
    }

    return result
}

export function rbf_sampler_free(model: RBFSampler) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.random_weights[c])
    }
    free(model.random_weights as ptr<void>)
    array_free_f32(model.offset)
}

# ============================================================================
# Nystroem
# ============================================================================

export struct Nystroem {
    components: Matrix,
    component_indices: ptr<i32>,
    n_components: i32,
    n_features: i32,
    gamma: f32,
    kernel: i32,
    eigenvectors: Matrix,
    eigvals: ptr<f32>,
    normalization: ptr<f32>,
    fitted: bool
}

export const KERNEL_RBF: i32 = 0
export const KERNEL_LINEAR: i32 = 1

function _kernel_func(x1: ptr<f32>, x2: ptr<f32>, n: i32, kernel: i32, gamma: f32) -> f32 {
    if kernel == KERNEL_LINEAR {
        let mut s: f32 = 0.0
        for i in 0 to n {
            s = s + x1[i] * x2[i]
        }
        return s
    }
    let mut s: f32 = 0.0
    for i in 0 to n {
        let d: f32 = x1[i] - x2[i]
        s = s + d * d
    }
    return exp((-gamma * s) as f64) as f32
}

export function nystroem_fit(X: Matrix, n_components: i32, gamma: f32, kernel: i32, seed: i32) -> Nystroem {
    let n: i32 = X.rows
    let p: i32 = X.cols

    srand(seed)

    let n_comp: i32 = n_components
    if n_comp > n { n_comp = n }

    let indices: ptr<i32> = malloc((n_comp as i64) * 4) as ptr<i32>
    for i in 0 to n_comp {
        indices[i] = rand() % n
    }

    let components: Matrix = matrix_new(n_comp, p)
    for i in 0 to n_comp {
        for j in 0 to p {
            matrix_set(components, i, j, matrix_at(X, indices[i], j))
        }
    }

    let K: Matrix = matrix_new(n_comp, n_comp)
    for i in 0 to n_comp {
        for j in 0 to n_comp {
            let xi: ptr<f32> = array_new_f32(p)
            let xj: ptr<f32> = array_new_f32(p)
            for k in 0 to p {
                xi[k] = matrix_at(components, i, k)
                xj[k] = matrix_at(components, j, k)
            }
            matrix_set(K, i, j, _kernel_func(xi, xj, p, kernel, gamma))
            array_free_f32(xi)
            array_free_f32(xj)
        }
    }

    # Eigendecomposition of K via power iteration with deflation.
    # K is symmetric (n_comp x n_comp). We extract the top n_comp
    # eigenvalue/eigenvector pairs. This replaces the previous incorrect
    # approach of using diagonal entries as eigenvalues.
    let eigvals: ptr<f32> = array_new_f32(n_comp)
    let eigenvectors: Matrix = matrix_new(n_comp, n_comp)

    let K_work: Matrix = matrix_copy(K)

    for c in 0 to n_comp {
        let v: ptr<f32> = array_new_f32(n_comp)
        for i in 0 to n_comp {
            v[i] = 1.0 / sqrt((n_comp as f64) as f32)
        }

        let mut iter: i32 = 0
        while iter < 200 {
            let new_v: ptr<f32> = array_new_f32(n_comp)
            for i in 0 to n_comp {
                let mut s: f32 = 0.0
                for j in 0 to n_comp {
                    s = s + matrix_at(K_work, i, j) * v[j]
                }
                new_v[i] = s
            }

            let norm: f32 = 0.0
            for i in 0 to n_comp {
                norm = norm + new_v[i] * new_v[i]
            }
            norm = sqrt((norm) as f64) as f32
            if norm < 0.0000000001 { norm = 1.0 }
            for i in 0 to n_comp {
                v[i] = new_v[i] / norm
            }
            array_free_f32(new_v)
            iter = iter + 1
        }

        # Rayleigh quotient for eigenvalue
        let tmp: ptr<f32> = array_new_f32(n_comp)
        for i in 0 to n_comp {
            let mut s: f32 = 0.0
            for j in 0 to n_comp {
                s = s + matrix_at(K_work, i, j) * v[j]
            }
            tmp[i] = s
        }
        let mut eigval: f32 = 0.0
        for i in 0 to n_comp {
            eigval = eigval + v[i] * tmp[i]
        }
        array_free_f32(tmp)

        if eigval < 0.0000000001 { eigval = 0.0000000001 }
        eigvals[c] = eigval
        for i in 0 to n_comp {
            matrix_set(eigenvectors, i, c, v[i])
        }

        # Deflate: K_work = K_work - eigval * v v^T
        for i in 0 to n_comp {
            for j in 0 to n_comp {
                let val: f32 = matrix_at(K_work, i, j) - eigval * v[i] * v[j]
                matrix_set(K_work, i, j, val)
            }
        }

        array_free_f32(v)
    }

    matrix_free(K_work)
    matrix_free(K)

    let normalization: ptr<f32> = array_new_f32(n_comp)
    for i in 0 to n_comp {
        normalization[i] = 1.0 / sqrt((eigvals[i]) as f64) as f32
    }

    return Nystroem {
        components: components,
        component_indices: indices,
        n_components: n_comp,
        n_features: p,
        gamma: gamma,
        kernel: kernel,
        eigenvectors: eigenvectors,
        eigvals: eigvals,
        normalization: normalization,
        fitted: true
    }
}

export function nystroem_transform(model: Nystroem, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)

    # For each sample, compute kernel against all components,
    # then project through eigenvectors and normalize by sqrt(eigval).
    for i in 0 to n {
        let xi: ptr<f32> = array_new_f32(model.n_features)
        for j in 0 to model.n_features {
            xi[j] = matrix_at(X, i, j)
        }

        # k_vec[j] = kernel(X_i, comp_j)
        let k_vec: ptr<f32> = array_new_f32(model.n_components)
        for j in 0 to model.n_components {
            let xc: ptr<f32> = array_new_f32(model.n_features)
            for k in 0 to model.n_features {
                xc[k] = matrix_at(model.components, j, k)
            }
            k_vec[j] = _kernel_func(xi, xc, model.n_features, model.kernel, model.gamma)
            array_free_f32(xc)
        }

        # result[i, c] = sum_j k_vec[j] * U[j, c] / sqrt(eigval_c)
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_components {
                s = s + k_vec[j] * matrix_at(model.eigenvectors, j, c)
            }
            matrix_set(result, i, c, s * model.normalization[c])
        }

        array_free_f32(k_vec)
        array_free_f32(xi)
    }

    return result
}

export function nystroem_free(model: Nystroem) -> void {
    matrix_free(model.components)
    matrix_free(model.eigenvectors)
    free(model.component_indices as ptr<void>)
    array_free_f32(model.eigvals)
    array_free_f32(model.normalization)
}

# ============================================================================
# AdditiveChi2Sampler
# ============================================================================

export struct AdditiveChi2Sampler {
    n_samples: i32,
    n_features: i32,
    sample_steps: i32,
    fitted: bool
}

export function additive_chi2_sampler_fit(n_samples: i32, n_features: i32, sample_steps: i32) -> AdditiveChi2Sampler {
    return AdditiveChi2Sampler {
        n_samples: n_samples,
        n_features: n_features,
        sample_steps: sample_steps,
        fitted: true
    }
}

export function additive_chi2_sampler_transform(model: AdditiveChi2Sampler, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let steps: i32 = model.sample_steps
    let n_out: i32 = p * steps
    let result: Matrix = matrix_new(n, n_out)

    # Frequencies depend only on the sample step, so compute them once instead
    # of for every row/feature. matrix_new is calloc-backed, so non-positive
    # inputs can simply leave their output span untouched at zero.
    let frequencies: ptr<f32> = array_new_f32(steps)
    let pi_val: f32 = 3.14159265358979
    let denom: f32 = 4.0 * (steps as f32)
    for k in 0 to steps {
        frequencies[k] = (4.0 * (k as f32) + 2.0) * pi_val / denom
    }

    for i in 0 to n {
        let input_base: i32 = i * p
        let output_base: i32 = i * n_out
        for j in 0 to p {
            let x: f32 = X.data[input_base + j]
            if x <= 0.0 { continue }

            let log_x: f32 = log((x) as f64) as f32
            let inv_sqrt_x: f32 = 1.0 / sqrt((x) as f64) as f32
            let feature_base: i32 = output_base + j * steps
            for k in 0 to steps {
                result.data[feature_base + k] = cos((frequencies[k] * log_x) as f64) as f32 * inv_sqrt_x
            }
        }
    }

    array_free_f32(frequencies)
    return result
}

export function additive_chi2_sampler_free(model: AdditiveChi2Sampler) -> void {
}

# ============================================================================
# SkewedChi2Sampler
# Approximates feature map of the "skewed chi-squared" kernel via Monte Carlo.
# ============================================================================

export struct SkewedChi2Sampler {
    random_weights: ptr<ptr<f32> >,
    offset: ptr<f32>,
    skewedness: f32,
    n_components: i32,
    n_features: i32,
    fitted: bool
}

export function skewed_chi2_sampler_fit(n_features: i32, skewedness: f32, n_components: i32, seed: i32) -> SkewedChi2Sampler {
    srand(seed)

    let weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let mut c: i32 = 0
    while c < n_components {
        weights[c] = array_new_f32(n_features)
        let mut j: i32 = 0
        while j < n_features {
            let r1: f32 = ((rand() % 10000) as f32) / 10000.0
            let r2: f32 = ((rand() % 10000) as f32) / 10000.0
            let u1: f32 = r1
            if u1 < 0.0000000001 { u1 = 0.0000000001 }
            let z: f32 = sqrt((-2.0 * log(u1 as f64)) as f64) as f32 * cos((6.28318 * r2) as f64) as f32
            weights[c][j] = z
            j = j + 1
        }
        c = c + 1
    }

    let offset: ptr<f32> = array_new_f32(n_components)
    c = 0
    while c < n_components {
        offset[c] = ((rand() % 10000) as f32) / 10000.0 * 6.28318
        c = c + 1
    }

    let result: SkewedChi2Sampler = SkewedChi2Sampler {
        random_weights: weights,
        offset: offset,
        skewedness: skewedness,
        n_components: n_components,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function skewed_chi2_sampler_transform(model: SkewedChi2Sampler, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    let scale: f32 = sqrt((2.0 / (model.n_components as f32)) as f64) as f32

    let mut i: i32 = 0
    while i < n {
        let mut c: i32 = 0
        while c < model.n_components {
            let mut dot: f32 = 0.0
            let mut j: i32 = 0
            while j < model.n_features {
                let x: f32 = matrix_at(X, i, j)
                let val: f32 = log((x + model.skewedness) as f64) as f32
                if x + model.skewedness > 0.0 {
                    dot = dot + val * model.random_weights[c][j]
                }
                j = j + 1
            }
            matrix_set(result, i, c, scale * cos((dot + model.offset[c]) as f64) as f32)
            c = c + 1
        }
        i = i + 1
    }
    return result
}

export function skewed_chi2_sampler_free(model: SkewedChi2Sampler) -> void {
    let mut c: i32 = 0
    while c < model.n_components {
        array_free_f32(model.random_weights[c])
        c = c + 1
    }
    free(model.random_weights as ptr<void>)
    array_free_f32(model.offset)
}