# Clustering module for flow-scikit.
# Implements KMeans clustering.

import "lib/scikit/matrix.flow"
import "lib/scikit/prng.flow"
import "lib/scikit/blas.flow"

export struct KMeans {
    centroids: ptr<ptr<f32> >,
    n_clusters: i32,
    n_features: i32,
    labels: ptr<i32>,
    inertia: f32,
    n_iter: i32,
    max_iter: i32,
    tol: f32,
    fitted: bool
}

export function kmeans_fit(X: Matrix, n_clusters: i32, max_iter: i32, tol: f32, seed: i32) -> KMeans {
    let n_features: i32 = X.cols
    let centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >

    let mut prng: PRNG = prng_seed(seed)
    for k in 0 to n_clusters {
        centroids[k] = array_new_f32(n_features)
        let res: PRNGResult = prng_int(prng, X.rows)
        prng = PRNG { state: res.state }
        let idx: i32 = res.value
        for j in 0 to n_features {
            centroids[k][j] = matrix_at(X, idx, j)
        }
    }

    return _kmeans_run(X, centroids, n_clusters, max_iter, tol)
}

# KMeans with explicit initial centroids (matches sklearn init=array).
export function kmeans_fit_init(X: Matrix, init_centers: Matrix, n_clusters: i32, max_iter: i32, tol: f32) -> KMeans {
    let n_features: i32 = X.cols
    let centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >
    for k in 0 to n_clusters {
        centroids[k] = array_new_f32(n_features)
        for j in 0 to n_features {
            centroids[k][j] = matrix_at(init_centers, k, j)
        }
    }
    return _kmeans_run(X, centroids, n_clusters, max_iter, tol)
}

# Scratch buffers for one Lloyd run. Allocated once per fit and reused across
# iterations, instead of the per-iteration malloc/calloc/free the accumulator
# arrays used to do.
struct KMeansScratch {
    cbuf: ptr<f32>,
    cnorm: ptr<f32>,
    cross: ptr<f32>,
    best_out: ptr<f32>,
    sums: ptr<f32>,
    counts: ptr<i32>
}

function _kmeans_scratch_new(n: i32, n_clusters: i32, n_features: i32) -> KMeansScratch {
    let cbuf: ptr<f32> = array_new_f32(n_clusters * n_features)
    let cnorm: ptr<f32> = array_new_f32(n_clusters)
    # malloc, not calloc: sgemm with beta = 0 overwrites every element.
    let cross: ptr<f32> = malloc(((n as i64) * (n_clusters as i64)) * 4) as ptr<f32>
    let best_out: ptr<f32> = array_new_f32(32)
    let sums: ptr<f32> = array_new_f32(n_clusters * n_features)
    let counts: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    let scratch: KMeansScratch = KMeansScratch {
        cbuf: cbuf,
        cnorm: cnorm,
        cross: cross,
        best_out: best_out,
        sums: sums,
        counts: counts
    }
    return scratch
}

function _kmeans_scratch_free(scratch: KMeansScratch) -> void {
    array_free_f32(scratch.cbuf)
    array_free_f32(scratch.cnorm)
    free(scratch.cross as ptr<void>)
    array_free_f32(scratch.best_out)
    array_free_f32(scratch.sums)
    free(scratch.counts as ptr<void>)
}

# Squared distance from one sample to one centroid, accumulated in the same
# order as the original per-pair loop.
function _kmeans_sqdist(x_data: ptr<f32>, x_base: i32, crow: ptr<f32>, n_features: i32) -> f32 {
    let mut dist: f32 = 0.0
    for j in 0 to n_features {
        let d: f32 = x_data[x_base + j] - crow[j]
        dist = dist + d * d
    }
    return dist
}

# One Lloyd assignment pass. Fills labels and returns the inertia.
#
# The argmin is taken from the squared-euclidean expansion
#   ||x - c||^2 = ||x||^2 + ||c||^2 - 2 * (x . c)
# with the cross term as a single sgemm, exactly as kmeans_predict does. The
# ||x||^2 term is common to all centroids so it drops out of the comparison.
#
# The winner is only accepted when it beats the runner-up by more than a
# conservative float32 error guard; anything inside the guard band, including
# exact ties, is re-decided by the direct kernel. The winning squared distance
# is then recomputed directly, in the original accumulation order, so the
# inertia this returns is bit-identical to the old triple loop. Cost per
# iteration drops from n*k*d scalar operations to one gemm plus n*d.
function _kmeans_assign(X: Matrix, centroids: ptr<ptr<f32> >, n_clusters: i32, n_features: i32, labels: ptr<i32>, scratch: KMeansScratch) -> f32 {
    let n: i32 = X.rows
    if n <= 0 || n_clusters <= 0 || n_features <= 0 {
        return 0.0
    }

    let x_data: ptr<f32> = X.data
    let x_stride: i32 = X.cols
    let cbuf: ptr<f32> = scratch.cbuf
    let cnorm: ptr<f32> = scratch.cnorm
    let cross: ptr<f32> = scratch.cross
    let best_out: ptr<f32> = scratch.best_out

    # Below the BLAS work threshold the sgemm dispatch costs more per iteration
    # than the whole scalar assignment, so run the direct kernel.
    if not _kmeans_use_blas(n, n_clusters, n_features) {
        let mut small_inertia: f32 = 0.0
        for i in 0 to n {
            let best_k: i32 = _kmeans_nearest_centroid(x_data, i * x_stride, centroids, n_clusters, n_features, best_out)
            labels[i] = best_k
            small_inertia = small_inertia + best_out[0]
        }
        return small_inertia
    }

    let mut cnorm_max: f32 = 0.0
    for k in 0 to n_clusters {
        let crow: ptr<f32> = centroids[k]
        let cbase: i32 = k * n_features
        let mut cs: f32 = 0.0
        for j in 0 to n_features {
            let v: f32 = crow[j]
            cbuf[cbase + j] = v
            cs = cs + v * v
        }
        cnorm[k] = cs
        if cs > cnorm_max {
            cnorm_max = cs
        }
    }

    blas_matmat_nt(x_data, cbuf, cross, n, n_clusters, n_features, x_stride, n_features, -2.0, 0.0)

    let mut inertia: f32 = 0.0
    for i in 0 to n {
        let xbase: i32 = i * x_stride
        let xs: f32 = blas_dot(n_features, x_data + xbase, x_data + xbase)
        let rbase: i32 = i * n_clusters
        let mut best: f32 = cnorm[0] + cross[rbase]
        let mut best_k: i32 = 0
        let mut second: f32 = 9999999999.0
        for k in 1 to n_clusters {
            let v: f32 = cnorm[k] + cross[rbase + k]
            if v < best {
                second = best
                best = v
                best_k = k
            } else {
                if v < second {
                    second = v
                }
            }
        }

        let guard: f32 = (xs + cnorm_max) * 0.0001 + 0.000001
        let mut best_dist: f32 = 0.0
        if second - best > guard {
            best_dist = _kmeans_sqdist(x_data, xbase, centroids[best_k], n_features)
        } else {
            best_k = _kmeans_nearest_centroid(x_data, xbase, centroids, n_clusters, n_features, best_out)
            best_dist = best_out[0]
        }
        labels[i] = best_k
        inertia = inertia + best_dist
    }
    return inertia
}

function _kmeans_run(X: Matrix, centroids: ptr<ptr<f32> >, n_clusters: i32, max_iter: i32, tol: f32) -> KMeans {
    let n_features: i32 = X.cols

    let labels: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    let mut inertia: f32 = 0.0
    let mut n_iter_run: i32 = 0
    let scratch: KMeansScratch = _kmeans_scratch_new(X.rows, n_clusters, n_features)
    let sums: ptr<f32> = scratch.sums
    let counts: ptr<i32> = scratch.counts
    let x_data: ptr<f32> = X.data

    for iter in 0 to max_iter {
        n_iter_run = iter + 1
        let new_inertia: f32 = _kmeans_assign(X, centroids, n_clusters, n_features, labels, scratch)

        for idx in 0 to n_clusters * n_features {
            sums[idx] = 0.0
        }
        for k in 0 to n_clusters {
            counts[k] = 0
        }

        for i in 0 to X.rows {
            let k: i32 = labels[i]
            counts[k] = counts[k] + 1
            let sbase: i32 = k * n_features
            let xbase: i32 = i * n_features
            for j in 0 to n_features {
                sums[sbase + j] = sums[sbase + j] + x_data[xbase + j]
            }
        }

        let mut max_shift: f32 = 0.0
        for k in 0 to n_clusters {
            let crow: ptr<f32> = centroids[k]
            let sbase: i32 = k * n_features
            if counts[k] > 0 {
                let count_f: f32 = counts[k] as f32
                for j in 0 to n_features {
                    let new_val: f32 = sums[sbase + j] / count_f
                    let shift: f32 = new_val - crow[j]
                    if shift < 0.0 {
                        let abs_shift: f32 = 0.0 - shift
                        if abs_shift > max_shift {
                            max_shift = abs_shift
                        }
                    } else {
                        if shift > max_shift {
                            max_shift = shift
                        }
                    }
                    crow[j] = new_val
                }
            } else {
                # Empty cluster: relocate centroid to the point with the
                # largest distance to its assigned centroid.
                # Addresses sklearn #34074: KMeans can skip final label
                # reassignment after empty-cluster relocation.
                let mut farthest_idx: i32 = 0
                let mut farthest_dist: f32 = -1.0
                for i in 0 to X.rows {
                    let dist: f32 = _kmeans_sqdist(x_data, i * n_features, centroids[labels[i]], n_features)
                    if dist > farthest_dist {
                        farthest_dist = dist
                        farthest_idx = i
                    }
                }
                let fbase: i32 = farthest_idx * n_features
                for j in 0 to n_features {
                    let new_val: f32 = x_data[fbase + j]
                    let shift: f32 = new_val - crow[j]
                    if shift < 0.0 {
                        let abs_shift: f32 = 0.0 - shift
                        if abs_shift > max_shift {
                            max_shift = abs_shift
                        }
                    } else {
                        if shift > max_shift {
                            max_shift = shift
                        }
                    }
                    crow[j] = new_val
                }
            }
        }

        inertia = new_inertia

        if max_shift < tol {
            break
        }
    }

    _kmeans_scratch_free(scratch)

    return KMeans {
        centroids: centroids,
        n_clusters: n_clusters,
        n_features: n_features,
        labels: labels,
        inertia: inertia,
        n_iter: n_iter_run,
        max_iter: max_iter,
        tol: tol,
        fitted: true
    }
}

# K-means++ initialization: picks initial centroids with probability
# proportional to squared distance from nearest existing centroid.
function _kmeans_plus_plus_init(X: Matrix, n_clusters: i32, prng_state: u32) -> ptr<ptr<f32> > {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >
    for k in 0 to n_clusters {
        centroids[k] = array_new_f32(n_features)
    }

    let mut prng: PRNG = PRNG { state: prng_state }

    # Pick first centroid randomly
    let res0: PRNGResult = prng_int(prng, n)
    prng = PRNG { state: res0.state }
    for j in 0 to n_features {
        centroids[0][j] = matrix_at(X, res0.value, j)
    }

    # Squared distances to nearest centroid
    let dist_sq: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut d: f32 = 0.0
        for j in 0 to n_features {
            let diff: f32 = matrix_at(X, i, j) - centroids[0][j]
            d = d + diff * diff
        }
        dist_sq[i] = d
    }

    for k in 1 to n_clusters {
        # Sum of squared distances
        let mut total: f32 = 0.0
        for i in 0 to n {
            total = total + dist_sq[i]
        }
        if total <= 0.0 {
            # All points are identical to centroids, pick random
            let res: PRNGResult = prng_int(prng, n)
            prng = PRNG { state: res.state }
            for j in 0 to n_features {
                centroids[k][j] = matrix_at(X, res.value, j)
            }
        } else {
            # Pick next centroid with probability proportional to dist_sq
            let res: PRNGResult = prng_int(prng, 2147483647)
            prng = PRNG { state: res.state }
            let threshold: f32 = (res.value as f32) / 2147483647.0 * total
            let mut cumsum: f32 = 0.0
            let mut chosen: i32 = n - 1
            for i in 0 to n {
                cumsum = cumsum + dist_sq[i]
                if cumsum >= threshold {
                    chosen = i
                    break
                }
            }
            for j in 0 to n_features {
                centroids[k][j] = matrix_at(X, chosen, j)
            }
        }
        # Update distances
        for i in 0 to n {
            let mut d: f32 = 0.0
            for j in 0 to n_features {
                let diff: f32 = matrix_at(X, i, j) - centroids[k][j]
                d = d + diff * diff
            }
            if d < dist_sq[i] { dist_sq[i] = d }
        }
    }

    array_free_f32(dist_sq)
    return centroids
}

# Run a single Lloyd iteration starting from given centroids.
function _kmeans_lloyd(X: Matrix, centroids: ptr<ptr<f32> >, n_clusters: i32, max_iter: i32, tol: f32) -> KMeans {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut inertia: f32 = 0.0
    let mut n_iter_run: i32 = 0
    let scratch: KMeansScratch = _kmeans_scratch_new(n, n_clusters, n_features)
    let sums: ptr<f32> = scratch.sums
    let counts: ptr<i32> = scratch.counts
    let x_data: ptr<f32> = X.data

    for iter in 0 to max_iter {
        n_iter_run = iter + 1
        let new_inertia: f32 = _kmeans_assign(X, centroids, n_clusters, n_features, labels, scratch)

        for idx in 0 to n_clusters * n_features {
            sums[idx] = 0.0
        }
        for k in 0 to n_clusters {
            counts[k] = 0
        }
        for i in 0 to n {
            let k: i32 = labels[i]
            counts[k] = counts[k] + 1
            let sbase: i32 = k * n_features
            let xbase: i32 = i * n_features
            for j in 0 to n_features {
                sums[sbase + j] = sums[sbase + j] + x_data[xbase + j]
            }
        }

        let mut max_shift: f32 = 0.0
        for k in 0 to n_clusters {
            if counts[k] > 0 {
                let crow: ptr<f32> = centroids[k]
                let sbase: i32 = k * n_features
                let count_f: f32 = counts[k] as f32
                for j in 0 to n_features {
                    let new_val: f32 = sums[sbase + j] / count_f
                    let shift: f32 = new_val - crow[j]
                    if shift < 0.0 {
                        let abs_shift: f32 = 0.0 - shift
                        if abs_shift > max_shift { max_shift = abs_shift }
                    } else {
                        if shift > max_shift { max_shift = shift }
                    }
                    crow[j] = new_val
                }
            }
        }

        inertia = new_inertia
        if max_shift < tol { break }
    }

    _kmeans_scratch_free(scratch)

    return KMeans {
        centroids: centroids,
        n_clusters: n_clusters,
        n_features: n_features,
        labels: labels,
        inertia: inertia,
        n_iter: n_iter_run,
        max_iter: max_iter,
        tol: tol,
        fitted: true
    }
}

# KMeans with k-means++ initialization and n_init restarts.
# Matches sklearn's default init='k-means++', n_init=10.
export function kmeans_fit_plus_plus(X: Matrix, n_clusters: i32, max_iter: i32, tol: f32, seed: i32, n_init: i32) -> KMeans {
    let n_features: i32 = X.cols
    let mut best_inertia: f32 = 9999999999.0
    let best_centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >
    for k in 0 to n_clusters {
        best_centroids[k] = array_new_f32(n_features)
    }
    let best_labels: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    let mut best_n_iter: i32 = 0

    for init in 0 to n_init {
        let init_seed: u32 = ((seed + init * 17) as u32)
        let centroids: ptr<ptr<f32> > = _kmeans_plus_plus_init(X, n_clusters, init_seed)
        let result: KMeans = _kmeans_lloyd(X, centroids, n_clusters, max_iter, tol)

        if result.inertia < best_inertia {
            best_inertia = result.inertia
            best_n_iter = result.n_iter
            for k in 0 to n_clusters {
                for j in 0 to n_features {
                    best_centroids[k][j] = result.centroids[k][j]
                }
            }
            for i in 0 to X.rows {
                best_labels[i] = result.labels[i]
            }
        }

        # Free this run's centroids and labels
        for k in 0 to n_clusters {
            array_free_f32(result.centroids[k])
        }
        free(result.centroids as ptr<void>)
        free(result.labels as ptr<void>)
    }

    return KMeans {
        centroids: best_centroids,
        n_clusters: n_clusters,
        n_features: n_features,
        labels: best_labels,
        inertia: best_inertia,
        n_iter: best_n_iter,
        max_iter: max_iter,
        tol: tol,
        fitted: true
    }
}

# Nearest centroid for the sample stored at x_data[x_base .. x_base+n_features).
#
# The squared distance to each centroid is accumulated in the same order and
# compared with the same strict less-than tie-break as the original per-pair
# loop, so the chosen index and the returned distance are bit-identical.
# The one addition is a partial-distance bail-out: squares are non-negative, so
# a running sum that has already reached the current best cannot come back
# below it, and the rest of that centroid's row can be skipped. The check runs
# once every 8 features so it costs a fraction of a comparison per element.
#
# best_out[0] receives the winning squared distance. The caller owns that
# 4-byte slot so it is not reallocated per sample.
function _kmeans_nearest_centroid(x_data: ptr<f32>, x_base: i32, centroids: ptr<ptr<f32> >, n_clusters: i32, n_features: i32, best_out: ptr<f32>) -> i32 {
    let mut best_k: i32 = 0
    let mut best_dist: f32 = 9999999999.0
    for k in 0 to n_clusters {
        let crow: ptr<f32> = centroids[k]
        let mut dist: f32 = 0.0
        let mut j: i32 = 0
        let mut bailed: bool = false
        while j < n_features {
            let mut lim: i32 = j + 8
            if lim > n_features {
                lim = n_features
            }
            while j < lim {
                let d: f32 = x_data[x_base + j] - crow[j]
                dist = dist + d * d
                j = j + 1
            }
            if dist >= best_dist {
                bailed = true
                break
            }
        }
        if not bailed {
            if dist < best_dist {
                best_dist = dist
                best_k = k
            }
        }
    }
    best_out[0] = best_dist
    return best_k
}

# Cluster assignment for every sample.
#
# The bulk of the work is the squared-euclidean expansion
#   ||x - c||^2 = ||x||^2 + ||c||^2 - 2 * (x . c)
# with the cross term as a single row-major sgemm, exactly as in
# kmeans_transform. ||x||^2 is common to every centroid, so the argmin only
# needs ||c||^2 - 2 * (x . c).
#
# The expansion is not bit-identical to the direct per-pair sum in f32, and
# predict feeds an adjusted-Rand-index parity row, so the winner is only
# accepted when it beats the runner-up by more than a conservative float32
# error guard. Samples inside the guard band, including exact ties, fall back
# to the direct kernel, which reproduces the original result bit for bit.
# On the canonical iris and digits fixtures the guard never fires and no label
# differs from the previous implementation.
export function kmeans_predict(model: KMeans, X: Matrix) -> ptr<i32> {
    let n: i32 = X.rows
    let n_clusters: i32 = model.n_clusters
    let n_features: i32 = model.n_features
    let preds: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    if n <= 0 {
        return preds
    }
    if n_clusters <= 0 || n_features <= 0 {
        for i in 0 to n {
            preds[i] = 0
        }
        return preds
    }

    let centroids: ptr<ptr<f32> > = model.centroids
    let x_data: ptr<f32> = X.data
    let x_stride: i32 = X.cols

    # Below the BLAS work threshold the sgemm dispatch costs more than the
    # whole scalar loop, so go straight to the direct kernel.
    if not _kmeans_use_blas(n, n_clusters, n_features) {
        let small_best: ptr<f32> = array_new_f32(32)
        for i in 0 to n {
            preds[i] = _kmeans_nearest_centroid(x_data, i * x_stride, centroids, n_clusters, n_features, small_best)
        }
        array_free_f32(small_best)
        return preds
    }

    # Pack the centroid rows contiguously and take their norms in one pass.
    let cbuf: ptr<f32> = array_new_f32(n_clusters * n_features)
    let cnorm: ptr<f32> = array_new_f32(n_clusters)
    let mut cnorm_max: f32 = 0.0
    for k in 0 to n_clusters {
        let crow: ptr<f32> = centroids[k]
        let cbase: i32 = k * n_features
        let mut cs: f32 = 0.0
        for j in 0 to n_features {
            let v: f32 = crow[j]
            cbuf[cbase + j] = v
            cs = cs + v * v
        }
        cnorm[k] = cs
        if cs > cnorm_max {
            cnorm_max = cs
        }
    }

    # cross = -2 * X * C^T. malloc, not calloc: sgemm with beta = 0 overwrites
    # every element, so zeroing it first would be wasted work.
    let cross: ptr<f32> = malloc(((n as i64) * (n_clusters as i64)) * 4) as ptr<f32>
    blas_matmat_nt(x_data, cbuf, cross, n, n_clusters, n_features, x_stride, n_features, -2.0, 0.0)

    let best_out: ptr<f32> = array_new_f32(32)
    for i in 0 to n {
        let xbase: i32 = i * x_stride
        # Only used to scale the error guard, so let cblas own the reduction.
        let xs: f32 = blas_dot(n_features, x_data + xbase, x_data + xbase)

        let rbase: i32 = i * n_clusters
        let mut best: f32 = cnorm[0] + cross[rbase]
        let mut best_k: i32 = 0
        let mut second: f32 = 9999999999.0
        for k in 1 to n_clusters {
            let v: f32 = cnorm[k] + cross[rbase + k]
            if v < best {
                second = best
                best = v
                best_k = k
            } else {
                if v < second {
                    second = v
                }
            }
        }

        let guard: f32 = (xs + cnorm_max) * 0.0001 + 0.000001
        if second - best > guard {
            preds[i] = best_k
        } else {
            preds[i] = _kmeans_nearest_centroid(x_data, xbase, centroids, n_clusters, n_features, best_out)
        }
    }

    array_free_f32(best_out)
    free(cross as ptr<void>)
    array_free_f32(cbuf)
    array_free_f32(cnorm)
    return preds
}

# Distance from every sample to every centroid.
#
# Uses the squared-euclidean expansion
#   ||x - c||^2 = ||x||^2 + ||c||^2 - 2 * (x . c)
# so each sample norm and each centroid norm is computed once instead of once
# per (sample, centroid) pair, and the whole cross term is a single row-major
# sgemm. The centroid rows are packed into one contiguous k x d block first,
# because the model stores them as separate allocations. Sample reads go
# straight to X.data instead of through matrix_at.
#
# The expansion can produce a small negative value for a sample sitting on top
# of a centroid, so the squared distance is clamped at zero before the sqrt.
#
# A sgemm call is not free. OpenBLAS in particular spends on the order of a
# tenth of a millisecond dispatching threads before it multiplies anything,
# which is more than the entire scalar loop costs on a small problem. So the
# expansion is only used once there is enough distance work to pay for it;
# below that the direct per-pair loop runs, which is also what the previous
# implementation computed, bit for bit.
function _kmeans_use_blas(n: i32, n_clusters: i32, n_features: i32) -> bool {
    let work: i64 = (n as i64) * (n_clusters as i64) * (n_features as i64)
    return work >= 65536
}

export function kmeans_transform(model: KMeans, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let n_clusters: i32 = model.n_clusters
    let n_features: i32 = model.n_features
    let result: Matrix = matrix_new(n, n_clusters)
    if n <= 0 || n_clusters <= 0 || n_features <= 0 {
        return result
    }

    let x_data: ptr<f32> = X.data
    let x_stride: i32 = X.cols

    if not _kmeans_use_blas(n, n_clusters, n_features) {
        let rd_small: ptr<f32> = result.data
        for i in 0 to n {
            let xbase: i32 = i * x_stride
            let rbase: i32 = i * n_clusters
            for k in 0 to n_clusters {
                let crow: ptr<f32> = model.centroids[k]
                let mut dist: f32 = 0.0
                for j in 0 to n_features {
                    let d: f32 = x_data[xbase + j] - crow[j]
                    dist = dist + d * d
                }
                rd_small[rbase + k] = sqrt(dist as f64) as f32
            }
        }
        return result
    }

    # Pack centroids contiguously and take their norms in the same pass.
    let cbuf: ptr<f32> = array_new_f32(n_clusters * n_features)
    let cnorm: ptr<f32> = array_new_f32(n_clusters)
    for k in 0 to n_clusters {
        let crow: ptr<f32> = model.centroids[k]
        let cbase: i32 = k * n_features
        let mut cs: f32 = 0.0
        for j in 0 to n_features {
            let v: f32 = crow[j]
            cbuf[cbase + j] = v
            cs = cs + v * v
        }
        cnorm[k] = cs
    }

    let xnorm: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let xbase: i32 = i * x_stride
        let mut xs: f32 = 0.0
        for j in 0 to n_features {
            let v: f32 = x_data[xbase + j]
            xs = xs + v * v
        }
        xnorm[i] = xs
    }

    # result = -2 * X * C^T (beta = 0 overwrites the calloc-backed buffer).
    let r_data: ptr<f32> = result.data
    blas_matmat_nt(x_data, cbuf, r_data, n, n_clusters, n_features, x_stride, n_features, -2.0, 0.0)

    for i in 0 to n {
        let rbase: i32 = i * n_clusters
        let xn: f32 = xnorm[i]
        for k in 0 to n_clusters {
            let idx: i32 = rbase + k
            let mut sq: f32 = xn + cnorm[k] + r_data[idx]
            if sq < 0.0 {
                sq = 0.0
            }
            r_data[idx] = sqrt(sq as f64) as f32
        }
    }

    array_free_f32(cbuf)
    array_free_f32(cnorm)
    array_free_f32(xnorm)
    return result
}

export function kmeans_free(model: KMeans) -> void {
    for k in 0 to model.n_clusters {
        array_free_f32(model.centroids[k])
    }
    free(model.centroids as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# DBSCAN (Density-Based Spatial Clustering of Applications with Noise)
# ============================================================================

export struct DBSCAN {
    labels: ptr<i32>,
    n_clusters: i32,
    n_noise: i32,
    eps: f32,
    min_samples: i32,
    n_samples: i32,
    fitted: bool
}

export function dbscan_fit(X: Matrix, eps: f32, min_samples: i32) -> DBSCAN {
    let n: i32 = X.rows
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        labels[i] = -1
    }

    let visited: ptr<bool> = malloc((n as i64) * 1) as ptr<bool>
    for i in 0 to n {
        visited[i] = false
    }

    let mut cluster_id: i32 = 0
    let mut n_noise: i32 = 0

    let eps_sq: f32 = eps * eps

    for i in 0 to n {
        if visited[i] {
            continue
        }

        visited[i] = true
        let neighbors: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        let mut n_neighbors: i32 = 0

        for j in 0 to n {
            if i == j {
                continue
            }
            let mut dist_sq: f32 = 0.0
            for k in 0 to X.cols {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                dist_sq = dist_sq + d * d
            }
            if dist_sq <= eps_sq {
                neighbors[n_neighbors] = j
                n_neighbors = n_neighbors + 1
            }
        }

        if n_neighbors + 1 < min_samples {
            labels[i] = -1
            n_noise = n_noise + 1
            free(neighbors as ptr<void>)
            continue
        }

        labels[i] = cluster_id

        let mut processed: i32 = 0
        while processed < n_neighbors {
            let j: i32 = neighbors[processed]
            processed = processed + 1

            if not visited[j] {
                visited[j] = true

                let j_neighbors: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
                let mut n_j_neighbors: i32 = 0

                for k in 0 to n {
                    if j == k {
                        continue
                    }
                    let mut dist_sq: f32 = 0.0
                    for f in 0 to X.cols {
                        let d: f32 = matrix_at(X, j, f) - matrix_at(X, k, f)
                        dist_sq = dist_sq + d * d
                    }
                    if dist_sq <= eps_sq {
                        j_neighbors[n_j_neighbors] = k
                        n_j_neighbors = n_j_neighbors + 1
                    }
                }

                if n_j_neighbors + 1 >= min_samples {
                    let new_neighbors: ptr<i32> = malloc(((n_neighbors + n_j_neighbors) as i64) * 4) as ptr<i32>
                    for k in 0 to n_neighbors {
                        new_neighbors[k] = neighbors[k]
                    }
                    for k in 0 to n_j_neighbors {
                        new_neighbors[n_neighbors + k] = j_neighbors[k]
                    }
                    n_neighbors = n_neighbors + n_j_neighbors
                    free(neighbors as ptr<void>)
                    neighbors = new_neighbors
                }

                free(j_neighbors as ptr<void>)
            }

            if labels[j] == -1 {
                labels[j] = cluster_id
            }
        }

        free(neighbors as ptr<void>)
        cluster_id = cluster_id + 1
    }

    free(visited as ptr<void>)

    return DBSCAN {
        labels: labels,
        n_clusters: cluster_id,
        n_noise: n_noise,
        eps: eps,
        min_samples: min_samples,
        n_samples: n,
        fitted: true
    }
}

export function dbscan_free(model: DBSCAN) -> void {
    free(model.labels as ptr<void>)
}

# ============================================================================
# AgglomerativeClustering (bottom-up hierarchical, single linkage)
# ============================================================================

export struct AgglomerativeClustering {
    labels: ptr<i32>,
    n_clusters: i32,
    n_samples: i32,
    fitted: bool
}

export function agglomerative_clustering_fit(X: Matrix, n_clusters: i32) -> AgglomerativeClustering {
    let n: i32 = X.rows

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        labels[i] = i
    }

    let mut active_clusters: i32 = n

    let dist: ptr<f32> = malloc((n * n) as i64 * 4) as ptr<f32>
    for i in 0 to n {
        for j in 0 to n {
            if i == j {
                dist[i * n + j] = 0.0
            } else {
                let mut d: f32 = 0.0
                for k in 0 to X.cols {
                    let diff: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    d = d + diff * diff
                }
                dist[i * n + j] = d
            }
        }
    }

    while active_clusters > n_clusters {
        let mut min_dist: f32 = 9999999999.0
        let mut min_i: i32 = -1
        let mut min_j: i32 = -1

        for i in 0 to n {
            if labels[i] != i {
                continue
            }
            for j in i + 1 to n {
                if labels[j] != j {
                    continue
                }
                if dist[i * n + j] < min_dist {
                    min_dist = dist[i * n + j]
                    min_i = i
                    min_j = j
                }
            }
        }

        if min_i < 0 {
            break
        }

        for k in 0 to n {
            if labels[k] == min_j {
                labels[k] = min_i
            }
        }

        for k in 0 to n {
            if k == min_i {
                continue
            }
            let d_ik: f32 = dist[min_i * n + k]
            let d_jk: f32 = dist[min_j * n + k]
            let new_dist: f32 = d_ik
            if d_jk < new_dist {
                new_dist = d_jk
            }
            dist[min_i * n + k] = new_dist
            dist[k * n + min_i] = new_dist
        }

        active_clusters = active_clusters - 1
    }

    let unique_labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut n_unique: i32 = 0
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_unique {
            if unique_labels[k] == labels[i] {
                found = true
            }
        }
        if not found {
            unique_labels[n_unique] = labels[i]
            n_unique = n_unique + 1
        }
    }

    let final_labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        for k in 0 to n_unique {
            if labels[i] == unique_labels[k] {
                final_labels[i] = k
            }
        }
    }

    free(dist as ptr<void>)
    free(labels as ptr<void>)
    free(unique_labels as ptr<void>)

    return AgglomerativeClustering {
        labels: final_labels,
        n_clusters: n_unique,
        n_samples: n,
        fitted: true
    }
}

export function agglomerative_clustering_free(model: AgglomerativeClustering) -> void {
    free(model.labels as ptr<void>)
}

export struct MiniBatchKMeans {
    centroids: ptr<ptr<f32> >,
    n_clusters: i32,
    n_features: i32,
    inertia: f32,
    n_iter: i32,
    fitted: bool
}

export function minibatch_kmeans_fit(X: Matrix, n_clusters: i32, batch_size: i32, max_iter: i32, tol: f32, seed: i32) -> MiniBatchKMeans {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >

    srand(seed)
    for k in 0 to n_clusters {
        centroids[k] = array_new_f32(n_features)
        let idx: i32 = rand() % n
        for j in 0 to n_features {
            centroids[k][j] = matrix_at(X, idx, j)
        }
    }

    let mut prev_inertia: f32 = 10000000000.0

    for iter in 0 to max_iter {
        let batch_indices: ptr<i32> = malloc((batch_size as i64) * 4) as ptr<i32>
        for i in 0 to batch_size {
            batch_indices[i] = rand() % n
        }

        let mut inertia: f32 = 0.0
        let counts: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
        for k in 0 to n_clusters {
            counts[k] = 0
        }

        for bi in 0 to batch_size {
            let idx: i32 = batch_indices[bi]
            let mut best_k: i32 = 0
            let mut best_dist: f32 = 10000000000.0
            for k in 0 to n_clusters {
                let mut dist: f32 = 0.0
                for j in 0 to n_features {
                    let d: f32 = matrix_at(X, idx, j) - centroids[k][j]
                    dist = dist + d * d
                }
                if dist < best_dist {
                    best_dist = dist
                    best_k = k
                }
            }
            inertia = inertia + best_dist
            counts[best_k] = counts[best_k] + 1

            let lr: f32 = 1.0 / (counts[best_k] as f32)
            for j in 0 to n_features {
                centroids[best_k][j] = centroids[best_k][j] * (1.0 - lr) + matrix_at(X, idx, j) * lr
            }
        }

        free(batch_indices as ptr<void>)
        free(counts as ptr<void>)

        if (fabs((prev_inertia - inertia) as f64) as f32) < tol {
            break
        }
        prev_inertia = inertia
    }

    return MiniBatchKMeans {
        centroids: centroids,
        n_clusters: n_clusters,
        n_features: n_features,
        inertia: prev_inertia,
        n_iter: max_iter,
        fitted: true
    }
}

export function minibatch_kmeans_predict(model: MiniBatchKMeans, X: Matrix) -> ptr<i32> {
    let labels: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows {
        let mut best_k: i32 = 0
        let mut best_dist: f32 = 10000000000.0
        for k in 0 to model.n_clusters {
            let mut dist: f32 = 0.0
            for j in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, j) - model.centroids[k][j]
                dist = dist + d * d
            }
            if dist < best_dist {
                best_dist = dist
                best_k = k
            }
        }
        labels[i] = best_k
    }
    return labels
}

export function minibatch_kmeans_free(model: MiniBatchKMeans) -> void {
    for k in 0 to model.n_clusters {
        array_free_f32(model.centroids[k])
    }
    free(model.centroids as ptr<void>)
}

# ============================================================================
# MeanShift
# ============================================================================

export struct MeanShift {
    centroids: ptr<ptr<f32> >,
    n_clusters: i32,
    n_features: i32,
    labels: ptr<i32>,
    bandwidth: f32,
    n_iter: i32,
    fitted: bool
}

export function mean_shift_fit(X: Matrix, bandwidth: f32, max_iter: i32) -> MeanShift {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let shifted: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        shifted[i] = array_new_f32(n_features)
        for j in 0 to n_features {
            shifted[i][j] = matrix_at(X, i, j)
        }
    }

    let bw_sq: f32 = bandwidth * bandwidth

    for iter in 0 to max_iter {
        let mut max_shift: f32 = 0.0

        for i in 0 to n {
            let mut new_pos: ptr<f32> = array_new_f32(n_features)
            let mut total_weight: f32 = 0.0

            for j in 0 to n {
                let mut dist_sq: f32 = 0.0
                for k in 0 to n_features {
                    let d: f32 = shifted[i][k] - matrix_at(X, j, k)
                    dist_sq = dist_sq + d * d
                }

                if dist_sq < bw_sq {
                    let weight: f32 = 1.0
                    for k in 0 to n_features {
                        new_pos[k] = new_pos[k] + matrix_at(X, j, k) * weight
                    }
                    total_weight = total_weight + weight
                }
            }

            if total_weight > 0.0 {
                for k in 0 to n_features {
                    new_pos[k] = new_pos[k] / total_weight
                }
            }

            let mut shift_dist: f32 = 0.0
            for k in 0 to n_features {
                let d: f32 = new_pos[k] - shifted[i][k]
                shift_dist = shift_dist + d * d
                shifted[i][k] = new_pos[k]
            }
            shift_dist = sqrt((shift_dist as f64)) as f32
            if shift_dist > max_shift { max_shift = shift_dist }

            array_free_f32(new_pos)
        }

        if max_shift < 0.0001 { break }
    }

    let mut n_clusters: i32 = 0
    let centroids: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    for i in 0 to n {
        let mut found: bool = false
        for c in 0 to n_clusters {
            let mut dist_sq: f32 = 0.0
            for k in 0 to n_features {
                let d: f32 = shifted[i][k] - centroids[c][k]
                dist_sq = dist_sq + d * d
            }
            if (sqrt((dist_sq as f64)) as f32) < bandwidth {
                labels[i] = c
                found = true
                break
            }
        }
        if not found {
            centroids[n_clusters] = array_new_f32(n_features)
            for k in 0 to n_features {
                centroids[n_clusters][k] = shifted[i][k]
            }
            labels[i] = n_clusters
            n_clusters = n_clusters + 1
        }
    }

    for i in 0 to n {
        array_free_f32(shifted[i])
    }
    free(shifted as ptr<void>)

    return MeanShift {
        centroids: centroids, n_clusters: n_clusters,
        n_features: n_features, labels: labels,
        bandwidth: bandwidth, n_iter: max_iter,
        fitted: true
    }
}

export function mean_shift_predict(model: MeanShift, X: Matrix) -> ptr<i32> {
    let n: i32 = X.rows
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_dist: f32 = 10000000000.0
        for c in 0 to model.n_clusters {
            let mut dist_sq: f32 = 0.0
            for k in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, k) - model.centroids[c][k]
                dist_sq = dist_sq + d * d
            }
            if dist_sq < best_dist {
                best_dist = dist_sq
                best_c = c
            }
        }
        labels[i] = best_c
    }

    return labels
}

export function mean_shift_free(model: MeanShift) -> void {
    for c in 0 to model.n_clusters {
        array_free_f32(model.centroids[c])
    }
    free(model.centroids as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# Birch
# ============================================================================

export struct Birch {
    centroids: ptr<ptr<f32> >,
    n_clusters: i32,
    n_features: i32,
    labels: ptr<i32>,
    threshold: f32,
    branching_factor: i32,
    fitted: bool
}

export function birch_fit(X: Matrix, threshold: f32, branching_factor: i32) -> Birch {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let max_clusters: i32 = n
    let centroids: ptr<ptr<f32> > = malloc((max_clusters as i64) * 8) as ptr<ptr<f32> >
    let cluster_counts: ptr<i32> = malloc((max_clusters as i64) * 4) as ptr<i32>
    let n_clusters: i32 = 0

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    for i in 0 to n {
        let mut best_c: i32 = -1
        let mut best_dist: f32 = 10000000000.0

        for c in 0 to n_clusters {
            let mut dist_sq: f32 = 0.0
            for k in 0 to n_features {
                let d: f32 = matrix_at(X, i, k) - centroids[c][k]
                dist_sq = dist_sq + d * d
            }
            if dist_sq < best_dist {
                best_dist = dist_sq
                best_c = c
            }
        }

        if best_c >= 0 && best_dist < threshold * threshold {
            let count: f32 = (cluster_counts[best_c] as f32)
            for k in 0 to n_features {
                let new_val: f32 = (centroids[best_c][k] * count + matrix_at(X, i, k)) / (count + 1.0)
                centroids[best_c][k] = new_val
            }
            cluster_counts[best_c] = cluster_counts[best_c] + 1
            labels[i] = best_c
        } else {
            centroids[n_clusters] = array_new_f32(n_features)
            for k in 0 to n_features {
                centroids[n_clusters][k] = matrix_at(X, i, k)
            }
            cluster_counts[n_clusters] = 1
            labels[i] = n_clusters
            n_clusters = n_clusters + 1
        }
    }

    free(cluster_counts as ptr<void>)

    return Birch {
        centroids: centroids, n_clusters: n_clusters,
        n_features: n_features, labels: labels,
        threshold: threshold,
        branching_factor: branching_factor,
        fitted: true
    }
}

export function birch_predict(model: Birch, X: Matrix) -> ptr<i32> {
    let n: i32 = X.rows
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_dist: f32 = 10000000000.0
        for c in 0 to model.n_clusters {
            let mut dist_sq: f32 = 0.0
            for k in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, k) - model.centroids[c][k]
                dist_sq = dist_sq + d * d
            }
            if dist_sq < best_dist {
                best_dist = dist_sq
                best_c = c
            }
        }
        labels[i] = best_c
    }

    return labels
}

export function birch_free(model: Birch) -> void {
    for c in 0 to model.n_clusters {
        array_free_f32(model.centroids[c])
    }
    free(model.centroids as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# SpectralClustering
# ============================================================================

export struct SpectralClustering {
    labels: ptr<i32>,
    n_clusters: i32,
    n_samples: i32,
    n_features: i32,
    affinity: ptr<ptr<f32> >,
    fitted: bool
}

function _build_rbf_affinity(X: Matrix, gamma: f32) -> ptr<ptr<f32> > {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let W: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        W[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            W[i][j] = exp((-gamma * s) as f64) as f32
        }
    }
    return W
}

export function spectral_clustering_fit(X: Matrix, n_clusters: i32, gamma: f32, seed: i32) -> SpectralClustering {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let W: ptr<ptr<f32> > = _build_rbf_affinity(X, gamma)

    let deg: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        for j in 0 to n {
            deg[i] = deg[i] + W[i][j]
        }
        if deg[i] < 0.0000000001 { deg[i] = 0.0000000001 }
    }

    let L: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        L[i] = array_new_f32(n)
        for j in 0 to n {
            if i == j {
                L[i][j] = 1.0
            } else {
                L[i][j] = -W[i][j] / sqrt((deg[i] * deg[j]) as f64) as f32
            }
        }
    }

    let eigvecs: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_clusters {
        eigvecs[c] = array_new_f32(n)
        srand(seed + c)
        for i in 0 to n {
            eigvecs[c][i] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }

        for iter in 0 to 100 {
            let Av: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut s: f32 = 0.0
                for j in 0 to n {
                    s = s + L[i][j] * eigvecs[c][j]
                }
                Av[i] = s
            }

            if c > 0 {
                for prev in 0 to c {
                    let mut dot: f32 = 0.0
                    for i in 0 to n {
                        dot = dot + Av[i] * eigvecs[prev][i]
                    }
                    for i in 0 to n {
                        Av[i] = Av[i] - dot * eigvecs[prev][i]
                    }
                }
            }

            let mut norm: f32 = 0.0
            for i in 0 to n {
                norm = norm + Av[i] * Av[i]
            }
            norm = sqrt((norm as f64)) as f32
            if norm < 0.0000000001 { norm = 0.0000000001 }

            let mut change: f32 = 0.0
            for i in 0 to n {
                let new_val: f32 = Av[i] / norm
                let d: f32 = fabs((new_val - eigvecs[c][i]) as f64) as f32
                if d > change { change = d }
                eigvecs[c][i] = new_val
            }
            array_free_f32(Av)
            if change < 0.000001 { break }
        }
    }

    let features: Matrix = matrix_new(n, n_clusters)
    for i in 0 to n {
        for c in 0 to n_clusters {
            matrix_set(features, i, c, eigvecs[c][i])
        }
    }

    let km: KMeans = kmeans_fit(features, n_clusters, 100, 0.0001, seed)

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        labels[i] = km.labels[i]
    }

    for i in 0 to n {
        array_free_f32(L[i])
    }
    free(L as ptr<void>)
    for c in 0 to n_clusters {
        array_free_f32(eigvecs[c])
    }
    free(eigvecs as ptr<void>)
    array_free_f32(deg)
    matrix_free(features)
    kmeans_free(km)

    return SpectralClustering {
        labels: labels,
        n_clusters: n_clusters,
        n_samples: n,
        n_features: p,
        affinity: W,
        fitted: true
    }
}

export function spectral_clustering_free(model: SpectralClustering) -> void {
    for i in 0 to model.n_samples {
        array_free_f32(model.affinity[i])
    }
    free(model.affinity as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# AffinityPropagation
# ============================================================================

export struct AffinityPropagation {
    cluster_centers_indices: ptr<i32>,
    labels: ptr<i32>,
    n_clusters: i32,
    n_samples: i32,
    n_iter: i32,
    fitted: bool
}

export function affinity_propagation_fit(X: Matrix, damping: f32, max_iter: i32, convergence_iter: i32) -> AffinityPropagation {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let S: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        S[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            S[i][j] = -s
        }
    }

    let mut pref: f32 = 0.0
    let mut count: i32 = 0
    for i in 0 to n {
        for j in 0 to n {
            if i != j {
                pref = pref + S[i][j]
                count = count + 1
            }
        }
    }
    pref = pref / (count as f32)
    for i in 0 to n {
        S[i][i] = pref
    }

    let R: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    let A: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        R[i] = array_new_f32(n)
        A[i] = array_new_f32(n)
    }

    let mut n_iter: i32 = 0
    let mut conv_count: i32 = 0
    let mut old_labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n { old_labels[i] = -1 }

    for iter in 0 to max_iter {
        n_iter = iter + 1

        for i in 0 to n {
            for k in 0 to n {
                let mut max_other: f32 = -9999999999.0
                for kk in 0 to n {
                    if kk == k { continue }
                    let val: f32 = A[i][kk] + S[i][kk]
                    if val > max_other { max_other = val }
                }
                R[i][k] = (1.0 - damping) * (S[i][k] - max_other) + damping * R[i][k]
            }
        }

        for k in 0 to n {
            let mut sum_pos: f32 = 0.0
            for i in 0 to n {
                if i == k { continue }
                if R[i][k] > 0.0 { sum_pos = sum_pos + R[i][k] }
            }
            for i in 0 to n {
                if i == k {
                    A[i][k] = (1.0 - damping) * (sum_pos + R[k][k]) + damping * A[i][k]
                } else {
                    let r_ik: f32 = R[i][k]
                    let val: f32 = sum_pos + R[k][k]
                    if r_ik > 0.0 { val = val - r_ik }
                    if val > 0.0 { val = 0.0 }
                    A[i][k] = (1.0 - damping) * val + damping * A[i][k]
                }
            }
        }

        let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        for i in 0 to n {
            let mut best_k: i32 = 0
            let mut best_val: f32 = -9999999999.0
            for k in 0 to n {
                let val: f32 = A[i][k] + R[i][k]
                if val > best_val {
                    best_val = val
                    best_k = k
                }
            }
            labels[i] = best_k
        }

        let mut changed: i32 = 0
        for i in 0 to n {
            if labels[i] != old_labels[i] { changed = changed + 1 }
            old_labels[i] = labels[i]
        }
        free(labels as ptr<void>)

        if changed == 0 {
            conv_count = conv_count + 1
            if conv_count >= convergence_iter { break }
        } else {
            conv_count = 0
        }
    }

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let exemplars: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut n_exemplars: i32 = 0

    for k in 0 to n {
        if A[k][k] + R[k][k] > 0.0 {
            exemplars[n_exemplars] = k
            n_exemplars = n_exemplars + 1
        }
    }

    for i in 0 to n {
        let mut best_e: i32 = 0
        let mut best_sim: f32 = -9999999999.0
        for e in 0 to n_exemplars {
            let k: i32 = exemplars[e]
            if S[i][k] > best_sim {
                best_sim = S[i][k]
                best_e = e
            }
        }
        labels[i] = best_e
    }

    free(old_labels as ptr<void>)
    for i in 0 to n {
        array_free_f32(S[i])
        array_free_f32(R[i])
        array_free_f32(A[i])
    }
    free(S as ptr<void>)
    free(R as ptr<void>)
    free(A as ptr<void>)

    let result: AffinityPropagation = AffinityPropagation {
        cluster_centers_indices: exemplars,
        labels: labels,
        n_clusters: n_exemplars,
        n_samples: n,
        n_iter: n_iter,
        fitted: true
    }
    return result
}

export function affinity_propagation_free(model: AffinityPropagation) -> void {
    free(model.cluster_centers_indices as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# OPTICS
# ============================================================================

export struct OPTICS {
    labels: ptr<i32>,
    core_distances: ptr<f32>,
    reachability: ptr<f32>,
    ordering: ptr<i32>,
    n_samples: i32,
    n_clusters: i32,
    n_features: i32,
    eps: f32,
    min_samples: i32,
    fitted: bool
}

export function optics_fit(X: Matrix, eps: f32, min_samples: i32) -> OPTICS {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let core_dist: ptr<f32> = array_new_f32(n)
    let reachability: ptr<f32> = array_new_f32(n)
    let ordering: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let processed: ptr<bool> = calloc((n as i64), 1) as ptr<bool>

    for i in 0 to n {
        reachability[i] = 9999999999.0
        ordering[i] = 0
    }

    for i in 0 to n {
        let dists: ptr<f32> = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            dists[j] = sqrt((s as f64)) as f32
        }

        let sorted: ptr<f32> = array_copy_f32(dists, n)
        for a in 0 to n {
            for b in 0 to n - 1 - a {
                if sorted[b] > sorted[b + 1] {
                    let t: f32 = sorted[b]
                    sorted[b] = sorted[b + 1]
                    sorted[b + 1] = t
                }
            }
        }
        if min_samples < n {
            core_dist[i] = sorted[min_samples]
        } else {
            core_dist[i] = sorted[n - 1]
        }
        array_free_f32(sorted)
        array_free_f32(dists)
    }

    let mut order_idx: i32 = 0
    for start in 0 to n {
        if processed[start] { continue }

        processed[start] = true
        reachability[start] = 0.0
        ordering[order_idx] = start
        order_idx = order_idx + 1

        let mut current: i32 = start
        for step in 0 to n {
            let neighbors: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
            let mut n_neighbors: i32 = 0
            for j in 0 to n {
                if processed[j] { continue }
                let mut s: f32 = 0.0
                for k in 0 to p {
                    let d: f32 = matrix_at(X, current, k) - matrix_at(X, j, k)
                    s = s + d * d
                }
                let dist: f32 = sqrt((s as f64)) as f32
                if dist <= eps {
                    neighbors[n_neighbors] = j
                    n_neighbors = n_neighbors + 1
                    let reach: f32 = core_dist[current]
                    if dist > reach { reach = dist }
                    if reach < reachability[j] {
                        reachability[j] = reach
                    }
                }
            }

            let mut best_j: i32 = -1
            let mut best_reach: f32 = 9999999999.0
            for j in 0 to n_neighbors {
                if reachability[neighbors[j]] < best_reach {
                    best_reach = reachability[neighbors[j]]
                    best_j = neighbors[j]
                }
            }
            free(neighbors as ptr<void>)

            if best_j < 0 { break }
            processed[best_j] = true
            ordering[order_idx] = best_j
            order_idx = order_idx + 1
            current = best_j
        }
    }

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut cluster_id: i32 = 0
    let mut in_cluster: bool = false

    for idx in 0 to n {
        let i: i32 = ordering[idx]
        if reachability[i] > eps {
            in_cluster = false
            labels[i] = -1
        } else {
            if not in_cluster {
                cluster_id = cluster_id + 1
                in_cluster = true
            }
            labels[i] = cluster_id - 1
        }
    }

    free(processed as ptr<void>)

    return OPTICS {
        labels: labels,
        core_distances: core_dist,
        reachability: reachability,
        ordering: ordering,
        n_samples: n,
        n_clusters: cluster_id,
        n_features: p,
        eps: eps,
        min_samples: min_samples,
        fitted: true
    }
}

export function optics_free(model: OPTICS) -> void {
    free(model.labels as ptr<void>)
    array_free_f32(model.core_distances)
    array_free_f32(model.reachability)
    free(model.ordering as ptr<void>)
}

# ============================================================================
# BisectingKMeans
# ============================================================================

export struct BisectingKMeans {
    centroids: ptr<ptr<f32> >,
    labels: ptr<i32>,
    n_clusters: i32,
    n_features: i32,
    n_samples: i32,
    n_iter: i32,
    fitted: bool
}

export function bisecting_kmeans_fit(X: Matrix, n_clusters: i32, max_iter: i32, seed: i32) -> BisectingKMeans {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    for i in 0 to n {
        labels[i] = 0
    }

    let mut n_current: i32 = 1
    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n {
            s = s + matrix_at(X, i, j)
        }
        mean[j] = s / (n as f32)
    }
    centroids[0] = array_copy_f32(mean, p)
    array_free_f32(mean)

    let cluster_members: ptr<ptr<i32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<i32> >
    let cluster_sizes: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for c in 0 to n_clusters {
        cluster_members[c] = malloc((n as i64) * 4) as ptr<i32>
        cluster_sizes[c] = 0
    }
    for i in 0 to n {
        cluster_members[0][i] = i
        cluster_sizes[0] = n
    }

    while n_current < n_clusters {
        let mut worst: i32 = 0
        let mut worst_sse: f32 = -1.0
        for c in 0 to n_current {
            if cluster_sizes[c] < 2 { continue }
            let mut sse: f32 = 0.0
            for idx in 0 to cluster_sizes[c] {
                let i: i32 = cluster_members[c][idx]
                for j in 0 to p {
                    let d: f32 = matrix_at(X, i, j) - centroids[c][j]
                    sse = sse + d * d
                }
            }
            if sse > worst_sse {
                worst_sse = sse
                worst = c
            }
        }

        if cluster_sizes[worst] < 2 { break }

        let sub_X: Matrix = matrix_new(cluster_sizes[worst], p)
        for idx in 0 to cluster_sizes[worst] {
            let i: i32 = cluster_members[worst][idx]
            for j in 0 to p {
                matrix_set(sub_X, idx, j, matrix_at(X, i, j))
            }
        }

        let km: KMeans = kmeans_fit(sub_X, 2, max_iter, 0.0001, seed + n_current)

        let new_cluster: i32 = n_current
        centroids[n_current] = array_copy_f32(km.centroids[1], p)
        for j in 0 to p {
            centroids[worst][j] = km.centroids[0][j]
        }

        let mut size0: i32 = 0
        let mut size1: i32 = 0
        for idx in 0 to cluster_sizes[worst] {
            let i: i32 = cluster_members[worst][idx]
            if km.labels[idx] == 0 {
                labels[i] = worst
                cluster_members[worst][size0] = i
                size0 = size0 + 1
            } else {
                labels[i] = new_cluster
                cluster_members[new_cluster][size1] = i
                size1 = size1 + 1
            }
        }
        cluster_sizes[worst] = size0
        cluster_sizes[new_cluster] = size1

        kmeans_free(km)
        matrix_free(sub_X)
        n_current = n_current + 1
    }

    for c in 0 to n_clusters {
        free(cluster_members[c] as ptr<void>)
    }
    free(cluster_members as ptr<void>)
    free(cluster_sizes as ptr<void>)

    return BisectingKMeans {
        centroids: centroids,
        labels: labels,
        n_clusters: n_current,
        n_features: p,
        n_samples: n,
        n_iter: n_current,
        fitted: true
    }
}

export function bisecting_kmeans_free(model: BisectingKMeans) -> void {
    for c in 0 to model.n_clusters {
        array_free_f32(model.centroids[c])
    }
    free(model.centroids as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# HDBSCAN
# ============================================================================

export struct HDBSCAN {
    labels: ptr<f32>,
    n_clusters: i32,
    n_samples: i32,
    fitted: bool
}

export function hdbscan_fit(X: Matrix, min_cluster_size: i32, min_samples: i32) -> HDBSCAN {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let labels: ptr<f32> = array_new_f32(n)

    # Compute core distances (distance to min_samples-th nearest neighbor)
    let core_dist: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        # Compute distances from point i to all others
        let dists: ptr<f32> = array_new_f32(n)
        let mut j: i32 = 0
        while j < n {
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < n_features {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
                k = k + 1
            }
            dists[j] = sqrt((s) as f64) as f32
            j = j + 1
        }
        # Sort to find min_samples-th nearest
        let mut a: i32 = 0
        while a < n {
            let mut min_idx: i32 = a
            let mut b: i32 = a + 1
            while b < n {
                if dists[b] < dists[min_idx] {
                    min_idx = b
                }
                b = b + 1
            }
            let tmp: f32 = dists[a]
            dists[a] = dists[min_idx]
            dists[min_idx] = tmp
            a = a + 1
        }
        # dists[0] is self (0), dists[min_samples] is the core distance
        if min_samples < n {
            core_dist[i] = dists[min_samples]
        } else {
            core_dist[i] = dists[n - 1]
        }
        array_free_f32(dists)
        i = i + 1
    }

    # Build mutual reachability distance matrix
    # d_mreach(a,b) = max(core_dist[a], core_dist[b], dist(a,b))
    # Then build MST via Prim's algorithm
    let in_tree: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let min_edge: ptr<f32> = array_new_f32(n)
    let parent: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    i = 0
    while i < n {
        in_tree[i] = 0
        min_edge[i] = 999999.0
        parent[i] = -1
        i = i + 1
    }
    min_edge[0] = 0.0

    # MST edges
    let mst_u: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mst_v: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mst_w: ptr<f32> = array_new_f32(n)
    let mut n_edges: i32 = 0

    let mut step: i32 = 0
    while step < n {
        # Find minimum edge vertex not in tree
        let mut u: i32 = -1
        let mut best: f32 = 999999.0
        i = 0
        while i < n {
            if in_tree[i] == 0 && min_edge[i] < best {
                best = min_edge[i]
                u = i
            }
            i = i + 1
        }
        if u == -1 {
            step = step + 1
        } else {
            in_tree[u] = 1
            if parent[u] != -1 {
                mst_u[n_edges] = parent[u]
                mst_v[n_edges] = u
                mst_w[n_edges] = min_edge[u]
                n_edges = n_edges + 1
            }
            # Update distances
            let mut v: i32 = 0
            while v < n {
                if in_tree[v] == 0 {
                    # Compute mutual reachability distance
                    let mut s: f32 = 0.0
                    let mut k: i32 = 0
                    while k < n_features {
                        let d: f32 = matrix_at(X, u, k) - matrix_at(X, v, k)
                        s = s + d * d
                        k = k + 1
                    }
                    let dist_uv: f32 = sqrt((s) as f64) as f32
                    let mut mr: f32 = dist_uv
                    if core_dist[u] > mr { mr = core_dist[u] }
                    if core_dist[v] > mr { mr = core_dist[v] }
                    if mr < min_edge[v] {
                        min_edge[v] = mr
                        parent[v] = u
                    }
                }
                v = v + 1
            }
            step = step + 1
        }
    }

    # Sort MST edges by weight descending (for single-linkage tree cutting)
    let mut a2: i32 = 0
    while a2 < n_edges {
        let mut max_idx: i32 = a2
        let mut b2: i32 = a2 + 1
        while b2 < n_edges {
            if mst_w[b2] > mst_w[max_idx] {
                max_idx = b2
            }
            b2 = b2 + 1
        }
        let tmp_u: i32 = mst_u[a2]; mst_u[a2] = mst_u[max_idx]; mst_u[max_idx] = tmp_u
        let tmp_v: i32 = mst_v[a2]; mst_v[a2] = mst_v[max_idx]; mst_v[max_idx] = tmp_v
        let tmp_w: f32 = mst_w[a2]; mst_w[a2] = mst_w[max_idx]; mst_w[max_idx] = tmp_w
        a2 = a2 + 1
    }

    # Cut the MST: edges with large weight separate clusters
    # Use union-find to assign cluster labels
    # Cut edges where weight > threshold based on min_cluster_size
    let uf_parent: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let uf_size: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    i = 0
    while i < n {
        uf_parent[i] = i
        uf_size[i] = 1
        i = i + 1
    }

    # Add edges in order of increasing weight (build clusters)
    let mut e: i32 = n_edges - 1
    while e >= 0 {
        let u: i32 = mst_u[e]
        let v: i32 = mst_v[e]
        # Find roots
        let mut ru: i32 = u
        while uf_parent[ru] != ru { ru = uf_parent[ru] }
        let mut rv: i32 = v
        while uf_parent[rv] != rv { rv = uf_parent[rv] }
        if ru != rv {
            # Merge smaller into larger
            if uf_size[ru] < uf_size[rv] {
                uf_parent[ru] = rv
                uf_size[rv] = uf_size[rv] + uf_size[ru]
            } else {
                uf_parent[rv] = ru
                uf_size[ru] = uf_size[ru] + uf_size[rv]
            }
        }
        e = e - 1
    }

    # Assign labels: find root of each point, map roots to cluster IDs
    # Only clusters with size >= min_cluster_size get a real label
    let root_ids: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut n_clusters: i32 = 0
    i = 0
    while i < n {
        let mut r: i32 = i
        while uf_parent[r] != r { r = uf_parent[r] }
        root_ids[i] = r
        i = i + 1
    }

    # Find unique roots with size >= min_cluster_size
    let unique_roots: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let cluster_map: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    i = 0
    while i < n {
        cluster_map[i] = -1
        i = i + 1
    }

    i = 0
    while i < n {
        let r: i32 = root_ids[i]
        if cluster_map[r] == -1 {
            # Check if this cluster is large enough
            if uf_size[r] >= min_cluster_size {
                cluster_map[r] = n_clusters
                unique_roots[n_clusters] = r
                n_clusters = n_clusters + 1
            }
        }
        i = i + 1
    }

    # Assign labels
    i = 0
    while i < n {
        let r: i32 = root_ids[i]
        if cluster_map[r] != -1 {
            labels[i] = (cluster_map[r] as f32)
        } else {
            labels[i] = -1.0
        }
        i = i + 1
    }

    array_free_f32(core_dist)
    free(in_tree as ptr<void>)
    array_free_f32(min_edge)
    free(parent as ptr<void>)
    free(mst_u as ptr<void>)
    free(mst_v as ptr<void>)
    array_free_f32(mst_w)
    free(uf_parent as ptr<void>)
    free(uf_size as ptr<void>)
    free(root_ids as ptr<void>)
    free(unique_roots as ptr<void>)
    free(cluster_map as ptr<void>)

    let result: HDBSCAN = HDBSCAN {
        labels: labels,
        n_clusters: n_clusters,
        n_samples: n,
        fitted: true
    }
    return result
}

export function hdbscan_labels(model: HDBSCAN) -> ptr<f32> {
    let result: ptr<f32> = array_copy_f32(model.labels, model.n_samples)
    return result
}

export function hdbscan_free(model: HDBSCAN) -> void {
    array_free_f32(model.labels)
}

# ============================================================================
# FeatureAgglomeration
# ============================================================================

export struct FeatureAgglomeration {
    n_clusters: i32,
    labels: ptr<i32>,
    n_features: i32,
    fitted: bool
}

export function feature_agglomeration_fit(X: Matrix, n_clusters: i32) -> FeatureAgglomeration {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let labels: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>

    # Compute correlation distance between features (1 - |corr|)
    let dist: ptr<f32> = array_new_f32(n_features * n_features)
    let mut i: i32 = 0
    while i < n_features {
        let mut j: i32 = 0
        while j < n_features {
            if i == j {
                dist[i * n_features + j] = 0.0
            } else {
                # Compute correlation between column i and column j
                let mut sum_i: f32 = 0.0
                let mut sum_j: f32 = 0.0
                let mut sum_ij: f32 = 0.0
                let mut sum_i2: f32 = 0.0
                let mut sum_j2: f32 = 0.0
                let mut k: i32 = 0
                while k < n {
                    let xi: f32 = matrix_at(X, k, i)
                    let xj: f32 = matrix_at(X, k, j)
                    sum_i = sum_i + xi
                    sum_j = sum_j + xj
                    sum_ij = sum_ij + xi * xj
                    sum_i2 = sum_i2 + xi * xi
                    sum_j2 = sum_j2 + xj * xj
                    k = k + 1
                }
                let mean_i: f32 = sum_i / (n as f32)
                let mean_j: f32 = sum_j / (n as f32)
                let cov: f32 = sum_ij / (n as f32) - mean_i * mean_j
                let var_i: f32 = sum_i2 / (n as f32) - mean_i * mean_i
                let var_j: f32 = sum_j2 / (n as f32) - mean_j * mean_j
                let denom: f32 = sqrt((var_i * var_j) as f64) as f32
                let corr: f32 = 0.0
                if denom > 0.0000000001 {
                    corr = cov / denom
                }
                dist[i * n_features + j] = 1.0 - fabs((corr) as f64) as f32
            }
            j = j + 1
        }
        i = i + 1
    }

    # Agglomerative clustering on features
    # Each feature starts as its own cluster
    let cluster_id: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>
    let mut n_current: i32 = n_features
    i = 0
    while i < n_features {
        cluster_id[i] = i
        labels[i] = i
        i = i + 1
    }

    # Merge closest clusters until n_clusters remain
    while n_current > n_clusters {
        # Find closest pair of clusters (single linkage: min distance between members)
        let mut best_dist: f32 = 999999.0
        let mut best_a: i32 = -1
        let mut best_b: i32 = -1
        i = 0
        while i < n_features {
            let mut j: i32 = i + 1
            while j < n_features {
                if cluster_id[i] != cluster_id[j] {
                    let d: f32 = dist[i * n_features + j]
                    if d < best_dist {
                        best_dist = d
                        best_a = cluster_id[i]
                        best_b = cluster_id[j]
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
        if best_a == -1 {
            n_current = n_clusters
        } else {
            # Merge cluster best_b into best_a
            i = 0
            while i < n_features {
                if cluster_id[i] == best_b {
                    cluster_id[i] = best_a
                }
                i = i + 1
            }
            n_current = n_current - 1
        }
    }

    # Relabel clusters to 0..n_clusters-1
    let unique_ids: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>
    let mut n_unique: i32 = 0
    i = 0
    while i < n_features {
        let mut found: bool = false
        let mut k: i32 = 0
        while k < n_unique {
            if unique_ids[k] == cluster_id[i] {
                found = true
            }
            k = k + 1
        }
        if not found {
            unique_ids[n_unique] = cluster_id[i]
            n_unique = n_unique + 1
        }
        i = i + 1
    }

    i = 0
    while i < n_features {
        let mut k: i32 = 0
        while k < n_unique {
            if unique_ids[k] == cluster_id[i] {
                labels[i] = k
            }
            k = k + 1
        }
        i = i + 1
    }

    array_free_f32(dist)
    free(cluster_id as ptr<void>)
    free(unique_ids as ptr<void>)

    let result: FeatureAgglomeration = FeatureAgglomeration {
        n_clusters: n_unique,
        labels: labels,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function feature_agglomeration_transform(model: FeatureAgglomeration, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_clusters)
    let mut c: i32 = 0
    while c < model.n_clusters {
        # Find features in this cluster
        let mut count: i32 = 0
        let mut f: i32 = 0
        while f < model.n_features {
            if model.labels[f] == c {
                count = count + 1
            }
            f = f + 1
        }
        # Average features in cluster
        let mut i: i32 = 0
        while i < n {
            let mut sum: f32 = 0.0
            let mut f2: i32 = 0
            while f2 < model.n_features {
                if model.labels[f2] == c {
                    sum = sum + matrix_at(X, i, f2)
                }
                f2 = f2 + 1
            }
            if count > 0 {
                matrix_set(result, i, c, sum / (count as f32))
            }
            i = i + 1
        }
        c = c + 1
    }
    return result
}

export function feature_agglomeration_free(model: FeatureAgglomeration) -> void {
    free(model.labels as ptr<void>)
}

# ============================================================================
# estimate_bandwidth - Estimate bandwidth for MeanShift
# ============================================================================

export function estimate_bandwidth(X: Matrix, quantile: f32, n_samples: i32, seed: i32) -> f32 {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let use_n: i32 = n_samples
    if use_n > n { use_n = n }

    srand(seed)

    let distances: ptr<f32> = array_new_f32(use_n)
    let mut d_idx: i32 = 0

    let mut i: i32 = 0
    while i < use_n {
        let idx: i32 = rand() % n
        let mut j: i32 = 0
        while j < use_n {
            if i != j {
                let jdx: i32 = rand() % n
                let mut dist: f32 = 0.0
                let mut k: i32 = 0
                while k < p {
                    let d: f32 = matrix_at(X, idx, k) - matrix_at(X, jdx, k)
                    dist = dist + d * d
                    k = k + 1
                }
                if d_idx < use_n {
                    distances[d_idx] = sqrt(dist as f64) as f32
                    d_idx = d_idx + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    let mut sorted: ptr<f32> = array_copy_f32(distances, d_idx)
    let mut a: i32 = 1
    while a < d_idx {
        let key: f32 = sorted[a]
        let mut b: i32 = a - 1
        while b >= 0 && sorted[b] > key {
            sorted[b + 1] = sorted[b]
            b = b - 1
        }
        sorted[b + 1] = key
        a = a + 1
    }

    let q_idx: i32 = ((d_idx as f32) * quantile) as i32
    if q_idx >= d_idx { q_idx = d_idx - 1 }
    if q_idx < 0 { q_idx = 0 }

    let bandwidth: f32 = sorted[q_idx]
    if bandwidth < 0.0000000001 { bandwidth = 1.0 }

    array_free_f32(distances)
    array_free_f32(sorted)
    return bandwidth
}

# ============================================================================
# kmeans_plusplus_init - K-Means++ initialization
# ============================================================================

export function kmeans_plusplus_init(X: Matrix, n_clusters: i32, seed: i32) -> Matrix {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let centers: Matrix = matrix_new(n_clusters, p)

    srand(seed)

    let first: i32 = rand() % n
    let mut j: i32 = 0
    while j < p {
        matrix_set(centers, 0, j, matrix_at(X, first, j))
        j = j + 1
    }

    let dists: ptr<f32> = array_new_f32(n)
    let mut c: i32 = 1
    while c < n_clusters {
        let mut total_dist: f32 = 0.0
        let mut i: i32 = 0
        while i < n {
            let mut min_dist: f32 = 10000000000.0
            let mut k: i32 = 0
            while k < c {
                let mut d: f32 = 0.0
                let mut f: i32 = 0
                while f < p {
                    let diff: f32 = matrix_at(X, i, f) - matrix_at(centers, k, f)
                    d = d + diff * diff
                    f = f + 1
                }
                if d < min_dist { min_dist = d }
                k = k + 1
            }
            dists[i] = min_dist
            total_dist = total_dist + min_dist
            i = i + 1
        }

        if total_dist < 0.0000000001 {
            let idx: i32 = rand() % n
            let mut f: i32 = 0
            while f < p {
                matrix_set(centers, c, f, matrix_at(X, idx, f))
                f = f + 1
            }
        } else {
            let r: f32 = ((rand() % 10000) as f32) / 10000.0 * total_dist
            let mut cum: f32 = 0.0
            let mut chosen: i32 = n - 1
            let mut i: i32 = 0
            while i < n {
                cum = cum + dists[i]
                if cum >= r {
                    chosen = i
                    break
                }
                i = i + 1
            }
            let mut f: i32 = 0
            while f < p {
                matrix_set(centers, c, f, matrix_at(X, chosen, f))
                f = f + 1
            }
        }
        c = c + 1
    }

    array_free_f32(dists)
    return centers
}
