# Deterministic PRNG for cross-platform reproducibility.
# libc rand() differs between platforms (macOS libSystem vs Android bionic),
# causing different model outputs. This xorshift32 implementation produces
# identical sequences on all platforms given the same seed.

export struct PRNG {
    state: u32
}

export struct PRNGResult {
    state: u32,
    value: i32
}

export function prng_seed(seed: i32) -> PRNG {
    let mut s: u32 = (seed as u32)
    if s == 0 { s = 1 }
    return PRNG { state: s }
}

export function prng_next(p: PRNG) -> PRNGResult {
    let mut x: u32 = p.state
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    return PRNGResult { state: x, value: (x & 0x7FFFFFFF) as i32 }
}

export function prng_int(p: PRNG, n: i32) -> PRNGResult {
    let r: PRNGResult = prng_next(p)
    if n <= 0 { return PRNGResult { state: r.state, value: 0 } }
    return PRNGResult { state: r.state, value: r.value % n }
}

# ============================================================================
# MT19937, bit-compatible with NumPy's legacy RandomState.
#
# Estimators that must reproduce a scikit-learn trajectory need the same
# random draws in the same order, and scikit-learn consumes
# numpy.random.RandomState, which is MT19937 seeded by numpy's scalar
# initializer. xorshift32 above stays the default for everything else; this is
# the opt-in stream for seeded-parity work.
#
# The state is a flat 625-word buffer: words 0..623 hold the key, word 624
# holds the read position. Keeping the position in the buffer lets the
# generator mutate in place, which Flow's by-value structs do not allow.
# ============================================================================

export function mt19937_new(seed: i32) -> ptr<u32> {
    let st: ptr<u32> = malloc(625 * 4) as ptr<u32>
    let mult: u32 = 1812433253 as u32
    let mut s: u32 = (seed as u32)
    let mut pos: i32 = 0
    while pos < 624 {
        st[pos] = s
        let x: u32 = s ^ (s >> 30)
        s = mult * x + ((pos + 1) as u32)
        pos = pos + 1
    }
    st[624] = 624 as u32
    return st
}

export function mt19937_free(st: ptr<u32>) -> void {
    free(st as ptr<void>)
}

# Refill the whole key block. Mirrors numpy's mt19937_gen.
function mt19937_twist(st: ptr<u32>) -> void {
    let upper: u32 = (1 as u32) << 31
    let lower: u32 = 2147483647 as u32
    let one: u32 = 1 as u32
    let zero: u32 = 0 as u32
    let matrix_a: u32 = ((0x9908 as u32) << 16) | (0xb0df as u32)

    let mut i: i32 = 0
    while i < 227 {
        let y: u32 = (st[i] & upper) | (st[i + 1] & lower)
        let mut m: u32 = zero
        if (y & one) != zero {
            m = matrix_a
        }
        st[i] = st[i + 397] ^ (y >> 1) ^ m
        i = i + 1
    }
    while i < 623 {
        let y: u32 = (st[i] & upper) | (st[i + 1] & lower)
        let mut m: u32 = zero
        if (y & one) != zero {
            m = matrix_a
        }
        st[i] = st[i - 227] ^ (y >> 1) ^ m
        i = i + 1
    }
    let yl: u32 = (st[623] & upper) | (st[0] & lower)
    let mut ml: u32 = zero
    if (yl & one) != zero {
        ml = matrix_a
    }
    st[623] = st[396] ^ (yl >> 1) ^ ml
    st[624] = zero
}

export function mt19937_next_u32(st: ptr<u32>) -> u32 {
    let mut pos: i32 = st[624] as i32
    if pos >= 624 {
        mt19937_twist(st)
        pos = 0
    }
    let mut y: u32 = st[pos]
    st[624] = ((pos + 1) as u32)
    let t1: u32 = ((0x9d2c as u32) << 16) | (0x5680 as u32)
    let t2: u32 = ((0xefc6 as u32) << 16) | (0x0000 as u32)
    y = y ^ (y >> 11)
    y = y ^ ((y << 7) & t1)
    y = y ^ ((y << 15) & t2)
    y = y ^ (y >> 18)
    return y
}

# One 53-bit double in [0, 1), identical to numpy's random_sample() and to
# uniform(low=0.0, high=1.0), which is 0.0 + 1.0 * this value.
export function mt19937_next_double(st: ptr<u32>) -> f64 {
    let a: u32 = mt19937_next_u32(st) >> 5
    let b: u32 = mt19937_next_u32(st) >> 6
    let av: f64 = (a as f64)
    let bv: f64 = (b as f64)
    return (av * 67108864.0 + bv) / 9007199254740992.0
}

# numpy's RandomState.choice(n, p=uniform) for a single draw: one double, then
# a right-searchsorted lookup into the normalized cumulative weights.
export function mt19937_choice_uniform(st: ptr<u32>, n: i32) -> i32 {
    if n <= 1 {
        return 0
    }
    let u: f64 = mt19937_next_double(st)
    let w: f64 = 1.0 / (n as f64)
    let mut total: f64 = 0.0
    for i in 0 to n {
        total = total + w
    }
    let mut acc: f64 = 0.0
    let mut idx: i32 = n - 1
    let mut found: bool = false
    for i in 0 to n {
        acc = acc + w
        if not found {
            if acc / total > u {
                idx = i
                found = true
            }
        }
    }
    return idx
}
