# Metrics module for flow-scikit.
# Addresses Issue #29205: classification_report returns structured output,
#   not a dict with collision-prone keys. Uses a ClassificationReport struct
#   with separate class_metrics and average_metrics arrays.
# Addresses Issue #30909: pos_label handled internally via classes_ array.
#   Metrics that need pos_label accept the estimator's classes array and
#   handle the switching internally.

import "lib/scikit/matrix.flow"

# ============================================================================
# Classification metrics
# ============================================================================

export function accuracy_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut correct: i32 = 0
    for i in 0 to n {
        if y_true[i] == y_pred[i] {
            correct = correct + 1
        }
    }
    return (correct as f32) / (n as f32)
}

export struct PrecisionRecall {
    precision: f32,
    recall: f32,
    f1: f32,
    support: i32
}

export function precision_recall_fscore(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> ptr<PrecisionRecall> {
    let results: ptr<PrecisionRecall> = malloc((n_classes as i64) * 16) as ptr<PrecisionRecall>

    for c in 0 to n_classes {
        let cls: f32 = classes[c]
        let mut tp: i32 = 0
        let mut fp: i32 = 0
        let mut fn: i32 = 0
        let mut support: i32 = 0

        for i in 0 to n {
            let true_cls: bool = y_true[i] == cls
            let pred_cls: bool = y_pred[i] == cls

            if true_cls && pred_cls {
                tp = tp + 1
            }
            if not true_cls && pred_cls {
                fp = fp + 1
            }
            if true_cls && not pred_cls {
                fn = fn + 1
            }
            if true_cls {
                support = support + 1
            }
        }

        let prec: f32 = 0.0
        if tp + fp > 0 {
            prec = (tp as f32) / ((tp + fp) as f32)
        }
        let rec: f32 = 0.0
        if tp + fn > 0 {
            rec = (tp as f32) / ((tp + fn) as f32)
        }
        let f1: f32 = 0.0
        if prec + rec > 0.0 {
            f1 = 2.0 * prec * rec / (prec + rec)
        }

        (results + c).precision = prec
        (results + c).recall = rec
        (results + c).f1 = f1
        (results + c).support = support
    }

    return results
}

export struct ClassificationReport {
    class_metrics: ptr<PrecisionRecall>,
    classes: ptr<f32>,
    n_classes: i32,
    accuracy: f32,
    macro_precision: f32,
    macro_recall: f32,
    macro_f1: f32,
    weighted_precision: f32,
    weighted_recall: f32,
    weighted_f1: f32,
    n_samples: i32
}

export function classification_report(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> ClassificationReport {
    let class_metrics: ptr<PrecisionRecall> = precision_recall_fscore(y_true, y_pred, n, classes, n_classes)
    let acc: f32 = accuracy_score(y_true, y_pred, n)

    let mut macro_p: f32 = 0.0
    let mut macro_r: f32 = 0.0
    let mut macro_f: f32 = 0.0
    let mut weighted_p: f32 = 0.0
    let mut weighted_r: f32 = 0.0
    let mut weighted_f: f32 = 0.0
    let mut total_support: i32 = 0

    for c in 0 to n_classes {
        let m: PrecisionRecall = class_metrics[c]
        macro_p = macro_p + m.precision
        macro_r = macro_r + m.recall
        macro_f = macro_f + m.f1
        weighted_p = weighted_p + m.precision * (m.support as f32)
        weighted_r = weighted_r + m.recall * (m.support as f32)
        weighted_f = weighted_f + m.f1 * (m.support as f32)
        total_support = total_support + m.support
    }

    macro_p = macro_p / (n_classes as f32)
    macro_r = macro_r / (n_classes as f32)
    macro_f = macro_f / (n_classes as f32)

    if total_support > 0 {
        weighted_p = weighted_p / (total_support as f32)
        weighted_r = weighted_r / (total_support as f32)
        weighted_f = weighted_f / (total_support as f32)
    }

    return ClassificationReport {
        class_metrics: class_metrics,
        classes: classes,
        n_classes: n_classes,
        accuracy: acc,
        macro_precision: macro_p,
        macro_recall: macro_r,
        macro_f1: macro_f,
        weighted_precision: weighted_p,
        weighted_recall: weighted_r,
        weighted_f1: weighted_f,
        n_samples: n
    }
}

export function print_classification_report(report: ClassificationReport) -> void {
    println("")
    println("              precision    recall  f1-score   support")
    println("")

    for c in 0 to report.n_classes {
        let m: PrecisionRecall = report.class_metrics[c]
        print("  class ")
        print(report.classes[c])
        print("       ")
        printf("%.4f", m.precision)
        print("   ")
        printf("%.4f", m.recall)
        print("   ")
        printf("%.4f", m.f1)
        print("     ")
        print(m.support)
        println("")
    }

    println("")
    print("  accuracy                          ")
    printf("%.4f", report.accuracy)
    print("     ")
    print(report.n_samples)
    println("")
    print("  macro avg     ")
    printf("%.4f", report.macro_precision)
    print("   ")
    printf("%.4f", report.macro_recall)
    print("   ")
    printf("%.4f", report.macro_f1)
    print("     ")
    print(report.n_samples)
    println("")
    print("  weighted avg  ")
    printf("%.4f", report.weighted_precision)
    print("   ")
    printf("%.4f", report.weighted_recall)
    print("   ")
    printf("%.4f", report.weighted_f1)
    print("     ")
    print(report.n_samples)
    println("")
}

export function classification_report_free(report: ClassificationReport) -> void {
    free(report.class_metrics as ptr<void>)
}

# ============================================================================
# pos_label-aware metrics (Issue #30909)
# Accept the estimator's classes_ array and handle pos_label internally.
# ============================================================================

export function roc_auc_score(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, classes: ptr<f32>, pos_label: f32) -> f32 {
    let mut pos_count: i32 = 0
    let mut neg_count: i32 = 0

    for i in 0 to n {
        if y_true[i] == pos_label {
            pos_count = pos_count + 1
        } else {
            neg_count = neg_count + 1
        }
    }

    if pos_count == 0 || neg_count == 0 {
        return 0.0
    }

    let mut auc: f32 = 0.0
    for i in 0 to n {
        if y_true[i] == pos_label {
            for j in 0 to n {
                if y_true[j] != pos_label {
                    if y_score[i] > y_score[j] {
                        auc = auc + 1.0
                    } elif y_score[i] == y_score[j] {
                        auc = auc + 0.5
                    }
                }
            }
        }
    }

    return auc / ((pos_count as f32) * (neg_count as f32))
}

export function precision_at_threshold(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32, threshold: f32) -> f32 {
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    for i in 0 to n {
        let predicted_pos: bool = y_score[i] >= threshold
        let actual_pos: bool = y_true[i] == pos_label
        if predicted_pos && actual_pos {
            tp = tp + 1
        }
        if predicted_pos && not actual_pos {
            fp = fp + 1
        }
    }
    if tp + fp == 0 {
        return 0.0
    }
    return (tp as f32) / ((tp + fp) as f32)
}

export function recall_at_threshold(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32, threshold: f32) -> f32 {
    let mut tp: i32 = 0
    let mut fn: i32 = 0
    for i in 0 to n {
        let predicted_pos: bool = y_score[i] >= threshold
        let actual_pos: bool = y_true[i] == pos_label
        if predicted_pos && actual_pos {
            tp = tp + 1
        }
        if not predicted_pos && actual_pos {
            fn = fn + 1
        }
    }
    if tp + fn == 0 {
        return 0.0
    }
    return (tp as f32) / ((tp + fn) as f32)
}

# ============================================================================
# Regression metrics
# ============================================================================

export function mean_squared_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y_true[i] - y_pred[i]
        sum = sum + d * d
    }
    return sum / (n as f32)
}

export function root_mean_squared_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    return sqrt(mean_squared_error(y_true, y_pred, n) as f64) as f32
}

export function mean_absolute_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y_true[i] - y_pred[i]
        if d < 0.0 {
            sum = sum - d
        } else {
            sum = sum + d
        }
    }
    return sum / (n as f32)
}

export function r2_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mean: f32 = array_mean(y_true, n)
    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    for i in 0 to n {
        let d_res: f32 = y_true[i] - y_pred[i]
        ss_res = ss_res + d_res * d_res
        let d_tot: f32 = y_true[i] - mean
        ss_tot = ss_tot + d_tot * d_tot
    }
    if ss_tot < 1e-10 {
        return 0.0
    }
    return 1.0 - ss_res / ss_tot
}

# ============================================================================
# Confusion matrix
# ============================================================================

export struct ConfusionMatrix {
    matrix: ptr<i32>,
    n_classes: i32,
    classes: ptr<f32>
}

export function confusion_matrix(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> ConfusionMatrix {
    let cm: ptr<i32> = malloc((n_classes * n_classes) as i64 * 4) as ptr<i32>
    for i in 0 to n_classes * n_classes {
        cm[i] = 0
    }

    for i in 0 to n {
        let mut true_idx: i32 = -1
        let mut pred_idx: i32 = -1
        for c in 0 to n_classes {
            if classes[c] == y_true[i] {
                true_idx = c
            }
            if classes[c] == y_pred[i] {
                pred_idx = c
            }
        }
        if true_idx >= 0 && pred_idx >= 0 {
            cm[true_idx * n_classes + pred_idx] = cm[true_idx * n_classes + pred_idx] + 1
        }
    }

    return ConfusionMatrix { matrix: cm, n_classes: n_classes, classes: classes }
}

export function print_confusion_matrix(cm: ConfusionMatrix) -> void {
    println("")
    print("  ")
    for c in 0 to cm.n_classes {
        print("  pred ")
        print(c)
        print("  ")
    }
    println("")

    for r in 0 to cm.n_classes {
        print("  true ")
        print(r)
        for c in 0 to cm.n_classes {
            let val: i32 = cm.matrix[r * cm.n_classes + c]
            if val < 10 {
                print("    ")
            } elif val < 100 {
                print("   ")
            } else {
                print("  ")
            }
            print(val)
            print("  ")
        }
        println("")
    }
}

export function confusion_matrix_free(cm: ConfusionMatrix) -> void {
    free(cm.matrix as ptr<void>)
}

# ============================================================================
# ROC curve
# ============================================================================

export struct ROCPoint {
    fpr: f32,
    tpr: f32,
    threshold: f32
}

export struct ROCCurve {
    points: ptr<ROCPoint>,
    n_points: i32,
    auc: f32
}

export function roc_curve(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32) -> ROCCurve {
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }

    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if y_score[indices[j]] > y_score[indices[max_idx]] {
                max_idx = j
            }
        }
        let tmp: i32 = indices[i]
        indices[i] = indices[max_idx]
        indices[max_idx] = tmp
    }

    let mut n_pos: i32 = 0
    let mut n_neg: i32 = 0
    for i in 0 to n {
        if y_true[i] == pos_label {
            n_pos = n_pos + 1
        } else {
            n_neg = n_neg + 1
        }
    }

    let max_points: i32 = n + 2
    let points: ptr<ROCPoint> = malloc((max_points as i64) * 16) as ptr<ROCPoint>
    let mut n_points: i32 = 0

    let mut tp: i32 = 0
    let mut fp: i32 = 0

    (points + n_points).fpr = 0.0
    (points + n_points).tpr = 0.0
    (points + n_points).threshold = y_score[indices[0]] + 1.0
    n_points = n_points + 1

    for i in 0 to n {
        if y_true[indices[i]] == pos_label {
            tp = tp + 1
        } else {
            fp = fp + 1
        }

        let fpr: f32 = (fp as f32) / (n_neg as f32)
        let tpr: f32 = (tp as f32) / (n_pos as f32)

        (points + n_points).fpr = fpr
        (points + n_points).tpr = tpr
        (points + n_points).threshold = y_score[indices[i]]
        n_points = n_points + 1
    }

    let auc: f32 = 0.0
    for i in 1 to n_points {
        let width: f32 = (points + i).fpr - (points + i - 1).fpr
        let height: f32 = ((points + i).tpr + (points + i - 1).tpr) / 2.0
        auc = auc + width * height
    }

    free(indices as ptr<void>)

    return ROCCurve { points: points, n_points: n_points, auc: auc }
}

export function roc_curve_free(curve: ROCCurve) -> void {
    free(curve.points as ptr<void>)
}

# ============================================================================
# Precision-Recall curve
# ============================================================================

export struct PRPoint {
    precision: f32,
    recall: f32,
    threshold: f32
}

export struct PRCurve {
    points: ptr<PRPoint>,
    n_points: i32
}

export function precision_recall_curve(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32) -> PRCurve {
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }

    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if y_score[indices[j]] > y_score[indices[max_idx]] {
                max_idx = j
            }
        }
        let tmp: i32 = indices[i]
        indices[i] = indices[max_idx]
        indices[max_idx] = tmp
    }

    let mut n_pos: i32 = 0
    for i in 0 to n {
        if y_true[i] == pos_label {
            n_pos = n_pos + 1
        }
    }

    let max_points: i32 = n + 2
    let points: ptr<PRPoint> = malloc((max_points as i64) * 16) as ptr<PRPoint>
    let mut n_points: i32 = 0

    let mut tp: i32 = 0
    let mut fp: i32 = 0

    (points + n_points).precision = 1.0
    (points + n_points).recall = 0.0
    (points + n_points).threshold = y_score[indices[0]] + 1.0
    n_points = n_points + 1

    for i in 0 to n {
        if y_true[indices[i]] == pos_label {
            tp = tp + 1
        } else {
            fp = fp + 1
        }

        let prec: f32 = (tp as f32) / ((tp + fp) as f32)
        let rec: f32 = (tp as f32) / (n_pos as f32)

        (points + n_points).precision = prec
        (points + n_points).recall = rec
        (points + n_points).threshold = y_score[indices[i]]
        n_points = n_points + 1
    }

    free(indices as ptr<void>)

    return PRCurve { points: points, n_points: n_points }
}

export function pr_curve_free(curve: PRCurve) -> void {
    free(curve.points as ptr<void>)
}

# ============================================================================
# Log loss (cross-entropy)
# ============================================================================

export function log_loss(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let p: f32 = y_pred[i]
        if p > 1.0 - 1e-10 {
            p = 1.0 - 1e-10
        }
        if p < 1e-10 {
            p = 1e-10
        }
        if y_true[i] == pos_label {
            sum = sum - log(p as f64) as f32
        } else {
            sum = sum - log((1.0 - p) as f64) as f32
        }
    }
    return sum / (n as f32)
}

# ============================================================================
# Cohen's Kappa
# ============================================================================

export function cohen_kappa(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let cm: ConfusionMatrix = confusion_matrix(y_true, y_pred, n, classes, n_classes)

    let mut po: f32 = 0.0
    for c in 0 to n_classes {
        po = po + (cm.matrix[c * n_classes + c] as f32)
    }
    po = po / (n as f32)

    let mut pe: f32 = 0.0
    for c in 0 to n_classes {
        let row_sum: f32 = 0.0
        let col_sum: f32 = 0.0
        for k in 0 to n_classes {
            row_sum = row_sum + (cm.matrix[c * n_classes + k] as f32)
            col_sum = col_sum + (cm.matrix[k * n_classes + c] as f32)
        }
        pe = pe + (row_sum / (n as f32)) * (col_sum / (n as f32))
    }

    confusion_matrix_free(cm)

    if pe > 1.0 - 1e-10 {
        return 0.0
    }
    return (po - pe) / (1.0 - pe)
}

# ============================================================================
# Matthews Correlation Coefficient
# ============================================================================

export function matthews_corrcoef(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    let mut tp: i32 = 0
    let mut tn: i32 = 0
    let mut fp: i32 = 0
    let mut fn: i32 = 0

    for i in 0 to n {
        let actual_pos: bool = y_true[i] == pos_label
        let pred_pos: bool = y_pred[i] == pos_label

        if actual_pos && pred_pos {
            tp = tp + 1
        } elif not actual_pos && not pred_pos {
            tn = tn + 1
        } elif not actual_pos && pred_pos {
            fp = fp + 1
        } else {
            fn = fn + 1
        }
    }

    let numerator: f32 = ((tp as f32) * (tn as f32) - (fp as f32) * (fn as f32))
    let denominator: f32 = sqrt((((tp + fp) as f32) * ((tp + fn) as f32) * ((tn + fp) as f32) * ((tn + fn) as f32)) as f64) as f32

    if denominator < 1e-10 {
        return 0.0
    }
    return numerator / denominator
}

# ============================================================================
# Hinge loss
# ============================================================================

export function hinge_loss(y_true: ptr<f32>, y_decision: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let label: f32 = 1.0
        if y_true[i] != pos_label {
            label = -1.0
        }
        let margin: f32 = 1.0 - label * y_decision[i]
        if margin > 0.0 {
            sum = sum + margin
        }
    }
    return sum / (n as f32)
}

# ============================================================================
# Explained variance score
# ============================================================================

export function explained_variance_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mean_true: f32 = array_mean(y_true, n)
    let mut var_diff: f32 = 0.0
    let mut var_true: f32 = 0.0
    for i in 0 to n {
        let d_diff: f32 = y_true[i] - y_pred[i]
        let d_true: f32 = y_true[i] - mean_true
        var_diff = var_diff + d_diff * d_diff
        var_true = var_true + d_true * d_true
    }
    if var_true < 1e-10 {
        return 0.0
    }
    return 1.0 - var_diff / var_true
}

# ============================================================================
# Balanced accuracy
# ============================================================================

export function balanced_accuracy_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let mut sum_recall: f32 = 0.0
    for c in 0 to n_classes {
        let cls: f32 = classes[c]
        let mut tp: i32 = 0
        let mut total: i32 = 0
        for i in 0 to n {
            if y_true[i] == cls {
                total = total + 1
                if y_pred[i] == cls {
                    tp = tp + 1
                }
            }
        }
        if total > 0 {
            sum_recall = sum_recall + (tp as f32) / (total as f32)
        }
    }
    return sum_recall / (n_classes as f32)
}

# ============================================================================
# F-beta score
# ============================================================================

export function fbeta_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32, beta: f32) -> f32 {
    let beta_sq: f32 = beta * beta
    let pr: ptr<PrecisionRecall> = precision_recall_fscore(y_true, y_pred, n, classes, n_classes)

    let mut sum_f: f32 = 0.0
    for c in 0 to n_classes {
        let prec: f32 = pr[c].precision
        let rec: f32 = pr[c].recall
        let fb: f32 = 0.0
        if prec + rec > 0.0 {
            fb = (1.0 + beta_sq) * prec * rec / (beta_sq * prec + rec)
        }
        sum_f = sum_f + fb
    }

    free(pr as ptr<void>)
    return sum_f / (n_classes as f32)
}

export function median_absolute_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let errors: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        errors[i] = fabs((y_true[i] - y_pred[i]) as f64) as f32
    }

    for i in 1 to n {
        let key: f32 = errors[i]
        let mut j: i32 = i - 1
        while j >= 0 && errors[j] > key {
            errors[j + 1] = errors[j]
            j = j - 1
        }
        errors[j + 1] = key
    }

    let median: f32 = 0.0
    if n % 2 == 0 {
        median = (errors[n / 2 - 1] + errors[n / 2]) / 2.0
    } else {
        median = errors[n / 2]
    }

    array_free_f32(errors)
    return median
}

export function max_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut max_err: f32 = fabs((y_true[0] - y_pred[0]) as f64) as f32
    for i in 1 to n {
        let err: f32 = fabs((y_true[i] - y_pred[i]) as f64) as f32
        if err > max_err {
            max_err = err
        }
    }
    return max_err
}

export function mean_squared_log_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let log_true: f32 = log((y_true[i] + 1.0) as f64) as f32
        let log_pred: f32 = log((y_pred[i] + 1.0) as f64) as f32
        let d: f32 = log_true - log_pred
        sum = sum + d * d
    }
    return sum / (n as f32)
}

export function silhouette_score(X: Matrix, labels: ptr<i32>, n: i32) -> f32 {
    let mut total: f32 = 0.0

    for i in 0 to n {
        let label_i: i32 = labels[i]

        let mut a_i: f32 = 0.0
        let mut count_same: i32 = 0
        for j in 0 to n {
            if i != j && labels[j] == label_i {
                let mut dist: f32 = 0.0
                for k in 0 to X.cols {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    dist = dist + d * d
                }
                a_i = a_i + sqrt(dist as f64) as f32
                count_same = count_same + 1
            }
        }
        if count_same > 0 {
            a_i = a_i / (count_same as f32)
        }

        let mut best_b: f32 = 1e10
        let mut found_other: bool = false
        for c in 0 to 100 {
            let mut has_cluster: bool = false
            for j in 0 to n {
                if labels[j] == c && c != label_i {
                    has_cluster = true
                    break
                }
            }
            if !has_cluster { continue }

            let mut b_i: f32 = 0.0
            let mut count_other: i32 = 0
            for j in 0 to n {
                if labels[j] == c {
                    let mut dist: f32 = 0.0
                    for k in 0 to X.cols {
                        let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                        dist = dist + d * d
                    }
                    b_i = b_i + sqrt(dist as f64) as f32
                    count_other = count_other + 1
                }
            }
            if count_other > 0 {
                b_i = b_i / (count_other as f32)
                if b_i < best_b {
                    best_b = b_i
                    found_other = true
                }
            }
        }

        if !found_other {
            total = total + 0.0
        } else {
            let denom: f32 = a_i
            if best_b > denom {
                total = total + (best_b - a_i) / best_b
            } else {
                total = total + (best_b - a_i) / denom
            }
        }
    }

    return total / (n as f32)
}

# ============================================================================
# Adjusted Rand Index (ARI)
# ============================================================================

export function adjusted_rand_index(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }

    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    let mut sum_comb_c: f32 = 0.0
    for i in 0 to n_classes {
        for j in 0 to n_clusters {
            let n_ij: f32 = contingency[i][j] as f32
            sum_comb_c = sum_comb_c + n_ij * (n_ij - 1.0) / 2.0
        }
    }

    let mut sum_comb_a: f32 = 0.0
    for i in 0 to n_classes {
        let n_i: f32 = a[i] as f32
        sum_comb_a = sum_comb_a + n_i * (n_i - 1.0) / 2.0
    }

    let mut sum_comb_b: f32 = 0.0
    for j in 0 to n_clusters {
        let n_j: f32 = b[j] as f32
        sum_comb_b = sum_comb_b + n_j * (n_j - 1.0) / 2.0
    }

    let n_f: f32 = n as f32
    let total_pairs: f32 = n_f * (n_f - 1.0) / 2.0
    let expected: f32 = sum_comb_a * sum_comb_b / total_pairs
    let max_index: f32 = (sum_comb_a + sum_comb_b) / 2.0

    if max_index == expected { return 1.0 }
    return (sum_comb_c - expected) / (max_index - expected)
}

# ============================================================================
# Normalized Mutual Information (NMI)
# ============================================================================

export function normalized_mutual_info(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }

    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    let mut mi: f32 = 0.0
    for i in 0 to n_classes {
        for j in 0 to n_clusters {
            if contingency[i][j] == 0 { continue }
            let p_ij: f32 = contingency[i][j] as f32 / (n as f32)
            let p_i: f32 = a[i] as f32 / (n as f32)
            let p_j: f32 = b[j] as f32 / (n as f32)
            mi = mi + p_ij * log((p_ij / (p_i * p_j)) as f64) as f32
        }
    }

    let mut h_a: f32 = 0.0
    for i in 0 to n_classes {
        if a[i] == 0 { continue }
        let p_i: f32 = a[i] as f32 / (n as f32)
        h_a = h_a - p_i * log((p_i) as f64) as f32
    }

    let mut h_b: f32 = 0.0
    for j in 0 to n_clusters {
        if b[j] == 0 { continue }
        let p_j: f32 = b[j] as f32 / (n as f32)
        h_b = h_b - p_j * log((p_j) as f64) as f32
    }

    let denom: f32 = (h_a + h_b) / 2.0
    if denom < 1e-10 { return 0.0 }
    return mi / denom
}

# ============================================================================
# V-measure
# ============================================================================

export function v_measure_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }

    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    let mut h_c_k: f32 = 0.0
    for k in 0 to n_clusters {
        if b[k] == 0 { continue }
        let p_k: f32 = b[k] as f32 / (n as f32)
        for c in 0 to n_classes {
            if contingency[c][k] == 0 { continue }
            let p_ck: f32 = contingency[c][k] as f32 / (b[k] as f32)
            h_c_k = h_c_k - p_k * p_ck * log((p_ck) as f64) as f32
        }
    }

    let mut h_c: f32 = 0.0
    for c in 0 to n_classes {
        if a[c] == 0 { continue }
        let p_c: f32 = a[c] as f32 / (n as f32)
        h_c = h_c - p_c * log((p_c) as f64) as f32
    }

    let homogeneity: f32 = 1.0 - h_c_k / (h_c + 1e-10)

    let mut h_k_c: f32 = 0.0
    for c in 0 to n_classes {
        if a[c] == 0 { continue }
        let p_c: f32 = a[c] as f32 / (n as f32)
        for k in 0 to n_clusters {
            if contingency[c][k] == 0 { continue }
            let p_kc: f32 = contingency[c][k] as f32 / (a[c] as f32)
            h_k_c = h_k_c - p_c * p_kc * log((p_kc) as f64) as f32
        }
    }

    let mut h_k: f32 = 0.0
    for k in 0 to n_clusters {
        if b[k] == 0 { continue }
        let p_k: f32 = b[k] as f32 / (n as f32)
        h_k = h_k - p_k * log((p_k) as f64) as f32
    }

    let completeness: f32 = 1.0 - h_k_c / (h_k + 1e-10)

    if homogeneity + completeness < 1e-10 { return 0.0 }
    return 2.0 * homogeneity * completeness / (homogeneity + completeness)
}

# ============================================================================
# Jaccard Score
# ============================================================================

export function jaccard_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    let mut fn_: i32 = 0
    for i in 0 to n {
        if y_true[i] == 1.0 && y_pred[i] == 1.0 { tp = tp + 1 }
        if y_true[i] == 0.0 && y_pred[i] == 1.0 { fp = fp + 1 }
        if y_true[i] == 1.0 && y_pred[i] == 0.0 { fn_ = fn_ + 1 }
    }
    let denom: i32 = tp + fp + fn_
    if denom == 0 { return 0.0 }
    return (tp as f32) / (denom as f32)
}

# ============================================================================
# Brier Score
# ============================================================================

export function brier_score_loss(y_true: ptr<f32>, y_prob: ptr<f32>, n: i32) -> f32 {
    let mut total: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y_true[i] - y_prob[i]
        total = total + d * d
    }
    return total / (n as f32)
}

# ============================================================================
# Pairwise Distances
# ============================================================================

export function euclidean_distances(X: Matrix, Y: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, Y.rows)
    for i in 0 to X.rows {
        for j in 0 to Y.rows {
            let mut s: f32 = 0.0
            for k in 0 to X.cols {
                let d: f32 = matrix_at(X, i, k) - matrix_at(Y, j, k)
                s = s + d * d
            }
            matrix_set(result, i, j, sqrt((s as f64)) as f32)
        }
    }
    return result
}

export function manhattan_distances(X: Matrix, Y: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, Y.rows)
    for i in 0 to X.rows {
        for j in 0 to Y.rows {
            let mut s: f32 = 0.0
            for k in 0 to X.cols {
                s = s + fabs((matrix_at(X, i, k) - matrix_at(Y, j, k)) as f64) as f32
            }
            matrix_set(result, i, j, s)
        }
    }
    return result
}

export function cosine_distances(X: Matrix, Y: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, Y.rows)
    for i in 0 to X.rows {
        let mut norm_x: f32 = 0.0
        for k in 0 to X.cols {
            norm_x = norm_x + matrix_at(X, i, k) * matrix_at(X, i, k)
        }
        norm_x = sqrt((norm_x as f64)) as f32
        if norm_x < 1e-10 { norm_x = 1e-10 }

        for j in 0 to Y.rows {
            let mut dot: f32 = 0.0
            let mut norm_y: f32 = 0.0
            for k in 0 to Y.cols {
                dot = dot + matrix_at(X, i, k) * matrix_at(Y, j, k)
                norm_y = norm_y + matrix_at(Y, j, k) * matrix_at(Y, j, k)
            }
            norm_y = sqrt((norm_y as f64)) as f32
            if norm_y < 1e-10 { norm_y = 1e-10 }
            let cos_sim: f32 = dot / (norm_x * norm_y)
            matrix_set(result, i, j, 1.0 - cos_sim)
        }
    }
    return result
}

# Multi-class metrics (One-vs-Rest and One-vs-One)
# ============================================================================

export struct MultiClassMetric {
    per_class: ptr<f32>,
    n_classes: i32,
    macro_avg: f32,
    micro_avg: f32,
    weighted_avg: f32
}

export function multiclass_precision_ovr(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> MultiClassMetric {
    let per_class: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    for c in 0 to n_classes {
        let mut tp: i32 = 0
        let mut fp: i32 = 0
        let mut fn_: i32 = 0

        for i in 0 to n {
            let true_pos: bool = y_true[i] == classes[c]
            let pred_pos: bool = y_pred[i] == classes[c]

            if true_pos && pred_pos { tp = tp + 1 }
            if not true_pos && pred_pos { fp = fp + 1 }
            if true_pos && not pred_pos { fn_ = fn_ + 1 }
        }

        let denom: i32 = tp + fp
        if denom > 0 {
            per_class[c] = (tp as f32) / (denom as f32)
        } else {
            per_class[c] = 0.0
        }
        class_counts[c] = tp + fn_
    }

    let mut macro: f32 = 0.0
    let mut weighted: f32 = 0.0
    let mut total_count: i32 = 0
    for c in 0 to n_classes {
        macro = macro + per_class[c]
        weighted = weighted + per_class[c] * (class_counts[c] as f32)
        total_count = total_count + class_counts[c]
    }
    macro = macro / (n_classes as f32)
    if total_count > 0 {
        weighted = weighted / (total_count as f32)
    }

    let mut micro_tp: i32 = 0
    let mut micro_fp: i32 = 0
    for i in 0 to n {
        if y_true[i] == y_pred[i] {
            micro_tp = micro_tp + 1
        } else {
            micro_fp = micro_fp + 1
        }
    }
    let micro: f32 = 0.0
    if micro_tp + micro_fp > 0 {
        micro = (micro_tp as f32) / ((micro_tp + micro_fp) as f32)
    }

    free(class_counts as ptr<void>)

    return MultiClassMetric {
        per_class: per_class,
        n_classes: n_classes,
        macro_avg: macro,
        micro_avg: micro,
        weighted_avg: weighted
    }
}

export function multiclass_recall_ovr(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> MultiClassMetric {
    let per_class: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    for c in 0 to n_classes {
        let mut tp: i32 = 0
        let mut fn_: i32 = 0

        for i in 0 to n {
            let true_pos: bool = y_true[i] == classes[c]
            let pred_pos: bool = y_pred[i] == classes[c]

            if true_pos && pred_pos { tp = tp + 1 }
            if true_pos && not pred_pos { fn_ = fn_ + 1 }
        }

        let denom: i32 = tp + fn_
        if denom > 0 {
            per_class[c] = (tp as f32) / (denom as f32)
        } else {
            per_class[c] = 0.0
        }
        class_counts[c] = denom
    }

    let mut macro: f32 = 0.0
    let mut weighted: f32 = 0.0
    let mut total_count: i32 = 0
    for c in 0 to n_classes {
        macro = macro + per_class[c]
        weighted = weighted + per_class[c] * (class_counts[c] as f32)
        total_count = total_count + class_counts[c]
    }
    macro = macro / (n_classes as f32)
    if total_count > 0 {
        weighted = weighted / (total_count as f32)
    }

    let mut micro_tp: i32 = 0
    let mut micro_fn: i32 = 0
    for i in 0 to n {
        if y_true[i] == y_pred[i] {
            micro_tp = micro_tp + 1
        } else {
            micro_fn = micro_fn + 1
        }
    }
    let micro: f32 = 0.0
    if micro_tp + micro_fn > 0 {
        micro = (micro_tp as f32) / ((micro_tp + micro_fn) as f32)
    }

    free(class_counts as ptr<void>)

    return MultiClassMetric {
        per_class: per_class,
        n_classes: n_classes,
        macro_avg: macro,
        micro_avg: micro,
        weighted_avg: weighted
    }
}

export function multiclass_f1_ovr(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> MultiClassMetric {
    let prec: MultiClassMetric = multiclass_precision_ovr(y_true, y_pred, n, classes, n_classes)
    let rec: MultiClassMetric = multiclass_recall_ovr(y_true, y_pred, n, classes, n_classes)

    let per_class: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes {
        let p: f32 = prec.per_class[c]
        let r: f32 = rec.per_class[c]
        if p + r > 0.0 {
            per_class[c] = 2.0 * p * r / (p + r)
        } else {
            per_class[c] = 0.0
        }
    }

    let mut macro: f32 = 0.0
    let mut weighted: f32 = 0.0
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let mut total_count: i32 = 0
    for c in 0 to n_classes {
        let mut count: i32 = 0
        for i in 0 to n {
            if y_true[i] == classes[c] { count = count + 1 }
        }
        class_counts[c] = count
        macro = macro + per_class[c]
        weighted = weighted + per_class[c] * (count as f32)
        total_count = total_count + count
    }
    macro = macro / (n_classes as f32)
    if total_count > 0 {
        weighted = weighted / (total_count as f32)
    }

    let micro: f32 = 0.0
    if prec.micro_avg + rec.micro_avg > 0.0 {
        micro = 2.0 * prec.micro_avg * rec.micro_avg / (prec.micro_avg + rec.micro_avg)
    }

    free(class_counts as ptr<void>)
    multiclass_metric_free(prec)
    multiclass_metric_free(rec)

    return MultiClassMetric {
        per_class: per_class,
        n_classes: n_classes,
        macro_avg: macro,
        micro_avg: micro,
        weighted_avg: weighted
    }
}

export function multiclass_metric_free(m: MultiClassMetric) -> void {
    array_free_f32(m.per_class)
}

export function print_multiclass_metric(name: string, m: MultiClassMetric, classes: ptr<f32>) -> void {
    print("  ")
    print(name)
    println(" (OvR):")
    for c in 0 to m.n_classes {
        print("    class ")
        print(classes[c])
        print(": ")
        printf("%.4f", m.per_class[c])
        println("")
    }
    print("    macro avg: ")
    printf("%.4f", m.macro_avg)
    println("")
    print("    micro avg: ")
    printf("%.4f", m.micro_avg)
    println("")
    print("    weighted avg: ")
    printf("%.4f", m.weighted_avg)
    println("")
}

# ============================================================================
# One-vs-One pairwise metrics
# ============================================================================

export struct OvOResult {
    scores: ptr<f32>,
    n_pairs: i32,
    avg: f32
}

export function multiclass_precision_ovo(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> OvOResult {
    let n_pairs: i32 = n_classes * (n_classes - 1) / 2
    let scores: ptr<f32> = array_new_f32(n_pairs)

    let mut idx: i32 = 0
    for a in 0 to n_classes {
        for b in a + 1 to n_classes {
            let mut tp: i32 = 0
            let mut fp: i32 = 0

            for i in 0 to n {
                if y_true[i] == classes[a] || y_true[i] == classes[b] {
                    if y_pred[i] == classes[a] && y_true[i] == classes[a] {
                        tp = tp + 1
                    }
                    if y_pred[i] == classes[a] && y_true[i] == classes[b] {
                        fp = fp + 1
                    }
                }
            }

            if tp + fp > 0 {
                scores[idx] = (tp as f32) / ((tp + fp) as f32)
            } else {
                scores[idx] = 0.0
            }
            idx = idx + 1
        }
    }

    let mut avg: f32 = 0.0
    for i in 0 to n_pairs {
        avg = avg + scores[i]
    }
    avg = avg / (n_pairs as f32)

    return OvOResult { scores: scores, n_pairs: n_pairs, avg: avg }
}

export function multiclass_recall_ovo(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> OvOResult {
    let n_pairs: i32 = n_classes * (n_classes - 1) / 2
    let scores: ptr<f32> = array_new_f32(n_pairs)

    let mut idx: i32 = 0
    for a in 0 to n_classes {
        for b in a + 1 to n_classes {
            let mut tp: i32 = 0
            let mut fn_: i32 = 0

            for i in 0 to n {
                if y_true[i] == classes[a] || y_true[i] == classes[b] {
                    if y_pred[i] == classes[a] && y_true[i] == classes[a] {
                        tp = tp + 1
                    }
                    if y_pred[i] == classes[b] && y_true[i] == classes[a] {
                        fn_ = fn_ + 1
                    }
                }
            }

            if tp + fn_ > 0 {
                scores[idx] = (tp as f32) / ((tp + fn_) as f32)
            } else {
                scores[idx] = 0.0
            }
            idx = idx + 1
        }
    }

    let mut avg: f32 = 0.0
    for i in 0 to n_pairs {
        avg = avg + scores[i]
    }
    avg = avg / (n_pairs as f32)

    return OvOResult { scores: scores, n_pairs: n_pairs, avg: avg }
}

export function ovo_result_free(r: OvOResult) -> void {
    array_free_f32(r.scores)
}
