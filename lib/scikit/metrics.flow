# Metrics module for flow-scikit.
# Addresses Issue #29205: classification_report returns structured output,
#   not a dict with collision-prone keys. Uses a ClassificationReport struct
#   with separate class_metrics and average_metrics arrays.
# Addresses Issue #30909: pos_label handled internally via classes_ array.
#   Metrics that need pos_label accept the estimator's classes array and
#   handle the switching internally.

import "lib/scikit/matrix.flow"
import lib.scikit.metrics_binary

# ============================================================================
# Classification metrics
# ============================================================================

export function accuracy_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    return binary_accuracy_score(y_true, y_pred, n)
}

export struct PrecisionRecall {
    precision: f32,
    recall: f32,
    f1: f32,
    support: i32
}

export function precision_recall_fscore(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> ptr<PrecisionRecall> {
    let results: ptr<PrecisionRecall> = malloc((n_classes as i64) * 16) as ptr<PrecisionRecall>

    for c in 0 to n_classes {
        let cls: f32 = classes[c]
        let mut tp: i32 = 0
        let mut fp: i32 = 0
        let mut fn: i32 = 0
        let mut support: i32 = 0

        for i in 0 to n {
            let true_cls: bool = y_true[i] == cls
            let pred_cls: bool = y_pred[i] == cls

            if true_cls && pred_cls {
                tp = tp + 1
            }
            if not true_cls && pred_cls {
                fp = fp + 1
            }
            if true_cls && not pred_cls {
                fn = fn + 1
            }
            if true_cls {
                support = support + 1
            }
        }

        let prec: f32 = 0.0
        if tp + fp > 0 {
            prec = (tp as f32) / ((tp + fp) as f32)
        }
        let rec: f32 = 0.0
        if tp + fn > 0 {
            rec = (tp as f32) / ((tp + fn) as f32)
        }
        let f1: f32 = 0.0
        if prec + rec > 0.0 {
            f1 = 2.0 * prec * rec / (prec + rec)
        }

        results[c].precision = prec
        results[c].recall = rec
        results[c].f1 = f1
        results[c].support = support
    }

    return results
}

# Binary precision_score for a given positive label.
# Matches sklearn precision_score(average='binary').
export function precision_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    return binary_precision_score(y_true, y_pred, n, pos_label)
}

# Binary recall_score for a given positive label.
# Matches sklearn recall_score(average='binary').
export function recall_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    return binary_recall_score(y_true, y_pred, n, pos_label)
}

# Binary f1_score for a given positive label.
# Matches sklearn f1_score(average='binary').
export function f1_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    return binary_f1_score(y_true, y_pred, n, pos_label)
}

# Macro-averaged precision across all classes.
export function precision_score_macro(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let mut sum: f32 = 0.0
    for c in 0 to n_classes {
        sum = sum + precision_score(y_true, y_pred, n, classes[c])
    }
    return sum / (n_classes as f32)
}

# Macro-averaged recall across all classes.
export function recall_score_macro(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let mut sum: f32 = 0.0
    for c in 0 to n_classes {
        sum = sum + recall_score(y_true, y_pred, n, classes[c])
    }
    return sum / (n_classes as f32)
}

# Macro-averaged f1 across all classes.
export function f1_score_macro(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let mut sum: f32 = 0.0
    for c in 0 to n_classes {
        sum = sum + f1_score(y_true, y_pred, n, classes[c])
    }
    return sum / (n_classes as f32)
}

export struct ClassificationReport {
    class_metrics: ptr<PrecisionRecall>,
    classes: ptr<f32>,
    n_classes: i32,
    accuracy: f32,
    macro_precision: f32,
    macro_recall: f32,
    macro_f1: f32,
    weighted_precision: f32,
    weighted_recall: f32,
    weighted_f1: f32,
    n_samples: i32
}

export function classification_report(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> ClassificationReport {
    let class_metrics: ptr<PrecisionRecall> = precision_recall_fscore(y_true, y_pred, n, classes, n_classes)
    let acc: f32 = accuracy_score(y_true, y_pred, n)

    let mut macro_p: f32 = 0.0
    let mut macro_r: f32 = 0.0
    let mut macro_f: f32 = 0.0
    let mut weighted_p: f32 = 0.0
    let mut weighted_r: f32 = 0.0
    let mut weighted_f: f32 = 0.0
    let mut total_support: i32 = 0

    for c in 0 to n_classes {
        let m: PrecisionRecall = class_metrics[c]
        macro_p = macro_p + m.precision
        macro_r = macro_r + m.recall
        macro_f = macro_f + m.f1
        weighted_p = weighted_p + m.precision * (m.support as f32)
        weighted_r = weighted_r + m.recall * (m.support as f32)
        weighted_f = weighted_f + m.f1 * (m.support as f32)
        total_support = total_support + m.support
    }

    macro_p = macro_p / (n_classes as f32)
    macro_r = macro_r / (n_classes as f32)
    macro_f = macro_f / (n_classes as f32)

    if total_support > 0 {
        weighted_p = weighted_p / (total_support as f32)
        weighted_r = weighted_r / (total_support as f32)
        weighted_f = weighted_f / (total_support as f32)
    }

    return ClassificationReport {
        class_metrics: class_metrics,
        classes: classes,
        n_classes: n_classes,
        accuracy: acc,
        macro_precision: macro_p,
        macro_recall: macro_r,
        macro_f1: macro_f,
        weighted_precision: weighted_p,
        weighted_recall: weighted_r,
        weighted_f1: weighted_f,
        n_samples: n
    }
}

export function print_classification_report(report: ClassificationReport) -> void {
    println("")
    println("              precision    recall  f1-score   support")
    println("")

    for c in 0 to report.n_classes {
        let m: PrecisionRecall = report.class_metrics[c]
        print("  class ")
        print(report.classes[c])
        print("       ")
        printf("%.4f", m.precision)
        print("   ")
        printf("%.4f", m.recall)
        print("   ")
        printf("%.4f", m.f1)
        print("     ")
        print(m.support)
        println("")
    }

    println("")
    print("  accuracy                          ")
    printf("%.4f", report.accuracy)
    print("     ")
    print(report.n_samples)
    println("")
    print("  macro avg     ")
    printf("%.4f", report.macro_precision)
    print("   ")
    printf("%.4f", report.macro_recall)
    print("   ")
    printf("%.4f", report.macro_f1)
    print("     ")
    print(report.n_samples)
    println("")
    print("  weighted avg  ")
    printf("%.4f", report.weighted_precision)
    print("   ")
    printf("%.4f", report.weighted_recall)
    print("   ")
    printf("%.4f", report.weighted_f1)
    print("     ")
    print(report.n_samples)
    println("")
}

export function classification_report_free(report: ClassificationReport) -> void {
    free(report.class_metrics as ptr<void>)
}

# ============================================================================
# pos_label-aware metrics (Issue #30909)
# Accept the estimator's classes_ array and handle pos_label internally.
# ============================================================================

export function roc_auc_score(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, classes: ptr<f32>, pos_label: f32) -> f32 {
    let mut pos_count: i32 = 0
    let mut neg_count: i32 = 0

    for i in 0 to n {
        if y_true[i] == pos_label {
            pos_count = pos_count + 1
        } else {
            neg_count = neg_count + 1
        }
    }

    if pos_count == 0 || neg_count == 0 {
        return 0.0
    }

    let mut auc: f32 = 0.0
    for i in 0 to n {
        if y_true[i] == pos_label {
            for j in 0 to n {
                if y_true[j] != pos_label {
                    if y_score[i] > y_score[j] {
                        auc = auc + 1.0
                    } elif y_score[i] == y_score[j] {
                        auc = auc + 0.5
                    }
                }
            }
        }
    }

    return auc / ((pos_count as f32) * (neg_count as f32))
}

export function precision_at_threshold(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32, threshold: f32) -> f32 {
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    for i in 0 to n {
        let predicted_pos: bool = y_score[i] >= threshold
        let actual_pos: bool = y_true[i] == pos_label
        if predicted_pos && actual_pos {
            tp = tp + 1
        }
        if predicted_pos && not actual_pos {
            fp = fp + 1
        }
    }
    if tp + fp == 0 {
        return 0.0
    }
    return (tp as f32) / ((tp + fp) as f32)
}

export function recall_at_threshold(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32, threshold: f32) -> f32 {
    let mut tp: i32 = 0
    let mut fn: i32 = 0
    for i in 0 to n {
        let predicted_pos: bool = y_score[i] >= threshold
        let actual_pos: bool = y_true[i] == pos_label
        if predicted_pos && actual_pos {
            tp = tp + 1
        }
        if not predicted_pos && actual_pos {
            fn = fn + 1
        }
    }
    if tp + fn == 0 {
        return 0.0
    }
    return (tp as f32) / ((tp + fn) as f32)
}

# ============================================================================
# Regression metrics
# ============================================================================

export function mean_squared_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y_true[i] - y_pred[i]
        sum = sum + d * d
    }
    return sum / (n as f32)
}

export function root_mean_squared_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    return sqrt(mean_squared_error(y_true, y_pred, n) as f64) as f32
}

export function mean_absolute_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y_true[i] - y_pred[i]
        if d < 0.0 {
            sum = sum - d
        } else {
            sum = sum + d
        }
    }
    return sum / (n as f32)
}

export function r2_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mean: f32 = array_mean(y_true, n)
    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    for i in 0 to n {
        let d_res: f32 = y_true[i] - y_pred[i]
        ss_res = ss_res + d_res * d_res
        let d_tot: f32 = y_true[i] - mean
        ss_tot = ss_tot + d_tot * d_tot
    }
    if ss_tot < 0.0000000001 {
        if ss_res < 0.0000000001 { return 1.0 }
        return 0.0
    }
    return 1.0 - ss_res / ss_tot
}

# ============================================================================
# Confusion matrix
# ============================================================================

export struct ConfusionMatrix {
    matrix: ptr<i32>,
    n_classes: i32,
    classes: ptr<f32>
}

export function confusion_matrix(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> ConfusionMatrix {
    let cm: ptr<i32> = malloc((n_classes * n_classes) as i64 * 4) as ptr<i32>
    for i in 0 to n_classes * n_classes {
        cm[i] = 0
    }

    for i in 0 to n {
        let mut true_idx: i32 = -1
        let mut pred_idx: i32 = -1
        for c in 0 to n_classes {
            if classes[c] == y_true[i] {
                true_idx = c
            }
            if classes[c] == y_pred[i] {
                pred_idx = c
            }
        }
        if true_idx >= 0 && pred_idx >= 0 {
            cm[true_idx * n_classes + pred_idx] = cm[true_idx * n_classes + pred_idx] + 1
        }
    }

    return ConfusionMatrix { matrix: cm, n_classes: n_classes, classes: classes }
}

export function print_confusion_matrix(cm: ConfusionMatrix) -> void {
    println("")
    print("  ")
    for c in 0 to cm.n_classes {
        print("  pred ")
        print(c)
        print("  ")
    }
    println("")

    for r in 0 to cm.n_classes {
        print("  true ")
        print(r)
        for c in 0 to cm.n_classes {
            let val: i32 = cm.matrix[r * cm.n_classes + c]
            if val < 10 {
                print("    ")
            } elif val < 100 {
                print("   ")
            } else {
                print("  ")
            }
            print(val)
            print("  ")
        }
        println("")
    }
}

export function confusion_matrix_free(cm: ConfusionMatrix) -> void {
    free(cm.matrix as ptr<void>)
}

# ============================================================================
# ROC curve
# ============================================================================

export struct ROCPoint {
    fpr: f32,
    tpr: f32,
    threshold: f32
}

export struct ROCCurve {
    points: ptr<ROCPoint>,
    n_points: i32,
    auc: f32
}

export function roc_curve(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32) -> ROCCurve {
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }

    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if y_score[indices[j]] > y_score[indices[max_idx]] {
                max_idx = j
            }
        }
        let tmp: i32 = indices[i]
        indices[i] = indices[max_idx]
        indices[max_idx] = tmp
    }

    let mut n_pos: i32 = 0
    let mut n_neg: i32 = 0
    for i in 0 to n {
        if y_true[i] == pos_label {
            n_pos = n_pos + 1
        } else {
            n_neg = n_neg + 1
        }
    }

    let max_points: i32 = n + 2
    let points: ptr<ROCPoint> = malloc((max_points as i64) * 16) as ptr<ROCPoint>
    let mut n_points: i32 = 0

    let mut tp: i32 = 0
    let mut fp: i32 = 0

    points[n_points].fpr = 0.0
    points[n_points].tpr = 0.0
    points[n_points].threshold = y_score[indices[0]] + 1.0
    n_points = n_points + 1

    for i in 0 to n {
        if y_true[indices[i]] == pos_label {
            tp = tp + 1
        } else {
            fp = fp + 1
        }

        let fpr: f32 = (fp as f32) / (n_neg as f32)
        let tpr: f32 = (tp as f32) / (n_pos as f32)

        points[n_points].fpr = fpr
        points[n_points].tpr = tpr
        points[n_points].threshold = y_score[indices[i]]
        n_points = n_points + 1
    }

    let auc: f32 = 0.0
    for i in 1 to n_points {
        let width: f32 = points[i].fpr - points[i - 1].fpr
        let height: f32 = (points[i].tpr + points[i - 1].tpr) / 2.0
        auc = auc + width * height
    }

    free(indices as ptr<void>)

    return ROCCurve { points: points, n_points: n_points, auc: auc }
}

export function roc_curve_free(curve: ROCCurve) -> void {
    free(curve.points as ptr<void>)
}

# ============================================================================
# Precision-Recall curve
# ============================================================================

export struct PRPoint {
    precision: f32,
    recall: f32,
    threshold: f32
}

export struct PRCurve {
    points: ptr<PRPoint>,
    n_points: i32
}

export function precision_recall_curve(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32) -> PRCurve {
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }

    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if y_score[indices[j]] > y_score[indices[max_idx]] {
                max_idx = j
            }
        }
        let tmp: i32 = indices[i]
        indices[i] = indices[max_idx]
        indices[max_idx] = tmp
    }

    let mut n_pos: i32 = 0
    for i in 0 to n {
        if y_true[i] == pos_label {
            n_pos = n_pos + 1
        }
    }

    let max_points: i32 = n + 2
    let points: ptr<PRPoint> = malloc((max_points as i64) * 16) as ptr<PRPoint>
    let mut n_points: i32 = 0

    let mut tp: i32 = 0
    let mut fp: i32 = 0

    points[n_points].precision = 1.0
    points[n_points].recall = 0.0
    points[n_points].threshold = y_score[indices[0]] + 1.0
    n_points = n_points + 1

    for i in 0 to n {
        if y_true[indices[i]] == pos_label {
            tp = tp + 1
        } else {
            fp = fp + 1
        }

        let prec: f32 = (tp as f32) / ((tp + fp) as f32)
        let rec: f32 = (tp as f32) / (n_pos as f32)

        points[n_points].precision = prec
        points[n_points].recall = rec
        points[n_points].threshold = y_score[indices[i]]
        n_points = n_points + 1
    }

    free(indices as ptr<void>)

    return PRCurve { points: points, n_points: n_points }
}

export function pr_curve_free(curve: PRCurve) -> void {
    free(curve.points as ptr<void>)
}

# ============================================================================
# Log loss (cross-entropy)
# ============================================================================

export function log_loss(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let p: f32 = y_pred[i]
        if p > 1.0 - 0.0000000001 {
            p = 1.0 - 0.0000000001
        }
        if p < 0.0000000001 {
            p = 0.0000000001
        }
        if y_true[i] == pos_label {
            sum = sum - log(p as f64) as f32
        } else {
            sum = sum - log((1.0 - p) as f64) as f32
        }
    }
    return sum / (n as f32)
}

# ============================================================================
# Cohen's Kappa
# ============================================================================

export function cohen_kappa(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let cm: ConfusionMatrix = confusion_matrix(y_true, y_pred, n, classes, n_classes)

    let mut po: f32 = 0.0
    for c in 0 to n_classes {
        po = po + (cm.matrix[c * n_classes + c] as f32)
    }
    po = po / (n as f32)

    let mut pe: f32 = 0.0
    for c in 0 to n_classes {
        let row_sum: f32 = 0.0
        let col_sum: f32 = 0.0
        for k in 0 to n_classes {
            row_sum = row_sum + (cm.matrix[c * n_classes + k] as f32)
            col_sum = col_sum + (cm.matrix[k * n_classes + c] as f32)
        }
        pe = pe + (row_sum / (n as f32)) * (col_sum / (n as f32))
    }

    confusion_matrix_free(cm)

    if pe > 1.0 - 0.0000000001 {
        return 0.0
    }
    return (po - pe) / (1.0 - pe)
}

# ============================================================================
# Matthews Correlation Coefficient
# ============================================================================

export function matthews_corrcoef(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    let mut tp: i32 = 0
    let mut tn: i32 = 0
    let mut fp: i32 = 0
    let mut fn: i32 = 0

    for i in 0 to n {
        let actual_pos: bool = y_true[i] == pos_label
        let pred_pos: bool = y_pred[i] == pos_label

        if actual_pos && pred_pos {
            tp = tp + 1
        } elif not actual_pos && not pred_pos {
            tn = tn + 1
        } elif not actual_pos && pred_pos {
            fp = fp + 1
        } else {
            fn = fn + 1
        }
    }

    let numerator: f32 = ((tp as f32) * (tn as f32) - (fp as f32) * (fn as f32))
    let denominator: f32 = sqrt((((tp + fp) as f32) * ((tp + fn) as f32) * ((tn + fp) as f32) * ((tn + fn) as f32)) as f64) as f32

    if denominator < 0.0000000001 {
        return 0.0
    }
    return numerator / denominator
}

# ============================================================================
# Hinge loss
# ============================================================================

export function hinge_loss(y_true: ptr<f32>, y_decision: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let label: f32 = 1.0
        if y_true[i] != pos_label {
            label = -1.0
        }
        let margin: f32 = 1.0 - label * y_decision[i]
        if margin > 0.0 {
            sum = sum + margin
        }
    }
    return sum / (n as f32)
}

# ============================================================================
# Explained variance score
# ============================================================================

export function explained_variance_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    if n < 2 {
        print("[flow-scikit] WARNING: explained_variance_score ill-defined with ")
        print(n)
        println(" samples, returning NaN")
        return 0.0 / 0.0
    }
    let mean_true: f32 = array_mean(y_true, n)
    let mut var_diff: f32 = 0.0
    let mut var_true: f32 = 0.0
    for i in 0 to n {
        let d_diff: f32 = y_true[i] - y_pred[i]
        let d_true: f32 = y_true[i] - mean_true
        var_diff = var_diff + d_diff * d_diff
        var_true = var_true + d_true * d_true
    }
    if var_true < 0.0000000001 {
        print("[flow-scikit] WARNING: explained_variance_score ill-defined (zero variance in y_true), returning NaN")
        return 0.0 / 0.0
    }
    return 1.0 - var_diff / var_true
}

# ============================================================================
# Balanced accuracy
# ============================================================================

export function balanced_accuracy_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let mut sum_recall: f32 = 0.0
    for c in 0 to n_classes {
        let cls: f32 = classes[c]
        let mut tp: i32 = 0
        let mut total: i32 = 0
        for i in 0 to n {
            if y_true[i] == cls {
                total = total + 1
                if y_pred[i] == cls {
                    tp = tp + 1
                }
            }
        }
        if total > 0 {
            sum_recall = sum_recall + (tp as f32) / (total as f32)
        }
    }
    return sum_recall / (n_classes as f32)
}

# ============================================================================
# F-beta score
# ============================================================================

export function fbeta_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32, beta: f32) -> f32 {
    let beta_sq: f32 = beta * beta
    let pr: ptr<PrecisionRecall> = precision_recall_fscore(y_true, y_pred, n, classes, n_classes)

    let mut sum_f: f32 = 0.0
    for c in 0 to n_classes {
        let prec: f32 = pr[c].precision
        let rec: f32 = pr[c].recall
        let fb: f32 = 0.0
        if prec + rec > 0.0 {
            fb = (1.0 + beta_sq) * prec * rec / (beta_sq * prec + rec)
        }
        sum_f = sum_f + fb
    }

    free(pr as ptr<void>)
    return sum_f / (n_classes as f32)
}

export function median_absolute_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let errors: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        errors[i] = fabs((y_true[i] - y_pred[i]) as f64) as f32
    }

    for i in 1 to n {
        let key: f32 = errors[i]
        let mut j: i32 = i - 1
        while j >= 0 && errors[j] > key {
            errors[j + 1] = errors[j]
            j = j - 1
        }
        errors[j + 1] = key
    }

    let median: f32 = 0.0
    if n % 2 == 0 {
        median = (errors[n / 2 - 1] + errors[n / 2]) / 2.0
    } else {
        median = errors[n / 2]
    }

    array_free_f32(errors)
    return median
}

export function max_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut max_err: f32 = fabs((y_true[0] - y_pred[0]) as f64) as f32
    for i in 1 to n {
        let err: f32 = fabs((y_true[i] - y_pred[i]) as f64) as f32
        if err > max_err {
            max_err = err
        }
    }
    return max_err
}

export function mean_squared_log_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let log_true: f32 = log((y_true[i] + 1.0) as f64) as f32
        let log_pred: f32 = log((y_pred[i] + 1.0) as f64) as f32
        let d: f32 = log_true - log_pred
        sum = sum + d * d
    }
    return sum / (n as f32)
}

export function silhouette_score(X: Matrix, labels: ptr<i32>, n: i32) -> f32 {
    let mut total: f32 = 0.0

    for i in 0 to n {
        let label_i: i32 = labels[i]

        let mut a_i: f32 = 0.0
        let mut count_same: i32 = 0
        for j in 0 to n {
            if i != j && labels[j] == label_i {
                let mut dist: f32 = 0.0
                for k in 0 to X.cols {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    dist = dist + d * d
                }
                a_i = a_i + sqrt(dist as f64) as f32
                count_same = count_same + 1
            }
        }
        if count_same > 0 {
            a_i = a_i / (count_same as f32)
        }

        let mut best_b: f32 = 10000000000.0
        let mut found_other: bool = false
        for c in 0 to 100 {
            let mut has_cluster: bool = false
            for j in 0 to n {
                if labels[j] == c && c != label_i {
                    has_cluster = true
                    break
                }
            }
            if !has_cluster { continue }

            let mut b_i: f32 = 0.0
            let mut count_other: i32 = 0
            for j in 0 to n {
                if labels[j] == c {
                    let mut dist: f32 = 0.0
                    for k in 0 to X.cols {
                        let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                        dist = dist + d * d
                    }
                    b_i = b_i + sqrt(dist as f64) as f32
                    count_other = count_other + 1
                }
            }
            if count_other > 0 {
                b_i = b_i / (count_other as f32)
                if b_i < best_b {
                    best_b = b_i
                    found_other = true
                }
            }
        }

        if !found_other {
            total = total + 0.0
        } else {
            let denom: f32 = a_i
            if best_b > denom {
                total = total + (best_b - a_i) / best_b
            } else {
                total = total + (best_b - a_i) / denom
            }
        }
    }

    return total / (n as f32)
}

# ============================================================================
# Adjusted Rand Index (ARI)
# ============================================================================

export function adjusted_rand_index(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }

    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    let mut sum_comb_c: f32 = 0.0
    for i in 0 to n_classes {
        for j in 0 to n_clusters {
            let n_ij: f32 = contingency[i][j] as f32
            sum_comb_c = sum_comb_c + n_ij * (n_ij - 1.0) / 2.0
        }
    }

    let mut sum_comb_a: f32 = 0.0
    for i in 0 to n_classes {
        let n_i: f32 = a[i] as f32
        sum_comb_a = sum_comb_a + n_i * (n_i - 1.0) / 2.0
    }

    let mut sum_comb_b: f32 = 0.0
    for j in 0 to n_clusters {
        let n_j: f32 = b[j] as f32
        sum_comb_b = sum_comb_b + n_j * (n_j - 1.0) / 2.0
    }

    let n_f: f32 = n as f32
    let total_pairs: f32 = n_f * (n_f - 1.0) / 2.0
    let expected: f32 = sum_comb_a * sum_comb_b / total_pairs
    let max_index: f32 = (sum_comb_a + sum_comb_b) / 2.0

    if max_index == expected { return 1.0 }
    return (sum_comb_c - expected) / (max_index - expected)
}

# ============================================================================
# Normalized Mutual Information (NMI)
# ============================================================================

export function normalized_mutual_info(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }

    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    let mut mi: f32 = 0.0
    for i in 0 to n_classes {
        for j in 0 to n_clusters {
            if contingency[i][j] == 0 { continue }
            let p_ij: f32 = contingency[i][j] as f32 / (n as f32)
            let p_i: f32 = a[i] as f32 / (n as f32)
            let p_j: f32 = b[j] as f32 / (n as f32)
            mi = mi + p_ij * log((p_ij / (p_i * p_j)) as f64) as f32
        }
    }

    let mut h_a: f32 = 0.0
    for i in 0 to n_classes {
        if a[i] == 0 { continue }
        let p_i: f32 = a[i] as f32 / (n as f32)
        h_a = h_a - p_i * log((p_i) as f64) as f32
    }

    let mut h_b: f32 = 0.0
    for j in 0 to n_clusters {
        if b[j] == 0 { continue }
        let p_j: f32 = b[j] as f32 / (n as f32)
        h_b = h_b - p_j * log((p_j) as f64) as f32
    }

    let denom: f32 = (h_a + h_b) / 2.0
    if denom < 0.0000000001 { return 0.0 }
    return mi / denom
}

# ============================================================================
# V-measure
# ============================================================================

export function v_measure_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }

    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    let mut h_c_k: f32 = 0.0
    for k in 0 to n_clusters {
        if b[k] == 0 { continue }
        let p_k: f32 = b[k] as f32 / (n as f32)
        for c in 0 to n_classes {
            if contingency[c][k] == 0 { continue }
            let p_ck: f32 = contingency[c][k] as f32 / (b[k] as f32)
            h_c_k = h_c_k - p_k * p_ck * log((p_ck) as f64) as f32
        }
    }

    let mut h_c: f32 = 0.0
    for c in 0 to n_classes {
        if a[c] == 0 { continue }
        let p_c: f32 = a[c] as f32 / (n as f32)
        h_c = h_c - p_c * log((p_c) as f64) as f32
    }

    let homogeneity: f32 = 1.0 - h_c_k / (h_c + 0.0000000001)

    let mut h_k_c: f32 = 0.0
    for c in 0 to n_classes {
        if a[c] == 0 { continue }
        let p_c: f32 = a[c] as f32 / (n as f32)
        for k in 0 to n_clusters {
            if contingency[c][k] == 0 { continue }
            let p_kc: f32 = contingency[c][k] as f32 / (a[c] as f32)
            h_k_c = h_k_c - p_c * p_kc * log((p_kc) as f64) as f32
        }
    }

    let mut h_k: f32 = 0.0
    for k in 0 to n_clusters {
        if b[k] == 0 { continue }
        let p_k: f32 = b[k] as f32 / (n as f32)
        h_k = h_k - p_k * log((p_k) as f64) as f32
    }

    let completeness: f32 = 1.0 - h_k_c / (h_k + 0.0000000001)

    if homogeneity + completeness < 0.0000000001 { return 0.0 }
    return 2.0 * homogeneity * completeness / (homogeneity + completeness)
}

# ============================================================================
# Jaccard Score
# ============================================================================

export function jaccard_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    let mut fn_: i32 = 0
    for i in 0 to n {
        if y_true[i] == 1.0 && y_pred[i] == 1.0 { tp = tp + 1 }
        if y_true[i] == 0.0 && y_pred[i] == 1.0 { fp = fp + 1 }
        if y_true[i] == 1.0 && y_pred[i] == 0.0 { fn_ = fn_ + 1 }
    }
    let denom: i32 = tp + fp + fn_
    if denom == 0 { return 0.0 }
    return (tp as f32) / (denom as f32)
}

# ============================================================================
# Brier Score
# ============================================================================

export function brier_score_loss(y_true: ptr<f32>, y_prob: ptr<f32>, n: i32) -> f32 {
    let mut total: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y_true[i] - y_prob[i]
        total = total + d * d
    }
    return total / (n as f32)
}

# ============================================================================
# Pairwise Distances
# ============================================================================

export function euclidean_distances(X: Matrix, Y: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, Y.rows)
    for i in 0 to X.rows {
        for j in 0 to Y.rows {
            let mut s: f32 = 0.0
            for k in 0 to X.cols {
                let d: f32 = matrix_at(X, i, k) - matrix_at(Y, j, k)
                s = s + d * d
            }
            matrix_set(result, i, j, sqrt((s as f64)) as f32)
        }
    }
    return result
}

export function manhattan_distances(X: Matrix, Y: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, Y.rows)
    for i in 0 to X.rows {
        for j in 0 to Y.rows {
            let mut s: f32 = 0.0
            for k in 0 to X.cols {
                s = s + fabs((matrix_at(X, i, k) - matrix_at(Y, j, k)) as f64) as f32
            }
            matrix_set(result, i, j, s)
        }
    }
    return result
}

export function cosine_distances(X: Matrix, Y: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, Y.rows)
    for i in 0 to X.rows {
        let mut norm_x: f32 = 0.0
        for k in 0 to X.cols {
            norm_x = norm_x + matrix_at(X, i, k) * matrix_at(X, i, k)
        }
        norm_x = sqrt((norm_x as f64)) as f32
        if norm_x < 0.0000000001 { norm_x = 0.0000000001 }

        for j in 0 to Y.rows {
            let mut dot: f32 = 0.0
            let mut norm_y: f32 = 0.0
            for k in 0 to Y.cols {
                dot = dot + matrix_at(X, i, k) * matrix_at(Y, j, k)
                norm_y = norm_y + matrix_at(Y, j, k) * matrix_at(Y, j, k)
            }
            norm_y = sqrt((norm_y as f64)) as f32
            if norm_y < 0.0000000001 { norm_y = 0.0000000001 }
            let cos_sim: f32 = dot / (norm_x * norm_y)
            matrix_set(result, i, j, 1.0 - cos_sim)
        }
    }
    return result
}

# Multi-class metrics (One-vs-Rest and One-vs-One)
# ============================================================================

export struct MultiClassMetric {
    per_class: ptr<f32>,
    n_classes: i32,
    macro_avg: f32,
    micro_avg: f32,
    weighted_avg: f32
}

export function multiclass_precision_ovr(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> MultiClassMetric {
    let per_class: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    for c in 0 to n_classes {
        let mut tp: i32 = 0
        let mut fp: i32 = 0
        let mut fn_: i32 = 0

        for i in 0 to n {
            let true_pos: bool = y_true[i] == classes[c]
            let pred_pos: bool = y_pred[i] == classes[c]

            if true_pos && pred_pos { tp = tp + 1 }
            if not true_pos && pred_pos { fp = fp + 1 }
            if true_pos && not pred_pos { fn_ = fn_ + 1 }
        }

        let denom: i32 = tp + fp
        if denom > 0 {
            per_class[c] = (tp as f32) / (denom as f32)
        } else {
            per_class[c] = 0.0
        }
        class_counts[c] = tp + fn_
    }

    let mut macro: f32 = 0.0
    let mut weighted: f32 = 0.0
    let mut total_count: i32 = 0
    for c in 0 to n_classes {
        macro = macro + per_class[c]
        weighted = weighted + per_class[c] * (class_counts[c] as f32)
        total_count = total_count + class_counts[c]
    }
    macro = macro / (n_classes as f32)
    if total_count > 0 {
        weighted = weighted / (total_count as f32)
    }

    let mut micro_tp: i32 = 0
    let mut micro_fp: i32 = 0
    for i in 0 to n {
        if y_true[i] == y_pred[i] {
            micro_tp = micro_tp + 1
        } else {
            micro_fp = micro_fp + 1
        }
    }
    let micro: f32 = 0.0
    if micro_tp + micro_fp > 0 {
        micro = (micro_tp as f32) / ((micro_tp + micro_fp) as f32)
    }

    free(class_counts as ptr<void>)

    return MultiClassMetric {
        per_class: per_class,
        n_classes: n_classes,
        macro_avg: macro,
        micro_avg: micro,
        weighted_avg: weighted
    }
}

export function multiclass_recall_ovr(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> MultiClassMetric {
    let per_class: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    for c in 0 to n_classes {
        let mut tp: i32 = 0
        let mut fn_: i32 = 0

        for i in 0 to n {
            let true_pos: bool = y_true[i] == classes[c]
            let pred_pos: bool = y_pred[i] == classes[c]

            if true_pos && pred_pos { tp = tp + 1 }
            if true_pos && not pred_pos { fn_ = fn_ + 1 }
        }

        let denom: i32 = tp + fn_
        if denom > 0 {
            per_class[c] = (tp as f32) / (denom as f32)
        } else {
            per_class[c] = 0.0
        }
        class_counts[c] = denom
    }

    let mut macro: f32 = 0.0
    let mut weighted: f32 = 0.0
    let mut total_count: i32 = 0
    for c in 0 to n_classes {
        macro = macro + per_class[c]
        weighted = weighted + per_class[c] * (class_counts[c] as f32)
        total_count = total_count + class_counts[c]
    }
    macro = macro / (n_classes as f32)
    if total_count > 0 {
        weighted = weighted / (total_count as f32)
    }

    let mut micro_tp: i32 = 0
    let mut micro_fn: i32 = 0
    for i in 0 to n {
        if y_true[i] == y_pred[i] {
            micro_tp = micro_tp + 1
        } else {
            micro_fn = micro_fn + 1
        }
    }
    let micro: f32 = 0.0
    if micro_tp + micro_fn > 0 {
        micro = (micro_tp as f32) / ((micro_tp + micro_fn) as f32)
    }

    free(class_counts as ptr<void>)

    return MultiClassMetric {
        per_class: per_class,
        n_classes: n_classes,
        macro_avg: macro,
        micro_avg: micro,
        weighted_avg: weighted
    }
}

export function multiclass_f1_ovr(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> MultiClassMetric {
    let prec: MultiClassMetric = multiclass_precision_ovr(y_true, y_pred, n, classes, n_classes)
    let rec: MultiClassMetric = multiclass_recall_ovr(y_true, y_pred, n, classes, n_classes)

    let per_class: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes {
        let p: f32 = prec.per_class[c]
        let r: f32 = rec.per_class[c]
        if p + r > 0.0 {
            per_class[c] = 2.0 * p * r / (p + r)
        } else {
            per_class[c] = 0.0
        }
    }

    let mut macro: f32 = 0.0
    let mut weighted: f32 = 0.0
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let mut total_count: i32 = 0
    for c in 0 to n_classes {
        let mut count: i32 = 0
        for i in 0 to n {
            if y_true[i] == classes[c] { count = count + 1 }
        }
        class_counts[c] = count
        macro = macro + per_class[c]
        weighted = weighted + per_class[c] * (count as f32)
        total_count = total_count + count
    }
    macro = macro / (n_classes as f32)
    if total_count > 0 {
        weighted = weighted / (total_count as f32)
    }

    let micro: f32 = 0.0
    if prec.micro_avg + rec.micro_avg > 0.0 {
        micro = 2.0 * prec.micro_avg * rec.micro_avg / (prec.micro_avg + rec.micro_avg)
    }

    free(class_counts as ptr<void>)
    multiclass_metric_free(prec)
    multiclass_metric_free(rec)

    return MultiClassMetric {
        per_class: per_class,
        n_classes: n_classes,
        macro_avg: macro,
        micro_avg: micro,
        weighted_avg: weighted
    }
}

export function multiclass_metric_free(m: MultiClassMetric) -> void {
    array_free_f32(m.per_class)
}

export function print_multiclass_metric(name: string, m: MultiClassMetric, classes: ptr<f32>) -> void {
    print("  ")
    print(name)
    println(" (OvR):")
    for c in 0 to m.n_classes {
        print("    class ")
        print(classes[c])
        print(": ")
        printf("%.4f", m.per_class[c])
        println("")
    }
    print("    macro avg: ")
    printf("%.4f", m.macro_avg)
    println("")
    print("    micro avg: ")
    printf("%.4f", m.micro_avg)
    println("")
    print("    weighted avg: ")
    printf("%.4f", m.weighted_avg)
    println("")
}

# ============================================================================
# One-vs-One pairwise metrics
# ============================================================================

export struct OvOResult {
    scores: ptr<f32>,
    n_pairs: i32,
    avg: f32
}

export function multiclass_precision_ovo(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> OvOResult {
    let n_pairs: i32 = n_classes * (n_classes - 1) / 2
    let scores: ptr<f32> = array_new_f32(n_pairs)

    let mut idx: i32 = 0
    for a in 0 to n_classes {
        for b in a + 1 to n_classes {
            let mut tp: i32 = 0
            let mut fp: i32 = 0

            for i in 0 to n {
                if y_true[i] == classes[a] || y_true[i] == classes[b] {
                    if y_pred[i] == classes[a] && y_true[i] == classes[a] {
                        tp = tp + 1
                    }
                    if y_pred[i] == classes[a] && y_true[i] == classes[b] {
                        fp = fp + 1
                    }
                }
            }

            if tp + fp > 0 {
                scores[idx] = (tp as f32) / ((tp + fp) as f32)
            } else {
                scores[idx] = 0.0
            }
            idx = idx + 1
        }
    }

    let mut avg: f32 = 0.0
    for i in 0 to n_pairs {
        avg = avg + scores[i]
    }
    avg = avg / (n_pairs as f32)

    return OvOResult { scores: scores, n_pairs: n_pairs, avg: avg }
}

export function multiclass_recall_ovo(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> OvOResult {
    let n_pairs: i32 = n_classes * (n_classes - 1) / 2
    let scores: ptr<f32> = array_new_f32(n_pairs)

    let mut idx: i32 = 0
    for a in 0 to n_classes {
        for b in a + 1 to n_classes {
            let mut tp: i32 = 0
            let mut fn_: i32 = 0

            for i in 0 to n {
                if y_true[i] == classes[a] || y_true[i] == classes[b] {
                    if y_pred[i] == classes[a] && y_true[i] == classes[a] {
                        tp = tp + 1
                    }
                    if y_pred[i] == classes[b] && y_true[i] == classes[a] {
                        fn_ = fn_ + 1
                    }
                }
            }

            if tp + fn_ > 0 {
                scores[idx] = (tp as f32) / ((tp + fn_) as f32)
            } else {
                scores[idx] = 0.0
            }
            idx = idx + 1
        }
    }

    let mut avg: f32 = 0.0
    for i in 0 to n_pairs {
        avg = avg + scores[i]
    }
    avg = avg / (n_pairs as f32)

    return OvOResult { scores: scores, n_pairs: n_pairs, avg: avg }
}

export function ovo_result_free(r: OvOResult) -> void {
    array_free_f32(r.scores)
}

# ============================================================================
# Additional classification metrics
# ============================================================================

export function zero_one_loss(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut errors: i32 = 0
    for i in 0 to n {
        if y_true[i] != y_pred[i] {
            errors = errors + 1
        }
    }
    return (errors as f32) / (n as f32)
}

export function zero_one_loss_count(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> i32 {
    let mut errors: i32 = 0
    for i in 0 to n {
        if y_true[i] != y_pred[i] {
            errors = errors + 1
        }
    }
    return errors
}

export function hamming_loss(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut mismatches: i32 = 0
    for i in 0 to n {
        if y_true[i] != y_pred[i] {
            mismatches = mismatches + 1
        }
    }
    return (mismatches as f32) / (n as f32)
}

# ============================================================================
# Ranking metrics
# ============================================================================

export function dcg_score(y_true: ptr<f32>, y_score: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let gain: f32 = pow((2.0 as f64), (y_true[i] as f64)) as f32 - 1.0
        let discount: f32 = log((((i + 2) as f64)) as f32) / log(2.0 as f64) as f32
        sum = sum + gain / discount
    }
    return sum
}

export function ndcg_score(y_true: ptr<f32>, y_score: ptr<f32>, n: i32) -> f32 {
    # Sort by score descending, get permutation
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }
    # Simple selection sort by y_score descending
    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if y_score[indices[j]] > y_score[indices[max_idx]] {
                max_idx = j
            }
        }
        let tmp: i32 = indices[i]
        indices[i] = indices[max_idx]
        indices[max_idx] = tmp
    }

    # DCG with predicted ordering
    let mut dcg: f32 = 0.0
    for i in 0 to n {
        let gain: f32 = pow((2.0 as f64), (y_true[indices[i]] as f64)) as f32 - 1.0
        let discount: f32 = log((((i + 2) as f64)) as f32) / log(2.0 as f64) as f32
        dcg = dcg + gain / discount
    }

    # Ideal DCG: sort y_true descending
    let sorted_y: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        sorted_y[i] = y_true[i]
    }
    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if sorted_y[j] > sorted_y[max_idx] {
                max_idx = j
            }
        }
        let tmp: f32 = sorted_y[i]
        sorted_y[i] = sorted_y[max_idx]
        sorted_y[max_idx] = tmp
    }

    let mut idcg: f32 = 0.0
    for i in 0 to n {
        let gain: f32 = pow((2.0 as f64), (sorted_y[i] as f64)) as f32 - 1.0
        let discount: f32 = log((((i + 2) as f64)) as f32) / log(2.0 as f64) as f32
        idcg = idcg + gain / discount
    }

    free(indices as ptr<void>)
    array_free_f32(sorted_y)

    if idcg < 0.0000000001 {
        return 0.0
    }
    return dcg / idcg
}

export function coverage_error(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, n_labels: i32) -> f32 {
    # For each sample, coverage is the fraction of labels that must be
    # predicted to cover all true labels. y_true and y_score are
    # flattened n*n_labels arrays.
    let mut total_coverage: f32 = 0.0
    for i in 0 to n {
        # Count true labels for this sample
        let mut n_true: i32 = 0
        for j in 0 to n_labels {
            if y_true[i * n_labels + j] > 0.5 {
                n_true = n_true + 1
            }
        }
        if n_true == 0 {
            continue
        }
        # Sort label scores descending, find how many we need
        let scores: ptr<f32> = array_new_f32(n_labels)
        let label_true: ptr<f32> = array_new_f32(n_labels)
        for j in 0 to n_labels {
            scores[j] = y_score[i * n_labels + j]
            label_true[j] = y_true[i * n_labels + j]
        }
        # Selection sort descending
        for j in 0 to n_labels {
            let mut max_idx: i32 = j
            for k in j + 1 to n_labels {
                if scores[k] > scores[max_idx] {
                    max_idx = k
                }
            }
            let tmp_s: f32 = scores[j]
            scores[j] = scores[max_idx]
            scores[max_idx] = tmp_s
            let tmp_t: f32 = label_true[j]
            label_true[j] = label_true[max_idx]
            label_true[max_idx] = tmp_t
        }
        # Count how many labels until all true are covered
        let mut covered: i32 = 0
        let mut found_true: i32 = 0
        for j in 0 to n_labels {
            covered = covered + 1
            if label_true[j] > 0.5 {
                found_true = found_true + 1
            }
            if found_true >= n_true {
                break
            }
        }
        total_coverage = total_coverage + (covered as f32) / (n_labels as f32)
        array_free_f32(scores)
        array_free_f32(label_true)
    }
    return total_coverage / (n as f32)
}

export function label_ranking_loss(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, n_labels: i32) -> f32 {
    # For each sample, fraction of incorrectly ordered label pairs.
    # A pair (i, j) is incorrectly ordered if y_true[i] > y_true[j]
    # but y_score[i] <= y_score[j].
    let mut total_loss: f32 = 0.0
    for i in 0 to n {
        let mut n_incorrect: i32 = 0
        let mut n_pairs: i32 = 0
        for j in 0 to n_labels {
            for k in j + 1 to n_labels {
                let tj: f32 = y_true[i * n_labels + j]
                let tk: f32 = y_true[i * n_labels + k]
                let sj: f32 = y_score[i * n_labels + j]
                let sk: f32 = y_score[i * n_labels + k]
                if tj != tk {
                    n_pairs = n_pairs + 1
                    if (tj > tk && sj <= sk) || (tj < tk && sj >= sk) {
                        n_incorrect = n_incorrect + 1
                    }
                }
            }
        }
        if n_pairs > 0 {
            total_loss = total_loss + (n_incorrect as f32) / (n_pairs as f32)
        }
    }
    return total_loss / (n as f32)
}

# ============================================================================
# Average Precision Score
# ============================================================================

export function average_precision_score(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    # Sort indices by score descending (selection sort)
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }
    for i in 0 to n {
        let mut max_idx: i32 = i
        for j in i + 1 to n {
            if y_score[indices[j]] > y_score[indices[max_idx]] {
                max_idx = j
            }
        }
        let tmp: i32 = indices[i]
        indices[i] = indices[max_idx]
        indices[max_idx] = tmp
    }

    # Count total positives
    let mut n_pos: i32 = 0
    for i in 0 to n {
        if y_true[i] == pos_label {
            n_pos = n_pos + 1
        }
    }

    if n_pos == 0 {
        free(indices as ptr<void>)
        let result: f32 = 0.0
        return result
    }

    # AP = sum of (recall - prev_recall) * precision at each threshold
    let mut ap: f32 = 0.0
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    let mut prev_recall: f32 = 0.0

    for i in 0 to n {
        if y_true[indices[i]] == pos_label {
            tp = tp + 1
        } else {
            fp = fp + 1
        }
        let precision: f32 = (tp as f32) / ((tp + fp) as f32)
        let recall: f32 = (tp as f32) / (n_pos as f32)
        ap = ap + precision * (recall - prev_recall)
        prev_recall = recall
    }

    free(indices as ptr<void>)

    let result: f32 = ap
    return result
}

# ============================================================================
# Top-k Accuracy Score
# ============================================================================

export function top_k_accuracy_score(y_true: ptr<f32>, y_score: ptr<f32>, n: i32, n_classes: i32, k: i32) -> f32 {
    let mut correct: i32 = 0
    let scores: ptr<f32> = array_new_f32(n_classes)
    let used: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for i in 0 to n {
        let true_cls: i32 = y_true[i] as i32

        for j in 0 to n_classes {
            scores[j] = y_score[i * n_classes + j]
            used[j] = 0
        }

        let mut found: bool = false
        for rank in 0 to k {
            let mut max_idx: i32 = -1
            for j in 0 to n_classes {
                if used[j] == 0 {
                    if max_idx == -1 || scores[j] > scores[max_idx] {
                        max_idx = j
                    }
                }
            }
            if max_idx == -1 {
                break
            }
            used[max_idx] = 1
            if max_idx == true_cls {
                found = true
            }
        }

        if found {
            correct = correct + 1
        }
    }

    free(used as ptr<void>)
    array_free_f32(scores)

    let result: f32 = (correct as f32) / (n as f32)
    return result
}

# ============================================================================
# Mean Poisson Deviance
# ============================================================================

export function mean_poisson_deviance(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        if y_true[i] == 0.0 {
            sum = sum + 2.0 * y_pred[i]
        } else {
            let ratio: f32 = y_true[i] / y_pred[i]
            let log_ratio: f32 = log((ratio) as f64) as f32
            sum = sum + 2.0 * (y_true[i] * log_ratio - (y_true[i] - y_pred[i]))
        }
    }
    let result: f32 = sum / (n as f32)
    return result
}

# ============================================================================
# Mean Gamma Deviance
# ============================================================================

export function mean_gamma_deviance(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        let ratio: f32 = y_true[i] / y_pred[i]
        let log_ratio: f32 = log((ratio) as f64) as f32
        sum = sum + 2.0 * (-log_ratio + (y_true[i] - y_pred[i]) / y_pred[i])
    }
    let result: f32 = sum / (n as f32)
    return result
}

# ============================================================================
# D2 Tweedie Score
# ============================================================================

export function tweedie_deviance_point(y: f32, x: f32, power: f32) -> f32 {
    if power == 0.0 {
        let d: f32 = y - x
        let result: f32 = d * d
        return result
    }
    if power == 1.0 {
        if y == 0.0 {
            let result: f32 = 2.0 * x
            return result
        }
        let ratio: f32 = y / x
        let log_ratio: f32 = log((ratio) as f64) as f32
        let result: f32 = 2.0 * (y * log_ratio - (y - x))
        return result
    }
    if power == 2.0 {
        let ratio: f32 = y / x
        let log_ratio: f32 = log((ratio) as f64) as f32
        let result: f32 = 2.0 * (-log_ratio + (y - x) / x)
        return result
    }
    # General Tweedie deviance for arbitrary power
    let p: f32 = power
    let term1: f32 = pow((y as f64), ((2.0 - p) as f64)) as f32 / ((1.0 - p) * (2.0 - p))
    let term2: f32 = y * pow((x as f64), ((1.0 - p) as f64)) as f32 / (1.0 - p)
    let term3: f32 = pow((x as f64), ((2.0 - p) as f64)) as f32 / (2.0 - p)
    let result: f32 = 2.0 * (term1 - term2 + term3)
    return result
}

export function d2_tweedie_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, power: f32) -> f32 {
    # Compute model deviance
    let mut deviance: f32 = 0.0
    for i in 0 to n {
        deviance = deviance + tweedie_deviance_point(y_true[i], y_pred[i], power)
    }

    # Compute null deviance (null model predicts mean(y_true))
    let mean_y: f32 = array_mean(y_true, n)
    let mut null_deviance: f32 = 0.0
    for i in 0 to n {
        null_deviance = null_deviance + tweedie_deviance_point(y_true[i], mean_y, power)
    }

    if null_deviance < 0.0000000001 {
        let result: f32 = 0.0
        return result
    }
    let result: f32 = 1.0 - deviance / null_deviance
    return result
}

# ============================================================================
# Class Likelihood Ratios
# ============================================================================

export struct ClassLikelihoodRatios {
    positive_lr: f32,
    negative_lr: f32
}

export function class_likelihood_ratios(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> ClassLikelihoodRatios {
    let mut tp: i32 = 0
    let mut tn: i32 = 0
    let mut fp: i32 = 0
    let mut fn_: i32 = 0

    for i in 0 to n {
        let actual_pos: bool = y_true[i] == pos_label
        let pred_pos: bool = y_pred[i] == pos_label

        if actual_pos && pred_pos {
            tp = tp + 1
        } elif not actual_pos && not pred_pos {
            tn = tn + 1
        } elif not actual_pos && pred_pos {
            fp = fp + 1
        } else {
            fn_ = fn_ + 1
        }
    }

    let sensitivity: f32 = 0.0
    if tp + fn_ > 0 {
        sensitivity = (tp as f32) / ((tp + fn_) as f32)
    }
    let specificity: f32 = 0.0
    if tn + fp > 0 {
        specificity = (tn as f32) / ((tn + fp) as f32)
    }

    let pos_lr: f32 = 0.0
    if specificity < 1.0 - 0.0000000001 {
        pos_lr = sensitivity / (1.0 - specificity)
    }
    let neg_lr: f32 = 0.0
    if specificity > 0.0000000001 {
        neg_lr = (1.0 - sensitivity) / specificity
    }

    let result: ClassLikelihoodRatios = ClassLikelihoodRatios {
        positive_lr: pos_lr,
        negative_lr: neg_lr
    }
    return result
}

# ============================================================================
# Class Balance Accuracy
# ============================================================================

export function class_balance_accuracy(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let mut sum_cba: f32 = 0.0
    for c in 0 to n_classes {
        let cls: f32 = classes[c]
        let mut tp: i32 = 0
        let mut predicted_as: i32 = 0
        let mut actual: i32 = 0

        for i in 0 to n {
            if y_true[i] == cls {
                actual = actual + 1
            }
            if y_pred[i] == cls {
                predicted_as = predicted_as + 1
            }
            if y_true[i] == cls && y_pred[i] == cls {
                tp = tp + 1
            }
        }

        let denom: i32 = predicted_as
        if actual > denom {
            denom = actual
        }
        if denom > 0 {
            sum_cba = sum_cba + (tp as f32) / (denom as f32)
        }
    }

    let result: f32 = sum_cba / (n_classes as f32)
    return result
}

# ============================================================================
# Mean Absolute Percentage Error
# ============================================================================

export function mean_absolute_percentage_error(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    let epsilon: f32 = 0.0000000001
    for i in 0 to n {
        let mut denom: f32 = fabs((y_true[i]) as f64) as f32
        if denom < epsilon {
            denom = epsilon
        }
        let diff: f32 = fabs((y_true[i] - y_pred[i]) as f64) as f32
        sum = sum + diff / denom
    }
    let result: f32 = sum / (n as f32) * 100.0
    return result
}

# ============================================================================
# Mean Tweedie Deviance
# ============================================================================

export function mean_tweedie_deviance(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, power: f32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        sum = sum + tweedie_deviance_point(y_true[i], y_pred[i], power)
    }
    let result: f32 = sum / (n as f32)
    return result
}

# ============================================================================
# Calinski-Harabasz Score
# ============================================================================

export function calinski_harabasz_score(X: Matrix, labels: ptr<f32>, n_clusters: i32, n: i32) -> f32 {
    let n_features: i32 = X.cols

    # Compute global mean
    let global_mean: ptr<f32> = array_new_f32(n_features)
    for j in 0 to n_features {
        let mut s: f32 = 0.0
        for i in 0 to n {
            s = s + matrix_at(X, i, j)
        }
        global_mean[j] = s / (n as f32)
    }

    # Compute cluster centers and counts
    let centers: ptr<f32> = array_new_f32(n_clusters * n_features)
    let counts: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for k in 0 to n_clusters {
        counts[k] = 0
    }
    for i in 0 to n {
        let k: i32 = labels[i] as i32
        counts[k] = counts[k] + 1
        for j in 0 to n_features {
            centers[k * n_features + j] = centers[k * n_features + j] + matrix_at(X, i, j)
        }
    }
    for k in 0 to n_clusters {
        if counts[k] > 0 {
            for j in 0 to n_features {
                centers[k * n_features + j] = centers[k * n_features + j] / (counts[k] as f32)
            }
        }
    }

    # W_k = within-cluster sum of squares
    let mut w_k: f32 = 0.0
    for i in 0 to n {
        let k: i32 = labels[i] as i32
        for j in 0 to n_features {
            let d: f32 = matrix_at(X, i, j) - centers[k * n_features + j]
            w_k = w_k + d * d
        }
    }

    # B_k = between-cluster dispersion
    let mut b_k: f32 = 0.0
    for k in 0 to n_clusters {
        for j in 0 to n_features {
            let d: f32 = centers[k * n_features + j] - global_mean[j]
            b_k = b_k + (counts[k] as f32) * d * d
        }
    }

    array_free_f32(global_mean)
    array_free_f32(centers)
    free(counts as ptr<void>)

    if n_clusters <= 1 || n <= n_clusters {
        let result: f32 = 0.0
        return result
    }
    let result: f32 = (b_k / ((n_clusters - 1) as f32)) / (w_k / ((n - n_clusters) as f32))
    return result
}

# ============================================================================
# Davies-Bouldin Score
# ============================================================================

export function davies_bouldin_score(X: Matrix, labels: ptr<f32>, n_clusters: i32, n: i32) -> f32 {
    let n_features: i32 = X.cols

    # Compute cluster centers and counts
    let centers: ptr<f32> = array_new_f32(n_clusters * n_features)
    let counts: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for k in 0 to n_clusters {
        counts[k] = 0
    }
    for i in 0 to n {
        let k: i32 = labels[i] as i32
        counts[k] = counts[k] + 1
        for j in 0 to n_features {
            centers[k * n_features + j] = centers[k * n_features + j] + matrix_at(X, i, j)
        }
    }
    for k in 0 to n_clusters {
        if counts[k] > 0 {
            for j in 0 to n_features {
                centers[k * n_features + j] = centers[k * n_features + j] / (counts[k] as f32)
            }
        }
    }

    # S_i = average distance from points in cluster i to center i
    let s_vals: ptr<f32> = array_new_f32(n_clusters)
    for k in 0 to n_clusters {
        s_vals[k] = 0.0
    }
    for i in 0 to n {
        let k: i32 = labels[i] as i32
        let mut dist: f32 = 0.0
        for j in 0 to n_features {
            let d: f32 = matrix_at(X, i, j) - centers[k * n_features + j]
            dist = dist + d * d
        }
        s_vals[k] = s_vals[k] + sqrt((dist) as f64) as f32
    }
    for k in 0 to n_clusters {
        if counts[k] > 0 {
            s_vals[k] = s_vals[k] / (counts[k] as f32)
        }
    }

    # DB = (1/k) * sum of max_j D_ij
    let mut db: f32 = 0.0
    for i in 0 to n_clusters {
        let mut max_d: f32 = 0.0
        for j in 0 to n_clusters {
            if i == j { continue }
            # distance between centers
            let mut dist_c: f32 = 0.0
            for f in 0 to n_features {
                let d: f32 = centers[i * n_features + f] - centers[j * n_features + f]
                dist_c = dist_c + d * d
            }
            dist_c = sqrt((dist_c) as f64) as f32
            if dist_c < 0.0000000001 {
                dist_c = 0.0000000001
            }
            let d_ij: f32 = (s_vals[i] + s_vals[j]) / dist_c
            if d_ij > max_d {
                max_d = d_ij
            }
        }
        db = db + max_d
    }

    array_free_f32(centers)
    array_free_f32(s_vals)
    free(counts as ptr<void>)

    let result: f32 = db / (n_clusters as f32)
    return result
}

# ============================================================================
# Homogeneity Score
# h = 1 - H(C|K) / H(C) where C=true labels, K=pred labels
# ============================================================================

export function homogeneity_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }
    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    # H(C|K) = conditional entropy of C given K
    let mut h_c_k: f32 = 0.0
    for k in 0 to n_clusters {
        if b[k] == 0 { continue }
        let p_k: f32 = b[k] as f32 / (n as f32)
        for c in 0 to n_classes {
            if contingency[c][k] == 0 { continue }
            let p_ck: f32 = contingency[c][k] as f32 / (b[k] as f32)
            h_c_k = h_c_k - p_k * p_ck * log((p_ck) as f64) as f32
        }
    }

    # H(C) = entropy of C
    let mut h_c: f32 = 0.0
    for c in 0 to n_classes {
        if a[c] == 0 { continue }
        let p_c: f32 = a[c] as f32 / (n as f32)
        h_c = h_c - p_c * log((p_c) as f64) as f32
    }

    for i in 0 to n_classes {
        free(contingency[i] as ptr<void>)
    }
    free(contingency as ptr<void>)
    free(a as ptr<void>)
    free(b as ptr<void>)

    if h_c < 0.0000000001 {
        let result: f32 = 1.0
        return result
    }
    let result: f32 = 1.0 - h_c_k / h_c
    return result
}

# ============================================================================
# Completeness Score
# c = 1 - H(K|C) / H(K)
# ============================================================================

export function completeness_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
    }
    let mut n_clusters: i32 = 0
    for i in 0 to n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
    }

    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        for j in 0 to n_clusters { contingency[i][j] = 0 }
    }
    for i in 0 to n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
    }

    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    for i in 0 to n_classes {
        a[i] = 0
        for j in 0 to n_clusters { a[i] = a[i] + contingency[i][j] }
    }
    for j in 0 to n_clusters {
        b[j] = 0
        for i in 0 to n_classes { b[j] = b[j] + contingency[i][j] }
    }

    # H(K|C) = conditional entropy of K given C
    let mut h_k_c: f32 = 0.0
    for c in 0 to n_classes {
        if a[c] == 0 { continue }
        let p_c: f32 = a[c] as f32 / (n as f32)
        for k in 0 to n_clusters {
            if contingency[c][k] == 0 { continue }
            let p_kc: f32 = contingency[c][k] as f32 / (a[c] as f32)
            h_k_c = h_k_c - p_c * p_kc * log((p_kc) as f64) as f32
        }
    }

    # H(K) = entropy of K
    let mut h_k: f32 = 0.0
    for k in 0 to n_clusters {
        if b[k] == 0 { continue }
        let p_k: f32 = b[k] as f32 / (n as f32)
        h_k = h_k - p_k * log((p_k) as f64) as f32
    }

    for i in 0 to n_classes {
        free(contingency[i] as ptr<void>)
    }
    free(contingency as ptr<void>)
    free(a as ptr<void>)
    free(b as ptr<void>)

    if h_k < 0.0000000001 {
        let result: f32 = 1.0
        return result
    }
    let result: f32 = 1.0 - h_k_c / h_k
    return result
}

# ============================================================================
# Fowlkes-Mallows Score
# FMI = TP / sqrt((TP + FP) * (TP + FN))
# ============================================================================

export function fowlkes_mallows_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    let mut fn_: i32 = 0
    for i in 0 to n {
        for j in i + 1 to n {
            let same_true: bool = labels_true[i] == labels_true[j]
            let same_pred: bool = labels_pred[i] == labels_pred[j]
            if same_true && same_pred {
                tp = tp + 1
            }
            if not same_true && same_pred {
                fp = fp + 1
            }
            if same_true && not same_pred {
                fn_ = fn_ + 1
            }
        }
    }
    let tp_f: f32 = tp as f32
    let fp_f: f32 = fp as f32
    let fn_f: f32 = fn_ as f32
    let denom: f32 = sqrt(((tp_f + fp_f) * (tp_f + fn_f)) as f64) as f32
    if denom < 0.0000000001 {
        let result: f32 = 0.0
        return result
    }
    let result: f32 = tp_f / denom
    return result
}

# ============================================================================
# Adjusted Mutual Info Score
# ============================================================================

export function adjusted_mutual_info_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    # AMI = (MI - E[MI]) / (max(H(C), H(K)) - E[MI])
    # Uses the standard expected MI formula from Vinh et al. 2009:
    #   E[MI] = sum_{i,j} sum_{n_ij} (n_ij! / (a_i! b_j!)) *
    #           (a_i b_j (n-a_i)(n-b_j)) / ((n-1)^2 * n!) *
    #           (n/n_ij) * log(n * n_ij / (a_i * b_j))
    # For computational tractability we use the approximation:
    #   E[MI] ~ (2 * R * C) / n  where R, C are the number of classes/clusters
    # This is the asymptotic upper bound on E[MI] for uniform marginals.

    let mut n_classes: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = labels_true[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
        i = i + 1
    }
    let mut n_clusters: i32 = 0
    i = 0
    while i < n {
        let c: i32 = labels_pred[i] as i32
        if c + 1 > n_clusters { n_clusters = c + 1 }
        i = i + 1
    }

    # Build contingency table
    let contingency: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    i = 0
    while i < n_classes {
        contingency[i] = malloc((n_clusters as i64) * 4) as ptr<i32>
        let mut j: i32 = 0
        while j < n_clusters {
            contingency[i][j] = 0
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < n {
        contingency[labels_true[i] as i32][labels_pred[i] as i32] = contingency[labels_true[i] as i32][labels_pred[i] as i32] + 1
        i = i + 1
    }

    # Marginals
    let a: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let b: ptr<i32> = malloc((n_clusters as i64) * 4) as ptr<i32>
    i = 0
    while i < n_classes {
        a[i] = 0
        let mut j: i32 = 0
        while j < n_clusters {
            a[i] = a[i] + contingency[i][j]
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < n_clusters {
        b[i] = 0
        let mut j: i32 = 0
        while j < n_classes {
            b[i] = b[i] + contingency[j][i]
            j = j + 1
        }
        i = i + 1
    }

    # Compute MI
    let mut mi: f32 = 0.0
    i = 0
    while i < n_classes {
        let mut j: i32 = 0
        while j < n_clusters {
            if contingency[i][j] > 0 {
                let p_ij: f32 = (contingency[i][j] as f32) / (n as f32)
                let p_i: f32 = (a[i] as f32) / (n as f32)
                let p_j: f32 = (b[j] as f32) / (n as f32)
                mi = mi + p_ij * log((p_ij / (p_i * p_j)) as f64) as f32
            }
            j = j + 1
        }
        i = i + 1
    }

    # Compute entropies
    let mut h_a: f32 = 0.0
    i = 0
    while i < n_classes {
        if a[i] > 0 {
            let p_i: f32 = (a[i] as f32) / (n as f32)
            h_a = h_a - p_i * log((p_i) as f64) as f32
        }
        i = i + 1
    }
    let mut h_b: f32 = 0.0
    i = 0
    while i < n_clusters {
        if b[i] > 0 {
            let p_j: f32 = (b[i] as f32) / (n as f32)
            h_b = h_b - p_j * log((p_j) as f64) as f32
        }
        i = i + 1
    }

    # Expected MI using the Vinh et al. approximation for large n:
    # E[MI] ~ sum over (a_i, b_j) pairs of the hypergeometric expectation.
    # For tractability, we compute the leading term:
    #   E[MI] = sum_{i,j} (a_i * b_j / n^2) * log(n * a_i * b_j / (a_i * b_j * n))
    #         = sum_{i,j} (a_i * b_j / n^2) * log(n)
    #         = log(n) * sum_{i,j} (a_i * b_j / n^2)
    #         = log(n)
    # But this overestimates. The proper EMI uses the hypergeometric:
    #   E[n_ij] = a_i * b_j / n
    #   E[MI] = sum_{i,j} sum_{k} P(n_ij=k) * (k/n) * log(n*k/(a_i*b_j))
    # We approximate with the mean term:
    #   E[MI] ~ sum_{i,j} (a_i*b_j/n^2) * log(n * (a_i*b_j/n) / (a_i*b_j))
    #         = sum_{i,j} (a_i*b_j/n^2) * log(1)
    #         = 0
    # The leading correction comes from the variance of the hypergeometric.
    # A practical approximation (used by sklearn for large n):
    #   E[MI] ~ (R-1)(C-1) / (2*(n-1))  for large n
    let emi: f32 = ((n_classes - 1) as f32) * ((n_clusters - 1) as f32) / (2.0 * ((n as f32) - 1.0))
    if n < 2 { emi = 0.0 }

    # Clean up
    i = 0
    while i < n_classes {
        free(contingency[i] as ptr<void>)
        i = i + 1
    }
    free(contingency as ptr<void>)
    free(a as ptr<void>)
    free(b as ptr<void>)

    let max_h: f32 = h_a
    if h_b > max_h { max_h = h_b }

    let denom: f32 = max_h - emi
    if denom < 0.0000000001 {
        let result: f32 = 1.0
        if mi < 0.0000000001 { result = 0.0 }
        return result
    }
    let result: f32 = (mi - emi) / denom
    if result < -1.0 { result = -1.0 }
    if result > 1.0 { result = 1.0 }
    return result
}

# ============================================================================
# Pair Confusion Matrix
# ============================================================================

export struct PairConfusionMatrix {
    tp: i32,
    fp: i32,
    fn: i32,
    tn: i32
}

export function pair_confusion_matrix(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> PairConfusionMatrix {
    let mut tp: i32 = 0
    let mut fp: i32 = 0
    let mut fn: i32 = 0
    let mut tn: i32 = 0

    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = i + 1
        while j < n {
            let same_true: bool = labels_true[i] == labels_true[j]
            let same_pred: bool = labels_pred[i] == labels_pred[j]
            if same_true && same_pred {
                tp = tp + 1
            } else {
                if same_pred && !same_true {
                    fp = fp + 1
                } else {
                    if same_true && !same_pred {
                        fn = fn + 1
                    } else {
                        tn = tn + 1
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    let result: PairConfusionMatrix = PairConfusionMatrix {
        tp: tp,
        fp: fp,
        fn: fn,
        tn: tn
    }
    return result
}

# ============================================================================
# Mean Pinball Loss
# ============================================================================

export function mean_pinball_loss(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, alpha: f32) -> f32 {
    let mut sum: f32 = 0.0
    let mut i: i32 = 0
    while i < n {
        let diff: f32 = y_true[i] - y_pred[i]
        let loss: f32 = 0.0
        if diff >= 0.0 {
            loss = alpha * diff
        } else {
            loss = (1.0 - alpha) * (-diff)
        }
        sum = sum + loss
        i = i + 1
    }
    let result: f32 = sum / (n as f32)
    return result
}

# ============================================================================
# D2 Absolute Error Score
# ============================================================================

export function d2_absolute_error_score(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    # D2 = 1 - (sum of absolute errors) / (sum of absolute deviations from median)
    let mut sum_true: f32 = 0.0
    let mut i: i32 = 0
    while i < n {
        sum_true = sum_true + y_true[i]
        i = i + 1
    }
    let mean_y: f32 = sum_true / (n as f32)

    let mut sum_abs_error: f32 = 0.0
    let mut sum_abs_dev: f32 = 0.0
    i = 0
    while i < n {
        let abs_error: f32 = fabs((y_true[i] - y_pred[i]) as f64) as f32
        let abs_dev: f32 = fabs((y_true[i] - mean_y) as f64) as f32
        sum_abs_error = sum_abs_error + abs_error
        sum_abs_dev = sum_abs_dev + abs_dev
        i = i + 1
    }

    if sum_abs_dev < 0.0000000001 {
        let result: f32 = 0.0
        return result
    }
    let result: f32 = 1.0 - sum_abs_error / sum_abs_dev
    return result
}

# ============================================================================
# silhouette_samples - Per-sample silhouette coefficients
# ============================================================================

export function silhouette_samples(X: Matrix, labels: ptr<i32>, n: i32) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let label_i: i32 = labels[i]

        let mut a_i: f32 = 0.0
        let mut count_same: i32 = 0
        for j in 0 to n {
            if i != j && labels[j] == label_i {
                let mut dist: f32 = 0.0
                for k in 0 to X.cols {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    dist = dist + d * d
                }
                a_i = a_i + sqrt(dist as f64) as f32
                count_same = count_same + 1
            }
        }
        if count_same > 0 { a_i = a_i / (count_same as f32) }

        let mut best_b: f32 = 10000000000.0
        let mut found_other: bool = false
        for c in 0 to 100 {
            let mut has_cluster: bool = false
            for j in 0 to n {
                if labels[j] == c && c != label_i { has_cluster = true; break }
            }
            if not has_cluster { continue }

            let mut b_i: f32 = 0.0
            let mut count_other: i32 = 0
            for j in 0 to n {
                if labels[j] == c {
                    let mut dist: f32 = 0.0
                    for k in 0 to X.cols {
                        let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                        dist = dist + d * d
                    }
                    b_i = b_i + sqrt(dist as f64) as f32
                    count_other = count_other + 1
                }
            }
            if count_other > 0 {
                b_i = b_i / (count_other as f32)
                if b_i < best_b { best_b = b_i; found_other = true }
            }
        }

        if not found_other {
            result[i] = 0.0
        } else {
            let denom: f32 = a_i
            if best_b > denom {
                result[i] = (best_b - a_i) / best_b
            } else {
                result[i] = (best_b - a_i) / denom
            }
        }
    }
    return result
}

# ============================================================================
# rand_score - Unadjusted Rand Index
# ============================================================================

export function rand_score(labels_true: ptr<f32>, labels_pred: ptr<f32>, n: i32) -> f32 {
    let mut a: f32 = 0.0
    let mut b: f32 = 0.0
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = i + 1
        while j < n {
            let same_true: bool = labels_true[i] == labels_true[j]
            let same_pred: bool = labels_pred[i] == labels_pred[j]
            if same_true && same_pred { a = a + 1.0 }
            if not same_true && not same_pred { b = b + 1.0 }
            j = j + 1
        }
        i = i + 1
    }
    let total: f32 = (n as f32) * ((n as f32) - 1.0) / 2.0
    if total < 0.0000000001 { return 1.0 }
    return (a + b) / total
}
