    matrix_set(X, i, 1, v1)
    matrix_set(X, i, 2, v2)
    matrix_set(X, i, 3, v3)
    matrix_set(X, i, 4, v4)
    matrix_set(X, i, 5, v5)
    matrix_set(X, i, 6, v6)
    matrix_set(X, i, 7, v7)
}

