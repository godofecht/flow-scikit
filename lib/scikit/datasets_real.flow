# Real wine dataset: 178 samples, 13 features, 3 classes
# Data from sklearn.datasets.load_wine()

function _set_wine_row(X: Matrix, i: i32, v0: f32, v1: f32, v2: f32, v3: f32, v4: f32, v5: f32, v6: f32, v7: f32, v8: f32, v9: f32, v10: f32, v11: f32, v12: f32) -> void {
    matrix_set(X, i, 0, v0)
    matrix_set(X, i, 1, v1)
    matrix_set(X, i, 2, v2)
    matrix_set(X, i, 3, v3)
    matrix_set(X, i, 4, v4)
    matrix_set(X, i, 5, v5)
    matrix_set(X, i, 6, v6)
    matrix_set(X, i, 7, v7)
    matrix_set(X, i, 8, v8)
    matrix_set(X, i, 9, v9)
    matrix_set(X, i, 10, v10)
    matrix_set(X, i, 11, v11)
    matrix_set(X, i, 12, v12)
}

export function load_wine() -> Dataset {
    let n: i32 = 178
    let p: i32 = 13
    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    _set_wine_row(X, 0, 14.2, 1.7, 2.4, 15.6, 127.0, 2.8, 3.1, 0.3, 2.3, 5.6, 1.0, 3.9, 1065.0)
    y[0] = 0.0
    _set_wine_row(X, 1, 13.2, 1.8, 2.1, 11.2, 100.0, 2.6, 2.8, 0.3, 1.3, 4.4, 1.1, 3.4, 1050.0)
    y[1] = 0.0
    _set_wine_row(X, 2, 13.2, 2.4, 2.7, 18.6, 101.0, 2.8, 3.2, 0.3, 2.8, 5.7, 1.0, 3.2, 1185.0)
    y[2] = 0.0
    _set_wine_row(X, 3, 14.4, 1.9, 2.5, 16.8, 113.0, 3.9, 3.5, 0.2, 2.2, 7.8, 0.9, 3.5, 1480.0)
    y[3] = 0.0
    _set_wine_row(X, 4, 13.2, 2.6, 2.9, 21.0, 118.0, 2.8, 2.7, 0.4, 1.8, 4.3, 1.0, 2.9, 735.0)
    y[4] = 0.0
    _set_wine_row(X, 5, 14.2, 1.8, 2.5, 15.2, 112.0, 3.3, 3.4, 0.3, 2.0, 6.8, 1.1, 2.9, 1450.0)
    y[5] = 0.0
    _set_wine_row(X, 6, 14.4, 1.9, 2.5, 14.6, 96.0, 2.5, 2.5, 0.3, 2.0, 5.2, 1.0, 3.6, 1290.0)
    y[6] = 0.0
    _set_wine_row(X, 7, 14.1, 2.1, 2.6, 17.6, 121.0, 2.6, 2.5, 0.3, 1.2, 5.0, 1.1, 3.6, 1295.0)
    y[7] = 0.0
    _set_wine_row(X, 8, 14.8, 1.6, 2.2, 14.0, 97.0, 2.8, 3.0, 0.3, 2.0, 5.2, 1.1, 2.9, 1045.0)
    y[8] = 0.0
    _set_wine_row(X, 9, 13.9, 1.4, 2.3, 16.0, 98.0, 3.0, 3.1, 0.2, 1.9, 7.2, 1.0, 3.5, 1045.0)
    y[9] = 0.0
    _set_wine_row(X, 10, 14.1, 2.2, 2.3, 18.0, 105.0, 3.0, 3.3, 0.2, 2.4, 5.8, 1.2, 3.2, 1510.0)
    y[10] = 0.0
    _set_wine_row(X, 11, 14.1, 1.5, 2.3, 16.8, 95.0, 2.2, 2.4, 0.3, 1.6, 5.0, 1.2, 2.8, 1280.0)
    y[11] = 0.0
    _set_wine_row(X, 12, 13.8, 1.7, 2.4, 16.0, 89.0, 2.6, 2.8, 0.3, 1.8, 5.6, 1.1, 2.9, 1320.0)
    y[12] = 0.0
