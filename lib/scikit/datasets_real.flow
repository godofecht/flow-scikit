# Real bundled datasets for flow-scikit.
# These contain the actual data from sklearn.datasets,
# replacing the previous synthetic approximations.

import "lib/scikit/matrix.flow"

# Real iris dataset: 150 samples, 4 features, 3 classes
# Data from sklearn.datasets.load_iris()

function _set_iris_row(X: Matrix, i: i32, v0: f32, v1: f32, v2: f32, v3: f32) -> void {
    matrix_set(X, i, 0, v0)
    matrix_set(X, i, 1, v1)
    matrix_set(X, i, 2, v2)
    matrix_set(X, i, 3, v3)
}

