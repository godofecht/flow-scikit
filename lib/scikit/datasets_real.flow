# Real breast_cancer dataset: 569 samples, 30 features, 2 classes
# Data from sklearn.datasets.load_breast_cancer()

function _set_breast_cancer_part0(X: Matrix, i: i32, v0: f32, v1: f32, v2: f32, v3: f32, v4: f32, v5: f32, v6: f32, v7: f32, v8: f32, v9: f32, v10: f32, v11: f32, v12: f32, v13: f32, v14: f32) -> void {
    matrix_set(X, i, 0, v0)
    matrix_set(X, i, 1, v1)
    matrix_set(X, i, 2, v2)
    matrix_set(X, i, 3, v3)
    matrix_set(X, i, 4, v4)
    matrix_set(X, i, 5, v5)
    matrix_set(X, i, 6, v6)
    matrix_set(X, i, 7, v7)
    matrix_set(X, i, 8, v8)
    matrix_set(X, i, 9, v9)
    matrix_set(X, i, 10, v10)
    matrix_set(X, i, 11, v11)
    matrix_set(X, i, 12, v12)
    matrix_set(X, i, 13, v13)
    matrix_set(X, i, 14, v14)
}

function _set_breast_cancer_part1(X: Matrix, i: i32, v0: f32, v1: f32, v2: f32, v3: f32, v4: f32, v5: f32, v6: f32, v7: f32, v8: f32, v9: f32, v10: f32, v11: f32, v12: f32, v13: f32, v14: f32) -> void {
    matrix_set(X, i, 15, v0)
    matrix_set(X, i, 16, v1)
    matrix_set(X, i, 17, v2)
    matrix_set(X, i, 18, v3)
    matrix_set(X, i, 19, v4)
    matrix_set(X, i, 20, v5)
    matrix_set(X, i, 21, v6)
    matrix_set(X, i, 22, v7)
    matrix_set(X, i, 23, v8)
    matrix_set(X, i, 24, v9)
    matrix_set(X, i, 25, v10)
    matrix_set(X, i, 26, v11)
    matrix_set(X, i, 27, v12)
    matrix_set(X, i, 28, v13)
    matrix_set(X, i, 29, v14)
}

