# Real diabetes dataset: 442 samples, 10 features, 0 classes
# Data from sklearn.datasets.load_diabetes()

function _set_diabetes_row(X: Matrix, i: i32, v0: f32, v1: f32, v2: f32, v3: f32, v4: f32, v5: f32, v6: f32, v7: f32, v8: f32, v9: f32) -> void {
    matrix_set(X, i, 0, v0)
    matrix_set(X, i, 1, v1)
    matrix_set(X, i, 2, v2)
    matrix_set(X, i, 3, v3)
    matrix_set(X, i, 4, v4)
    matrix_set(X, i, 5, v5)
    matrix_set(X, i, 6, v6)
    matrix_set(X, i, 7, v7)
    matrix_set(X, i, 8, v8)
    matrix_set(X, i, 9, v9)
}

