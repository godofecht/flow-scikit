# Covariance estimation for flow-scikit.
# Implements EmpiricalCovariance, ShrunkCovariance, OAS, LedoitWolf, GraphicalLasso, MinCovDet.

import "lib/scikit/matrix.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function sqrt(x: f64) -> f64
    function fabs(x: f64) -> f64
    function log(x: f64) -> f64
    function rand() -> i32
    function srand(seed: u32) -> void
    function printf(fmt: string, ...) -> i32
}

export struct EmpiricalCovariance {
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    n_samples: i32,
    fitted: bool
}

export function empirical_covariance_fit(X: Matrix) -> EmpiricalCovariance {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let location: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        location[j] = m / (n as f32)
    }

    let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        cov[i] = array_new_f32(p)
    }

    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                s = s + di * dj
            }
            cov[i][j] = s / (n as f32)
        }
    }

    return EmpiricalCovariance {
        covariance: cov,
        location: location,
        n_features: p,
        n_samples: n,
        fitted: true
    }
}

export function empirical_covariance_get_precision(model: EmpiricalCovariance) -> ptr<ptr<f32> > {
    let p: i32 = model.n_features
    let inv: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        inv[i] = array_new_f32(p)
    }

    # Build augmented matrix [cov | I] and do Gaussian elimination
    let aug: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        aug[i] = array_new_f32(2 * p)
        for j in 0 to p {
            aug[i][j] = model.covariance[i][j]
        }
        aug[i][p + i] = 1.0
    }

    # Forward elimination with partial pivoting
    for col in 0 to p {
        # Find pivot
        let mut pivot: i32 = col
        let mut max_val: f32 = fabs((aug[col][col]) as f64) as f32
        for row in (col + 1) to p {
            let val: f32 = fabs((aug[row][col]) as f64) as f32
            if val > max_val {
                max_val = val
                pivot = row
            }
        }

        # Swap rows
        if pivot != col {
            for j in 0 to (2 * p) {
                let tmp: f32 = aug[col][j]
                aug[col][j] = aug[pivot][j]
                aug[pivot][j] = tmp
            }
        }

        # Skip if column is zero
        if max_val < 0.0000000001 { continue }

        # Eliminate below
        for row in (col + 1) to p {
            let factor: f32 = aug[row][col] / aug[col][col]
            for j in col to (2 * p) {
                aug[row][j] = aug[row][j] - factor * aug[col][j]
            }
        }
    }

    # Back substitution
    for col in 0 to p {
        let c: i32 = p - 1 - col
        # Normalize pivot row
        let pivot_val: f32 = aug[c][c]
        if fabs((pivot_val) as f64) as f32 > 0.0000000001 {
            for j in 0 to (2 * p) {
                aug[c][j] = aug[c][j] / pivot_val
            }
        }
        # Eliminate above
        for row in 0 to c {
            let factor: f32 = aug[row][c]
            for j in 0 to (2 * p) {
                aug[row][j] = aug[row][j] - factor * aug[c][j]
            }
        }
    }

    # Extract inverse from right half of augmented matrix
    for i in 0 to p {
        for j in 0 to p {
            inv[i][j] = aug[i][p + j]
        }
    }

    for i in 0 to p { array_free_f32(aug[i]) }
    free(aug as ptr<void>)

    return inv
}

export function empirical_covariance_mahalanobis(model: EmpiricalCovariance, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let precision: ptr<ptr<f32> > = empirical_covariance_get_precision(model)
    let dists: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let diff: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            diff[j] = matrix_at(X, i, j) - model.location[j]
        }
        let mut s: f32 = 0.0
        for a in 0 to p {
            let mut dot: f32 = 0.0
            for b in 0 to p {
                dot = dot + diff[b] * precision[a][b]
            }
            s = s + diff[a] * dot
        }
        dists[i] = s
        array_free_f32(diff)
    }

    for i in 0 to p {
        array_free_f32(precision[i])
    }
    free(precision as ptr<void>)

    return dists
}

export function empirical_covariance_free(model: EmpiricalCovariance) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.covariance[i])
    }
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
}

# ============================================================================
# ShrunkCovariance
# ============================================================================

export struct ShrunkCovariance {
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    shrinkage: f32,
    fitted: bool
}

export function shrunk_covariance_fit(X: Matrix, shrinkage: f32) -> ShrunkCovariance {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let location: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        location[j] = m / (n as f32)
    }

    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                s = s + di * dj
            }
            emp_cov[i][j] = s / (n as f32)
        }
    }

    let mut trace: f32 = 0.0
    for i in 0 to p {
        trace = trace + emp_cov[i][i]
    }
    let mu: f32 = trace / (p as f32)

    let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        cov[i] = array_new_f32(p)
        for j in 0 to p {
            if i == j {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j] + shrinkage * mu
            } else {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j]
            }
        }
    }

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)

    return ShrunkCovariance {
        covariance: cov,
        location: location,
        n_features: p,
        shrinkage: shrinkage,
        fitted: true
    }
}

export function shrunk_covariance_free(model: ShrunkCovariance) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.covariance[i])
    }
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
}

# ============================================================================
# OAS (Oracle Approximating Shrinkage)
# ============================================================================

export function oas_estimate(X: Matrix) -> f32 {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let mut trace_sq: f32 = 0.0
    let mut trace_cov_sq: f32 = 0.0
    let mut trace: f32 = 0.0

    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - mean[i]
                let dj: f32 = matrix_at(X, k, j) - mean[j]
                s = s + di * dj
            }
            let cij: f32 = s / (n as f32)
            if i == j {
                trace = trace + cij
            }
            trace_sq = trace_sq + cij * cij
        }
    }

    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - mean[i]
                let dj: f32 = matrix_at(X, k, j) - mean[j]
                s = s + di * di * dj * dj
            }
            trace_cov_sq = trace_cov_sq + (s / (n as f32)) * (s / (n as f32))
        }
    }

    array_free_f32(mean)

    let numerator: f32 = (1.0 - 2.0 / (p as f32)) * trace_cov_sq + trace * trace
    let denominator: f32 = (n as f32 + 1.0 - 2.0 / (p as f32)) * (trace_cov_sq - trace_sq / (p as f32))

    if (fabs((denominator) as f64) as f32) < 0.0000000001 {
        return 0.0
    }
    let rho: f32 = numerator / denominator
    if rho < 0.0 { rho = 0.0 }
    if rho > 1.0 { rho = 1.0 }
    return rho
}

export function oas_estimator_fit(X: Matrix) -> ShrunkCovariance {
    let shrinkage: f32 = oas_estimate(X)
    let result = shrunk_covariance_fit(X, shrinkage)
    return result
}

# ============================================================================
# LedoitWolf (optimal shrinkage estimator)
# Ledoit & Wolf (2004): "A well-conditioned estimator for large-dimensional
# covariance matrices". Computes the optimal shrinkage intensity analytically.
# Addresses sklearn #34660: adding weights to the calculation for Ledoit Wolf.
# ============================================================================

export function ledoit_wolf_estimate(X: Matrix) -> f32 {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    # Empirical covariance S (1/n)
    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - mean[i]
                let dj: f32 = matrix_at(X, k, j) - mean[j]
                s = s + di * dj
            }
            emp_cov[i][j] = s / (n as f32)
        }
    }

    # mu = trace(S) / p
    let mut trace: f32 = 0.0
    for i in 0 to p {
        trace = trace + emp_cov[i][i]
    }
    let mu: f32 = trace / (p as f32)

    # d^2 = ||S - mu*I||_F^2
    let mut d_sq: f32 = 0.0
    for i in 0 to p {
        for j in 0 to p {
            let target: f32 = 0.0
            if i == j {
                target = mu
            }
            let diff: f32 = emp_cov[i][j] - target
            d_sq = d_sq + diff * diff
        }
    }

    # b_bar^2 = (1/n^2) * sum_k ||(x_k - mean)(x_k - mean)^T - S||_F^2
    let mut b_bar_sq: f32 = 0.0
    for k in 0 to n {
        for i in 0 to p {
            for j in 0 to p {
                let di: f32 = matrix_at(X, k, i) - mean[i]
                let dj: f32 = matrix_at(X, k, j) - mean[j]
                let outer: f32 = di * dj
                let diff: f32 = outer - emp_cov[i][j]
                b_bar_sq = b_bar_sq + diff * diff
            }
        }
    }
    b_bar_sq = b_bar_sq / ((n as f32) * (n as f32))

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)
    array_free_f32(mean)

    if d_sq < 0.0000000001 {
        return 1.0
    }

    # b^2 = min(b_bar^2, d^2)
    let mut b_sq: f32 = b_bar_sq
    if b_sq > d_sq {
        b_sq = d_sq
    }

    let shrinkage: f32 = b_sq / d_sq
    return shrinkage
}

# LedoitWolf with sample weights.
# Addresses sklearn #34660: adding weights to the calculation for Ledoit Wolf.
export function ledoit_wolf_estimate_weighted(X: Matrix, sample_weights: ptr<f32>) -> f32 {
    let n: i32 = X.rows
    let p: i32 = X.cols

    # Compute total weight
    let mut total_w: f32 = 0.0
    for i in 0 to n {
        total_w = total_w + sample_weights[i]
    }
    if total_w < 0.0000000001 {
        return 1.0
    }

    # Weighted mean
    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + sample_weights[i] * matrix_at(X, i, j)
        }
        mean[j] = m / total_w
    }

    # Weighted empirical covariance S
    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - mean[i]
                let dj: f32 = matrix_at(X, k, j) - mean[j]
                s = s + sample_weights[k] * di * dj
            }
            emp_cov[i][j] = s / total_w
        }
    }

    # mu = trace(S) / p
    let mut trace: f32 = 0.0
    for i in 0 to p {
        trace = trace + emp_cov[i][i]
    }
    let mu: f32 = trace / (p as f32)

    # d^2 = ||S - mu*I||_F^2
    let mut d_sq: f32 = 0.0
    for i in 0 to p {
        for j in 0 to p {
            let target: f32 = 0.0
            if i == j {
                target = mu
            }
            let diff: f32 = emp_cov[i][j] - target
            d_sq = d_sq + diff * diff
        }
    }

    # b_bar^2 with weights
    let mut b_bar_sq: f32 = 0.0
    for k in 0 to n {
        let w: f32 = sample_weights[k] / total_w
        for i in 0 to p {
            for j in 0 to p {
                let di: f32 = matrix_at(X, k, i) - mean[i]
                let dj: f32 = matrix_at(X, k, j) - mean[j]
                let outer: f32 = di * dj
                let diff: f32 = outer - emp_cov[i][j]
                b_bar_sq = b_bar_sq + w * diff * diff
            }
        }
    }

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)
    array_free_f32(mean)

    if d_sq < 0.0000000001 {
        return 1.0
    }

    let mut b_sq: f32 = b_bar_sq
    if b_sq > d_sq {
        b_sq = d_sq
    }

    let shrinkage: f32 = b_sq / d_sq
    return shrinkage
}

export function ledoit_wolf_estimator_fit(X: Matrix) -> ShrunkCovariance {
    let shrinkage: f32 = ledoit_wolf_estimate(X)
    let result = shrunk_covariance_fit(X, shrinkage)
    return result
}

export function ledoit_wolf_estimator_fit_weighted(X: Matrix, sample_weights: ptr<f32>) -> ShrunkCovariance {
    let shrinkage: f32 = ledoit_wolf_estimate_weighted(X, sample_weights)
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mut total_w: f32 = 0.0
    for i in 0 to n {
        total_w = total_w + sample_weights[i]
    }
    if total_w < 0.0000000001 {
        total_w = 1.0
    }

    let location: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + sample_weights[i] * matrix_at(X, i, j)
        }
        location[j] = m / total_w
    }

    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                s = s + sample_weights[k] * di * dj
            }
            emp_cov[i][j] = s / total_w
        }
    }

    let mut trace: f32 = 0.0
    for i in 0 to p {
        trace = trace + emp_cov[i][i]
    }
    let mu: f32 = trace / (p as f32)

    let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        cov[i] = array_new_f32(p)
        for j in 0 to p {
            if i == j {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j] + shrinkage * mu
            } else {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j]
            }
        }
    }

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)

    return ShrunkCovariance {
        covariance: cov,
        location: location,
        n_features: p,
        shrinkage: shrinkage,
        fitted: true
    }
}

# ============================================================================
# GraphicalLasso (L1-penalized precision matrix)
# ============================================================================

export struct GraphicalLasso {
    precision: ptr<ptr<f32> >,
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    alpha: f32,
    n_iter: i32,
    fitted: bool
}

export function graphical_lasso_fit(X: Matrix, alpha: f32, max_iter: i32, tol: f32) -> GraphicalLasso {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let location: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        location[j] = m / (n as f32)
    }

    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                s = s + di * dj
            }
            emp_cov[i][j] = s / (n as f32)
        }
    }

    let precision: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    let covariance: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        precision[i] = array_new_f32(p)
        covariance[i] = array_new_f32(p)
    }

    for i in 0 to p {
        for j in 0 to p {
            precision[i][j] = 0.0
            if i == j {
                precision[i][j] = 1.0 / (emp_cov[i][i] + alpha)
            }
        }
    }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1
        let mut max_change: f32 = 0.0

        for i in 0 to p {
            let w_ii: f32 = emp_cov[i][i] + alpha
            let mut w_ii_inv: f32 = 1.0 / w_ii

            for j in 0 to p {
                if i == j { continue }
                let mut s: f32 = emp_cov[i][j]
                for k in 0 to p {
                    if k != i && k != j {
                        s = s - precision[i][k] * emp_cov[k][j]
                    }
                }
                let old: f32 = precision[i][j]
                let new_val: f32 = 0.0
                if (fabs((s) as f64) as f32) > alpha {
                    if s > 0 {
                        new_val = -(s - alpha) * w_ii_inv
                    } else {
                        new_val = -(s + alpha) * w_ii_inv
                    }
                }
                precision[i][j] = new_val
                precision[j][i] = new_val
                let change: f32 = fabs((new_val - old) as f64) as f32
                if change > max_change { max_change = change }
            }
        }

        if max_change < tol { break }
    }

    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to p {
                s = s + precision[i][k] * emp_cov[k][j]
            }
            covariance[i][j] = s
        }
    }

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)

    return GraphicalLasso {
        precision: precision,
        covariance: covariance,
        location: location,
        n_features: p,
        alpha: alpha,
        n_iter: n_iter,
        fitted: true
    }
}

export function graphical_lasso_free(model: GraphicalLasso) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.precision[i])
        array_free_f32(model.covariance[i])
    }
    free(model.precision as ptr<void>)
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
}

# ============================================================================
# MinCovDet (Minimum Covariance Determinant)
# ============================================================================

export struct MinCovDet {
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    n_samples: i32,
    support_: ptr<i32>,
    n_support: i32,
    fitted: bool
}

export function min_cov_det_fit(X: Matrix, h_fraction: f32, max_iter: i32, seed: i32) -> MinCovDet {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let h: i32 = ((n as f32) * h_fraction) as i32
    if h < p + 1 { h = p + 1 }
    if h > n { h = n }

    srand(seed)

    let best_det: ptr<f32> = array_new_f32(1)
    best_det[0] = 9999999999.0

    let best_location: ptr<f32> = array_new_f32(p)
    let best_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        best_cov[i] = array_new_f32(p)
    }

    let subset: ptr<i32> = malloc((h as i64) * 4) as ptr<i32>

    for trial in 0 to max_iter {
        for i in 0 to h {
            subset[i] = rand() % n
        }

        let loc: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for i in 0 to h {
                s = s + matrix_at(X, subset[i], j)
            }
            loc[j] = s / (h as f32)
        }

        let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
        for i in 0 to p {
            cov[i] = array_new_f32(p)
        }
        for i in 0 to p {
            for j in 0 to p {
                let mut s: f32 = 0.0
                for k in 0 to h {
                    let di: f32 = matrix_at(X, subset[k], i) - loc[i]
                    let dj: f32 = matrix_at(X, subset[k], j) - loc[j]
                    s = s + di * dj
                }
                cov[i][j] = s / (h as f32)
            }
        }

        let mut det: f32 = 1.0
        for i in 0 to p {
            det = det * (cov[i][i] + 0.0000000001)
        }
        det = fabs((det) as f64) as f32

        if det < best_det[0] {
            best_det[0] = det
            for j in 0 to p {
                best_location[j] = loc[j]
            }
            for i in 0 to p {
                for j in 0 to p {
                    best_cov[i][j] = cov[i][j]
                }
            }
        }

        array_free_f32(loc)
        for i in 0 to p {
            array_free_f32(cov[i])
        }
        free(cov as ptr<void>)
    }

    let support_: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut n_support: i32 = 0
    let dists: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut s: f32 = 0.0
        for a in 0 to p {
            let d: f32 = matrix_at(X, i, a) - best_location[a]
            s = s + d * d / (best_cov[a][a] + 0.0000000001)
        }
        dists[i] = s
    }

    let threshold: f32 = (p as f32) * 2.0
    for i in 0 to n {
        if dists[i] < threshold {
            support_[n_support] = i
            n_support = n_support + 1
        }
    }

    array_free_f32(dists)
    array_free_f32(best_det)
    free(subset as ptr<void>)

    return MinCovDet {
        covariance: best_cov,
        location: best_location,
        n_features: p,
        n_samples: n,
        support_: support_,
        n_support: n_support,
        fitted: true
    }
}

export function min_cov_det_free(model: MinCovDet) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.covariance[i])
    }
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
    free(model.support_ as ptr<void>)
}

# ============================================================================
# GraphicalLassoCV
# ============================================================================

export struct GraphicalLassoCV {
    emp_cov: Matrix,
    alpha: f32,
    n_iter: i32,
    n_features: i32,
    fitted: bool
}

export function graphical_lasso_cv_fit(X: Matrix, n_alphas: i32, n_folds: i32, max_iter: i32) -> GraphicalLassoCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Compute empirical covariance
    let emp_cov: Matrix = matrix_new(n_features, n_features)
    let means: ptr<f32> = array_new_f32(n_features)
    let mut j: i32 = 0
    while j < n_features {
        let mut s: f32 = 0.0
        let mut i: i32 = 0
        while i < n {
            s = s + matrix_at(X, i, j)
            i = i + 1
        }
        means[j] = s / (n as f32)
        j = j + 1
    }

    let mut i: i32 = 0
    while i < n_features {
        let mut j2: i32 = 0
        while j2 < n_features {
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < n {
                let d1: f32 = matrix_at(X, k, i) - means[i]
                let d2: f32 = matrix_at(X, k, j2) - means[j2]
                s = s + d1 * d2
                k = k + 1
            }
            matrix_set(emp_cov, i, j2, s / ((n - 1) as f32))
            j2 = j2 + 1
        }
        i = i + 1
    }

    # Grid of alpha values
    let mut max_off: f32 = 0.0
    i = 0
    while i < n_features {
        let mut j3: i32 = 0
        while j3 < n_features {
            if i != j3 {
                let v: f32 = fabs((matrix_at(emp_cov, i, j3)) as f64) as f32
                if v > max_off {
                    max_off = v
                }
            }
            j3 = j3 + 1
        }
        i = i + 1
    }

    # Try each alpha, compute log-likelihood
    let mut best_alpha: f32 = max_off
    let mut best_score: f32 = -999999.0

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let mut alpha: f32 = max_off * ((a_idx as f32) + 1.0) / (n_alphas as f32)
        if alpha < 0.001 { alpha = 0.001 }

        # Fit GraphicalLasso with this alpha
        let gl: GraphicalLasso = graphical_lasso_fit(emp_cov, alpha, max_iter, 0.0001)

        # Compute log-likelihood using the precision matrix
        # log(det(precision)) - trace(precision * emp_cov)
        # Access precision via gl.precision which is ptr<ptr<f32>>
        let mut trace: f32 = 0.0
        i = 0
        while i < n_features {
            let mut j4: i32 = 0
            while j4 < n_features {
                trace = trace + gl.precision[i][j4] * matrix_at(emp_cov, j4, i)
                j4 = j4 + 1
            }
            i = i + 1
        }
        # Simple score: negative trace (higher is better)
        let score: f32 = -trace

        if score > best_score {
            best_score = score
            best_alpha = alpha
        }

        graphical_lasso_free(gl)
        a_idx = a_idx + 1
    }

    array_free_f32(means)

    let emp_cov_copy: Matrix = matrix_copy(emp_cov)
    matrix_free(emp_cov)

    let result: GraphicalLassoCV = GraphicalLassoCV {
        emp_cov: emp_cov_copy,
        alpha: best_alpha,
        n_iter: max_iter,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function graphical_lasso_cv_free(model: GraphicalLassoCV) -> void {
    matrix_free(model.emp_cov)
}

# ============================================================================
# LedoitWolf: oracle approximating shrinkage via analytical formula
# Ledoit and Wolf (2004). Optimal shrinkage estimator.
# ============================================================================

export struct LedoitWolf {
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    shrinkage: f32,
    fitted: bool
}

export function ledoit_wolf_cv_fit(X: Matrix) -> LedoitWolf {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let location: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        location[j] = m / (n as f32)
    }

    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                s = s + di * dj
            }
            emp_cov[i][j] = s / (n as f32)
        }
    }

    # Compute mu = trace(emp_cov) / p
    let mut trace: f32 = 0.0
    for i in 0 to p {
        trace = trace + emp_cov[i][i]
    }
    let mu: f32 = trace / (p as f32)

    # Compute delta = ||emp_cov - mu*I||^2_F / p
    let mut delta: f32 = 0.0
    for i in 0 to p {
        for j in 0 to p {
            let diff: f32 = emp_cov[i][j]
            if i == j {
                diff = emp_cov[i][j] - mu
            }
            delta = delta + diff * diff
        }
    }
    delta = delta / (p as f32)

    # Compute d^2 = sum of var of entries / (n * p)
    let mut d2: f32 = 0.0
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                let val: f32 = di * dj - emp_cov[i][j]
                s = s + val * val
            }
            d2 = d2 + s
        }
    }
    d2 = d2 / ((n as f32) * (n as f32) * (p as f32))

    # shrinkage = max(0, min(1, d2 / delta))
    let mut shrinkage: f32 = d2 / delta
    if shrinkage < 0.0 { shrinkage = 0.0 }
    if shrinkage > 1.0 { shrinkage = 1.0 }

    # Apply shrinkage: (1 - shrinkage) * emp_cov + shrinkage * mu * I
    let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        cov[i] = array_new_f32(p)
        for j in 0 to p {
            if i == j {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j] + shrinkage * mu
            } else {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j]
            }
        }
    }

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)

    return LedoitWolf {
        covariance: cov,
        location: location,
        n_features: p,
        shrinkage: shrinkage,
        fitted: true
    }
}

export function ledoit_wolf_cv_free(model: LedoitWolf) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.covariance[i])
    }
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
}

# ============================================================================
# OAS: Oracle Approximating Shrinkage
# Chen et al. (2010). Improved estimator of shrinkage.
# ============================================================================

export struct OAS {
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    shrinkage: f32,
    fitted: bool
}

export function oas_cv_fit(X: Matrix) -> OAS {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let location: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        location[j] = m / (n as f32)
    }

    let emp_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        emp_cov[i] = array_new_f32(p)
    }
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                let di: f32 = matrix_at(X, k, i) - location[i]
                let dj: f32 = matrix_at(X, k, j) - location[j]
                s = s + di * dj
            }
            emp_cov[i][j] = s / (n as f32)
        }
    }

    let mut trace: f32 = 0.0
    let mut trace2: f32 = 0.0
    for i in 0 to p {
        trace = trace + emp_cov[i][i]
        trace2 = trace2 + emp_cov[i][i] * emp_cov[i][i]
    }
    let mu: f32 = trace / (p as f32)

    # OAS formula: rho = ((1-2/p)*tr(S^2) + tr(S)^2) / ((n+1-2/p)*tr(S^2) + tr(S)^2)
    # where tr(S^2) = sum of all squared entries
    let mut sum_sq: f32 = 0.0
    for i in 0 to p {
        for j in 0 to p {
            sum_sq = sum_sq + emp_cov[i][j] * emp_cov[i][j]
        }
    }

    let numerator: f32 = (1.0 - 2.0 / (p as f32)) * sum_sq + trace * trace
    let denominator: f32 = (n as f32 + 1.0 - 2.0 / (p as f32)) * sum_sq + trace * trace
    let mut shrinkage: f32 = numerator / denominator
    if shrinkage < 0.0 { shrinkage = 0.0 }
    if shrinkage > 1.0 { shrinkage = 1.0 }

    let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        cov[i] = array_new_f32(p)
        for j in 0 to p {
            if i == j {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j] + shrinkage * mu
            } else {
                cov[i][j] = (1.0 - shrinkage) * emp_cov[i][j]
            }
        }
    }

    for i in 0 to p {
        array_free_f32(emp_cov[i])
    }
    free(emp_cov as ptr<void>)

    return OAS {
        covariance: cov,
        location: location,
        n_features: p,
        shrinkage: shrinkage,
        fitted: true
    }
}

export function oas_cv_free(model: OAS) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.covariance[i])
    }
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
}

# ============================================================================
# EllipticEnvelope: outlier detection via robust covariance (MinCovDet)
# Uses Mahalanobis distance with MCD estimate.
# ============================================================================

export struct EllipticEnvelope {
    covariance: ptr<ptr<f32> >,
    location: ptr<f32>,
    n_features: i32,
    contamination: f32,
    support_: ptr<i32>,
    n_support: i32,
    fitted: bool
}

export function elliptic_envelope_fit(X: Matrix, contamination: f32, n_trials: i32) -> EllipticEnvelope {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let h: i32 = (n * 3) / 4
    if h > n { h = n }
    if h < 2 { h = 2 }

    srand(42)

    let best_location: ptr<f32> = array_new_f32(p)
    let best_cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p { best_cov[i] = array_new_f32(p) }
    let mut best_det: f32 = 1000000000.0

    let support_: ptr<i32> = array_new_f32(h) as ptr<i32>

    for trial in 0 to n_trials {
        # Random subset of size h
        let subset: ptr<i32> = array_new_f32(h) as ptr<i32>
        for i in 0 to h {
            subset[i] = rand() % n
        }

        # Compute mean of subset
        let loc: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for i in 0 to h {
                s = s + matrix_at(X, subset[i], j)
            }
            loc[j] = s / (h as f32)
        }

        # Compute covariance of subset
        let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
        for i in 0 to p { cov[i] = array_new_f32(p) }
        for i in 0 to p {
            for j in 0 to p {
                let mut s: f32 = 0.0
                for k in 0 to h {
                    let di: f32 = matrix_at(X, subset[k], i) - loc[i]
                    let dj: f32 = matrix_at(X, subset[k], j) - loc[j]
                    s = s + di * dj
                }
                cov[i][j] = s / (h as f32)
            }
        }

        # Compute determinant (simplified: product of diagonal)
        let mut det: f32 = 1.0
        for i in 0 to p {
            if cov[i][i] > 0.0000000001 {
                det = det * cov[i][i]
            } else {
                det = det * 0.0000000001
            }
        }

        if det < best_det {
            best_det = det
            for j in 0 to p { best_location[j] = loc[j] }
            for i in 0 to p {
                for j in 0 to p {
                    best_cov[i][j] = cov[i][j]
                }
            }
            for i in 0 to h { support_[i] = subset[i] }
        }

        array_free_f32(loc)
        for i in 0 to p { array_free_f32(cov[i]) }
        free(cov as ptr<void>)
        array_free_f32(subset as ptr<f32>)
    }

    return EllipticEnvelope {
        covariance: best_cov,
        location: best_location,
        n_features: p,
        contamination: contamination,
        support_: support_,
        n_support: h,
        fitted: true
    }
}

export function elliptic_envelope_predict(model: EllipticEnvelope, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let result: ptr<f32> = array_new_f32(n)

    # Compute Mahalanobis distance for each sample
    # Simplified: use diagonal covariance inverse
    let inv_diag: ptr<f32> = array_new_f32(p)
    for i in 0 to p {
        if model.covariance[i][i] > 0.0000000001 {
            inv_diag[i] = 1.0 / model.covariance[i][i]
        } else {
            inv_diag[i] = 0.0
        }
    }

    # Threshold based on contamination
    let threshold: f32 = (p as f32) * 2.0

    for i in 0 to n {
        let mut dist: f32 = 0.0
        for j in 0 to p {
            let diff: f32 = matrix_at(X, i, j) - model.location[j]
            dist = dist + diff * diff * inv_diag[j]
        }
        if dist > threshold {
            result[i] = -1.0
        } else {
            result[i] = 1.0
        }
    }

    array_free_f32(inv_diag)
    return result
}

export function elliptic_envelope_free(model: EllipticEnvelope) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.covariance[i])
    }
    free(model.covariance as ptr<void>)
    array_free_f32(model.location)
    array_free_f32(model.support_ as ptr<f32>)
}
