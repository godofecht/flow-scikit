# Cross decomposition module for flow-scikit.
# Implements PLS (Partial Least Squares) regression via NIPALS algorithm.
# Supports PLSRegression for supervised dimensionality reduction.

import "lib/scikit/matrix.flow"

export struct PLSRegression {
    x_mean: ptr<f32>,
    x_std: ptr<f32>,
    y_mean: ptr<f32>,
    y_std: ptr<f32>,
    x_weights: ptr<f32>,
    y_weights: ptr<f32>,
    x_scores: ptr<f32>,
    y_scores: ptr<f32>,
    x_loadings: ptr<f32>,
    y_loadings: ptr<f32>,
    coef: ptr<f32>,
    n_components: i32,
    n_features: i32,
    n_targets: i32,
    n_samples: i32,
    fitted: bool
}

function compute_mean_col(m: Matrix, col: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to m.rows {
        sum = sum + matrix_at(m, i, col)
    }
    return sum / (m.rows as f32)
}

function compute_std_col(m: Matrix, col: i32, mean: f32) -> f32 {
    let mut sum_sq: f32 = 0.0
    for i in 0 to m.rows {
        let d: f32 = matrix_at(m, i, col) - mean
        sum_sq = sum_sq + d * d
    }
    let var: f32 = sum_sq / (m.rows as f32)
    if var < 0.0000000001 {
        return 1.0
    }
    return sqrt(var as f64) as f32
}

export function pls_fit(X: Matrix, Y: Matrix, n_components: i32, max_iter: i32, tol: f32) -> PLSRegression {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let q: i32 = Y.cols

    let x_mean: ptr<f32> = array_new_f32(p)
    let x_std: ptr<f32> = array_new_f32(p)
    let y_mean: ptr<f32> = array_new_f32(q)
    let y_std: ptr<f32> = array_new_f32(q)

    for j in 0 to p {
        x_mean[j] = compute_mean_col(X, j)
        x_std[j] = compute_std_col(X, j, x_mean[j])
    }
    for j in 0 to q {
        y_mean[j] = compute_mean_col(Y, j)
        y_std[j] = compute_std_col(Y, j, y_mean[j])
    }

    let Xc: Matrix = matrix_new(n, p)
    let Yc: Matrix = matrix_new(n, q)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, (matrix_at(X, i, j) - x_mean[j]) / x_std[j])
        }
        for j in 0 to q {
            matrix_set(Yc, i, j, (matrix_at(Y, i, j) - y_mean[j]) / y_std[j])
        }
    }

    let x_weights: ptr<f32> = array_new_f32(n_components * p)
    let y_weights: ptr<f32> = array_new_f32(n_components * q)
    let x_scores: ptr<f32> = array_new_f32(n * n_components)
    let y_scores: ptr<f32> = array_new_f32(n * n_components)
    let x_loadings: ptr<f32> = array_new_f32(n_components * p)
    let y_loadings: ptr<f32> = array_new_f32(n_components * q)

    let Xk: Matrix = matrix_copy(Xc)
    let Yk: Matrix = matrix_copy(Yc)

    for c in 0 to n_components {
        let u: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            u[i] = matrix_at(Yk, i, 0)
        }

        let t: ptr<f32> = array_new_f32(n)
        let w: ptr<f32> = array_new_f32(p)
        let c_vec: ptr<f32> = array_new_f32(q)

        for _ in 0 to max_iter {
            let w_new: ptr<f32> = array_new_f32(p)
            for j in 0 to p {
                let mut sum: f32 = 0.0
                for i in 0 to n {
                    sum = sum + matrix_at(Xk, i, j) * u[i]
                }
                w_new[j] = sum
            }
            let w_norm: f32 = 0.0
            for j in 0 to p {
                w_norm = w_norm + w_new[j] * w_new[j]
            }
            w_norm = sqrt(w_norm as f64) as f32
            if w_norm < 0.0000000001 { w_norm = 1.0 }
            for j in 0 to p {
                w_new[j] = w_new[j] / w_norm
            }

            let t_new: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut sum: f32 = 0.0
                for j in 0 to p {
                    sum = sum + matrix_at(Xk, i, j) * w_new[j]
                }
                t_new[i] = sum
            }

            let c_new: ptr<f32> = array_new_f32(q)
            for j in 0 to q {
                let mut sum: f32 = 0.0
                for i in 0 to n {
                    sum = sum + matrix_at(Yk, i, j) * t_new[i]
                }
                c_new[j] = sum
            }

            let u_new: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut sum: f32 = 0.0
                for j in 0 to q {
                    sum = sum + matrix_at(Yk, i, j) * c_new[j]
                }
                u_new[i] = sum
            }

            let mut diff: f32 = 0.0
            for i in 0 to n {
                let d: f32 = t_new[i] - t[i]
                diff = diff + d * d
            }
            diff = sqrt(diff as f64) as f32

            for i in 0 to n { t[i] = t_new[i] }
            for j in 0 to p { w[j] = w_new[j] }
            for j in 0 to q { c_vec[j] = c_new[j] }
            for i in 0 to n { u[i] = u_new[i] }

            array_free_f32(w_new)
            array_free_f32(t_new)
            array_free_f32(c_new)
            array_free_f32(u_new)

            if diff < tol {
                break
            }
        }

        let p_vec: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            let mut sum: f32 = 0.0
            for i in 0 to n {
                sum = sum + matrix_at(Xk, i, j) * t[i]
            }
            p_vec[j] = sum
        }

        let t_norm: f32 = 0.0
        for i in 0 to n {
            t_norm = t_norm + t[i] * t[i]
        }
        if t_norm < 0.0000000001 { t_norm = 1.0 }

        for j in 0 to p {
            x_weights[c * p + j] = w[j]
            x_loadings[c * p + j] = p_vec[j] / t_norm
        }
        for j in 0 to q {
            y_weights[c * q + j] = c_vec[j]
            y_loadings[c * q + j] = c_vec[j] / t_norm
        }
        for i in 0 to n {
            x_scores[i * n_components + c] = t[i]
            y_scores[i * n_components + c] = u[i]
        }

        for i in 0 to n {
            for j in 0 to p {
                let val: f32 = matrix_at(Xk, i, j) - t[i] * p_vec[j] / t_norm
                matrix_set(Xk, i, j, val)
            }
            for j in 0 to q {
                let val: f32 = matrix_at(Yk, i, j) - t[i] * c_vec[j] / t_norm
                matrix_set(Yk, i, j, val)
            }
        }

        array_free_f32(u)
        array_free_f32(t)
        array_free_f32(w)
        array_free_f32(c_vec)
        array_free_f32(p_vec)
    }

    # Coefficient matrix: coef = W * (P^T * W)^{-1} * C^T
    # For orthogonal W (which NIPLS produces), P^T * W is upper triangular
    # and its inverse can be computed by back-substitution.
    # For simplicity, compute R = W * (P^T * W)^{-1} then coef = R * C^T
    let pt_w: ptr<f32> = array_new_f32(n_components * n_components)
    for a in 0 to n_components {
        for b in 0 to n_components {
            let mut sum: f32 = 0.0
            for j in 0 to p {
                sum = sum + x_loadings[a * p + j] * x_weights[b * p + j]
            }
            pt_w[a * n_components + b] = sum
        }
    }

    # Invert pt_w (n_components x n_components) via Gaussian elimination
    let inv_ptw: ptr<f32> = array_new_f32(n_components * n_components)
    for i in 0 to n_components {
        for j in 0 to n_components {
            if i == j {
                inv_ptw[i * n_components + j] = 1.0
            } else {
                inv_ptw[i * n_components + j] = 0.0
            }
        }
    }
    let eps: f32 = 0.000000000001
    for col in 0 to n_components {
        let pivot: f32 = pt_w[col * n_components + col]
        let abs_pivot: f32 = fabs(pivot as f64) as f32
        if abs_pivot < eps {
            # Skip degenerate column
            continue
        }
        for j in 0 to n_components {
            pt_w[col * n_components + j] = pt_w[col * n_components + j] / pivot
            inv_ptw[col * n_components + j] = inv_ptw[col * n_components + j] / pivot
        }
        for row in 0 to n_components {
            if row == col {
                continue
            }
            let factor: f32 = pt_w[row * n_components + col]
            for j in 0 to n_components {
                pt_w[row * n_components + j] = pt_w[row * n_components + j] - factor * pt_w[col * n_components + j]
                inv_ptw[row * n_components + j] = inv_ptw[row * n_components + j] - factor * inv_ptw[col * n_components + j]
            }
        }
    }

    # R = W * inv_ptw  (p x n_components)
    let r_mat: ptr<f32> = array_new_f32(p * n_components)
    for j in 0 to p {
        for a in 0 to n_components {
            let mut sum: f32 = 0.0
            for b in 0 to n_components {
                sum = sum + x_weights[b * p + j] * inv_ptw[b * n_components + a]
            }
            r_mat[j * n_components + a] = sum
        }
    }

    # coef = R * Q^T  (p x q), where Q = y_loadings
    let coef: ptr<f32> = array_new_f32(p * q)
    for j in 0 to p {
        for k in 0 to q {
            let mut sum: f32 = 0.0
            for a in 0 to n_components {
                sum = sum + r_mat[j * n_components + a] * y_loadings[a * q + k]
            }
            coef[j * q + k] = sum
        }
    }

    array_free_f32(pt_w)
    array_free_f32(inv_ptw)
    array_free_f32(r_mat)

    matrix_free(Xc)
    matrix_free(Yc)
    matrix_free(Xk)
    matrix_free(Yk)

    return PLSRegression {
        x_mean: x_mean,
        x_std: x_std,
        y_mean: y_mean,
        y_std: y_std,
        x_weights: x_weights,
        y_weights: y_weights,
        x_scores: x_scores,
        y_scores: y_scores,
        x_loadings: x_loadings,
        y_loadings: y_loadings,
        coef: coef,
        n_components: n_components,
        n_features: p,
        n_targets: q,
        n_samples: n,
        fitted: true
    }
}

export function pls_predict(model: PLSRegression, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_targets)

    for i in 0 to n {
        for k in 0 to model.n_targets {
            let mut sum: f32 = 0.0
            for j in 0 to model.n_features {
                let x_val: f32 = (matrix_at(X, i, j) - model.x_mean[j]) / model.x_std[j]
                sum = sum + x_val * model.coef[j * model.n_targets + k]
            }
            matrix_set(result, i, k, sum * model.y_std[k] + model.y_mean[k])
        }
    }

    return result
}

export function pls_transform(model: PLSRegression, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)

    for i in 0 to n {
        for c in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for j in 0 to model.n_features {
                let x_val: f32 = (matrix_at(X, i, j) - model.x_mean[j]) / model.x_std[j]
                sum = sum + x_val * model.x_weights[c * model.n_features + j]
            }
            matrix_set(result, i, c, sum)
        }
    }

    return result
}

export function pls_free(model: PLSRegression) -> void {
    array_free_f32(model.x_mean)
    array_free_f32(model.x_std)
    array_free_f32(model.y_mean)
    array_free_f32(model.y_std)
    array_free_f32(model.x_weights)
    array_free_f32(model.y_weights)
    array_free_f32(model.x_scores)
    array_free_f32(model.y_scores)
    array_free_f32(model.x_loadings)
    array_free_f32(model.y_loadings)
    array_free_f32(model.coef)
}

# ============================================================================
# CCA (Canonical Correlation Analysis)
# ============================================================================

export struct CCA {
    x_weights: ptr<ptr<f32> >,
    y_weights: ptr<ptr<f32> >,
    n_components: i32,
    n_x_features: i32,
    n_y_features: i32,
    fitted: bool
}

export function cca_fit(X: Matrix, Y: Matrix, n_components: i32, max_iter: i32, tol: f32) -> CCA {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let q: i32 = Y.cols

    let x_mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        x_mean[j] = s / (n as f32)
    }
    let y_mean: ptr<f32> = array_new_f32(q)
    for j in 0 to q {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(Y, i, j) }
        y_mean[j] = s / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - x_mean[j])
        }
    }
    let Yc: Matrix = matrix_new(n, q)
    for i in 0 to n {
        for j in 0 to q {
            matrix_set(Yc, i, j, matrix_at(Y, i, j) - y_mean[j])
        }
    }

    let x_weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let y_weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >

    for c in 0 to n_components {
        let u: ptr<f32> = array_new_f32(q)
        srand(42 + c)
        for j in 0 to q { u[j] = ((rand() % 1000) as f32) / 500.0 - 1.0 }

        let mut prev_corr: f32 = 0.0
        for iter in 0 to max_iter {
            let a: ptr<f32> = array_new_f32(p)
            for j in 0 to p {
                for i in 0 to n {
                    for k in 0 to q {
                        a[j] = a[j] + matrix_at(Xc, i, j) * matrix_at(Yc, i, k) * u[k]
                    }
                }
            }

            let mut a_norm: f32 = 0.0
            for j in 0 to p { a_norm = a_norm + a[j] * a[j] }
            a_norm = sqrt((a_norm as f64)) as f32
            if a_norm < 0.0000000001 { a_norm = 0.0000000001 }
            for j in 0 to p { a[j] = a[j] / a_norm }

            let b: ptr<f32> = array_new_f32(q)
            for j in 0 to q {
                let mut s: f32 = 0.0
                for i in 0 to n {
                    for k in 0 to p {
                        s = s + matrix_at(Yc, i, j) * matrix_at(Xc, i, k) * a[k]
                    }
                }
                b[j] = s
            }

            let mut b_norm: f32 = 0.0
            for j in 0 to q { b_norm = b_norm + b[j] * b[j] }
            b_norm = sqrt((b_norm as f64)) as f32
            if b_norm < 0.0000000001 { b_norm = 0.0000000001 }
            for j in 0 to q { b[j] = b[j] / b_norm }

            let mut corr: f32 = 0.0
            for i in 0 to n {
                let mut xa: f32 = 0.0
                let mut yb: f32 = 0.0
                for j in 0 to p { xa = xa + matrix_at(Xc, i, j) * a[j] }
                for j in 0 to q { yb = yb + matrix_at(Yc, i, j) * b[j] }
                corr = corr + xa * yb
            }
            corr = corr / (n as f32)

            for j in 0 to q { u[j] = b[j] }
            array_free_f32(a)
            array_free_f32(b)

            if (fabs((corr - prev_corr) as f64) as f32) < tol { break }
            prev_corr = corr
        }

        x_weights[c] = array_new_f32(p)
        y_weights[c] = array_new_f32(q)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for i in 0 to n {
                for k in 0 to q {
                    s = s + matrix_at(Xc, i, j) * matrix_at(Yc, i, k) * u[k]
                }
            }
            x_weights[c][j] = s
        }
        let mut x_norm: f32 = 0.0
        for j in 0 to p { x_norm = x_norm + x_weights[c][j] * x_weights[c][j] }
        x_norm = sqrt((x_norm as f64)) as f32
        if x_norm < 0.0000000001 { x_norm = 0.0000000001 }
        for j in 0 to p { x_weights[c][j] = x_weights[c][j] / x_norm }

        for j in 0 to q {
            let mut s: f32 = 0.0
            for i in 0 to n {
                for k in 0 to p {
                    s = s + matrix_at(Yc, i, j) * matrix_at(Xc, i, k) * x_weights[c][k]
                }
            }
            y_weights[c][j] = s
        }
        let mut y_norm: f32 = 0.0
        for j in 0 to q { y_norm = y_norm + y_weights[c][j] * y_weights[c][j] }
        y_norm = sqrt((y_norm as f64)) as f32
        if y_norm < 0.0000000001 { y_norm = 0.0000000001 }
        for j in 0 to q { y_weights[c][j] = y_weights[c][j] / y_norm }

        for i in 0 to n {
            let mut score: f32 = 0.0
            for j in 0 to p { score = score + matrix_at(Xc, i, j) * x_weights[c][j] }
            for j in 0 to p {
                matrix_set(Xc, i, j, matrix_at(Xc, i, j) - score * x_weights[c][j])
            }
        }
        for i in 0 to n {
            let mut score: f32 = 0.0
            for j in 0 to q { score = score + matrix_at(Yc, i, j) * y_weights[c][j] }
            for j in 0 to q {
                matrix_set(Yc, i, j, matrix_at(Yc, i, j) - score * y_weights[c][j])
            }
        }

        array_free_f32(u)
    }

    matrix_free(Xc)
    matrix_free(Yc)
    array_free_f32(x_mean)
    array_free_f32(y_mean)

    return CCA {
        x_weights: x_weights,
        y_weights: y_weights,
        n_components: n_components,
        n_x_features: p,
        n_y_features: q,
        fitted: true
    }
}

export function cca_transform(model: CCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_x_features {
                s = s + matrix_at(X, i, j) * model.x_weights[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function cca_free(model: CCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.x_weights[c])
        array_free_f32(model.y_weights[c])
    }
    free(model.x_weights as ptr<void>)
    free(model.y_weights as ptr<void>)
}

# ============================================================================
# PLSCanonical
# ============================================================================

export struct PLSCanonical {
    x_weights: ptr<ptr<f32> >,
    y_weights: ptr<ptr<f32> >,
    n_components: i32,
    n_x_features: i32,
    n_y_features: i32,
    fitted: bool
}

export function pls_canonical_fit(X: Matrix, Y: Matrix, n_components: i32) -> PLSCanonical {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let q: i32 = Y.cols

    let x_mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        x_mean[j] = s / (n as f32)
    }
    let y_mean: ptr<f32> = array_new_f32(q)
    for j in 0 to q {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(Y, i, j) }
        y_mean[j] = s / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - x_mean[j])
        }
    }
    let Yc: Matrix = matrix_new(n, q)
    for i in 0 to n {
        for j in 0 to q {
            matrix_set(Yc, i, j, matrix_at(Y, i, j) - y_mean[j])
        }
    }

    let x_weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let y_weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >

    for c in 0 to n_components {
        let mut max_val: f32 = -9999999999.0
        let mut max_j: i32 = 0
        for j in 0 to q {
            let mut s: f32 = 0.0
            for i in 0 to n { s = s + matrix_at(Yc, i, j) * matrix_at(Yc, i, j) }
            if s > max_val { max_val = s; max_j = j }
        }

        let u: ptr<f32> = array_new_f32(n)
        for i in 0 to n { u[i] = matrix_at(Yc, i, max_j) }

        let w: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for i in 0 to n { s = s + matrix_at(Xc, i, j) * u[i] }
            w[j] = s
        }
        let mut w_norm: f32 = 0.0
        for j in 0 to p { w_norm = w_norm + w[j] * w[j] }
        w_norm = sqrt((w_norm as f64)) as f32
        if w_norm < 0.0000000001 { w_norm = 0.0000000001 }
        for j in 0 to p { w[j] = w[j] / w_norm }

        let t: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            let mut s: f32 = 0.0
            for j in 0 to p { s = s + matrix_at(Xc, i, j) * w[j] }
            t[i] = s
        }

        let c_vec: ptr<f32> = array_new_f32(q)
        for j in 0 to q {
            let mut s: f32 = 0.0
            for i in 0 to n { s = s + matrix_at(Yc, i, j) * t[i] }
            c_vec[j] = s
        }
        let mut c_norm: f32 = 0.0
        for j in 0 to q { c_norm = c_norm + c_vec[j] * c_vec[j] }
        c_norm = sqrt((c_norm as f64)) as f32
        if c_norm < 0.0000000001 { c_norm = 0.0000000001 }
        for j in 0 to q { c_vec[j] = c_vec[j] / c_norm }

        x_weights[c] = w
        y_weights[c] = c_vec

        let p_load: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for i in 0 to n { s = s + matrix_at(Xc, i, j) * t[i] }
            p_load[j] = s
        }
        let t_norm: f32 = 0.0
        for i in 0 to n { t_norm = t_norm + t[i] * t[i] }
        if t_norm > 0.0000000001 {
            for i in 0 to n {
                for j in 0 to p {
                    matrix_set(Xc, i, j, matrix_at(Xc, i, j) - t[i] * p_load[j] / t_norm)
                }
            }
        }

        let q_load: ptr<f32> = array_new_f32(q)
        for j in 0 to q {
            let mut s: f32 = 0.0
            for i in 0 to n { s = s + matrix_at(Yc, i, j) * t[i] }
            q_load[j] = s
        }
        if t_norm > 0.0000000001 {
            for i in 0 to n {
                for j in 0 to q {
                    matrix_set(Yc, i, j, matrix_at(Yc, i, j) - t[i] * q_load[j] / t_norm)
                }
            }
        }

        array_free_f32(u)
        array_free_f32(t)
        array_free_f32(p_load)
        array_free_f32(q_load)
    }

    matrix_free(Xc)
    matrix_free(Yc)
    array_free_f32(x_mean)
    array_free_f32(y_mean)

    return PLSCanonical {
        x_weights: x_weights,
        y_weights: y_weights,
        n_components: n_components,
        n_x_features: p,
        n_y_features: q,
        fitted: true
    }
}

export function pls_canonical_transform(model: PLSCanonical, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_x_features {
                s = s + matrix_at(X, i, j) * model.x_weights[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function pls_canonical_free(model: PLSCanonical) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.x_weights[c])
        array_free_f32(model.y_weights[c])
    }
    free(model.x_weights as ptr<void>)
    free(model.y_weights as ptr<void>)
}

# ============================================================================
# PLSSVD
# ============================================================================

export struct PLSSVD {
    x_weights: ptr<ptr<f32> >,
    y_weights: ptr<ptr<f32> >,
    n_components: i32,
    n_x_features: i32,
    n_y_features: i32,
    fitted: bool
}

export function pls_svd_fit(X: Matrix, Y: Matrix, n_components: i32) -> PLSSVD {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let q: i32 = Y.cols

    let x_mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        x_mean[j] = s / (n as f32)
    }
    let y_mean: ptr<f32> = array_new_f32(q)
    for j in 0 to q {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(Y, i, j) }
        y_mean[j] = s / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - x_mean[j])
        }
    }
    let Yc: Matrix = matrix_new(n, q)
    for i in 0 to n {
        for j in 0 to q {
            matrix_set(Yc, i, j, matrix_at(Y, i, j) - y_mean[j])
        }
    }

    let C: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for j in 0 to p {
        C[j] = array_new_f32(q)
        for k in 0 to q {
            let mut s: f32 = 0.0
            for i in 0 to n {
                s = s + matrix_at(Xc, i, j) * matrix_at(Yc, i, k)
            }
            C[j][k] = s
        }
    }

    let x_weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let y_weights: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >

    for c in 0 to n_components {
        let u: ptr<f32> = array_new_f32(p)
        srand(42 + c)
        for j in 0 to p { u[j] = ((rand() % 1000) as f32) / 500.0 - 1.0 }

        for iter in 0 to 100 {
            let Cv: ptr<f32> = array_new_f32(q)
            for k in 0 to q {
                let mut s: f32 = 0.0
                for j in 0 to p { s = s + C[j][k] * u[j] }
                Cv[k] = s
            }
            let mut v_norm: f32 = 0.0
            for k in 0 to q { v_norm = v_norm + Cv[k] * Cv[k] }
            v_norm = sqrt((v_norm as f64)) as f32
            if v_norm < 0.0000000001 { v_norm = 0.0000000001 }
            for k in 0 to q { Cv[k] = Cv[k] / v_norm }

            let CtCv: ptr<f32> = array_new_f32(p)
            for j in 0 to p {
                let mut s: f32 = 0.0
                for k in 0 to q { s = s + C[j][k] * Cv[k] }
                CtCv[j] = s
            }
            let mut u_norm: f32 = 0.0
            for j in 0 to p { u_norm = u_norm + CtCv[j] * CtCv[j] }
            u_norm = sqrt((u_norm as f64)) as f32
            if u_norm < 0.0000000001 { u_norm = 0.0000000001 }
            for j in 0 to p { u[j] = CtCv[j] / u_norm }

            array_free_f32(Cv)
            array_free_f32(CtCv)
        }

        let v: ptr<f32> = array_new_f32(q)
        for k in 0 to q {
            let mut s: f32 = 0.0
            for j in 0 to p { s = s + C[j][k] * u[j] }
            v[k] = s
        }
        let mut v_norm: f32 = 0.0
        for k in 0 to q { v_norm = v_norm + v[k] * v[k] }
        v_norm = sqrt((v_norm as f64)) as f32
        if v_norm < 0.0000000001 { v_norm = 0.0000000001 }
        for k in 0 to q { v[k] = v[k] / v_norm }

        x_weights[c] = u
        y_weights[c] = v

        for j in 0 to p {
            for k in 0 to q {
                C[j][k] = C[j][k] - u[j] * v[k]
            }
        }
    }

    for j in 0 to p { array_free_f32(C[j]) }
    free(C as ptr<void>)
    matrix_free(Xc)
    matrix_free(Yc)
    array_free_f32(x_mean)
    array_free_f32(y_mean)

    return PLSSVD {
        x_weights: x_weights,
        y_weights: y_weights,
        n_components: n_components,
        n_x_features: p,
        n_y_features: q,
        fitted: true
    }
}

export function pls_svd_transform(model: PLSSVD, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_x_features {
                s = s + matrix_at(X, i, j) * model.x_weights[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function pls_svd_free(model: PLSSVD) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.x_weights[c])
        array_free_f32(model.y_weights[c])
    }
    free(model.x_weights as ptr<void>)
    free(model.y_weights as ptr<void>)
}
