# Matrix type and operations for flow-scikit.
# Uses flat row-major storage with ptr<f32> for dynamic allocation.

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function memset(p: ptr<void>, val: i32, n: i64) -> ptr<void>
    function sqrt(x: f64) -> f64
    function exp(x: f64) -> f64
    function log(x: f64) -> f64
    function fabs(x: f64) -> f64
    function pow(x: f64, y: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

export struct Matrix {
    data: ptr<f32>,
    rows: i32,
    cols: i32
}

export struct Dataset {
    X: Matrix,
    y: ptr<f32>,
    n_samples: i32,
    n_features: i32,
    n_classes: i32,
    is_classification: bool
}

export function matrix_new(rows: i32, cols: i32) -> Matrix {
    let n: i64 = (rows as i64) * (cols as i64) * 4
    let p: ptr<void> = calloc(n, 1)
    return Matrix { data: p as ptr<f32>, rows: rows, cols: cols }
}

export function matrix_free(m: Matrix) -> void {
    free(m.data as ptr<void>)
}

export function matrix_at(m: Matrix, row: i32, col: i32) -> f32 {
    let idx: i32 = row * m.cols + col
    return m.data[idx]
}

export function matrix_set(m: Matrix, row: i32, col: i32, val: f32) -> void {
    let idx: i32 = row * m.cols + col
    m.data[idx] = val
}

export function matrix_row(m: Matrix, row: i32, out: ptr<f32>) -> void {
    let start: i32 = row * m.cols
    for j in 0 to m.cols {
        out[j] = m.data[start + j]
    }
}

export function matrix_copy(m: Matrix) -> Matrix {
    let result: Matrix = matrix_new(m.rows, m.cols)
    let n: i64 = (m.rows as i64) * (m.cols as i64) * 4
    memcpy(result.data as ptr<void>, m.data as ptr<void>, n)
    return result
}

export function matrix_transpose(m: Matrix) -> Matrix {
    let result: Matrix = matrix_new(m.cols, m.rows)
    for i in 0 to m.rows {
        for j in 0 to m.cols {
            matrix_set(result, j, i, matrix_at(m, i, j))
        }
    }
    return result
}

export function matrix_multiply(a: Matrix, b: Matrix) -> Matrix {
    let result: Matrix = matrix_new(a.rows, b.cols)
    for i in 0 to a.rows {
        for j in 0 to b.cols {
            let mut sum: f32 = 0.0
            for k in 0 to a.cols {
                sum = sum + matrix_at(a, i, k) * matrix_at(b, k, j)
            }
            matrix_set(result, i, j, sum)
        }
    }
    return result
}

export function matrix_multiply_vec(a: Matrix, v: ptr<f32>, out: ptr<f32>) -> void {
    for i in 0 to a.rows {
        let mut sum: f32 = 0.0
        for j in 0 to a.cols {
            sum = sum + matrix_at(a, i, j) * v[j]
        }
        out[i] = sum
    }
}

export function matrix_add_bias_col(m: Matrix) -> Matrix {
    let result: Matrix = matrix_new(m.rows, m.cols + 1)
    for i in 0 to m.rows {
        matrix_set(result, i, 0, 1.0)
        for j in 0 to m.cols {
            matrix_set(result, i, j + 1, matrix_at(m, i, j))
        }
    }
    return result
}

export function matrix_fill(m: Matrix, val: f32) -> void {
    let n: i32 = m.rows * m.cols
    for i in 0 to n {
        m.data[i] = val
    }
}

export function matrix_print(m: Matrix) -> void {
    for i in 0 to m.rows {
        print("  [")
        for j in 0 to m.cols {
            printf("%.4f", matrix_at(m, i, j))
            if j < m.cols - 1 {
                print(", ")
            }
        }
        println("]")
    }
}

export function array_new_f32(n: i32) -> ptr<f32> {
    let p: ptr<void> = calloc((n as i64) * 4, 1)
    return p as ptr<f32>
}

export function array_free_f32(p: ptr<f32>) -> void {
    free(p as ptr<void>)
}

# Distinct-value collection, issue #398.
#
# Roughly thirty fit functions in this library derived their class vector with
# the same hand-rolled loop:
#
#     let classes: ptr<f32> = array_new_f32(n_classes)
#     let mut n_found: i32 = 0
#     for i in 0 to n {
#         let mut found: bool = false
#         for c in 0 to n_found {
#             if classes[c] == y[i] { found = true }
#         }
#         if not found {
#             classes[n_found] = y[i]
#             n_found = n_found + 1
#         }
#     }
#
# n_classes is caller supplied and nothing tied it to the number of distinct
# labels in y, so labels carrying more distinct values than the caller declared
# wrote past the end of the allocation. n_found still counted every distinct
# value, and the membership scan read those out-of-bounds slots back, so the
# loop behaved as though the buffer had always been large enough.
#
# distinct_f32 keeps exactly that behaviour and makes it legal: the buffer is
# sized to hold every distinct value, never fewer than the caller's declared
# capacity. No class is dropped, count is the same number the old loop
# produced, and first-appearance order is preserved, which is what fixes the
# column order of every predict_proba in the library.
#
# Membership used to be a linear rescan with no early exit, so the pass was
# O(n * n_found). Labels are almost always small integers; when they are,
# membership is a direct-index table lookup and the pass is O(n). Fractional
# values, huge magnitudes and NaN fall back to the original scan, now with an
# early exit.
export struct DistinctF32 {
    values: ptr<f32>,
    count: i32,
    capacity: i32
}

export struct DistinctI32 {
    values: ptr<i32>,
    count: i32,
    capacity: i32
}

export function distinct_f32(src: ptr<f32>, n: i32, min_capacity: i32) -> DistinctF32 {
    let mut cap: i32 = min_capacity
    if cap < 0 { cap = 0 }

    if n < 1 {
        let empty: ptr<f32> = array_new_f32(cap)
        let empty_result: DistinctF32 = DistinctF32 { values: empty, count: 0, capacity: cap }
        return empty_result
    }

    let mut lo: f32 = src[0]
    let mut hi: f32 = src[0]
    let mut use_table: bool = true
    for i in 0 to n {
        let v: f32 = src[i]
        if v < -1000000.0 || v > 1000000.0 {
            use_table = false
            break
        }
        let t: f32 = (v as i32) as f32
        if t != v {
            use_table = false
            break
        }
        if v < lo { lo = v }
        if v > hi { hi = v }
    }

    let lo_i: i32 = lo as i32
    let mut span: i32 = 1
    if use_table {
        span = (hi as i32) - lo_i + 1
        if span < 1 || span > 4000000 { use_table = false }
    }

    if use_table {
        let mut values: ptr<f32> = array_new_f32(cap)
        let seen: ptr<f32> = array_new_f32(span)
        let mut count: i32 = 0
        for i in 0 to n {
            let v: f32 = src[i]
            let idx: i32 = (v as i32) - lo_i
            if seen[idx] == 0.0 {
                seen[idx] = 1.0
                if count < cap { values[count] = v }
                count = count + 1
            }
        }
        if count > cap {
            # y carried more distinct labels than the caller declared. Grow to
            # fit and refill rather than drop a class.
            array_free_f32(values)
            cap = count
            values = array_new_f32(cap)
            for i in 0 to span { seen[i] = 0.0 }
            let mut w: i32 = 0
            for i in 0 to n {
                let v: f32 = src[i]
                let idx: i32 = (v as i32) - lo_i
                if seen[idx] == 0.0 {
                    seen[idx] = 1.0
                    values[w] = v
                    w = w + 1
                }
            }
        }
        array_free_f32(seen)
        let table_result: DistinctF32 = DistinctF32 { values: values, count: count, capacity: cap }
        return table_result
    }

    # Fractional values, huge magnitudes and NaN keep the original linear scan,
    # now with an early exit. The sample count is an upper bound on the number
    # of distinct values, so collect into scratch and size the result after.
    let scratch: ptr<f32> = array_new_f32(n)
    let mut count: i32 = 0
    for i in 0 to n {
        let v: f32 = src[i]
        let mut found: bool = false
        for c in 0 to count {
            if scratch[c] == v {
                found = true
                break
            }
        }
        if not found {
            scratch[count] = v
            count = count + 1
        }
    }

    if cap < count { cap = count }
    let values: ptr<f32> = array_new_f32(cap)
    for c in 0 to count { values[c] = scratch[c] }
    array_free_f32(scratch)

    let result: DistinctF32 = DistinctF32 { values: values, count: count, capacity: cap }
    return result
}

# Same contract as distinct_f32 for i32 sources.
export function distinct_i32(src: ptr<i32>, n: i32, min_capacity: i32) -> DistinctI32 {
    let mut cap: i32 = min_capacity
    if cap < 0 { cap = 0 }

    if n < 1 {
        let empty: ptr<i32> = malloc((cap as i64) * 4) as ptr<i32>
        let empty_result: DistinctI32 = DistinctI32 { values: empty, count: 0, capacity: cap }
        return empty_result
    }

    let scratch: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut count: i32 = 0
    for i in 0 to n {
        let v: i32 = src[i]
        let mut found: bool = false
        for c in 0 to count {
            if scratch[c] == v {
                found = true
                break
            }
        }
        if not found {
            scratch[count] = v
            count = count + 1
        }
    }

    if cap < count { cap = count }
    let values: ptr<i32> = malloc((cap as i64) * 4) as ptr<i32>
    for c in 0 to cap { values[c] = 0 }
    for c in 0 to count { values[c] = scratch[c] }
    free(scratch as ptr<void>)

    let result: DistinctI32 = DistinctI32 { values: values, count: count, capacity: cap }
    return result
}

# f64 array support for higher-precision internal computations
export function array_new_f64(n: i32) -> ptr<f64> {
    let p: ptr<void> = calloc((n as i64) * 8, 1)
    return p as ptr<f64>
}

export function array_free_f64(p: ptr<f64>) -> void {
    free(p as ptr<void>)
}

export function array_copy_f64(src: ptr<f64>, n: i32) -> ptr<f64> {
    let dst: ptr<f64> = array_new_f64(n)
    memcpy(dst as ptr<void>, src as ptr<void>, (n as i64) * 8)
    return dst
}

export function array_copy_f32(src: ptr<f32>, n: i32) -> ptr<f32> {
    let dst: ptr<f32> = array_new_f32(n)
    memcpy(dst as ptr<void>, src as ptr<void>, (n as i64) * 4)
    return dst
}

export function array_mean(a: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        sum = sum + a[i]
    }
    return sum / (n as f32)
}

export function array_std(a: ptr<f32>, n: i32, mean: f32) -> f32 {
    let mut sum_sq: f32 = 0.0
    for i in 0 to n {
        let d: f32 = a[i] - mean
        sum_sq = sum_sq + d * d
    }
    # Population standard deviation (ddof=0), matching NumPy/sklearn defaults.
    let denom: f32 = n as f32
    if denom < 1.0 { denom = 1.0 }
    return sqrt((sum_sq / denom) as f64) as f32
}

export function array_min_val(a: ptr<f32>, n: i32) -> f32 {
    let mut m: f32 = a[0]
    for i in 1 to n {
        if a[i] < m {
            m = a[i]
        }
    }
    return m
}

export function array_max_val(a: ptr<f32>, n: i32) -> f32 {
    let mut m: f32 = a[0]
    for i in 1 to n {
        if a[i] > m {
            m = a[i]
        }
    }
    return m
}

export function array_argmax(a: ptr<f32>, n: i32) -> i32 {
    let mut best_idx: i32 = 0
    let mut best_val: f32 = a[0]
    for i in 1 to n {
        if a[i] > best_val {
            best_val = a[i]
            best_idx = i
        }
    }
    return best_idx
}

export function array_dot(a: ptr<f32>, b: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        sum = sum + a[i] * b[i]
    }
    return sum
}

export function array_scale(a: ptr<f32>, n: i32, factor: f32) -> void {
    for i in 0 to n {
        a[i] = a[i] * factor
    }
}

export function array_axpy(a: ptr<f32>, b: ptr<f32>, n: i32, alpha: f32) -> void {
    for i in 0 to n {
        b[i] = b[i] + alpha * a[i]
    }
}

export function sigmoid(x: f32) -> f32 {
    return 1.0 / (1.0 + exp((0.0 - x) as f64) as f32)
}

export function dot_product(a: ptr<f32>, b: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        sum = sum + a[i] * b[i]
    }
    return sum
}
