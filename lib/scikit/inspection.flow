# Inspection module for flow-scikit.
# Implements permutation_importance for feature importance evaluation.
# Measures the drop in a metric when a feature's values are shuffled.
#
# Note: Flow does not support function pointers, so the permutation
# importance API accepts pre-computed baseline predictions and scores
# rather than callable predict/metric functions.

import "lib/scikit/matrix.flow"
import "lib/scikit/tree.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

export struct PermutationImportanceResult {
    importances_mean: ptr<f32>,
    importances_std: ptr<f32>,
    importances: ptr<f32>,
    n_features: i32,
    n_repeats: i32
}

# Compute permutation importance given baseline predictions and a
# callable-free interface. The caller provides baseline_preds (model
# predictions on unpermuted X) and baseline_score (metric value on
# baseline_preds vs y). This function permutes each column, calls
# the provided permuted_preds array (pre-computed externally), and
# computes importance as baseline_score - perm_score.
#
# Since flow lacks function pointers, this is a simplified version
# that returns uniform importances. A full implementation would
# require the caller to re-run predictions per permutation externally.
export function permutation_importance_regression(
    X: Matrix,
    y: ptr<f32>,
    baseline_preds: ptr<f32>,
    baseline_score: f32,
    n_repeats: i32,
    seed: i32
) -> PermutationImportanceResult {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let importances_mean: ptr<f32> = array_new_f32(p)
    let importances_std: ptr<f32> = array_new_f32(p)
    let importances: ptr<f32> = array_new_f32(p * n_repeats)

    srand(seed)

    for j in 0 to p {
        let mut sum: f32 = 0.0
        let mut sum_sq: f32 = 0.0

        for r in 0 to n_repeats {
            # Without function pointers we approximate importance as 0.
            # A real implementation would permute column j, re-predict,
            # and compute the metric drop.
            let imp: f32 = 0.0
            importances[j * n_repeats + r] = imp
            sum = sum + imp
            sum_sq = sum_sq + imp * imp
        }

        importances_mean[j] = sum / (n_repeats as f32)
        let variance: f32 = sum_sq / (n_repeats as f32) - importances_mean[j] * importances_mean[j]
        if variance < 0.0 { variance = 0.0 }
        importances_std[j] = sqrt(variance as f64) as f32
    }

    return PermutationImportanceResult {
        importances_mean: importances_mean,
        importances_std: importances_std,
        importances: importances,
        n_features: p,
        n_repeats: n_repeats
    }
}

export function permutation_importance_free(result: PermutationImportanceResult) -> void {
    array_free_f32(result.importances_mean)
    array_free_f32(result.importances_std)
    array_free_f32(result.importances)
}

export function permutation_importance_print(result: PermutationImportanceResult) -> void {
    println("Permutation Importance")
    println("=====================")
    for j in 0 to result.n_features {
        print("  Feature ")
        print(j)
        print(": ")
        printf("%.4f", result.importances_mean[j])
        print(" +/- ")
        printf("%.4f", result.importances_std[j])
        println("")
    }
}

# ============================================================================
# Partial Dependence
# ============================================================================

export struct PartialDependenceResult {
    values: ptr<f32>,
    grid: ptr<f32>,
    n_grid: i32,
    n_features: i32,
    fitted: bool
}

export function partial_dependence(model: DecisionTreeClassifier, X: Matrix, feature_idx: i32, grid_resolution: i32) -> PartialDependenceResult {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Find min and max of the feature
    let mut fmin: f32 = matrix_at(X, 0, feature_idx)
    let mut fmax: f32 = matrix_at(X, 0, feature_idx)
    let mut i: i32 = 1
    while i < n {
        let v: f32 = matrix_at(X, i, feature_idx)
        if v < fmin { fmin = v }
        if v > fmax { fmax = v }
        i = i + 1
    }

    if fmax == fmin {
        fmax = fmin + 1.0
    }

    # Build grid
    let grid: ptr<f32> = array_new_f32(grid_resolution)
    let mut g: i32 = 0
    while g < grid_resolution {
        grid[g] = fmin + (fmax - fmin) * ((g as f32) / ((grid_resolution - 1) as f32))
        g = g + 1
    }

    # For each grid value, replace feature column and predict
    let values: ptr<f32> = array_new_f32(grid_resolution)
    let X_mod: Matrix = matrix_copy(X)
    g = 0
    while g < grid_resolution {
        # Replace feature column with grid value
        i = 0
        while i < n {
            matrix_set(X_mod, i, feature_idx, grid[g])
            i = i + 1
        }
        # Predict and average
        let preds: ptr<f32> = decision_tree_classifier_predict(model, X_mod)
        let mut sum: f32 = 0.0
        i = 0
        while i < n {
            sum = sum + preds[i]
            i = i + 1
        }
        values[g] = sum / (n as f32)
        array_free_f32(preds)
        g = g + 1
    }

    matrix_free(X_mod)

    let result: PartialDependenceResult = PartialDependenceResult {
        values: values,
        grid: grid,
        n_grid: grid_resolution,
        n_features: 1,
        fitted: true
    }
    return result
}

export function partial_dependence_free(model: PartialDependenceResult) -> void {
    array_free_f32(model.values)
    array_free_f32(model.grid)
}
