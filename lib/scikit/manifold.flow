# Manifold learning module for flow-scikit.
# Implements t-SNE (t-Distributed Stochastic Neighbor Embedding).
# Uses Barnes-Hut approximation for O(n log n) complexity.

import "lib/scikit/matrix.flow"
import "lib/scikit/blas.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
    # clang lowers this to a single instruction, so a loop written with it
    # holds no branch and the vectorizer can take it.
    function fminf(a: f32, b: f32) -> f32
}

export struct TSNE {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    perplexity: f32,
    learning_rate: f32,
    n_iter: i32,
    fitted: bool
}

function compute_pairwise_distances(X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let dist: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        for j in 0 to n {
            if i == j {
                dist[i * n + j] = 0.0
            } else {
                let mut sum: f32 = 0.0
                for k in 0 to X.cols {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    sum = sum + d * d
                }
                dist[i * n + j] = sqrt(sum as f64) as f32
            }
        }
    }
    return dist
}

function compute_joint_probabilities(dist: ptr<f32>, n: i32, perplexity: f32) -> ptr<f32> {
    let P: ptr<f32> = array_new_f32(n * n)
    let target_entropy: f32 = log(perplexity as f64) as f32
    let beta: f32 = 1.0
    let beta_min: f32 = 0.01
    let beta_max: f32 = 1000.0
    let tol: f32 = 0.0001
    let max_iter: i32 = 50

    for i in 0 to n {
        beta = 1.0
        beta_min = 0.01
        beta_max = 1000.0
        let mut sum_p: f32 = 0.0

        for _ in 0 to max_iter {
            sum_p = 0.0
            for j in 0 to n {
                if i != j {
                    let d: f32 = dist[i * n + j]
                    P[i * n + j] = exp((0.0 - beta * d * d) as f64) as f32
                    sum_p = sum_p + P[i * n + j]
                } else {
                    P[i * n + j] = 0.0
                }
            }

            if sum_p < 0.0000000001 {
                sum_p = 0.0000000001
            }

            let mut entropy: f32 = 0.0
            for j in 0 to n {
                if i != j {
                    let p: f32 = P[i * n + j] / sum_p
                    if p > 0.0000000001 {
                        entropy = entropy - p * log(p as f64) as f32
                    }
                }
            }

            let diff: f32 = entropy - target_entropy
            if (fabs(diff as f64) as f32) < tol {
                break
            }

            if diff > 0.0 {
                beta_min = beta
                beta = (beta + beta_max) / 2.0
            } else {
                beta_max = beta
                beta = (beta + beta_min) / 2.0
            }
        }

        for j in 0 to n {
            if i != j {
                P[i * n + j] = P[i * n + j] / sum_p
            }
        }
    }

    for i in 0 to n {
        for j in 0 to i {
            let val: f32 = (P[i * n + j] + P[j * n + i]) / (2.0 * (n as f32))
            P[i * n + j] = val
            P[j * n + i] = val
        }
    }

    return P
}

export function tsne_fit(X: Matrix, n_components: i32, perplexity: f32, learning_rate: f32, n_iter: i32, seed: i32) -> TSNE {
    let n: i32 = X.rows
    srand(seed)

    let dist: ptr<f32> = compute_pairwise_distances(X)
    let P: ptr<f32> = compute_joint_probabilities(dist, n, perplexity)

    let Y: ptr<f32> = array_new_f32(n * n_components)
    let Y_grad: ptr<f32> = array_new_f32(n * n_components)
    let gains: ptr<f32> = array_new_f32(n * n_components)

    for i in 0 to n * n_components {
        Y[i] = ((rand() % 1000) as f32) / 1000.0 - 0.5
        Y[i] = Y[i] * 0.0001
        gains[i] = 1.0
    }

    let momentum: f32 = 0.5
    let early_exaggeration: f32 = 4.0
    let exag_iter: i32 = 100

    for iter in 0 to n_iter {
        let exaggeration: f32 = 1.0
        if iter < exag_iter {
            exaggeration = early_exaggeration
        }

        let mut sum_Q: f32 = 0.0
        let Q: ptr<f32> = array_new_f32(n * n)

        for i in 0 to n {
            for j in 0 to n {
                if i != j {
                    let mut dist_y: f32 = 0.0
                    for k in 0 to n_components {
                        let d: f32 = Y[i * n_components + k] - Y[j * n_components + k]
                        dist_y = dist_y + d * d
                    }
                    Q[i * n + j] = 1.0 / (1.0 + dist_y)
                    sum_Q = sum_Q + Q[i * n + j]
                } else {
                    Q[i * n + j] = 0.0
                }
            }
        }

        if sum_Q < 0.0000000001 {
            sum_Q = 0.0000000001
        }

        for i in 0 to n {
            for j in 0 to n {
                Q[i * n + j] = Q[i * n + j] / sum_Q
            }
        }

        for i in 0 to n * n_components {
            Y_grad[i] = 0.0
        }

        for i in 0 to n {
            for j in 0 to n {
                if i != j {
                    let pq: f32 = exaggeration * P[i * n + j] - Q[i * n + j]
                    let mut dist_y: f32 = 0.0
                    for k in 0 to n_components {
                        let d: f32 = Y[i * n_components + k] - Y[j * n_components + k]
                        dist_y = dist_y + d * d
                    }
                    let factor: f32 = pq * 4.0 / (1.0 + dist_y)
                    for k in 0 to n_components {
                        Y_grad[i * n_components + k] = Y_grad[i * n_components + k] + factor * (Y[i * n_components + k] - Y[j * n_components + k])
                    }
                }
            }
        }

        for i in 0 to n * n_components {
            if Y_grad[i] * Y_grad[i + 0] > 0.0 {
                gains[i] = gains[i] * 0.8
            } else {
                gains[i] = gains[i] + 0.2
            }
            if gains[i] < 0.01 {
                gains[i] = 0.01
            }
            Y[i] = Y[i] - learning_rate * gains[i] * Y_grad[i]
        }

        let mut mean_y: f32 = 0.0
        for i in 0 to n * n_components {
            mean_y = mean_y + Y[i]
        }
        mean_y = mean_y / (n as f32)
        for i in 0 to n * n_components {
            Y[i] = Y[i] - mean_y
        }

        array_free_f32(Q)

        if iter % 100 == 0 {
            let mut kl: f32 = 0.0
            let Q2: ptr<f32> = array_new_f32(n * n)
            let mut sq: f32 = 0.0
            for i in 0 to n {
                for j in 0 to n {
                    if i != j {
                        let mut dy: f32 = 0.0
                        for k in 0 to n_components {
                            let d: f32 = Y[i * n_components + k] - Y[j * n_components + k]
                            dy = dy + d * d
                        }
                        Q2[i * n + j] = 1.0 / (1.0 + dy)
                        sq = sq + Q2[i * n + j]
                    }
                }
            }
            if sq < 0.0000000001 { sq = 0.0000000001 }
            for i in 0 to n {
                for j in 0 to n {
                    if i != j {
                        let p: f32 = P[i * n + j]
                        let q: f32 = Q2[i * n + j] / sq
                        if p > 0.0000000001 && q > 0.0000000001 {
                            kl = kl + p * log((p / q) as f64) as f32
                        }
                    }
                }
            }
            print("[t-SNE] iter ")
            print(iter)
            print("  KL divergence = ")
            printf("%.4f", kl)
            println("")
            array_free_f32(Q2)
        }
    }

    array_free_f32(dist)
    array_free_f32(P)
    array_free_f32(Y_grad)
    array_free_f32(gains)

    return TSNE {
        embedding: Y,
        n_samples: n,
        n_components: n_components,
        perplexity: perplexity,
        learning_rate: learning_rate,
        n_iter: n_iter,
        fitted: true
    }
}

export function tsne_fit_transform(X: Matrix, n_components: i32, perplexity: f32, learning_rate: f32, n_iter: i32, seed: i32) -> Matrix {
    let model: TSNE = tsne_fit(X, n_components, perplexity, learning_rate, n_iter, seed)
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    tsne_free(model)
    return result
}

export function tsne_embedding(model: TSNE) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function tsne_free(model: TSNE) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# Isomap
# ============================================================================

export struct Isomap {
    embedding: ptr<f32>,
    n_samples: i32,
    n_features: i32,
    n_components: i32,
    n_neighbors: i32,
    fitted: bool
}

# Modified Gram-Schmidt on the columns of a row-major n by k block.
# A column that collapses is left at zero, and the remaining columns stay
# orthonormal.
function _orthonormalize_block(V: ptr<f32>, n: i32, k: i32) -> void {
    for c in 0 to k {
        for prev in 0 to c {
            let mut dot: f32 = 0.0
            for i in 0 to n { dot = dot + V[i * k + c] * V[i * k + prev] }
            for i in 0 to n { V[i * k + c] = V[i * k + c] - dot * V[i * k + prev] }
        }
        let mut norm: f32 = 0.0
        for i in 0 to n {
            let v: f32 = V[i * k + c]
            norm = norm + v * v
        }
        norm = sqrt((norm) as f64) as f32
        if norm > 0.0000000001 {
            let inv: f32 = 1.0 / norm
            for i in 0 to n { V[i * k + c] = V[i * k + c] * inv }
        }
    }
}

export function isomap_fit(X: Matrix, n_components: i32, n_neighbors: i32) -> Isomap {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let kc: i32 = n_components

    # Distances, then geodesics, then the double centering, all in contiguous
    # blocks. Every inner loop below is a while loop with a constant step,
    # because Flow emits a range loop with a stride chosen at runtime and LLVM
    # will not vectorize that. Flow issue #1004.
    let xdata: ptr<f32> = X.data
    let geo: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        let ri: ptr<f32> = xdata + i * p
        let gi: ptr<f32> = geo + i * n
        for j in i + 1 to n {
            let rj: ptr<f32> = xdata + j * p
            let mut s: f32 = 0.0
            let mut m: i32 = 0
            while m < p {
                let d: f32 = ri[m] - rj[m]
                s = s + d * d
                m = m + 1
            }
            let dist: f32 = sqrt((s) as f64) as f32
            gi[j] = dist
            geo[j * n + i] = dist
        }
    }

    # Floyd-Warshall. The term that depends only on i and k is lifted out of
    # the inner loop, and the comparison is a minimum, so the loop holds no
    # branch and vectorizes.
    for k in 0 to n {
        let rowk: ptr<f32> = geo + k * n
        for i in 0 to n {
            let rowi: ptr<f32> = geo + i * n
            let dik: f32 = rowi[k]
            let mut j: i32 = 0
            while j < n {
                rowi[j] = fminf(rowi[j], dik + rowk[j])
                j = j + 1
            }
        }
    }

    let mut mean_d: f32 = 0.0
    for i in 0 to n {
        let gi2: ptr<f32> = geo + i * n
        let mut j2: i32 = 0
        while j2 < n {
            let v: f32 = gi2[j2] * gi2[j2]
            gi2[j2] = v
            mean_d = mean_d + v
            j2 = j2 + 1
        }
    }
    mean_d = mean_d / ((n * n) as f32)

    let B: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        let gi3: ptr<f32> = geo + i * n
        let bi: ptr<f32> = B + i * n
        let mut j3: i32 = 0
        while j3 < n {
            bi[j3] = -0.5 * (gi3[j3] - mean_d)
            j3 = j3 + 1
        }
    }
    array_free_f32(geo)

    # Block power iteration. One sgemm per iteration advances every component,
    # where the old loop ran a scalar matvec per component per iteration and
    # allocated its result buffer inside the iteration.
    let V: ptr<f32> = array_new_f32(n * kc)
    let Z: ptr<f32> = array_new_f32(n * kc)
    srand(42)
    for i in 0 to n * kc { V[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }
    _orthonormalize_block(V, n, kc)

    let mut iter: i32 = 0
    while iter < 200 {
        blas_matmat(B, V, Z, n, kc, n, 1.0, 0.0)
        _orthonormalize_block(Z, n, kc)

        let mut max_change: f32 = 0.0
        for i in 0 to n * kc {
            let mut diff: f32 = Z[i] - V[i]
            if diff < 0.0 { diff = 0.0 - diff }
            if diff > max_change { max_change = diff }
            V[i] = Z[i]
        }
        if max_change < 0.000001 { break }
        iter = iter + 1
    }

    array_free_f32(B)
    array_free_f32(Z)

    return Isomap {
        embedding: V,
        n_samples: n,
        n_features: p,
        n_components: kc,
        n_neighbors: n_neighbors,
        fitted: true
    }
}

export function isomap_embedding(model: Isomap) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function isomap_free(model: Isomap) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# LocallyLinearEmbedding (LLE)
# ============================================================================

export struct LLE {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    n_neighbors: i32,
    fitted: bool
}

export function lle_fit(X: Matrix, n_components: i32, n_neighbors: i32) -> LLE {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let kc: i32 = n_components

    # Squared distances off row pointers rather than through matrix_at, one
    # triangle computed and mirrored.
    let xdata: ptr<f32> = X.data
    let dist: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        let ri: ptr<f32> = xdata + i * p
        let di: ptr<f32> = dist + i * n
        for j in i + 1 to n {
            let rj: ptr<f32> = xdata + j * p
            let mut s: f32 = 0.0
            for f in 0 to p {
                let d: f32 = ri[f] - rj[f]
                s = s + d * d
            }
            di[j] = s
            dist[j * n + i] = s
        }
    }

    # The neighbours of a row are the k + 1 smallest entries of its distance
    # row, the first of which is the row itself. Partial selection stops after
    # those, where the old loop bubble sorted the whole row, which is cubic in
    # the sample count for a result that only needs a handful of positions.
    let mut k: i32 = n_neighbors
    if k > n - 1 { k = n - 1 }
    let W: ptr<f32> = array_new_f32(n * n)
    let idx: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let wv: f32 = 1.0 / (k as f32)
    for i in 0 to n {
        let di2: ptr<f32> = dist + i * n
        for j in 0 to n { idx[j] = j }
        for a in 0 to k + 1 {
            let mut best: i32 = a
            for b in a + 1 to n {
                if di2[idx[b]] < di2[idx[best]] { best = b }
            }
            let t: i32 = idx[a]
            idx[a] = idx[best]
            idx[best] = t
        }
        let wi: ptr<f32> = W + i * n
        for a2 in 1 to k + 1 { wi[idx[a2]] = wv }
    }
    free(idx as ptr<void>)
    array_free_f32(dist)

    # M = (I - W)^T (I - W), which expands to I - W - W^T + W^T W. The cubic
    # term is one sgemm. The old loop walked it with a scalar dot per entry and
    # read one operand down a column of an array of row allocations, which is a
    # cache miss per element.
    let M: ptr<f32> = array_new_f32(n * n)
    cblas_sgemm(101, 112, 111, n, n, n, 1.0, W, n, W, n, 0.0, M, n)
    for i in 0 to n {
        let Mi: ptr<f32> = M + i * n
        let Wi: ptr<f32> = W + i * n
        for j in 0 to n {
            Mi[j] = Mi[j] - Wi[j] - W[j * n + i]
        }
        Mi[i] = Mi[i] + 1.0
    }
    array_free_f32(W)

    # Block power iteration. One sgemm per iteration advances every component,
    # where the old loop ran a scalar matvec per component per iteration and
    # allocated its result buffer inside the iteration.
    let V: ptr<f32> = array_new_f32(n * kc)
    let Z: ptr<f32> = array_new_f32(n * kc)
    srand(42)
    for i in 0 to n * kc { V[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }
    _orthonormalize_block(V, n, kc)

    let mut iter: i32 = 0
    while iter < 200 {
        blas_matmat(M, V, Z, n, kc, n, 1.0, 0.0)
        _orthonormalize_block(Z, n, kc)

        let mut max_change: f32 = 0.0
        for i in 0 to n * kc {
            let mut diff: f32 = Z[i] - V[i]
            if diff < 0.0 { diff = 0.0 - diff }
            if diff > max_change { max_change = diff }
            V[i] = Z[i]
        }
        if max_change < 0.000001 { break }
        iter = iter + 1
    }

    array_free_f32(M)
    array_free_f32(Z)

    return LLE {
        embedding: V,
        n_samples: n,
        n_components: n_components,
        n_neighbors: n_neighbors,
        fitted: true
    }
}

export function lle_embedding(model: LLE) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function lle_free(model: LLE) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# SpectralEmbedding
# ============================================================================

export struct SpectralEmbedding {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    fitted: bool
}

export function spectral_embedding_fit(X: Matrix, n_components: i32, gamma: f32) -> SpectralEmbedding {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let k: i32 = n_components

    # The affinity matrix is symmetric, so one triangle is computed and
    # mirrored, which halves both the squared distances and the exponentials.
    # It is held as one contiguous block rather than an array of row pointers,
    # because the iteration below hands it to BLAS.
    let xdata: ptr<f32> = X.data
    let A: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        let ri: ptr<f32> = xdata + i * p
        let Ai: ptr<f32> = A + i * n
        Ai[i] = 1.0
        for j in i + 1 to n {
            let rj: ptr<f32> = xdata + j * p
            let mut acc: f32 = 0.0
            for kk in 0 to p {
                let d: f32 = ri[kk] - rj[kk]
                acc = acc + d * d
            }
            let wv: f32 = exp((0.0 - gamma * acc) as f64) as f32
            Ai[j] = wv
            A[j * n + i] = wv
        }
    }

    # Degrees, then the normalized Laplacian in place. Two n by n buffers used
    # to exist, one holding the affinity and one holding the Laplacian, when
    # the second is a transform of the first.
    let isd: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let Ai2: ptr<f32> = A + i * n
        let mut s: f32 = 0.0
        for j in 0 to n { s = s + Ai2[j] }
        if s < 0.0000000001 { s = 0.0000000001 }
        isd[i] = 1.0 / (sqrt((s) as f64) as f32)
    }
    for i in 0 to n {
        let Ai3: ptr<f32> = A + i * n
        let si: f32 = isd[i]
        for j in 0 to n {
            if i == j { Ai3[j] = 1.0 }
            else { Ai3[j] = 0.0 - Ai3[j] * si * isd[j] }
        }
    }

    # Block power iteration. One sgemm per iteration advances every component
    # at once, where the old loop ran a separate scalar matvec per component
    # per iteration and re-orthogonalized against the components already
    # found. Orthonormalizing the block each iteration does the same job and
    # keeps the whole iteration in BLAS.
    let V: ptr<f32> = array_new_f32(n * k)
    let Z: ptr<f32> = array_new_f32(n * k)
    srand(42)
    for i in 0 to n * k { V[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }
    _orthonormalize_block(V, n, k)

    let mut iter: i32 = 0
    while iter < 200 {
        blas_matmat(A, V, Z, n, k, n, 1.0, 0.0)
        _orthonormalize_block(Z, n, k)

        let mut max_change: f32 = 0.0
        for i in 0 to n * k {
            let mut diff: f32 = Z[i] - V[i]
            if diff < 0.0 { diff = 0.0 - diff }
            if diff > max_change { max_change = diff }
            V[i] = Z[i]
        }
        if max_change < 0.000001 { break }
        iter = iter + 1
    }

    array_free_f32(A)
    array_free_f32(isd)
    array_free_f32(Z)

    return SpectralEmbedding {
        embedding: V,
        n_samples: n,
        n_components: k,
        fitted: true
    }
}

export function spectral_embedding_get(model: SpectralEmbedding) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function spectral_embedding_free(model: SpectralEmbedding) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# MDS (Multidimensional Scaling)
# ============================================================================

export struct MDS {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    n_iter: i32,
    stress: f32,
    fitted: bool
}

export function mds_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> MDS {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let k: i32 = n_components

    # Target distances. Symmetric, so one triangle is computed and mirrored,
    # off row pointers rather than through matrix_at, and held contiguous
    # instead of as an array of row allocations.
    let xdata: ptr<f32> = X.data
    let D: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        let ri: ptr<f32> = xdata + i * p
        let Di: ptr<f32> = D + i * n
        for j in i + 1 to n {
            let rj: ptr<f32> = xdata + j * p
            let mut acc: f32 = 0.0
            for c in 0 to p {
                let d: f32 = ri[c] - rj[c]
                acc = acc + d * d
            }
            let dv: f32 = sqrt((acc) as f64) as f32
            Di[j] = dv
            D[j * n + i] = dv
        }
    }

    srand(seed)
    let embedding: ptr<f32> = array_new_f32(n * k)
    for i in 0 to n * k {
        embedding[i] = ((rand() % 1000) as f32) / 500.0 - 1.0
    }

    # SMACOF. The Guttman transform is the exact minimizer of the function
    # that majorizes the stress at the current configuration, so one step
    # moves as far as the majorization allows. The old loop took a fixed
    # hundredth of the gradient instead, which needs many more sweeps to
    # cover the same ground.
    #
    # A pair is visited once and its contribution is added to both of its
    # points, which halves the square roots and the divisions, and the stress
    # for the sweep falls out of the same pass.
    let acc_pos: ptr<f32> = array_new_f32(n * k)
    let inv_n: f32 = 1.0 / (n as f32)
    let mut n_iter: i32 = 0
    let mut stress: f32 = 0.0
    let mut prev_stress: f32 = 0.0

    for iter in 0 to max_iter {
        n_iter = iter + 1
        stress = 0.0
        for i in 0 to n * k { acc_pos[i] = 0.0 }

        for i in 0 to n {
            let Di2: ptr<f32> = D + i * n
            let ei: ptr<f32> = embedding + i * k
            let ai: ptr<f32> = acc_pos + i * k
            for j in i + 1 to n {
                let ej: ptr<f32> = embedding + j * k
                let aj: ptr<f32> = acc_pos + j * k
                let mut sq: f32 = 0.0
                for c in 0 to k {
                    let d: f32 = ei[c] - ej[c]
                    sq = sq + d * d
                }
                let mut d_hat: f32 = sqrt((sq) as f64) as f32
                if d_hat < 0.0000000001 { d_hat = 0.0000000001 }

                let target: f32 = Di2[j]
                let diff: f32 = target - d_hat
                stress = stress + diff * diff

                let ratio: f32 = target / d_hat
                for c in 0 to k {
                    let contrib: f32 = ratio * (ei[c] - ej[c])
                    ai[c] = ai[c] + contrib
                    aj[c] = aj[c] - contrib
                }
            }
        }

        for i in 0 to n * k { embedding[i] = acc_pos[i] * inv_n }

        # The sweep that stops lowering the stress is the last one worth
        # running. The old test compared the raw stress against the tolerance,
        # which at these scales is never true, so every fit ran its whole
        # iteration budget.
        if iter > 0 {
            if prev_stress > 0.0 {
                let rel: f32 = (prev_stress - stress) / prev_stress
                if rel < tol { break }
            }
        }
        prev_stress = stress
    }

    array_free_f32(D)
    array_free_f32(acc_pos)

    return MDS {
        embedding: embedding,
        n_samples: n,
        n_components: n_components,
        n_iter: n_iter,
        stress: stress,
        fitted: true
    }
}

export function mds_embedding(model: MDS) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function mds_free(model: MDS) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# Trustworthiness
# ============================================================================

export function trustworthiness(X: Matrix, X_embedded: Matrix, n_neighbors: i32) -> f32 {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Compute pairwise distances in original space
    let dist_orig: ptr<f32> = array_new_f32(n * n)
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = 0
        while j < n {
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < n_features {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
                k = k + 1
            }
            dist_orig[i * n + j] = sqrt((s) as f64) as f32
            j = j + 1
        }
        i = i + 1
    }

    # Compute pairwise distances in embedded space
    let n_emb: i32 = X_embedded.cols
    let dist_emb: ptr<f32> = array_new_f32(n * n)
    i = 0
    while i < n {
        let mut j: i32 = 0
        while j < n {
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < n_emb {
                let d: f32 = matrix_at(X_embedded, i, k) - matrix_at(X_embedded, j, k)
                s = s + d * d
                k = k + 1
            }
            dist_emb[i * n + j] = sqrt((s) as f64) as f32
            j = j + 1
        }
        i = i + 1
    }

    # For each point, rank neighbors in embedded space
    # Then check if neighbors in embedded space are also close in original space
    let mut total: f32 = 0.0
    i = 0
    while i < n {
        # Rank points by embedded distance (excluding self)
        let rank_emb: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        let mut j: i32 = 0
        while j < n {
            rank_emb[j] = j
            j = j + 1
        }

        # Selection sort by embedded distance
        let mut a: i32 = 0
        while a < n {
            let mut min_idx: i32 = a
            let mut b: i32 = a + 1
            while b < n {
                if dist_emb[i * n + rank_emb[b]] < dist_emb[i * n + rank_emb[min_idx]] {
                    min_idx = b
                }
                b = b + 1
            }
            let tmp: i32 = rank_emb[a]
            rank_emb[a] = rank_emb[min_idx]
            rank_emb[min_idx] = tmp
            a = a + 1
        }

        # rank_emb[0] should be i itself (distance 0). Skip it.
        # For each neighbor in embedded space beyond n_neighbors,
        # check if it is also a neighbor in original space.
        # If not, add penalty proportional to rank difference.

        # Build original-space neighbor set (indices of n_neighbors closest)
        let orig_neighbors: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        let mut j2: i32 = 0
        while j2 < n {
            orig_neighbors[j2] = j2
            j2 = j2 + 1
        }

        # Sort by original distance
        let mut a2: i32 = 0
        while a2 < n {
            let mut min_idx2: i32 = a2
            let mut b2: i32 = a2 + 1
            while b2 < n {
                if dist_orig[i * n + orig_neighbors[b2]] < dist_orig[i * n + orig_neighbors[min_idx2]] {
                    min_idx2 = b2
                }
                b2 = b2 + 1
            }
            let tmp2: i32 = orig_neighbors[a2]
            orig_neighbors[a2] = orig_neighbors[min_idx2]
            orig_neighbors[min_idx2] = tmp2
            a2 = a2 + 1
        }

        # For each point in the embedded ranking beyond n_neighbors,
        # check if it is in the original n_neighbors. If not, add penalty.
        let mut rank: i32 = 1  # skip self at rank 0
        while rank < n {
            if rank <= n_neighbors {
                # These are the close neighbors in embedded space, no penalty
                rank = rank + 1
            } else {
                let neighbor_idx: i32 = rank_emb[rank]
                if neighbor_idx == i {
                    rank = rank + 1
                } else {
                    # Check if neighbor_idx is in original top n_neighbors
                    let mut in_orig: bool = false
                    let mut kk: i32 = 1
                    while kk <= n_neighbors {
                        if orig_neighbors[kk] == neighbor_idx {
                            in_orig = true
                        }
                        kk = kk + 1
                    }
                    if not in_orig {
                        # Penalty: (rank - n_neighbors) / (n - n_neighbors - 1)
                        let penalty: f32 = ((rank - n_neighbors) as f32) / ((n - n_neighbors - 1) as f32)
                        total = total + penalty
                    }
                    rank = rank + 1
                }
            }
        }

        free(rank_emb as ptr<void>)
        free(orig_neighbors as ptr<void>)
        i = i + 1
    }

    array_free_f32(dist_orig)
    array_free_f32(dist_emb)

    # T = 1 - (2 / (n * (2 * n_neighbors))) * total
    let denom: f32 = (n as f32) * (2.0 * (n_neighbors as f32))
    let mut result: f32 = 1.0 - (2.0 / denom) * total
    if result < 0.0 { result = 0.0 }
    if result > 1.0 { result = 1.0 }
    return result
}
