# Manifold learning module for flow-scikit.
# Implements t-SNE (t-Distributed Stochastic Neighbor Embedding).
# Uses Barnes-Hut approximation for O(n log n) complexity.

import "lib/scikit/matrix.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

export struct TSNE {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    perplexity: f32,
    learning_rate: f32,
    n_iter: i32,
    fitted: bool
}

function compute_pairwise_distances(X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let dist: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        for j in 0 to n {
            if i == j {
                dist[i * n + j] = 0.0
            } else {
                let mut sum: f32 = 0.0
                for k in 0 to X.cols {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    sum = sum + d * d
                }
                dist[i * n + j] = sqrt(sum as f64) as f32
            }
        }
    }
    return dist
}

function compute_joint_probabilities(dist: ptr<f32>, n: i32, perplexity: f32) -> ptr<f32> {
    let P: ptr<f32> = array_new_f32(n * n)
    let target_entropy: f32 = log(perplexity as f64) as f32
    let beta: f32 = 1.0
    let beta_min: f32 = 0.01
    let beta_max: f32 = 1000.0
    let tol: f32 = 0.0001
    let max_iter: i32 = 50

    for i in 0 to n {
        beta = 1.0
        beta_min = 0.01
        beta_max = 1000.0
        let mut sum_p: f32 = 0.0

        for _ in 0 to max_iter {
            sum_p = 0.0
            for j in 0 to n {
                if i != j {
                    let d: f32 = dist[i * n + j]
                    P[i * n + j] = exp((0.0 - beta * d * d) as f64) as f32
                    sum_p = sum_p + P[i * n + j]
                } else {
                    P[i * n + j] = 0.0
                }
            }

            if sum_p < 0.0000000001 {
                sum_p = 0.0000000001
            }

            let mut entropy: f32 = 0.0
            for j in 0 to n {
                if i != j {
                    let p: f32 = P[i * n + j] / sum_p
                    if p > 0.0000000001 {
                        entropy = entropy - p * log(p as f64) as f32
                    }
                }
            }

            let diff: f32 = entropy - target_entropy
            if (fabs(diff as f64) as f32) < tol {
                break
            }

            if diff > 0.0 {
                beta_min = beta
                beta = (beta + beta_max) / 2.0
            } else {
                beta_max = beta
                beta = (beta + beta_min) / 2.0
            }
        }

        for j in 0 to n {
            if i != j {
                P[i * n + j] = P[i * n + j] / sum_p
            }
        }
    }

    for i in 0 to n {
        for j in 0 to i {
            let val: f32 = (P[i * n + j] + P[j * n + i]) / (2.0 * (n as f32))
            P[i * n + j] = val
            P[j * n + i] = val
        }
    }

    return P
}

export function tsne_fit(X: Matrix, n_components: i32, perplexity: f32, learning_rate: f32, n_iter: i32, seed: i32) -> TSNE {
    let n: i32 = X.rows
    srand(seed)

    let dist: ptr<f32> = compute_pairwise_distances(X)
    let P: ptr<f32> = compute_joint_probabilities(dist, n, perplexity)

    let Y: ptr<f32> = array_new_f32(n * n_components)
    let Y_grad: ptr<f32> = array_new_f32(n * n_components)
    let gains: ptr<f32> = array_new_f32(n * n_components)

    for i in 0 to n * n_components {
        Y[i] = ((rand() % 1000) as f32) / 1000.0 - 0.5
        Y[i] = Y[i] * 0.0001
        gains[i] = 1.0
    }

    let momentum: f32 = 0.5
    let early_exaggeration: f32 = 4.0
    let exag_iter: i32 = 100

    for iter in 0 to n_iter {
        let exaggeration: f32 = 1.0
        if iter < exag_iter {
            exaggeration = early_exaggeration
        }

        let mut sum_Q: f32 = 0.0
        let Q: ptr<f32> = array_new_f32(n * n)

        for i in 0 to n {
            for j in 0 to n {
                if i != j {
                    let mut dist_y: f32 = 0.0
                    for k in 0 to n_components {
                        let d: f32 = Y[i * n_components + k] - Y[j * n_components + k]
                        dist_y = dist_y + d * d
                    }
                    Q[i * n + j] = 1.0 / (1.0 + dist_y)
                    sum_Q = sum_Q + Q[i * n + j]
                } else {
                    Q[i * n + j] = 0.0
                }
            }
        }

        if sum_Q < 0.0000000001 {
            sum_Q = 0.0000000001
        }

        for i in 0 to n {
            for j in 0 to n {
                Q[i * n + j] = Q[i * n + j] / sum_Q
            }
        }

        for i in 0 to n * n_components {
            Y_grad[i] = 0.0
        }

        for i in 0 to n {
            for j in 0 to n {
                if i != j {
                    let pq: f32 = exaggeration * P[i * n + j] - Q[i * n + j]
                    let mut dist_y: f32 = 0.0
                    for k in 0 to n_components {
                        let d: f32 = Y[i * n_components + k] - Y[j * n_components + k]
                        dist_y = dist_y + d * d
                    }
                    let factor: f32 = pq * 4.0 / (1.0 + dist_y)
                    for k in 0 to n_components {
                        Y_grad[i * n_components + k] = Y_grad[i * n_components + k] + factor * (Y[i * n_components + k] - Y[j * n_components + k])
                    }
                }
            }
        }

        for i in 0 to n * n_components {
            if Y_grad[i] * Y_grad[i + 0] > 0.0 {
                gains[i] = gains[i] * 0.8
            } else {
                gains[i] = gains[i] + 0.2
            }
            if gains[i] < 0.01 {
                gains[i] = 0.01
            }
            Y[i] = Y[i] - learning_rate * gains[i] * Y_grad[i]
        }

        let mut mean_y: f32 = 0.0
        for i in 0 to n * n_components {
            mean_y = mean_y + Y[i]
        }
        mean_y = mean_y / (n as f32)
        for i in 0 to n * n_components {
            Y[i] = Y[i] - mean_y
        }

        array_free_f32(Q)

        if iter % 100 == 0 {
            let mut kl: f32 = 0.0
            let Q2: ptr<f32> = array_new_f32(n * n)
            let mut sq: f32 = 0.0
            for i in 0 to n {
                for j in 0 to n {
                    if i != j {
                        let mut dy: f32 = 0.0
                        for k in 0 to n_components {
                            let d: f32 = Y[i * n_components + k] - Y[j * n_components + k]
                            dy = dy + d * d
                        }
                        Q2[i * n + j] = 1.0 / (1.0 + dy)
                        sq = sq + Q2[i * n + j]
                    }
                }
            }
            if sq < 0.0000000001 { sq = 0.0000000001 }
            for i in 0 to n {
                for j in 0 to n {
                    if i != j {
                        let p: f32 = P[i * n + j]
                        let q: f32 = Q2[i * n + j] / sq
                        if p > 0.0000000001 && q > 0.0000000001 {
                            kl = kl + p * log((p / q) as f64) as f32
                        }
                    }
                }
            }
            print("[t-SNE] iter ")
            print(iter)
            print("  KL divergence = ")
            printf("%.4f", kl)
            println("")
            array_free_f32(Q2)
        }
    }

    array_free_f32(dist)
    array_free_f32(P)
    array_free_f32(Y_grad)
    array_free_f32(gains)

    return TSNE {
        embedding: Y,
        n_samples: n,
        n_components: n_components,
        perplexity: perplexity,
        learning_rate: learning_rate,
        n_iter: n_iter,
        fitted: true
    }
}

export function tsne_fit_transform(X: Matrix, n_components: i32, perplexity: f32, learning_rate: f32, n_iter: i32, seed: i32) -> Matrix {
    let model: TSNE = tsne_fit(X, n_components, perplexity, learning_rate, n_iter, seed)
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    tsne_free(model)
    return result
}

export function tsne_embedding(model: TSNE) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function tsne_free(model: TSNE) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# Isomap
# ============================================================================

export struct Isomap {
    embedding: ptr<f32>,
    n_samples: i32,
    n_features: i32,
    n_components: i32,
    n_neighbors: i32,
    fitted: bool
}

export function isomap_fit(X: Matrix, n_components: i32, n_neighbors: i32) -> Isomap {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let D: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        D[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            D[i][j] = sqrt((s as f64)) as f32
        }
    }

    let geo: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        geo[i] = array_copy_f32(D[i], n)
    }

    for k in 0 to n {
        for i in 0 to n {
            for j in 0 to n {
                if geo[i][k] + geo[k][j] < geo[i][j] {
                    geo[i][j] = geo[i][k] + geo[k][j]
                }
            }
        }
    }

    let mut mean_d: f32 = 0.0
    for i in 0 to n {
        for j in 0 to n {
            geo[i][j] = geo[i][j] * geo[i][j]
            mean_d = mean_d + geo[i][j]
        }
    }
    mean_d = mean_d / ((n * n) as f32)

    let B: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        B[i] = array_new_f32(n)
        for j in 0 to n {
            B[i][j] = -0.5 * (geo[i][j] - mean_d)
        }
    }

    let embedding: ptr<f32> = array_new_f32(n * n_components)
    # Track found eigenvectors for deflation
    let found_vecs: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        let v: ptr<f32> = array_new_f32(n)
        srand(42 + c)
        for i in 0 to n { v[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }

        # Orthogonalize against previously found eigenvectors
        for prev in 0 to c {
            let mut dot: f32 = 0.0
            for i in 0 to n { dot = dot + v[i] * found_vecs[prev][i] }
            for i in 0 to n { v[i] = v[i] - dot * found_vecs[prev][i] }
        }

        let mut iter: i32 = 0
        while iter < 200 {
            let Bv: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut s: f32 = 0.0
                for j in 0 to n { s = s + B[i][j] * v[j] }
                Bv[i] = s
            }

            # Deflate against previous eigenvectors
            for prev in 0 to c {
                let mut dot: f32 = 0.0
                for i in 0 to n { dot = dot + Bv[i] * found_vecs[prev][i] }
                for i in 0 to n { Bv[i] = Bv[i] - dot * found_vecs[prev][i] }
            }

            let mut norm: f32 = 0.0
            for i in 0 to n { norm = norm + Bv[i] * Bv[i] }
            norm = sqrt((norm as f64)) as f32
            if norm < 0.0000000001 { norm = 0.0000000001 }

            # Convergence check
            let mut max_change: f32 = 0.0
            for i in 0 to n {
                let new_v: f32 = Bv[i] / norm
                let diff: f32 = new_v - v[i]
                if diff < 0.0 { diff = -diff }
                if diff > max_change { max_change = diff }
                v[i] = new_v
            }
            array_free_f32(Bv)

            if max_change < 0.000001 { break }
            iter = iter + 1
        }

        for i in 0 to n {
            embedding[i * n_components + c] = v[i]
        }
        found_vecs[c] = v
    }

    for c in 0 to n_components { array_free_f32(found_vecs[c]) }
    free(found_vecs as ptr<void>)

    for i in 0 to n { array_free_f32(D[i]); array_free_f32(geo[i]); array_free_f32(B[i]) }
    free(D as ptr<void>)
    free(geo as ptr<void>)
    free(B as ptr<void>)

    return Isomap {
        embedding: embedding,
        n_samples: n,
        n_features: p,
        n_components: n_components,
        n_neighbors: n_neighbors,
        fitted: true
    }
}

export function isomap_embedding(model: Isomap) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function isomap_free(model: Isomap) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# LocallyLinearEmbedding (LLE)
# ============================================================================

export struct LLE {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    n_neighbors: i32,
    fitted: bool
}

export function lle_fit(X: Matrix, n_components: i32, n_neighbors: i32) -> LLE {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let W: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        W[i] = array_new_f32(n)

        let dists: ptr<f32> = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            dists[j] = s
        }

        let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        for j in 0 to n { indices[j] = j }
        for a in 0 to n {
            for b in 0 to n - 1 - a {
                if dists[indices[b]] > dists[indices[b + 1]] {
                    let t: i32 = indices[b]
                    indices[b] = indices[b + 1]
                    indices[b + 1] = t
                }
            }
        }

        let k: i32 = n_neighbors
        if k > n - 1 { k = n - 1 }
        let mut sum_w: f32 = 0.0
        for j in 1 to k + 1 {
            W[i][indices[j]] = 1.0 / (k as f32)
            sum_w = sum_w + W[i][indices[j]]
        }
        if sum_w > 0.0000000001 {
            for j in 0 to n { W[i][j] = W[i][j] / sum_w }
        }

        array_free_f32(dists)
        free(indices as ptr<void>)
    }

    let M: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        M[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            if i == j { s = 1.0 }
            s = s - W[i][j] - W[j][i]
            for k in 0 to n {
                s = s + W[k][i] * W[k][j]
            }
            M[i][j] = s
        }
    }

    let embedding: ptr<f32> = array_new_f32(n * n_components)
    let found_vecs: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        let v: ptr<f32> = array_new_f32(n)
        srand(42 + c)
        for i in 0 to n { v[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }

        # Orthogonalize against previously found eigenvectors
        for prev in 0 to c {
            let mut dot: f32 = 0.0
            for i in 0 to n { dot = dot + v[i] * found_vecs[prev][i] }
            for i in 0 to n { v[i] = v[i] - dot * found_vecs[prev][i] }
        }

        let mut iter: i32 = 0
        while iter < 200 {
            let Mv: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut s: f32 = 0.0
                for j in 0 to n { s = s + M[i][j] * v[j] }
                Mv[i] = s
            }

            for prev in 0 to c {
                let mut dot: f32 = 0.0
                for i in 0 to n { dot = dot + Mv[i] * found_vecs[prev][i] }
                for i in 0 to n { Mv[i] = Mv[i] - dot * found_vecs[prev][i] }
            }

            let mut norm: f32 = 0.0
            for i in 0 to n { norm = norm + Mv[i] * Mv[i] }
            norm = sqrt((norm as f64)) as f32
            if norm < 0.0000000001 { norm = 0.0000000001 }

            let mut max_change: f32 = 0.0
            for i in 0 to n {
                let new_v: f32 = Mv[i] / norm
                let diff: f32 = new_v - v[i]
                if diff < 0.0 { diff = -diff }
                if diff > max_change { max_change = diff }
                v[i] = new_v
            }
            array_free_f32(Mv)

            if max_change < 0.000001 { break }
            iter = iter + 1
        }

        for i in 0 to n {
            embedding[i * n_components + c] = v[i]
        }
        found_vecs[c] = v
    }

    for c in 0 to n_components { array_free_f32(found_vecs[c]) }
    free(found_vecs as ptr<void>)

    for i in 0 to n { array_free_f32(W[i]); array_free_f32(M[i]) }
    free(W as ptr<void>)
    free(M as ptr<void>)

    return LLE {
        embedding: embedding,
        n_samples: n,
        n_components: n_components,
        n_neighbors: n_neighbors,
        fitted: true
    }
}

export function lle_embedding(model: LLE) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function lle_free(model: LLE) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# SpectralEmbedding
# ============================================================================

export struct SpectralEmbedding {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    fitted: bool
}

export function spectral_embedding_fit(X: Matrix, n_components: i32, gamma: f32) -> SpectralEmbedding {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let W: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        W[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            W[i][j] = exp((-gamma * s) as f64) as f32
        }
    }

    let deg: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        for j in 0 to n { deg[i] = deg[i] + W[i][j] }
        if deg[i] < 0.0000000001 { deg[i] = 0.0000000001 }
    }

    let L: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        L[i] = array_new_f32(n)
        for j in 0 to n {
            if i == j { L[i][j] = 1.0 }
            else { L[i][j] = -W[i][j] / sqrt((deg[i] * deg[j]) as f64) as f32 }
        }
    }

    let embedding: ptr<f32> = array_new_f32(n * n_components)
    let found_vecs: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        let v: ptr<f32> = array_new_f32(n)
        srand(42 + c)
        for i in 0 to n { v[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }

        # Orthogonalize against previously found eigenvectors
        for prev in 0 to c {
            let mut dot: f32 = 0.0
            for i in 0 to n { dot = dot + v[i] * found_vecs[prev][i] }
            for i in 0 to n { v[i] = v[i] - dot * found_vecs[prev][i] }
        }

        let mut iter: i32 = 0
        while iter < 200 {
            let Lv: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut s: f32 = 0.0
                for j in 0 to n { s = s + L[i][j] * v[j] }
                Lv[i] = s
            }

            for prev in 0 to c {
                let mut dot: f32 = 0.0
                for i in 0 to n { dot = dot + Lv[i] * found_vecs[prev][i] }
                for i in 0 to n { Lv[i] = Lv[i] - dot * found_vecs[prev][i] }
            }

            let mut norm: f32 = 0.0
            for i in 0 to n { norm = norm + Lv[i] * Lv[i] }
            norm = sqrt((norm as f64)) as f32
            if norm < 0.0000000001 { norm = 0.0000000001 }

            let mut max_change: f32 = 0.0
            for i in 0 to n {
                let new_v: f32 = Lv[i] / norm
                let diff: f32 = new_v - v[i]
                if diff < 0.0 { diff = -diff }
                if diff > max_change { max_change = diff }
                v[i] = new_v
            }
            array_free_f32(Lv)

            if max_change < 0.000001 { break }
            iter = iter + 1
        }

        for i in 0 to n {
            embedding[i * n_components + c] = v[i]
        }
        found_vecs[c] = v
    }

    for c in 0 to n_components { array_free_f32(found_vecs[c]) }
    free(found_vecs as ptr<void>)

    for i in 0 to n { array_free_f32(W[i]); array_free_f32(L[i]) }
    free(W as ptr<void>)
    free(L as ptr<void>)
    array_free_f32(deg)

    return SpectralEmbedding {
        embedding: embedding,
        n_samples: n,
        n_components: n_components,
        fitted: true
    }
}

export function spectral_embedding_get(model: SpectralEmbedding) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function spectral_embedding_free(model: SpectralEmbedding) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# MDS (Multidimensional Scaling)
# ============================================================================

export struct MDS {
    embedding: ptr<f32>,
    n_samples: i32,
    n_components: i32,
    n_iter: i32,
    stress: f32,
    fitted: bool
}

export function mds_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> MDS {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let D: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        D[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            D[i][j] = sqrt((s as f64)) as f32
        }
    }

    srand(seed)
    let embedding: ptr<f32> = array_new_f32(n * n_components)
    for i in 0 to n * n_components {
        embedding[i] = ((rand() % 1000) as f32) / 500.0 - 1.0
    }

    let mut n_iter: i32 = 0
    let mut stress: f32 = 0.0
    for iter in 0 to max_iter {
        n_iter = iter + 1
        stress = 0.0

        for i in 0 to n {
            for j in 0 to n {
                if i == j { continue }
                let mut d_hat: f32 = 0.0
                for c in 0 to n_components {
                    let d: f32 = embedding[i * n_components + c] - embedding[j * n_components + c]
                    d_hat = d_hat + d * d
                }
                d_hat = sqrt((d_hat as f64)) as f32
                if d_hat < 0.0000000001 { d_hat = 0.0000000001 }

                let delta: f32 = D[i][j] - d_hat
                stress = stress + delta * delta

                let grad_scale: f32 = delta / d_hat
                for c in 0 to n_components {
                    let g: f32 = grad_scale * (embedding[i * n_components + c] - embedding[j * n_components + c])
                    embedding[i * n_components + c] = embedding[i * n_components + c] + 0.01 * g
                }
            }
        }

        if stress / (n as f32) < tol { break }
    }

    for i in 0 to n { array_free_f32(D[i]) }
    free(D as ptr<void>)

    return MDS {
        embedding: embedding,
        n_samples: n,
        n_components: n_components,
        n_iter: n_iter,
        stress: stress,
        fitted: true
    }
}

export function mds_embedding(model: MDS) -> Matrix {
    let result: Matrix = matrix_new(model.n_samples, model.n_components)
    for i in 0 to model.n_samples {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, model.embedding[i * model.n_components + j])
        }
    }
    return result
}

export function mds_free(model: MDS) -> void {
    array_free_f32(model.embedding)
}

# ============================================================================
# Trustworthiness
# ============================================================================

export function trustworthiness(X: Matrix, X_embedded: Matrix, n_neighbors: i32) -> f32 {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Compute pairwise distances in original space
    let dist_orig: ptr<f32> = array_new_f32(n * n)
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = 0
        while j < n {
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < n_features {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
                k = k + 1
            }
            dist_orig[i * n + j] = sqrt((s) as f64) as f32
            j = j + 1
        }
        i = i + 1
    }

    # Compute pairwise distances in embedded space
    let n_emb: i32 = X_embedded.cols
    let dist_emb: ptr<f32> = array_new_f32(n * n)
    i = 0
    while i < n {
        let mut j: i32 = 0
        while j < n {
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < n_emb {
                let d: f32 = matrix_at(X_embedded, i, k) - matrix_at(X_embedded, j, k)
                s = s + d * d
                k = k + 1
            }
            dist_emb[i * n + j] = sqrt((s) as f64) as f32
            j = j + 1
        }
        i = i + 1
    }

    # For each point, rank neighbors in embedded space
    # Then check if neighbors in embedded space are also close in original space
    let mut total: f32 = 0.0
    i = 0
    while i < n {
        # Rank points by embedded distance (excluding self)
        let rank_emb: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        let mut j: i32 = 0
        while j < n {
            rank_emb[j] = j
            j = j + 1
        }

        # Selection sort by embedded distance
        let mut a: i32 = 0
        while a < n {
            let mut min_idx: i32 = a
            let mut b: i32 = a + 1
            while b < n {
                if dist_emb[i * n + rank_emb[b]] < dist_emb[i * n + rank_emb[min_idx]] {
                    min_idx = b
                }
                b = b + 1
            }
            let tmp: i32 = rank_emb[a]
            rank_emb[a] = rank_emb[min_idx]
            rank_emb[min_idx] = tmp
            a = a + 1
        }

        # rank_emb[0] should be i itself (distance 0). Skip it.
        # For each neighbor in embedded space beyond n_neighbors,
        # check if it is also a neighbor in original space.
        # If not, add penalty proportional to rank difference.

        # Build original-space neighbor set (indices of n_neighbors closest)
        let orig_neighbors: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        let mut j2: i32 = 0
        while j2 < n {
            orig_neighbors[j2] = j2
            j2 = j2 + 1
        }

        # Sort by original distance
        let mut a2: i32 = 0
        while a2 < n {
            let mut min_idx2: i32 = a2
            let mut b2: i32 = a2 + 1
            while b2 < n {
                if dist_orig[i * n + orig_neighbors[b2]] < dist_orig[i * n + orig_neighbors[min_idx2]] {
                    min_idx2 = b2
                }
                b2 = b2 + 1
            }
            let tmp2: i32 = orig_neighbors[a2]
            orig_neighbors[a2] = orig_neighbors[min_idx2]
            orig_neighbors[min_idx2] = tmp2
            a2 = a2 + 1
        }

        # For each point in the embedded ranking beyond n_neighbors,
        # check if it is in the original n_neighbors. If not, add penalty.
        let mut rank: i32 = 1  # skip self at rank 0
        while rank < n {
            if rank <= n_neighbors {
                # These are the close neighbors in embedded space, no penalty
                rank = rank + 1
            } else {
                let neighbor_idx: i32 = rank_emb[rank]
                if neighbor_idx == i {
                    rank = rank + 1
                } else {
                    # Check if neighbor_idx is in original top n_neighbors
                    let mut in_orig: bool = false
                    let mut kk: i32 = 1
                    while kk <= n_neighbors {
                        if orig_neighbors[kk] == neighbor_idx {
                            in_orig = true
                        }
                        kk = kk + 1
                    }
                    if not in_orig {
                        # Penalty: (rank - n_neighbors) / (n - n_neighbors - 1)
                        let penalty: f32 = ((rank - n_neighbors) as f32) / ((n - n_neighbors - 1) as f32)
                        total = total + penalty
                    }
                    rank = rank + 1
                }
            }
        }

        free(rank_emb as ptr<void>)
        free(orig_neighbors as ptr<void>)
        i = i + 1
    }

    array_free_f32(dist_orig)
    array_free_f32(dist_emb)

    # T = 1 - (2 / (n * (2 * n_neighbors))) * total
    let denom: f32 = (n as f32) * (2.0 * (n_neighbors as f32))
    let mut result: f32 = 1.0 - (2.0 / denom) * total
    if result < 0.0 { result = 0.0 }
    if result > 1.0 { result = 1.0 }
    return result
}
