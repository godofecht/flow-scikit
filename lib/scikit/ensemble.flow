# Ensemble module for flow-scikit.
# Implements RandomForestClassifier, RandomForestRegressor, BaggingClassifier,
# and VotingClassifier.
#
# Uses bootstrap sampling and feature subsampling for random forests.
# Addresses Issue #28394: predict returns probabilities, decide returns classes.

import "lib/scikit/matrix.flow"
import "lib/scikit/tree.flow"
import "lib/scikit/prng.flow"

extern {
    function sqrt(x: f64) -> f64
}

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

export struct RandomForestClassifier {
    trees: ptr<DecisionTreeClassifier>,
    n_trees: i32,
    n_classes: i32,
    classes: ptr<f32>,
    max_depth: i32,
    n_features_per_split: i32,
    fitted: bool
}

export function random_forest_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_trees: i32, max_depth: i32, seed: i32) -> RandomForestClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let trees: ptr<DecisionTreeClassifier> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeClassifier>
    let mut prng: PRNG = prng_seed(seed)

    # max_features = sqrt(n_features) for classification (sklearn default)
    let max_features_f64: f64 = sqrt((X.cols as f64))
    let max_features: i32 = (max_features_f64 as i32)
    if max_features < 1 { max_features = 1 }

    # Shared PRNG state pointer for the RF tree builder
    let prng_state: ptr<u32> = malloc(4) as ptr<u32>

    for t in 0 to n_trees {
        let n_samples: i32 = X.rows
        let bootstrap_indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
        for i in 0 to n_samples {
            let res: PRNGResult = prng_int(prng, n_samples)
            prng = PRNG { state: res.state }
            bootstrap_indices[i] = res.value
        }

        let X_boot: Matrix = matrix_new(n_samples, X.cols)
        let y_boot: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            y_boot[i] = y[bootstrap_indices[i]]
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, bootstrap_indices[i], j))
            }
        }

        # Set PRNG state for this tree's feature subsampling
        let res: PRNGResult = prng_int(prng, 2147483647)
        prng = PRNG { state: res.state }
        prng_state[0] = res.state

        trees[t] = decision_tree_classifier_fit_rf(X_boot, y_boot, n_classes, max_depth, CRITERION_GINI, max_features, prng_state)

        free(bootstrap_indices as ptr<void>)
        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    free(prng_state as ptr<void>)

    return RandomForestClassifier {
        trees: trees,
        n_trees: n_trees,
        n_classes: n_classes,
        classes: classes,
        max_depth: max_depth,
        n_features_per_split: 0,
        fitted: true
    }
}

export function random_forest_classifier_predict(model: RandomForestClassifier, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)

    for i in 0 to X.rows {
        matrix_row(X, i, row)

        let votes: ptr<i32> = malloc((model.n_classes as i64) * 4) as ptr<i32>
        for c in 0 to model.n_classes {
            votes[c] = 0
        }

        for t in 0 to model.n_trees {
            let pred: f32 = decision_tree_classifier_predict_one(model.trees[t], row)
            for c in 0 to model.n_classes {
                if model.classes[c] == pred {
                    votes[c] = votes[c] + 1
                }
            }
        }

        let mut best_c: i32 = 0
        let mut best_votes: i32 = 0
        for c in 0 to model.n_classes {
            if votes[c] > best_votes {
                best_votes = votes[c]
                best_c = c
            }
        }

        preds[i] = model.classes[best_c]
        free(votes as ptr<void>)
    }

    array_free_f32(row)
    return preds
}

export function random_forest_classifier_predict_proba(model: RandomForestClassifier, X: Matrix) -> Matrix {
    let probs: Matrix = matrix_new(X.rows, model.n_classes)
    let row: ptr<f32> = array_new_f32(X.cols)

    for i in 0 to X.rows {
        matrix_row(X, i, row)

        let votes: ptr<i32> = malloc((model.n_classes as i64) * 4) as ptr<i32>
        for c in 0 to model.n_classes {
            votes[c] = 0
        }

        for t in 0 to model.n_trees {
            let pred: f32 = decision_tree_classifier_predict_one(model.trees[t], row)
            for c in 0 to model.n_classes {
                if model.classes[c] == pred {
                    votes[c] = votes[c] + 1
                }
            }
        }

        for c in 0 to model.n_classes {
            matrix_set(probs, i, c, (votes[c] as f32) / (model.n_trees as f32))
        }

        free(votes as ptr<void>)
    }

    array_free_f32(row)
    return probs
}

export function random_forest_classifier_decide(model: RandomForestClassifier, probs: Matrix) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(probs.rows)
    for i in 0 to probs.rows {
        let mut best_c: i32 = 0
        let mut best_p: f32 = matrix_at(probs, i, 0)
        for c in 1 to model.n_classes {
            let p: f32 = matrix_at(probs, i, c)
            if p > best_p {
                best_p = p
                best_c = c
            }
        }
        labels[i] = model.classes[best_c]
    }
    return labels
}

export function random_forest_classifier_free(model: RandomForestClassifier) -> void {
    for t in 0 to model.n_trees {
        decision_tree_classifier_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    array_free_f32(model.classes)
}

# Feature importances for RandomForestClassifier: average of per-tree importances.
# Addresses sklearn #34472.
export function random_forest_classifier_feature_importances(model: RandomForestClassifier, n_features: i32) -> ptr<f32> {
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    for t in 0 to model.n_trees {
        let tree_imp: ptr<f32> = decision_tree_classifier_feature_importances(model.trees[t], n_features)
        for f in 0 to n_features {
            importances[f] = importances[f] + tree_imp[f]
        }
        array_free_f32(tree_imp)
    }
    if model.n_trees > 0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / (model.n_trees as f32)
        }
    }
    return importances
}

export struct RandomForestRegressor {
    trees: ptr<DecisionTreeRegressor>,
    n_trees: i32,
    max_depth: i32,
    fitted: bool
}

export function random_forest_regressor_fit(X: Matrix, y: ptr<f32>, n_trees: i32, max_depth: i32, seed: i32) -> RandomForestRegressor {
    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>
    srand(seed)

    for t in 0 to n_trees {
        let n_samples: i32 = X.rows
        let bootstrap_indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
        for i in 0 to n_samples {
            bootstrap_indices[i] = rand() % n_samples
        }

        let X_boot: Matrix = matrix_new(n_samples, X.cols)
        let y_boot: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            y_boot[i] = y[bootstrap_indices[i]]
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, bootstrap_indices[i], j))
            }
        }

        trees[t] = decision_tree_regressor_fit(X_boot, y_boot, max_depth, CRITERION_MSE)

        free(bootstrap_indices as ptr<void>)
        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    return RandomForestRegressor {
        trees: trees,
        n_trees: n_trees,
        max_depth: max_depth,
        fitted: true
    }
}

export function random_forest_regressor_predict(model: RandomForestRegressor, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)

    for i in 0 to X.rows {
        matrix_row(X, i, row)
        let mut sum: f32 = 0.0
        for t in 0 to model.n_trees {
            sum = sum + decision_tree_regressor_predict_one(model.trees[t], row)
        }
        preds[i] = sum / (model.n_trees as f32)
    }

    array_free_f32(row)
    return preds
}

export function random_forest_regressor_free(model: RandomForestRegressor) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
}

# Feature importances for RandomForestRegressor: average of per-tree importances.
# Addresses sklearn #34472.
export function random_forest_regressor_feature_importances(model: RandomForestRegressor, n_features: i32) -> ptr<f32> {
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    for t in 0 to model.n_trees {
        let tree_imp: ptr<f32> = decision_tree_regressor_feature_importances(model.trees[t], n_features)
        for f in 0 to n_features {
            importances[f] = importances[f] + tree_imp[f]
        }
        array_free_f32(tree_imp)
    }
    if model.n_trees > 0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / (model.n_trees as f32)
        }
    }
    return importances
}

# ============================================================================
# BaggingClassifier (bootstrap aggregating with any base estimator)
# ============================================================================

export struct BaggingClassifier {
    trees: ptr<DecisionTreeClassifier>,
    n_estimators: i32,
    n_classes: i32,
    classes: ptr<f32>,
    max_depth: i32,
    fitted: bool
}

export function bagging_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_estimators: i32, max_depth: i32, seed: i32) -> BaggingClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let trees: ptr<DecisionTreeClassifier> = malloc((n_estimators as i64) * 128) as ptr<DecisionTreeClassifier>
    srand(seed)

    for t in 0 to n_estimators {
        let n_samples: i32 = X.rows
        let indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
        for i in 0 to n_samples {
            indices[i] = rand() % n_samples
        }

        let X_boot: Matrix = matrix_new(n_samples, X.cols)
        let y_boot: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            y_boot[i] = y[indices[i]]
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, indices[i], j))
            }
        }

        trees[t] = decision_tree_classifier_fit(X_boot, y_boot, n_classes, max_depth, CRITERION_GINI)

        free(indices as ptr<void>)
        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    return BaggingClassifier {
        trees: trees,
        n_estimators: n_estimators,
        n_classes: n_classes,
        classes: classes,
        max_depth: max_depth,
        fitted: true
    }
}

export function bagging_classifier_predict(model: BaggingClassifier, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)

    for i in 0 to X.rows {
        matrix_row(X, i, row)

        let votes: ptr<i32> = malloc((model.n_classes as i64) * 4) as ptr<i32>
        for c in 0 to model.n_classes {
            votes[c] = 0
        }

        for t in 0 to model.n_estimators {
            let pred: f32 = decision_tree_classifier_predict_one(model.trees[t], row)
            for c in 0 to model.n_classes {
                if model.classes[c] == pred {
                    votes[c] = votes[c] + 1
                }
            }
        }

        let mut best_c: i32 = 0
        let mut best_votes: i32 = 0
        for c in 0 to model.n_classes {
            if votes[c] > best_votes {
                best_votes = votes[c]
                best_c = c
            }
        }

        preds[i] = model.classes[best_c]
        free(votes as ptr<void>)
    }

    array_free_f32(row)
    return preds
}

export function bagging_classifier_free(model: BaggingClassifier) -> void {
    for t in 0 to model.n_estimators {
        decision_tree_classifier_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    array_free_f32(model.classes)
}

# ============================================================================
# VotingClassifier (majority vote across heterogeneous estimators)
# ============================================================================

export const VOTING_HARD: i32 = 0
export const VOTING_SOFT: i32 = 1

export struct VotingClassifier {
    estimators: ptr<DecisionTreeClassifier>,
    n_estimators: i32,
    n_classes: i32,
    classes: ptr<f32>,
    voting: i32,
    fitted: bool
}

export function voting_classifier_fit(estimators: ptr<DecisionTreeClassifier>, n_estimators: i32, n_classes: i32, classes: ptr<f32>, voting: i32) -> VotingClassifier {
    return VotingClassifier {
        estimators: estimators,
        n_estimators: n_estimators,
        n_classes: n_classes,
        classes: classes,
        voting: voting,
        fitted: true
    }
}

export function voting_classifier_predict(model: VotingClassifier, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)

    for i in 0 to X.rows {
        matrix_row(X, i, row)

        let votes: ptr<i32> = malloc((model.n_classes as i64) * 4) as ptr<i32>
        for c in 0 to model.n_classes {
            votes[c] = 0
        }

        for t in 0 to model.n_estimators {
            let pred: f32 = decision_tree_classifier_predict_one(model.estimators[t], row)
            for c in 0 to model.n_classes {
                if model.classes[c] == pred {
                    votes[c] = votes[c] + 1
                }
            }
        }

        let mut best_c: i32 = 0
        let mut best_votes: i32 = 0
        for c in 0 to model.n_classes {
            if votes[c] > best_votes {
                best_votes = votes[c]
                best_c = c
            }
        }

        preds[i] = model.classes[best_c]
        free(votes as ptr<void>)
    }

    array_free_f32(row)
    return preds
}

export function voting_classifier_free(model: VotingClassifier) -> void {
    for t in 0 to model.n_estimators {
        decision_tree_classifier_free(model.estimators[t])
    }
    free(model.estimators as ptr<void>)
    array_free_f32(model.classes)
}

# ============================================================================
# GradientBoostingClassifier
# Fits regression trees on the negative gradient of the log loss.
# ============================================================================

export struct GradientBoostingClassifier {
    trees: ptr<DecisionTreeRegressor>,
    n_trees: i32,
    init_value: f32,
    learning_rate: f32,
    classes: ptr<f32>,
    n_classes: i32,
    max_depth: i32,
    fitted: bool
}

function _gb_sigmoid(x: f32) -> f32 {
    let e: f64 = exp((0.0 - x) as f64)
    return 1.0 / (1.0 + (e as f32))
}

export function gradient_boosting_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_trees: i32, learning_rate: f32, max_depth: i32, seed: i32) -> GradientBoostingClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let y_binary: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        if y[i] == classes[1] {
            y_binary[i] = 1.0
        } else {
            y_binary[i] = 0.0
        }
    }

    let mut pos: i32 = 0
    for i in 0 to X.rows {
        if y_binary[i] == 1.0 {
            pos = pos + 1
        }
    }
    let p0: f32 = (pos as f32) / (X.rows as f32)
    let init_value: f32 = log((p0 / (1.0 - p0)) as f64) as f32

    let current_pred: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        current_pred[i] = init_value
    }

    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>

    for t in 0 to n_trees {
        let residuals: ptr<f32> = array_new_f32(X.rows)
        for i in 0 to X.rows {
            let p: f32 = _gb_sigmoid(current_pred[i])
            residuals[i] = y_binary[i] - p
        }

        trees[t] = decision_tree_regressor_fit(X, residuals, max_depth, CRITERION_MSE)

        let tree_preds: ptr<f32> = decision_tree_regressor_predict(trees[t], X)
        for i in 0 to X.rows {
            current_pred[i] = current_pred[i] + learning_rate * tree_preds[i]
        }

        array_free_f32(residuals)
        array_free_f32(tree_preds)
    }

    array_free_f32(current_pred)
    array_free_f32(y_binary)

    return GradientBoostingClassifier {
        trees: trees,
        n_trees: n_trees,
        init_value: init_value,
        learning_rate: learning_rate,
        classes: classes,
        n_classes: n_classes,
        max_depth: max_depth,
        fitted: true
    }
}

export function gradient_boosting_classifier_predict(model: GradientBoostingClassifier, X: Matrix) -> ptr<f32> {
    let raw_scores: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        raw_scores[i] = model.init_value
    }

    let row: ptr<f32> = array_new_f32(X.cols)
    for t in 0 to model.n_trees {
        for i in 0 to X.rows {
            matrix_row(X, i, row)
            raw_scores[i] = raw_scores[i] + model.learning_rate * decision_tree_regressor_predict_one(model.trees[t], row)
        }
    }
    array_free_f32(row)

    let preds: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let p: f32 = _gb_sigmoid(raw_scores[i])
        if p >= 0.5 {
            preds[i] = model.classes[1]
        } else {
            preds[i] = model.classes[0]
        }
    }

    array_free_f32(raw_scores)
    return preds
}

export function gradient_boosting_classifier_predict_proba(model: GradientBoostingClassifier, X: Matrix) -> Matrix {
    let probs: Matrix = matrix_new(X.rows, 2)
    let raw_scores: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        raw_scores[i] = model.init_value
    }

    let row: ptr<f32> = array_new_f32(X.cols)
    for t in 0 to model.n_trees {
        for i in 0 to X.rows {
            matrix_row(X, i, row)
            raw_scores[i] = raw_scores[i] + model.learning_rate * decision_tree_regressor_predict_one(model.trees[t], row)
        }
    }
    array_free_f32(row)

    for i in 0 to X.rows {
        let p: f32 = _gb_sigmoid(raw_scores[i])
        matrix_set(probs, i, 0, 1.0 - p)
        matrix_set(probs, i, 1, p)
    }

    array_free_f32(raw_scores)
    return probs
}

export function gradient_boosting_classifier_free(model: GradientBoostingClassifier) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    array_free_f32(model.classes)
}

# Feature importances for GradientBoostingClassifier.
# Addresses sklearn #34472.
export function gradient_boosting_classifier_feature_importances(model: GradientBoostingClassifier, n_features: i32) -> ptr<f32> {
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    for t in 0 to model.n_trees {
        let tree_imp: ptr<f32> = decision_tree_regressor_feature_importances(model.trees[t], n_features)
        for f in 0 to n_features {
            importances[f] = importances[f] + tree_imp[f]
        }
        array_free_f32(tree_imp)
    }
    if model.n_trees > 0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / (model.n_trees as f32)
        }
    }
    return importances
}

# ============================================================================
# GradientBoostingRegressor
# ============================================================================

export struct GradientBoostingRegressor {
    trees: ptr<DecisionTreeRegressor>,
    n_trees: i32,
    init_value: f32,
    learning_rate: f32,
    max_depth: i32,
    fitted: bool
}

export function gradient_boosting_regressor_fit(X: Matrix, y: ptr<f32>, n_trees: i32, learning_rate: f32, max_depth: i32) -> GradientBoostingRegressor {
    let init_value: f32 = array_mean(y, X.rows)

    let current_pred: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        current_pred[i] = init_value
    }

    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>

    for t in 0 to n_trees {
        let residuals: ptr<f32> = array_new_f32(X.rows)
        for i in 0 to X.rows {
            residuals[i] = y[i] - current_pred[i]
        }

        trees[t] = decision_tree_regressor_fit(X, residuals, max_depth, CRITERION_MSE)

        let tree_preds: ptr<f32> = decision_tree_regressor_predict(trees[t], X)
        for i in 0 to X.rows {
            current_pred[i] = current_pred[i] + learning_rate * tree_preds[i]
        }

        array_free_f32(residuals)
        array_free_f32(tree_preds)
    }

    array_free_f32(current_pred)

    return GradientBoostingRegressor {
        trees: trees,
        n_trees: n_trees,
        init_value: init_value,
        learning_rate: learning_rate,
        max_depth: max_depth,
        fitted: true
    }
}

export function gradient_boosting_regressor_predict(model: GradientBoostingRegressor, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        preds[i] = model.init_value
    }

    let row: ptr<f32> = array_new_f32(X.cols)
    for t in 0 to model.n_trees {
        for i in 0 to X.rows {
            matrix_row(X, i, row)
            preds[i] = preds[i] + model.learning_rate * decision_tree_regressor_predict_one(model.trees[t], row)
        }
    }
    array_free_f32(row)

    return preds
}

export function gradient_boosting_regressor_free(model: GradientBoostingRegressor) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
}

# Feature importances for GradientBoostingRegressor.
# Addresses sklearn #34472.
export function gradient_boosting_regressor_feature_importances(model: GradientBoostingRegressor, n_features: i32) -> ptr<f32> {
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    for t in 0 to model.n_trees {
        let tree_imp: ptr<f32> = decision_tree_regressor_feature_importances(model.trees[t], n_features)
        for f in 0 to n_features {
            importances[f] = importances[f] + tree_imp[f]
        }
        array_free_f32(tree_imp)
    }
    if model.n_trees > 0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / (model.n_trees as f32)
        }
    }
    return importances
}

# ============================================================================
# AdaBoostClassifier
# ============================================================================

export struct AdaBoostClassifier {
    trees: ptr<DecisionTreeClassifier>,
    alphas: ptr<f32>,
    n_trees: i32,
    classes: ptr<f32>,
    n_classes: i32,
    fitted: bool
}

export function adaboost_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_trees: i32, max_depth: i32, seed: i32) -> AdaBoostClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let trees: ptr<DecisionTreeClassifier> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeClassifier>
    let alphas: ptr<f32> = array_new_f32(n_trees)

    let weights: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        weights[i] = 1.0 / (X.rows as f32)
    }

    srand(seed)

    for t in 0 to n_trees {
        let n_samples: i32 = X.rows
        let sample_indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>

        let mut cum: f32 = 0.0
        for i in 0 to n_samples {
            cum = cum + weights[i]
        }

        for i in 0 to n_samples {
            let r: f32 = (rand() as f32) / 2147483647.0 * cum
            let mut acc: f32 = 0.0
            let mut idx: i32 = n_samples - 1
            for j in 0 to n_samples {
                acc = acc + weights[j]
                if acc >= r {
                    idx = j
                    break
                }
            }
            sample_indices[i] = idx
        }

        let X_boot: Matrix = matrix_new(n_samples, X.cols)
        let y_boot: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            y_boot[i] = y[sample_indices[i]]
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, sample_indices[i], j))
            }
        }

        trees[t] = decision_tree_classifier_fit(X_boot, y_boot, n_classes, max_depth, CRITERION_GINI)

        let preds: ptr<f32> = decision_tree_classifier_predict(trees[t], X)

        let mut err: f32 = 0.0
        for i in 0 to X.rows {
            if preds[i] != y[i] {
                err = err + weights[i]
            }
        }

        if err > 0.5 {
            alphas[t] = 0.0
        } else {
            err = err + 0.0000000001
            alphas[t] = 0.5 * log(((1.0 - err) / err) as f64) as f32
        }

        let mut total_w: f32 = 0.0
        for i in 0 to X.rows {
            let y_sign: f32 = -1.0
            if preds[i] == y[i] {
                y_sign = 1.0
            }
            weights[i] = weights[i] * exp((0.0 - alphas[t] * y_sign) as f64) as f32
            total_w = total_w + weights[i]
        }

        for i in 0 to X.rows {
            weights[i] = weights[i] / total_w
        }

        free(sample_indices as ptr<void>)
        matrix_free(X_boot)
        array_free_f32(y_boot)
        array_free_f32(preds)
    }

    array_free_f32(weights)

    return AdaBoostClassifier {
        trees: trees,
        alphas: alphas,
        n_trees: n_trees,
        classes: classes,
        n_classes: n_classes,
        fitted: true
    }
}

export function adaboost_classifier_predict(model: AdaBoostClassifier, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)

    for i in 0 to X.rows {
        matrix_row(X, i, row)

        let class_scores: ptr<f32> = array_new_f32(model.n_classes)
        for c in 0 to model.n_classes {
            class_scores[c] = 0.0
        }

        for t in 0 to model.n_trees {
            let pred: f32 = decision_tree_classifier_predict_one(model.trees[t], row)
            for c in 0 to model.n_classes {
                if model.classes[c] == pred {
                    class_scores[c] = class_scores[c] + model.alphas[t]
                }
            }
        }

        let mut best_c: i32 = 0
        let mut best_score: f32 = class_scores[0]
        for c in 1 to model.n_classes {
            if class_scores[c] > best_score {
                best_score = class_scores[c]
                best_c = c
            }
        }

        preds[i] = model.classes[best_c]
        free(class_scores as ptr<void>)
    }

    array_free_f32(row)
    return preds
}

export function adaboost_classifier_free(model: AdaBoostClassifier) -> void {
    for t in 0 to model.n_trees {
        decision_tree_classifier_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    array_free_f32(model.alphas)
    array_free_f32(model.classes)
}

# Feature importances for AdaBoostClassifier: weighted average of per-tree
# importances, weighted by estimator weights (alphas).
# Addresses sklearn #34472: feature_importances_ with proper not-fitted check.
export function adaboost_classifier_feature_importances(model: AdaBoostClassifier, n_features: i32) -> ptr<f32> {
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    let mut total_weight: f32 = 0.0
    for t in 0 to model.n_trees {
        let tree_imp: ptr<f32> = decision_tree_classifier_feature_importances(model.trees[t], n_features)
        let w: f32 = model.alphas[t]
        total_weight = total_weight + w
        for f in 0 to n_features {
            importances[f] = importances[f] + w * tree_imp[f]
        }
        array_free_f32(tree_imp)
    }
    if total_weight > 0.0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / total_weight
        }
    }
    return importances
}

# ============================================================================
# AdaBoostRegressor (AdaBoost.R2 algorithm)
# ============================================================================

export struct AdaBoostRegressor {
    trees: ptr<DecisionTreeRegressor>,
    alphas: ptr<f32>,
    n_trees: i32,
    fitted: bool
}

export function adaboost_regressor_fit(X: Matrix, y: ptr<f32>, n_trees: i32, max_depth: i32, seed: i32) -> AdaBoostRegressor {
    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>
    let alphas: ptr<f32> = array_new_f32(n_trees)

    let weights: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        weights[i] = 1.0 / (X.rows as f32)
    }

    srand(seed)

    for t in 0 to n_trees {
        let n_samples: i32 = X.rows
        let sample_indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>

        let mut cum: f32 = 0.0
        for i in 0 to n_samples {
            cum = cum + weights[i]
        }

        for i in 0 to n_samples {
            let r: f32 = (rand() as f32) / 2147483647.0 * cum
            let mut acc: f32 = 0.0
            let mut idx: i32 = n_samples - 1
            for j in 0 to n_samples {
                acc = acc + weights[j]
                if acc >= r {
                    idx = j
                    break
                }
            }
            sample_indices[i] = idx
        }

        let X_boot: Matrix = matrix_new(n_samples, X.cols)
        let y_boot: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            y_boot[i] = y[sample_indices[i]]
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, sample_indices[i], j))
            }
        }

        trees[t] = decision_tree_regressor_fit(X_boot, y_boot, max_depth, CRITERION_MSE)

        let preds: ptr<f32> = decision_tree_regressor_predict(trees[t], X)

        # AdaBoost.R2: compute relative errors
        let mut max_err: f32 = 0.0
        for i in 0 to X.rows {
            let abs_err: f32 = fabs((y[i] - preds[i]) as f64) as f32
            if abs_err > max_err {
                max_err = abs_err
            }
        }

        if max_err < 0.0000000001 {
            alphas[t] = 1.0
            free(sample_indices as ptr<void>)
            matrix_free(X_boot)
            array_free_f32(y_boot)
            array_free_f32(preds)
            continue
        }

        let mut err: f32 = 0.0
        for i in 0 to X.rows {
            let rel_err: f32 = fabs((y[i] - preds[i]) as f64) as f32 / max_err
            err = err + weights[i] * rel_err
        }

        # Estimator weight (AdaBoost.R2, linear loss):
        # beta = err / (1 - err), alpha = log(1/beta)
        let mut beta: f32 = 0.0
        if err >= 0.99 {
            alphas[t] = 0.0
            beta = 10000000000.0
        } else {
            beta = err / (1.0 - err)
            if beta < 0.0000000001 { beta = 0.0000000001 }
            alphas[t] = log((1.0 / beta) as f64) as f32
        }

        # Update weights: w_i *= beta^rel_err_i
        let mut total_w: f32 = 0.0
        for i in 0 to X.rows {
            let rel_err: f32 = fabs((y[i] - preds[i]) as f64) as f32 / max_err
            weights[i] = weights[i] * pow(beta as f64, rel_err as f64) as f32
            total_w = total_w + weights[i]
        }

        for i in 0 to X.rows {
            weights[i] = weights[i] / total_w
        }

        free(sample_indices as ptr<void>)
        matrix_free(X_boot)
        array_free_f32(y_boot)
        array_free_f32(preds)
    }

    array_free_f32(weights)

    return AdaBoostRegressor {
        trees: trees,
        alphas: alphas,
        n_trees: n_trees,
        fitted: true
    }
}

export function adaboost_regressor_predict(model: AdaBoostRegressor, X: Matrix) -> ptr<f32> {
    # Weighted median prediction (sorted by prediction, accumulate weights)
    let preds: ptr<f32> = array_new_f32(X.rows)
    let tree_preds: ptr<ptr<f32> > = malloc((model.n_trees as i64) * 8) as ptr<ptr<f32> >

    for t in 0 to model.n_trees {
        tree_preds[t] = decision_tree_regressor_predict(model.trees[t], X)
    }

    for i in 0 to X.rows {
        # Collect (prediction, weight) pairs and sort by prediction
        let sorted_preds: ptr<f32> = array_new_f32(model.n_trees)
        let sorted_weights: ptr<f32> = array_new_f32(model.n_trees)
        let order: ptr<i32> = malloc((model.n_trees as i64) * 4) as ptr<i32>
        for t in 0 to model.n_trees {
            order[t] = t
        }

        # Simple insertion sort by prediction value
        for t in 1 to model.n_trees {
            let key: i32 = order[t]
            let key_val: f32 = tree_preds[key][i]
            let mut j: i32 = t - 1
            while j >= 0 && tree_preds[order[j]][i] > key_val {
                order[j + 1] = order[j]
                j = j - 1
            }
            order[j + 1] = key
        }

        for t in 0 to model.n_trees {
            sorted_preds[t] = tree_preds[order[t]][i]
            sorted_weights[t] = model.alphas[order[t]]
        }

        # Weighted median: find where cumulative weight crosses 0.5
        let mut total_w: f32 = 0.0
        for t in 0 to model.n_trees {
            total_w = total_w + sorted_weights[t]
        }

        let mut cum_w: f32 = 0.0
        let mut median_idx: i32 = model.n_trees - 1
        if total_w > 0.0 {
            for t in 0 to model.n_trees {
                cum_w = cum_w + sorted_weights[t] / total_w
                if cum_w >= 0.5 {
                    median_idx = t
                    break
                }
            }
        }

        preds[i] = sorted_preds[median_idx]

        array_free_f32(sorted_preds)
        array_free_f32(sorted_weights)
        free(order as ptr<void>)
    }

    for t in 0 to model.n_trees {
        array_free_f32(tree_preds[t])
    }
    free(tree_preds as ptr<void>)

    return preds
}

export function adaboost_regressor_free(model: AdaBoostRegressor) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    array_free_f32(model.alphas)
}

# Feature importances for AdaBoostRegressor: weighted average of per-tree
# importances, weighted by estimator weights (alphas).
# Addresses sklearn #34472.
export function adaboost_regressor_feature_importances(model: AdaBoostRegressor, n_features: i32) -> ptr<f32> {
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    let mut total_weight: f32 = 0.0
    for t in 0 to model.n_trees {
        let tree_imp: ptr<f32> = decision_tree_regressor_feature_importances(model.trees[t], n_features)
        let w: f32 = model.alphas[t]
        total_weight = total_weight + w
        for f in 0 to n_features {
            importances[f] = importances[f] + w * tree_imp[f]
        }
        array_free_f32(tree_imp)
    }
    if total_weight > 0.0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / total_weight
        }
    }
    return importances
}

# ============================================================================
# ExtraTreesClassifier / ExtraTreesRegressor
# ============================================================================

export struct ExtraTreesClassifier {
    trees: ptr<DecisionTreeClassifier>,
    n_trees: i32,
    n_classes: i32,
    classes: ptr<f32>,
    max_depth: i32,
    n_features_per_split: i32,
    fitted: bool
}

export function extra_trees_classifier_fit(
    X: Matrix, y: ptr<f32>, n_classes: i32,
    n_trees: i32, max_depth: i32, seed: i32
) -> ExtraTreesClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] { found = true; break }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let trees: ptr<DecisionTreeClassifier> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeClassifier>
    let n_features: i32 = X.cols
    let n_features_per_split: i32 = 1
    if n_features > 1 {
        n_features_per_split = 2
    }

    srand(seed)

    for t in 0 to n_trees {
        let bootstrap_n: i32 = X.rows
        let X_boot: Matrix = matrix_new(bootstrap_n, X.cols)
        let y_boot: ptr<f32> = array_new_f32(bootstrap_n)

        for i in 0 to bootstrap_n {
            let idx: i32 = rand() % X.rows
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, idx, j))
            }
            y_boot[i] = y[idx]
        }

        trees[t] = decision_tree_classifier_fit(X_boot, y_boot, n_classes, max_depth, CRITERION_GINI)

        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    return ExtraTreesClassifier {
        trees: trees, n_trees: n_trees,
        n_classes: n_classes, classes: classes,
        max_depth: max_depth,
        n_features_per_split: n_features_per_split,
        fitted: true
    }
}

export function extra_trees_classifier_predict(model: ExtraTreesClassifier, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let vote_counts: ptr<ptr<i32> > = malloc((n as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n {
        vote_counts[i] = malloc((model.n_classes as i64) * 4) as ptr<i32>
        for c in 0 to model.n_classes {
            vote_counts[i][c] = 0
        }
    }

    for t in 0 to model.n_trees {
        let preds: ptr<f32> = decision_tree_classifier_predict(model.trees[t], X)
        for i in 0 to n {
            for c in 0 to model.n_classes {
                if preds[i] == model.classes[c] {
                    vote_counts[i][c] = vote_counts[i][c] + 1
                    break
                }
            }
        }
        array_free_f32(preds)
    }

    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_count: i32 = 0
        for c in 0 to model.n_classes {
            if vote_counts[i][c] > best_count {
                best_count = vote_counts[i][c]
                best_c = c
            }
        }
        result[i] = model.classes[best_c]
    }

    for i in 0 to n {
        free(vote_counts[i] as ptr<void>)
    }
    free(vote_counts as ptr<void>)

    return result
}

export function extra_trees_classifier_free(model: ExtraTreesClassifier) -> void {
    for t in 0 to model.n_trees {
        decision_tree_classifier_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    array_free_f32(model.classes)
}

export struct ExtraTreesRegressor {
    trees: ptr<DecisionTreeRegressor>,
    n_trees: i32,
    max_depth: i32,
    fitted: bool
}

export function extra_trees_regressor_fit(
    X: Matrix, y: ptr<f32>,
    n_trees: i32, max_depth: i32, seed: i32
) -> ExtraTreesRegressor {
    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>

    srand(seed)

    for t in 0 to n_trees {
        let bootstrap_n: i32 = X.rows
        let X_boot: Matrix = matrix_new(bootstrap_n, X.cols)
        let y_boot: ptr<f32> = array_new_f32(bootstrap_n)

        for i in 0 to bootstrap_n {
            let idx: i32 = rand() % X.rows
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, idx, j))
            }
            y_boot[i] = y[idx]
        }

        trees[t] = decision_tree_regressor_fit(X_boot, y_boot, max_depth, CRITERION_MSE)

        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    return ExtraTreesRegressor {
        trees: trees, n_trees: n_trees,
        max_depth: max_depth, fitted: true
    }
}

export function extra_trees_regressor_predict(model: ExtraTreesRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for t in 0 to model.n_trees {
        let preds: ptr<f32> = decision_tree_regressor_predict(model.trees[t], X)
        for i in 0 to n {
            result[i] = result[i] + preds[i] / (model.n_trees as f32)
        }
        array_free_f32(preds)
    }

    return result
}

export function extra_trees_regressor_free(model: ExtraTreesRegressor) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
}

# ============================================================================
# IsolationForest
# ============================================================================

export struct IsolationForest {
    trees: ptr<DecisionTreeRegressor>,
    n_trees: i32,
    n_features: i32,
    n_samples: i32,
    max_depth: i32,
    threshold: f32,
    fitted: bool
}

export function isolation_forest_fit(X: Matrix, n_trees: i32, max_depth: i32, seed: i32) -> IsolationForest {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let sub_size: i32 = 256
    if sub_size > n { sub_size = n }

    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>
    srand(seed)

    for t in 0 to n_trees {
        let sub_X: Matrix = matrix_new(sub_size, p)
        for i in 0 to sub_size {
            let idx: i32 = rand() % n
            for j in 0 to p {
                matrix_set(sub_X, i, j, matrix_at(X, idx, j))
            }
        }
        let y_sub: ptr<f32> = array_new_f32(sub_size)
        for i in 0 to sub_size { y_sub[i] = 0.0 }
        trees[t] = decision_tree_regressor_fit(sub_X, y_sub, max_depth, CRITERION_MSE)
        array_free_f32(y_sub)
        matrix_free(sub_X)
    }

    let mut depths: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let row: ptr<f32> = array_new_f32(p)
        for j in 0 to p { row[j] = matrix_at(X, i, j) }
        let mut avg_depth: f32 = 0.0
        for t in 0 to n_trees {
            avg_depth = avg_depth + decision_tree_regressor_predict_one(trees[t], row)
        }
        depths[i] = avg_depth / (n_trees as f32)
        array_free_f32(row)
    }

    let mut mean_depth: f32 = 0.0
    for i in 0 to n { mean_depth = mean_depth + depths[i] }
    mean_depth = mean_depth / (n as f32)

    let mut std_depth: f32 = 0.0
    for i in 0 to n {
        let d: f32 = depths[i] - mean_depth
        std_depth = std_depth + d * d
    }
    std_depth = sqrt((std_depth / (n as f32)) as f64) as f32
    let threshold: f32 = mean_depth - 2.0 * std_depth

    array_free_f32(depths)

    return IsolationForest {
        trees: trees,
        n_trees: n_trees,
        n_features: p,
        n_samples: n,
        max_depth: max_depth,
        threshold: threshold,
        fitted: true
    }
}

export function isolation_forest_predict(model: IsolationForest, X: Matrix) -> ptr<i32> {
    let n: i32 = X.rows
    let result: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let row: ptr<f32> = array_new_f32(model.n_features)

    for i in 0 to n {
        for j in 0 to model.n_features { row[j] = matrix_at(X, i, j) }
        let mut avg_depth: f32 = 0.0
        for t in 0 to model.n_trees {
            avg_depth = avg_depth + decision_tree_regressor_predict_one(model.trees[t], row)
        }
        avg_depth = avg_depth / (model.n_trees as f32)
        if avg_depth < model.threshold {
            result[i] = -1
        } else {
            result[i] = 1
        }
    }

    array_free_f32(row)
    return result
}

export function isolation_forest_free(model: IsolationForest) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
}

# ============================================================================
# Stacking
# ============================================================================

export struct StackingClassifier {
    base_preds: ptr<ptr<f32> >,
    n_base: i32,
    n_classes: i32,
    classes: ptr<f32>,
    meta_weights: ptr<ptr<f32> >,
    meta_bias: ptr<f32>,
    n_features: i32,
    fitted: bool
}

export function stacking_classifier_fit(
    base_preds: ptr<ptr<f32> >,
    y: ptr<f32>,
    n_samples: i32,
    n_base: i32,
    n_classes: i32,
    lr: f32,
    n_iter: i32
) -> StackingClassifier {
    let meta_weights: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let meta_bias: ptr<f32> = array_new_f32(n_classes)

    for c in 0 to n_classes {
        meta_weights[c] = array_new_f32(n_base)
        for j in 0 to n_base {
            meta_weights[c][j] = 0.0
        }
        meta_bias[c] = 0.0
    }

    for iter in 0 to n_iter {
        for i in 0 to n_samples {
            for c in 0 to n_classes {
                let mut z: f32 = meta_bias[c]
                for j in 0 to n_base {
                    z = z + meta_weights[c][j] * base_preds[i][j]
                }
                let target: f32 = 0.0
                if y[i] as i32 == c { target = 1.0 }
                let sigmoid_val: f32 = 1.0 / (1.0 + exp((-z) as f64) as f32)
                let error: f32 = target - sigmoid_val
                for j in 0 to n_base {
                    meta_weights[c][j] = meta_weights[c][j] + lr * error * base_preds[i][j]
                }
                meta_bias[c] = meta_bias[c] + lr * error
            }
        }
    }

    let classes: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes { classes[c] = c as f32 }

    return StackingClassifier {
        base_preds: base_preds,
        n_base: n_base,
        n_classes: n_classes,
        classes: classes,
        meta_weights: meta_weights,
        meta_bias: meta_bias,
        n_features: n_base,
        fitted: true
    }
}

export function stacking_classifier_predict(model: StackingClassifier, base_preds: ptr<ptr<f32> >, n_samples: i32) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        let mut best_c: i32 = 0
        let mut best_val: f32 = -9999999999.0
        for c in 0 to model.n_classes {
            let mut z: f32 = model.meta_bias[c]
            for j in 0 to model.n_base {
                z = z + model.meta_weights[c][j] * base_preds[i][j]
            }
            if z > best_val {
                best_val = z
                best_c = c
            }
        }
        result[i] = best_c as f32
    }
    return result
}

export function stacking_classifier_free(model: StackingClassifier) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.meta_weights[c])
    }
    free(model.meta_weights as ptr<void>)
    array_free_f32(model.meta_bias)
    array_free_f32(model.classes)
}

# ============================================================================
# HistGradientBoosting with proper histogram binning and histogram-based splits.
# Bins features into at most 256 bins, builds gradient/hessian histograms,
# and finds splits by scanning histogram bins instead of all samples.
# ============================================================================

# Histogram tree node: stores split feature, threshold, or leaf value
export struct HistNode {
    feature: i32,
    threshold: f32,
    left: i32,
    right: i32,
    value: f32,
    is_leaf: bool
}

# Histogram tree: array of nodes
export struct HistTree {
    nodes: ptr<HistNode>,
    n_nodes: i32,
    max_nodes: i32
}

# Binned data: each value is an integer bin index (0 to n_bins-1)
# Stored as a Matrix where data is interpreted as i32
export struct BinnedData {
    data: ptr<i32>,
    n_samples: i32,
    n_features: i32,
    # Per-feature bin boundaries: thresholds[f][b] is the upper bound of bin b
    thresholds: ptr<ptr<f32> >,
    n_bins: ptr<i32>,
    max_bins: i32
}

# Helper: compute quantile-based bin boundaries for one feature
function _compute_bin_thresholds(values: ptr<f32>, n: i32, max_bins: i32) -> ptr<f32> {
    # Sort values (simple insertion sort for small n)
    let sorted: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        sorted[i] = values[i]
        i = i + 1
    }
    let mut i2: i32 = 1
    while i2 < n {
        let key: f32 = sorted[i2]
        let mut j: i32 = i2 - 1
        while j >= 0 && sorted[j] > key {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
        i2 = i2 + 1
    }

    # Create bin boundaries at quantile positions
    let n_thresholds: i32 = max_bins - 1
    if n_thresholds > n - 1 { n_thresholds = n - 1 }
    if n_thresholds < 1 { n_thresholds = 1 }

    let thresholds: ptr<f32> = array_new_f32(max_bins)
    let mut k: i32 = 0
    while k < n_thresholds {
        # Quantile position
        let pos: f32 = (k + 1) as f32 / (n_thresholds + 1) as f32
        let idx: i32 = (pos * (n as f32)) as i32
        if idx >= n { idx = n - 1 }
        if idx < 0 { idx = 0 }
        thresholds[k] = sorted[idx]
        k = k + 1
    }
    # Fill remaining with last value
    while k < max_bins {
        thresholds[k] = sorted[n - 1]
        k = k + 1
    }

    array_free_f32(sorted)
    return thresholds
}

# Helper: assign a value to a bin using the thresholds
function _bin_value(val: f32, thresholds: ptr<f32>, n_thresholds: i32) -> i32 {
    let mut b: i32 = 0
    while b < n_thresholds {
        if val <= thresholds[b] { return b }
        b = b + 1
    }
    return n_thresholds
}

# Bin all features of X
function _bin_features(X: Matrix, max_bins: i32) -> BinnedData {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let binned: ptr<i32> = malloc((n as i64) * (p as i64) * 4) as ptr<i32>
    let thresholds: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    let n_bins: ptr<i32> = malloc((p as i64) * 4) as ptr<i32>

    let mut f: i32 = 0
    while f < p {
        # Extract column
        let col_vals: ptr<f32> = array_new_f32(n)
        let mut i: i32 = 0
        while i < n {
            col_vals[i] = matrix_at(X, i, f)
            i = i + 1
        }

        thresholds[f] = _compute_bin_thresholds(col_vals, n, max_bins)
        n_bins[f] = max_bins

        # Bin each value
        i = 0
        while i < n {
            binned[i * p + f] = _bin_value(matrix_at(X, i, f), thresholds[f], max_bins - 1)
            i = i + 1
        }

        array_free_f32(col_vals)
        f = f + 1
    }

    return BinnedData {
        data: binned,
        n_samples: n,
        n_features: p,
        thresholds: thresholds,
        n_bins: n_bins,
        max_bins: max_bins
    }
}

# Free binned data
function _binned_free(bd: BinnedData) -> void {
    let mut f: i32 = 0
    while f < bd.n_features {
        array_free_f32(bd.thresholds[f])
        f = f + 1
    }
    free(bd.thresholds as ptr<void>)
    free(bd.n_bins as ptr<void>)
    free(bd.data as ptr<void>)
}

# Helper: create a new hist tree
function _hist_tree_new(max_nodes: i32) -> HistTree {
    let nodes: ptr<HistNode> = malloc((max_nodes as i64) * 24) as ptr<HistNode>
    return HistTree { nodes: nodes, n_nodes: 0, max_nodes: max_nodes }
}

# Helper: add a leaf node
function _hist_tree_add_leaf(tree: HistTree, value: f32) -> i32 {
    let idx: i32 = tree.n_nodes
    tree.nodes[idx].feature = -1
    tree.nodes[idx].threshold = 0.0
    tree.nodes[idx].left = -1
    tree.nodes[idx].right = -1
    tree.nodes[idx].value = value
    tree.nodes[idx].is_leaf = true
    tree.n_nodes = tree.n_nodes + 1
    return idx
}

# Helper: add a leaf node using shared node counter
function _hist_tree_add_leaf_ptr(tree: HistTree, value: f32, node_count: ptr<i32>) -> i32 {
    let idx: i32 = node_count[0]
    tree.nodes[idx].feature = -1
    tree.nodes[idx].threshold = 0.0
    tree.nodes[idx].left = -1
    tree.nodes[idx].right = -1
    tree.nodes[idx].value = value
    tree.nodes[idx].is_leaf = true
    node_count[0] = node_count[0] + 1
    return idx
}

# Helper: add a split node
function _hist_tree_add_split(tree: HistTree, feature: i32, threshold: f32, left: i32, right: i32) -> i32 {
    let idx: i32 = tree.n_nodes
    tree.nodes[idx].feature = feature
    tree.nodes[idx].threshold = threshold
    tree.nodes[idx].left = left
    tree.nodes[idx].right = right
    tree.nodes[idx].value = 0.0
    tree.nodes[idx].is_leaf = false
    tree.n_nodes = tree.n_nodes + 1
    return idx
}

# Helper: build histogram for one feature at one node
# Returns arrays of gradient sum and hessian sum per bin
struct HistPair {
    hist_g: ptr<f32>,
    hist_h: ptr<f32>
}

function _build_hist(
    bd: BinnedData, gradients: ptr<f32>, hessians: ptr<f32>,
    sample_idx: ptr<i32>, n_samples: i32, feature: i32,
    n_bins: i32
) -> HistPair {
    let hist_g: ptr<f32> = array_new_f32(n_bins)
    let hist_h: ptr<f32> = array_new_f32(n_bins)
    let mut i: i32 = 0
    while i < n_samples {
        let sidx: i32 = sample_idx[i]
        let bin_val: i32 = bd.data[sidx * bd.n_features + feature]
        hist_g[bin_val] = hist_g[bin_val] + gradients[sidx]
        hist_h[bin_val] = hist_h[bin_val] + hessians[sidx]
        i = i + 1
    }
    return HistPair { hist_g: hist_g, hist_h: hist_h }
}

# Helper: find best split across all features using histograms
# Returns: best_feature, best_bin, best_gain (-1 if no split found)
struct SplitResult {
    feature: i32,
    bin: i32,
    gain: f32
}

function _find_best_hist_split(
    bd: BinnedData, gradients: ptr<f32>, hessians: ptr<f32>,
    sample_idx: ptr<i32>, n_samples: i32, n_bins: i32,
    lam: f32
) -> SplitResult {
    let mut best_feature: i32 = -1
    let mut best_bin: i32 = -1
    let mut best_gain: f32 = 0.0

    # Total G and H
    let mut total_g: f32 = 0.0
    let mut total_h: f32 = 0.0
    let mut i: i32 = 0
    while i < n_samples {
        let sidx: i32 = sample_idx[i]
        total_g = total_g + gradients[sidx]
        total_h = total_h + hessians[sidx]
        i = i + 1
    }

    let parent_score: f32 = (total_g * total_g) / (total_h + lam)

    let mut f: i32 = 0
    while f < bd.n_features {
        let result: HistPair = _build_hist(bd, gradients, hessians, sample_idx, n_samples, f, n_bins)
        let hist_g: ptr<f32> = result.hist_g
        let hist_h: ptr<f32> = result.hist_h

        # Scan bins to find best split
        let mut cum_g: f32 = 0.0
        let mut cum_h: f32 = 0.0
        let mut b: i32 = 0
        while b < n_bins - 1 {
            cum_g = cum_g + hist_g[b]
            cum_h = cum_h + hist_h[b]
            let right_g: f32 = total_g - cum_g
            let right_h: f32 = total_h - cum_h

            if cum_h > 0.0000000001 and right_h > 0.0000000001 {
                let left_score: f32 = (cum_g * cum_g) / (cum_h + lam)
                let right_score: f32 = (right_g * right_g) / (right_h + lam)
                let gain: f32 = left_score + right_score - parent_score
                if gain > best_gain {
                    best_gain = gain
                    best_feature = f
                    best_bin = b
                }
            }
            b = b + 1
        }

        array_free_f32(hist_g)
        array_free_f32(hist_h)
        f = f + 1
    }

    return SplitResult { feature: best_feature, bin: best_bin, gain: best_gain }
}

# Helper: split samples into left and right based on feature and bin
struct SplitSamplesResult {
    n_left: i32,
    n_right: i32
}

function _split_samples(
    bd: BinnedData, sample_idx: ptr<i32>, n_samples: i32,
    feature: i32, bin_threshold: i32,
    left_idx: ptr<i32>, right_idx: ptr<i32>
) -> SplitSamplesResult {
    let mut n_left: i32 = 0
    let mut n_right: i32 = 0
    let mut i: i32 = 0
    while i < n_samples {
        let sidx: i32 = sample_idx[i]
        let bin_val: i32 = bd.data[sidx * bd.n_features + feature]
        if bin_val <= bin_threshold {
            left_idx[n_left] = sidx
            n_left = n_left + 1
        } else {
            right_idx[n_right] = sidx
            n_right = n_right + 1
        }
        i = i + 1
    }
    return SplitSamplesResult { n_left: n_left, n_right: n_right }
}

# Helper: compute leaf value (negative gradient / hessian sum)
function _compute_leaf_value(gradients: ptr<f32>, hessians: ptr<f32>, sample_idx: ptr<i32>, n_samples: i32, lam: f32) -> f32 {
    let mut g_sum: f32 = 0.0
    let mut h_sum: f32 = 0.0
    let mut i: i32 = 0
    while i < n_samples {
        g_sum = g_sum + gradients[sample_idx[i]]
        h_sum = h_sum + hessians[sample_idx[i]]
        i = i + 1
    }
    return -g_sum / (h_sum + lam)
}

# Build a histogram tree recursively
function _build_hist_tree(
    bd: BinnedData, gradients: ptr<f32>, hessians: ptr<f32>,
    sample_idx: ptr<i32>, n_samples: i32, depth: i32, max_depth: i32,
    n_bins: i32, lam: f32, min_samples_leaf: i32
) -> HistTree {
    let max_nodes: i32 = 1
    let mut d: i32 = 0
    while d < max_depth {
        max_nodes = max_nodes * 2 + 1
        d = d + 1
    }
    let tree: HistTree = _hist_tree_new(max_nodes + 1)
    let node_count: ptr<i32> = malloc(4) as ptr<i32>
    node_count[0] = 0
    _hist_tree_build_recursive(bd, gradients, hessians, sample_idx, n_samples, depth, max_depth, n_bins, lam, min_samples_leaf, tree, node_count)
    tree.n_nodes = node_count[0]
    free(node_count as ptr<void>)
    return tree
}

# Recursive tree builder. Uses node_count pointer for shared state.
function _hist_tree_build_recursive(
    bd: BinnedData, gradients: ptr<f32>, hessians: ptr<f32>,
    sample_idx: ptr<i32>, n_samples: i32, depth: i32, max_depth: i32,
    n_bins: i32, lam: f32, min_samples_leaf: i32, tree: HistTree,
    node_count: ptr<i32>
) -> i32 {
    # Check stopping conditions
    if depth >= max_depth || n_samples < min_samples_leaf * 2 {
        let val: f32 = _compute_leaf_value(gradients, hessians, sample_idx, n_samples, lam)
        return _hist_tree_add_leaf_ptr(tree, val, node_count)
    }

    # Find best split
    let result: SplitResult = _find_best_hist_split(bd, gradients, hessians, sample_idx, n_samples, n_bins, lam)
    let best_feature: i32 = result.feature
    let best_bin: i32 = result.bin
    let best_gain: f32 = result.gain

    if best_feature < 0 || best_gain < 0.0 {
        let val: f32 = _compute_leaf_value(gradients, hessians, sample_idx, n_samples, lam)
        return _hist_tree_add_leaf_ptr(tree, val, node_count)
    }

    # Split samples
    let left_idx: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    let right_idx: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    let split_result: SplitSamplesResult = _split_samples(bd, sample_idx, n_samples, best_feature, best_bin, left_idx, right_idx)
    let n_left: i32 = split_result.n_left
    let n_right: i32 = split_result.n_right

    if n_left < min_samples_leaf || n_right < min_samples_leaf {
        let val: f32 = _compute_leaf_value(gradients, hessians, sample_idx, n_samples, lam)
        free(left_idx as ptr<void>)
        free(right_idx as ptr<void>)
        return _hist_tree_add_leaf_ptr(tree, val, node_count)
    }

    # Get threshold value from bin boundaries
    let threshold: f32 = bd.thresholds[best_feature][best_bin]

    # Reserve this node (split node)
    let node_idx: i32 = node_count[0]
    node_count[0] = node_count[0] + 1

    # Build left and right subtrees
    let left_idx_node: i32 = _hist_tree_build_recursive(bd, gradients, hessians, left_idx, n_left, depth + 1, max_depth, n_bins, lam, min_samples_leaf, tree, node_count)
    let right_idx_node: i32 = _hist_tree_build_recursive(bd, gradients, hessians, right_idx, n_right, depth + 1, max_depth, n_bins, lam, min_samples_leaf, tree, node_count)

    # Fill in the split node
    tree.nodes[node_idx].feature = best_feature
    tree.nodes[node_idx].threshold = threshold
    tree.nodes[node_idx].left = left_idx_node
    tree.nodes[node_idx].right = right_idx_node
    tree.nodes[node_idx].value = 0.0
    tree.nodes[node_idx].is_leaf = false

    free(left_idx as ptr<void>)
    free(right_idx as ptr<void>)
    return node_idx
}

# Predict for a single sample using a hist tree
function _hist_tree_predict_one(tree: HistTree, X: Matrix, i: i32) -> f32 {
    let mut node_idx: i32 = 0
    let mut depth: i32 = 0
    while depth < 100 {
        let node: HistNode = tree.nodes[node_idx]
        if node.is_leaf { return node.value }
        let val: f32 = matrix_at(X, i, node.feature)
        if val <= node.threshold {
            node_idx = node.left
        } else {
            node_idx = node.right
        }
        depth = depth + 1
    }
    return 0.0
}

# Predict for all samples
function _hist_tree_predict(tree: HistTree, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        preds[i] = _hist_tree_predict_one(tree, X, i)
        i = i + 1
    }
    return preds
}

# Free a hist tree
function _hist_tree_free(tree: HistTree) -> void {
    free(tree.nodes as ptr<void>)
}

export struct HistGradientBoostingClassifier {
    init_score: f32,
    trees: ptr<HistTree>,
    n_trees: i32,
    n_classes: i32,
    learning_rate: f32,
    n_features: i32,
    fitted: bool
}

export function hist_gradient_boosting_classifier_fit(
    X: Matrix, y: ptr<f32>,
    n_samples: i32,
    n_classes: i32,
    n_trees: i32,
    learning_rate: f32,
    max_depth: i32
) -> HistGradientBoostingClassifier {
    let mut pos: i32 = 0
    for i in 0 to n_samples {
        if y[i] == 1.0 { pos = pos + 1 }
    }
    let init_score: f32 = log(((pos as f32) / ((n_samples - pos) as f32 + 0.0000000001)) as f64) as f32

    # Bin features
    let bd: BinnedData = _bin_features(X, 256)

    let trees: ptr<HistTree> = malloc((n_trees as i64) * 24) as ptr<HistTree>

    let current_pred: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        current_pred[i] = init_score
    }

    let lam: f32 = 0.0
    let min_samples_leaf: i32 = 1
    if min_samples_leaf < 1 { min_samples_leaf = 1 }

    # Sample indices (all samples initially)
    let sample_idx: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    for i in 0 to n_samples {
        sample_idx[i] = i
    }

    for t in 0 to n_trees {
        # Compute gradients and hessians for logistic loss
        let gradients: ptr<f32> = array_new_f32(n_samples)
        let hessians: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            let p: f32 = 1.0 / (1.0 + exp((-current_pred[i]) as f64) as f32)
            let target: f32 = 0.0
            if y[i] == 1.0 { target = 1.0 }
            gradients[i] = p - target
            hessians[i] = p * (1.0 - p)
        }

        # Build histogram tree
        trees[t] = _build_hist_tree(bd, gradients, hessians, sample_idx, n_samples, 0, max_depth, 256, lam, min_samples_leaf)

        # Update predictions
        let tree_preds: ptr<f32> = _hist_tree_predict(trees[t], X)
        for i in 0 to n_samples {
            current_pred[i] = current_pred[i] + learning_rate * tree_preds[i]
        }

        array_free_f32(gradients)
        array_free_f32(hessians)
        array_free_f32(tree_preds)
    }

    array_free_f32(current_pred)
    free(sample_idx as ptr<void>)
    _binned_free(bd)

    return HistGradientBoostingClassifier {
        init_score: init_score,
        trees: trees,
        n_trees: n_trees,
        n_classes: n_classes,
        learning_rate: learning_rate,
        n_features: X.cols,
        fitted: true
    }
}

export function hist_gradient_boosting_classifier_predict(model: HistGradientBoostingClassifier, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let current_pred: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        current_pred[i] = model.init_score
    }

    for t in 0 to model.n_trees {
        let tree_preds: ptr<f32> = _hist_tree_predict(model.trees[t], X)
        for i in 0 to n {
            current_pred[i] = current_pred[i] + model.learning_rate * tree_preds[i]
        }
        array_free_f32(tree_preds)
    }

    for i in 0 to n {
        let p: f32 = 1.0 / (1.0 + exp((-current_pred[i]) as f64) as f32)
        if p > 0.5 {
            result[i] = 1.0
        } else {
            result[i] = 0.0
        }
    }
    array_free_f32(current_pred)
    return result
}

export function hist_gradient_boosting_classifier_free(model: HistGradientBoostingClassifier) -> void {
    for t in 0 to model.n_trees {
        _hist_tree_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
}

# ============================================================================
# HistGradientBoostingRegressor
# ============================================================================

export struct HistGradientBoostingRegressor {
    init_score: f32,
    trees: ptr<HistTree>,
    n_trees: i32,
    learning_rate: f32,
    n_features: i32,
    fitted: bool
}

export function hist_gradient_boosting_regressor_fit(
    X: Matrix, y: ptr<f32>,
    n_samples: i32,
    n_trees: i32,
    learning_rate: f32,
    max_depth: i32
) -> HistGradientBoostingRegressor {
    # Init score = mean of y
    let mut sum_y: f32 = 0.0
    for i in 0 to n_samples {
        sum_y = sum_y + y[i]
    }
    let init_score: f32 = sum_y / (n_samples as f32)

    # Bin features
    let bd: BinnedData = _bin_features(X, 256)

    let trees: ptr<HistTree> = malloc((n_trees as i64) * 24) as ptr<HistTree>

    let current_pred: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        current_pred[i] = init_score
    }

    let lam: f32 = 0.0
    let min_samples_leaf: i32 = 1
    if min_samples_leaf < 1 { min_samples_leaf = 1 }

    let sample_idx: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    for i in 0 to n_samples {
        sample_idx[i] = i
    }

    for t in 0 to n_trees {
        # Gradients and hessians for squared error: g = pred - y, h = 1
        let gradients: ptr<f32> = array_new_f32(n_samples)
        let hessians: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            gradients[i] = current_pred[i] - y[i]
            hessians[i] = 1.0
        }

        # Build histogram tree
        trees[t] = _build_hist_tree(bd, gradients, hessians, sample_idx, n_samples, 0, max_depth, 256, lam, min_samples_leaf)

        # Update predictions
        let tree_preds: ptr<f32> = _hist_tree_predict(trees[t], X)
        for i in 0 to n_samples {
            current_pred[i] = current_pred[i] + learning_rate * tree_preds[i]
        }

        array_free_f32(gradients)
        array_free_f32(hessians)
        array_free_f32(tree_preds)
    }

    array_free_f32(current_pred)
    free(sample_idx as ptr<void>)
    _binned_free(bd)

    let result: HistGradientBoostingRegressor = HistGradientBoostingRegressor {
        init_score: init_score,
        trees: trees,
        n_trees: n_trees,
        learning_rate: learning_rate,
        n_features: X.cols,
        fitted: true
    }
    return result
}

export function hist_gradient_boosting_regressor_predict(model: HistGradientBoostingRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        result[i] = model.init_score
    }

    for t in 0 to model.n_trees {
        let tree_preds: ptr<f32> = _hist_tree_predict(model.trees[t], X)
        for i in 0 to n {
            result[i] = result[i] + model.learning_rate * tree_preds[i]
        }
        array_free_f32(tree_preds)
    }

    return result
}

export function hist_gradient_boosting_regressor_free(model: HistGradientBoostingRegressor) -> void {
    for t in 0 to model.n_trees {
        _hist_tree_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
}

# ============================================================================
# BaggingRegressor
# ============================================================================

export struct BaggingRegressor {
    trees: ptr<DecisionTreeRegressor>,
    n_estimators: i32,
    n_features: i32,
    fitted: bool
}

export function bagging_regressor_fit(X: Matrix, y: ptr<f32>, n_estimators: i32, max_depth: i32, seed: i32) -> BaggingRegressor {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let trees: ptr<DecisionTreeRegressor> = malloc((n_estimators as i64) * 128) as ptr<DecisionTreeRegressor>
    srand(seed)

    let mut i: i32 = 0
    while i < n_estimators {
        # Bootstrap sample
        let X_boot: Matrix = matrix_new(n, n_features)
        let y_boot: ptr<f32> = array_new_f32(n)
        let mut j: i32 = 0
        while j < n {
            let idx: i32 = rand() % n
            let mut k: i32 = 0
            while k < n_features {
                matrix_set(X_boot, j, k, matrix_at(X, idx, k))
                k = k + 1
            }
            y_boot[j] = y[idx]
            j = j + 1
        }
        trees[i] = decision_tree_regressor_fit(X_boot, y_boot, max_depth, 2)
        matrix_free(X_boot)
        array_free_f32(y_boot)
        i = i + 1
    }

    let result: BaggingRegressor = BaggingRegressor {
        trees: trees,
        n_estimators: n_estimators,
        n_features: n_features,
        fitted: true
    }
    return result
}

# Mean prediction over the bagged trees.
#
# The old loop was row-major over an estimator-major kernel: for every row i it
# called decision_tree_regressor_predict once per tree, and that call predicts
# every row of X, allocates an n-element buffer and a scratch row buffer, then
# the caller read element i and threw the rest away. So a batch of n rows over
# m trees did n * m full passes, n * n * m traversals, and 2 * n * m
# allocations, to produce n * m useful numbers.
#
# Running tree-major instead does each tree once over all rows, keeps that
# tree's node array hot for the whole pass, reads X.data in place instead of
# copying a scratch row, and allocates nothing inside the loop. The work drops
# from O(n^2 * m) traversals to O(n * m).
#
# The accumulation order is unchanged: row i still sums tree 0 through
# tree m-1 in that order before the single divide, so the f32 result is
# bit-identical to the old one. result comes from array_new_f32, which is
# calloc-backed, so the zero it starts from is already there.
export function bagging_regressor_predict(model: BaggingRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let n_cols: i32 = X.cols
    let result: ptr<f32> = array_new_f32(n)
    let xd: ptr<f32> = X.data

    for t in 0 to model.n_estimators {
        let tree: DecisionTreeRegressor = model.trees[t]
        let nodes: ptr<TreeNode> = tree.nodes
        let mut row_base: i32 = 0
        for i in 0 to n {
            let mut node_idx: i32 = 0
            while not nodes[node_idx].is_leaf {
                let node: ptr<TreeNode> = nodes + node_idx
                if xd[row_base + node.feature] <= node.threshold {
                    node_idx = node.left
                } else {
                    node_idx = node.right
                }
            }
            result[i] = result[i] + nodes[node_idx].value
            row_base = row_base + n_cols
        }
    }

    let denom: f32 = model.n_estimators as f32
    for i in 0 to n {
        result[i] = result[i] / denom
    }
    return result
}

export function bagging_regressor_free(model: BaggingRegressor) -> void {
    let mut i: i32 = 0
    while i < model.n_estimators {
        decision_tree_regressor_free(model.trees[i])
        i = i + 1
    }
    free(model.trees as ptr<void>)
}

# ============================================================================
# VotingRegressor
# ============================================================================

export struct VotingRegressor {
    estimators: ptr<DecisionTreeRegressor>,
    n_estimators: i32,
    n_features: i32,
    weights: ptr<f32>,
    fitted: bool
}

export function voting_regressor_fit(estimators: ptr<DecisionTreeRegressor>, n_estimators: i32, weights: ptr<f32>) -> VotingRegressor {
    let result: VotingRegressor = VotingRegressor {
        estimators: estimators,
        n_estimators: n_estimators,
        n_features: 0,
        weights: weights,
        fitted: true
    }
    return result
}

export function voting_regressor_predict(model: VotingRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let row: ptr<f32> = array_new_f32(X.cols)

    let mut total_weight: f32 = 0.0
    let mut t: i32 = 0
    while t < model.n_estimators {
        total_weight = total_weight + model.weights[t]
        t = t + 1
    }
    if total_weight < 0.0000000001 { total_weight = 1.0 }

    let mut i: i32 = 0
    while i < n {
        matrix_row(X, i, row)
        let mut sum: f32 = 0.0
        let mut t2: i32 = 0
        while t2 < model.n_estimators {
            let pred: f32 = decision_tree_regressor_predict_one(model.estimators[t2], row)
            sum = sum + model.weights[t2] * pred
            t2 = t2 + 1
        }
        result[i] = sum / total_weight
        i = i + 1
    }

    array_free_f32(row)
    return result
}

export function voting_regressor_free(model: VotingRegressor) -> void {
    let mut t: i32 = 0
    while t < model.n_estimators {
        decision_tree_regressor_free(model.estimators[t])
        t = t + 1
    }
    free(model.estimators as ptr<void>)
    array_free_f32(model.weights)
}

# ============================================================================
# StackingRegressor
# Trains base regressors, then a meta-learner (ridge regression) on their
# out-of-fold predictions.
# ============================================================================

export struct StackingRegressor {
    base_estimators: ptr<DecisionTreeRegressor>,
    n_base: i32,
    meta_weights: ptr<f32>,
    meta_bias: f32,
    n_features: i32,
    fitted: bool
}

export function stacking_regressor_fit(
    X: Matrix, y: ptr<f32>, n_base: i32, max_depth: i32, seed: i32
) -> StackingRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let base_estimators: ptr<DecisionTreeRegressor> = malloc((n_base as i64) * 128) as ptr<DecisionTreeRegressor>

    srand(seed)

    let mut t: i32 = 0
    while t < n_base {
        let X_boot: Matrix = matrix_new(n, p)
        let y_boot: ptr<f32> = array_new_f32(n)
        let mut i: i32 = 0
        while i < n {
            let idx: i32 = rand() % n
            let mut j: i32 = 0
            while j < p {
                matrix_set(X_boot, i, j, matrix_at(X, idx, j))
                j = j + 1
            }
            y_boot[i] = y[idx]
            i = i + 1
        }
        base_estimators[t] = decision_tree_regressor_fit(X_boot, y_boot, max_depth, CRITERION_MSE)
        matrix_free(X_boot)
        array_free_f32(y_boot)
        t = t + 1
    }

    let meta_X: Matrix = matrix_new(n, n_base)
    let row: ptr<f32> = array_new_f32(p)
    let mut i2: i32 = 0
    while i2 < n {
        matrix_row(X, i2, row)
        let mut t2: i32 = 0
        while t2 < n_base {
            let pred: f32 = decision_tree_regressor_predict_one(base_estimators[t2], row)
            matrix_set(meta_X, i2, t2, pred)
            t2 = t2 + 1
        }
        i2 = i2 + 1
    }
    array_free_f32(row)

    let meta_weights: ptr<f32> = array_new_f32(n_base)
    let mut meta_bias: f32 = 0.0

    let y_mean: f32 = array_mean(y, n)
    let mut t3: i32 = 0
    while t3 < n_base {
        let col: ptr<f32> = array_new_f32(n)
        let mut i3: i32 = 0
        while i3 < n {
            col[i3] = matrix_at(meta_X, i3, t3)
            i3 = i3 + 1
        }
        let col_mean: f32 = array_mean(col, n)
        let mut cov: f32 = 0.0
        let mut var: f32 = 0.0
        let mut i4: i32 = 0
        while i4 < n {
            cov = cov + (col[i4] - col_mean) * (y[i4] - y_mean)
            var = var + (col[i4] - col_mean) * (col[i4] - col_mean)
            i4 = i4 + 1
        }
        if var > 0.0000000001 {
            meta_weights[t3] = cov / var
        } else {
            meta_weights[t3] = 0.0
        }
        array_free_f32(col)
        t3 = t3 + 1
    }

    meta_bias = y_mean
    let mut t4: i32 = 0
    while t4 < n_base {
        let col: ptr<f32> = array_new_f32(n)
        let mut i5: i32 = 0
        while i5 < n {
            col[i5] = matrix_at(meta_X, i5, t4)
            i5 = i5 + 1
        }
        let col_mean: f32 = array_mean(col, n)
        meta_bias = meta_bias - meta_weights[t4] * col_mean
        array_free_f32(col)
        t4 = t4 + 1
    }

    matrix_free(meta_X)

    let result: StackingRegressor = StackingRegressor {
        base_estimators: base_estimators,
        n_base: n_base,
        meta_weights: meta_weights,
        meta_bias: meta_bias,
        n_features: p,
        fitted: true
    }
    return result
}

export function stacking_regressor_predict(model: StackingRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let row: ptr<f32> = array_new_f32(X.cols)

    let mut i: i32 = 0
    while i < n {
        matrix_row(X, i, row)
        let mut pred: f32 = model.meta_bias
        let mut t: i32 = 0
        while t < model.n_base {
            let base_pred: f32 = decision_tree_regressor_predict_one(model.base_estimators[t], row)
            pred = pred + model.meta_weights[t] * base_pred
            t = t + 1
        }
        result[i] = pred
        i = i + 1
    }

    array_free_f32(row)
    return result
}

export function stacking_regressor_free(model: StackingRegressor) -> void {
    let mut t: i32 = 0
    while t < model.n_base {
        decision_tree_regressor_free(model.base_estimators[t])
        t = t + 1
    }
    free(model.base_estimators as ptr<void>)
    array_free_f32(model.meta_weights)
}

# ============================================================================
# RandomTreesEmbedding
# Transforms data using the leaf indices of an ensemble of random trees.
# ============================================================================

export struct RandomTreesEmbedding {
    trees: ptr<DecisionTreeRegressor>,
    n_trees: i32,
    max_depth: i32,
    n_leaves_per_tree: ptr<i32>,
    n_output_features: i32,
    fitted: bool
}

function _count_leaves(nodes: ptr<TreeNode>, node_idx: i32) -> i32 {
    let node: ptr<TreeNode> = nodes + node_idx
    if node.is_leaf { return 1 }
    let mut count: i32 = 0
    count = count + _count_leaves(nodes, node.left)
    count = count + _count_leaves(nodes, node.right)
    return count
}

function _leaf_index(nodes: ptr<TreeNode>, node_idx: i32, x: ptr<f32>, counter: ptr<i32>) -> i32 {
    let node: ptr<TreeNode> = nodes + node_idx
    if node.is_leaf {
        let idx: i32 = counter[0]
        counter[0] = counter[0] + 1
        return idx
    }
    if x[node.feature] <= node.threshold {
        return _leaf_index(nodes, node.left, x, counter)
    }
    return _leaf_index(nodes, node.right, x, counter)
}

export function random_trees_embedding_fit(X: Matrix, n_trees: i32, max_depth: i32, seed: i32) -> RandomTreesEmbedding {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let trees: ptr<DecisionTreeRegressor> = malloc((n_trees as i64) * 128) as ptr<DecisionTreeRegressor>
    let n_leaves_arr: ptr<i32> = malloc((n_trees as i64) * 4) as ptr<i32>

    srand(seed)

    let mut total_leaves: i32 = 0
    for t in 0 to n_trees {
        let X_boot: Matrix = matrix_new(n, p)
        let y_boot: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            let idx: i32 = rand() % n
            for j in 0 to p { matrix_set(X_boot, i, j, matrix_at(X, idx, j)) }
            y_boot[i] = (idx as f32)
        }
        trees[t] = decision_tree_regressor_fit(X_boot, y_boot, max_depth, CRITERION_MSE)
        let n_leaves: i32 = _count_leaves(trees[t].nodes, 0)
        n_leaves_arr[t] = n_leaves
        total_leaves = total_leaves + n_leaves
        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    let result: RandomTreesEmbedding = RandomTreesEmbedding {
        trees: trees, n_trees: n_trees,
        max_depth: max_depth,
        n_leaves_per_tree: n_leaves_arr,
        n_output_features: total_leaves,
        fitted: true
    }
    return result
}

export function random_trees_embedding_transform(model: RandomTreesEmbedding, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let result: Matrix = matrix_new(n, model.n_output_features)

    for i in 0 to n {
        let x: ptr<f32> = array_new_f32(p)
        for j in 0 to p { x[j] = matrix_at(X, i, j) }

        let mut offset: i32 = 0
        for t in 0 to model.n_trees {
            let counter: ptr<i32> = malloc(4) as ptr<i32>
            counter[0] = 0
            let leaf_idx: i32 = _leaf_index(model.trees[t].nodes, 0, x, counter)
            let col: i32 = offset + leaf_idx
            if col < model.n_output_features {
                matrix_set(result, i, col, 1.0)
            }
            offset = offset + model.n_leaves_per_tree[t]
            free(counter as ptr<void>)
        }
        array_free_f32(x)
    }
    return result
}

export function random_trees_embedding_free(model: RandomTreesEmbedding) -> void {
    for t in 0 to model.n_trees {
        decision_tree_regressor_free(model.trees[t])
    }
    free(model.trees as ptr<void>)
    free(model.n_leaves_per_tree as ptr<void>)
}
