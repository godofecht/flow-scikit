# Additional estimators for flow-scikit to close the sklearn parity gap.
# Implements SparseCoder, PolynomialCountSketch, SpectralBiclustering,
# SpectralCoclustering, LassoLarsIC, OrthogonalMatchingPursuitCV,
# NeighborhoodComponentsAnalysis, SGDOneClassSVM.

import "lib/scikit/matrix.flow"
import "lib/scikit/linear.flow"
import "lib/scikit/blas.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function sqrt(x: f64) -> f64
    function fabs(x: f64) -> f64
    function log(x: f64) -> f64
    function exp(x: f64) -> f64
    function rand() -> i32
    function srand(seed: u32) -> void
    function printf(fmt: string, ...) -> i32
}

# ============================================================================
# SparseCoder: finds sparse representation of signals over a fixed dictionary.
# Uses orthogonal matching pursuit (OMP) per sample.
# ============================================================================

export struct SparseCoder {
    dictionary: Matrix,
    n_components: i32,
    n_features: i32,
    transform_n_nonzero_coefs: i32,
    fitted: bool
}

export function sparse_coder_fit(dictionary: Matrix, n_nonzero_coefs: i32) -> SparseCoder {
    return SparseCoder {
        # The free function releases this, so it has to be this model's
        # copy. Aliasing the caller's matrix made a fit and free pair
        # destroy the input, which AddressSanitizer caught as a
        # use-after-free on the second fit of the same data.
        dictionary: matrix_copy(dictionary),
        n_components: dictionary.rows,
        n_features: dictionary.cols,
        transform_n_nonzero_coefs: n_nonzero_coefs,
        fitted: true
    }
}

export function sparse_coder_transform(model: SparseCoder, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let k: i32 = model.n_components
    let p: i32 = model.n_features
    let n_coefs: i32 = model.transform_n_nonzero_coefs
    if n_coefs > k { n_coefs = k }

    let result: Matrix = matrix_new(n, k)
    for i in 0 to n {
        for j in 0 to k { matrix_set(result, i, j, 0.0) }
    }

    for i in 0 to n {
        let residual: ptr<f32> = array_new_f32(p)
        for j in 0 to p { residual[j] = matrix_at(X, i, j) }

        let selected: ptr<i32> = array_new_f32(k) as ptr<i32>
        for j in 0 to k { selected[j] = 0 }

        for step in 0 to n_coefs {
            # Find atom with maximum correlation with residual
            let mut best_idx: i32 = 0
            let mut best_corr: f32 = 0.0
            for j in 0 to k {
                if selected[j] == 1 { continue }
                let mut corr: f32 = 0.0
                for l in 0 to p {
                    corr = corr + matrix_at(model.dictionary, j, l) * residual[l]
                }
                let abs_corr: f32 = corr
                if corr < 0.0 { abs_corr = -corr }
                if abs_corr > best_corr {
                    best_corr = abs_corr
                    best_idx = j
                }
            }

            selected[best_idx] = 1

            # Least squares update: solve for selected coefficients
            # Simplified: just use the correlation as coefficient
            let mut norm_sq: f32 = 0.0
            for l in 0 to p {
                let val: f32 = matrix_at(model.dictionary, best_idx, l)
                norm_sq = norm_sq + val * val
            }
            if norm_sq > 0.0000000001 {
                let mut coef: f32 = 0.0
                for l in 0 to p {
                    coef = coef + matrix_at(model.dictionary, best_idx, l) * residual[l]
                }
                coef = coef / norm_sq
                matrix_set(result, i, best_idx, coef)
                for l in 0 to p {
                    residual[l] = residual[l] - coef * matrix_at(model.dictionary, best_idx, l)
                }
            }
        }

        array_free_f32(residual)
        array_free_f32(selected as ptr<f32>)
    }

    return result
}

export function sparse_coder_free(model: SparseCoder) -> void {
    matrix_free(model.dictionary)
}

# ============================================================================
# PolynomialCountSketch: approximates polynomial kernel features.
# Uses the tensor sketch trick (Pham and Pagh 2013).
# ============================================================================

export struct PolynomialCountSketch {
    n_components: i32,
    n_features: i32,
    degree: i32,
    hash_tables: ptr<ptr<i32> >,
    sign_tables: ptr<ptr<f32> >,
    fitted: bool
}

export function polynomial_count_sketch_fit(n_features: i32, n_components: i32, degree: i32) -> PolynomialCountSketch {
    srand(42)
    let hash_tables: ptr<ptr<i32> > = malloc((degree as i64) * 8) as ptr<ptr<i32> >
    let sign_tables: ptr<ptr<f32> > = malloc((degree as i64) * 8) as ptr<ptr<f32> >
    for d in 0 to degree {
        hash_tables[d] = array_new_f32(n_features) as ptr<i32>
        sign_tables[d] = array_new_f32(n_features)
        for j in 0 to n_features {
            hash_tables[d][j] = rand() % n_components
            let s: i32 = rand() % 2
            if s == 0 {
                sign_tables[d][j] = 1.0
            } else {
                sign_tables[d][j] = -1.0
            }
        }
    }
    return PolynomialCountSketch {
        n_components: n_components,
        n_features: n_features,
        degree: degree,
        hash_tables: hash_tables,
        sign_tables: sign_tables,
        fitted: true
    }
}

export function polynomial_count_sketch_transform(model: PolynomialCountSketch, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    for i in 0 to n {
        for j in 0 to model.n_components {
            matrix_set(result, i, j, 0.0)
        }
        for j in 0 to model.n_features {
            let val: f32 = matrix_at(X, i, j)
            let h: i32 = model.hash_tables[0][j]
            let s: f32 = model.sign_tables[0][j]
            matrix_set(result, i, h, matrix_at(result, i, h) + s * val)
        }
    }
    return result
}

export function polynomial_count_sketch_free(model: PolynomialCountSketch) -> void {
    for d in 0 to model.degree {
        array_free_f32(model.hash_tables[d] as ptr<f32>)
        array_free_f32(model.sign_tables[d])
    }
    free(model.hash_tables as ptr<void>)
    free(model.sign_tables as ptr<void>)
}

# ============================================================================
# SpectralBiclustering: biclustering via SVD of the data matrix.
# ============================================================================

export struct SpectralBiclustering {
    row_labels: ptr<i32>,
    col_labels: ptr<i32>,
    n_row_clusters: i32,
    n_col_clusters: i32,
    n_rows: i32,
    n_cols: i32,
    fitted: bool
}

# Modified Gram-Schmidt over the columns of a row-major m by k block.
function _bic_orthonormalize(V: ptr<f32>, m: i32, k: i32) -> void {
    for c in 0 to k {
        for prev in 0 to c {
            let mut dot: f32 = 0.0
            let mut i: i32 = 0
            while i < m {
                dot = dot + V[i * k + c] * V[i * k + prev]
                i = i + 1
            }
            let mut i2: i32 = 0
            while i2 < m {
                V[i2 * k + c] = V[i2 * k + c] - dot * V[i2 * k + prev]
                i2 = i2 + 1
            }
        }
        let mut norm: f32 = 0.0
        let mut i3: i32 = 0
        while i3 < m {
            let v: f32 = V[i3 * k + c]
            norm = norm + v * v
            i3 = i3 + 1
        }
        norm = sqrt((norm) as f64) as f32
        if norm > 0.0000000001 {
            let inv: f32 = 1.0 / norm
            let mut i4: i32 = 0
            while i4 < m {
                V[i4 * k + c] = V[i4 * k + c] * inv
                i4 = i4 + 1
            }
        }
    }
}

# The k leading right singular vectors of A, as the k leading eigenvectors of
# A^T A by block power iteration. A is row-major n by p, V is p by k.
function _bic_right_singular(A: ptr<f32>, n: i32, p: i32, k: i32, V: ptr<f32>) -> void {
    let M: ptr<f32> = array_new_f32(p * p)
    cblas_sgemm(101, 112, 111, p, p, n, 1.0, A, p, A, p, 0.0, M, p)

    let Z: ptr<f32> = array_new_f32(p * k)
    srand(42)
    for i in 0 to p * k { V[i] = ((rand() % 1000) as f32) / 500.0 - 1.0 }
    _bic_orthonormalize(V, p, k)

    let mut iter: i32 = 0
    while iter < 300 {
        blas_matmat(M, V, Z, p, k, p, 1.0, 0.0)
        _bic_orthonormalize(Z, p, k)
        let mut max_change: f32 = 0.0
        let mut i2: i32 = 0
        let total: i32 = p * k
        while i2 < total {
            let mut diff: f32 = Z[i2] - V[i2]
            if diff < 0.0 { diff = 0.0 - diff }
            if diff > max_change { max_change = diff }
            V[i2] = Z[i2]
            i2 = i2 + 1
        }
        if max_change < 0.0000001 { break }
        iter = iter + 1
    }

    array_free_f32(M)
    array_free_f32(Z)
}

# Lloyd's algorithm over m points in d dimensions, seeded by points spread
# evenly through the set so a fit is reproducible.
function _bic_kmeans(Z: ptr<f32>, m: i32, d: i32, k: i32, labels: ptr<i32>) -> void {
    let centers: ptr<f32> = array_new_f32(k * d)
    let counts: ptr<i32> = malloc((k as i64) * 4 + 64) as ptr<i32>
    for c in 0 to k {
        let src: i32 = (c * m) / k
        let mut j: i32 = 0
        while j < d {
            centers[c * d + j] = Z[src * d + j]
            j = j + 1
        }
    }
    for i in 0 to m { labels[i] = 0 }

    let mut iter: i32 = 0
    while iter < 100 {
        let mut moved: i32 = 0
        let mut i: i32 = 0
        while i < m {
            let zi: ptr<f32> = Z + i * d
            let mut best: i32 = 0
            let mut best_d: f32 = 999999999999.0
            let mut c: i32 = 0
            while c < k {
                let cc: ptr<f32> = centers + c * d
                let mut acc: f32 = 0.0
                let mut j2: i32 = 0
                while j2 < d {
                    let diff: f32 = zi[j2] - cc[j2]
                    acc = acc + diff * diff
                    j2 = j2 + 1
                }
                if acc < best_d {
                    best_d = acc
                    best = c
                }
                c = c + 1
            }
            if labels[i] != best {
                labels[i] = best
                moved = moved + 1
            }
            i = i + 1
        }

        for c2 in 0 to k {
            counts[c2] = 0
            let mut j3: i32 = 0
            while j3 < d {
                centers[c2 * d + j3] = 0.0
                j3 = j3 + 1
            }
        }
        let mut i2: i32 = 0
        while i2 < m {
            let lab: i32 = labels[i2]
            let zi2: ptr<f32> = Z + i2 * d
            let cc2: ptr<f32> = centers + lab * d
            let mut j4: i32 = 0
            while j4 < d {
                cc2[j4] = cc2[j4] + zi2[j4]
                j4 = j4 + 1
            }
            counts[lab] = counts[lab] + 1
            i2 = i2 + 1
        }
        for c3 in 0 to k {
            if counts[c3] > 0 {
                let inv: f32 = 1.0 / (counts[c3] as f32)
                let mut j5: i32 = 0
                while j5 < d {
                    centers[c3 * d + j5] = centers[c3 * d + j5] * inv
                    j5 = j5 + 1
                }
            }
        }

        if moved == 0 { break }
        iter = iter + 1
    }

    array_free_f32(centers)
    free(counts as ptr<void>)
}

# Spectral biclustering, after Kluger et al. (2003), which is what
# scikit-learn's SpectralBiclustering implements.
#
# The checkerboard structure it looks for shows up in the singular vectors of
# the bistochastically normalized matrix: a vector that fits the structure is
# close to piecewise constant. So the leading vectors are ranked by how well a
# one dimensional k-means fits each of them, the best few are kept, and rows
# and columns are clustered separately in the space they span.
#
# What stood here bucketed row means and column means between their smallest
# and largest values, which finds no checkerboard and came out at thirty
# thousand times scikit-learn for doing almost nothing.

# Sinkhorn-Knopp, which is the default normalization scikit-learn uses.
function _bic_bistochastic(A: ptr<f32>, n: i32, p: i32) -> void {
    let r: ptr<f32> = array_new_f32(n)
    let c: ptr<f32> = array_new_f32(p)
    let mut iter: i32 = 0
    while iter < 100 {
        for i in 0 to n { r[i] = 0.0 }
        for j in 0 to p { c[j] = 0.0 }
        let mut i2: i32 = 0
        while i2 < n {
            let row: ptr<f32> = A + i2 * p
            let mut s: f32 = 0.0
            let mut j2: i32 = 0
            while j2 < p {
                s = s + row[j2]
                j2 = j2 + 1
            }
            if s < 0.0000000001 { s = 0.0000000001 }
            r[i2] = 1.0 / (sqrt((s) as f64) as f32)
            i2 = i2 + 1
        }
        let mut i3: i32 = 0
        while i3 < n {
            let row2: ptr<f32> = A + i3 * p
            let ri: f32 = r[i3]
            let mut j3: i32 = 0
            while j3 < p {
                let v: f32 = row2[j3] * ri
                row2[j3] = v
                c[j3] = c[j3] + v
                j3 = j3 + 1
            }
            i3 = i3 + 1
        }
        let mut max_dev: f32 = 0.0
        let mut j4: i32 = 0
        while j4 < p {
            let mut s2: f32 = c[j4]
            if s2 < 0.0000000001 { s2 = 0.0000000001 }
            let scale: f32 = 1.0 / (sqrt((s2) as f64) as f32)
            c[j4] = scale
            let dev: f32 = fabs((scale - 1.0) as f64) as f32
            if dev > max_dev { max_dev = dev }
            j4 = j4 + 1
        }
        let mut i4: i32 = 0
        while i4 < n {
            let row3: ptr<f32> = A + i4 * p
            let mut j5: i32 = 0
            while j5 < p {
                row3[j5] = row3[j5] * c[j5]
                j5 = j5 + 1
            }
            i4 = i4 + 1
        }
        if max_dev < 0.00001 { break }
        iter = iter + 1
    }
    array_free_f32(r)
    array_free_f32(c)
}

# How well a one dimensional k-means fits a vector, as the sum of squared
# distances to the assigned centroid. A vector that carries the checkerboard
# is close to piecewise constant and scores low.
function _bic_piecewise_error(v: ptr<f32>, m: i32, k: i32) -> f32 {
    let labels: ptr<i32> = malloc((m as i64) * 4 + 64) as ptr<i32>
    _bic_kmeans(v, m, 1, k, labels)

    let sums: ptr<f32> = array_new_f32(k)
    let counts: ptr<i32> = malloc((k as i64) * 4 + 64) as ptr<i32>
    for c in 0 to k { counts[c] = 0 }
    let mut i: i32 = 0
    while i < m {
        sums[labels[i]] = sums[labels[i]] + v[i]
        counts[labels[i]] = counts[labels[i]] + 1
        i = i + 1
    }
    for c2 in 0 to k {
        if counts[c2] > 0 { sums[c2] = sums[c2] / (counts[c2] as f32) }
    }
    let mut err: f32 = 0.0
    let mut i2: i32 = 0
    while i2 < m {
        let d: f32 = v[i2] - sums[labels[i2]]
        err = err + d * d
        i2 = i2 + 1
    }

    free(labels as ptr<void>)
    free(counts as ptr<void>)
    array_free_f32(sums)
    return err
}

export function spectral_biclustering_fit(X: Matrix, n_row_clusters: i32, n_col_clusters: i32) -> SpectralBiclustering {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let xdata: ptr<f32> = X.data

    let An: ptr<f32> = array_new_f32(n * p)
    for i in 0 to n * p { An[i] = xdata[i] }
    _bic_bistochastic(An, n, p)

    # scikit-learn takes six singular vectors and keeps the best three of
    # them, which is as many as the matrix has here when it is narrow.
    let mut n_vecs: i32 = 6
    if n_vecs > p { n_vecs = p }
    if n_vecs < 2 { n_vecs = 2 }

    let V: ptr<f32> = array_new_f32(p * n_vecs)
    _bic_right_singular(An, n, p, n_vecs, V)

    let U: ptr<f32> = array_new_f32(n * n_vecs)
    blas_matmat(An, V, U, n, n_vecs, p, 1.0, 0.0)
    for c in 0 to n_vecs {
        let mut norm: f32 = 0.0
        let mut i2: i32 = 0
        while i2 < n {
            let v: f32 = U[i2 * n_vecs + c]
            norm = norm + v * v
            i2 = i2 + 1
        }
        norm = sqrt((norm) as f64) as f32
        if norm > 0.0000000001 {
            let inv: f32 = 1.0 / norm
            let mut i3: i32 = 0
            while i3 < n {
                U[i3 * n_vecs + c] = U[i3 * n_vecs + c] * inv
                i3 = i3 + 1
            }
        }
    }

    # Rank the vectors after the trivial one by how close to piecewise
    # constant they are, and keep the best few.
    let mut n_best: i32 = 3
    if n_best > n_vecs - 1 { n_best = n_vecs - 1 }
    if n_best < 1 { n_best = 1 }

    let scratch: ptr<f32> = array_new_f32(n)
    let errs: ptr<f32> = array_new_f32(n_vecs)
    let chosen: ptr<i32> = malloc((n_vecs as i64) * 4 + 64) as ptr<i32>
    for c2 in 0 to n_vecs { chosen[c2] = 0 }
    for c3 in 1 to n_vecs {
        let mut i4: i32 = 0
        while i4 < n {
            scratch[i4] = U[i4 * n_vecs + c3]
            i4 = i4 + 1
        }
        errs[c3] = _bic_piecewise_error(scratch, n, n_row_clusters)
    }
    for b in 0 to n_best {
        let mut best_c: i32 = -1
        let mut best_err: f32 = 999999999999.0
        for c4 in 1 to n_vecs {
            if chosen[c4] == 0 {
                if errs[c4] < best_err {
                    best_err = errs[c4]
                    best_c = c4
                }
            }
        }
        if best_c >= 0 { chosen[best_c] = 1 }
    }

    # Rows and columns are clustered separately, in the space the kept
    # vectors span.
    let Zr: ptr<f32> = array_new_f32(n * n_best)
    let Zc: ptr<f32> = array_new_f32(p * n_best)
    let mut slot: i32 = 0
    for c5 in 1 to n_vecs {
        if chosen[c5] == 1 {
            let mut i5: i32 = 0
            while i5 < n {
                Zr[i5 * n_best + slot] = U[i5 * n_vecs + c5]
                i5 = i5 + 1
            }
            let mut j2: i32 = 0
            while j2 < p {
                Zc[j2 * n_best + slot] = V[j2 * n_vecs + c5]
                j2 = j2 + 1
            }
            slot = slot + 1
        }
    }

    let row_labels: ptr<i32> = malloc((n as i64) * 4 + 64) as ptr<i32>
    let col_labels: ptr<i32> = malloc((p as i64) * 4 + 64) as ptr<i32>
    _bic_kmeans(Zr, n, n_best, n_row_clusters, row_labels)
    _bic_kmeans(Zc, p, n_best, n_col_clusters, col_labels)

    array_free_f32(An)
    array_free_f32(U)
    array_free_f32(V)
    array_free_f32(Zr)
    array_free_f32(Zc)
    array_free_f32(scratch)
    array_free_f32(errs)
    free(chosen as ptr<void>)

    return SpectralBiclustering {
        row_labels: row_labels,
        col_labels: col_labels,
        n_row_clusters: n_row_clusters,
        n_col_clusters: n_col_clusters,
        n_rows: n,
        n_cols: p,
        fitted: true
    }
}

export function spectral_biclustering_free(model: SpectralBiclustering) -> void {
    array_free_f32(model.row_labels as ptr<f32>)
    array_free_f32(model.col_labels as ptr<f32>)
}

# ============================================================================
# SpectralCoclustering: coclustering via SVD of the normalized data matrix.
# ============================================================================

export struct SpectralCoclustering {
    row_labels: ptr<i32>,
    col_labels: ptr<i32>,
    n_clusters: i32,
    n_rows: i32,
    n_cols: i32,
    fitted: bool
}

# Spectral co-clustering, after Dhillon (2001), which is what scikit-learn's
# SpectralCoclustering implements.
#
# The data matrix is treated as the adjacency of a bipartite graph. Normalizing
# it by the square roots of its row and column sums turns the partitioning
# problem into a singular value problem: the leading pair is trivial, and the
# next ceil(log2(k)) pairs embed rows and columns in a common space where a
# k-means run recovers the co-clusters.
#
# What stood here scaled each row sum into a bucket between the smallest and
# the largest, which is not that algorithm and is not any other one. It came
# out at three thousand times scikit-learn because it did almost nothing.
#
# The helper names carry a prefix because a non-exported function with the same
# name in two modules collides in the generated C. Flow issue #465.

export function spectral_coclustering_fit(X: Matrix, n_clusters: i32) -> SpectralCoclustering {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let xdata: ptr<f32> = X.data

    let row_labels: ptr<i32> = malloc((n as i64) * 4 + 64) as ptr<i32>
    let col_labels: ptr<i32> = malloc((p as i64) * 4 + 64) as ptr<i32>

    # Row and column sums, and the inverse square roots the normalization uses.
    let r_inv: ptr<f32> = array_new_f32(n)
    let c_inv: ptr<f32> = array_new_f32(p)
    let c_sum: ptr<f32> = array_new_f32(p)
    for i in 0 to n {
        let row: ptr<f32> = xdata + i * p
        let mut s: f32 = 0.0
        let mut j: i32 = 0
        while j < p {
            let v: f32 = row[j]
            s = s + v
            c_sum[j] = c_sum[j] + v
            j = j + 1
        }
        if s < 0.0000000001 { s = 0.0000000001 }
        r_inv[i] = 1.0 / (sqrt((s) as f64) as f32)
    }
    for j2 in 0 to p {
        let mut s2: f32 = c_sum[j2]
        if s2 < 0.0000000001 { s2 = 0.0000000001 }
        c_inv[j2] = 1.0 / (sqrt((s2) as f64) as f32)
    }

    let An: ptr<f32> = array_new_f32(n * p)
    for i2 in 0 to n {
        let src: ptr<f32> = xdata + i2 * p
        let dst: ptr<f32> = An + i2 * p
        let ri: f32 = r_inv[i2]
        let mut j3: i32 = 0
        while j3 < p {
            dst[j3] = ri * src[j3] * c_inv[j3]
            j3 = j3 + 1
        }
    }

    # The leading pair is trivial, so ceil(log2(k)) more are needed after it.
    let mut n_keep: i32 = 0
    let mut reach: i32 = 1
    while reach < n_clusters {
        reach = reach * 2
        n_keep = n_keep + 1
    }
    if n_keep < 1 { n_keep = 1 }
    let mut n_vecs: i32 = n_keep + 1
    if n_vecs > p { n_vecs = p }

    let V: ptr<f32> = array_new_f32(p * n_vecs)
    _bic_right_singular(An, n, p, n_vecs, V)

    # The matching left vectors, as A v, which is what the normalized matrix
    # maps the right vectors to.
    let U: ptr<f32> = array_new_f32(n * n_vecs)
    blas_matmat(An, V, U, n, n_vecs, p, 1.0, 0.0)
    for c in 0 to n_vecs {
        let mut norm: f32 = 0.0
        let mut i3: i32 = 0
        while i3 < n {
            let v: f32 = U[i3 * n_vecs + c]
            norm = norm + v * v
            i3 = i3 + 1
        }
        norm = sqrt((norm) as f64) as f32
        if norm > 0.0000000001 {
            let inv: f32 = 1.0 / norm
            let mut i4: i32 = 0
            while i4 < n {
                U[i4 * n_vecs + c] = U[i4 * n_vecs + c] * inv
                i4 = i4 + 1
            }
        }
    }

    # Rows and columns land in one space, scaled back by the same square roots,
    # and one k-means run over the stack assigns both.
    let d: i32 = n_vecs - 1
    let m: i32 = n + p
    let Z: ptr<f32> = array_new_f32(m * d)
    for i5 in 0 to n {
        let ri2: f32 = r_inv[i5]
        let mut j4: i32 = 0
        while j4 < d {
            Z[i5 * d + j4] = ri2 * U[i5 * n_vecs + j4 + 1]
            j4 = j4 + 1
        }
    }
    for j5 in 0 to p {
        let cj: f32 = c_inv[j5]
        let mut j6: i32 = 0
        while j6 < d {
            Z[(n + j5) * d + j6] = cj * V[j5 * n_vecs + j6 + 1]
            j6 = j6 + 1
        }
    }

    let labels: ptr<i32> = malloc((m as i64) * 4 + 64) as ptr<i32>
    _bic_kmeans(Z, m, d, n_clusters, labels)
    for i6 in 0 to n { row_labels[i6] = labels[i6] }
    for j7 in 0 to p { col_labels[j7] = labels[n + j7] }

    free(labels as ptr<void>)
    array_free_f32(Z)
    array_free_f32(U)
    array_free_f32(V)
    array_free_f32(An)
    array_free_f32(r_inv)
    array_free_f32(c_inv)
    array_free_f32(c_sum)

    return SpectralCoclustering {
        row_labels: row_labels,
        col_labels: col_labels,
        n_clusters: n_clusters,
        n_rows: n,
        n_cols: p,
        fitted: true
    }
}

export function spectral_coclustering_free(model: SpectralCoclustering) -> void {
    array_free_f32(model.row_labels as ptr<f32>)
    array_free_f32(model.col_labels as ptr<f32>)
}

# ============================================================================
# LassoLarsIC: Lasso with LARS and model selection via information criterion.
# Uses LARS path then selects best alpha by AIC or BIC.
# ============================================================================

export struct LassoLarsIC {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    criterion: i32,
    fitted: bool
}

export const LASSO_LARS_IC_AIC: i32 = 0
export const LASSO_LARS_IC_BIC: i32 = 1

export function lasso_lars_ic_fit(X: Matrix, y: ptr<f32>, criterion: i32) -> LassoLarsIC {
    let n: i32 = X.cols
    let m: i32 = X.rows

    # Use Lasso coordinate descent with a range of alphas, pick best by IC
    let mut best_alpha: f32 = 0.001
    let mut best_ic: f32 = 1000000.0

    let alpha_list: ptr<f32> = array_new_f32(20)
    for i in 0 to 20 {
        alpha_list[i] = 0.0001 * pow_int(10, i) as f32
    }

    for a_idx in 0 to 20 {
        let alpha: f32 = alpha_list[a_idx]
        let model: Lasso = lasso_fit(X, y, alpha, 100, 0.01)
        let preds: ptr<f32> = lasso_predict(model, X)

        let mut rss: f32 = 0.0
        for i in 0 to m {
            let err: f32 = preds[i] - y[i]
            rss = rss + err * err
        }

        let mut n_nonzero: i32 = 0
        for j in 0 to n {
            let mut w: f32 = model.weights[j]
            if w < 0.0 { w = -w }
            if w > 0.0000000001 { n_nonzero = n_nonzero + 1 }
        }

        let sigma2: f32 = rss / (m as f32)
        let ic: f32 = 0.0
        if criterion == LASSO_LARS_IC_AIC {
            ic = m * log((sigma2) as f64) as f32 + 2.0 * (n_nonzero as f32)
        } else {
            ic = m * log((sigma2) as f64) as f32 + (n_nonzero as f32) * log((m) as f64) as f32
        }

        if ic < best_ic {
            best_ic = ic
            best_alpha = alpha
        }

        lasso_free(model)
        array_free_f32(preds)
    }

    let final_model: Lasso = lasso_fit(X, y, best_alpha, 200, 0.01)
    let weights: ptr<f32> = array_new_f32(n)
    for j in 0 to n { weights[j] = final_model.weights[j] }

    let result: LassoLarsIC = LassoLarsIC {
        weights: weights,
        bias: final_model.bias,
        n_features: n,
        alpha: best_alpha,
        criterion: criterion,
        fitted: true
    }
    lasso_free(final_model)
    array_free_f32(alpha_list)
    return result
}

# Same y = X * w + b batch as the linear.flow predicts: one cblas_sgemv with
# the row stride passed as lda above the 65536 rows * features work threshold,
# and the scalar kernel with matrix_at folded into a direct row-major index
# below it. matrix_at takes the Matrix struct by value, so the old loop copied
# the struct on every element access.
export function lasso_lars_ic_predict(model: LassoLarsIC, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return preds }

    let nf: i32 = model.n_features
    let bias: f32 = model.bias
    let w: ptr<f32> = model.weights
    let data: ptr<f32> = X.data
    let stride: i32 = X.cols

    if nf > 0 && nf <= stride && rows * nf >= 65536 {
        blas_matvec_ld(data, rows, nf, stride, w, preds, 1.0, 0.0)
        for i in 0 to rows {
            preds[i] = preds[i] + bias
        }
        return preds
    }

    for i in 0 to rows {
        let base: i32 = i * stride
        let mut pred: f32 = bias
        for j in 0 to nf {
            pred = pred + w[j] * data[base + j]
        }
        preds[i] = pred
    }
    return preds
}

export function lasso_lars_ic_free(model: LassoLarsIC) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# OrthogonalMatchingPursuitCV: OMP with cross-validated n_nonzero_coefs.
# ============================================================================

export struct OrthogonalMatchingPursuitCV {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_nonzero_coefs: i32,
    fitted: bool
}

export function omp_cv_fit(X: Matrix, y: ptr<f32>, max_coefs: i32) -> OrthogonalMatchingPursuitCV {
    let n: i32 = X.cols
    let m: i32 = X.rows
    if max_coefs > n { max_coefs = n }

    # Try each value of n_nonzero_coefs and pick best by CV error
    let mut best_n: i32 = 1
    let mut best_error: f32 = 1000000.0

    for n_coefs in 1 to max_coefs + 1 {
        # Simple fit: greedy selection
        let residual: ptr<f32> = array_new_f32(m)
        for i in 0 to m { residual[i] = y[i] }

        let selected: ptr<i32> = array_new_f32(n) as ptr<i32>
        for j in 0 to n { selected[j] = 0 }

        let weights: ptr<f32> = array_new_f32(n)
        for j in 0 to n { weights[j] = 0.0 }

        for step in 0 to n_coefs {
            let mut best_idx: i32 = 0
            let mut best_corr: f32 = 0.0
            for j in 0 to n {
                if selected[j] == 1 { continue }
                let mut corr: f32 = 0.0
                for i in 0 to m {
                    corr = corr + matrix_at(X, i, j) * residual[i]
                }
                let abs_corr: f32 = corr
                if corr < 0.0 { abs_corr = -corr }
                if abs_corr > best_corr {
                    best_corr = abs_corr
                    best_idx = j
                }
            }
            selected[best_idx] = 1

            let mut norm_sq: f32 = 0.0
            for i in 0 to m {
                let val: f32 = matrix_at(X, i, best_idx)
                norm_sq = norm_sq + val * val
            }
            if norm_sq > 0.0000000001 {
                let mut coef: f32 = 0.0
                for i in 0 to m {
                    coef = coef + matrix_at(X, i, best_idx) * residual[i]
                }
                coef = coef / norm_sq
                weights[best_idx] = coef
                for i in 0 to m {
                    residual[i] = residual[i] - coef * matrix_at(X, i, best_idx)
                }
            }
        }

        let mut error: f32 = 0.0
        for i in 0 to m {
            error = error + residual[i] * residual[i]
        }
        if error < best_error {
            best_error = error
            best_n = n_coefs
        }

        array_free_f32(residual)
        array_free_f32(selected as ptr<f32>)
        array_free_f32(weights)
    }

    # Refit with best_n
    let residual: ptr<f32> = array_new_f32(m)
    for i in 0 to m { residual[i] = y[i] }
    let selected: ptr<i32> = array_new_f32(n) as ptr<i32>
    for j in 0 to n { selected[j] = 0 }
    let weights: ptr<f32> = array_new_f32(n)
    for j in 0 to n { weights[j] = 0.0 }

    for step in 0 to best_n {
        let mut best_idx: i32 = 0
        let mut best_corr: f32 = 0.0
        for j in 0 to n {
            if selected[j] == 1 { continue }
            let mut corr: f32 = 0.0
            for i in 0 to m {
                corr = corr + matrix_at(X, i, j) * residual[i]
            }
            let abs_corr: f32 = corr
            if corr < 0.0 { abs_corr = -corr }
            if abs_corr > best_corr {
                best_corr = abs_corr
                best_idx = j
            }
        }
        selected[best_idx] = 1
        let mut norm_sq: f32 = 0.0
        for i in 0 to m {
            let val: f32 = matrix_at(X, i, best_idx)
            norm_sq = norm_sq + val * val
        }
        if norm_sq > 0.0000000001 {
            let mut coef: f32 = 0.0
            for i in 0 to m {
                coef = coef + matrix_at(X, i, best_idx) * residual[i]
            }
            coef = coef / norm_sq
            weights[best_idx] = coef
            for i in 0 to m {
                residual[i] = residual[i] - coef * matrix_at(X, i, best_idx)
            }
        }
    }

    array_free_f32(residual)
    array_free_f32(selected as ptr<f32>)

    return OrthogonalMatchingPursuitCV {
        weights: weights,
        bias: 0.0,
        n_features: n,
        n_nonzero_coefs: best_n,
        fitted: true
    }
}

export function omp_cv_predict(model: OrthogonalMatchingPursuitCV, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut pred: f32 = model.bias
        for j in 0 to model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
        }
        preds[i] = pred
    }
    return preds
}

export function omp_cv_free(model: OrthogonalMatchingPursuitCV) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# NeighborhoodComponentsAnalysis: learns a Mahalanobis distance metric
# for k-NN via gradient descent on a leave-one-out objective.
# ============================================================================

export struct NeighborhoodComponentsAnalysis {
    transformation: ptr<ptr<f32> >,
    n_features: i32,
    n_components: i32,
    fitted: bool
}

# Neighbourhood components analysis, after Goldberger et al. (2004), which is
# what scikit-learn's NeighborhoodComponentsAnalysis maximizes.
#
# The objective is the expected number of correctly classified points under
# stochastic nearest neighbours: with p_ik proportional to exp of minus the
# squared distance between the projected points, the score of a point is the
# probability mass its own class receives, and the gradient of that sum with
# respect to the projection is
#
#   2 * sum_i ( p_i * sum_k p_ik C_ik  -  sum_{k in class of i} p_ik C_ik ) * T
#
# with C_ik the outer product of the difference of the two rows.
#
# What stood here computed neither. Its distance summed the squares of the
# individual products rather than squaring the projected difference, which is
# not the distance in the projected space unless the projection has one
# column, and its gradient kept only the second of the two terms above, so it
# pulled same-class points together with nothing pushing back.
export function nca_fit(X: Matrix, y: ptr<f32>, n_components: i32, epochs: i32, lr: f32) -> NeighborhoodComponentsAnalysis {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let d: i32 = n_components
    let xdata: ptr<f32> = X.data

    # The projection, held flat while it is being fitted and handed back a row
    # at a time at the end.
    let T: ptr<f32> = array_new_f32(p * d)
    for i in 0 to p {
        let mut j: i32 = 0
        while j < d {
            if i == j { T[i * d + j] = 1.0 }
            else { T[i * d + j] = 0.0 }
            j = j + 1
        }
    }

    let proj: ptr<f32> = array_new_f32(n * d)
    let prob: ptr<f32> = array_new_f32(n)
    let W: ptr<f32> = array_new_f32(p * p)
    let grad: ptr<f32> = array_new_f32(p * d)
    let diff: ptr<f32> = array_new_f32(p)

    for epoch in 0 to epochs {
        # One projection of the whole design per epoch.
        blas_matmat(xdata, T, proj, n, d, p, 1.0, 0.0)
        for i in 0 to p * p { W[i] = 0.0 }

        for i in 0 to n {
            let pi: ptr<f32> = proj + i * d
            let yi: f32 = y[i]

            # The softmax over the other points, and the mass its own class
            # receives.
            let mut total: f32 = 0.0
            let mut same: f32 = 0.0
            let mut k: i32 = 0
            while k < n {
                if k != i {
                    let pk: ptr<f32> = proj + k * d
                    let mut dist: f32 = 0.0
                    let mut b: i32 = 0
                    while b < d {
                        let dv: f32 = pi[b] - pk[b]
                        dist = dist + dv * dv
                        b = b + 1
                    }
                    let w: f32 = exp((0.0 - dist) as f64) as f32
                    prob[k] = w
                    total = total + w
                    if y[k] == yi { same = same + w }
                } else {
                    prob[k] = 0.0
                }
                k = k + 1
            }
            if total < 0.0000000001 { continue }

            let inv_total: f32 = 1.0 / total
            let p_i: f32 = same * inv_total

            # Each pair contributes its outer product, weighted by how much
            # the pair helps or hurts the score of this point.
            let row_i: ptr<f32> = xdata + i * p
            let mut k2: i32 = 0
            while k2 < n {
                if k2 != i {
                    let p_ik: f32 = prob[k2] * inv_total
                    let mut coeff: f32 = p_i * p_ik
                    if y[k2] == yi { coeff = coeff - p_ik }
                    if coeff > 0.0000001 || coeff < 0.0 - 0.0000001 {
                        let row_k: ptr<f32> = xdata + k2 * p
                        let mut a: i32 = 0
                        while a < p {
                            diff[a] = row_i[a] - row_k[a]
                            a = a + 1
                        }
                        let mut a2: i32 = 0
                        while a2 < p {
                            let da: f32 = coeff * diff[a2]
                            let wrow: ptr<f32> = W + a2 * p
                            let mut b2: i32 = 0
                            while b2 < p {
                                wrow[b2] = wrow[b2] + da * diff[b2]
                                b2 = b2 + 1
                            }
                            a2 = a2 + 1
                        }
                    }
                }
                k2 = k2 + 1
            }
        }

        # Ascend the objective. The step is scaled by the sample count so a
        # learning rate means the same thing whatever the size of the data.
        blas_matmat(W, T, grad, p, d, p, 1.0, 0.0)
        let step: f32 = 2.0 * lr / (n as f32)
        let mut t: i32 = 0
        let total_t: i32 = p * d
        while t < total_t {
            T[t] = T[t] + step * grad[t]
            t = t + 1
        }
    }

    let transform: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i2 in 0 to p {
        let row: ptr<f32> = array_new_f32(d)
        let mut j2: i32 = 0
        while j2 < d {
            row[j2] = T[i2 * d + j2]
            j2 = j2 + 1
        }
        transform[i2] = row
    }

    array_free_f32(T)
    array_free_f32(proj)
    array_free_f32(prob)
    array_free_f32(W)
    array_free_f32(grad)
    array_free_f32(diff)

    return NeighborhoodComponentsAnalysis {
        transformation: transform,
        n_features: p,
        n_components: n_components,
        fitted: true
    }
}

export function nca_transform(model: NeighborhoodComponentsAnalysis, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    for i in 0 to n {
        for j in 0 to model.n_components {
            let mut s: f32 = 0.0
            for k in 0 to model.n_features {
                s = s + matrix_at(X, i, k) * model.transformation[k][j]
            }
            matrix_set(result, i, j, s)
        }
    }
    return result
}

export function nca_free(model: NeighborhoodComponentsAnalysis) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.transformation[i])
    }
    free(model.transformation as ptr<void>)
}

# ============================================================================
# SGDOneClassSVM: one-class SVM via stochastic gradient descent.
# Equivalent to sklearn's SGDOneClassSVM.
# ============================================================================

export struct SGDOneClassSVM {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    nu: f32,
    fitted: bool
}

export function sgd_one_class_svm_fit(X: Matrix, nu: f32, epochs: i32, lr: f32) -> SGDOneClassSVM {
    let n: i32 = X.cols
    let m: i32 = X.rows

    let weights: ptr<f32> = array_new_f32(n)
    for j in 0 to n { weights[j] = 0.0 }
    let mut bias: f32 = 0.0

    # One-class SVM: minimize 0.5 * ||w||^2 + (1/(nu*m)) * sum(max(0, 1 - (w*x + b)))
    for epoch in 0 to epochs {
        for i in 0 to m {
            let mut score: f32 = bias
            for j in 0 to n {
                score = score + weights[j] * matrix_at(X, i, j)
            }

            if score < 1.0 {
                # Update: w += lr * x / (nu * m), b += lr / (nu * m)
                let coef: f32 = lr / (nu * (m as f32))
                for j in 0 to n {
                    weights[j] = weights[j] + coef * matrix_at(X, i, j)
                }
                bias = bias + coef
            }

            # L2 regularization
            let reg: f32 = 1.0 - lr
            for j in 0 to n {
                weights[j] = weights[j] * reg
            }
        }
    }

    return SGDOneClassSVM {
        weights: weights,
        bias: bias,
        n_features: n,
        nu: nu,
        fitted: true
    }
}

export function sgd_one_class_svm_predict(model: SGDOneClassSVM, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut score: f32 = model.bias
        for j in 0 to model.n_features {
            score = score + model.weights[j] * matrix_at(X, i, j)
        }
        if score >= 0.0 {
            result[i] = 1.0
        } else {
            result[i] = -1.0
        }
    }
    return result
}

export function sgd_one_class_svm_decision_function(model: SGDOneClassSVM, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut score: f32 = model.bias
        for j in 0 to model.n_features {
            score = score + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = score
    }
    return result
}

export function sgd_one_class_svm_free(model: SGDOneClassSVM) -> void {
    array_free_f32(model.weights)
}

# Helper
function pow_int(base: i32, exp: i32) -> i32 {
    let mut result: i32 = 1
    for i in 0 to exp {
        result = result * base
    }
    return result
}
