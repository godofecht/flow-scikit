# SVM module for flow-scikit.
# Implements SVC (linear kernel) and SVR (epsilon-insensitive) via SGD.
# Uses simplified SMO-like updates for the dual formulation.

import "lib/scikit/matrix.flow"
import "lib/scikit/sparse.flow"
import "lib/scikit/kernel_ridge.flow"
import "lib/scikit/blas.flow"

# ============================================================================
# LinearSVC (linear SVM classifier via SGD on hinge loss)
# Addresses Issue #28394: predict returns scores, decide returns classes
# ============================================================================

export struct LinearSVC {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    classes: ptr<f32>,
    n_classes: i32,
    C: f32,
    fitted: bool
}

export function linear_svc_fit(X: Matrix, y: ptr<f32>, n_classes: i32, C: f32, epochs: i32, lr: f32) -> LinearSVC {
    let n_features: i32 = X.cols
    let n_samples: i32 = X.rows
    let weights: ptr<f32> = array_new_f32(n_features)
    let bias: f32 = 0.0

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n_samples, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    # Ensure classes[1] is the positive class (larger value).
    if n_found == 2 {
        if classes[0] > classes[1] {
            let tmp: f32 = classes[0]
            classes[0] = classes[1]
            classes[1] = tmp
        }
    }

    # Binary encoding: class[1] = +1, others = -1
    let y_dual: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        if y[i] == classes[1] {
            y_dual[i] = 1.0
        } else {
            y_dual[i] = -1.0
        }
    }

    # Primal Newton method for L2-regularized L2-loss (squared hinge) SVM.
    # This is what LIBLINEAR uses with dual=False (sklearn dual='auto' picks
    # primal when n_samples > n_features). The bias is handled by augmenting
    # the feature vector with a constant 1.0 column.
    # Objective: min (1/2)||w||^2 + C * sum max(0, 1 - y_i*(w^T x_i))^2

    let n_aug: i32 = n_features + 1
    let w: ptr<f64> = array_new_f64(n_aug)
    let C64: f64 = C as f64

    # Precompute x_i^T x_i for each sample (augmented)
    let x_norm_sq: ptr<f64> = array_new_f64(n_samples)
    for i in 0 to n_samples {
        let mut s: f64 = 0.0
        for j in 0 to n_features {
            let xv: f64 = (matrix_at(X, i, j)) as f64
            s = s + xv * xv
        }
        s = s + 1.0  # bias term
        x_norm_sq[i] = s
    }

    let mut iter: i32 = 0
    while iter < epochs {
        # Compute margins y_i * w^T x_i and identify active set
        # Active set I = {i : y_i * w^T x_i < 1}
        let margins: ptr<f64> = array_new_f64(n_samples)
        let active: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
        let mut n_active: i32 = 0
        for i in 0 to n_samples {
            let mut dot: f64 = 0.0
            for j in 0 to n_features {
                dot = dot + w[j] * (matrix_at(X, i, j)) as f64
            }
            dot = dot + w[n_features]  # bias weight
            let m: f64 = (y_dual[i]) as f64 * dot
            margins[i] = m
            if m < 1.0 {
                active[n_active] = i
                n_active = n_active + 1
            }
        }

        # Gradient: g_j = w_j - 2*C * sum_{i in I} y_i*(1 - m_i) * x_ij
        let g: ptr<f64> = array_new_f64(n_aug)
        for j in 0 to n_aug {
            g[j] = w[j]
        }
        for k in 0 to n_active {
            let i: i32 = active[k]
            let yi: f64 = (y_dual[i]) as f64
            let residual: f64 = 1.0 - margins[i]
            for j in 0 to n_features {
                g[j] = g[j] - 2.0 * C64 * yi * residual * (matrix_at(X, i, j)) as f64
            }
            g[n_features] = g[n_features] - 2.0 * C64 * yi * residual  # bias term
        }

        # Check gradient norm
        let mut g_norm: f64 = 0.0
        for j in 0 to n_aug {
            g_norm = g_norm + g[j] * g[j]
        }
        if g_norm < 0.000001 {
            free(active as ptr<void>)
            array_free_f64(margins)
            array_free_f64(g)
            break
        }

        # Hessian: H_jk = delta_jk + 2*C * sum_{i in I} x_ij * x_ik
        # For small n_aug, build and solve directly with Gaussian elimination.
        # The augmented matrix has n2 rows and (n2+1) columns (last col = -g).
        let n2: i32 = n_aug
        let stride: i32 = n2 + 1
        let H: ptr<f64> = malloc((n2 as i64) * (stride as i64) * 8) as ptr<f64>
        for j in 0 to n2 {
            for k in 0 to n2 {
                if j == k {
                    H[j * stride + k] = 1.0
                } else {
                    H[j * stride + k] = 0.0
                }
            }
        }
        for kk in 0 to n_active {
            let i: i32 = active[kk]
            for j in 0 to n_features {
                let xij: f64 = (matrix_at(X, i, j)) as f64
                for k in 0 to n_features {
                    H[j * stride + k] = H[j * stride + k] + 2.0 * C64 * xij * ((matrix_at(X, i, k)) as f64)
                }
                # bias column/row
                H[j * stride + n_features] = H[j * stride + n_features] + 2.0 * C64 * xij
                H[n_features * stride + j] = H[n_features * stride + j] + 2.0 * C64 * xij
            }
            H[n_features * stride + n_features] = H[n_features * stride + n_features] + 2.0 * C64
        }

        # Solve H * d = -g using Gaussian elimination with partial pivoting
        # Augment H with -g as the last column
        for j in 0 to n2 {
            H[j * stride + n2] = 0.0 - g[j]
        }

        # Forward elimination
        let mut col: i32 = 0
        while col < n2 {
            # Find pivot
            let mut max_row: i32 = col
            let mut max_val: f64 = H[col * stride + col]
            if max_val < 0.0 { max_val = -max_val }
            let mut row: i32 = col + 1
            while row < n2 {
                let val: f64 = H[row * stride + col]
                let abs_val: f64 = val
                if val < 0.0 { abs_val = -val }
                if abs_val > max_val {
                    max_val = abs_val
                    max_row = row
                }
                row = row + 1
            }
            # Swap rows
            if max_row != col {
                let mut k: i32 = 0
                while k <= n2 {
                    let tmp: f64 = H[col * stride + k]
                    H[col * stride + k] = H[max_row * stride + k]
                    H[max_row * stride + k] = tmp
                    k = k + 1
                }
            }
            # Eliminate
            let pivot: f64 = H[col * stride + col]
            if pivot > 0.0000000001 || pivot < -0.0000000001 {
                let mut row: i32 = col + 1
                while row < n2 {
                    let factor: f64 = H[row * stride + col] / pivot
                    let mut k: i32 = col
                    while k <= n2 {
                        H[row * stride + k] = H[row * stride + k] - factor * H[col * stride + k]
                        k = k + 1
                    }
                    row = row + 1
                }
            }
            col = col + 1
        }

        # Back substitution
        let d: ptr<f64> = array_new_f64(n2)
        let mut row: i32 = n2 - 1
        while row >= 0 {
            let mut sum: f64 = H[row * stride + n2]
            let mut k: i32 = row + 1
            while k < n2 {
                sum = sum - H[row * stride + k] * d[k]
                k = k + 1
            }
            d[row] = sum / H[row * stride + row]
            row = row - 1
        }

        # Line search: find step size beta that minimizes objective
        # f(w + beta*d) = (1/2)||w+beta*d||^2 + C*sum max(0, 1 - y_i*(w+beta*d)^T x_i)^2
        # Use backtracking with Wolfe-like conditions
        let mut beta: f64 = 1.0
        let mut best_beta: f64 = 0.0
        let mut best_obj: f64 = 0.0
        # Compute current objective
        for j in 0 to n_aug { best_obj = best_obj + 0.5 * w[j] * w[j] }
        for k in 0 to n_active {
            let i: i32 = active[k]
            let yi: f64 = (y_dual[i]) as f64
            let mut dot: f64 = 0.0
            for j in 0 to n_features {
                dot = dot + w[j] * (matrix_at(X, i, j)) as f64
            }
            dot = dot + w[n_features]
            let loss: f64 = 1.0 - yi * dot
            if loss > 0.0 { best_obj = best_obj + C64 * loss * loss }
        }

        # Try several step sizes
        let mut trial: i32 = 0
        while trial < 20 {
            let b: f64 = beta
            let mut obj: f64 = 0.0
            for j in 0 to n_aug {
                let wj: f64 = w[j] + b * d[j]
                obj = obj + 0.5 * wj * wj
            }
            for k in 0 to n_active {
                let i: i32 = active[k]
                let yi: f64 = (y_dual[i]) as f64
                let mut dot: f64 = 0.0
                for j in 0 to n_features {
                    dot = dot + (w[j] + b * d[j]) * (matrix_at(X, i, j)) as f64
                }
                dot = dot + (w[n_features] + b * d[n_features])
                let loss: f64 = 1.0 - yi * dot
                if loss > 0.0 { obj = obj + C64 * loss * loss }
            }
            if obj < best_obj {
                best_obj = obj
                best_beta = b
            }
            beta = beta * 0.5
            trial = trial + 1
        }

        # Update w
        for j in 0 to n_aug {
            w[j] = w[j] + best_beta * d[j]
        }

        free(H as ptr<void>)
        free(active as ptr<void>)
        array_free_f64(margins)
        array_free_f64(g)
        array_free_f64(d)

        iter = iter + 1
    }

    # Extract weights and bias
    for j in 0 to n_features {
        weights[j] = w[j] as f32
    }
    bias = w[n_features] as f32

    array_free_f32(y_dual)
    array_free_f64(w)
    array_free_f64(x_norm_sq)

    return LinearSVC {
        weights: weights,
        bias: bias,
        n_features: n_features,
        classes: classes,
        n_classes: n_classes,
        C: C,
        fitted: true
    }
}

# Sparse-input version of linear_svc_fit.
# Takes a SparseMatrix (CSR) instead of a dense Matrix.
# Uses the same dual coordinate descent algorithm but only iterates
# over non-zero entries when computing w_dot_x and updating weights.
export function linear_svc_fit_sparse(S: SparseMatrix, y: ptr<f32>, n_classes: i32, C: f32, epochs: i32) -> LinearSVC {
    let n_features: i32 = S.n_cols
    let n_samples: i32 = S.n_rows
    let weights: ptr<f32> = array_new_f32(n_features)
    let bias: f32 = 0.0

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n_samples, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    # Ensure classes[1] is the positive class (larger value).
    if n_found == 2 {
        if classes[0] > classes[1] {
            let tmp: f32 = classes[0]
            classes[0] = classes[1]
            classes[1] = tmp
        }
    }

    let y_dual: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        if y[i] == classes[1] {
            y_dual[i] = 1.0
        } else {
            y_dual[i] = -1.0
        }
    }

    let w64: ptr<f64> = array_new_f64(n_features)
    let mut bias64: f64 = 0.0
    let alpha: ptr<f64> = array_new_f64(n_samples)
    let C64: f64 = C as f64

    let eps: f64 = 0.001
    let mut epoch: i32 = 0
    while epoch < epochs {
        let mut max_pg: f64 = 0.0
        for i in 0 to n_samples {
            # Augment sparse samples with the same constant bias feature
            # used by the dense solver.
            let mut Q_ii: f64 = 1.0
            let start: i32 = S.indptr[i]
            let end: i32 = S.indptr[i + 1]
            let mut k: i32 = start
            while k < end {
                let val: f64 = (S.data[k]) as f64
                Q_ii = Q_ii + val * val
                k = k + 1
            }

            if Q_ii < 0.0000000001 { continue }

            # w_dot_x = sum over non-zero entries of w[j] * x_ij
            let mut w_dot_x: f64 = bias64
            k = start
            while k < end {
                w_dot_x = w_dot_x + w64[S.indices[k]] * (S.data[k]) as f64
                k = k + 1
            }
            let G: f64 = (y_dual[i]) as f64 * w_dot_x - 1.0 + 2.0 * alpha[i]

            let mut PG: f64 = G
            if alpha[i] <= 0.0 {
                if G > 0.0 { PG = 0.0 }
            }
            if alpha[i] >= C64 {
                if G < 0.0 { PG = 0.0 }
            }

            let abs_pg: f64 = PG
            if PG < 0.0 { abs_pg = -PG }
            if abs_pg > max_pg { max_pg = abs_pg }

            if abs_pg > eps {
                let alpha_new: f64 = alpha[i] - G / (Q_ii + 1.0)
                if alpha_new < 0.0 { alpha_new = 0.0 }
                if alpha_new > C64 { alpha_new = C64 }

                let delta: f64 = (alpha_new - alpha[i]) * (y_dual[i]) as f64
                k = start
                while k < end {
                    w64[S.indices[k]] = w64[S.indices[k]] + delta * (S.data[k]) as f64
                    k = k + 1
                }
                bias64 = bias64 + delta

                alpha[i] = alpha_new
            }
        }
        if max_pg < eps { break }
        epoch = epoch + 1
    }

    # Bias is optimized jointly as the augmented constant feature.
    bias = bias64 as f32

    for j in 0 to n_features {
        weights[j] = w64[j] as f32
    }

    array_free_f32(y_dual)
    array_free_f64(w64)
    array_free_f64(alpha)

    return LinearSVC {
        weights: weights,
        bias: bias,
        n_features: n_features,
        classes: classes,
        n_classes: n_classes,
        C: C,
        fitted: true
    }
}

export function linear_svc_decision_function(model: LinearSVC, X: Matrix) -> ptr<f32> {
    let scores: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut z: f32 = model.bias
        for j in 0 to model.n_features {
            z = z + model.weights[j] * matrix_at(X, i, j)
        }
        scores[i] = z
    }
    return scores
}

export function linear_svc_predict(model: LinearSVC, X: Matrix) -> ptr<f32> {
    return linear_svc_decision_function(model, X)
}

export function linear_svc_decide(model: LinearSVC, scores: ptr<f32>, n_samples: i32) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        if scores[i] >= 0.0 {
            labels[i] = model.classes[1]
        } else {
            labels[i] = model.classes[0]
        }
    }
    return labels
}

export function linear_svc_free(model: LinearSVC) -> void {
    array_free_f32(model.weights)
    array_free_f32(model.classes)
}

# ============================================================================
# Multi-class LinearSVC via One-vs-Rest
# Trains n_classes binary classifiers. Each classifier distinguishes one
# class from all others. Prediction uses argmax of decision functions.
# ============================================================================

export struct LinearSVCMulti {
    weights: ptr<ptr<f32> >,
    biases: ptr<f32>,
    classes: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    fitted: bool
}

export function linear_svc_multi_fit(X: Matrix, y: ptr<f32>, n_classes: i32, C: f32, epochs: i32) -> LinearSVCMulti {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    let weights: ptr<ptr<f32> > = malloc((n_found as i64) * 8) as ptr<ptr<f32> >
    let biases: ptr<f32> = array_new_f32(n_found)

    let mut c: i32 = 0
    while c < n_found {
        let y_binary: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            if y[i] == classes[c] {
                y_binary[i] = 1.0
            } else {
                y_binary[i] = 0.0
            }
        }

        let model: LinearSVC = linear_svc_fit(X, y_binary, 2, C, epochs, 0.01)
        weights[c] = model.weights
        biases[c] = model.bias
        array_free_f32(model.classes)
        array_free_f32(y_binary)
        c = c + 1
    }

    return LinearSVCMulti {
        weights: weights,
        biases: biases,
        classes: classes,
        n_classes: n_found,
        n_features: n_features,
        fitted: true
    }
}

export function linear_svc_multi_decision_function(model: LinearSVCMulti, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let scores: ptr<f32> = array_new_f32(n * model.n_classes)

    let mut c: i32 = 0
    while c < model.n_classes {
        for i in 0 to n {
            let mut z: f32 = model.biases[c]
            for j in 0 to model.n_features {
                z = z + model.weights[c][j] * matrix_at(X, i, j)
            }
            scores[i * model.n_classes + c] = z
        }
        c = c + 1
    }

    return scores
}

export function linear_svc_multi_predict(model: LinearSVCMulti, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let scores: ptr<f32> = linear_svc_multi_decision_function(model, X)
    let preds: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = scores[i * model.n_classes]
        let mut c: i32 = 1
        while c < model.n_classes {
            let s: f32 = scores[i * model.n_classes + c]
            if s > best_score {
                best_score = s
                best_c = c
            }
            c = c + 1
        }
        preds[i] = model.classes[best_c]
    }

    array_free_f32(scores)
    return preds
}

export function linear_svc_multi_free(model: LinearSVCMulti) -> void {
    let mut c: i32 = 0
    while c < model.n_classes {
        array_free_f32(model.weights[c])
        c = c + 1
    }
    free(model.weights as ptr<void>)
    array_free_f32(model.biases)
    array_free_f32(model.classes)
}

# ============================================================================
# LinearSVR (epsilon-insensitive SVR via SGD)
# ============================================================================

export struct LinearSVR {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    C: f32,
    epsilon: f32,
    fitted: bool
}

export function linear_svr_fit(X: Matrix, y: ptr<f32>, C: f32, epsilon: f32, epochs: i32, lr: f32) -> LinearSVR {
    let n: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(n)
    let bias: f32 = 0.0

    for epoch in 0 to epochs {
        for i in 0 to X.rows {
            let mut pred: f32 = bias
            for j in 0 to n {
                pred = pred + weights[j] * matrix_at(X, i, j)
            }
            let err: f32 = pred - y[i]

            if err > epsilon {
                for j in 0 to n {
                    weights[j] = weights[j] - lr * (C * matrix_at(X, i, j) + weights[j] / (X.rows as f32))
                }
                bias = bias - lr * C
            } elif err < -epsilon {
                for j in 0 to n {
                    weights[j] = weights[j] - lr * (C * -matrix_at(X, i, j) + weights[j] / (X.rows as f32))
                }
                bias = bias + lr * C
            } else {
                for j in 0 to n {
                    weights[j] = weights[j] - lr * weights[j] / (X.rows as f32)
                }
            }
        }
    }

    return LinearSVR {
        weights: weights,
        bias: bias,
        n_features: n,
        C: C,
        epsilon: epsilon,
        fitted: true
    }
}

export function linear_svr_predict(model: LinearSVR, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut pred: f32 = model.bias
        for j in 0 to model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
        }
        preds[i] = pred
    }
    return preds
}

export function linear_svr_free(model: LinearSVR) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# KernelSVC (kernel SVM via precomputed kernel matrix approximation)
# Uses RBF kernel. Implements simplified SMO.
# ============================================================================

export struct KernelSVC {
    X_train: Matrix,
    y_train_dual: ptr<f32>,
    alphas: ptr<f32>,
    b: f32,
    n_samples: i32,
    n_features: i32,
    classes: ptr<f32>,
    n_classes: i32,
    gamma: f32,
    C: f32,
    fitted: bool
}

# Helper: compute SVM decision function output for sample j
function _svm_compute_ej(kernel: Matrix, alphas: ptr<f32>, y_dual: ptr<f32>, n: i32, b: f32, j: i32) -> f32 {
    let mut ej: f64 = 0.0
    let mut k: i32 = 0
    while k < n {
        ej = ej + (alphas[k] * y_dual[k] * matrix_at(kernel, j, k)) as f64
        k = k + 1
    }
    ej = ej + (b) as f64 - (y_dual[j]) as f64
    return ej as f32
}

export function kernel_svc_fit(X: Matrix, y: ptr<f32>, n_classes: i32, C: f32, gamma: f32, max_iter: i32) -> KernelSVC {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count
    let mut i: i32 = 0

    let y_dual: ptr<f32> = array_new_f32(n)
    i = 0
    while i < n {
        if y[i] == classes[1] {
            y_dual[i] = 1.0
        } else {
            y_dual[i] = -1.0
        }
        i = i + 1
    }

    let result: KernelSVC = _kernel_svc_smo(X, y_dual, classes, n_classes, C, gamma, max_iter)
    return result
}

# Wrapper: build kernel from X, then call precomputed SMO.
function _kernel_svc_smo(X: Matrix, y_dual: ptr<f32>, classes: ptr<f32>, n_classes: i32, C: f32, gamma: f32, max_iter: i32) -> KernelSVC {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Build kernel matrix in f64 (BLAS for large, scalar for small)
    let kernel_d: ptr<f64> = _build_full_kernel(X, n, n_features, gamma)

    # Identity index map
    let idx_map: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        idx_map[i] = i
    }

    let result: KernelSVC = _kernel_svc_smo_precomputed(X, y_dual, classes, n_classes, C, gamma, max_iter, kernel_d, idx_map, n)

    free(kernel_d as ptr<void>)
    free(idx_map as ptr<void>)
    return result
}

# Core SVM training using SMO (Sequential Minimal Optimization).
# Solves: min (1/2) alpha^T Q alpha - sum alpha_i  s.t. 0 <= alpha_i <= C
# where Q_ij = y_i * y_j * K[i,j].
# Takes y_dual directly (-1/+1) so callers can control class encoding.
# Takes a precomputed kernel matrix (full n_total x n_total) and an index
# array mapping local rows to kernel rows, so the multiclass wrapper can
# build the kernel once and slice it for each OvO pair.
function _kernel_svc_smo_precomputed(
    X: Matrix,
    y_dual: ptr<f32>,
    classes: ptr<f32>,
    n_classes: i32,
    C: f32,
    gamma: f32,
    max_iter: i32,
    kernel_full: ptr<f64>,
    idx_map: ptr<i32>,
    n_total: i32
) -> KernelSVC {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let alphas_d: ptr<f64> = array_new_f64(n)
    let mut b: f64 = 0.0
    let C_d: f64 = C as f64

    let y_d: ptr<f64> = array_new_f64(n)
    for i in 0 to n {
        y_d[i] = y_dual[i] as f64
    }

    # Extract the n x n sub-kernel for this pair from the full kernel.
    # Fold y_i * y_j into the kernel to get Q directly, saving one O(n^2) pass.
    let Q: ptr<f64> = malloc((n as i64) * (n as i64) * 8) as ptr<f64>
    for i in 0 to n {
        let gi: i32 = idx_map[i]
        let yi: f64 = y_d[i]
        for j in 0 to n {
            let gj: i32 = idx_map[j]
            Q[i * n + j] = yi * y_d[j] * kernel_full[gi * n_total + gj]
        }
    }

    # Maintain gradient incrementally: G[i] = sum_j Q[i,j] * alpha_j - 1
    let G: ptr<f64> = array_new_f64(n)
    for i in 0 to n {
        G[i] = -1.0
    }

    let tol: f64 = 0.001
    let mut iter: i32 = 0
    let mut examine_all: bool = true
    let mut n_changed: i32 = 0

    while iter < max_iter {
        n_changed = 0
        if examine_all {
            for i in 0 to n {
                if _smo_examine(i, n, alphas_d, y_d, G, Q, C_d, tol) {
                    n_changed = n_changed + 1
                }
            }
        } else {
            for i in 0 to n {
                if alphas_d[i] > 0.0 && alphas_d[i] < C_d {
                    if _smo_examine(i, n, alphas_d, y_d, G, Q, C_d, tol) {
                        n_changed = n_changed + 1
                    }
                }
            }
        }

        if examine_all {
            examine_all = false
        } elif n_changed == 0 {
            examine_all = true
        }

        iter = iter + 1
        if n_changed == 0 && examine_all {
            break
        }
    }

    # Compute bias from free support vectors (0 < alpha < C)
    # K[i,j] = Q[i,j] * y_i * y_j (since y^2 = 1, so 1/(y_i*y_j) = y_i*y_j)
    let mut n_free: i32 = 0
    for i in 0 to n {
        if alphas_d[i] > 0.0 && alphas_d[i] < C_d {
            let mut fi: f64 = 0.0
            for j in 0 to n {
                if alphas_d[j] > 0.0 {
                    let K_ij: f64 = Q[i * n + j] * y_d[i] * y_d[j]
                    fi = fi + alphas_d[j] * y_d[j] * K_ij
                }
            }
            b = b + (y_d[i] - fi)
            n_free = n_free + 1
        }
    }
    if n_free > 0 {
        b = b / (n_free as f64)
    }

    free(Q as ptr<void>)
    array_free_f64(G)
    array_free_f64(y_d)

    # Convert f64 alphas to f32 for storage
    let alphas: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        alphas[i] = alphas_d[i] as f32
    }
    array_free_f64(alphas_d)

    let X_copy: Matrix = matrix_copy(X)
    let result: KernelSVC = KernelSVC {
        X_train: X_copy,
        y_train_dual: y_dual,
        alphas: alphas,
        b: b as f32,
        n_samples: n,
        n_features: n_features,
        classes: classes,
        n_classes: n_classes,
        gamma: gamma,
        C: C,
        fitted: true
    }
    return result
}

# SMO: examine example i. Try to find a j that violates KKT and do a 2-variable step.
function _smo_examine(
    i2: i32,
    n: i32,
    alphas: ptr<f64>,
    y: ptr<f64>,
    G: ptr<f64>,
    Q: ptr<f64>,
    C: f64,
    tol: f64
) -> bool {
    let y2: f64 = y[i2]
    let alpha2: f64 = alphas[i2]
    # r = y_i * E_i = G[i] (since G[i] = y_i * E_i)
    let r2: f64 = G[i2]

    # KKT violation check
    if (r2 < -tol && alpha2 < C) || (r2 > tol && alpha2 > 0.0) {
        # Find j that maximizes |E1 - E2| (second-order heuristic)
        # E_i = G[i] * y_i
        let E2: f64 = G[i2] * y2
        let mut best_j: i32 = -1
        let mut best_gain: f64 = 0.0
        for j in 0 to n {
            if alphas[j] > 0.0 && alphas[j] < C {
                let E1: f64 = G[j] * y[j]
                let gain: f64 = (E1 - E2) * (E1 - E2)
                if gain > best_gain {
                    best_gain = gain
                    best_j = j
                }
            }
        }

        if best_j >= 0 {
            if _smo_step(best_j, i2, n, alphas, y, G, Q, C) {
                return true
            }
        }

        # Fall back to iterating over non-bound examples
        let mut start: i32 = (i2 + 1) % n
        let mut k: i32 = 0
        while k < n {
            let j: i32 = (start + k) % n
            if alphas[j] > 0.0 && alphas[j] < C {
                if _smo_step(j, i2, n, alphas, y, G, Q, C) {
                    return true
                }
            }
            k = k + 1
        }

        # Fall back to iterating over all examples
        let mut k2: i32 = 0
        while k2 < n {
            let j: i32 = (start + k2) % n
            if _smo_step(j, i2, n, alphas, y, G, Q, C) {
                return true
            }
            k2 = k2 + 1
        }
    }
    return false
}

# SMO 2-variable analytic step. Updates alpha_i1, alpha_i2, G, and returns true if progress.
function _smo_step(
    i1: i32,
    i2: i32,
    n: i32,
    alphas: ptr<f64>,
    y: ptr<f64>,
    G: ptr<f64>,
    Q: ptr<f64>,
    C: f64
) -> bool {
    if i1 == i2 { return false }

    let alpha1: f64 = alphas[i1]
    let alpha2: f64 = alphas[i2]
    let y1: f64 = y[i1]
    let y2: f64 = y[i2]

    # Q values
    let q11: f64 = Q[i1 * n + i1]
    let q12: f64 = Q[i1 * n + i2]
    let q22: f64 = Q[i2 * n + i2]

    let eta: f64 = q11 + q22 - 2.0 * q12

    # G[i] = y_i * E_i, so E_i = G[i] * y_i (since y_i^2 = 1)
    # SMO update: a2_new = alpha2 + y2 * (E1 - E2) / eta
    #            = alpha2 + (y1*y2*G[i1] - G[i2]) / eta
    let mut a2_new: f64 = 0.0
    if eta > 0.0000000001 {
        a2_new = alpha2 + (y1 * y2 * G[i1] - G[i2]) / eta
    } else {
        return false
    }

    # Clip
    let mut L: f64 = 0.0
    let mut H: f64 = C
    if y1 == y2 {
        L = alpha1 + alpha2 - C
        H = alpha1 + alpha2
        if L < 0.0 { L = 0.0 }
        if H > C { H = C }
    } else {
        L = alpha2 - alpha1
        H = alpha2 - alpha1 + C
        if L < 0.0 { L = 0.0 }
        if H > C { H = C }
    }

    if a2_new < L { a2_new = L }
    if a2_new > H { a2_new = H }

    let a1_new: f64 = alpha1 + y1 * y2 * (alpha2 - a2_new)

    # Check for negligible change
    let d2: f64 = a2_new - alpha2
    let d1: f64 = a1_new - alpha1
    let abs_d2: f64 = d2
    if d2 < 0.0 { abs_d2 = 0.0 - d2 }
    if abs_d2 < 0.0000000001 { return false }

    # Update alphas
    alphas[i1] = a1_new
    alphas[i2] = a2_new

    # Update gradient: G += d1 * Q[:,i1] + d2 * Q[:,i2]
    for j in 0 to n {
        G[j] = G[j] + d1 * Q[j * n + i1] + d2 * Q[j * n + i2]
    }

    return true
}

function _rbf_exp(neg_gamma_sum: f32) -> f32 {
    let val: f32 = exp((neg_gamma_sum) as f64) as f32
    return val
}

function _rbf_exp_f64(neg_gamma_sum: f64) -> f64 {
    let val: f64 = exp(neg_gamma_sum)
    return val
}

# BLAS-accelerated RBF kernel matrix computation.
# K[i,j] = exp(-gamma * ||x1_i - x2_j||^2)
# Uses the identity: ||a-b||^2 = ||a||^2 + ||b||^2 - 2*a^T*b
# The cross term a^T*b is computed via cblas_sgemm.
function _rbf_kernel_blas(X1: Matrix, X2: Matrix, gamma: f32) -> Matrix {
    let n1: i32 = X1.rows
    let n2: i32 = X2.rows
    let nf: i32 = X1.cols
    let result: Matrix = matrix_new(n1, n2)

    # Compute squared norms of X1 and X2
    let x1_sq: ptr<f32> = array_new_f32(n1)
    let x2_sq: ptr<f32> = array_new_f32(n2)
    for i in 0 to n1 {
        let mut s: f32 = 0.0
        for k in 0 to nf {
            let v: f32 = matrix_at(X1, i, k)
            s = s + v * v
        }
        x1_sq[i] = s
    }
    for j in 0 to n2 {
        let mut s: f32 = 0.0
        for k in 0 to nf {
            let v: f32 = matrix_at(X2, j, k)
            s = s + v * v
        }
        x2_sq[j] = s
    }

    # Cross term: X1 * X2^T via cblas_sgemm
    # X1 is n1 x nf (row-major), X2 is n2 x nf (row-major)
    # We need X1 * X2^T which is n1 x n2.
    # cblas_sgemm with transb=CblasTrans computes C = alpha * X1 * X2^T + beta * C
    let gamma_f: f32 = gamma
    let cross: ptr<f32> = malloc((n1 as i64) * (n2 as i64) * 4) as ptr<f32>
    # Use the BLAS matmat wrapper with transposed B
    # But our wrapper doesn't support trans. Call cblas_sgemm directly.
    cblas_sgemm(CBLAS_ROW_MAJOR, CBLAS_NO_TRANS, CBLAS_TRANS, n1, n2, nf, 1.0, X1.data, nf, X2.data, nf, 0.0, cross, n2)

    # Combine: sq_dist = x1_sq + x2_sq - 2*cross, then exp(-gamma * sq_dist)
    let gamma_d: f64 = gamma as f64
    for i in 0 to n1 {
        for j in 0 to n2 {
            let sq: f32 = x1_sq[i] + x2_sq[j] - 2.0 * cross[i * n2 + j]
            let val: f32 = _rbf_exp_f64(0.0 - gamma_d * (sq as f64)) as f32
            matrix_set(result, i, j, val)
        }
    }

    free(cross as ptr<void>)
    array_free_f32(x1_sq)
    array_free_f32(x2_sq)
    return result
}

# BLAS-accelerated f64 RBF kernel matrix for training.
# Returns a flat n1 x n2 f64 array (row-major).
# Uses f32 sgemm for the cross term (faster than dgemm), then casts to f64 for exp.
function _rbf_kernel_blas_f64(X1: Matrix, X2: Matrix, gamma: f32) -> ptr<f64> {
    let n1: i32 = X1.rows
    let n2: i32 = X2.rows
    let nf: i32 = X1.cols

    # Compute squared norms in f32 (cheap)
    let x1_sq: ptr<f32> = array_new_f32(n1)
    let x2_sq: ptr<f32> = array_new_f32(n2)
    for i in 0 to n1 {
        let mut s: f32 = 0.0
        for k in 0 to nf {
            let v: f32 = matrix_at(X1, i, k)
            s = s + v * v
        }
        x1_sq[i] = s
    }
    for j in 0 to n2 {
        let mut s: f32 = 0.0
        for k in 0 to nf {
            let v: f32 = matrix_at(X2, j, k)
            s = s + v * v
        }
        x2_sq[j] = s
    }

    # Cross term: X1 * X2^T via f32 cblas_sgemm (much faster than dgemm)
    let cross: ptr<f32> = malloc((n1 as i64) * (n2 as i64) * 4) as ptr<f32>
    cblas_sgemm(CBLAS_ROW_MAJOR, CBLAS_NO_TRANS, CBLAS_TRANS, n1, n2, nf, 1.0, X1.data, nf, X2.data, nf, 0.0, cross, n2)

    # Combine and apply exp in f64
    let gamma_d: f64 = gamma as f64
    let result: ptr<f64> = malloc((n1 as i64) * (n2 as i64) * 8) as ptr<f64>
    for i in 0 to n1 {
        for j in 0 to n2 {
            let sq: f64 = (x1_sq[i] + x2_sq[j] - 2.0 * cross[i * n2 + j]) as f64
            result[i * n2 + j] = _rbf_exp_f64(0.0 - gamma_d * sq)
        }
    }

    free(cross as ptr<void>)
    array_free_f32(x1_sq)
    array_free_f32(x2_sq)
    return result
}

function _rbf_kernel(X1: Matrix, X2: Matrix, gamma: f32) -> Matrix {
    let result: Matrix = matrix_new(X1.rows, X2.rows)
    for i in 0 to X1.rows {
        for j in 0 to X2.rows {
            let mut sum: f64 = 0.0
            for k in 0 to X1.cols {
                let d: f64 = (matrix_at(X1, i, k) - matrix_at(X2, j, k)) as f64
                sum = sum + d * d
            }
            let val: f32 = _rbf_exp_f64(0.0 - (gamma as f64) * sum) as f32
            matrix_set(result, i, j, val)
        }
    }
    return result
}

export function kernel_svc_decision_function(model: KernelSVC, X: Matrix) -> ptr<f32> {
    let n_test: i32 = X.rows
    let scores: ptr<f32> = array_new_f32(n_test)

    # Use BLAS-accelerated RBF kernel: K = exp(-gamma * ||x - x_train||^2)
    let K: Matrix = _rbf_kernel_blas(X, model.X_train, model.gamma)

    # scores = K * (alpha .* y_dual) + b
    # Build the coefficient vector
    let coef: ptr<f32> = array_new_f32(model.n_samples)
    for j in 0 to model.n_samples {
        coef[j] = model.alphas[j] * model.y_train_dual[j]
    }

    # scores = K * coef (BLAS sgemv)
    blas_matvec(K.data, n_test, model.n_samples, coef, scores, 1.0, 0.0)

    # Add bias
    let b_val: f32 = model.b
    for i in 0 to n_test {
        scores[i] = scores[i] + b_val
    }

    array_free_f32(coef)
    matrix_free(K)
    return scores
}

export function kernel_svc_predict(model: KernelSVC, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = kernel_svc_decision_function(model, X)
    return result
}

export function kernel_svc_decide(model: KernelSVC, scores: ptr<f32>, n_samples: i32) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        if scores[i] >= 0.0 {
            labels[i] = model.classes[1]
        } else {
            labels[i] = model.classes[0]
        }
    }
    return labels
}

export function kernel_svc_free(model: KernelSVC) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.y_train_dual)
    array_free_f32(model.alphas)
    array_free_f32(model.classes)
}

# Build full RBF kernel matrix. Always use BLAS because cblas_sgemm is faster
# than the scalar nested loop even for small arrays like 100-500.
function _build_full_kernel(X: Matrix, n: i32, n_features: i32, gamma: f32) -> ptr<f64> {
    return _rbf_kernel_blas_f64(X, X, gamma)
}

# ============================================================================
# Multi-class KernelSVC via One-vs-One (OvO)
# Trains one binary kernel SVM per pair of classes, matching sklearn's SVC.
# Prediction uses voting across all binary classifiers.
# ============================================================================

export struct KernelSVCMulti {
    models: ptr<KernelSVC>,
    pair_a: ptr<i32>,
    pair_b: ptr<i32>,
    classes: ptr<f32>,
    n_classes: i32,
    n_pairs: i32,
    n_features: i32,
    gamma: f32,
    C: f32,
    fitted: bool
}

export function kernel_svc_multi_fit(X: Matrix, y: ptr<f32>, n_classes: i32, gamma: f32, C: f32, max_iter: i32) -> KernelSVCMulti {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    # Build the full kernel matrix once in f64.
    # Use BLAS for large datasets, scalar for small (BLAS call overhead dominates below ~500 samples).
    let kernel_full: ptr<f64> = _build_full_kernel(X, n, n_features, gamma)

    # Count pairs: n_found * (n_found - 1) / 2
    let n_pairs: i32 = (n_found * (n_found - 1)) / 2
    let models: ptr<KernelSVC> = malloc((n_pairs as i64) * 128) as ptr<KernelSVC>
    let pair_a: ptr<i32> = malloc((n_pairs as i64) * 4) as ptr<i32>
    let pair_b: ptr<i32> = malloc((n_pairs as i64) * 4) as ptr<i32>

    let mut pair_idx: i32 = 0
    let mut a: i32 = 0
    while a < n_found {
        let mut b: i32 = a + 1
        while b < n_found {
            # Collect samples belonging to class a or class b
            let mut count: i32 = 0
            for i in 0 to n {
                if y[i] == classes[a] || y[i] == classes[b] {
                    count = count + 1
                }
            }

            let X_sub: Matrix = matrix_new(count, n_features)
            let y_dual: ptr<f32> = array_new_f32(count)
            let idx_map: ptr<i32> = malloc((count as i64) * 4) as ptr<i32>
            let mut idx: i32 = 0
            for i in 0 to n {
                if y[i] == classes[a] || y[i] == classes[b] {
                    for j in 0 to n_features {
                        matrix_set(X_sub, idx, j, matrix_at(X, i, j))
                    }
                    if y[i] == classes[a] {
                        y_dual[idx] = 1.0
                    } else {
                        y_dual[idx] = -1.0
                    }
                    idx_map[idx] = i
                    idx = idx + 1
                }
            }

            let binary_classes: ptr<f32> = array_new_f32(2)
            binary_classes[0] = -1.0
            binary_classes[1] = 1.0
            models[pair_idx] = _kernel_svc_smo_precomputed(X_sub, y_dual, binary_classes, 2, C, gamma, max_iter, kernel_full, idx_map, n)
            pair_a[pair_idx] = a
            pair_b[pair_idx] = b

            # idx_map is consumed by the solver (it copies the kernel slice).
            free(idx_map as ptr<void>)
            # X_sub is stored in the model (matrix_copy inside solver).
            matrix_free(X_sub)

            pair_idx = pair_idx + 1
            b = b + 1
        }
        a = a + 1
    }

    free(kernel_full as ptr<void>)

    return KernelSVCMulti {
        models: models,
        pair_a: pair_a,
        pair_b: pair_b,
        classes: classes,
        n_classes: n_found,
        n_pairs: n_pairs,
        n_features: n_features,
        gamma: gamma,
        C: C,
        fitted: true
    }
}

export function kernel_svc_multi_predict(model: KernelSVCMulti, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let total_votes: i32 = n * model.n_classes
    let votes: ptr<i32> = malloc((total_votes as i64) * 4) as ptr<i32>
    for i in 0 to total_votes {
        votes[i] = 0
    }

    let mut p: i32 = 0
    while p < model.n_pairs {
        let binary_scores: ptr<f32> = kernel_svc_predict(model.models[p], X)
        let a: i32 = model.pair_a[p]
        let b: i32 = model.pair_b[p]
        for i in 0 to n {
            if binary_scores[i] > 0.0 {
                votes[i * model.n_classes + a] = votes[i * model.n_classes + a] + 1
            } else {
                votes[i * model.n_classes + b] = votes[i * model.n_classes + b] + 1
            }
        }
        array_free_f32(binary_scores)
        p = p + 1
    }

    let preds: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_votes: i32 = votes[i * model.n_classes]
        let mut c: i32 = 1
        while c < model.n_classes {
            let v: i32 = votes[i * model.n_classes + c]
            if v > best_votes {
                best_votes = v
                best_c = c
            }
            c = c + 1
        }
        preds[i] = model.classes[best_c]
    }

    free(votes as ptr<void>)
    return preds
}

export function kernel_svc_multi_free(model: KernelSVCMulti) -> void {
    let mut p: i32 = 0
    while p < model.n_pairs {
        kernel_svc_free(model.models[p])
        p = p + 1
    }
    free(model.models as ptr<void>)
    free(model.pair_a as ptr<void>)
    free(model.pair_b as ptr<void>)
    array_free_f32(model.classes)
}

# ============================================================================
# NuSVC
# ============================================================================

export struct NuSVC {
    X_train: Matrix,
    y_train_dual: ptr<f32>,
    alphas: ptr<f32>,
    b: f32,
    classes: ptr<f32>,
    n_classes: i32,
    n_support: i32,
    gamma: f32,
    nu: f32,
    fitted: bool
}

export function nu_svc_fit(X: Matrix, y: ptr<f32>, nu: f32, gamma: f32, max_iter: i32, C: f32) -> NuSVC {
    let n: i32 = X.rows
    let p: i32 = X.cols

    # Detect classes from data
    # Issue #398: classes held exactly 2 entries here and the loop appended one
    # entry per distinct label with no check, so three or more distinct labels
    # wrote past it.
    let found_classes: DistinctF32 = distinct_f32(y, n, 2)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count
    let mut i: i32 = 0

    let y_dual: ptr<f32> = array_new_f32(n)
    i = 0
    while i < n {
        if y[i] == classes[1] {
            y_dual[i] = 1.0
        } else {
            y_dual[i] = -1.0
        }
        i = i + 1
    }

    # nu-SVM: upper bound is C/nu, and sum(alpha_i * y_i) = 0
    # The nu parameter controls the fraction of support vectors and errors.
    let alpha_upper: f32 = C / nu
    let kernel: Matrix = _rbf_kernel(X, X, gamma)

    let alphas: ptr<f32> = array_new_f32(n)
    for i in 0 to n { alphas[i] = 0.0 }

    let mut b: f32 = 0.0
    let tol: f32 = 0.001

    # SMO with nu constraint. We maintain sum(y_i * alpha_i) = 0
    # by only updating pairs (i, j) where y_dual[i] != y_dual[j].
    let mut iter: i32 = 0
    let mut examine_all: bool = true
    let mut num_changed: i32 = 1

    while (num_changed > 0 || examine_all) && iter < max_iter {
        num_changed = 0

        if examine_all {
            i = 0
            while i < n {
                let mut ei: f64 = 0.0
                for j in 0 to n {
                    ei = ei + (alphas[j] * y_dual[j] * matrix_at(kernel, i, j)) as f64
                }
                ei = ei + (b) as f64 - (y_dual[i]) as f64
                let ei_f: f32 = ei as f32

                let yi_ei: f32 = y_dual[i] * ei_f
                if (yi_ei < -tol && alphas[i] < alpha_upper) || (yi_ei > tol && alphas[i] > 0.0) {
                    # Pick j with opposite label to maintain sum constraint
                    let mut best_j: i32 = -1
                    let mut best_gain: f32 = 0.0
                    for j in 0 to n {
                        if j == i { continue }
                        if y_dual[j] == y_dual[i] { continue }
                        let ej: f32 = _svm_compute_ej(kernel, alphas, y_dual, n, b, j)
                        let diff: f32 = ei_f - ej
                        let abs_diff: f32 = diff
                        if diff < 0.0 { abs_diff = -diff }
                        if abs_diff > best_gain {
                            best_gain = abs_diff
                            best_j = j
                        }
                    }

                    if best_j >= 0 {
                        let j2: i32 = best_j
                        let ej: f32 = _svm_compute_ej(kernel, alphas, y_dual, n, b, j2)

                        let alpha_i_old: f32 = alphas[i]
                        let alpha_j_old: f32 = alphas[j2]

                        # For opposite labels: L = max(0, aj - ai), H = min(Cnu, Cnu + aj - ai)
                        let mut L: f32 = alpha_j_old - alpha_i_old
                        let mut H: f32 = alpha_upper + alpha_j_old - alpha_i_old
                        if L < 0.0 { L = 0.0 }
                        if H > alpha_upper { H = alpha_upper }

                        if L == H { i = i + 1; continue }

                        let eta: f32 = 2.0 * matrix_at(kernel, i, j2) - matrix_at(kernel, i, i) - matrix_at(kernel, j2, j2)
                        if eta >= -0.0000000001 { i = i + 1; continue }

                        let mut alpha_j_new: f32 = alpha_j_old - y_dual[j2] * (ei_f - ej) / eta
                        if alpha_j_new < L { alpha_j_new = L }
                        if alpha_j_new > H { alpha_j_new = H }

                        # Maintain sum(y_i * alpha_i) = 0:
                        # y_i * (ai_new - ai_old) + y_j * (aj_new - aj_old) = 0
                        # Since y_j = -y_i: ai_new = ai_old + (aj_old - aj_new)
                        let alpha_i_new: f32 = alpha_i_old + (alpha_j_old - alpha_j_new)

                        if alpha_i_new < 0.0 || alpha_i_new > alpha_upper {
                            i = i + 1
                            continue
                        }

                        alphas[i] = alpha_i_new
                        alphas[j2] = alpha_j_new

                        let b1: f32 = b - ei_f - y_dual[i] * (alpha_i_new - alpha_i_old) * matrix_at(kernel, i, i) - y_dual[j2] * (alpha_j_new - alpha_j_old) * matrix_at(kernel, i, j2)
                        let b2: f32 = b - ej - y_dual[i] * (alpha_i_new - alpha_i_old) * matrix_at(kernel, i, j2) - y_dual[j2] * (alpha_j_new - alpha_j_old) * matrix_at(kernel, j2, j2)

                        if alpha_i_new > 0.0 && alpha_i_new < alpha_upper {
                            b = b1
                        } elif alpha_j_new > 0.0 && alpha_j_new < alpha_upper {
                            b = b2
                        } else {
                            b = (b1 + b2) / 2.0
                        }

                        num_changed = num_changed + 1
                    }
                }
                i = i + 1
            }
        } else {
            i = 0
            while i < n {
                if alphas[i] > 0.0 && alphas[i] < alpha_upper {
                    let mut ei: f64 = 0.0
                    for j in 0 to n {
                        ei = ei + (alphas[j] * y_dual[j] * matrix_at(kernel, i, j)) as f64
                    }
                    ei = ei + (b) as f64 - (y_dual[i]) as f64
                    let ei_f: f32 = ei as f32

                    let yi_ei: f32 = y_dual[i] * ei_f
                    if (yi_ei < -tol && alphas[i] < alpha_upper) || (yi_ei > tol && alphas[i] > 0.0) {
                        let mut best_j: i32 = -1
                        let mut best_gain: f32 = 0.0
                        for j in 0 to n {
                            if j == i { continue }
                            if y_dual[j] == y_dual[i] { continue }
                            let ej: f32 = _svm_compute_ej(kernel, alphas, y_dual, n, b, j)
                            let diff: f32 = ei_f - ej
                            let abs_diff: f32 = diff
                            if diff < 0.0 { abs_diff = -diff }
                            if abs_diff > best_gain {
                                best_gain = abs_diff
                                best_j = j
                            }
                        }

                        if best_j >= 0 {
                            let j2: i32 = best_j
                            let ej: f32 = _svm_compute_ej(kernel, alphas, y_dual, n, b, j2)

                            let alpha_i_old: f32 = alphas[i]
                            let alpha_j_old: f32 = alphas[j2]

                            let mut L: f32 = alpha_j_old - alpha_i_old
                            let mut H: f32 = alpha_upper + alpha_j_old - alpha_i_old
                            if L < 0.0 { L = 0.0 }
                            if H > alpha_upper { H = alpha_upper }

                            if L == H { i = i + 1; continue }

                            let eta: f32 = 2.0 * matrix_at(kernel, i, j2) - matrix_at(kernel, i, i) - matrix_at(kernel, j2, j2)
                            if eta >= -0.0000000001 { i = i + 1; continue }

                            let mut alpha_j_new: f32 = alpha_j_old - y_dual[j2] * (ei_f - ej) / eta
                            if alpha_j_new < L { alpha_j_new = L }
                            if alpha_j_new > H { alpha_j_new = H }

                            let alpha_i_new: f32 = alpha_i_old + (alpha_j_old - alpha_j_new)

                            if alpha_i_new < 0.0 || alpha_i_new > alpha_upper {
                                i = i + 1
                                continue
                            }

                            alphas[i] = alpha_i_new
                            alphas[j2] = alpha_j_new

                            let b1: f32 = b - ei_f - y_dual[i] * (alpha_i_new - alpha_i_old) * matrix_at(kernel, i, i) - y_dual[j2] * (alpha_j_new - alpha_j_old) * matrix_at(kernel, i, j2)
                            let b2: f32 = b - ej - y_dual[i] * (alpha_i_new - alpha_i_old) * matrix_at(kernel, i, j2) - y_dual[j2] * (alpha_j_new - alpha_j_old) * matrix_at(kernel, j2, j2)

                            if alpha_i_new > 0.0 && alpha_i_new < alpha_upper {
                                b = b1
                            } elif alpha_j_new > 0.0 && alpha_j_new < alpha_upper {
                                b = b2
                            } else {
                                b = (b1 + b2) / 2.0
                            }

                            num_changed = num_changed + 1
                        }
                    }
                }
                i = i + 1
            }
        }

        if examine_all {
            examine_all = false
        } elif num_changed == 0 {
            examine_all = true
        }

        iter = iter + 1
    }

    matrix_free(kernel)

    let mut n_support: i32 = 0
    for i in 0 to n {
        if alphas[i] > 0.000001 { n_support = n_support + 1 }
    }

    let X_copy: Matrix = matrix_copy(X)

    return NuSVC {
        X_train: X_copy,
        y_train_dual: y_dual,
        alphas: alphas,
        b: b,
        classes: classes,
        n_classes: 2,
        n_support: n_support,
        gamma: gamma,
        nu: nu,
        fitted: true
    }
}

export function nu_svc_predict(model: NuSVC, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.X_train.cols
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut decision: f32 = -model.b
        for j in 0 to model.X_train.rows {
            if model.alphas[j] < 0.0000000001 { continue }
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                s = s + d * d
            }
            decision = decision + model.alphas[j] * model.y_train_dual[j] * exp((-model.gamma * s) as f64) as f32
        }
        if decision > 0 {
            result[i] = model.classes[1]
        } else {
            result[i] = model.classes[0]
        }
    }
    return result
}

export function nu_svc_free(model: NuSVC) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.y_train_dual)
    array_free_f32(model.alphas)
    array_free_f32(model.classes)
}

# ============================================================================
# NuSVR
# ============================================================================

export struct NuSVR {
    X_train: Matrix,
    y_train: ptr<f32>,
    alphas: ptr<f32>,
    b: f32,
    gamma: f32,
    nu: f32,
    C: f32,
    n_support: i32,
    fitted: bool
}

export function nu_svr_fit(X: Matrix, y: ptr<f32>, nu: f32, C: f32, gamma: f32, max_iter: i32) -> NuSVR {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let alphas: ptr<f32> = array_new_f32(n)
    for i in 0 to n { alphas[i] = 0.0 }
    let mut b: f32 = 0.0

    let alpha_max: f32 = C / (nu * (n as f32))

    for iter in 0 to max_iter {
        for i in 0 to n {
            let mut g_i: f32 = y[i] - b
            for j in 0 to n {
                if (fabs((alphas[j]) as f64) as f32) < 0.0000000001 { continue }
                let mut s: f32 = 0.0
                for k in 0 to p {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    s = s + d * d
                }
                g_i = g_i - alphas[j] * exp((-gamma * s) as f64) as f32
            }

            if g_i > 0 && alphas[i] < alpha_max {
                alphas[i] = alphas[i] + 0.01
            } else {
                if g_i < 0 && alphas[i] > -alpha_max {
                    alphas[i] = alphas[i] - 0.01
                }
            }
        }
    }

    let mut n_support: i32 = 0
    for i in 0 to n {
        if (fabs((alphas[i]) as f64) as f32) > 0.000001 { n_support = n_support + 1 }
    }

    return NuSVR {
        X_train: X,
        y_train: y,
        alphas: alphas,
        b: b,
        gamma: gamma,
        nu: nu,
        C: C,
        n_support: n_support,
        fitted: true
    }
}

export function nu_svr_predict(model: NuSVR, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.X_train.cols
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut pred: f32 = model.b
        for j in 0 to model.X_train.rows {
            if (fabs((model.alphas[j]) as f64) as f32) < 0.0000000001 { continue }
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                s = s + d * d
            }
            pred = pred + model.alphas[j] * exp((-model.gamma * s) as f64) as f32
        }
        result[i] = pred
    }
    return result
}

export function nu_svr_free(model: NuSVR) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.y_train)
    array_free_f32(model.alphas)
}

# ============================================================================
# OneClassSVM
# ============================================================================

export struct OneClassSVM {
    X_train: Matrix,
    alphas: ptr<f32>,
    b: f32,
    gamma: f32,
    nu: f32,
    n_support: i32,
    threshold: f32,
    fitted: bool
}

export function one_class_svm_fit(X: Matrix, nu: f32, gamma: f32, max_iter: i32) -> OneClassSVM {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let alphas: ptr<f32> = array_new_f32(n)
    let alpha_max: f32 = 1.0 / (nu * (n as f32))
    for i in 0 to n { alphas[i] = alpha_max / 2.0 }

    let mut b: f32 = 0.0

    for iter in 0 to max_iter {
        for i in 0 to n {
            let mut g_i: f32 = -b
            for j in 0 to n {
                let mut s: f32 = 0.0
                for k in 0 to p {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                    s = s + d * d
                }
                g_i = g_i + alphas[j] * exp((-gamma * s) as f64) as f32
            }

            if g_i > 0 && alphas[i] < alpha_max {
                alphas[i] = alphas[i] + 0.001
            } else {
                if g_i < 0 && alphas[i] > 0 {
                    alphas[i] = alphas[i] - 0.001
                    if alphas[i] < 0 { alphas[i] = 0.0 }
                }
            }
        }
    }

    let mut threshold: f32 = 0.0
    for i in 0 to n {
        let mut g_i: f32 = -b
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            g_i = g_i + alphas[j] * exp((-gamma * s) as f64) as f32
        }
        threshold = threshold + g_i
    }
    threshold = threshold / (n as f32)

    let mut n_support: i32 = 0
    for i in 0 to n {
        if alphas[i] > 0.000001 { n_support = n_support + 1 }
    }

    return OneClassSVM {
        X_train: X,
        alphas: alphas,
        b: b,
        gamma: gamma,
        nu: nu,
        n_support: n_support,
        threshold: threshold,
        fitted: true
    }
}

export function one_class_svm_predict(model: OneClassSVM, X: Matrix) -> ptr<i32> {
    let n: i32 = X.rows
    let p: i32 = model.X_train.cols
    let result: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    for i in 0 to n {
        let mut score: f32 = -model.b
        for j in 0 to model.X_train.rows {
            if model.alphas[j] < 0.0000000001 { continue }
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                s = s + d * d
            }
            score = score + model.alphas[j] * exp((-model.gamma * s) as f64) as f32
        }
        if score < model.threshold {
            result[i] = -1
        } else {
            result[i] = 1
        }
    }
    return result
}

export function one_class_svm_free(model: OneClassSVM) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.alphas)
}

# ============================================================================
# SVC (Support Vector Classification) with kernel support via SMO
# Kernels: RBF, linear, polynomial, sigmoid
# Multi-class via one-vs-rest
# ============================================================================

export const KERNEL_POLY: i32 = 2
export const KERNEL_SIGMOID: i32 = 3

struct SMOResult {
    alphas: ptr<f32>,
    b: f32
}

export struct SVC {
    X_train: Matrix,
    alphas: ptr<f32>,
    y_dual: ptr<f32>,
    b: ptr<f32>,
    n_samples: i32,
    n_features: i32,
    classes: ptr<f32>,
    n_classes: i32,
    gamma: f32,
    C: f32,
    kernel: i32,
    degree: i32,
    coef0: f32,
    fitted: bool
}

export struct SVR {
    X_train: Matrix,
    alpha_diff: ptr<f32>,
    b: f32,
    n_samples: i32,
    n_features: i32,
    gamma: f32,
    C: f32,
    epsilon: f32,
    kernel: i32,
    degree: i32,
    coef0: f32,
    fitted: bool
}

function _svm_pow_f32(base: f32, exp: i32) -> f32 {
    let mut result: f32 = 1.0
    for _ in 0 to exp {
        result = result * base
    }
    return result
}

function _svm_tanh_f32(x: f32) -> f32 {
    let e1: f64 = exp(x as f64)
    let e2: f64 = exp((0.0 - x) as f64)
    let val: f32 = ((e1 - e2) / (e1 + e2)) as f32
    return val
}

function _svm_kernel_rows(X1: Matrix, i1: i32, X2: Matrix, i2: i32, n_features: i32, kernel: i32, gamma: f32, degree: i32, coef0: f32) -> f32 {
    if kernel == KERNEL_LINEAR {
        let mut s: f32 = 0.0
        for k in 0 to n_features {
            s = s + matrix_at(X1, i1, k) * matrix_at(X2, i2, k)
        }
        return s
    }
    if kernel == KERNEL_POLY {
        let mut s: f32 = 0.0
        for k in 0 to n_features {
            s = s + matrix_at(X1, i1, k) * matrix_at(X2, i2, k)
        }
        let base: f32 = gamma * s + coef0
        let val: f32 = _svm_pow_f32(base, degree)
        return val
    }
    if kernel == KERNEL_RBF {
        let mut s: f32 = 0.0
        for k in 0 to n_features {
            let d: f32 = matrix_at(X1, i1, k) - matrix_at(X2, i2, k)
            s = s + d * d
        }
        let val: f32 = exp((0.0 - gamma * s) as f64) as f32
        return val
    }
    if kernel == KERNEL_SIGMOID {
        let mut s: f32 = 0.0
        for k in 0 to n_features {
            s = s + matrix_at(X1, i1, k) * matrix_at(X2, i2, k)
        }
        let val: f32 = _svm_tanh_f32(gamma * s + coef0)
        return val
    }
    let mut s: f32 = 0.0
    for k in 0 to n_features {
        s = s + matrix_at(X1, i1, k) * matrix_at(X2, i2, k)
    }
    return s
}

function _svm_kernel_matrix(X: Matrix, kernel: i32, gamma: f32, degree: i32, coef0: f32) -> Matrix {
    let n: i32 = X.rows
    let K: Matrix = matrix_new(n, n)
    for i in 0 to n {
        for j in 0 to n {
            let val: f32 = _svm_kernel_rows(X, i, X, j, X.cols, kernel, gamma, degree, coef0)
            matrix_set(K, i, j, val)
        }
    }
    return K
}

function _smo_train(K: Matrix, y_dual: ptr<f32>, n: i32, C: f32, max_iter: i32) -> SMOResult {
    let alphas: ptr<f32> = array_new_f32(n)
    let mut b: f32 = 0.0
    let tol: f32 = 0.001

    let mut iter: i32 = 0
    let mut passes_without_change: i32 = 0
    while iter < max_iter && passes_without_change < 5 {
        let mut num_changed: i32 = 0

        for i in 0 to n {
            let mut ei: f32 = 0.0
            for j in 0 to n {
                ei = ei + alphas[j] * y_dual[j] * matrix_at(K, i, j)
            }
            ei = ei + b - y_dual[i]

            let yi_ei: f32 = y_dual[i] * ei
            if (yi_ei < -tol && alphas[i] < C) || (yi_ei > tol && alphas[i] > 0.0) {
                # Platt-style second-choice heuristic: choose the partner
                # with the largest |E_i - E_j| so each step has useful gain.
                let mut j: i32 = -1
                let mut best_gap: f32 = -1.0
                for candidate in 0 to n {
                    if candidate != i {
                        let mut candidate_e: f32 = 0.0
                        for k in 0 to n {
                            candidate_e = candidate_e + alphas[k] * y_dual[k] * matrix_at(K, candidate, k)
                        }
                        candidate_e = candidate_e + b - y_dual[candidate]
                        let mut gap: f32 = ei - candidate_e
                        if gap < 0.0 { gap = -gap }
                        if gap > best_gap {
                            best_gap = gap
                            j = candidate
                        }
                    }
                }
                if j < 0 { continue }

                let mut ej: f32 = 0.0
                for k in 0 to n {
                    ej = ej + alphas[k] * y_dual[k] * matrix_at(K, j, k)
                }
                ej = ej + b - y_dual[j]

                let alpha_i_old: f32 = alphas[i]
                let alpha_j_old: f32 = alphas[j]

                let mut L: f32 = 0.0
                let mut H: f32 = C
                if y_dual[i] == y_dual[j] {
                    L = alpha_i_old + alpha_j_old - C
                    H = alpha_i_old + alpha_j_old
                    if L < 0.0 {
                        L = 0.0
                    }
                    if H > C {
                        H = C
                    }
                } else {
                    # Standard SMO bounds when y_i != y_j:
                    # L=max(0, a_j-a_i), H=min(C, C+a_j-a_i).
                    L = alpha_j_old - alpha_i_old
                    H = alpha_j_old - alpha_i_old + C
                    if L < 0.0 {
                        L = 0.0
                    }
                    if H > C {
                        H = C
                    }
                }

                if L == H {
                    continue
                }

                let eta: f32 = 2.0 * matrix_at(K, i, j) - matrix_at(K, i, i) - matrix_at(K, j, j)
                if eta >= 0.0 {
                    continue
                }

                let mut alpha_j_new: f32 = alpha_j_old - y_dual[j] * (ei - ej) / eta
                if alpha_j_new < L {
                    alpha_j_new = L
                }
                if alpha_j_new > H {
                    alpha_j_new = H
                }

                let alpha_i_new: f32 = alpha_i_old + y_dual[i] * y_dual[j] * (alpha_j_old - alpha_j_new)

                alphas[i] = alpha_i_new
                alphas[j] = alpha_j_new

                let b1: f32 = b - ei - y_dual[i] * (alpha_i_new - alpha_i_old) * matrix_at(K, i, i) - y_dual[j] * (alpha_j_new - alpha_j_old) * matrix_at(K, i, j)
                let b2: f32 = b - ej - y_dual[i] * (alpha_i_new - alpha_i_old) * matrix_at(K, i, j) - y_dual[j] * (alpha_j_new - alpha_j_old) * matrix_at(K, j, j)

                if alpha_i_new > 0.0 && alpha_i_new < C {
                    b = b1
                } elif alpha_j_new > 0.0 && alpha_j_new < C {
                    b = b2
                } else {
                    b = (b1 + b2) / 2.0
                }

                num_changed = num_changed + 1
            }
        }

        iter = iter + 1
        if num_changed == 0 {
            passes_without_change = passes_without_change + 1
        } else {
            passes_without_change = 0
        }
    }

    let result: SMOResult = SMOResult { alphas: alphas, b: b }
    return result
}

export function svc_fit(X: Matrix, y: ptr<f32>, n_classes: i32, C: f32, kernel: i32, gamma: f32, degree: i32, coef0: f32) -> SVC {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    let K: Matrix = _svm_kernel_matrix(X, kernel, gamma, degree, coef0)

    let total_size: i32 = n_classes * n
    let alphas_all: ptr<f32> = array_new_f32(total_size)
    let y_dual_all: ptr<f32> = array_new_f32(total_size)
    let b_all: ptr<f32> = array_new_f32(n_classes)

    let max_iter: i32 = 1000

    for c in 0 to n_classes {
        let y_dual: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            if y[i] == classes[c] {
                y_dual[i] = 1.0
            } else {
                y_dual[i] = -1.0
            }
        }

        let smo: SMOResult = _smo_train(K, y_dual, n, C, max_iter)

        for i in 0 to n {
            alphas_all[c * n + i] = smo.alphas[i]
            y_dual_all[c * n + i] = y_dual[i]
        }
        b_all[c] = smo.b

        array_free_f32(smo.alphas)
        array_free_f32(y_dual)
    }

    matrix_free(K)

    let result: SVC = SVC {
        X_train: matrix_copy(X),
        alphas: alphas_all,
        y_dual: y_dual_all,
        b: b_all,
        n_samples: n,
        n_features: n_features,
        classes: classes,
        n_classes: n_classes,
        gamma: gamma,
        C: C,
        kernel: kernel,
        degree: degree,
        coef0: coef0,
        fitted: true
    }
    return result
}

export function svc_decision_function(model: SVC, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let scores: ptr<f32> = array_new_f32(n * model.n_classes)

    for i in 0 to n {
        for c in 0 to model.n_classes {
            let mut sum: f32 = model.b[c]
            for j in 0 to model.n_samples {
                let a: f32 = model.alphas[c * model.n_samples + j]
                if a > 0.0 {
                    let k_val: f32 = _svm_kernel_rows(X, i, model.X_train, j, model.n_features, model.kernel, model.gamma, model.degree, model.coef0)
                    let yd: f32 = model.y_dual[c * model.n_samples + j]
                    sum = sum + a * yd * k_val
                }
            }
            scores[i * model.n_classes + c] = sum
        }
    }

    return scores
}

export function svc_predict(model: SVC, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let scores: ptr<f32> = svc_decision_function(model, X)
    let labels: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = scores[i * model.n_classes + 0]
        for c in 1 to model.n_classes {
            let s: f32 = scores[i * model.n_classes + c]
            if s > best_score {
                best_score = s
                best_c = c
            }
        }
        labels[i] = model.classes[best_c]
    }

    array_free_f32(scores)
    return labels
}

export function svc_free(model: SVC) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.alphas)
    array_free_f32(model.y_dual)
    array_free_f32(model.b)
    array_free_f32(model.classes)
}

# ============================================================================
# SVR (Support Vector Regression) with epsilon-tube loss and kernel support
# ============================================================================

export function svr_fit(X: Matrix, y: ptr<f32>, C: f32, epsilon: f32, kernel: i32, gamma: f32, degree: i32, coef0: f32) -> SVR {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let K: Matrix = _svm_kernel_matrix(X, kernel, gamma, degree, coef0)

    let alpha_diff: ptr<f32> = array_new_f32(n)
    let mut b: f32 = 0.0

    let max_iter: i32 = 1000
    let step: f32 = 0.01

    for iter in 0 to max_iter {
        let mut num_changed: i32 = 0
        for i in 0 to n {
            let mut f_i: f32 = b
            for j in 0 to n {
                f_i = f_i + alpha_diff[j] * matrix_at(K, i, j)
            }

            let g_i: f32 = y[i] - f_i

            if g_i > epsilon && alpha_diff[i] < C {
                alpha_diff[i] = alpha_diff[i] + step
                if alpha_diff[i] > C {
                    alpha_diff[i] = C
                }
                num_changed = num_changed + 1
            } elif g_i < -epsilon && alpha_diff[i] > -C {
                alpha_diff[i] = alpha_diff[i] - step
                if alpha_diff[i] < -C {
                    alpha_diff[i] = -C
                }
                num_changed = num_changed + 1
            }
        }
        if num_changed == 0 {
            break
        }
    }

    let mut b_sum: f32 = 0.0
    let mut b_count: i32 = 0
    for i in 0 to n {
        let ad: f32 = fabs((alpha_diff[i]) as f64) as f32
        if ad > 0.001 {
            let mut f_i: f32 = 0.0
            for j in 0 to n {
                f_i = f_i + alpha_diff[j] * matrix_at(K, i, j)
            }
            b_sum = b_sum + (y[i] - f_i)
            b_count = b_count + 1
        }
    }
    if b_count > 0 {
        b = b_sum / (b_count as f32)
    }

    matrix_free(K)

    let result: SVR = SVR {
        X_train: matrix_copy(X),
        alpha_diff: alpha_diff,
        b: b,
        n_samples: n,
        n_features: n_features,
        gamma: gamma,
        C: C,
        epsilon: epsilon,
        kernel: kernel,
        degree: degree,
        coef0: coef0,
        fitted: true
    }
    return result
}

export function svr_predict(model: SVR, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut sum: f32 = model.b
        for j in 0 to model.n_samples {
            let ad: f32 = fabs((model.alpha_diff[j]) as f64) as f32
            if ad > 0.0 {
                let k_val: f32 = _svm_kernel_rows(X, i, model.X_train, j, model.n_features, model.kernel, model.gamma, model.degree, model.coef0)
                sum = sum + model.alpha_diff[j] * k_val
            }
        }
        preds[i] = sum
    }

    return preds
}

export function svr_free(model: SVR) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.alpha_diff)
}

# ============================================================================
# LS-SVM (Least Squares SVM) classifier via KernelRidge one-vs-rest.
# Solves (K + alpha*I) w = y for each class, then picks argmax.
# More reliable than SMO for multi-class problems.
# ============================================================================

export struct LSSVMClassifier {
    models: ptr<KernelRidge>,
    classes: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    gamma: f32,
    alpha: f32,
    fitted: bool
}

export function lssvm_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, gamma: f32, alpha: f32) -> LSSVMClassifier {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Issue #398: this used to append at classes[n_found] with no check against
    # the classes allocation, which wrote past it whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    let models: ptr<KernelRidge> = malloc((n_found as i64) * 256) as ptr<KernelRidge>

    let mut c: i32 = 0
    while c < n_found {
        let y_bin: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            if y[i] == classes[c] {
                y_bin[i] = 1.0
            } else {
                y_bin[i] = -1.0
            }
        }
        models[c] = kernel_ridge_fit(X, y_bin, alpha, 1, gamma, 3, 0.0)
        array_free_f32(y_bin)
        c = c + 1
    }

    return LSSVMClassifier {
        models: models,
        classes: classes,
        n_classes: n_found,
        n_features: n_features,
        gamma: gamma,
        alpha: alpha,
        fitted: true
    }
}

export function lssvm_classifier_predict(model: LSSVMClassifier, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(n)

    # Compute scores for each class, then pick argmax.
    let all_scores: ptr<f32> = malloc((n as i64) * (model.n_classes as i64) * 4) as ptr<f32>
    let mut c2: i32 = 0
    while c2 < model.n_classes {
        let scores: ptr<f32> = kernel_ridge_predict(model.models[c2], X)
        for i in 0 to n {
            all_scores[i * model.n_classes + c2] = scores[i]
        }
        array_free_f32(scores)
        c2 = c2 + 1
    }

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = all_scores[i * model.n_classes + 0]
        let mut c3: i32 = 1
        while c3 < model.n_classes {
            if all_scores[i * model.n_classes + c3] > best_score {
                best_score = all_scores[i * model.n_classes + c3]
                best_c = c3
            }
            c3 = c3 + 1
        }
        preds[i] = model.classes[best_c]
    }

    free(all_scores as ptr<void>)
    return preds
}

export function lssvm_classifier_free(model: LSSVMClassifier) -> void {
    let mut c: i32 = 0
    while c < model.n_classes {
        kernel_ridge_free(model.models[c])
        c = c + 1
    }
    free(model.models as ptr<void>)
    array_free_f32(model.classes)
}
