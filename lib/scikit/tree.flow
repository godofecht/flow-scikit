# Decision tree module for flow-scikit.
# Implements CART-style decision trees for classification and regression.

import "lib/scikit/matrix.flow"
import "lib/scikit/prng.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(count: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function fabs(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

export const TREE_MAX_DEPTH: i32 = 50
export const TREE_MIN_SAMPLES_SPLIT: i32 = 2
export const TREE_MIN_SAMPLES_LEAF: i32 = 1

export const CRITERION_GINI: i32 = 0
export const CRITERION_ENTROPY: i32 = 1
export const CRITERION_MSE: i32 = 2
export const CRITERION_MAE: i32 = 3

# Node arrays for this struct are allocated with calloc, never malloc.
# The builders write only the fields each node kind needs: a leaf leaves
# feature and threshold alone, an internal node leaves value alone, and the
# ExtraTree builders also leave n_samples and impurity alone. With malloc
# those fields hold whatever the allocator handed back, so two runs that fit
# the same tree on the same data produce different bytes. Nothing reads an
# unwritten field, so prediction is unaffected, but it makes per-node learned
# structure impossible to compare against sklearn.
# sizeof(TreeNode) is 32 on arm64: eight 4-byte fields, with the bool padded
# to 4. The stride below stays at the repo's generous 36 so the tail padding
# is zeroed too, which no per-field write could reach.
export struct TreeNode {
    feature: i32,
    threshold: f32,
    left: i32,
    right: i32,
    is_leaf: bool,
    value: f32,
    n_samples: i32,
    impurity: f32
}

export struct DecisionTreeClassifier {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    criterion: i32,
    n_classes: i32,
    classes: ptr<f32>,
    fitted: bool
}

export struct DecisionTreeRegressor {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    criterion: i32,
    fitted: bool
}

function _gini(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        counts[c] = 0
    }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] {
                counts[c] = counts[c] + 1
            }
        }
    }
    let mut impurity: f32 = 1.0
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / (n as f32)
        impurity = impurity - p * p
    }
    free(counts as ptr<void>)
    return impurity
}

function _entropy(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        counts[c] = 0
    }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] {
                counts[c] = counts[c] + 1
            }
        }
    }
    let mut impurity: f32 = 0.0
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / (n as f32)
        if p > 0.0 {
            let log_p: f64 = log(p as f64)
            impurity = impurity - p * (log_p as f32)
        }
    }
    free(counts as ptr<void>)
    return impurity
}

function _mse(y: ptr<f32>, n: i32) -> f32 {
    let mut mean: f32 = 0.0
    for i in 0 to n {
        mean = mean + y[i]
    }
    mean = mean / (n as f32)
    let mut sum_sq: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y[i] - mean
        sum_sq = sum_sq + d * d
    }
    return sum_sq / (n as f32)
}

function _majority_class(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        counts[c] = 0
    }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] {
                counts[c] = counts[c] + 1
            }
        }
    }
    let mut best_c: i32 = 0
    let mut best_count: i32 = 0
    for c in 0 to n_classes {
        if counts[c] > best_count {
            best_count = counts[c]
            best_c = c
        }
    }
    free(counts as ptr<void>)
    return classes[best_c]
}

function _mean_val(y: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        sum = sum + y[i]
    }
    return sum / (n as f32)
}

# Shell sort: sort values array, keeping companion i32 array in sync.
#
# Gaps follow Knuth's 1, 4, 13, 40, 121, ... sequence instead of repeated
# halving. Halving gives every gap a common factor of two, so early passes
# only ever compare positions of the same parity and leave most inversions for
# the final gap-1 pass to walk one step at a time. The 3h+1 gaps are coprime,
# so each pass makes progress the next one keeps.
#
# The final pass always runs at gap 1, so the output is fully sorted either
# way. The split scan that consumes this only reads counts at boundaries where
# consecutive values differ, and those counts depend on the sorted value
# sequence rather than on the order among equal values, so the chosen split and
# threshold are unchanged.
function _sort_pairs(values: ptr<f32>, companions: ptr<i32>, n: i32) -> void {
    let mut gap: i32 = 1
    while gap < n / 3 {
        gap = 3 * gap + 1
    }
    while gap > 0 {
        let mut i: i32 = gap
        while i < n {
            let key_v: f32 = values[i]
            let key_c: i32 = companions[i]
            let mut j: i32 = i
            while j >= gap && values[j - gap] > key_v {
                values[j] = values[j - gap]
                companions[j] = companions[j - gap]
                j = j - gap
            }
            values[j] = key_v
            companions[j] = key_c
            i = i + 1
        }
        gap = (gap - 1) / 3
    }
}

# Shell sort: sort values array, keeping companion f32 array in sync.
function _sort_pairs_f32(values: ptr<f32>, companions: ptr<f32>, n: i32) -> void {
    let mut gap: i32 = n / 2
    while gap > 0 {
        let mut i: i32 = gap
        while i < n {
            let key_v: f32 = values[i]
            let key_c: f32 = companions[i]
            let mut j: i32 = i
            while j >= gap && values[j - gap] > key_v {
                values[j] = values[j - gap]
                companions[j] = companions[j - gap]
                j = j - gap
            }
            values[j] = key_v
            companions[j] = key_c
            i = i + 1
        }
        gap = gap / 2
    }
}

# Gini impurity from precomputed class counts.
function _gini_from_counts(counts: ptr<i32>, n_classes: i32, n: i32) -> f32 {
    if n <= 0 { return 0.0 }
    let mut sum_sq: f32 = 0.0
    let nf: f32 = n as f32
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / nf
        sum_sq = sum_sq + p * p
    }
    return 1.0 - sum_sq
}

# Gini impurity over a precomputed ascending list of the classes present at a
# node. Classes absent from the node are absent from both sides of every split
# below it, so their term is 0.0 either way and dropping it is exact. The
# surviving terms are still summed in ascending class order.
#
# This is the same computation as _gini_from_counts, restricted to the classes
# that can be non-empty. In a forest the split scan calls it twice per
# candidate threshold, and below the first couple of levels a node typically
# holds a small fraction of the label set.
function _tree_gini_present(counts: ptr<i32>, present: ptr<i32>, n_present: i32, n: i32) -> f32 {
    if n <= 0 { return 0.0 }
    let mut sum_sq: f32 = 0.0
    let nf: f32 = n as f32
    for pi in 0 to n_present {
        let k: i32 = counts[present[pi]]
        if k == 0 { continue }
        let p: f32 = (k as f32) / nf
        sum_sq = sum_sq + p * p
    }
    return 1.0 - sum_sq
}

export function decision_tree_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32) -> DecisionTreeClassifier {
    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values

    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 36) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    let indices: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows {
        indices[i] = i
    }

    let final_n_nodes: i32 = _build_classifier_tree(nodes, n_nodes_ptr, X, y, indices, X.rows, 0, max_depth, criterion, classes, n_classes)

    free(indices as ptr<void>)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        n_classes: n_classes,
        classes: classes,
        fitted: true
    }
}

function _build_classifier_tree(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    indices: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32,
    classes: ptr<f32>,
    n_classes: i32
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_subset[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_subset, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = _gini(y_subset, n_indices, classes, n_classes)
        array_free_f32(y_subset)
        return node_idx
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0

    let x_data: ptr<f32> = X.data
    let x_cols: i32 = X.cols
    let class_bytes: i64 = (n_indices as i64) * 4
    let row_base: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        row_base[i] = indices[i] * x_cols
    }

    let class_idx: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        let mut ci: i32 = 0
        let yi: f32 = y[indices[i]]
        for c in 0 to n_classes {
            if yi == classes[c] { ci = c }
        }
        class_idx[i] = ci
    }

    let total_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { total_counts[c] = 0 }
    for i in 0 to n_indices { total_counts[class_idx[i]] = total_counts[class_idx[i]] + 1 }

    let present: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let mut n_present: i32 = 0
    for c in 0 to n_classes {
        if total_counts[c] > 0 {
            present[n_present] = c
            n_present = n_present + 1
        }
    }

    let parent_impurity: f32 = _tree_gini_present(total_counts, present, n_present, n_indices)

    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_classes: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let left_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let right_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for f in 0 to x_cols {
        let first_value: f32 = x_data[row_base[0] + f]
        let mut is_constant: bool = true
        for i in 0 to n_indices {
            let v: f32 = x_data[row_base[i] + f]
            sort_values[i] = v
            if v != first_value { is_constant = false }
        }
        if is_constant { continue }

        memcpy(sort_classes as ptr<void>, class_idx as ptr<void>, class_bytes)
        _sort_pairs(sort_values, sort_classes, n_indices)

        for pi in 0 to n_present {
            let c: i32 = present[pi]
            left_counts[c] = 0
            right_counts[c] = total_counts[c]
        }

        for i in 0 to n_indices - 1 {
            left_counts[sort_classes[i]] = left_counts[sort_classes[i]] + 1
            right_counts[sort_classes[i]] = right_counts[sort_classes[i]] - 1

            if sort_values[i] == sort_values[i + 1] { continue }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let gini_left: f32 = _tree_gini_present(left_counts, present, n_present, n_left)
            let gini_right: f32 = _tree_gini_present(right_counts, present, n_present, n_right)
            let nf: f32 = n_indices as f32
            let weighted: f32 = (n_left as f32) / nf * gini_left + (n_right as f32) / nf * gini_right

            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
            }
        }
    }

    array_free_f32(sort_values)
    free(sort_classes as ptr<void>)
    free(left_counts as ptr<void>)
    free(right_counts as ptr<void>)
    free(class_idx as ptr<void>)
    free(present as ptr<void>)
    free(total_counts as ptr<void>)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        let y_sub: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_sub[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_sub, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_sub)
        free(row_base as ptr<void>)
        return node_idx
    }

    let left_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let right_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let mut left_n: i32 = 0
    let mut right_n: i32 = 0

    for i in 0 to n_indices {
        if x_data[row_base[i] + best_feature] <= best_threshold {
            left_indices[left_n] = indices[i]
            left_n = left_n + 1
        } else {
            right_indices[right_n] = indices[i]
            right_n = right_n + 1
        }
    }
    free(row_base as ptr<void>)

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = _build_classifier_tree(nodes, n_nodes, X, y, left_indices, left_n, depth + 1, max_depth, criterion, classes, n_classes)
    let right_idx: i32 = _build_classifier_tree(nodes, n_nodes, X, y, right_indices, right_n, depth + 1, max_depth, criterion, classes, n_classes)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_indices as ptr<void>)
    free(right_indices as ptr<void>)

    return node_idx
}

# Tree builder with feature subsampling for RandomForest.
# At each node, only max_features randomly chosen features are considered.
function _build_classifier_tree_rf(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    indices: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32,
    classes: ptr<f32>,
    n_classes: i32,
    max_features: i32,
    prng_state: ptr<u32>
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_subset[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_subset, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = _gini(y_subset, n_indices, classes, n_classes)
        array_free_f32(y_subset)
        return node_idx
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0

    # Row offsets into X.data, computed once per node and reused by every
    # candidate feature and by the final partition, instead of recomputing
    # indices[i] * X.cols inside matrix_at on every element touch.
    let x_data: ptr<f32> = X.data
    let x_cols: i32 = X.cols
    let class_bytes: i64 = (n_indices as i64) * 4
    let row_base: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        row_base[i] = indices[i] * x_cols
    }

    let class_idx: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        let mut ci: i32 = 0
        let yi: f32 = y[indices[i]]
        for c in 0 to n_classes {
            if yi == classes[c] { ci = c }
        }
        class_idx[i] = ci
    }

    let total_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { total_counts[c] = 0 }
    for i in 0 to n_indices { total_counts[class_idx[i]] = total_counts[class_idx[i]] + 1 }

    # Ascending list of the classes that actually occur at this node. A class
    # with no samples here has no samples on either side of any split below,
    # so its impurity term is 0.0 and dropping it is exact. Every count loop in
    # the split scan walks this list instead of the whole label set.
    let present: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let mut n_present: i32 = 0
    for c in 0 to n_classes {
        if total_counts[c] > 0 {
            present[n_present] = c
            n_present = n_present + 1
        }
    }

    let parent_impurity: f32 = _tree_gini_present(total_counts, present, n_present, n_indices)

    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_classes: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let left_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let right_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    # Determine which features to try at this node
    let n_features: i32 = X.cols
    let feature_mask: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>
    for f in 0 to n_features { feature_mask[f] = 0 }

    if max_features >= n_features {
        for f in 0 to n_features { feature_mask[f] = 1 }
    } else {
        # Randomly select max_features features without replacement
        let n_selected: i32 = 0
        while n_selected < max_features {
            let prng: PRNG = PRNG { state: prng_state[0] }
            let res: PRNGResult = prng_int(prng, n_features)
            prng_state[0] = res.state
            if feature_mask[res.value] == 0 {
                feature_mask[res.value] = 1
                n_selected = n_selected + 1
            }
        }
    }

    for f in 0 to n_features {
        if feature_mask[f] == 0 { continue }

        # Gather and check for a constant column in one pass. If every sample
        # shares a value, the scan below hits `sort_values[i] == sort_values[i+1]`
        # at every position and evaluates no candidate at all, so skipping the
        # sort and the scan changes nothing. Constant columns are common in a
        # forest: pixel-style features are constant over most nodes, and deeper
        # nodes make more of them constant.
        let first_value: f32 = x_data[row_base[0] + f]
        let mut is_constant: bool = true
        for i in 0 to n_indices {
            let v: f32 = x_data[row_base[i] + f]
            sort_values[i] = v
            if v != first_value { is_constant = false }
        }
        if is_constant { continue }

        memcpy(sort_classes as ptr<void>, class_idx as ptr<void>, class_bytes)
        _sort_pairs(sort_values, sort_classes, n_indices)

        # right_counts starts as the node's full class histogram, which is
        # exactly total_counts; left_counts starts empty. Seeding from the
        # histogram replaces a second pass over every sample.
        for pi in 0 to n_present {
            let c: i32 = present[pi]
            left_counts[c] = 0
            right_counts[c] = total_counts[c]
        }

        for i in 0 to n_indices - 1 {
            left_counts[sort_classes[i]] = left_counts[sort_classes[i]] + 1
            right_counts[sort_classes[i]] = right_counts[sort_classes[i]] - 1

            if sort_values[i] == sort_values[i + 1] { continue }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let gini_left: f32 = _tree_gini_present(left_counts, present, n_present, n_left)
            let gini_right: f32 = _tree_gini_present(right_counts, present, n_present, n_right)
            let nf: f32 = n_indices as f32
            let weighted: f32 = (n_left as f32) / nf * gini_left + (n_right as f32) / nf * gini_right

            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
            }
        }
    }

    free(feature_mask as ptr<void>)
    array_free_f32(sort_values)
    free(sort_classes as ptr<void>)
    free(left_counts as ptr<void>)
    free(right_counts as ptr<void>)
    free(class_idx as ptr<void>)
    free(present as ptr<void>)
    free(total_counts as ptr<void>)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        let y_sub: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_sub[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_sub, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_sub)
        free(row_base as ptr<void>)
        return node_idx
    }

    let left_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let right_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let mut left_n: i32 = 0
    let mut right_n: i32 = 0

    for i in 0 to n_indices {
        if x_data[row_base[i] + best_feature] <= best_threshold {
            left_indices[left_n] = indices[i]
            left_n = left_n + 1
        } else {
            right_indices[right_n] = indices[i]
            right_n = right_n + 1
        }
    }

    free(row_base as ptr<void>)

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = _build_classifier_tree_rf(nodes, n_nodes, X, y, left_indices, left_n, depth + 1, max_depth, criterion, classes, n_classes, max_features, prng_state)
    let right_idx: i32 = _build_classifier_tree_rf(nodes, n_nodes, X, y, right_indices, right_n, depth + 1, max_depth, criterion, classes, n_classes, max_features, prng_state)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_indices as ptr<void>)
    free(right_indices as ptr<void>)

    return node_idx
}

# Fit a decision tree with feature subsampling (for RandomForest).
export function decision_tree_classifier_fit_rf(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32, max_features: i32, prng_state: ptr<u32>) -> DecisionTreeClassifier {
    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values

    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 36) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    let indices: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows { indices[i] = i }

    let _final: i32 = _build_classifier_tree_rf(nodes, n_nodes_ptr, X, y, indices, X.rows, 0, max_depth, criterion, classes, n_classes, max_features, prng_state)

    free(indices as ptr<void>)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        n_classes: n_classes,
        classes: classes,
        fitted: true
    }
}

export function decision_tree_classifier_predict_one(model: DecisionTreeClassifier, x: ptr<f32>) -> f32 {
    let mut node_idx: i32 = 0
    while not model.nodes[node_idx].is_leaf {
        let node: ptr<TreeNode> = model.nodes + node_idx
        if x[node.feature] <= node.threshold {
            node_idx = node.left
        } else {
            node_idx = node.right
        }
    }
    return model.nodes[node_idx].value
}

export function decision_tree_classifier_predict(model: DecisionTreeClassifier, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        preds[i] = decision_tree_classifier_predict_one(model, row)
    }
    array_free_f32(row)
    return preds
}

export function decision_tree_classifier_free(model: DecisionTreeClassifier) -> void {
    free(model.nodes as ptr<void>)
    array_free_f32(model.classes)
}

# Feature importances for DecisionTreeClassifier.
# Computes the weighted impurity decrease per feature, normalized to sum 1.
# Addresses sklearn #34472: feature_importances_ with proper not-fitted check.
export function decision_tree_classifier_feature_importances(model: DecisionTreeClassifier, n_features: i32) -> ptr<f32> {
    if not model.fitted || model.n_nodes == 0 {
        println("[flow-scikit] ERROR: classifier not fitted, call fit before feature_importances_")
        return array_new_f32(n_features)
    }
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    let root_samples: f32 = model.nodes[0].n_samples as f32
    if root_samples < 1.0 {
        return importances
    }
    for i in 0 to model.n_nodes {
        let node: ptr<TreeNode> = model.nodes + i
        if not node.is_leaf {
            let left: ptr<TreeNode> = model.nodes + node.left
            let right: ptr<TreeNode> = model.nodes + node.right
            let decrease: f32 = (node.n_samples as f32) * node.impurity
                - (left.n_samples as f32) * left.impurity
                - (right.n_samples as f32) * right.impurity
            importances[node.feature] = importances[node.feature] + decrease / root_samples
        }
    }
    let mut total: f32 = 0.0
    for f in 0 to n_features {
        total = total + importances[f]
    }
    if total > 0.0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / total
        }
    }
    return importances
}

export function decision_tree_regressor_fit(X: Matrix, y: ptr<f32>, max_depth: i32, criterion: i32) -> DecisionTreeRegressor {
    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 36) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    let indices: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows {
        indices[i] = i
    }

    let final_n_nodes: i32 = _build_regressor_tree(nodes, n_nodes_ptr, X, y, indices, X.rows, 0, max_depth, criterion)

    free(indices as ptr<void>)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeRegressor {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        fitted: true
    }
}

function _build_regressor_tree(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    indices: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_subset[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _mean_val(y_subset, n_indices)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = _mse(y_subset, n_indices)
        array_free_f32(y_subset)
        return node_idx
    }

    let y_subset: ptr<f32> = array_new_f32(n_indices)
    for i in 0 to n_indices {
        y_subset[i] = y[indices[i]]
    }
    let parent_impurity: f32 = _mse(y_subset, n_indices)
    array_free_f32(y_subset)

    # Precompute y values for sorted sweep.
    let y_vals: ptr<f32> = array_new_f32(n_indices)
    for i in 0 to n_indices { y_vals[i] = y[indices[i]] }
    let mut total_sum: f32 = 0.0
    let mut total_sum_sq: f32 = 0.0
    for i in 0 to n_indices {
        total_sum = total_sum + y_vals[i]
        total_sum_sq = total_sum_sq + y_vals[i] * y_vals[i]
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0

    let x_data: ptr<f32> = X.data
    let x_cols: i32 = X.cols
    let y_bytes: i64 = (n_indices as i64) * 4
    let row_base: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        row_base[i] = indices[i] * x_cols
    }

    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_y: ptr<f32> = array_new_f32(n_indices)

    for f in 0 to x_cols {
        let first_value: f32 = x_data[row_base[0] + f]
        let mut is_constant: bool = true
        for i in 0 to n_indices {
            let v: f32 = x_data[row_base[i] + f]
            sort_values[i] = v
            if v != first_value { is_constant = false }
        }
        if is_constant { continue }

        memcpy(sort_y as ptr<void>, y_vals as ptr<void>, y_bytes)
        _sort_pairs_f32(sort_values, sort_y, n_indices)

        let mut left_sum: f32 = 0.0
        let mut left_sum_sq: f32 = 0.0

        for i in 0 to n_indices - 1 {
            left_sum = left_sum + sort_y[i]
            left_sum_sq = left_sum_sq + sort_y[i] * sort_y[i]

            if sort_values[i] == sort_values[i + 1] { continue }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let right_sum: f32 = total_sum - left_sum
            let right_sum_sq: f32 = total_sum_sq - left_sum_sq

            let nl: f32 = n_left as f32
            let nr: f32 = n_right as f32
            let left_mean: f32 = left_sum / nl
            let right_mean: f32 = right_sum / nr
            let left_mse: f32 = left_sum_sq / nl - left_mean * left_mean
            let right_mse: f32 = right_sum_sq / nr - right_mean * right_mean

            let nf: f32 = n_indices as f32
            let weighted: f32 = nl / nf * left_mse + nr / nf * right_mse

            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
            }
        }
    }

    array_free_f32(sort_values)
    array_free_f32(sort_y)
    array_free_f32(y_vals)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        let y_sub: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_sub[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _mean_val(y_sub, n_indices)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_sub)
        free(row_base as ptr<void>)
        return node_idx
    }

    let left_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let right_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let mut left_n: i32 = 0
    let mut right_n: i32 = 0

    for i in 0 to n_indices {
        if x_data[row_base[i] + best_feature] <= best_threshold {
            left_indices[left_n] = indices[i]
            left_n = left_n + 1
        } else {
            right_indices[right_n] = indices[i]
            right_n = right_n + 1
        }
    }
    free(row_base as ptr<void>)

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = _build_regressor_tree(nodes, n_nodes, X, y, left_indices, left_n, depth + 1, max_depth, criterion)
    let right_idx: i32 = _build_regressor_tree(nodes, n_nodes, X, y, right_indices, right_n, depth + 1, max_depth, criterion)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_indices as ptr<void>)
    free(right_indices as ptr<void>)

    return node_idx
}

export function decision_tree_regressor_predict_one(model: DecisionTreeRegressor, x: ptr<f32>) -> f32 {
    let mut node_idx: i32 = 0
    while not model.nodes[node_idx].is_leaf {
        let node: ptr<TreeNode> = model.nodes + node_idx
        if x[node.feature] <= node.threshold {
            node_idx = node.left
        } else {
            node_idx = node.right
        }
    }
    return model.nodes[node_idx].value
}

export function decision_tree_regressor_predict(model: DecisionTreeRegressor, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        preds[i] = decision_tree_regressor_predict_one(model, row)
    }
    array_free_f32(row)
    return preds
}

export function decision_tree_regressor_free(model: DecisionTreeRegressor) -> void {
    free(model.nodes as ptr<void>)
}

# Feature importances for DecisionTreeRegressor.
# Addresses sklearn #34472: feature_importances_ with proper not-fitted check.
export function decision_tree_regressor_feature_importances(model: DecisionTreeRegressor, n_features: i32) -> ptr<f32> {
    if not model.fitted || model.n_nodes == 0 {
        println("[flow-scikit] ERROR: regressor not fitted, call fit before feature_importances_")
        return array_new_f32(n_features)
    }
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    let root_samples: f32 = model.nodes[0].n_samples as f32
    if root_samples < 1.0 {
        return importances
    }
    for i in 0 to model.n_nodes {
        let node: ptr<TreeNode> = model.nodes + i
        if not node.is_leaf {
            let left: ptr<TreeNode> = model.nodes + node.left
            let right: ptr<TreeNode> = model.nodes + node.right
            let decrease: f32 = (node.n_samples as f32) * node.impurity
                - (left.n_samples as f32) * left.impurity
                - (right.n_samples as f32) * right.impurity
            importances[node.feature] = importances[node.feature] + decrease / root_samples
        }
    }
    let mut total: f32 = 0.0
    for f in 0 to n_features {
        total = total + importances[f]
    }
    if total > 0.0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / total
        }
    }
    return importances
}

# ============================================================================
# ExtraTreeClassifier (randomized splitting)
# ============================================================================

export struct ExtraTreeClassifier {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    n_features: i32,
    n_classes: i32,
    fitted: bool
}

export function extra_tree_classifier_fit(X: Matrix, y: ptr<f32>, n_samples: i32, n_features: i32, n_classes: i32, max_depth: i32, seed: i32) -> ExtraTreeClassifier {
    srand(seed)
    let nodes: ptr<TreeNode> = calloc(1024 as i64, 36) as ptr<TreeNode>
    let mut n_nodes: i32 = 0

    n_nodes = _extra_tree_clf_build(nodes, n_nodes, X, y, n_samples, n_features, n_classes, 0, max_depth, seed)

    return ExtraTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        n_features: n_features,
        n_classes: n_classes,
        fitted: true
    }
}

function _extra_tree_clf_build(nodes: ptr<TreeNode>, node_idx: i32, X: Matrix, y: ptr<f32>, n: i32, p: i32, n_classes: i32, depth: i32, max_depth: i32, seed: i32) -> i32 {
    let mut idx: i32 = node_idx

    let mut class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { class_counts[c] = 0 }
    for i in 0 to n {
        let c: i32 = y[i] as i32
        if c >= 0 && c < n_classes { class_counts[c] = class_counts[c] + 1 }
    }

    let mut best_class: i32 = 0
    let mut best_count: i32 = 0
    for c in 0 to n_classes {
        if class_counts[c] > best_count {
            best_count = class_counts[c]
            best_class = c
        }
    }

    let pure: bool = best_count == n
    if pure || depth >= max_depth || n < 2 {
        nodes[idx].is_leaf = true
        nodes[idx].value = best_class as f32
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        free(class_counts as ptr<void>)
        return idx + 1
    }

    let feature: i32 = rand() % p
    let r1: i32 = rand() % n
    let r2: i32 = rand() % n
    if r1 == r2 {
        nodes[idx].is_leaf = true
        nodes[idx].value = best_class as f32
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        free(class_counts as ptr<void>)
        return idx + 1
    }
    let threshold: f32 = (matrix_at(X, r1, feature) + matrix_at(X, r2, feature)) / 2.0

    let left_y: ptr<f32> = array_new_f32(n)
    let right_y: ptr<f32> = array_new_f32(n)
    let left_X: Matrix = matrix_new(n, p)
    let right_X: Matrix = matrix_new(n, p)
    let mut n_left: i32 = 0
    let mut n_right: i32 = 0

    for i in 0 to n {
        if matrix_at(X, i, feature) <= threshold {
            for j in 0 to p { matrix_set(left_X, n_left, j, matrix_at(X, i, j)) }
            left_y[n_left] = y[i]
            n_left = n_left + 1
        } else {
            for j in 0 to p { matrix_set(right_X, n_right, j, matrix_at(X, i, j)) }
            right_y[n_right] = y[i]
            n_right = n_right + 1
        }
    }

    nodes[idx].is_leaf = false
    nodes[idx].feature = feature
    nodes[idx].threshold = threshold
    nodes[idx].left = idx + 1
    free(class_counts as ptr<void>)

    if n_left == 0 || n_right == 0 {
        nodes[idx].is_leaf = true
        nodes[idx].value = best_class as f32
        nodes[idx].feature = -1
        nodes[idx].left = -1
        nodes[idx].right = -1
        matrix_free(left_X)
        matrix_free(right_X)
        array_free_f32(left_y)
        array_free_f32(right_y)
        return idx + 1
    }

    let left_idx: i32 = idx + 1
    let next_idx: i32 = _extra_tree_clf_build(nodes, left_idx, left_X, left_y, n_left, p, n_classes, depth + 1, max_depth, seed + 1)
    nodes[idx].right = next_idx

    let right_idx: i32 = next_idx
    let final_idx: i32 = _extra_tree_clf_build(nodes, right_idx, right_X, right_y, n_right, p, n_classes, depth + 1, max_depth, seed + 2)

    matrix_free(left_X)
    matrix_free(right_X)
    array_free_f32(left_y)
    array_free_f32(right_y)

    return final_idx
}

export function extra_tree_classifier_predict(model: ExtraTreeClassifier, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        let mut node: i32 = 0
        while not model.nodes[node].is_leaf {
            if row[model.nodes[node].feature] <= model.nodes[node].threshold {
                node = model.nodes[node].left
            } else {
                node = model.nodes[node].right
            }
        }
        result[i] = model.nodes[node].value
    }
    array_free_f32(row)
    return result
}

export function extra_tree_classifier_free(model: ExtraTreeClassifier) -> void {
    free(model.nodes as ptr<void>)
}

# ============================================================================
# ExtraTreeRegressor (randomized splitting)
# ============================================================================

export struct ExtraTreeRegressor {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    n_features: i32,
    fitted: bool
}

export function extra_tree_regressor_fit(X: Matrix, y: ptr<f32>, n_samples: i32, n_features: i32, max_depth: i32, seed: i32) -> ExtraTreeRegressor {
    srand(seed)
    let nodes: ptr<TreeNode> = calloc(1024 as i64, 36) as ptr<TreeNode>
    let mut n_nodes: i32 = 0

    n_nodes = _extra_tree_reg_build(nodes, n_nodes, X, y, n_samples, n_features, 0, max_depth, seed)

    return ExtraTreeRegressor {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        n_features: n_features,
        fitted: true
    }
}

function _extra_tree_reg_build(nodes: ptr<TreeNode>, node_idx: i32, X: Matrix, y: ptr<f32>, n: i32, p: i32, depth: i32, max_depth: i32, seed: i32) -> i32 {
    let mut idx: i32 = node_idx

    let mut mean: f32 = 0.0
    for i in 0 to n { mean = mean + y[i] }
    mean = mean / (n as f32)

    if n < 2 || depth >= max_depth {
        nodes[idx].is_leaf = true
        nodes[idx].value = mean
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        return idx + 1
    }

    let feature: i32 = rand() % p
    let r1: i32 = rand() % n
    let r2: i32 = rand() % n
    if r1 == r2 {
        nodes[idx].is_leaf = true
        nodes[idx].value = mean
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        return idx + 1
    }
    let threshold: f32 = (matrix_at(X, r1, feature) + matrix_at(X, r2, feature)) / 2.0

    let left_y: ptr<f32> = array_new_f32(n)
    let right_y: ptr<f32> = array_new_f32(n)
    let left_X: Matrix = matrix_new(n, p)
    let right_X: Matrix = matrix_new(n, p)
    let mut n_left: i32 = 0
    let mut n_right: i32 = 0

    for i in 0 to n {
        if matrix_at(X, i, feature) <= threshold {
            for j in 0 to p { matrix_set(left_X, n_left, j, matrix_at(X, i, j)) }
            left_y[n_left] = y[i]
            n_left = n_left + 1
        } else {
            for j in 0 to p { matrix_set(right_X, n_right, j, matrix_at(X, i, j)) }
            right_y[n_right] = y[i]
            n_right = n_right + 1
        }
    }

    if n_left == 0 || n_right == 0 {
        nodes[idx].is_leaf = true
        nodes[idx].value = mean
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        matrix_free(left_X)
        matrix_free(right_X)
        array_free_f32(left_y)
        array_free_f32(right_y)
        return idx + 1
    }

    nodes[idx].is_leaf = false
    nodes[idx].feature = feature
    nodes[idx].threshold = threshold
    nodes[idx].left = idx + 1

    let left_idx: i32 = idx + 1
    let next_idx: i32 = _extra_tree_reg_build(nodes, left_idx, left_X, left_y, n_left, p, depth + 1, max_depth, seed + 1)
    nodes[idx].right = next_idx

    let right_idx: i32 = next_idx
    let final_idx: i32 = _extra_tree_reg_build(nodes, right_idx, right_X, right_y, n_right, p, depth + 1, max_depth, seed + 2)

    matrix_free(left_X)
    matrix_free(right_X)
    array_free_f32(left_y)
    array_free_f32(right_y)

    return final_idx
}

export function extra_tree_regressor_predict(model: ExtraTreeRegressor, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        let mut node: i32 = 0
        while not model.nodes[node].is_leaf {
            if row[model.nodes[node].feature] <= model.nodes[node].threshold {
                node = model.nodes[node].left
            } else {
                node = model.nodes[node].right
            }
        }
        result[i] = model.nodes[node].value
    }
    array_free_f32(row)
    return result
}

export function extra_tree_regressor_free(model: ExtraTreeRegressor) -> void {
    free(model.nodes as ptr<void>)
}

# ============================================================================
# Tree visualization: export_text
# ============================================================================

export function export_tree_text(model: DecisionTreeClassifier, max_depth: i32) -> void {
    _export_tree_text_recursive(model.nodes, 0, 0, max_depth, true, true)
}

export function export_tree_text_reg(model: DecisionTreeRegressor, max_depth: i32) -> void {
    _export_tree_text_recursive(model.nodes, 0, 0, max_depth, false, true)
}

function _export_tree_text_recursive(
    nodes: ptr<TreeNode>, node_idx: i32, depth: i32,
    max_depth: i32, is_classifier: bool, is_left: bool
) -> void {
    if max_depth > 0 && depth >= max_depth {
        return
    }
    let node: TreeNode = nodes[node_idx]
    let mut i: i32 = 0
    while i < depth {
        print("  ")
        i = i + 1
    }
    if depth > 0 {
        if is_left {
            print("L: ")
        } else {
            print("R: ")
        }
    }
    if node.is_leaf {
        if is_classifier {
            print("class = ")
            printf("%.0f", node.value)
        } else {
            print("value = ")
            printf("%.4f", node.value)
        }
        print(" (n=")
        print(node.n_samples)
        println(")")
    } else {
        print("feature ")
        print(node.feature)
        print(" <= ")
        printf("%.4f", node.threshold)
        print("  (n=")
        print(node.n_samples)
        println(")")
        _export_tree_text_recursive(nodes, node.left, depth + 1, max_depth, is_classifier, true)
        _export_tree_text_recursive(nodes, node.right, depth + 1, max_depth, is_classifier, false)
    }
}

# ============================================================================
# Tree visualization: export_graphviz (DOT format)
# ============================================================================

export function export_graphviz(model: DecisionTreeClassifier) -> void {
    println("digraph Tree {")
    _export_graphviz_recursive(model.nodes, 0, 0, true)
    println("}")
}

export function export_graphviz_reg(model: DecisionTreeRegressor) -> void {
    println("digraph Tree {")
    _export_graphviz_recursive(model.nodes, 0, 0, false)
    println("}")
}

function _export_graphviz_recursive(
    nodes: ptr<TreeNode>, node_idx: i32, depth: i32, is_classifier: bool
) -> void {
    let node: TreeNode = nodes[node_idx]
    print("  ")
    print(node_idx)
    print(" [label=")
    if node.is_leaf {
        if is_classifier {
            print("class=")
            printf("%.0f", node.value)
        } else {
            print("value=")
            printf("%.4f", node.value)
        }
        print(" nsamples=")
        print(node.n_samples)
    } else {
        print("feature")
        print(node.feature)
        print(" <=")
        printf("%.4f", node.threshold)
        print(" nsamples=")
        print(node.n_samples)
    }
    println("]")

    if not node.is_leaf {
        print("  ")
        print(node_idx)
        print(" -> ")
        print(node.left)
        println(" [label=true]")
        print("  ")
        print(node_idx)
        print(" -> ")
        print(node.right)
        println(" [label=false]")
        _export_graphviz_recursive(nodes, node.left, depth + 1, is_classifier)
        _export_graphviz_recursive(nodes, node.right, depth + 1, is_classifier)
    }
}
