# Decision tree module for flow-scikit.
# Implements CART-style decision trees for classification and regression.

import "lib/scikit/matrix.flow"
import "lib/scikit/prng.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(count: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fabs(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

export const TREE_MAX_DEPTH: i32 = 50
export const TREE_MIN_SAMPLES_SPLIT: i32 = 2
export const TREE_MIN_SAMPLES_LEAF: i32 = 1

export const CRITERION_GINI: i32 = 0
export const CRITERION_ENTROPY: i32 = 1
export const CRITERION_MSE: i32 = 2
export const CRITERION_MAE: i32 = 3

# Node arrays for this struct are allocated with calloc, never malloc.
# The builders write only the fields each node kind needs: a leaf leaves
# feature and threshold alone, an internal node leaves value alone, and the
# ExtraTree builders also leave n_samples and impurity alone. With malloc
# those fields hold whatever the allocator handed back, so two runs that fit
# the same tree on the same data produce different bytes. Nothing reads an
# unwritten field, so prediction is unaffected, but it makes per-node learned
# structure impossible to compare against sklearn.
# sizeof(TreeNode) is 52 on arm64: thirteen 4-byte fields, with the bool
# padded to 4. Every allocation of a node array in this repo passes a literal
# byte count per element, so that literal is now 64, above the real size with
# room to spare and with the tail padding zeroed too, which no per-field write
# could reach. Two heap overflows have come from a literal that no longer
# matched the struct (#419, #421); if you add a field here, grep the repo for
# `ptr<TreeNode>` and raise every literal you find, including the reference
# builders under tests/.
#
# Issue #354: cat_kind and cat_mask0..3 carry categorical splits.
#   cat_kind = 0  numeric split, take the branch on `value <= threshold`.
#   cat_kind = 1  categorical split on a subset of levels. cat_mask0..3 are a
#                 128-bit set, bit c set meaning level c goes left. threshold
#                 is unused and left at 0.0.
# calloc zeroes cat_kind, so a node written by any builder that knows nothing
# about categorical features is a numeric node, which is what every existing
# builder produces.
export struct TreeNode {
    feature: i32,
    threshold: f32,
    left: i32,
    right: i32,
    is_leaf: bool,
    value: f32,
    n_samples: i32,
    impurity: f32,
    cat_kind: i32,
    cat_mask0: u32,
    cat_mask1: u32,
    cat_mask2: u32,
    cat_mask3: u32
}

# Largest number of levels a categorical feature may have. The left set is a
# bitmask stored inline in the node, four 32-bit words wide, so raising this
# means widening TreeNode and raising every allocation literal with it.
#
# An exported const is not visible through an import here (see AGENTS.md), so
# this names the cap for a reader rather than being referenced: the range
# check, the validator's message and the tests all spell out 128. Change all
# four together.
export const TREE_CAT_MAX_LEVELS: i32 = 128

export struct DecisionTreeClassifier {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    criterion: i32,
    n_classes: i32,
    classes: ptr<f32>,
    fitted: bool
}

export struct DecisionTreeRegressor {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    criterion: i32,
    fitted: bool
}

function _gini(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        counts[c] = 0
    }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] {
                counts[c] = counts[c] + 1
            }
        }
    }
    let mut impurity: f32 = 1.0
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / (n as f32)
        impurity = impurity - p * p
    }
    free(counts as ptr<void>)
    return impurity
}

function _entropy(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        counts[c] = 0
    }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] {
                counts[c] = counts[c] + 1
            }
        }
    }
    let mut impurity: f32 = 0.0
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / (n as f32)
        if p > 0.0 {
            let log_p: f64 = log(p as f64)
            impurity = impurity - p * (log_p as f32)
        }
    }
    free(counts as ptr<void>)
    return impurity
}

function _mse(y: ptr<f32>, n: i32) -> f32 {
    let mut mean: f32 = 0.0
    for i in 0 to n {
        mean = mean + y[i]
    }
    mean = mean / (n as f32)
    let mut sum_sq: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y[i] - mean
        sum_sq = sum_sq + d * d
    }
    return sum_sq / (n as f32)
}

function _majority_class(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        counts[c] = 0
    }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] {
                counts[c] = counts[c] + 1
            }
        }
    }
    let mut best_c: i32 = 0
    let mut best_count: i32 = 0
    for c in 0 to n_classes {
        if counts[c] > best_count {
            best_count = counts[c]
            best_c = c
        }
    }
    free(counts as ptr<void>)
    return classes[best_c]
}

function _mean_val(y: ptr<f32>, n: i32) -> f32 {
    let mut sum: f32 = 0.0
    for i in 0 to n {
        sum = sum + y[i]
    }
    return sum / (n as f32)
}

# Shell sort: sort values array, keeping companion i32 array in sync.
#
# Gaps follow Knuth's 1, 4, 13, 40, 121, ... sequence instead of repeated
# halving. Halving gives every gap a common factor of two, so early passes
# only ever compare positions of the same parity and leave most inversions for
# the final gap-1 pass to walk one step at a time. The 3h+1 gaps are coprime,
# so each pass makes progress the next one keeps.
#
# The final pass always runs at gap 1, so the output is fully sorted either
# way. The split scan that consumes this only reads counts at boundaries where
# consecutive values differ, and those counts depend on the sorted value
# sequence rather than on the order among equal values, so the chosen split and
# threshold are unchanged.
function _sort_pairs(values: ptr<f32>, companions: ptr<i32>, n: i32) -> void {
    let mut gap: i32 = 1
    while gap < n / 3 {
        gap = 3 * gap + 1
    }
    while gap > 0 {
        let mut i: i32 = gap
        while i < n {
            let key_v: f32 = values[i]
            let key_c: i32 = companions[i]
            let mut j: i32 = i
            while j >= gap && values[j - gap] > key_v {
                values[j] = values[j - gap]
                companions[j] = companions[j - gap]
                j = j - gap
            }
            values[j] = key_v
            companions[j] = key_c
            i = i + 1
        }
        gap = (gap - 1) / 3
    }
}

# Shell sort: sort values array, keeping companion f32 array in sync.
function _sort_pairs_f32(values: ptr<f32>, companions: ptr<f32>, n: i32) -> void {
    let mut gap: i32 = n / 2
    while gap > 0 {
        let mut i: i32 = gap
        while i < n {
            let key_v: f32 = values[i]
            let key_c: f32 = companions[i]
            let mut j: i32 = i
            while j >= gap && values[j - gap] > key_v {
                values[j] = values[j - gap]
                companions[j] = companions[j - gap]
                j = j - gap
            }
            values[j] = key_v
            companions[j] = key_c
            i = i + 1
        }
        gap = gap / 2
    }
}

# Gini impurity from precomputed class counts.
function _gini_from_counts(counts: ptr<i32>, n_classes: i32, n: i32) -> f32 {
    if n <= 0 { return 0.0 }
    let mut sum_sq: f32 = 0.0
    let nf: f32 = n as f32
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / nf
        sum_sq = sum_sq + p * p
    }
    return 1.0 - sum_sq
}

# Gini impurity over a precomputed ascending list of the classes present at a
# node. Classes absent from the node are absent from both sides of every split
# below it, so their term is 0.0 either way and dropping it is exact. The
# surviving terms are still summed in ascending class order.
#
# This is the same computation as _gini_from_counts, restricted to the classes
# that can be non-empty. In a forest the split scan calls it twice per
# candidate threshold, and below the first couple of levels a node typically
# holds a small fraction of the label set.
function _tree_gini_present(counts: ptr<i32>, present: ptr<i32>, n_present: i32, n: i32) -> f32 {
    if n <= 0 { return 0.0 }
    let mut sum_sq: f32 = 0.0
    let nf: f32 = n as f32
    for pi in 0 to n_present {
        let k: i32 = counts[present[pi]]
        if k == 0 { continue }
        let p: f32 = (k as f32) / nf
        sum_sq = sum_sq + p * p
    }
    return 1.0 - sum_sq
}

# Which way one sample goes at one internal node.
#
# For a numeric node this is the same `xv <= threshold` the builders have
# always used, reading the same f32 threshold the builder wrote, so a tree
# with no categorical split routes every row exactly as before.
#
# For a categorical node the level index is the feature value truncated to an
# integer, and the sample goes left when that level's bit is set.
#
# Unseen levels go right. A level that was absent from the training data has
# no bit set in any node, so it goes right at every node it reaches, and so
# does a value outside 0..127 or one that is not a whole number. This is a
# defined direction rather than an error: predict has to return something for
# every row, and the alternatives used elsewhere (send the row to the child
# with more training samples, or split it proportionally) need per-node counts
# the node does not carry. Callers who need a distinct answer for an unseen
# level should map it to a reserved level at fit time.
function _tree_split_goes_left(node: ptr<TreeNode>, xv: f32) -> bool {
    if node.cat_kind == 0 {
        return xv <= node.threshold
    }
    let c: i32 = xv as i32
    if (c as f32) != xv { return false }
    if c < 0 || c >= 128 { return false }
    let widx: i32 = c / 32
    let bit: i32 = c - widx * 32
    let mut w: u32 = node.cat_mask0
    if widx == 1 { w = node.cat_mask1 }
    if widx == 2 { w = node.cat_mask2 }
    if widx == 3 { w = node.cat_mask3 }
    let one: u32 = 1 as u32
    let probe: u32 = one << (bit as u32)
    let zero: u32 = 0 as u32
    return (w & probe) != zero
}

# Turn the winning prefix of the level ordering into the node's left-set mask.
# cats[0..n_left_cats) are the levels that go left, as level indices.
function _tree_write_cat_mask(nodes: ptr<TreeNode>, node_idx: i32, cats: ptr<i32>, n_left_cats: i32) -> void {
    let zero: u32 = 0 as u32
    let one: u32 = 1 as u32
    let mut w0: u32 = zero
    let mut w1: u32 = zero
    let mut w2: u32 = zero
    let mut w3: u32 = zero
    for j in 0 to n_left_cats {
        let c: i32 = cats[j]
        let widx: i32 = c / 32
        let bit: i32 = c - widx * 32
        let probe: u32 = one << (bit as u32)
        if widx == 0 { w0 = w0 | probe }
        if widx == 1 { w1 = w1 | probe }
        if widx == 2 { w2 = w2 | probe }
        if widx == 3 { w3 = w3 | probe }
    }
    nodes[node_idx].cat_kind = 1
    nodes[node_idx].cat_mask0 = w0
    nodes[node_idx].cat_mask1 = w1
    nodes[node_idx].cat_mask2 = w2
    nodes[node_idx].cat_mask3 = w3
}

# Validate the caller's categorical mask against the data and turn it into one
# array the builders can read: entry f is 0 when feature f is to be fitted as
# an ordinary numeric feature, and otherwise 1 + the largest level index in
# column f.
#
# A feature marked categorical whose column is not whole numbers in
# 0..127 is reported once and fitted numerically, which is the behaviour the
# caller had before asking for a categorical fit. Failing the whole fit would
# be worse: the column is still a usable numeric column, and a tree that
# refuses to build gives the caller nothing to inspect.
function _tree_cat_cardinalities(X: Matrix, categorical: ptr<i32>) -> ptr<i32> {
    let cols: i32 = X.cols
    let rows: i32 = X.rows
    let xd: ptr<f32> = X.data
    let card: ptr<i32> = malloc((cols as i64) * 4) as ptr<i32>
    for f in 0 to cols { card[f] = 0 }
    for f in 0 to cols {
        if categorical[f] == 0 { continue }
        let mut ok: bool = true
        let mut hi: i32 = 0
        for i in 0 to rows {
            let v: f32 = xd[i * cols + f]
            let c: i32 = v as i32
            if (c as f32) != v { ok = false }
            if c < 0 || c >= 128 { ok = false }
            if ok && c > hi { hi = c }
        }
        if ok {
            card[f] = hi + 1
        } else {
            print("[flow-scikit] WARNING: feature ")
            print(f)
            println(" is marked categorical but its column is not whole numbers in 0..127; fitting it as a numeric feature")
        }
    }
    return card
}

# Largest level count over the categorical features, 0 when there are none.
function _tree_cat_max_card(card: ptr<i32>, cols: i32) -> i32 {
    let mut m: i32 = 0
    for f in 0 to cols {
        if card[f] > m { m = card[f] }
    }
    return m
}

export function decision_tree_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32) -> DecisionTreeClassifier {
    # Every feature numeric: calloc gives the all-zero mask the categorical
    # fit reads as "no categorical features", and with max_card 0 the builder
    # never enters the categorical branch, so this is the old code path.
    let none: ptr<i32> = calloc(X.cols as i64, 4) as ptr<i32>
    let model: DecisionTreeClassifier = decision_tree_classifier_fit_categorical(X, y, n_classes, max_depth, criterion, none)
    free(none as ptr<void>)
    return model
}

# Fit a classification tree where the features flagged in `categorical` are
# split on a subset of their levels instead of on a threshold. `categorical`
# is X.cols entries, non-zero meaning categorical, and a categorical column
# must hold whole numbers in 0..127 which are read as level indices.
#
# The subset search is Breiman's, not an enumeration. At each node the levels
# present there are ordered by the mean class index of their samples and only
# the k-1 prefixes of that ordering are scored, which is O(k log k) instead of
# O(2^(k-1)). For a two-class problem the mean class index is the proportion
# of the higher class and the theorem in CART section 4.2 says the best subset
# split is one of those prefixes, so the search is exact. For more than two
# classes no such theorem holds and the ordering is a heuristic; it is the
# same one LightGBM and H2O use per class, and it is still strictly better
# than the label encoding a caller would otherwise be forced into, because the
# ordering is recomputed from the response at every node rather than fixed
# once by the encoder.
#
# Issue #457 extended the mask to the ensembles. RandomForest, Bagging,
# ExtraTrees and the ExtraTree builders each have a _categorical entry point on
# this same contract, and ensemble.flow evaluates cat_kind at every traversal.
# The one thing still numeric only is the boosting family: GradientBoosting,
# AdaBoost and the histogram estimators.
export function decision_tree_classifier_fit_categorical(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32, categorical: ptr<i32>) -> DecisionTreeClassifier {
    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values

    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 64) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    # Every column is sorted once here, and the builder keeps each feature's
    # ascending order as it partitions, so no node sorts anything. See the
    # note on _build_classifier_tree for why the tree is unchanged.
    let n_rows: i32 = X.rows
    let x_cols: i32 = X.cols
    let x_data: ptr<f32> = X.data

    # Class index per row, resolved once instead of once per node.
    let class_of_row: ptr<i32> = malloc((n_rows as i64) * 4) as ptr<i32>
    for i in 0 to n_rows {
        let mut ci: i32 = 0
        let yi: f32 = y[i]
        for c in 0 to n_classes {
            if yi == classes[c] { ci = c }
        }
        class_of_row[i] = ci
    }

    # order holds X.cols blocks of n_rows row indices. Block f lists every row
    # in ascending order of feature f.
    let order: ptr<i32> = malloc((x_cols as i64) * (n_rows as i64) * 4) as ptr<i32>
    let sort_v: ptr<f32> = array_new_f32(n_rows)
    let sort_r: ptr<i32> = malloc((n_rows as i64) * 4) as ptr<i32>
    for f in 0 to x_cols {
        for i in 0 to n_rows {
            sort_v[i] = x_data[i * x_cols + f]
            sort_r[i] = i
        }
        _sort_pairs(sort_v, sort_r, n_rows)
        let base: i32 = f * n_rows
        for i in 0 to n_rows {
            order[base + i] = sort_r[i]
        }
    }
    array_free_f32(sort_v)
    free(sort_r as ptr<void>)

    # Scratch marking each row's side of the current split, indexed by row.
    let side: ptr<i32> = malloc((n_rows as i64) * 4) as ptr<i32>

    # Categorical bookkeeping. cat_card[f] is 0 for a numeric feature, so with
    # no categorical features max_card is 0, the builder's categorical branch
    # is unreachable, and these two allocations are 16 bytes and one float.
    #
    # The scratch is allocated once here rather than per node so the numeric
    # path picks up no extra allocation at all. Nothing in it survives across
    # the recursive calls: a node fills it, picks its split and partitions
    # before it descends.
    let cat_card: ptr<i32> = _tree_cat_cardinalities(X, categorical)
    let max_card: i32 = _tree_cat_max_card(cat_card, x_cols)
    let ccap: i64 = max_card as i64
    let cat_iscratch: ptr<i32> = malloc((ccap * 4 + ccap * (n_classes as i64)) * 4 + 16) as ptr<i32>
    let cat_mean: ptr<f32> = array_new_f32(max_card + 1)

    let final_n_nodes: i32 = _build_classifier_tree(nodes, n_nodes_ptr, X, y, order, n_rows, 0, max_depth, criterion, classes, n_classes, class_of_row, side, cat_card, max_card, cat_iscratch, cat_mean)

    free(order as ptr<void>)
    free(side as ptr<void>)
    free(class_of_row as ptr<void>)
    free(cat_card as ptr<void>)
    free(cat_iscratch as ptr<void>)
    array_free_f32(cat_mean)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        n_classes: n_classes,
        classes: classes,
        fitted: true
    }
}

# Plain classifier builder, used by DecisionTreeClassifier and, through it, by
# BaggingClassifier.
#
# No node sorts anything. `order` holds X.cols contiguous blocks of n_indices
# row indices; block f lists this node's rows in ascending order of feature f.
# decision_tree_classifier_fit sorts every column once, and a split partitions
# each block into the two children while preserving relative order, which is
# O(n) per feature per node instead of O(n log n).
#
# The tree is unchanged, and the reason is the one already recorded on
# _sort_pairs: the scan reads counts only at boundaries where consecutive
# values differ, and at such a boundary the samples on the left are exactly
# those whose value is at or below that value, whatever order the equal values
# came in. The counts are integers, so they are exact, and the value sequence
# any correct ascending sort produces is the same sequence. Both the chosen
# feature and the threshold therefore come out bit-identical.
#
# That argument depends on the criterion being counts. It does NOT carry to
# _build_regressor_tree, whose scan accumulates left_sum and left_sum_sq in f32
# in sorted position order, where reordering equal values changes the rounding.
function _build_classifier_tree(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    order: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32,
    classes: ptr<f32>,
    n_classes: i32,
    class_of_row: ptr<i32>,
    side: ptr<i32>,
    cat_card: ptr<i32>,
    max_card: i32,
    cat_iscratch: ptr<i32>,
    cat_mean: ptr<f32>
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_subset[i] = y[order[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_subset, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = _gini(y_subset, n_indices, classes, n_classes)
        array_free_f32(y_subset)
        return node_idx
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0
    let mut best_is_cat: bool = false
    let mut best_n_left_cats: i32 = 0

    let x_data: ptr<f32> = X.data
    let x_cols: i32 = X.cols

    # Views into the one categorical scratch block the fit allocated. All five
    # are empty when max_card is 0, and nothing below reads them unless some
    # cat_card[f] is positive, which cannot happen when max_card is 0.
    let cat_count: ptr<i32> = cat_iscratch
    let cat_ci_sum: ptr<i32> = cat_iscratch + max_card
    let cat_ids: ptr<i32> = cat_iscratch + 2 * max_card
    let best_cats: ptr<i32> = cat_iscratch + 3 * max_card
    let cat_class: ptr<i32> = cat_iscratch + 4 * max_card

    # Node class histogram, over any block since all blocks hold the same rows.
    let total_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { total_counts[c] = 0 }
    for i in 0 to n_indices {
        let c: i32 = class_of_row[order[i]]
        total_counts[c] = total_counts[c] + 1
    }

    # Ascending list of the classes that actually occur at this node. A class
    # with no samples here has no samples on either side of any split below,
    # so its impurity term is 0.0 and dropping it is exact.
    let present: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let mut n_present: i32 = 0
    for c in 0 to n_classes {
        if total_counts[c] > 0 {
            present[n_present] = c
            n_present = n_present + 1
        }
    }

    let parent_impurity: f32 = _tree_gini_present(total_counts, present, n_present, n_indices)

    # Allocated once, reused across features.
    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_classes: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let left_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let right_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for f in 0 to x_cols {
        let card: i32 = cat_card[f]
        if card > 0 {
            # Breiman's subset search on a categorical feature.
            #
            # Bucket the node's rows by level, keeping each level's class
            # histogram and the sum of the class indices of its samples.
            for lv in 0 to card {
                cat_count[lv] = 0
                cat_ci_sum[lv] = 0
            }
            let cclen: i32 = card * n_classes
            for k in 0 to cclen { cat_class[k] = 0 }

            let cbase: i32 = f * n_indices
            for i in 0 to n_indices {
                let row: i32 = order[cbase + i]
                let lv: i32 = x_data[row * x_cols + f] as i32
                let cls: i32 = class_of_row[row]
                cat_count[lv] = cat_count[lv] + 1
                cat_ci_sum[lv] = cat_ci_sum[lv] + cls
                cat_class[lv * n_classes + cls] = cat_class[lv * n_classes + cls] + 1
            }

            # Order the levels present here by their mean class index. Only
            # the k-1 prefixes of that ordering are scored, so a 40-level
            # column costs 39 candidates rather than 2^39.
            let mut n_cats: i32 = 0
            for lv in 0 to card {
                if cat_count[lv] > 0 {
                    cat_ids[n_cats] = lv
                    cat_mean[n_cats] = (cat_ci_sum[lv] as f32) / (cat_count[lv] as f32)
                    n_cats = n_cats + 1
                }
            }
            if n_cats < 2 { continue }
            _sort_pairs(cat_mean, cat_ids, n_cats)

            for pi in 0 to n_present {
                let c: i32 = present[pi]
                left_counts[c] = 0
                right_counts[c] = total_counts[c]
            }

            let mut n_left: i32 = 0
            for j in 0 to n_cats - 1 {
                let lv: i32 = cat_ids[j]
                for pi in 0 to n_present {
                    let c: i32 = present[pi]
                    let hit: i32 = cat_class[lv * n_classes + c]
                    left_counts[c] = left_counts[c] + hit
                    right_counts[c] = right_counts[c] - hit
                }
                n_left = n_left + cat_count[lv]
                let n_right: i32 = n_indices - n_left
                if n_left < 1 || n_right < 1 { continue }

                let gini_left: f32 = _tree_gini_present(left_counts, present, n_present, n_left)
                let gini_right: f32 = _tree_gini_present(right_counts, present, n_present, n_right)
                let nf: f32 = n_indices as f32
                let weighted: f32 = (n_left as f32) / nf * gini_left + (n_right as f32) / nf * gini_right

                # The same strict comparison as the numeric scan below, run
                # from the same feature loop in the same index order, so the
                # tie-break rule pinned by #204 and #426 is unchanged: the
                # lowest feature index wins among equals whether the winner is
                # numeric or categorical, and within one categorical feature
                # the shortest left set wins.
                if weighted < best_impurity {
                    best_impurity = weighted
                    best_feature = f
                    best_threshold = 0.0
                    best_is_cat = true
                    best_n_left_cats = j + 1
                    for k in 0 to j + 1 { best_cats[k] = cat_ids[k] }
                }
            }
            continue
        }

        # Gather this feature's values and classes in the order block f already
        # holds, which is ascending by construction.
        let base: i32 = f * n_indices
        for i in 0 to n_indices {
            let row: i32 = order[base + i]
            sort_values[i] = x_data[row * x_cols + f]
            sort_classes[i] = class_of_row[row]
        }

        # Constant column: the scan would hit sort_values[i] == sort_values[i+1]
        # at every position and evaluate no candidate at all. Sorted, that is a
        # single comparison of the ends.
        if sort_values[0] == sort_values[n_indices - 1] { continue }

        # right_counts starts as the node's full class histogram; left_counts
        # starts empty. Seeding from the histogram replaces a second pass over
        # every sample.
        for pi in 0 to n_present {
            let c: i32 = present[pi]
            left_counts[c] = 0
            right_counts[c] = total_counts[c]
        }

        # Sweep sorted values, moving one sample at a time to left.
        for i in 0 to n_indices - 1 {
            left_counts[sort_classes[i]] = left_counts[sort_classes[i]] + 1
            right_counts[sort_classes[i]] = right_counts[sort_classes[i]] - 1

            # Skip duplicate values.
            if sort_values[i] == sort_values[i + 1] {
                continue
            }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let gini_left: f32 = _tree_gini_present(left_counts, present, n_present, n_left)
            let gini_right: f32 = _tree_gini_present(right_counts, present, n_present, n_right)
            let nf: f32 = n_indices as f32
            let weighted: f32 = (n_left as f32) / nf * gini_left + (n_right as f32) / nf * gini_right

            # Tie-break rule, issue #204. The comparison is strict, and the
            # feature loop runs 0..X.cols-1 in fixed order, so when several
            # features reach the same weighted impurity the lowest feature
            # index wins, and within one feature the earliest boundary wins.
            #
            # sklearn's BestSplitter reaches the same set of candidates
            # (max_features is None for a plain DecisionTreeClassifier) but
            # draws them through a Fisher-Yates shuffle off the splitter's
            # rand_r state, seeded from random_state, and also compares
            # strictly. First drawn among equals wins there.
            #
            # Ties are the common case on this data. On the canonical digits
            # row, 68 of 122 split nodes have more than one feature at the
            # exact f32 minimum, mean multiplicity 9.7. At node 4, features
            # 3, 29, 37, 41, 45 and 46 all give weighted gini 0.32 against a
            # parent of 0.66, identical in f32 and in float64. Flow takes 3,
            # sklearn with random_state=42 takes 46, and both are correct.
            #
            # The choice is deliberate and stays. It makes the fit a pure
            # function of the data with no RNG for a plain tree. Matching
            # sklearn's pick would mean reproducing its xorshift stream and
            # its constant-feature draw bookkeeping bit for bit, and the
            # payoff is not accuracy: sweeping sklearn's own random_state
            # over 0..59 on this row spans 0.8111 to 0.8444, which contains
            # both Flow's 0.8333 and sklearn's seeded 0.8139.
            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
                best_is_cat = false
            }
        }
    }

    array_free_f32(sort_values)
    free(sort_classes as ptr<void>)
    free(left_counts as ptr<void>)
    free(right_counts as ptr<void>)
    free(present as ptr<void>)
    free(total_counts as ptr<void>)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        let y_sub: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_sub[i] = y[order[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_sub, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_sub)
        return node_idx
    }

    # Mark each row's side once, then split every feature's block in place
    # order. A child block stays ascending because it keeps the parent's
    # relative order.
    let mut left_n: i32 = 0
    if best_is_cat {
        # Commit the left set first so the routing here is the identical
        # predicate predict will use on the same node, rather than a second
        # copy of it that could drift.
        _tree_write_cat_mask(nodes, node_idx, best_cats, best_n_left_cats)
        let split_node: ptr<TreeNode> = nodes + node_idx
        for i in 0 to n_indices {
            let row: i32 = order[i]
            if _tree_split_goes_left(split_node, x_data[row * x_cols + best_feature]) {
                side[row] = 0
                left_n = left_n + 1
            } else {
                side[row] = 1
            }
        }
    } else {
        for i in 0 to n_indices {
            let row: i32 = order[i]
            if x_data[row * x_cols + best_feature] <= best_threshold {
                side[row] = 0
                left_n = left_n + 1
            } else {
                side[row] = 1
            }
        }
    }
    let right_n: i32 = n_indices - left_n

    let left_order: ptr<i32> = malloc(((x_cols as i64) * (left_n as i64) + 1) * 4) as ptr<i32>
    let right_order: ptr<i32> = malloc(((x_cols as i64) * (right_n as i64) + 1) * 4) as ptr<i32>

    for f in 0 to x_cols {
        let sbase: i32 = f * n_indices
        let lbase: i32 = f * left_n
        let rbase: i32 = f * right_n
        let mut li: i32 = 0
        let mut ri: i32 = 0
        for i in 0 to n_indices {
            let row: i32 = order[sbase + i]
            if side[row] == 0 {
                left_order[lbase + li] = row
                li = li + 1
            } else {
                right_order[rbase + ri] = row
                ri = ri + 1
            }
        }
    }

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = _build_classifier_tree(nodes, n_nodes, X, y, left_order, left_n, depth + 1, max_depth, criterion, classes, n_classes, class_of_row, side, cat_card, max_card, cat_iscratch, cat_mean)
    let right_idx: i32 = _build_classifier_tree(nodes, n_nodes, X, y, right_order, right_n, depth + 1, max_depth, criterion, classes, n_classes, class_of_row, side, cat_card, max_card, cat_iscratch, cat_mean)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_order as ptr<void>)
    free(right_order as ptr<void>)

    return node_idx
}

# Tree builder with feature subsampling for RandomForest.
# At each node, only max_features randomly chosen features are considered.
#
# Issue #457: a drawn feature flagged categorical in cat_card gets Breiman's
# subset scan instead of the threshold sweep, and an undrawn one is skipped
# whether it is categorical or numeric. The categorical scan runs from the same
# feature loop, after the same feature_mask test, so max_features means the
# same thing for both kinds of feature.
#
# The draw order is untouched. The feature mask is drawn before any feature is
# looked at, and it is drawn from n_features and the PRNG state alone, so which
# features are sampled does not depend on what those features contain.
#
# With no categorical feature max_card is 0, every cat_card entry is 0, the
# categorical branch is unreachable and this is the numeric builder unchanged.
function _build_classifier_tree_rf(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    indices: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32,
    classes: ptr<f32>,
    n_classes: i32,
    max_features: i32,
    prng_state: ptr<u32>,
    cat_card: ptr<i32>,
    max_card: i32,
    cat_iscratch: ptr<i32>,
    cat_mean: ptr<f32>
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_subset[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_subset, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = _gini(y_subset, n_indices, classes, n_classes)
        array_free_f32(y_subset)
        return node_idx
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0
    let mut best_is_cat: bool = false
    let mut best_n_left_cats: i32 = 0

    # Views into the one categorical scratch block the fit allocated. All five
    # are empty when max_card is 0, and nothing below reads them unless some
    # cat_card[f] is positive, which cannot happen when max_card is 0.
    let cat_count: ptr<i32> = cat_iscratch
    let cat_ci_sum: ptr<i32> = cat_iscratch + max_card
    let cat_ids: ptr<i32> = cat_iscratch + 2 * max_card
    let best_cats: ptr<i32> = cat_iscratch + 3 * max_card
    let cat_class: ptr<i32> = cat_iscratch + 4 * max_card

    # Row offsets into X.data, computed once per node and reused by every
    # candidate feature and by the final partition, instead of recomputing
    # indices[i] * X.cols inside matrix_at on every element touch.
    let x_data: ptr<f32> = X.data
    let x_cols: i32 = X.cols
    let class_bytes: i64 = (n_indices as i64) * 4
    let row_base: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        row_base[i] = indices[i] * x_cols
    }

    let class_idx: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        let mut ci: i32 = 0
        let yi: f32 = y[indices[i]]
        for c in 0 to n_classes {
            if yi == classes[c] { ci = c }
        }
        class_idx[i] = ci
    }

    let total_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { total_counts[c] = 0 }
    for i in 0 to n_indices { total_counts[class_idx[i]] = total_counts[class_idx[i]] + 1 }

    # Ascending list of the classes that actually occur at this node. A class
    # with no samples here has no samples on either side of any split below,
    # so its impurity term is 0.0 and dropping it is exact. Every count loop in
    # the split scan walks this list instead of the whole label set.
    let present: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let mut n_present: i32 = 0
    for c in 0 to n_classes {
        if total_counts[c] > 0 {
            present[n_present] = c
            n_present = n_present + 1
        }
    }

    let parent_impurity: f32 = _tree_gini_present(total_counts, present, n_present, n_indices)

    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_classes: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let left_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let right_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    # Determine which features to try at this node
    let n_features: i32 = X.cols
    let feature_mask: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>
    for f in 0 to n_features { feature_mask[f] = 0 }

    if max_features >= n_features {
        for f in 0 to n_features { feature_mask[f] = 1 }
    } else {
        # Randomly select max_features features without replacement
        let n_selected: i32 = 0
        while n_selected < max_features {
            let prng: PRNG = PRNG { state: prng_state[0] }
            let res: PRNGResult = prng_int(prng, n_features)
            prng_state[0] = res.state
            if feature_mask[res.value] == 0 {
                feature_mask[res.value] = 1
                n_selected = n_selected + 1
            }
        }
    }

    for f in 0 to n_features {
        if feature_mask[f] == 0 { continue }

        let card: i32 = cat_card[f]
        if card > 0 {
            # Breiman's subset search, the same scan the plain builder runs.
            # Bucket this node's rows by level, keeping each level's class
            # histogram and the sum of the class indices of its samples.
            for lv in 0 to card {
                cat_count[lv] = 0
                cat_ci_sum[lv] = 0
            }
            let cclen: i32 = card * n_classes
            for k in 0 to cclen { cat_class[k] = 0 }

            for i in 0 to n_indices {
                let lv: i32 = x_data[row_base[i] + f] as i32
                let cls: i32 = class_idx[i]
                cat_count[lv] = cat_count[lv] + 1
                cat_ci_sum[lv] = cat_ci_sum[lv] + cls
                cat_class[lv * n_classes + cls] = cat_class[lv * n_classes + cls] + 1
            }

            # Order the levels present here by their mean class index and score
            # only the k-1 prefixes of that ordering, so a 40-level column
            # costs 39 candidates rather than 2^39.
            let mut n_cats: i32 = 0
            for lv in 0 to card {
                if cat_count[lv] > 0 {
                    cat_ids[n_cats] = lv
                    cat_mean[n_cats] = (cat_ci_sum[lv] as f32) / (cat_count[lv] as f32)
                    n_cats = n_cats + 1
                }
            }
            if n_cats < 2 { continue }
            _sort_pairs(cat_mean, cat_ids, n_cats)

            for pi in 0 to n_present {
                let c: i32 = present[pi]
                left_counts[c] = 0
                right_counts[c] = total_counts[c]
            }

            let mut n_left_c: i32 = 0
            for j in 0 to n_cats - 1 {
                let lv: i32 = cat_ids[j]
                for pi in 0 to n_present {
                    let c: i32 = present[pi]
                    let hit: i32 = cat_class[lv * n_classes + c]
                    left_counts[c] = left_counts[c] + hit
                    right_counts[c] = right_counts[c] - hit
                }
                n_left_c = n_left_c + cat_count[lv]
                let n_right_c: i32 = n_indices - n_left_c
                if n_left_c < 1 || n_right_c < 1 { continue }

                let gini_left: f32 = _tree_gini_present(left_counts, present, n_present, n_left_c)
                let gini_right: f32 = _tree_gini_present(right_counts, present, n_present, n_right_c)
                let nf: f32 = n_indices as f32
                let weighted: f32 = (n_left_c as f32) / nf * gini_left + (n_right_c as f32) / nf * gini_right

                # The same strict comparison as the numeric scan below, run
                # from the same feature loop in the same index order, so the
                # tie-break rule pinned by #204 and #426 is unchanged: the
                # lowest feature index wins among equals whether the winner is
                # numeric or categorical, and within one categorical feature
                # the shortest left set wins.
                if weighted < best_impurity {
                    best_impurity = weighted
                    best_feature = f
                    best_threshold = 0.0
                    best_is_cat = true
                    best_n_left_cats = j + 1
                    for k in 0 to j + 1 { best_cats[k] = cat_ids[k] }
                }
            }
            continue
        }

        # Gather and check for a constant column in one pass. If every sample
        # shares a value, the scan below hits `sort_values[i] == sort_values[i+1]`
        # at every position and evaluates no candidate at all, so skipping the
        # sort and the scan changes nothing. Constant columns are common in a
        # forest: pixel-style features are constant over most nodes, and deeper
        # nodes make more of them constant.
        let first_value: f32 = x_data[row_base[0] + f]
        let mut is_constant: bool = true
        for i in 0 to n_indices {
            let v: f32 = x_data[row_base[i] + f]
            sort_values[i] = v
            if v != first_value { is_constant = false }
        }
        if is_constant { continue }

        memcpy(sort_classes as ptr<void>, class_idx as ptr<void>, class_bytes)
        _sort_pairs(sort_values, sort_classes, n_indices)

        # right_counts starts as the node's full class histogram, which is
        # exactly total_counts; left_counts starts empty. Seeding from the
        # histogram replaces a second pass over every sample.
        for pi in 0 to n_present {
            let c: i32 = present[pi]
            left_counts[c] = 0
            right_counts[c] = total_counts[c]
        }

        for i in 0 to n_indices - 1 {
            left_counts[sort_classes[i]] = left_counts[sort_classes[i]] + 1
            right_counts[sort_classes[i]] = right_counts[sort_classes[i]] - 1

            if sort_values[i] == sort_values[i + 1] { continue }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let gini_left: f32 = _tree_gini_present(left_counts, present, n_present, n_left)
            let gini_right: f32 = _tree_gini_present(right_counts, present, n_present, n_right)
            let nf: f32 = n_indices as f32
            let weighted: f32 = (n_left as f32) / nf * gini_left + (n_right as f32) / nf * gini_right

            # Same strict comparison and same lowest-index tie-break as the
            # plain builder above. The feature loop walks feature_mask in
            # ascending index order, so the sampled subset is scanned by index
            # rather than by the order it was drawn. See the note there and
            # #204: the canonical RandomForest digits row carries the same
            # +0.0194 accuracy difference from the same cause, tracked in #205.
            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
                best_is_cat = false
            }
        }
    }

    free(feature_mask as ptr<void>)
    array_free_f32(sort_values)
    free(sort_classes as ptr<void>)
    free(left_counts as ptr<void>)
    free(right_counts as ptr<void>)
    free(class_idx as ptr<void>)
    free(present as ptr<void>)
    free(total_counts as ptr<void>)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        let y_sub: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_sub[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _majority_class(y_sub, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_sub)
        free(row_base as ptr<void>)
        return node_idx
    }

    let left_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let right_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let mut left_n: i32 = 0
    let mut right_n: i32 = 0

    if best_is_cat {
        # Commit the left set first so the routing here is the identical
        # predicate predict will use on the same node, rather than a second
        # copy of it that could drift.
        _tree_write_cat_mask(nodes, node_idx, best_cats, best_n_left_cats)
        let split_node: ptr<TreeNode> = nodes + node_idx
        for i in 0 to n_indices {
            if _tree_split_goes_left(split_node, x_data[row_base[i] + best_feature]) {
                left_indices[left_n] = indices[i]
                left_n = left_n + 1
            } else {
                right_indices[right_n] = indices[i]
                right_n = right_n + 1
            }
        }
    } else {
        for i in 0 to n_indices {
            if x_data[row_base[i] + best_feature] <= best_threshold {
                left_indices[left_n] = indices[i]
                left_n = left_n + 1
            } else {
                right_indices[right_n] = indices[i]
                right_n = right_n + 1
            }
        }
    }

    free(row_base as ptr<void>)

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = _build_classifier_tree_rf(nodes, n_nodes, X, y, left_indices, left_n, depth + 1, max_depth, criterion, classes, n_classes, max_features, prng_state, cat_card, max_card, cat_iscratch, cat_mean)
    let right_idx: i32 = _build_classifier_tree_rf(nodes, n_nodes, X, y, right_indices, right_n, depth + 1, max_depth, criterion, classes, n_classes, max_features, prng_state, cat_card, max_card, cat_iscratch, cat_mean)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_indices as ptr<void>)
    free(right_indices as ptr<void>)

    return node_idx
}

# Fit a decision tree with feature subsampling (for RandomForest).
export function decision_tree_classifier_fit_rf(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32, max_features: i32, prng_state: ptr<u32>) -> DecisionTreeClassifier {
    # Every feature numeric: calloc gives the all-zero mask the categorical
    # fit reads as "no categorical features", and with max_card 0 the builder
    # never enters the categorical branch, so this is the old code path.
    let none: ptr<i32> = calloc(X.cols as i64, 4) as ptr<i32>
    let model: DecisionTreeClassifier = decision_tree_classifier_fit_rf_categorical(X, y, n_classes, max_depth, criterion, max_features, prng_state, none)
    free(none as ptr<void>)
    return model
}

# Issue #457: the feature-subsampling fit RandomForest uses, with the same
# per-feature categorical mask the plain classifier fit takes. `categorical` is
# X.cols entries, non-zero meaning categorical, and a categorical column must
# hold whole numbers in 0..127 which are read as level indices.
#
# The subset search is the same Breiman ordering the plain builder runs, and
# the same 128-level cap applies. It is scoped by max_features exactly as the
# threshold sweep is: a categorical feature that was not drawn at a node is not
# scanned there.
export function decision_tree_classifier_fit_rf_categorical(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32, max_features: i32, prng_state: ptr<u32>, categorical: ptr<i32>) -> DecisionTreeClassifier {
    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values

    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 64) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    let indices: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows { indices[i] = i }

    # Categorical bookkeeping, allocated once per tree rather than per node so
    # the numeric path picks up no extra allocation at all. With no categorical
    # feature max_card is 0 and these are a 16-byte stub and one float.
    let cat_card: ptr<i32> = _tree_cat_cardinalities(X, categorical)
    let max_card: i32 = _tree_cat_max_card(cat_card, X.cols)
    let ccap: i64 = max_card as i64
    let cat_iscratch: ptr<i32> = malloc((ccap * 4 + ccap * (n_classes as i64)) * 4 + 16) as ptr<i32>
    let cat_mean: ptr<f32> = array_new_f32(max_card + 1)

    let _final: i32 = _build_classifier_tree_rf(nodes, n_nodes_ptr, X, y, indices, X.rows, 0, max_depth, criterion, classes, n_classes, max_features, prng_state, cat_card, max_card, cat_iscratch, cat_mean)

    free(cat_card as ptr<void>)
    free(cat_iscratch as ptr<void>)
    array_free_f32(cat_mean)

    free(indices as ptr<void>)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        n_classes: n_classes,
        classes: classes,
        fitted: true
    }
}

export function decision_tree_classifier_predict_one(model: DecisionTreeClassifier, x: ptr<f32>) -> f32 {
    let mut node_idx: i32 = 0
    while not model.nodes[node_idx].is_leaf {
        let node: ptr<TreeNode> = model.nodes + node_idx
        if _tree_split_goes_left(node, x[node.feature]) {
            node_idx = node.left
        } else {
            node_idx = node.right
        }
    }
    return model.nodes[node_idx].value
}

export function decision_tree_classifier_predict(model: DecisionTreeClassifier, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        preds[i] = decision_tree_classifier_predict_one(model, row)
    }
    array_free_f32(row)
    return preds
}

export function decision_tree_classifier_free(model: DecisionTreeClassifier) -> void {
    free(model.nodes as ptr<void>)
    array_free_f32(model.classes)
}

# Feature importances for DecisionTreeClassifier.
# Computes the weighted impurity decrease per feature, normalized to sum 1.
# Addresses sklearn #34472: feature_importances_ with proper not-fitted check.
export function decision_tree_classifier_feature_importances(model: DecisionTreeClassifier, n_features: i32) -> ptr<f32> {
    if not model.fitted || model.n_nodes == 0 {
        println("[flow-scikit] ERROR: classifier not fitted, call fit before feature_importances_")
        return array_new_f32(n_features)
    }
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    let root_samples: f32 = model.nodes[0].n_samples as f32
    if root_samples < 1.0 {
        return importances
    }
    for i in 0 to model.n_nodes {
        let node: ptr<TreeNode> = model.nodes + i
        if not node.is_leaf {
            let left: ptr<TreeNode> = model.nodes + node.left
            let right: ptr<TreeNode> = model.nodes + node.right
            let decrease: f32 = (node.n_samples as f32) * node.impurity
                - (left.n_samples as f32) * left.impurity
                - (right.n_samples as f32) * right.impurity
            importances[node.feature] = importances[node.feature] + decrease / root_samples
        }
    }
    let mut total: f32 = 0.0
    for f in 0 to n_features {
        total = total + importances[f]
    }
    if total > 0.0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / total
        }
    }
    return importances
}

export function decision_tree_regressor_fit(X: Matrix, y: ptr<f32>, max_depth: i32, criterion: i32) -> DecisionTreeRegressor {
    let none: ptr<i32> = calloc(X.cols as i64, 4) as ptr<i32>
    let model: DecisionTreeRegressor = decision_tree_regressor_fit_categorical(X, y, max_depth, criterion, none)
    free(none as ptr<void>)
    return model
}

# Fit a regression tree where the features flagged in `categorical` are split
# on a subset of their levels. Same contract as
# decision_tree_classifier_fit_categorical: X.cols entries, non-zero meaning
# categorical, levels whole numbers in 0..127.
#
# Here Breiman's result is exact regardless of the number of levels. Ordering
# the levels by their mean response and scoring only the k-1 prefixes finds
# the subset split with the lowest weighted MSE, which is the theorem in CART
# section 9.4.
export function decision_tree_regressor_fit_categorical(X: Matrix, y: ptr<f32>, max_depth: i32, criterion: i32, categorical: ptr<i32>) -> DecisionTreeRegressor {
    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 64) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    let indices: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows {
        indices[i] = i
    }

    # As in the classifier: with no categorical feature max_card is 0, the
    # builder's categorical branch is unreachable and these are 16-byte stubs.
    let cat_card: ptr<i32> = _tree_cat_cardinalities(X, categorical)
    let max_card: i32 = _tree_cat_max_card(cat_card, X.cols)
    let rccap: i64 = max_card as i64
    let cat_iscratch: ptr<i32> = malloc(rccap * 12 + 16) as ptr<i32>
    let cat_fscratch: ptr<f32> = array_new_f32(3 * max_card + 4)

    let final_n_nodes: i32 = _build_regressor_tree(nodes, n_nodes_ptr, X, y, indices, X.rows, 0, max_depth, criterion, cat_card, max_card, cat_iscratch, cat_fscratch)

    free(indices as ptr<void>)
    free(cat_card as ptr<void>)
    free(cat_iscratch as ptr<void>)
    array_free_f32(cat_fscratch)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeRegressor {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        fitted: true
    }
}

function _build_regressor_tree(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    indices: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32,
    cat_card: ptr<i32>,
    max_card: i32,
    cat_iscratch: ptr<i32>,
    cat_fscratch: ptr<f32>
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices {
            y_subset[i] = y[indices[i]]
        }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _mean_val(y_subset, n_indices)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = _mse(y_subset, n_indices)
        array_free_f32(y_subset)
        return node_idx
    }

    # One copy of the node's y values, used both for the parent impurity and
    # for the sorted sweep. This used to be gathered twice into two separate
    # allocations holding the same numbers in the same order.
    let y_vals: ptr<f32> = array_new_f32(n_indices)
    for i in 0 to n_indices { y_vals[i] = y[indices[i]] }
    let parent_impurity: f32 = _mse(y_vals, n_indices)

    # Row offsets into X.data, computed once per node and reused by every
    # feature and by the final partition, instead of recomputing
    # indices[i] * X.cols inside matrix_at on every element touch.
    let x_data: ptr<f32> = X.data
    let x_cols: i32 = X.cols
    let row_base: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        row_base[i] = indices[i] * x_cols
    }

    let mut total_sum: f32 = 0.0
    let mut total_sum_sq: f32 = 0.0
    for i in 0 to n_indices {
        total_sum = total_sum + y_vals[i]
        total_sum_sq = total_sum_sq + y_vals[i] * y_vals[i]
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0
    let mut best_is_cat: bool = false
    let mut best_n_left_cats: i32 = 0

    # Views into the one categorical scratch block the fit allocated. All
    # empty when max_card is 0, and unreachable in that case.
    let cat_count: ptr<i32> = cat_iscratch
    let cat_ids: ptr<i32> = cat_iscratch + max_card
    let best_cats: ptr<i32> = cat_iscratch + 2 * max_card
    let cat_sum: ptr<f32> = cat_fscratch
    let cat_sum_sq: ptr<f32> = cat_fscratch + max_card
    let cat_mean: ptr<f32> = cat_fscratch + 2 * max_card

    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_y: ptr<f32> = array_new_f32(n_indices)

    for f in 0 to x_cols {
        let card: i32 = cat_card[f]
        if card > 0 {
            # Breiman's subset search, exact for MSE. Bucket by level, order
            # the levels present here by their mean response, then score the
            # k-1 prefixes of that ordering.
            for lv in 0 to card {
                cat_count[lv] = 0
                cat_sum[lv] = 0.0
                cat_sum_sq[lv] = 0.0
            }
            for i in 0 to n_indices {
                let lv: i32 = x_data[row_base[i] + f] as i32
                let yv: f32 = y_vals[i]
                cat_count[lv] = cat_count[lv] + 1
                cat_sum[lv] = cat_sum[lv] + yv
                cat_sum_sq[lv] = cat_sum_sq[lv] + yv * yv
            }

            let mut n_cats: i32 = 0
            for lv in 0 to card {
                if cat_count[lv] > 0 {
                    cat_ids[n_cats] = lv
                    cat_mean[n_cats] = cat_sum[lv] / (cat_count[lv] as f32)
                    n_cats = n_cats + 1
                }
            }
            if n_cats < 2 { continue }
            _sort_pairs(cat_mean, cat_ids, n_cats)

            let mut left_sum: f32 = 0.0
            let mut left_sum_sq: f32 = 0.0
            let mut n_left: i32 = 0
            for j in 0 to n_cats - 1 {
                let lv: i32 = cat_ids[j]
                left_sum = left_sum + cat_sum[lv]
                left_sum_sq = left_sum_sq + cat_sum_sq[lv]
                n_left = n_left + cat_count[lv]
                let n_right: i32 = n_indices - n_left
                if n_left < 1 || n_right < 1 { continue }

                let right_sum: f32 = total_sum - left_sum
                let right_sum_sq: f32 = total_sum_sq - left_sum_sq

                let nl: f32 = n_left as f32
                let nr: f32 = n_right as f32
                let left_mean: f32 = left_sum / nl
                let right_mean: f32 = right_sum / nr
                let left_mse: f32 = left_sum_sq / nl - left_mean * left_mean
                let right_mse: f32 = right_sum_sq / nr - right_mean * right_mean

                let nf: f32 = n_indices as f32
                let weighted: f32 = nl / nf * left_mse + nr / nf * right_mse

                if weighted < best_impurity {
                    best_impurity = weighted
                    best_feature = f
                    best_threshold = 0.0
                    best_is_cat = true
                    best_n_left_cats = j + 1
                    for k in 0 to j + 1 { best_cats[k] = cat_ids[k] }
                }
            }
            continue
        }

        # Gather and check for a constant column in one pass. If every sample
        # shares a value, the sweep below hits sort_values[i] == sort_values[i+1]
        # at every position and evaluates no candidate at all, and left_sum is
        # reset per feature, so skipping the sort and the sweep changes nothing.
        let first_value: f32 = x_data[row_base[0] + f]
        let mut is_constant: bool = true
        for i in 0 to n_indices {
            let v: f32 = x_data[row_base[i] + f]
            sort_values[i] = v
            if v != first_value { is_constant = false }
        }
        if is_constant { continue }

        memcpy(sort_y as ptr<void>, y_vals as ptr<void>, (n_indices as i64) * 4)

        # _sort_pairs_f32 stays as it is. Unlike the classifier, this sweep
        # accumulates left_sum and left_sum_sq in f32 in sorted position order,
        # so reordering equal values changes the rounding and can flip the
        # strict comparison below. The order among ties is part of the result
        # here, which is why the presorted-order rewrite the classifier got
        # does not apply.
        _sort_pairs_f32(sort_values, sort_y, n_indices)

        let mut left_sum: f32 = 0.0
        let mut left_sum_sq: f32 = 0.0

        for i in 0 to n_indices - 1 {
            left_sum = left_sum + sort_y[i]
            left_sum_sq = left_sum_sq + sort_y[i] * sort_y[i]

            if sort_values[i] == sort_values[i + 1] { continue }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let right_sum: f32 = total_sum - left_sum
            let right_sum_sq: f32 = total_sum_sq - left_sum_sq

            let nl: f32 = n_left as f32
            let nr: f32 = n_right as f32
            let left_mean: f32 = left_sum / nl
            let right_mean: f32 = right_sum / nr
            let left_mse: f32 = left_sum_sq / nl - left_mean * left_mean
            let right_mse: f32 = right_sum_sq / nr - right_mean * right_mean

            let nf: f32 = n_indices as f32
            let weighted: f32 = nl / nf * left_mse + nr / nf * right_mse

            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
                best_is_cat = false
            }
        }
    }

    array_free_f32(sort_values)
    array_free_f32(sort_y)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = _mean_val(y_vals, n_indices)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_vals)
        free(row_base as ptr<void>)
        return node_idx
    }

    array_free_f32(y_vals)

    let left_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let right_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let mut left_n: i32 = 0
    let mut right_n: i32 = 0

    if best_is_cat {
        _tree_write_cat_mask(nodes, node_idx, best_cats, best_n_left_cats)
        let split_node: ptr<TreeNode> = nodes + node_idx
        for i in 0 to n_indices {
            if _tree_split_goes_left(split_node, x_data[row_base[i] + best_feature]) {
                left_indices[left_n] = indices[i]
                left_n = left_n + 1
            } else {
                right_indices[right_n] = indices[i]
                right_n = right_n + 1
            }
        }
    } else {
        for i in 0 to n_indices {
            if x_data[row_base[i] + best_feature] <= best_threshold {
                left_indices[left_n] = indices[i]
                left_n = left_n + 1
            } else {
                right_indices[right_n] = indices[i]
                right_n = right_n + 1
            }
        }
    }

    free(row_base as ptr<void>)

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = _build_regressor_tree(nodes, n_nodes, X, y, left_indices, left_n, depth + 1, max_depth, criterion, cat_card, max_card, cat_iscratch, cat_fscratch)
    let right_idx: i32 = _build_regressor_tree(nodes, n_nodes, X, y, right_indices, right_n, depth + 1, max_depth, criterion, cat_card, max_card, cat_iscratch, cat_fscratch)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_indices as ptr<void>)
    free(right_indices as ptr<void>)

    return node_idx
}

export function decision_tree_regressor_predict_one(model: DecisionTreeRegressor, x: ptr<f32>) -> f32 {
    let mut node_idx: i32 = 0
    while not model.nodes[node_idx].is_leaf {
        let node: ptr<TreeNode> = model.nodes + node_idx
        if _tree_split_goes_left(node, x[node.feature]) {
            node_idx = node.left
        } else {
            node_idx = node.right
        }
    }
    return model.nodes[node_idx].value
}

export function decision_tree_regressor_predict(model: DecisionTreeRegressor, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        preds[i] = decision_tree_regressor_predict_one(model, row)
    }
    array_free_f32(row)
    return preds
}

export function decision_tree_regressor_free(model: DecisionTreeRegressor) -> void {
    free(model.nodes as ptr<void>)
}

# Feature importances for DecisionTreeRegressor.
# Addresses sklearn #34472: feature_importances_ with proper not-fitted check.
export function decision_tree_regressor_feature_importances(model: DecisionTreeRegressor, n_features: i32) -> ptr<f32> {
    if not model.fitted || model.n_nodes == 0 {
        println("[flow-scikit] ERROR: regressor not fitted, call fit before feature_importances_")
        return array_new_f32(n_features)
    }
    let importances: ptr<f32> = array_new_f32(n_features)
    for f in 0 to n_features {
        importances[f] = 0.0
    }
    let root_samples: f32 = model.nodes[0].n_samples as f32
    if root_samples < 1.0 {
        return importances
    }
    for i in 0 to model.n_nodes {
        let node: ptr<TreeNode> = model.nodes + i
        if not node.is_leaf {
            let left: ptr<TreeNode> = model.nodes + node.left
            let right: ptr<TreeNode> = model.nodes + node.right
            let decrease: f32 = (node.n_samples as f32) * node.impurity
                - (left.n_samples as f32) * left.impurity
                - (right.n_samples as f32) * right.impurity
            importances[node.feature] = importances[node.feature] + decrease / root_samples
        }
    }
    let mut total: f32 = 0.0
    for f in 0 to n_features {
        total = total + importances[f]
    }
    if total > 0.0 {
        for f in 0 to n_features {
            importances[f] = importances[f] / total
        }
    }
    return importances
}

# ============================================================================
# ExtraTreeClassifier (randomized splitting)
# ============================================================================

export struct ExtraTreeClassifier {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    n_features: i32,
    n_classes: i32,
    fitted: bool
}

# Draw the left set for an ExtraTree split on a categorical feature.
#
# Issue #457. The ExtraTree split rule is "pick one feature at random, then one
# cut at random inside it". On an ordered feature the random cut is the
# midpoint of two randomly drawn sample values. The subset analogue, the one
# Geurts, Ernst and Wehenkel give for a nominal attribute, is a random
# non-empty proper subset of the levels present at the node, drawn by one coin
# flip per level.
#
# `seen`, `present_lv` and `left_lv` are 128-entry scratch arrays owned by the
# fit, so a node allocates nothing. The return value is the number of levels
# written to left_lv, and 0 means the node has fewer than two levels here and
# cannot be split on this feature at all.
#
# A draw that lands on the empty set or on every level is not a split, so it is
# repaired to the single lowest level rather than redrawn. Redrawing would make
# the number of rand() calls at a node depend on the draws themselves, and the
# repaired set is still a valid random subset of a set the node can separate.
#
# rand() is consumed only when this is reached, which is only when the node's
# drawn feature is categorical, so the numeric path draws exactly what it drew
# before: one feature and two rows per node, in that order.
function _tree_extra_cat_left_set(X: Matrix, n: i32, feature: i32, seen: ptr<i32>, present_lv: ptr<i32>, left_lv: ptr<i32>) -> i32 {
    for lv in 0 to 128 { seen[lv] = 0 }
    for i in 0 to n {
        let v: f32 = matrix_at(X, i, feature)
        let c: i32 = v as i32
        if (c as f32) == v {
            if c >= 0 && c < 128 { seen[c] = 1 }
        }
    }
    let mut k: i32 = 0
    for lv in 0 to 128 {
        if seen[lv] == 1 {
            present_lv[k] = lv
            k = k + 1
        }
    }
    if k < 2 { return 0 }

    let mut nl: i32 = 0
    for j in 0 to k {
        let coin: i32 = rand() % 2
        if coin == 1 {
            left_lv[nl] = present_lv[j]
            nl = nl + 1
        }
    }
    if nl == 0 || nl == k {
        left_lv[0] = present_lv[0]
        nl = 1
    }
    return nl
}

export function extra_tree_classifier_fit(X: Matrix, y: ptr<f32>, n_samples: i32, n_features: i32, n_classes: i32, max_depth: i32, seed: i32) -> ExtraTreeClassifier {
    # Every feature numeric: calloc gives the all-zero mask the categorical fit
    # reads as "no categorical features", so this is the old code path.
    let none: ptr<i32> = calloc(X.cols as i64, 4) as ptr<i32>
    let model: ExtraTreeClassifier = extra_tree_classifier_fit_categorical(X, y, n_samples, n_features, n_classes, max_depth, seed, none)
    free(none as ptr<void>)
    return model
}

# Issue #457: the ExtraTree classifier with a per-feature categorical mask.
# `categorical` is X.cols entries, non-zero meaning categorical, and a
# categorical column must hold whole numbers in 0..127 read as level indices.
# A node whose drawn feature is categorical splits on a random subset of the
# levels present there instead of on a random threshold.
export function extra_tree_classifier_fit_categorical(X: Matrix, y: ptr<f32>, n_samples: i32, n_features: i32, n_classes: i32, max_depth: i32, seed: i32, categorical: ptr<i32>) -> ExtraTreeClassifier {
    srand(seed)
    let nodes: ptr<TreeNode> = calloc(1024 as i64, 64) as ptr<TreeNode>
    let mut n_nodes: i32 = 0

    # One allocation per fit, not per node, so the numeric path is unchanged.
    let cat_card: ptr<i32> = _tree_cat_cardinalities(X, categorical)
    let et_seen: ptr<i32> = malloc(512) as ptr<i32>
    let et_present: ptr<i32> = malloc(512) as ptr<i32>
    let et_left: ptr<i32> = malloc(512) as ptr<i32>

    n_nodes = _extra_tree_clf_build(nodes, n_nodes, X, y, n_samples, n_features, n_classes, 0, max_depth, seed, cat_card, et_seen, et_present, et_left)

    free(cat_card as ptr<void>)
    free(et_seen as ptr<void>)
    free(et_present as ptr<void>)
    free(et_left as ptr<void>)

    return ExtraTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        n_features: n_features,
        n_classes: n_classes,
        fitted: true
    }
}

function _extra_tree_clf_build(nodes: ptr<TreeNode>, node_idx: i32, X: Matrix, y: ptr<f32>, n: i32, p: i32, n_classes: i32, depth: i32, max_depth: i32, seed: i32, cat_card: ptr<i32>, et_seen: ptr<i32>, et_present: ptr<i32>, et_left: ptr<i32>) -> i32 {
    let mut idx: i32 = node_idx

    let mut class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { class_counts[c] = 0 }
    for i in 0 to n {
        let c: i32 = y[i] as i32
        if c >= 0 && c < n_classes { class_counts[c] = class_counts[c] + 1 }
    }

    let mut best_class: i32 = 0
    let mut best_count: i32 = 0
    for c in 0 to n_classes {
        if class_counts[c] > best_count {
            best_count = class_counts[c]
            best_class = c
        }
    }

    let pure: bool = best_count == n
    if pure || depth >= max_depth || n < 2 {
        nodes[idx].is_leaf = true
        nodes[idx].value = best_class as f32
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        free(class_counts as ptr<void>)
        return idx + 1
    }

    let feature: i32 = rand() % p
    let r1: i32 = rand() % n
    let r2: i32 = rand() % n

    # A categorical feature splits on a random subset of its levels; the two
    # row draws above are spent either way, so the numeric draw order stands.
    let is_cat: bool = cat_card[feature] > 0
    let mut n_left_cats: i32 = 0
    if is_cat {
        n_left_cats = _tree_extra_cat_left_set(X, n, feature, et_seen, et_present, et_left)
    }

    let mut degenerate: bool = r1 == r2
    if is_cat { degenerate = n_left_cats == 0 }
    if degenerate {
        nodes[idx].is_leaf = true
        nodes[idx].value = best_class as f32
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        free(class_counts as ptr<void>)
        return idx + 1
    }

    let mut threshold: f32 = 0.0
    if is_cat {
        # Commit the left set before partitioning so the routing here is the
        # identical predicate predict will use on the same node.
        _tree_write_cat_mask(nodes, idx, et_left, n_left_cats)
    } else {
        threshold = (matrix_at(X, r1, feature) + matrix_at(X, r2, feature)) / 2.0
    }

    let left_y: ptr<f32> = array_new_f32(n)
    let right_y: ptr<f32> = array_new_f32(n)
    let left_X: Matrix = matrix_new(n, p)
    let right_X: Matrix = matrix_new(n, p)
    let mut n_left: i32 = 0
    let mut n_right: i32 = 0

    let split_node: ptr<TreeNode> = nodes + idx
    for i in 0 to n {
        let xv: f32 = matrix_at(X, i, feature)
        let mut goes_left: bool = xv <= threshold
        if is_cat { goes_left = _tree_split_goes_left(split_node, xv) }
        if goes_left {
            for j in 0 to p { matrix_set(left_X, n_left, j, matrix_at(X, i, j)) }
            left_y[n_left] = y[i]
            n_left = n_left + 1
        } else {
            for j in 0 to p { matrix_set(right_X, n_right, j, matrix_at(X, i, j)) }
            right_y[n_right] = y[i]
            n_right = n_right + 1
        }
    }

    nodes[idx].is_leaf = false
    nodes[idx].feature = feature
    nodes[idx].threshold = threshold
    nodes[idx].left = idx + 1
    free(class_counts as ptr<void>)

    if n_left == 0 || n_right == 0 {
        nodes[idx].is_leaf = true
        nodes[idx].value = best_class as f32
        nodes[idx].feature = -1
        nodes[idx].left = -1
        nodes[idx].right = -1
        # A leaf carries no split, so the left set written above is cleared
        # rather than left behind for a node dump to trip over.
        nodes[idx].cat_kind = 0
        nodes[idx].cat_mask0 = 0 as u32
        nodes[idx].cat_mask1 = 0 as u32
        nodes[idx].cat_mask2 = 0 as u32
        nodes[idx].cat_mask3 = 0 as u32
        matrix_free(left_X)
        matrix_free(right_X)
        array_free_f32(left_y)
        array_free_f32(right_y)
        return idx + 1
    }

    let left_idx: i32 = idx + 1
    let next_idx: i32 = _extra_tree_clf_build(nodes, left_idx, left_X, left_y, n_left, p, n_classes, depth + 1, max_depth, seed + 1, cat_card, et_seen, et_present, et_left)
    nodes[idx].right = next_idx

    let right_idx: i32 = next_idx
    let final_idx: i32 = _extra_tree_clf_build(nodes, right_idx, right_X, right_y, n_right, p, n_classes, depth + 1, max_depth, seed + 2, cat_card, et_seen, et_present, et_left)

    matrix_free(left_X)
    matrix_free(right_X)
    array_free_f32(left_y)
    array_free_f32(right_y)

    return final_idx
}

export function extra_tree_classifier_predict(model: ExtraTreeClassifier, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        let mut node: i32 = 0
        while not model.nodes[node].is_leaf {
            let np: ptr<TreeNode> = model.nodes + node
            if _tree_split_goes_left(np, row[np.feature]) {
                node = np.left
            } else {
                node = np.right
            }
        }
        result[i] = model.nodes[node].value
    }
    array_free_f32(row)
    return result
}

export function extra_tree_classifier_free(model: ExtraTreeClassifier) -> void {
    free(model.nodes as ptr<void>)
}

# ============================================================================
# ExtraTreeRegressor (randomized splitting)
# ============================================================================

export struct ExtraTreeRegressor {
    nodes: ptr<TreeNode>,
    n_nodes: i32,
    max_depth: i32,
    n_features: i32,
    fitted: bool
}

export function extra_tree_regressor_fit(X: Matrix, y: ptr<f32>, n_samples: i32, n_features: i32, max_depth: i32, seed: i32) -> ExtraTreeRegressor {
    # Every feature numeric: calloc gives the all-zero mask the categorical fit
    # reads as "no categorical features", so this is the old code path.
    let none: ptr<i32> = calloc(X.cols as i64, 4) as ptr<i32>
    let model: ExtraTreeRegressor = extra_tree_regressor_fit_categorical(X, y, n_samples, n_features, max_depth, seed, none)
    free(none as ptr<void>)
    return model
}

# Issue #457: the ExtraTree regressor with a per-feature categorical mask, the
# same contract as extra_tree_classifier_fit_categorical.
export function extra_tree_regressor_fit_categorical(X: Matrix, y: ptr<f32>, n_samples: i32, n_features: i32, max_depth: i32, seed: i32, categorical: ptr<i32>) -> ExtraTreeRegressor {
    srand(seed)
    let nodes: ptr<TreeNode> = calloc(1024 as i64, 64) as ptr<TreeNode>
    let mut n_nodes: i32 = 0

    let cat_card: ptr<i32> = _tree_cat_cardinalities(X, categorical)
    let et_seen: ptr<i32> = malloc(512) as ptr<i32>
    let et_present: ptr<i32> = malloc(512) as ptr<i32>
    let et_left: ptr<i32> = malloc(512) as ptr<i32>

    n_nodes = _extra_tree_reg_build(nodes, n_nodes, X, y, n_samples, n_features, 0, max_depth, seed, cat_card, et_seen, et_present, et_left)

    free(cat_card as ptr<void>)
    free(et_seen as ptr<void>)
    free(et_present as ptr<void>)
    free(et_left as ptr<void>)

    return ExtraTreeRegressor {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        n_features: n_features,
        fitted: true
    }
}

function _extra_tree_reg_build(nodes: ptr<TreeNode>, node_idx: i32, X: Matrix, y: ptr<f32>, n: i32, p: i32, depth: i32, max_depth: i32, seed: i32, cat_card: ptr<i32>, et_seen: ptr<i32>, et_present: ptr<i32>, et_left: ptr<i32>) -> i32 {
    let mut idx: i32 = node_idx

    let mut mean: f32 = 0.0
    for i in 0 to n { mean = mean + y[i] }
    mean = mean / (n as f32)

    if n < 2 || depth >= max_depth {
        nodes[idx].is_leaf = true
        nodes[idx].value = mean
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        return idx + 1
    }

    let feature: i32 = rand() % p
    let r1: i32 = rand() % n
    let r2: i32 = rand() % n

    # A categorical feature splits on a random subset of its levels; the two
    # row draws above are spent either way, so the numeric draw order stands.
    let is_cat: bool = cat_card[feature] > 0
    let mut n_left_cats: i32 = 0
    if is_cat {
        n_left_cats = _tree_extra_cat_left_set(X, n, feature, et_seen, et_present, et_left)
    }

    let mut degenerate: bool = r1 == r2
    if is_cat { degenerate = n_left_cats == 0 }
    if degenerate {
        nodes[idx].is_leaf = true
        nodes[idx].value = mean
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        return idx + 1
    }

    let mut threshold: f32 = 0.0
    if is_cat {
        # Commit the left set before partitioning so the routing here is the
        # identical predicate predict will use on the same node.
        _tree_write_cat_mask(nodes, idx, et_left, n_left_cats)
    } else {
        threshold = (matrix_at(X, r1, feature) + matrix_at(X, r2, feature)) / 2.0
    }

    let left_y: ptr<f32> = array_new_f32(n)
    let right_y: ptr<f32> = array_new_f32(n)
    let left_X: Matrix = matrix_new(n, p)
    let right_X: Matrix = matrix_new(n, p)
    let mut n_left: i32 = 0
    let mut n_right: i32 = 0

    let split_node: ptr<TreeNode> = nodes + idx
    for i in 0 to n {
        let xv: f32 = matrix_at(X, i, feature)
        let mut goes_left: bool = xv <= threshold
        if is_cat { goes_left = _tree_split_goes_left(split_node, xv) }
        if goes_left {
            for j in 0 to p { matrix_set(left_X, n_left, j, matrix_at(X, i, j)) }
            left_y[n_left] = y[i]
            n_left = n_left + 1
        } else {
            for j in 0 to p { matrix_set(right_X, n_right, j, matrix_at(X, i, j)) }
            right_y[n_right] = y[i]
            n_right = n_right + 1
        }
    }

    if n_left == 0 || n_right == 0 {
        nodes[idx].is_leaf = true
        nodes[idx].value = mean
        nodes[idx].feature = -1
        nodes[idx].threshold = 0.0
        nodes[idx].left = -1
        nodes[idx].right = -1
        # A leaf carries no split, so the left set written above is cleared.
        nodes[idx].cat_kind = 0
        nodes[idx].cat_mask0 = 0 as u32
        nodes[idx].cat_mask1 = 0 as u32
        nodes[idx].cat_mask2 = 0 as u32
        nodes[idx].cat_mask3 = 0 as u32
        matrix_free(left_X)
        matrix_free(right_X)
        array_free_f32(left_y)
        array_free_f32(right_y)
        return idx + 1
    }

    nodes[idx].is_leaf = false
    nodes[idx].feature = feature
    nodes[idx].threshold = threshold
    nodes[idx].left = idx + 1

    let left_idx: i32 = idx + 1
    let next_idx: i32 = _extra_tree_reg_build(nodes, left_idx, left_X, left_y, n_left, p, depth + 1, max_depth, seed + 1, cat_card, et_seen, et_present, et_left)
    nodes[idx].right = next_idx

    let right_idx: i32 = next_idx
    let final_idx: i32 = _extra_tree_reg_build(nodes, right_idx, right_X, right_y, n_right, p, depth + 1, max_depth, seed + 2, cat_card, et_seen, et_present, et_left)

    matrix_free(left_X)
    matrix_free(right_X)
    array_free_f32(left_y)
    array_free_f32(right_y)

    return final_idx
}

export function extra_tree_regressor_predict(model: ExtraTreeRegressor, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    let row: ptr<f32> = array_new_f32(X.cols)
    for i in 0 to X.rows {
        matrix_row(X, i, row)
        let mut node: i32 = 0
        while not model.nodes[node].is_leaf {
            let np: ptr<TreeNode> = model.nodes + node
            if _tree_split_goes_left(np, row[np.feature]) {
                node = np.left
            } else {
                node = np.right
            }
        }
        result[i] = model.nodes[node].value
    }
    array_free_f32(row)
    return result
}

export function extra_tree_regressor_free(model: ExtraTreeRegressor) -> void {
    free(model.nodes as ptr<void>)
}

# ============================================================================
# Tree visualization: export_text
# ============================================================================

export function export_tree_text(model: DecisionTreeClassifier, max_depth: i32) -> void {
    _export_tree_text_recursive(model.nodes, 0, 0, max_depth, true, true)
}

export function export_tree_text_reg(model: DecisionTreeRegressor, max_depth: i32) -> void {
    _export_tree_text_recursive(model.nodes, 0, 0, max_depth, false, true)
}

function _export_tree_text_recursive(
    nodes: ptr<TreeNode>, node_idx: i32, depth: i32,
    max_depth: i32, is_classifier: bool, is_left: bool
) -> void {
    if max_depth > 0 && depth >= max_depth {
        return
    }
    let node: TreeNode = nodes[node_idx]
    let mut i: i32 = 0
    while i < depth {
        print("  ")
        i = i + 1
    }
    if depth > 0 {
        if is_left {
            print("L: ")
        } else {
            print("R: ")
        }
    }
    if node.is_leaf {
        if is_classifier {
            print("class = ")
            printf("%.0f", node.value)
        } else {
            print("value = ")
            printf("%.4f", node.value)
        }
        print(" (n=")
        print(node.n_samples)
        println(")")
    } else {
        print("feature ")
        print(node.feature)
        print(" <= ")
        printf("%.4f", node.threshold)
        print("  (n=")
        print(node.n_samples)
        println(")")
        _export_tree_text_recursive(nodes, node.left, depth + 1, max_depth, is_classifier, true)
        _export_tree_text_recursive(nodes, node.right, depth + 1, max_depth, is_classifier, false)
    }
}

# ============================================================================
# Tree visualization: export_graphviz (DOT format)
# ============================================================================

export function export_graphviz(model: DecisionTreeClassifier) -> void {
    println("digraph Tree {")
    _export_graphviz_recursive(model.nodes, 0, 0, true)
    println("}")
}

export function export_graphviz_reg(model: DecisionTreeRegressor) -> void {
    println("digraph Tree {")
    _export_graphviz_recursive(model.nodes, 0, 0, false)
    println("}")
}

function _export_graphviz_recursive(
    nodes: ptr<TreeNode>, node_idx: i32, depth: i32, is_classifier: bool
) -> void {
    let node: TreeNode = nodes[node_idx]
    print("  ")
    print(node_idx)
    print(" [label=")
    if node.is_leaf {
        if is_classifier {
            print("class=")
            printf("%.0f", node.value)
        } else {
            print("value=")
            printf("%.4f", node.value)
        }
        print(" nsamples=")
        print(node.n_samples)
    } else {
        print("feature")
        print(node.feature)
        print(" <=")
        printf("%.4f", node.threshold)
        print(" nsamples=")
        print(node.n_samples)
    }
    println("]")

    if not node.is_leaf {
        print("  ")
        print(node_idx)
        print(" -> ")
        print(node.left)
        println(" [label=true]")
        print("  ")
        print(node_idx)
        print(" -> ")
        print(node.right)
        println(" [label=false]")
        _export_graphviz_recursive(nodes, node.left, depth + 1, is_classifier)
        _export_graphviz_recursive(nodes, node.right, depth + 1, is_classifier)
    }
}
