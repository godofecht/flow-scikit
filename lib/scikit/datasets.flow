# Synthetic dataset generators for flow-scikit.
# Mirrors sklearn.datasets.make_* functions.

import "lib/scikit/matrix.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
    function sqrt(x: f64) -> f64
    function exp(x: f64) -> f64
    function log(x: f64) -> f64
    function fabs(x: f64) -> f64
    function sin(x: f64) -> f64
    function cos(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function _gauss(seed: i32) -> f32 {
    let u1: f32 = ((rand() % 10000) as f32) / 10000.0
    let u2: f32 = ((rand() % 10000) as f32) / 10000.0
    if u1 < 0.000001 { u1 = 0.000001 }
    let r: f32 = sqrt((0.0 - 2.0 * log(u1 as f64)) as f64) as f32
    let theta: f32 = 2.0 * 3.14159265 * u2
    return r * cos(theta as f64) as f32
}

export function make_classification(
    n_samples: i32, n_features: i32, n_classes: i32,
    n_informative: i32, n_redundant: i32,
    class_sep: f32, seed: i32
) -> Dataset {
    srand(seed)

    let X: Matrix = matrix_new(n_samples, n_features)
    let y: ptr<f32> = array_new_f32(n_samples)

    let weights: ptr<f32> = array_new_f32(n_informative)
    for j in 0 to n_informative {
        weights[j] = ((rand() % 100) as f32) / 10.0 - 5.0
    }

    let per_class: i32 = n_samples / n_classes

    for c in 0 to n_classes {
        let cx: f32 = (c as f32) * class_sep
        for i in 0 to per_class {
            let idx: i32 = c * per_class + i
            if idx >= n_samples { break }

            for j in 0 to n_features {
                let val: f32 = _gauss(idx * 100 + j) + cx
                if j < n_informative {
                    val = val + weights[j] * (c as f32)
                } else {
                    if j < n_informative + n_redundant {
                        let src: i32 = j % n_informative
                        val = val + matrix_at(X, idx, src) * 0.5
                    }
                }
                matrix_set(X, idx, j, val)
            }
            y[idx] = (c as f32)
        }
    }

    free(weights as ptr<void>)

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: n_features,
        n_classes: n_classes,
        is_classification: true
    }
}

export function make_regression(
    n_samples: i32, n_features: i32, n_informative: i32,
    noise: f32, bias: f32, seed: i32
) -> Dataset {
    srand(seed)

    let X: Matrix = matrix_new(n_samples, n_features)
    let y: ptr<f32> = array_new_f32(n_samples)

    let weights: ptr<f32> = array_new_f32(n_informative)
    for j in 0 to n_informative {
        weights[j] = ((rand() % 100) as f32) / 10.0 - 5.0
    }

    for i in 0 to n_samples {
        for j in 0 to n_features {
            matrix_set(X, i, j, _gauss(i * 100 + j))
        }

        let mut y_val: f32 = bias
        for j in 0 to n_informative {
            y_val = y_val + weights[j] * matrix_at(X, i, j)
        }
        y_val = y_val + _gauss(i * 200) * noise
        y[i] = y_val
    }

    free(weights as ptr<void>)

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: n_features,
        n_classes: 0,
        is_classification: false
    }
}

export function make_blobs(
    n_samples: i32, n_features: i32, n_centers: i32,
    cluster_std: f32, center_box_min: f32, center_box_max: f32,
    seed: i32
) -> Dataset {
    srand(seed)

    let X: Matrix = matrix_new(n_samples, n_features)
    let y: ptr<f32> = array_new_f32(n_samples)

    let centers: ptr<f32> = array_new_f32(n_centers * n_features)
    for c in 0 to n_centers {
        for j in 0 to n_features {
            let range: f32 = center_box_max - center_box_min
            centers[c * n_features + j] = center_box_min + ((rand() % 1000) as f32) / 1000.0 * range
        }
    }

    let per_center: i32 = n_samples / n_centers

    for c in 0 to n_centers {
        for i in 0 to per_center {
            let idx: i32 = c * per_center + i
            if idx >= n_samples { break }

            for j in 0 to n_features {
                let val: f32 = centers[c * n_features + j] + _gauss(idx * 100 + j) * cluster_std
                matrix_set(X, idx, j, val)
            }
            y[idx] = (c as f32)
        }
    }

    free(centers as ptr<void>)

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: n_features,
        n_classes: n_centers,
        is_classification: true
    }
}

export function make_moons(n_samples: i32, noise: f32, seed: i32) -> Dataset {
    srand(seed)

    let X: Matrix = matrix_new(n_samples, 2)
    let y: ptr<f32> = array_new_f32(n_samples)

    let half: i32 = n_samples / 2

    for i in 0 to half {
        let t: f32 = 3.14159265 * ((i as f32) / (half as f32))
        let x: f32 = cos(t as f64) as f32 + _gauss(i) * noise
        let y_val: f32 = sin(t as f64) as f32 + _gauss(i + 1000) * noise
        matrix_set(X, i, 0, x)
        matrix_set(X, i, 1, y_val)
        y[i] = 0.0
    }

    for i in 0 to (n_samples - half) {
        let idx: i32 = half + i
        let t: f32 = 3.14159265 * ((i as f32) / ((n_samples - half) as f32))
        let x: f32 = 1.0 - cos(t as f64) as f32 + _gauss(idx) * noise
        let y_val: f32 = 0.0 - sin(t as f64) as f32 + _gauss(idx + 1000) * noise
        matrix_set(X, idx, 0, x)
        matrix_set(X, idx, 1, y_val)
        y[idx] = 1.0
    }

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: 2,
        n_classes: 2,
        is_classification: true
    }
}

export function make_circles(n_samples: i32, noise: f32, factor: f32, seed: i32) -> Dataset {
    srand(seed)

    let X: Matrix = matrix_new(n_samples, 2)
    let y: ptr<f32> = array_new_f32(n_samples)

    let half: i32 = n_samples / 2

    for i in 0 to half {
        let t: f32 = 2.0 * 3.14159265 * ((i as f32) / (half as f32))
        let r: f32 = 1.0
        matrix_set(X, i, 0, r * cos(t as f64) as f32 + _gauss(i) * noise)
        matrix_set(X, i, 1, r * sin(t as f64) as f32 + _gauss(i + 1000) * noise)
        y[i] = 0.0
    }

    for i in 0 to (n_samples - half) {
        let idx: i32 = half + i
        let t: f32 = 2.0 * 3.14159265 * ((i as f32) / ((n_samples - half) as f32))
        let r: f32 = factor
        matrix_set(X, idx, 0, r * cos(t as f64) as f32 + _gauss(idx) * noise)
        matrix_set(X, idx, 1, r * sin(t as f64) as f32 + _gauss(idx + 1000) * noise)
        y[idx] = 1.0
    }

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: 2,
        n_classes: 2,
        is_classification: true
    }
}

export function dataset_free(d: Dataset) -> void {
    matrix_free(d.X)
    array_free_f32(d.y)
}

# ============================================================================
# load_iris (simplified, 150 samples, 4 features, 3 classes)
# ============================================================================

export function load_iris() -> Dataset {
    let n: i32 = 150
    let p: i32 = 4
    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    let base: ptr<ptr<f32> > = malloc((3 as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to 3 {
        base[c] = array_new_f32(p)
    }
    base[0][0] = 5.0; base[0][1] = 3.4; base[0][2] = 1.5; base[0][3] = 0.2
    base[1][0] = 5.9; base[1][1] = 2.8; base[1][2] = 4.3; base[1][3] = 1.3
    base[2][0] = 6.5; base[2][1] = 3.0; base[2][2] = 5.5; base[2][3] = 2.0

    let spread: ptr<f32> = array_new_f32(p)
    spread[0] = 0.35; spread[1] = 0.32; spread[2] = 0.55; spread[3] = 0.25

    srand(42)
    for i in 0 to n {
        let c: i32 = i / 50
        y[i] = c as f32
        for j in 0 to p {
            let noise: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * spread[j]
            matrix_set(X, i, j, base[c][j] + noise)
        }
    }

    for c in 0 to 3 { array_free_f32(base[c]) }
    free(base as ptr<void>)
    array_free_f32(spread)

    return Dataset {
        X: X, y: y,
        n_samples: n,
        n_features: p,
        n_classes: 3,
        is_classification: true
    }
}

# ============================================================================
# make_s_curve
# ============================================================================

export function make_s_curve(n_samples: i32, noise: f32, seed: i32) -> Dataset {
    let X: Matrix = matrix_new(n_samples, 3)
    let y: ptr<f32> = array_new_f32(n_samples)

    srand(seed)
    for i in 0 to n_samples {
        let t: f32 = 3.0 * 3.14159265 * (((rand() % 10000) as f32) / 10000.0)
        let n0: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * noise
        let n1: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * noise
        let n2: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * noise

        matrix_set(X, i, 0, sin((t) as f64) as f32 + n0)
        matrix_set(X, i, 1, t / 3.0 + n1)
        matrix_set(X, i, 2, 0.0 + n2)
        y[i] = t
    }

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: 3,
        n_classes: 0,
        is_classification: false
    }
}

# ============================================================================
# make_swiss_roll
# ============================================================================

export function make_swiss_roll(n_samples: i32, noise: f32, seed: i32) -> Dataset {
    let X: Matrix = matrix_new(n_samples, 3)
    let y: ptr<f32> = array_new_f32(n_samples)

    srand(seed)
    for i in 0 to n_samples {
        let t: f32 = 1.5 * 3.14159265 * (1.0 + 2.0 * ((rand() % 10000) as f32) / 10000.0)
        let h: f32 = 21.0 * ((rand() % 10000) as f32) / 10000.0
        let n0: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * noise
        let n1: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * noise
        let n2: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * noise

        matrix_set(X, i, 0, t * cos((t) as f64) as f32 + n0)
        matrix_set(X, i, 1, h + n1)
        matrix_set(X, i, 2, t * sin((t) as f64) as f32 + n2)
        y[i] = t
    }

    return Dataset {
        X: X, y: y,
        n_samples: n_samples,
        n_features: 3,
        n_classes: 0,
        is_classification: false
    }
}

# ============================================================================
# load_digits (simplified, 8x8=64 features, 10 classes, 1797 samples)
# ============================================================================

export function load_digits() -> Dataset {
    let n: i32 = 180
    let p: i32 = 64
    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    srand(42)
    let per_class: i32 = n / 10

    let mut c: i32 = 0
    while c < 10 {
        let mut i: i32 = 0
        while i < per_class {
            let idx: i32 = c * per_class + i
            y[idx] = c as f32
            let mut j: i32 = 0
            while j < p {
                let row: i32 = j / 8
                let col: i32 = j % 8
                let center_row: f32 = 3.5 + (c as f32) * 0.3
                let center_col: f32 = 3.5
                let dist: f32 = sqrt(((row as f32 - center_row) * (row as f32 - center_row) + (col as f32 - center_col) * (col as f32 - center_col)) as f64) as f32
                let val: f32 = 16.0 - dist * 2.0
                if val < 0.0 { val = 0.0 }
                val = val + (((rand() % 100) as f32) / 100.0 - 0.5) * 4.0
                if val < 0.0 { val = 0.0 }
                if val > 16.0 { val = 16.0 }
                matrix_set(X, idx, j, val)
                j = j + 1
            }
            i = i + 1
        }
        c = c + 1
    }

    return Dataset {
        X: X, y: y,
        n_samples: n, n_features: p,
        n_classes: 10, is_classification: true
    }
}

# ============================================================================
# load_wine (simplified, 13 features, 3 classes, 178 samples)
# ============================================================================

export function load_wine() -> Dataset {
    let n: i32 = 178
    let p: i32 = 13
    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    let base: ptr<ptr<f32> > = malloc((3 as i64) * 8) as ptr<ptr<f32> >
    let mut c: i32 = 0
    while c < 3 {
        base[c] = array_new_f32(p)
        c = c + 1
    }
    base[0][0] = 13.7; base[0][1] = 2.1; base[0][2] = 2.5; base[0][3] = 17.0; base[0][4] = 100.0
    base[0][5] = 2.8; base[0][6] = 2.7; base[0][7] = 0.3; base[0][8] = 1.7; base[0][9] = 2.8
    base[0][10] = 1.1; base[0][11] = 1.0; base[0][12] = 900.0

    base[1][0] = 12.3; base[1][1] = 1.5; base[1][2] = 2.1; base[1][3] = 20.0; base[1][4] = 95.0
    base[1][5] = 2.5; base[1][6] = 2.2; base[1][7] = 0.4; base[1][8] = 1.3; base[1][9] = 2.4
    base[1][10] = 1.1; base[1][11] = 0.9; base[1][12] = 700.0

    base[2][0] = 14.0; base[2][1] = 4.0; base[2][2] = 2.5; base[2][3] = 25.0; base[2][4] = 110.0
    base[2][5] = 3.0; base[2][6] = 3.2; base[2][7] = 0.5; base[2][8] = 2.0; base[2][9] = 3.0
    base[2][10] = 1.2; base[2][11] = 1.1; base[2][12] = 1000.0

    let spread: ptr<f32> = array_new_f32(p)
    spread[0] = 0.5; spread[1] = 0.2; spread[2] = 0.2; spread[3] = 2.0; spread[4] = 5.0
    spread[5] = 0.3; spread[6] = 0.3; spread[7] = 0.1; spread[8] = 0.2; spread[9] = 0.3
    spread[10] = 0.2; spread[11] = 0.2; spread[12] = 50.0

    srand(42)
    let mut i: i32 = 0
    while i < n {
        let cls: i32 = i / 60
        if cls > 2 { cls = 2 }
        y[i] = cls as f32
        let mut j: i32 = 0
        while j < p {
            let noise_val: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * spread[j]
            matrix_set(X, i, j, base[cls][j] + noise_val)
            j = j + 1
        }
        i = i + 1
    }

    c = 0
    while c < 3 { array_free_f32(base[c]); c = c + 1 }
    free(base as ptr<void>)
    array_free_f32(spread)

    return Dataset {
        X: X, y: y,
        n_samples: n, n_features: p,
        n_classes: 3, is_classification: true
    }
}

# ============================================================================
# load_breast_cancer (simplified, 30 features, 2 classes, 569 samples)
# ============================================================================

export function load_breast_cancer() -> Dataset {
    let n: i32 = 569
    let p: i32 = 30
    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    let base: ptr<ptr<f32> > = malloc((2 as i64) * 8) as ptr<ptr<f32> >
    let mut c: i32 = 0
    while c < 2 {
        base[c] = array_new_f32(p)
        c = c + 1
    }

    let mut j: i32 = 0
    while j < p {
        base[0][j] = 15.0 + (j as f32) * 0.5
        base[1][j] = 25.0 + (j as f32) * 0.5
        j = j + 1
    }

    srand(42)
    let mut i: i32 = 0
    while i < n {
        let cls: i32 = i % 2
        y[i] = cls as f32
        j = 0
        while j < p {
            let noise_val: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * 3.0
            matrix_set(X, i, j, base[cls][j] + noise_val)
            j = j + 1
        }
        i = i + 1
    }

    c = 0
    while c < 2 { array_free_f32(base[c]); c = c + 1 }
    free(base as ptr<void>)

    return Dataset {
        X: X, y: y,
        n_samples: n, n_features: p,
        n_classes: 2, is_classification: true
    }
}

# ============================================================================
# load_diabetes (simplified, 10 features, regression, 442 samples)
# ============================================================================

export function load_diabetes() -> Dataset {
    let n: i32 = 442
    let p: i32 = 10
    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    let weights: ptr<f32> = array_new_f32(p)
    weights[0] = 0.8; weights[1] = -0.5; weights[2] = 0.3; weights[3] = -0.2
    weights[4] = 0.1; weights[5] = -0.3; weights[6] = 0.4; weights[7] = -0.1
    weights[8] = 0.2; weights[9] = -0.4

    srand(42)
    let mut i: i32 = 0
    while i < n {
        let mut y_val: f32 = 150.0
        let mut j: i32 = 0
        while j < p {
            let val: f32 = (((rand() % 1000) as f32) / 500.0 - 1.0) * 0.1
            matrix_set(X, i, j, val)
            y_val = y_val + weights[j] * val * 100.0
            j = j + 1
        }
        y_val = y_val + (((rand() % 1000) as f32) / 500.0 - 1.0) * 30.0
        y[i] = y_val
        i = i + 1
    }

    array_free_f32(weights)

    return Dataset {
        X: X, y: y,
        n_samples: n, n_features: p,
        n_classes: 0, is_classification: false
    }
}
