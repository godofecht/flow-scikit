# Gaussian Mixture Models for flow-scikit.
# Implements GaussianMixture with EM algorithm (full covariance diagonal).

import "lib/scikit/matrix.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function exp(x: f64) -> f64
    function log(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function fabs(x: f64) -> f64
    function rand() -> i32
    function srand(seed: u32) -> void
    function printf(fmt: string, ...) -> i32
}

export struct GaussianMixture {
    means: ptr<ptr<f32> >,
    variances: ptr<ptr<f32> >,
    weights: ptr<f32>,
    n_components: i32,
    n_features: i32,
    log_likelihood: f32,
    n_iter: i32,
    converged: bool,
    fitted: bool
}

function _log_gaussian(x: ptr<f32>, mean: ptr<f32>, var: ptr<f32>, n_features: i32) -> f32 {
    let mut log_prob: f32 = 0.0
    for j in 0 to n_features {
        let d: f32 = x[j] - mean[j]
        let v: f32 = var[j]
        if v < 0.0000000001 { v = 0.0000000001 }
        log_prob = log_prob - 0.5 * log((2.0 * 3.14159265 * v) as f64) as f32
        log_prob = log_prob - 0.5 * d * d / v
    }
    return log_prob
}

# Per-component normalisation constant for one feature.
# Kept in a helper so log() never appears inside a nested loop body
# (Flow compiler bug #421). Returns f64 so the value carries the same
# precision the inline expression had before it was rounded into the
# f32 accumulator, which keeps the sum bit-identical.
function _gm_log_norm_term(v: f32) -> f64 {
    let lg32: f32 = log((2.0 * 3.14159265 * v) as f64) as f32
    return 0.0 - 0.5 * (lg32 as f64)
}

# Builds the per-component constants that the old code recomputed for
# every sample: the clamped variance, the log normaliser and log(weight).
# Cost is n_components * n_features instead of n_samples * that.
function _gm_prepare_terms(model: GaussianMixture, out_const: ptr<f64>, out_var: ptr<f32>, out_logw: ptr<f32>) -> void {
    for k in 0 to model.n_components {
        out_logw[k] = log((model.weights[k] as f64)) as f32
        let base: i32 = k * model.n_features
        for j in 0 to model.n_features {
            let mut v: f32 = model.variances[k][j]
            if v < 0.0000000001 { v = 0.0000000001 }
            out_var[base + j] = v
            out_const[base + j] = _gm_log_norm_term(v)
        }
    }
}

# Diagonal Gaussian log density using the precomputed tables.
# Same accumulation order and same rounding points as _log_gaussian.
function _gm_log_gaussian_pre(x: ptr<f32>, xoff: i32, mean: ptr<f32>, cterm: ptr<f64>, vclamp: ptr<f32>, base: i32, n_features: i32) -> f32 {
    let mut log_prob: f32 = 0.0
    for j in 0 to n_features {
        let d: f32 = x[xoff + j] - mean[j]
        log_prob = ((log_prob as f64) + cterm[base + j]) as f32
        log_prob = log_prob - 0.5 * d * d / vclamp[base + j]
    }
    return log_prob
}

export function gaussian_mixture_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> GaussianMixture {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    srand(seed)

    let means: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let variances: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let weights: ptr<f32> = array_new_f32(n_components)

    # Allocate parameters first. Initialize means with farthest-point seeding
    # so distinct components do not accidentally start in the same cluster.
    for k in 0 to n_components {
        means[k] = array_new_f32(n_features)
        variances[k] = array_new_f32(n_features)
        for j in 0 to n_features {
            variances[k][j] = 1.0
        }
        weights[k] = 1.0 / (n_components as f32)
    }

    let first_idx: i32 = rand() % n
    for j in 0 to n_features {
        means[0][j] = matrix_at(X, first_idx, j)
    }

    let mut init_k: i32 = 1
    while init_k < n_components {
        let mut best_idx: i32 = 0
        let mut best_dist: f32 = -1.0
        for i in 0 to n {
            let mut min_dist: f32 = 10000000000.0
            let mut prev_k: i32 = 0
            while prev_k < init_k {
                let mut dist: f32 = 0.0
                for j in 0 to n_features {
                    let d: f32 = matrix_at(X, i, j) - means[prev_k][j]
                    dist = dist + d * d
                }
                if dist < min_dist { min_dist = dist }
                prev_k = prev_k + 1
            }
            if min_dist > best_dist {
                best_dist = min_dist
                best_idx = i
            }
        }
        for j in 0 to n_features {
            means[init_k][j] = matrix_at(X, best_idx, j)
        }
        init_k = init_k + 1
    }

    let init_counts: ptr<i32> = malloc((n_components as i64) * 4) as ptr<i32>
    for k in 0 to n_components {
        init_counts[k] = 0
        for j in 0 to n_features { variances[k][j] = 0.0 }
    }
    for i in 0 to n {
        let mut nearest: i32 = 0
        let mut nearest_dist: f32 = 10000000000.0
        for k in 0 to n_components {
            let mut dist: f32 = 0.0
            for j in 0 to n_features {
                let d: f32 = matrix_at(X, i, j) - means[k][j]
                dist = dist + d * d
            }
            if dist < nearest_dist {
                nearest_dist = dist
                nearest = k
            }
        }
        init_counts[nearest] = init_counts[nearest] + 1
        for j in 0 to n_features {
            let d: f32 = matrix_at(X, i, j) - means[nearest][j]
            variances[nearest][j] = variances[nearest][j] + d * d
        }
    }
    for k in 0 to n_components {
        if init_counts[k] > 0 {
            weights[k] = (init_counts[k] as f32) / (n as f32)
            for j in 0 to n_features {
                variances[k][j] = variances[k][j] / (init_counts[k] as f32)
                if variances[k][j] < 0.001 { variances[k][j] = 0.001 }
            }
        } else {
            weights[k] = 1.0 / (n_components as f32)
            for j in 0 to n_features { variances[k][j] = 1.0 }
        }
    }
    free(init_counts as ptr<void>)

    let resp: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        resp[i] = array_new_f32(n_components)
    }

    let mut prev_ll: f32 = -10000000000.0
    let mut n_iter: i32 = 0
    let mut converged: bool = false

    for iter in 0 to max_iter {
        n_iter = iter + 1

        # E-step
        let mut total_ll: f32 = 0.0
        for i in 0 to n {
            let x_row: ptr<f32> = array_new_f32(n_features)
            for j in 0 to n_features {
                x_row[j] = matrix_at(X, i, j)
            }

            let mut max_log: f32 = -10000000000.0
            for k in 0 to n_components {
                let lg: f32 = log((weights[k] as f64)) as f32 + _log_gaussian(x_row, means[k], variances[k], n_features)
                resp[i][k] = lg
                if lg > max_log { max_log = lg }
            }

            let mut sum_exp: f32 = 0.0
            for k in 0 to n_components {
                resp[i][k] = exp((resp[i][k] - max_log) as f64) as f32
                sum_exp = sum_exp + resp[i][k]
            }
            for k in 0 to n_components {
                resp[i][k] = resp[i][k] / sum_exp
            }

            total_ll = total_ll + max_log + log((sum_exp as f64)) as f32
            array_free_f32(x_row)
        }

        total_ll = total_ll / (n as f32)

        if (fabs((prev_ll - total_ll) as f64) as f32) < tol {
            converged = true
            prev_ll = total_ll
            break
        }
        prev_ll = total_ll

        # M-step
        for k in 0 to n_components {
            let mut nk: f32 = 0.0
            for i in 0 to n {
                nk = nk + resp[i][k]
            }

            weights[k] = nk / (n as f32)

            for j in 0 to n_features {
                let mut mean_j: f32 = 0.0
                for i in 0 to n {
                    mean_j = mean_j + resp[i][k] * matrix_at(X, i, j)
                }
                if nk > 0.0000000001 {
                    means[k][j] = mean_j / nk
                }

                let mut var_j: f32 = 0.0
                for i in 0 to n {
                    let d: f32 = matrix_at(X, i, j) - means[k][j]
                    var_j = var_j + resp[i][k] * d * d
                }
                if nk > 0.0000000001 {
                    variances[k][j] = var_j / nk
                }
                if variances[k][j] < 0.000001 {
                    variances[k][j] = 0.000001
                }
            }
        }
    }

    for i in 0 to n {
        array_free_f32(resp[i])
    }
    free(resp as ptr<void>)

    return GaussianMixture {
        means: means, variances: variances, weights: weights,
        n_components: n_components, n_features: n_features,
        log_likelihood: prev_ll, n_iter: n_iter,
        converged: converged, fitted: true
    }
}

export function gaussian_mixture_predict(model: GaussianMixture, X: Matrix) -> ptr<i32> {
    let n: i32 = X.rows
    let kc: i32 = model.n_components
    let nf: i32 = model.n_features
    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>

    let cterm: ptr<f64> = array_new_f64(kc * nf)
    let vclamp: ptr<f32> = array_new_f32(kc * nf)
    let logw: ptr<f32> = array_new_f32(kc)
    _gm_prepare_terms(model, cterm, vclamp, logw)

    let xd: ptr<f32> = X.data
    let xc: i32 = X.cols

    for i in 0 to n {
        let xbase: i32 = i * xc

        let mut best_k: i32 = 0
        let mut best_log: f32 = -10000000000.0
        for k in 0 to kc {
            let lg: f32 = logw[k] + _gm_log_gaussian_pre(xd, xbase, model.means[k], cterm, vclamp, k * nf, nf)
            if lg > best_log {
                best_log = lg
                best_k = k
            }
        }
        labels[i] = best_k
    }

    array_free_f64(cterm)
    array_free_f32(vclamp)
    array_free_f32(logw)
    return labels
}

export function gaussian_mixture_predict_proba(model: GaussianMixture, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let kc: i32 = model.n_components
    let nf: i32 = model.n_features
    let result: Matrix = matrix_new(n, kc)

    let cterm: ptr<f64> = array_new_f64(kc * nf)
    let vclamp: ptr<f32> = array_new_f32(kc * nf)
    let logw: ptr<f32> = array_new_f32(kc)
    _gm_prepare_terms(model, cterm, vclamp, logw)

    let xd: ptr<f32> = X.data
    let rd: ptr<f32> = result.data
    let xc: i32 = X.cols

    for i in 0 to n {
        let xbase: i32 = i * xc
        let rbase: i32 = i * kc

        let mut max_log: f32 = -10000000000.0
        for k in 0 to kc {
            let lg: f32 = logw[k] + _gm_log_gaussian_pre(xd, xbase, model.means[k], cterm, vclamp, k * nf, nf)
            rd[rbase + k] = lg
            if lg > max_log { max_log = lg }
        }

        let mut sum_exp: f32 = 0.0
        for k in 0 to kc {
            let val: f32 = exp((rd[rbase + k] - max_log) as f64) as f32
            rd[rbase + k] = val
            sum_exp = sum_exp + val
        }
        for k in 0 to kc {
            rd[rbase + k] = rd[rbase + k] / sum_exp
        }
    }

    array_free_f64(cterm)
    array_free_f32(vclamp)
    array_free_f32(logw)
    return result
}

export function gaussian_mixture_score(model: GaussianMixture, X: Matrix) -> f32 {
    let n: i32 = X.rows
    let mut total_ll: f32 = 0.0

    let x_row: ptr<f32> = array_new_f32(model.n_features)

    for i in 0 to n {
        for j in 0 to model.n_features {
            x_row[j] = matrix_at(X, i, j)
        }

        let mut max_log: f32 = -10000000000.0
        for k in 0 to model.n_components {
            let lg: f32 = log((model.weights[k] as f64)) as f32 + _log_gaussian(x_row, model.means[k], model.variances[k], model.n_features)
            if lg > max_log { max_log = lg }
        }

        let mut sum_exp: f32 = 0.0
        for k in 0 to model.n_components {
            let lg: f32 = log((model.weights[k] as f64)) as f32 + _log_gaussian(x_row, model.means[k], model.variances[k], model.n_features)
            sum_exp = sum_exp + exp((lg - max_log) as f64) as f32
        }

        total_ll = total_ll + max_log + log((sum_exp as f64)) as f32
    }

    array_free_f32(x_row)
    return total_ll / (n as f32)
}

export function gaussian_mixture_free(model: GaussianMixture) -> void {
    for k in 0 to model.n_components {
        array_free_f32(model.means[k])
        array_free_f32(model.variances[k])
    }
    free(model.means as ptr<void>)
    free(model.variances as ptr<void>)
    array_free_f32(model.weights)
}

# ============================================================================
# BayesianGaussianMixture
# ============================================================================

export struct BayesianGaussianMixture {
    means: ptr<ptr<f32> >,
    variances: ptr<ptr<f32> >,
    weights: ptr<f32>,
    alpha: ptr<f32>,
    n_components: i32,
    n_features: i32,
    n_iter: i32,
    fitted: bool
}

export function bayesian_gaussian_mixture_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> BayesianGaussianMixture {
    let n: i32 = X.rows
    let p: i32 = X.cols
    srand(seed)

    let means: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let variances: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let weights: ptr<f32> = array_new_f32(n_components)
    let alpha: ptr<f32> = array_new_f32(n_components)

    for k in 0 to n_components {
        means[k] = array_new_f32(p)
        variances[k] = array_new_f32(p)
        let idx: i32 = rand() % n
        for j in 0 to p {
            means[k][j] = matrix_at(X, idx, j)
            variances[k][j] = 1.0
        }
        weights[k] = 1.0 / (n_components as f32)
        alpha[k] = 1.0
    }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1

        let resp: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
        for i in 0 to n {
            resp[i] = array_new_f32(n_components)
            let mut total: f32 = 0.0
            for k in 0 to n_components {
                let mut log_lik: f32 = log((weights[k]) as f64) as f32
                for j in 0 to p {
                    let d: f32 = matrix_at(X, i, j) - means[k][j]
                    let v: f32 = variances[k][j]
                    if v < 0.0000000001 { v = 0.0000000001 }
                    log_lik = log_lik - 0.5 * d * d / v - 0.5 * log((v) as f64) as f32
                }
                resp[i][k] = exp((log_lik) as f64) as f32
                total = total + resp[i][k]
            }
            if total < 0.0000000001 { total = 0.0000000001 }
            for k in 0 to n_components {
                resp[i][k] = resp[i][k] / total
            }
        }

        let mut max_change: f32 = 0.0
        for k in 0 to n_components {
            let mut nk: f32 = 0.0
            for i in 0 to n { nk = nk + resp[i][k] }

            let alpha_k: f32 = 1.0 + nk
            let weight_k: f32 = nk / (n as f32 + n_components as f32)

            for j in 0 to p {
                let mut mean_kj: f32 = 0.0
                for i in 0 to n {
                    mean_kj = mean_kj + resp[i][k] * matrix_at(X, i, j)
                }
                if nk > 0.0000000001 { mean_kj = mean_kj / nk }

                let mut var_kj: f32 = 0.0
                for i in 0 to n {
                    let d: f32 = matrix_at(X, i, j) - mean_kj
                    var_kj = var_kj + resp[i][k] * d * d
                }
                if nk > 0.0000000001 { var_kj = var_kj / nk + 0.001 }

                let change_m: f32 = fabs((mean_kj - means[k][j]) as f64) as f32
                let change_v: f32 = fabs((var_kj - variances[k][j]) as f64) as f32
                if change_m > max_change { max_change = change_m }
                if change_v > max_change { max_change = change_v }

                means[k][j] = mean_kj
                variances[k][j] = var_kj
            }

            alpha[k] = alpha_k
            weights[k] = weight_k
        }

        for i in 0 to n { array_free_f32(resp[i]) }
        free(resp as ptr<void>)

        if max_change < tol { break }
    }

    return BayesianGaussianMixture {
        means: means,
        variances: variances,
        weights: weights,
        alpha: alpha,
        n_components: n_components,
        n_features: p,
        n_iter: n_iter,
        fitted: true
    }
}

export function bayesian_gaussian_mixture_predict(model: BayesianGaussianMixture, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_k: i32 = 0
        let mut best_lik: f32 = -9999999999.0
        for k in 0 to model.n_components {
            let mut lik: f32 = log((model.weights[k]) as f64) as f32
            for j in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, j) - model.means[k][j]
                let v: f32 = model.variances[k][j]
                if v < 0.0000000001 { v = 0.0000000001 }
                lik = lik - 0.5 * d * d / v
            }
            if lik > best_lik {
                best_lik = lik
                best_k = k
            }
        }
        result[i] = best_k as f32
    }
    return result
}

export function bayesian_gaussian_mixture_free(model: BayesianGaussianMixture) -> void {
    for k in 0 to model.n_components {
        array_free_f32(model.means[k])
        array_free_f32(model.variances[k])
    }
    free(model.means as ptr<void>)
    free(model.variances as ptr<void>)
    array_free_f32(model.weights)
    array_free_f32(model.alpha)
}
