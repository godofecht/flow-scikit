# Linear models for flow-scikit.
# Addresses Issue #28394:
#   - Classifiers: predict returns probabilities, decide returns classes
#   - Linear model API with terms, interactions, and penalties
# Addresses Issue #30909: pos_label handled internally via classes_ array.

import "lib/scikit/matrix.flow"
import "lib/scikit/validation.flow"
import "lib/scikit/progress.flow"
import "lib/scikit/sparse.flow"
import "lib/scikit/blas.flow"

extern {
    function sqrt(x: f64) -> f64
    function log(x: f64) -> f64
}

function sqrt_f32(x: f32) -> f32 {
    return sqrt((x as f64)) as f32
}

function log_f32(x: f32) -> f32 {
    return log((x as f64)) as f32
}

# ============================================================================
# Term specification for linear models (Issue #28394)
# ============================================================================

export const TERM_LINEAR: i32 = 0
export const TERM_POLYNOMIAL: i32 = 1
export const TERM_INTERACTION: i32 = 2
export const TERM_SPLINE: i32 = 3

export struct TermSpec {
    feature_indices: ptr<i32>,
    n_indices: i32,
    degree: i32,
    term_type: i32
}

export const PENALTY_NONE: i32 = 0
export const PENALTY_L1: i32 = 1
export const PENALTY_L2: i32 = 2
export const PENALTY_ELASTICNET: i32 = 3

function _solve_in_place(A: ptr<f32>, b: ptr<f32>, n: i32) -> void {
    for col in 0 to n {
        let pv: f32 = A[col * n + col]
        let abs_pv: f32 = pv
        if pv < 0.0 { abs_pv = -pv }
        if abs_pv < 0.0000000001 { continue }
        let mut row: i32 = col + 1
        while row < n {
            let factor: f32 = A[row * n + col] / pv
            A[row * n + col] = 0.0
            let mut j: i32 = col + 1
            while j < n {
                A[row * n + j] = A[row * n + j] - factor * A[col * n + j]
                j = j + 1
            }
            b[row] = b[row] - factor * b[col]
            row = row + 1
        }
    }
    let mut i: i32 = n - 1
    while i >= 0 {
        let mut s: f32 = b[i]
        let mut j: i32 = i + 1
        while j < n {
            s = s - A[i * n + j] * b[j]
            j = j + 1
        }
        let pv2: f32 = A[i * n + i]
        let abs_pv2: f32 = pv2
        if pv2 < 0.0 { abs_pv2 = -pv2 }
        if abs_pv2 < 0.0000000001 {
            b[i] = 0.0
        } else {
            b[i] = s / pv2
        }
        i = i - 1
    }
}

# f64 Gaussian elimination with partial pivoting for higher precision.
# Used by linear_regression and ridge where f32 is insufficient.
export function _solve_f64(A: ptr<f64>, b: ptr<f64>, n: i32) -> void {
    for col in 0 to n {
        let mut pivot_row: i32 = col
        let mut max_val: f64 = fabs(A[col * n + col])
        let mut row: i32 = col + 1
        while row < n {
            let val: f64 = fabs(A[row * n + col])
            if val > max_val {
                max_val = val
                pivot_row = row
            }
            row = row + 1
        }
        if max_val < 0.000000000000001 { continue }

        if pivot_row != col {
            let mut j: i32 = 0
            while j < n {
                let tmp: f64 = A[col * n + j]
                A[col * n + j] = A[pivot_row * n + j]
                A[pivot_row * n + j] = tmp
                j = j + 1
            }
            let tmp_b: f64 = b[col]
            b[col] = b[pivot_row]
            b[pivot_row] = tmp_b
        }

        let pv: f64 = A[col * n + col]
        let mut r: i32 = col + 1
        while r < n {
            let factor: f64 = A[r * n + col] / pv
            A[r * n + col] = 0.0
            let mut j: i32 = col + 1
            while j < n {
                A[r * n + j] = A[r * n + j] - factor * A[col * n + j]
                j = j + 1
            }
            b[r] = b[r] - factor * b[col]
            r = r + 1
        }
    }
    let mut i: i32 = n - 1
    while i >= 0 {
        let mut s: f64 = b[i]
        let mut j: i32 = i + 1
        while j < n {
            s = s - A[i * n + j] * b[j]
            j = j + 1
        }
        let pv2: f64 = A[i * n + i]
        let abs_pv2: f64 = fabs(pv2)
        if abs_pv2 < 0.000000000000001 {
            b[i] = 0.0
        } else {
            b[i] = s / pv2
        }
        i = i - 1
    }
}

# QR-based least squares solver via Householder reflections.
# Solves min ||X*w - y||^2 where X is m x n (m >= n).
# Modifies X and y in place. Result is stored in y[0..n-1].
# This avoids forming XtX (which squares the condition number).
#
# The Householder sequence is unchanged: reflectors are still built for columns
# 0..n-1 in that order, with no pivoting, from the same alpha/beta formulas.
# Only the loops that apply a reflector move to BLAS. Applying H to the
# trailing block is v^T A followed by a rank-1 update, which are exactly
# dgemv(trans) and dger over a sub-block addressed by an explicit leading
# dimension, with the reflector read as a strided column. The old code walked
# the whole trailing block once per column in scalar f64.
#
# Rank deficiency (Issue #448). Back substitution needs a rule for when a
# diagonal entry of R counts as zero. An absolute cutoff cannot express that:
# whether a pivot is negligible depends on the scale of the design. On
# X = [x, 2x] with x = 1..5 the second pivot lands just above an absolute
# 1e-15, so the old code divided by it and returned coefficients near 9.86e14
# and -4.93e14. Storing that pair in f32 cancelled the signal and every
# prediction collapsed to the mean of y, silently, with fitted = true.
#
# The cutoff is therefore relative: 1e-11 * max|R_ii|, floored at 1e-15 so a
# design whose pivots are all tiny in absolute terms is not declared deficient
# on rounding noise. This is the same rule and the same two constants
# ols_inference_fit uses (see lin353_invert_upper), deliberately, so that one
# file does not carry two definitions of rank.
#
# A coordinate whose pivot falls below the cutoff is set to zero and the
# remaining coordinates are solved against the leading triangular block, which
# is the reduced problem: the zeroed columns contribute nothing to the sums
# above them. On the collinear design that returns 0.6 on the first column,
# 0.0 on the second and the correct intercept, so predictions follow the true
# line. numpy lstsq and sklearn both keep the fit rather than refusing here.
# They reach the minimum-norm solution through an SVD, which spreads the weight
# over the collinear pair instead of parking it on one column; the predictions
# agree, the individual coefficients do not.
#
# On a full-rank design the relative cutoff is never reached, so the arithmetic
# is untouched: same reflectors, same order, same divisions.
export function _solve_lstsq_qr(X: ptr<f64>, y: ptr<f64>, m: i32, n: i32) -> void {
    let dots: ptr<f64> = array_new_f64(n)

    # Apply n Householder transformations to reduce X to upper triangular
    for k in 0 to n {
        let rows: i32 = m - k
        if rows <= 0 { continue }
        let vcol: ptr<f64> = X + k * n + k

        # Compute Householder vector for column k, rows k..m
        let mut norm: f64 = blas_dot_strided_f64(rows, vcol, n, vcol, n)
        norm = sqrt(norm)
        if norm < 0.000000000000001 { continue }

        # alpha = -sign(x_k) * norm
        let alpha: f64 = 0.0 - norm
        if X[k * n + k] < 0.0 { alpha = norm }

        # v = x - alpha*e1, store in column k below diagonal
        X[k * n + k] = X[k * n + k] - alpha

        # beta = 2 / (v^T v)
        let vtv: f64 = blas_dot_strided_f64(rows, vcol, n, vcol, n)
        if vtv < 0.000000000000001 { continue }
        let beta: f64 = 2.0 / vtv

        # Apply H to remaining columns of X (columns k+1..n-1)
        let cols: i32 = n - k - 1
        if cols > 0 {
            let block: ptr<f64> = X + k * n + k + 1
            blas_matvec_trans_ld_f64(block, rows, cols, n, vcol, n, dots, 1.0, 0.0)
            blas_ger_ld_f64(block, rows, cols, n, vcol, n, dots, 0.0 - beta)
        }

        # Apply H to y
        let dot_y: f64 = blas_dot_strided_f64(rows, vcol, n, y + k, 1)
        blas_axpy_strided_f64(rows, 0.0 - beta * dot_y, vcol, n, y + k, 1)

        # Set the diagonal element of R
        X[k * n + k] = alpha
    }

    array_free_f64(dots)

    # Rank cutoff, relative to the largest pivot and floored at the old
    # absolute value so it can never be looser than the code it replaces.
    let mut maxdiag: f64 = 0.0
    for d in 0 to n {
        let dd: f64 = fabs(X[d * n + d])
        if dd > maxdiag { maxdiag = dd }
    }
    let mut tol: f64 = 0.00000000001 * maxdiag
    if tol < 0.000000000000001 { tol = 0.000000000000001 }

    # Back-substitution: R * w = y(0..n-1). A coordinate whose pivot is below
    # tol is set to zero, which drops its column out of every sum above it and
    # leaves the reduced problem to the surviving pivots.
    let mut i: i32 = n - 1
    while i >= 0 {
        let mut s: f64 = y[i]
        let mut j: i32 = i + 1
        while j < n {
            s = s - X[i * n + j] * y[j]
            j = j + 1
        }
        let pv: f64 = X[i * n + i]
        let abs_pv: f64 = fabs(pv)
        if abs_pv < tol {
            y[i] = 0.0
        } else {
            y[i] = s / pv
        }
        i = i - 1
    }
}

export struct Penalty {
    kind: i32,
    alpha: f32,
    l1_ratio: f32
}

export function penalty_none() -> Penalty {
    return Penalty { kind: PENALTY_NONE, alpha: 0.0, l1_ratio: 0.0 }
}

export function penalty_l2(alpha: f32) -> Penalty {
    return Penalty { kind: PENALTY_L2, alpha: alpha, l1_ratio: 0.0 }
}

export function penalty_l1(alpha: f32) -> Penalty {
    return Penalty { kind: PENALTY_L1, alpha: alpha, l1_ratio: 1.0 }
}

# Issue #408: the L2 strength that reproduces scikit-learn's C on this library's
# objective.
#
# scikit-learn's LogisticRegression minimises the SUM of the per-sample losses
# plus 0.5 * ||w||^2 / C. The fitters here minimise the MEAN loss plus
# 0.5 * alpha * ||w||^2. Dividing scikit-learn's objective by n_samples puts the
# two in the same units and leaves
#
#     alpha = 1 / (C * n_samples)
#
# so alpha and C are not interchangeable and the sample count is part of the
# conversion. Passing scikit-learn's C straight through as alpha regularizes by
# a factor of n_samples too little.
#
# Returns a zero-strength L2 penalty for a non-positive C or sample count.
export function penalty_l2_from_c(c: f32, n_samples: i32) -> Penalty {
    let mut alpha: f32 = 0.0
    if c > 0.0 && n_samples > 0 {
        alpha = 1.0 / (c * (n_samples as f32))
    }
    return Penalty { kind: PENALTY_L2, alpha: alpha, l1_ratio: 0.0 }
}

export function penalty_elasticnet(alpha: f32, l1_ratio: f32) -> Penalty {
    return Penalty { kind: PENALTY_ELASTICNET, alpha: alpha, l1_ratio: l1_ratio }
}

# ============================================================================
# Feature expansion from TermSpec array
# ============================================================================

export function expand_features(X: Matrix, terms: ptr<TermSpec>, n_terms: i32) -> Matrix {
    let mut total_cols: i32 = 0
    for t in 0 to n_terms {
        let term: TermSpec = terms[t]
        if term.term_type == TERM_LINEAR {
            total_cols = total_cols + term.n_indices
        } elif term.term_type == TERM_POLYNOMIAL {
            total_cols = total_cols + term.n_indices * term.degree
        } elif term.term_type == TERM_INTERACTION {
            total_cols = total_cols + 1
        }
    }

    let result: Matrix = matrix_new(X.rows, total_cols)
    let mut col: i32 = 0

    for t in 0 to n_terms {
        let term: TermSpec = terms[t]

        if term.term_type == TERM_LINEAR {
            for idx in 0 to term.n_indices {
                let f_idx: i32 = term.feature_indices[idx]
                for i in 0 to X.rows {
                    matrix_set(result, i, col, matrix_at(X, i, f_idx))
                }
                col = col + 1
            }
        } elif term.term_type == TERM_POLYNOMIAL {
            for idx in 0 to term.n_indices {
                let f_idx: i32 = term.feature_indices[idx]
                for d in 1 to term.degree + 1 {
                    for i in 0 to X.rows {
                        let val: f32 = matrix_at(X, i, f_idx)
                        let mut powered: f32 = 1.0
                        for _ in 0 to d {
                            powered = powered * val
                        }
                        matrix_set(result, i, col, powered)
                    }
                    col = col + 1
                }
            }
        } elif term.term_type == TERM_INTERACTION {
            for i in 0 to X.rows {
                let mut product: f32 = 1.0
                for idx in 0 to term.n_indices {
                    let f_idx: i32 = term.feature_indices[idx]
                    product = product * matrix_at(X, i, f_idx)
                }
                matrix_set(result, i, col, product)
            }
            col = col + 1
        }
    }

    return result
}

# ============================================================================
# LinearRegression
# ============================================================================

export struct LinearRegression {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    penalty: Penalty,
    fitted: bool
}

export function linear_regression_fit(X: Matrix, y: ptr<f32>, penalty: Penalty) -> LinearRegression {
    let n: i32 = X.cols
    let m: i32 = X.rows

    # Center data in f64 for precision. X is contiguous row-major, so both
    # sweeps index X.data directly; matrix_at copies the Matrix struct by value
    # on every element.
    let xdata: ptr<f32> = X.data
    let x_mean: ptr<f64> = array_new_f64(n)
    let mut y_mean: f64 = 0.0
    for i in 0 to m {
        y_mean = y_mean + (y[i] as f64)
        let base: i32 = i * n
        for j in 0 to n {
            x_mean[j] = x_mean[j] + (xdata[base + j] as f64)
        }
    }
    y_mean = y_mean / (m as f64)
    for j in 0 to n {
        x_mean[j] = x_mean[j] / (m as f64)
    }

    # Build centered X in f64 and centered y in f64.
    # Use QR decomposition on the centered X to solve least squares.
    # This avoids forming XtX which squares the condition number.
    let Xc: ptr<f64> = malloc((m as i64) * (n as i64) * 8) as ptr<f64>
    let yc: ptr<f64> = array_new_f64(m)
    for i in 0 to m {
        yc[i] = (y[i] as f64) - y_mean
        let base: i32 = i * n
        for j in 0 to n {
            Xc[base + j] = (xdata[base + j] as f64) - x_mean[j]
        }
    }

    # Add L2 regularization if applicable (append rows for ridge effect)
    if penalty.kind == PENALTY_L2 || penalty.kind == PENALTY_ELASTICNET {
        let l2: f64 = (penalty.alpha as f64) * (1.0 - (penalty.l1_ratio as f64)) * (m as f64)
        # Regularization is handled by adding sqrt(l2) * I rows to X and 0 to y
        # But for simplicity, use normal equations for regularized case
        let XtX: ptr<f64> = array_new_f64(n * n)
        let Xty: ptr<f64> = array_new_f64(n)
        # Same accumulation order as before; the row base, the row of XtX and
        # the response value are hoisted out of the inner loop instead of being
        # recomputed for every one of the m * n * n updates.
        for i in 0 to m {
            let base: i32 = i * n
            let yi: f64 = yc[i]
            for j in 0 to n {
                let xj: f64 = Xc[base + j]
                Xty[j] = Xty[j] + xj * yi
                let rowj: i32 = j * n
                for k in 0 to n {
                    XtX[rowj + k] = XtX[rowj + k] + xj * Xc[base + k]
                }
            }
        }
        for j in 0 to n {
            XtX[j * n + j] = XtX[j * n + j] + l2
        }
        _solve_f64(XtX, Xty, n)
        let mut bias: f32 = y_mean as f32
        for j in 0 to n {
            bias = bias - (x_mean[j] * Xty[j]) as f32
        }
        let weights: ptr<f32> = array_new_f32(n)
        for j in 0 to n {
            weights[j] = Xty[j] as f32
        }
        free(Xc as ptr<void>)
        array_free_f64(yc)
        array_free_f64(x_mean)
        array_free_f64(XtX)
        array_free_f64(Xty)
        return LinearRegression { weights: weights, bias: bias, n_features: n, penalty: penalty, fitted: true }
    }

    # No regularization: use QR decomposition for accuracy
    _solve_lstsq_qr(Xc, yc, m, n)

    # Recover bias in f64: b = y_mean - sum(x_mean[j] * w[j])
    let mut bias_d: f64 = y_mean
    for j in 0 to n {
        bias_d = bias_d - x_mean[j] * yc[j]
    }

    let weights: ptr<f32> = array_new_f32(n)
    for j in 0 to n {
        weights[j] = yc[j] as f32
    }

    free(Xc as ptr<void>)
    array_free_f64(yc)
    array_free_f64(x_mean)

    return LinearRegression { weights: weights, bias: bias_d as f32, n_features: n, penalty: penalty, fitted: true }
}

# Predictions are y = X * w + b. X is contiguous row-major, so the whole batch
# is one cblas_sgemv with the matrix row stride passed as lda; the previous loop
# called matrix_at once per element, which copies the Matrix struct by value on
# every access. The scalar f64 path is kept for the case where the model's
# feature count does not fit inside a row of X.
export function linear_regression_predict(model: LinearRegression, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return preds }

    let nf: i32 = model.n_features
    let bias: f32 = model.bias
    let w: ptr<f32> = model.weights

    if nf <= 0 || nf > X.cols {
        let data: ptr<f32> = X.data
        let stride: i32 = X.cols
        for i in 0 to rows {
            let base: i32 = i * stride
            let mut pred: f64 = bias as f64
            for j in 0 to nf {
                pred = pred + (w[j] as f64) * (data[base + j] as f64)
            }
            preds[i] = pred as f32
        }
        return preds
    }

    blas_matvec_ld(X.data, rows, nf, X.cols, w, preds, 1.0, 0.0)
    for i in 0 to rows {
        preds[i] = preds[i] + bias
    }
    return preds
}

export function linear_regression_free(model: LinearRegression) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# OLS coefficient inference (Issue #353)
#
# Scope, deliberately narrow. Issue #353 records a real disagreement in its
# sources about whether a machine learning library should report inference at
# all. What is not in dispute is that for an unpenalized least squares fit the
# coefficient covariance is a by-product of the solve that has already run, so
# withholding it buys nothing. This exposes exactly four quantities:
#
#   residual standard error   s = sqrt(SSE / df)
#   coefficient covariance    s^2 * (Xc^T Xc)^-1, extended to the intercept
#   standard errors           the square roots of its diagonal
#   t statistics              coefficient / standard error
#
# There is no p-value and no printed summary. A p-value needs an accurate
# incomplete beta function, and a summary table is the statsmodels-shaped thing
# the issue's dissenting sources argue against.
#
# Where the covariance comes from. linear_regression_fit centres X and y and
# calls _solve_lstsq_qr, whose Householder sweep leaves R (the triangular
# factor of the centred design) in the upper triangle of its X buffer. R is
# discarded there because the fit does not need it. This function repeats the
# same centring and the same QR, keeps R, inverts it by back substitution and
# forms (Xc^T Xc)^-1 = R^-1 R^-T. Nothing squares the condition number.
#
# The intercept. The fit solves the centred problem, so R covers the slopes
# only. The intercept b0 = ybar - xbar^T w has the standard textbook variance
# s^2 * (1/m + xbar^T (Xc^T Xc)^-1 xbar) and covariance -s^2 * (Xc^T Xc)^-1 xbar
# with the slopes. Both are filled in, so cov is (n+1) x (n+1).
#
# Index convention throughout: 0..n-1 are the slopes in feature order and index
# n is the intercept.
#
# Penalized fits are refused. This answers one of the two questions PR #443
# left open on the issue. Under a ridge penalty the estimator is biased and
# s^2 * (X^T X)^-1 is no longer its covariance, so reporting it would be
# dishonest rather than merely imprecise. ols_inference_fit returns
# fitted = false with every buffer zeroed when model.penalty.kind is not
# PENALTY_NONE, and likewise when there are not enough residual degrees of
# freedom to estimate s^2.
#
# Rank deficiency, stated rather than left to chance. A perfectly collinear
# design gives R a zero diagonal entry and (Xc^T Xc)^-1 does not exist.
# ols_inference_fit detects this from R's diagonal, returns fitted = false with
# every buffer zeroed, sets rank_deficient = true and reports the numerical
# rank it found in the rank field. No standard error is invented.
#
# PR #443 met a singular system in its Newton solve and handled it differently:
# it lets _solve_f64 zero the dependent coordinate and solves the reduced
# problem, which is a genuine Newton step and leaves the fitted linear
# predictor unchanged. That reasoning does not carry over here, because there
# the zeroed coordinate only has to produce a good step, whereas here the
# coefficients themselves are the object being reported on. Concretely, on
# X = [x, 2x] with x = 1..5, linear_regression_fit returns weights of about
# 9.86e14 and -4.93e14: R's second pivot lands just above the solver's absolute
# 1e-15 cutoff, so it divides by it, and the f32 store of the two enormous
# opposing coefficients cancels the fit down to a flat line at the intercept.
# There is no reduced-problem solution held in the model to do inference about.
# Refusing is the only honest answer, and rank_deficient is how it is said.
#
# The second question PR #443 left open, ownership of the matrix after the fit,
# is answered by not attaching it to the fit at all. LinearRegression is
# untouched. The buffers live on OLSInference and are released by
# ols_inference_free.
# ============================================================================

export struct OLSInference {
    cov: ptr<f32>,
    std_errors: ptr<f32>,
    t_stats: ptr<f32>,
    residual_std_error: f32,
    n_features: i32,
    n_params: i32,
    df_residual: i32,
    rank: i32,
    rank_deficient: bool,
    fitted: bool
}

# Inverts the upper triangular R (n x n, row stride n) into Z by back
# substitution, one column at a time. Diagonal entries below tol are treated as
# structurally zero: that row and column of Z stay zero. Returns the number of
# usable pivots, i.e. the numerical rank.
function lin353_invert_upper(R: ptr<f64>, Z: ptr<f64>, n: i32, tol: f64) -> i32 {
    let bad: ptr<f64> = array_new_f64(n + 8)
    let mut rank: i32 = 0
    for j in 0 to n {
        let dj: f64 = fabs(R[j * n + j])
        if dj < tol {
            bad[j] = 1.0
        } else {
            bad[j] = 0.0
            rank = rank + 1
        }
    }

    for c in 0 to n {
        if bad[c] == 0.0 {
            let mut i: i32 = c
            while i >= 0 {
                if bad[i] != 0.0 {
                    Z[i * n + c] = 0.0
                } else {
                    let mut s: f64 = 0.0
                    if i == c { s = 1.0 }
                    let mut j: i32 = i + 1
                    while j <= c {
                        s = s - R[i * n + j] * Z[j * n + c]
                        j = j + 1
                    }
                    Z[i * n + c] = s / R[i * n + i]
                }
                i = i - 1
            }
        }
    }

    array_free_f64(bad)
    return rank
}

# Sum of squared residuals of the fitted model on (X, y), accumulated in f64.
function lin353_sse(model: LinearRegression, X: Matrix, y: ptr<f32>) -> f64 {
    let m: i32 = X.rows
    let n: i32 = model.n_features
    let data: ptr<f32> = X.data
    let stride: i32 = X.cols
    let w: ptr<f32> = model.weights
    let mut sse: f64 = 0.0
    for i in 0 to m {
        let base: i32 = i * stride
        let mut pred: f64 = model.bias as f64
        for j in 0 to n {
            pred = pred + (w[j] as f64) * (data[base + j] as f64)
        }
        let r: f64 = (y[i] as f64) - pred
        sse = sse + r * r
    }
    return sse
}

function lin353_empty(n: i32, d: i32, rank: i32, deficient: bool) -> OLSInference {
    let cov: ptr<f32> = array_new_f32(d * d + 16)
    let se: ptr<f32> = array_new_f32(d + 8)
    let ts: ptr<f32> = array_new_f32(d + 8)
    return OLSInference {
        cov: cov,
        std_errors: se,
        t_stats: ts,
        residual_std_error: 0.0,
        n_features: n,
        n_params: d,
        df_residual: 0,
        rank: rank,
        rank_deficient: deficient,
        fitted: false
    }
}

# Coefficient inference for an unpenalized least squares fit.
#
# model must be the result of linear_regression_fit(X, y, penalty_none()) on
# the same X and y that are passed here. Returns fitted = false with zeroed
# buffers if the fit was penalized, if X is empty, or if there is no residual
# degree of freedom left.
export function ols_inference_fit(model: LinearRegression, X: Matrix, y: ptr<f32>) -> OLSInference {
    let n: i32 = X.cols
    let m: i32 = X.rows
    let d: i32 = n + 1

    if n <= 0 || m <= 0 {
        let bad0: OLSInference = lin353_empty(n, d, 0, false)
        return bad0
    }
    if model.penalty.kind != PENALTY_NONE {
        let bad1: OLSInference = lin353_empty(n, d, 0, false)
        return bad1
    }

    # Same centring the fit performs, in f64.
    let xdata: ptr<f32> = X.data
    let x_mean: ptr<f64> = array_new_f64(n + 8)
    let mut y_mean: f64 = 0.0
    for i in 0 to m {
        y_mean = y_mean + (y[i] as f64)
        let base: i32 = i * n
        for j in 0 to n {
            x_mean[j] = x_mean[j] + (xdata[base + j] as f64)
        }
    }
    y_mean = y_mean / (m as f64)
    for j in 0 to n {
        x_mean[j] = x_mean[j] / (m as f64)
    }

    let Xc: ptr<f64> = malloc((m as i64) * (n as i64) * 8 + 128) as ptr<f64>
    let yc: ptr<f64> = array_new_f64(m + 8)
    for i in 0 to m {
        yc[i] = (y[i] as f64) - y_mean
        let base: i32 = i * n
        for j in 0 to n {
            Xc[base + j] = (xdata[base + j] as f64) - x_mean[j]
        }
    }

    # The Householder sweep leaves R in the upper triangle of Xc. yc comes back
    # holding the same slope estimates the fit produced; they are not used here,
    # the model's own coefficients are.
    _solve_lstsq_qr(Xc, yc, m, n)

    let mut maxdiag: f64 = 0.0
    for j in 0 to n {
        let dj: f64 = fabs(Xc[j * n + j])
        if dj > maxdiag { maxdiag = dj }
    }
    let mut tol: f64 = 0.00000000001 * maxdiag
    if tol < 0.000000000000001 { tol = 0.000000000000001 }

    let Z: ptr<f64> = array_new_f64(n * n + 16)
    let rank: i32 = lin353_invert_upper(Xc, Z, n, tol)

    # Rank deficiency: refuse, and say so through the flag. See the header
    # comment for why this does not follow PR #443 in solving a reduced problem.
    if rank < n {
        free(Xc as ptr<void>)
        array_free_f64(yc)
        array_free_f64(Z)
        array_free_f64(x_mean)
        let bad3: OLSInference = lin353_empty(n, d, rank, true)
        return bad3
    }

    # (Xc^T Xc)^-1 = Z Z^T, symmetric.
    let XtXinv: ptr<f64> = array_new_f64(n * n + 16)
    for a in 0 to n {
        for b in 0 to n {
            let mut s: f64 = 0.0
            for k in 0 to n {
                s = s + Z[a * n + k] * Z[b * n + k]
            }
            XtXinv[a * n + b] = s
        }
    }

    let df: i32 = m - rank - 1
    let sse: f64 = lin353_sse(model, X, y)

    free(Xc as ptr<void>)
    array_free_f64(yc)
    array_free_f64(Z)

    if df <= 0 {
        array_free_f64(x_mean)
        array_free_f64(XtXinv)
        let bad2: OLSInference = lin353_empty(n, d, n, false)
        return bad2
    }

    let sigma2: f64 = sse / (df as f64)
    let cov: ptr<f32> = array_new_f32(d * d + 16)
    let se: ptr<f32> = array_new_f32(d + 8)
    let ts: ptr<f32> = array_new_f32(d + 8)

    for a in 0 to n {
        for b in 0 to n {
            cov[a * d + b] = (sigma2 * XtXinv[a * n + b]) as f32
        }
    }

    # Intercept block. u = (Xc^T Xc)^-1 xbar.
    let u: ptr<f64> = array_new_f64(n + 8)
    for a in 0 to n {
        let mut s: f64 = 0.0
        for b in 0 to n {
            s = s + XtXinv[a * n + b] * x_mean[b]
        }
        u[a] = s
    }
    let mut q: f64 = 0.0
    for a in 0 to n {
        q = q + x_mean[a] * u[a]
    }
    for a in 0 to n {
        let cab: f32 = (0.0 - sigma2 * u[a]) as f32
        cov[a * d + n] = cab
        cov[n * d + a] = cab
    }
    cov[n * d + n] = (sigma2 * (1.0 / (m as f64) + q)) as f32

    let w: ptr<f32> = model.weights
    for j in 0 to d {
        let v: f32 = cov[j * d + j]
        let mut sj: f32 = 0.0
        if v > 0.0 { sj = sqrt((v as f64)) as f32 }
        se[j] = sj
        let mut coef: f32 = model.bias
        if j < n { coef = w[j] }
        if sj > 0.0 {
            ts[j] = coef / sj
        } else {
            ts[j] = 0.0
        }
    }

    let rse: f32 = sqrt((sigma2)) as f32
    let deficient: bool = rank < n

    array_free_f64(u)
    array_free_f64(x_mean)
    array_free_f64(XtXinv)

    return OLSInference {
        cov: cov,
        std_errors: se,
        t_stats: ts,
        residual_std_error: rse,
        n_features: n,
        n_params: d,
        df_residual: df,
        rank: rank,
        rank_deficient: deficient,
        fitted: true
    }
}

# Standard error of coefficient j. j in 0..n_features-1 is a slope, j ==
# n_features is the intercept.
export function ols_inference_std_error(inf: OLSInference, j: i32) -> f32 {
    if j < 0 || j >= inf.n_params { return 0.0 }
    return inf.std_errors[j]
}

# t statistic of coefficient j against the null that it is zero.
export function ols_inference_t_stat(inf: OLSInference, j: i32) -> f32 {
    if j < 0 || j >= inf.n_params { return 0.0 }
    return inf.t_stats[j]
}

# Entry (a, b) of the coefficient covariance matrix.
export function ols_inference_cov(inf: OLSInference, a: i32, b: i32) -> f32 {
    if a < 0 || a >= inf.n_params { return 0.0 }
    if b < 0 || b >= inf.n_params { return 0.0 }
    return inf.cov[a * inf.n_params + b]
}

export function ols_inference_free(inf: OLSInference) -> void {
    array_free_f32(inf.cov)
    array_free_f32(inf.std_errors)
    array_free_f32(inf.t_stats)
}

# ============================================================================
# LogisticRegression
# Addresses Issue #28394: predict returns probabilities, decide returns classes
# Addresses Issue #30909: pos_label handled internally via classes_ array
# ============================================================================

export struct LogisticRegression {
    weights: ptr<f32>,
    bias: f32,
    biases: ptr<f32>,
    n_features: i32,
    classes: ptr<f32>,
    n_classes: i32,
    penalty: Penalty,
    fitted: bool,
    n_iter: i32
}

# Issue #357: which optimizer logistic_regression_fit_solver runs.
#
# LBFGS is the default and its behaviour is unchanged. It needs only O(m*d) per
# iteration, which is why it is the right default for wide data: Newton forms
# the d x d Hessian at O(m*d^2) and solves it at O(d^3) every iteration.
#
# On a low-dimensional problem that cost is small and Newton pays for itself.
# It converges in far fewer iterations and lands on the same coefficients the
# textbook update produces, which is what R's glm reports. That matters when a
# model is being ported between languages.
#
# For a binary target Newton's method and iteratively reweighted least squares
# are the same update written two ways, so LOGISTIC_SOLVER_IRLS names the same
# solver rather than a second implementation.
export const LOGISTIC_SOLVER_LBFGS: i32 = 0
export const LOGISTIC_SOLVER_NEWTON: i32 = 1
export const LOGISTIC_SOLVER_IRLS: i32 = 1

# Issue #433: turns one row of logits into softmax probabilities in place.
#
# The row maximum is subtracted before exponentiating. Raw logits pass 300
# whenever the gradient at the origin is small enough that LBFGS takes a large
# first step, exp(300) overflows float32 to inf, inf / inf is NaN, and every
# coefficient downstream of it becomes NaN. Subtracting the maximum leaves the
# largest exponent at exactly 1.0 and cannot overflow for any finite input.
# tests/test_multinomial_logistic.flow pins a fixture that reaches that range.
#
# The exp() call lives here rather than at the call site because the transpiler
# miscompiles exp() inside a nested while loop (compiler bug #421). The name
# carries the module and issue number because non-exported functions sharing a
# name across modules collide in the generated C (compiler bug #465).
function lin433_softmax_row(row: ptr<f32>, nc: i32) -> void {
    if nc <= 0 { return }
    let mut max_val: f32 = row[0]
    for c in 1 to nc {
        if row[c] > max_val { max_val = row[c] }
    }
    let mut sum: f32 = 0.0
    for c in 0 to nc {
        let e: f32 = exp((row[c] - max_val) as f64) as f32
        row[c] = e
        sum = sum + e
    }
    if sum > 0.0 {
        let inv: f32 = 1.0 / sum
        for c in 0 to nc {
            row[c] = row[c] * inv
        }
    }
}

# Issue #433: multinomial (softmax) logistic regression, fitted jointly over all
# classes, which is what scikit-learn's LogisticRegression does for a multiclass
# target.
#
# The objective is the MEAN cross-entropy of the softmax over the m training
# samples plus 0.5 * alpha * ||W||^2, summed over every class weight row, with
# the intercepts left unpenalized. That is the same convention the binary path
# uses, so penalty_l2_from_c(C, m) maps scikit-learn's C onto it unchanged
# (issue #408).
#
# One-vs-rest fits K independent binary models and combines them afterwards. It
# optimises a different objective and lands on different coefficients. On iris
# at C=1.0 the difference was one test sample in thirty.
#
# Parameters are the stacked augmented vector theta, nc blocks of d = n + 1
# entries each, with the intercept last inside each block. Solved with the same
# LBFGS as the binary path: memory 10, no line search, at most 100 iterations.
#
# Returns weights in the same nc x n row-major layout the caller expects, so
# logistic_predict and logistic_decide need no change: argmax over the softmax
# is argmax over the linear scores.
function lin433_multinomial_fit(X: Matrix, y: ptr<f32>, classes: ptr<f32>, nc: i32, epochs: i32, penalty: Penalty) -> LogisticRegression {
    let n: i32 = X.cols
    let m: i32 = X.rows
    let d: i32 = n + 1
    let dim: i32 = nc * d

    let all_weights: ptr<f32> = array_new_f32(nc * n)
    let all_biases: ptr<f32> = array_new_f32(nc)
    for i in 0 to nc * n { all_weights[i] = 0.0 }
    for i in 0 to nc { all_biases[i] = 0.0 }

    # X_aug = [X | 1], row-major m x d, so the intercept is just another weight.
    let X_aug: ptr<f32> = malloc((m as i64) * (d as i64) * 4) as ptr<f32>
    let x_data: ptr<f32> = X.data
    let x_stride: i32 = X.cols
    for i in 0 to m {
        let src: i32 = i * x_stride
        let dst: i32 = i * d
        for j in 0 to n {
            X_aug[dst + j] = x_data[src + j]
        }
        X_aug[dst + n] = 1.0
    }

    # Class index of each sample, resolved once rather than per iteration.
    let tgt: ptr<i32> = malloc((m as i64) * 4) as ptr<i32>
    for i in 0 to m {
        tgt[i] = 0
        for c in 0 to nc {
            if classes[c] == y[i] { tgt[i] = c }
        }
    }

    let theta: ptr<f32> = array_new_f32(dim)
    let grad: ptr<f32> = array_new_f32(dim)
    let grad_prev: ptr<f32> = array_new_f32(dim)
    let theta_prev: ptr<f32> = array_new_f32(dim)
    let direction: ptr<f32> = array_new_f32(dim)
    let q: ptr<f32> = array_new_f32(dim)
    let r_lb: ptr<f32> = array_new_f32(dim)
    # Z holds the m x nc logits, then the softmax probabilities, then the
    # residual p - t, all in the same buffer.
    let Z: ptr<f32> = malloc((m as i64) * (nc as i64) * 4) as ptr<f32>
    let col: ptr<f32> = array_new_f32(m)

    let mem: i32 = 10
    let s_hist: ptr<f32> = malloc((mem as i64) * (dim as i64) * 4) as ptr<f32>
    let y_hist: ptr<f32> = malloc((mem as i64) * (dim as i64) * 4) as ptr<f32>
    let rho_hist: ptr<f32> = array_new_f32(mem)
    let alpha_lb: ptr<f32> = array_new_f32(mem)

    let l2_coeff: f32 = 0.0
    if penalty.kind == PENALTY_L2 || penalty.kind == PENALTY_ELASTICNET {
        l2_coeff = penalty.alpha * (1.0 - penalty.l1_ratio)
    }

    let max_iter: i32 = epochs
    if max_iter > 100 { max_iter = 100 }
    if max_iter < 10 { max_iter = 10 }

    let inv_m: f32 = 1.0 / (m as f32)

    for j in 0 to dim { theta[j] = 0.0 }

    # Gradient at the starting point. Each later iteration ends by evaluating
    # the gradient at the theta it stepped to, so the loop carries it forward.
    for c in 0 to nc {
        blas_matvec(X_aug, m, d, theta + c * d, col, 1.0, 0.0)
        for i in 0 to m {
            Z[i * nc + c] = col[i]
        }
    }
    for i in 0 to m {
        lin433_softmax_row(Z + i * nc, nc)
        Z[i * nc + tgt[i]] = Z[i * nc + tgt[i]] - 1.0
    }
    for c in 0 to nc {
        for i in 0 to m {
            col[i] = Z[i * nc + c]
        }
        blas_matvec_trans(X_aug, m, d, col, grad + c * d, inv_m, 0.0)
        let base: i32 = c * d
        for j in 0 to n {
            grad[base + j] = grad[base + j] + l2_coeff * theta[base + j]
        }
    }

    let mut iter: i32 = 0
    let mut converged: bool = false
    let mut hist_size: i32 = 0
    let mut hist_idx: i32 = 0

    while iter < max_iter && not converged {
        let mut gnorm: f32 = 0.0
        for j in 0 to dim {
            let g: f32 = grad[j]
            gnorm = gnorm + g * g
        }
        gnorm = sqrt_f32(gnorm)
        if gnorm < 0.0001 { converged = true; break }

        for j in 0 to dim {
            grad_prev[j] = grad[j]
            theta_prev[j] = theta[j]
        }

        if hist_size == 0 {
            for j in 0 to dim {
                direction[j] = -grad[j]
            }
        } else {
            for j in 0 to dim { q[j] = grad[j] }

            let mut count: i32 = hist_size
            if count > mem { count = mem }
            let mut start: i32 = hist_idx - 1
            if start < 0 { start = mem - 1 }
            let mut k: i32 = 0
            while k < count {
                let si: i32 = start * dim
                let s_dot_q: f32 = blas_dot(dim, s_hist + si, q)
                alpha_lb[k] = rho_hist[start] * s_dot_q
                blas_axpy(dim, -alpha_lb[k], y_hist + si, q)

                start = start - 1
                if start < 0 { start = mem - 1 }
                k = k + 1
            }

            let last: i32 = hist_idx - 1
            if last < 0 { last = mem - 1 }
            let sy: f32 = blas_dot(dim, s_hist + last * dim, y_hist + last * dim)
            let yy: f32 = blas_dot(dim, y_hist + last * dim, y_hist + last * dim)
            let gamma: f32 = 1.0
            if yy > 0.0000001 { gamma = sy / yy }
            for j in 0 to dim { r_lb[j] = gamma * q[j] }

            start = hist_idx - count
            if start < 0 { start = start + mem }
            k = count - 1
            while k >= 0 {
                let si: i32 = start * dim
                let y_dot_r: f32 = blas_dot(dim, y_hist + si, r_lb)
                let beta: f32 = rho_hist[start] * y_dot_r
                blas_axpy(dim, alpha_lb[k] - beta, s_hist + si, r_lb)

                start = start + 1
                if start >= mem { start = 0 }
                k = k - 1
            }

            for j in 0 to dim { direction[j] = -r_lb[j] }
        }

        let mut step: f32 = 1.0
        if iter == 0 {
            let mut gnorm2: f32 = 0.0
            for j in 0 to dim { gnorm2 = gnorm2 + grad[j] * grad[j] }
            if gnorm2 > 0.0000001 { step = 1.0 / gnorm2 }
        }

        for j in 0 to dim { theta[j] = theta_prev[j] + step * direction[j] }

        for c in 0 to nc {
            blas_matvec(X_aug, m, d, theta + c * d, col, 1.0, 0.0)
            for i in 0 to m {
                Z[i * nc + c] = col[i]
            }
        }
        for i in 0 to m {
            lin433_softmax_row(Z + i * nc, nc)
            Z[i * nc + tgt[i]] = Z[i * nc + tgt[i]] - 1.0
        }
        for c in 0 to nc {
            for i in 0 to m {
                col[i] = Z[i * nc + c]
            }
            blas_matvec_trans(X_aug, m, d, col, grad + c * d, inv_m, 0.0)
            let base: i32 = c * d
            for j in 0 to n {
                grad[base + j] = grad[base + j] + l2_coeff * theta[base + j]
            }
        }

        let si: i32 = hist_idx * dim
        for j in 0 to dim {
            s_hist[si + j] = theta[j] - theta_prev[j]
            y_hist[si + j] = grad[j] - grad_prev[j]
        }
        let sy2: f32 = blas_dot(dim, s_hist + si, y_hist + si)
        if sy2 > 0.0000001 {
            rho_hist[hist_idx] = 1.0 / sy2
            hist_idx = hist_idx + 1
            if hist_idx >= mem { hist_idx = 0 }
            if hist_size < mem { hist_size = hist_size + 1 }
        }

        iter = iter + 1
    }

    for c in 0 to nc {
        let base: i32 = c * d
        for j in 0 to n {
            all_weights[c * n + j] = theta[base + j]
        }
        all_biases[c] = theta[base + n]
    }

    free(X_aug as ptr<void>)
    free(tgt as ptr<void>)
    free(Z as ptr<void>)
    array_free_f32(col)
    array_free_f32(theta)
    array_free_f32(grad)
    array_free_f32(grad_prev)
    array_free_f32(theta_prev)
    array_free_f32(direction)
    array_free_f32(q)
    array_free_f32(r_lb)
    free(s_hist as ptr<void>)
    free(y_hist as ptr<void>)
    array_free_f32(rho_hist)
    array_free_f32(alpha_lb)

    let first_bias: f32 = all_biases[0]
    let iters_used: i32 = iter
    return LogisticRegression {
        weights: all_weights,
        bias: first_bias,
        biases: all_biases,
        n_features: n,
        classes: classes,
        n_classes: nc,
        penalty: penalty,
        fitted: true,
        n_iter: iters_used
    }
}

# ============================================================================
# Issue #357: Newton / IRLS solver for binary logistic regression.
#
# Same objective as the LBFGS path: the MEAN log loss over the m training
# samples plus 0.5 * alpha * ||w||^2, with the intercept left unpenalized. The
# penalty convention is unchanged, so penalty_l2_from_c(C, m) maps
# scikit-learn's C onto this solver exactly as it does onto LBFGS (issue #408).
#
# The update is the textbook one. With p the fitted probabilities and
# W = diag(p * (1 - p)),
#
#     g = (1/m) X^T (p - y) + alpha * [w; 0]
#     H = (1/m) X^T W X     + alpha * diag([1..1, 0])
#     theta <- theta - H^-1 g
#
# which is the same step iteratively reweighted least squares takes, written
# without the working response. The gradient, the Hessian and the solve are all
# f64; only the iterate itself is f32.
#
# Cost is O(m*d^2) to build H and O(d^3) to solve it, every iteration, against
# O(m*d) for LBFGS. That is why LBFGS remains the default. On a
# low-dimensional problem the d^2 and d^3 terms are small, Newton converges in
# a handful of iterations, and it reaches the coefficients R's glm reports.
#
# The Hessian this builds is the observed Fisher information. Its inverse,
# divided by m, is the coefficient covariance matrix, which is what issue #353
# needs for standard errors. This function does not expose it; #353 is not
# implemented here.
#
# Helper names carry lin357 because non-exported functions sharing a name
# across modules collide in the generated C (compiler bug #465).
# ============================================================================

# Log loss for one sample, in the form that cannot overflow:
#
#     log(1 + exp(z)) - label * z  =  max(z, 0) + log(1 + exp(-|z|)) - label * z
#
# exp() and log() live in this helper rather than at the call site because the
# transpiler miscompiles them inside a nested while loop (compiler bug #421).
function lin357_logloss_term(z: f32, label: f32) -> f32 {
    let mut az: f32 = z
    if az < 0.0 { az = 0.0 - z }
    let mut mz: f32 = 0.0
    if z > 0.0 { mz = z }
    let one: f64 = 1.0
    let e: f64 = exp((0.0 - az) as f64)
    let soft: f32 = log(one + e) as f32
    return mz + soft - label * z
}

# Penalized mean log loss at theta. Leaves the logits in z_arr, which the
# caller reuses for the next iteration's probabilities.
# The sum is accumulated in f64: over a few thousand samples an f32 running
# total loses enough of the tail that a step which does lower the objective can
# look like one that raises it, and the backtracking below would reject it.
function lin357_objective(X_aug: ptr<f32>, m: i32, d: i32, n: i32, theta: ptr<f32>, label: ptr<f32>, z_arr: ptr<f32>, l2_coeff: f32) -> f64 {
    blas_matvec(X_aug, m, d, theta, z_arr, 1.0, 0.0)
    let mut total: f64 = 0.0
    for i in 0 to m {
        total = total + (lin357_logloss_term(z_arr[i], label[i]) as f64)
    }
    let mut reg: f64 = 0.0
    for j in 0 to n {
        let tj: f64 = theta[j] as f64
        reg = reg + tj * tj
    }
    return total / (m as f64) + 0.5 * (l2_coeff as f64) * reg
}

# Solves (H + ridge*I) delta = -g, raising ridge until the step is usable.
#
# A perfectly collinear design makes H singular. That system is still
# consistent: the gradient is X^T r, which lies in the row space of the design,
# and the row space is exactly the orthogonal complement of the null space of a
# symmetric H. _solve_f64 meets the zero pivot, puts a zero in that coordinate
# and solves the rest, which is a genuine Newton step for the reduced problem
# and leaves the fitted linear predictor unchanged. The residual check below
# confirms that: for the consistent singular case it is zero and no ridge is
# added.
#
# Two things can still go wrong, and both are caught here.
#
#   - The pivot lands just above the zero threshold instead of just below it.
#     The solve then returns a step with an enormous component along the
#     near-null direction. That component does not change any prediction, so
#     the objective cannot reject it, and the coefficients would wander off
#     while the fit stayed still. A step far larger than the current iterate is
#     treated as a failed solve.
#   - The solve returns a NaN.
#
# On either failure a ridge is added to the diagonal and the solve is retried,
# starting at 1e-8 of the mean diagonal and multiplying by 100 each attempt.
# That is Levenberg damping: the damped system is positive definite, so the
# step exists, is finite and is a descent direction.
#
# Returns the ridge that was accepted, or -1.0 if no attempt gave a usable
# step, in which case the caller falls back to a gradient step.
function lin357_damped_solve(H: ptr<f64>, g: ptr<f64>, delta: ptr<f64>, A: ptr<f64>, d: i32, theta_scale: f64) -> f64 {
    let mut gnorm: f64 = 0.0
    for j in 0 to d { gnorm = gnorm + g[j] * g[j] }
    gnorm = sqrt(gnorm)

    let mut trace: f64 = 0.0
    for j in 0 to d { trace = trace + H[j * d + j] }
    let mut scale: f64 = trace / (d as f64)
    if scale < 0.000000000001 { scale = 0.000000000001 }

    let mut ridge: f64 = 0.0
    let mut attempt: i32 = 0
    while attempt < 8 {
        for j in 0 to d {
            for k in 0 to d { A[j * d + k] = H[j * d + k] }
            A[j * d + j] = A[j * d + j] + ridge
            delta[j] = 0.0 - g[j]
        }
        _solve_f64(A, delta, d)

        let mut finite: bool = true
        let mut resid: f64 = 0.0
        let mut dmax: f64 = 0.0
        for j in 0 to d {
            if delta[j] != delta[j] { finite = false }
            let ad: f64 = fabs(delta[j])
            if ad > dmax { dmax = ad }
            let mut s: f64 = g[j] + ridge * delta[j]
            for k in 0 to d { s = s + H[j * d + k] * delta[k] }
            resid = resid + s * s
        }
        resid = sqrt(resid)

        let bounded: bool = dmax <= 1000000.0 * (theta_scale + 1.0)
        if finite && bounded && resid <= 0.0001 * gnorm + 0.000000000000001 {
            return ridge
        }

        if ridge == 0.0 {
            ridge = 0.00000001 * scale
        } else {
            ridge = ridge * 100.0
        }
        attempt = attempt + 1
    }
    return -1.0
}

# Newton / IRLS fit for one or two classes, one binary model per class.
# Returns the same layout logistic_regression_fit returns.
function lin357_newton_fit(X: Matrix, y: ptr<f32>, classes: ptr<f32>, nc: i32, epochs: i32, penalty: Penalty) -> LogisticRegression {
    let n: i32 = X.cols
    let m: i32 = X.rows
    let d: i32 = n + 1

    let all_weights: ptr<f32> = array_new_f32(nc * n)
    let all_biases: ptr<f32> = array_new_f32(nc)
    for i in 0 to nc * n { all_weights[i] = 0.0 }
    for i in 0 to nc { all_biases[i] = 0.0 }

    # X_aug = [X | 1], row-major m x d, exactly as the LBFGS path builds it.
    let X_aug: ptr<f32> = malloc((m as i64) * (d as i64) * 4 + 128) as ptr<f32>
    let x_data: ptr<f32> = X.data
    let x_stride: i32 = X.cols
    for i in 0 to m {
        let src: i32 = i * x_stride
        let dst: i32 = i * d
        for j in 0 to n {
            X_aug[dst + j] = x_data[src + j]
        }
        X_aug[dst + n] = 1.0
    }

    let theta: ptr<f32> = array_new_f32(d)
    let theta_prev: ptr<f32> = array_new_f32(d)
    let label_arr: ptr<f32> = array_new_f32(m)
    let z_arr: ptr<f32> = array_new_f32(m)
    let err_arr: ptr<f32> = array_new_f32(m)
    let wt_arr: ptr<f32> = array_new_f32(m)

    let grad: ptr<f64> = malloc((d as i64) * 8 + 128) as ptr<f64>
    let delta: ptr<f64> = malloc((d as i64) * 8 + 128) as ptr<f64>
    let hess: ptr<f64> = malloc((d as i64) * (d as i64) * 8 + 128) as ptr<f64>
    let hcopy: ptr<f64> = malloc((d as i64) * (d as i64) * 8 + 128) as ptr<f64>

    let l2_coeff: f32 = 0.0
    if penalty.kind == PENALTY_L2 || penalty.kind == PENALTY_ELASTICNET {
        l2_coeff = penalty.alpha * (1.0 - penalty.l1_ratio)
    }

    # Newton needs far fewer iterations than LBFGS, so epochs is honoured down
    # to 1 rather than being floored at 10.
    let mut max_iter: i32 = epochs
    if max_iter > 100 { max_iter = 100 }
    if max_iter < 1 { max_iter = 1 }

    let inv_m: f64 = 1.0 / (m as f64)
    let l2_f64: f64 = l2_coeff as f64
    let mut iters_used: i32 = 0

    for c in 0 to nc {
        for j in 0 to d { theta[j] = 0.0 }

        let target: f32 = classes[c]
        for i in 0 to m {
            label_arr[i] = 0.0
            if y[i] == target { label_arr[i] = 1.0 }
        }

        let mut fobj: f64 = lin357_objective(X_aug, m, d, n, theta, label_arr, z_arr, l2_coeff)
        let mut iter: i32 = 0
        let mut converged: bool = false

        while iter < max_iter && not converged {
            # z_arr already holds the logits at theta.
            for i in 0 to m {
                let pi: f32 = sigmoid(z_arr[i])
                err_arr[i] = pi - label_arr[i]
                let mut wi: f32 = pi * (1.0 - pi)
                # A saturated probability drives the weight to zero and takes a
                # row out of the Hessian entirely. Flooring it keeps H positive
                # definite without moving a converged fit.
                if wi < 0.0000001 { wi = 0.0000001 }
                wt_arr[i] = wi
            }

            for j in 0 to d { grad[j] = 0.0 }
            for i in 0 to m {
                let base: i32 = i * d
                let e: f64 = err_arr[i] as f64
                for j in 0 to d {
                    grad[j] = grad[j] + (X_aug[base + j] as f64) * e
                }
            }
            for j in 0 to d { grad[j] = grad[j] * inv_m }
            for j in 0 to n { grad[j] = grad[j] + l2_f64 * (theta[j] as f64) }

            let mut gnorm: f64 = 0.0
            for j in 0 to d { gnorm = gnorm + grad[j] * grad[j] }
            gnorm = sqrt(gnorm)
            if gnorm < 0.000001 { converged = true; break }

            for j in 0 to d * d { hess[j] = 0.0 }
            for i in 0 to m {
                let base: i32 = i * d
                let wi: f64 = wt_arr[i] as f64
                for j in 0 to d {
                    let xw: f64 = (X_aug[base + j] as f64) * wi
                    for k in j to d {
                        hess[j * d + k] = hess[j * d + k] + xw * (X_aug[base + k] as f64)
                    }
                }
            }
            for j in 0 to d {
                for k in j to d {
                    let v: f64 = hess[j * d + k] * inv_m
                    hess[j * d + k] = v
                    hess[k * d + j] = v
                }
            }
            for j in 0 to n { hess[j * d + j] = hess[j * d + j] + l2_f64 }

            let mut theta_scale: f64 = 0.0
            for j in 0 to d {
                let at: f32 = theta[j]
                let mut aat: f64 = at as f64
                if aat < 0.0 { aat = 0.0 - aat }
                if aat > theta_scale { theta_scale = aat }
            }
            let ridge: f64 = lin357_damped_solve(hess, grad, delta, hcopy, d, theta_scale)
            if ridge < 0.0 {
                # No usable Newton step. Fall back to a scaled gradient step so
                # the fit still moves downhill instead of stopping on garbage.
                for j in 0 to d { delta[j] = (0.0 - grad[j]) / (gnorm + 0.000000001) }
            }

            for j in 0 to d { theta_prev[j] = theta[j] }

            # Backtracking guard. A full Newton step is the common case; a step
            # that raises the objective is halved until it does not.
            let mut step: f32 = 1.0
            let mut accepted: bool = false
            let mut bt: i32 = 0
            while bt < 12 && not accepted {
                for j in 0 to d { theta[j] = theta_prev[j] + step * (delta[j] as f32) }
                let f_new: f64 = lin357_objective(X_aug, m, d, n, theta, label_arr, z_arr, l2_coeff)
                if f_new == f_new && f_new <= fobj {
                    fobj = f_new
                    accepted = true
                } else {
                    step = step * 0.5
                }
                bt = bt + 1
            }

            if accepted {
                let mut dn: f32 = 0.0
                for j in 0 to d {
                    let dj: f32 = theta[j] - theta_prev[j]
                    dn = dn + dj * dj
                }
                if sqrt_f32(dn) < 0.0000001 { converged = true }
            } else {
                for j in 0 to d { theta[j] = theta_prev[j] }
                converged = true
            }

            iter = iter + 1
        }

        if iter > iters_used { iters_used = iter }

        for j in 0 to n {
            all_weights[c * n + j] = theta[j]
        }
        all_biases[c] = theta[n]
    }

    free(X_aug as ptr<void>)
    array_free_f32(theta)
    array_free_f32(theta_prev)
    array_free_f32(label_arr)
    array_free_f32(z_arr)
    array_free_f32(err_arr)
    array_free_f32(wt_arr)
    free(grad as ptr<void>)
    free(delta as ptr<void>)
    free(hess as ptr<void>)
    free(hcopy as ptr<void>)

    let first_bias: f32 = all_biases[0]
    return LogisticRegression {
        weights: all_weights,
        bias: first_bias,
        biases: all_biases,
        n_features: n,
        classes: classes,
        n_classes: nc,
        penalty: penalty,
        fitted: true,
        n_iter: iters_used
    }
}
# Fits a logistic regression classifier.
#
# Two or fewer classes: one binary model per class, one-vs-rest. The objective
# for each subproblem is the MEAN log loss over the m training samples plus
# 0.5 * alpha * ||w||^2, with the intercept left unpenalized.
#
# More than two classes: one multinomial softmax fitted jointly over all
# classes, which is what scikit-learn's LogisticRegression does. See issue #433
# and lin433_multinomial_fit. The objective carries the same mean-loss and
# unpenalized-intercept convention, so the penalty mapping is unchanged.
#
# To match scikit-learn's C on the same data, build the penalty with
# penalty_l2_from_c(C, m) rather than passing C or 1/C as alpha directly. See
# issue #408.
#
# The solver is LBFGS. Issue #357: call logistic_regression_fit_solver to ask
# for Newton / IRLS instead.
export function logistic_regression_fit(X: Matrix, y: ptr<f32>, n_classes: i32, epochs: i32, lr: f32, penalty: Penalty) -> LogisticRegression {
    return logistic_regression_fit_solver(X, y, n_classes, epochs, lr, penalty, 0)
}

# Issue #357: logistic_regression_fit with the solver named explicitly.
#
# solver is LOGISTIC_SOLVER_LBFGS (0) or LOGISTIC_SOLVER_NEWTON (1).
# LOGISTIC_SOLVER_IRLS is the same value as LOGISTIC_SOLVER_NEWTON: for a
# binary target the two are the same update. Anything else is treated as
# LBFGS. Pass the literal rather than the constant when calling through the
# scikit.flow umbrella, because an export const is not transitively visible
# through imports.
#
# The Newton solver covers the one-and-two-class case, which is the case the
# textbook update and R's glm describe. With more than two classes the fit is
# the joint multinomial softmax of issue #433 and runs LBFGS whichever solver
# was asked for; a one-vs-rest Newton fit there would optimise a different
# objective and disagree with scikit-learn.
export function logistic_regression_fit_solver(X: Matrix, y: ptr<f32>, n_classes: i32, epochs: i32, lr: f32, penalty: Penalty, solver: i32) -> LogisticRegression {
    let n: i32 = X.cols
    let m: i32 = X.rows

    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, m, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count
    let nc: i32 = n_found

    # Issue #433: scikit-learn fits one multinomial softmax over all classes
    # rather than K independent one-vs-rest binary models, and the two land on
    # different coefficients. The binary case is untouched: with two classes
    # scikit-learn also fits a single binary model.
    if nc > 2 {
        return lin433_multinomial_fit(X, y, classes, nc, epochs, penalty)
    }

    # Issue #357.
    if solver == LOGISTIC_SOLVER_NEWTON {
        return lin357_newton_fit(X, y, classes, nc, epochs, penalty)
    }

    let all_weights: ptr<f32> = array_new_f32(nc * n)
    let all_biases: ptr<f32> = array_new_f32(nc)
    for i in 0 to nc * n { all_weights[i] = 0.0 }
    for i in 0 to nc { all_biases[i] = 0.0 }

    # LBFGS optimizer for each binary subproblem.
    # Augmented weight vector includes bias: theta = [w; b], dimension d = n+1.
    # X_aug = [X | 1] stored as row-major m x d.
    # Uses BLAS (cblas_sgemv) for forward pass and gradient.
    # LBFGS avoids the O(m*d^2) Hessian, needing only O(m*d) per iteration.
    let d: i32 = n + 1
    let X_aug: ptr<f32> = malloc((m as i64) * (d as i64) * 4) as ptr<f32>
    let x_data: ptr<f32> = X.data
    let x_stride: i32 = X.cols
    for i in 0 to m {
        let src: i32 = i * x_stride
        let dst: i32 = i * d
        for j in 0 to n {
            X_aug[dst + j] = x_data[src + j]
        }
        X_aug[dst + n] = 1.0
    }

    let theta: ptr<f32> = array_new_f32(d)
    let grad: ptr<f32> = array_new_f32(d)
    let p_arr: ptr<f32> = array_new_f32(m)
    let z_arr: ptr<f32> = array_new_f32(m)
    let err_arr: ptr<f32> = array_new_f32(m)
    # One-vs-rest target for the class currently being fitted. The comparison
    # against classes[c] is loop-invariant across LBFGS iterations, so it is
    # built once per class instead of m times per iteration.
    let label_arr: ptr<f32> = array_new_f32(m)

    # LBFGS history buffers (memory = 10)
    let mem: i32 = 10
    let s_hist: ptr<f32> = malloc((mem as i64) * (d as i64) * 4) as ptr<f32>
    let y_hist: ptr<f32> = malloc((mem as i64) * (d as i64) * 4) as ptr<f32>
    let rho_hist: ptr<f32> = array_new_f32(mem)
    let alpha_lb: ptr<f32> = array_new_f32(mem)
    let q: ptr<f32> = array_new_f32(d)
    let r_lb: ptr<f32> = array_new_f32(d)
    let grad_prev: ptr<f32> = array_new_f32(d)
    let theta_prev: ptr<f32> = array_new_f32(d)
    let direction: ptr<f32> = array_new_f32(d)

    let l2_coeff: f32 = 0.0
    if penalty.kind == PENALTY_L2 || penalty.kind == PENALTY_ELASTICNET {
        l2_coeff = penalty.alpha * (1.0 - penalty.l1_ratio)
    }

    let max_iter: i32 = epochs
    if max_iter > 100 { max_iter = 100 }
    if max_iter < 10 { max_iter = 10 }

    let inv_m: f32 = 1.0 / (m as f32)

    # Issue #357: reported as n_iter, the worst case over the one-vs-rest
    # subproblems. It is read only after the fit and changes no arithmetic.
    let mut iters_used: i32 = 0

    for c in 0 to nc {
        for j in 0 to d { theta[j] = 0.0 }

        let target: f32 = classes[c]
        for i in 0 to m {
            label_arr[i] = 0.0
            if y[i] == target { label_arr[i] = 1.0 }
        }

        let mut iter: i32 = 0
        let mut converged: bool = false
        let mut hist_size: i32 = 0
        let mut hist_idx: i32 = 0

        # Gradient at the starting point. Every later iteration ends by
        # evaluating the gradient at the theta it just stepped to, which is the
        # same value this block used to recompute at the top of the loop, so
        # the loop now carries it forward instead of redoing both sgemv calls.
        blas_matvec(X_aug, m, d, theta, z_arr, 1.0, 0.0)
        for i in 0 to m {
            p_arr[i] = sigmoid(z_arr[i])
            err_arr[i] = p_arr[i] - label_arr[i]
        }
        blas_matvec_trans(X_aug, m, d, err_arr, grad, inv_m, 0.0)
        for j in 0 to n {
            grad[j] = grad[j] + l2_coeff * theta[j]
        }

        while iter < max_iter && not converged {
            # Check convergence
            let mut gnorm: f32 = 0.0
            for j in 0 to d {
                let g: f32 = grad[j]
                gnorm = gnorm + g * g
            }
            # Approximate sqrt via repeated multiply
            gnorm = sqrt_f32(gnorm)
            if gnorm < 0.0001 { converged = true; break }

            # Save gradient and theta for history
            for j in 0 to d {
                grad_prev[j] = grad[j]
                theta_prev[j] = theta[j]
            }

            # LBFGS two-loop recursion to compute direction = -H * grad
            if hist_size == 0 {
                # First iteration: steepest descent
                for j in 0 to d {
                    direction[j] = -grad[j]
                }
            } else {
                # q = grad
                for j in 0 to d { q[j] = grad[j] }

                # First loop (newest to oldest)
                let mut count: i32 = hist_size
                if count > mem { count = mem }
                let mut start: i32 = hist_idx - 1
                if start < 0 { start = mem - 1 }
                let mut k: i32 = 0
                while k < count {
                    let si: i32 = start * d
                    let yi: i32 = start * d
                    let s_dot_q: f32 = blas_dot(d, s_hist + si, q)
                    alpha_lb[k] = rho_hist[start] * s_dot_q
                    # q = q - alpha * y
                    blas_axpy(d, -alpha_lb[k], y_hist + yi, q)

                    start = start - 1
                    if start < 0 { start = mem - 1 }
                    k = k + 1
                }

                # Scaling: r = q * (s_dot_y / y_dot_y) from most recent
                let last: i32 = hist_idx - 1
                if last < 0 { last = mem - 1 }
                let sy: f32 = blas_dot(d, s_hist + last * d, y_hist + last * d)
                let yy: f32 = blas_dot(d, y_hist + last * d, y_hist + last * d)
                let gamma: f32 = 1.0
                if yy > 0.0000001 { gamma = sy / yy }
                for j in 0 to d { r_lb[j] = gamma * q[j] }

                # Second loop (oldest to newest)
                start = hist_idx - count
                if start < 0 { start = start + mem }
                k = count - 1
                while k >= 0 {
                    let si: i32 = start * d
                    let yi: i32 = start * d
                    let y_dot_r: f32 = blas_dot(d, y_hist + yi, r_lb)
                    let beta: f32 = rho_hist[start] * y_dot_r
                    # r = r + (alpha - beta) * s
                    blas_axpy(d, alpha_lb[k] - beta, s_hist + si, r_lb)

                    start = start + 1
                    if start >= mem { start = 0 }
                    k = k - 1
                }

                # direction = -r
                for j in 0 to d { direction[j] = -r_lb[j] }
            }

            # Take LBFGS step directly (no line search for speed)
            let mut step: f32 = 1.0
            if iter == 0 {
                # Scale first step by inverse gradient norm
                let mut gnorm2: f32 = 0.0
                for j in 0 to d { gnorm2 = gnorm2 + grad[j] * grad[j] }
                if gnorm2 > 0.0000001 { step = 1.0 / gnorm2 }
            }

            # theta = theta + step * direction
            for j in 0 to d { theta[j] = theta_prev[j] + step * direction[j] }

            # Gradient at the new theta, for the LBFGS history and for the next
            # iteration's convergence check and direction.
            blas_matvec(X_aug, m, d, theta, z_arr, 1.0, 0.0)
            for i in 0 to m {
                p_arr[i] = sigmoid(z_arr[i])
                err_arr[i] = p_arr[i] - label_arr[i]
            }
            blas_matvec_trans(X_aug, m, d, err_arr, grad, inv_m, 0.0)
            for j in 0 to n {
                grad[j] = grad[j] + l2_coeff * theta[j]
            }

            # s = theta - theta_prev, y = grad - grad_prev
            let si: i32 = hist_idx * d
            for j in 0 to d {
                s_hist[si + j] = theta[j] - theta_prev[j]
                y_hist[si + j] = grad[j] - grad_prev[j]
            }
            let sy: f32 = blas_dot(d, s_hist + si, y_hist + si)
            if sy > 0.0000001 {
                rho_hist[hist_idx] = 1.0 / sy
                hist_idx = hist_idx + 1
                if hist_idx >= mem { hist_idx = 0 }
                if hist_size < mem { hist_size = hist_size + 1 }
            }

            iter = iter + 1
        }

        if iter > iters_used { iters_used = iter }

        for j in 0 to n {
            all_weights[c * n + j] = theta[j]
        }
        all_biases[c] = theta[n]
    }

    free(X_aug as ptr<void>)
    array_free_f32(theta)
    array_free_f32(grad)
    array_free_f32(p_arr)
    array_free_f32(z_arr)
    array_free_f32(err_arr)
    array_free_f32(label_arr)
    free(s_hist as ptr<void>)
    free(y_hist as ptr<void>)
    array_free_f32(rho_hist)
    array_free_f32(alpha_lb)
    array_free_f32(q)
    array_free_f32(r_lb)
    array_free_f32(grad_prev)
    array_free_f32(theta_prev)
    array_free_f32(direction)

    return LogisticRegression {
        weights: all_weights,
        bias: all_biases[0],
        biases: all_biases,
        n_features: n,
        classes: classes,
        n_classes: nc,
        penalty: penalty,
        fitted: true,
        n_iter: iters_used
    }
}

# Sparse-input version of logistic_regression_fit.
# Takes a SparseMatrix (CSR) and only iterates over non-zero entries.
export function logistic_regression_fit_sparse(S: SparseMatrix, y: ptr<f32>, n_classes: i32, epochs: i32, lr: f32, penalty: Penalty) -> LogisticRegression {
    let n: i32 = S.n_cols
    let n_samples: i32 = S.n_rows

    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, n_samples, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count
    let nc: i32 = n_found

    let all_weights: ptr<f32> = array_new_f32(nc * n)
    let all_biases: ptr<f32> = array_new_f32(nc)
    for i in 0 to nc * n { all_weights[i] = 0.0 }
    for i in 0 to nc { all_biases[i] = 0.0 }

    for c in 0 to nc {
        let w: ptr<f32> = array_new_f32(n)
        for j in 0 to n { w[j] = 0.0 }
        let mut b: f32 = 0.0

        for epoch in 0 to epochs {
            let grad_w: ptr<f32> = array_new_f32(n)
            for j in 0 to n { grad_w[j] = 0.0 }
            let mut grad_b: f32 = 0.0

            for i in 0 to n_samples {
                let mut z: f32 = b
                let start: i32 = S.indptr[i]
                let end: i32 = S.indptr[i + 1]
                let mut k: i32 = start
                while k < end {
                    z = z + w[S.indices[k]] * S.data[k]
                    k = k + 1
                }
                let p: f32 = sigmoid(z)
                let label: f32 = 0.0
                if y[i] == classes[c] { label = 1.0 }
                let err: f32 = p - label

                k = start
                while k < end {
                    grad_w[S.indices[k]] = grad_w[S.indices[k]] + err * S.data[k]
                    k = k + 1
                }
                grad_b = grad_b + err
            }

            let inv_n: f32 = 1.0 / (n_samples as f32)
            for j in 0 to n {
                grad_w[j] = grad_w[j] * inv_n
                if penalty.kind == PENALTY_L2 || penalty.kind == PENALTY_ELASTICNET {
                    grad_w[j] = grad_w[j] + penalty.alpha * w[j] * (1.0 - penalty.l1_ratio)
                }
                w[j] = w[j] - lr * grad_w[j]
            }
            b = b - lr * grad_b * inv_n
            array_free_f32(grad_w)
        }

        for j in 0 to n {
            all_weights[c * n + j] = w[j]
        }
        all_biases[c] = b
        array_free_f32(w)
    }

    # Fixed-length gradient descent: it runs every epoch and never tests for
    # convergence, so the iteration count is the epoch count it was given.
    return LogisticRegression {
        weights: all_weights,
        bias: all_biases[0],
        biases: all_biases,
        n_features: n,
        classes: classes,
        n_classes: nc,
        penalty: penalty,
        fitted: true,
        n_iter: epochs
    }
}

# Positive-class probabilities: P(classes[1]), which is what scikit-learn puts
# in column 1 of predict_proba. Issue #435 pins that convention, because the
# threshold logistic_decide takes is meaningless unless caller and callee agree
# on which class the probability refers to.
#
# This is exactly sigmoid(decision_function), so it reuses the BLAS-backed score
# path and maps the result in place rather than repeating the dot product with
# per-element matrix_at calls.
export function logistic_predict_proba(model: LogisticRegression, X: Matrix) -> ptr<f32> {
    let probs: ptr<f32> = logistic_decision_function(model, X)
    let rows: i32 = X.rows
    for i in 0 to rows {
        probs[i] = sigmoid(probs[i])
    }
    return probs
}

# One-vs-rest class prediction: argmax over the per-class decision scores.
# The scores for one class are a matrix-vector product against a contiguous
# row-major X, so each class costs one cblas_sgemv and the running argmax is
# carried across classes in two m-length buffers. Class order is preserved, so
# ties still resolve to the lowest class index exactly as before.
export function logistic_predict(model: LogisticRegression, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let result: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return result }

    let nf: i32 = model.n_features
    let nc: i32 = model.n_classes

    if nf <= 0 || nf > X.cols {
        for i in 0 to rows {
            let mut best_score: f32 = -1000000.0
            let mut best_class: i32 = 0
            for c in 0 to nc {
                let mut z: f32 = model.biases[c]
                for j in 0 to nf {
                    z = z + model.weights[c * nf + j] * matrix_at(X, i, j)
                }
                if z > best_score {
                    best_score = z
                    best_class = c
                }
            }
            result[i] = model.classes[best_class]
        }
        return result
    }

    let scores: ptr<f32> = array_new_f32(rows)
    let best: ptr<f32> = array_new_f32(rows)
    let best_cls: ptr<i32> = malloc((rows as i64) * 4) as ptr<i32>
    for i in 0 to rows {
        best[i] = -1000000.0
        best_cls[i] = 0
    }

    for c in 0 to nc {
        blas_matvec_ld(X.data, rows, nf, X.cols, model.weights + c * nf, scores, 1.0, 0.0)
        let b: f32 = model.biases[c]
        for i in 0 to rows {
            let z: f32 = scores[i] + b
            if z > best[i] {
                best[i] = z
                best_cls[i] = c
            }
        }
    }

    for i in 0 to rows {
        result[i] = model.classes[best_cls[i]]
    }

    array_free_f32(scores)
    array_free_f32(best)
    free(best_cls as ptr<void>)
    return result
}

# Turns probabilities into labels at an explicit threshold. probs is
# P(classes[1]) as logistic_predict_proba returns it, so a value at or above
# the threshold is classes[1] and raising the threshold makes classes[1] rarer
# (issue #435).
#
# With more than two classes there is no single probability to threshold, so
# the input is passed through unchanged. Callers hand it the argmax labels from
# logistic_predict in that case.
export function logistic_decide(model: LogisticRegression, probs: ptr<f32>, n_samples: i32, threshold: f32) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(n_samples)
    if model.n_classes <= 2 {
        for i in 0 to n_samples {
            if probs[i] >= threshold {
                labels[i] = model.classes[1]
            } else {
                labels[i] = model.classes[0]
            }
        }
    } else {
        for i in 0 to n_samples {
            labels[i] = probs[i]
        }
    }
    return labels
}

# Binary decision scores: z = X * w + b for the positive class, which is
# classes[1]. A positive score means classes[1], the same sign convention
# scikit-learn's decision_function uses.
#
# Issue #435: the one-vs-rest loop fits class c as the positive class and
# stores that model in weights row c, so for a binary target the classes[1]
# model is row 1. This function used to read row 0, the classes[0] model, which
# made logistic_predict_proba return P(classes[0]) while logistic_decide
# labelled a high probability classes[1]. The two composed to an inverted
# label: 0 of 6 correct on a perfectly separable problem.
#
# model.weights and model.bias are row 0 and are left alone. Nothing else reads
# them for a binary target; logistic_predict takes the argmax over both rows.
#
# X is contiguous row-major, so the whole thing is one cblas_sgemv with the
# matrix row stride passed as lda. Falls back to the scalar dot product when the
# feature count does not fit inside a row of X.
export function logistic_decision_function(model: LogisticRegression, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let scores: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return scores }

    let nf: i32 = model.n_features
    let mut bias: f32 = model.bias
    let mut w: ptr<f32> = model.weights
    if model.n_classes == 2 {
        bias = model.biases[1]
        w = model.weights + nf
    }

    if nf <= 0 || nf > X.cols {
        let data: ptr<f32> = X.data
        let stride: i32 = X.cols
        for i in 0 to rows {
            let mut z: f32 = bias
            let base: i32 = i * stride
            for j in 0 to nf {
                z = z + w[j] * data[base + j]
            }
            scores[i] = z
        }
        return scores
    }

    blas_matvec_ld(X.data, rows, nf, X.cols, w, scores, 1.0, 0.0)
    for i in 0 to rows {
        scores[i] = scores[i] + bias
    }
    return scores
}

export function logistic_regression_free(model: LogisticRegression) -> void {
    array_free_f32(model.weights)
    array_free_f32(model.biases)
    array_free_f32(model.classes)
}

# ============================================================================
# Logistic coefficient inference (Issue #458)
#
# The deferred half of #353. PR #446 shipped OLS inference and left logistic
# models out; PR #443's Newton solver forms the matrix this needs, the observed
# information at the fitted coefficients.
#
# CONVENTION. For a binary logit the asymptotic covariance of the maximum
# likelihood coefficients is the inverse of the observed information
#
#     I(theta) = sum_i p_i (1 - p_i) xt_i xt_i^T,        cov = I^-1
#
# over the augmented rows xt_i = [x_i, 1], with p_i the fitted probability of
# the positive class. Written with the MEAN Hessian H = I / m that
# lin357_newton_fit assembles, the same quantity is H^-1 / m. The two are equal
# and this code computes the unscaled form directly. It is what statsmodels
# reports as Logit.cov_params() and what R's glm reports as vcov(), so these
# numbers are checkable against either.
#
# The information matrix is never formed. sqrt(p_i (1 - p_i)) scales row i of
# the augmented design into A, and then I = A^T A, so the QR of A gives the
# triangular factor R with R^T R = I and cov = R^-1 R^-T. That is exactly the
# route ols_inference_fit takes, reusing _solve_lstsq_qr and
# lin353_invert_upper unchanged, and it avoids squaring the condition number
# the way an explicit Hessian and a Gaussian solve would.
#
# INDEX CONVENTION follows ols_inference_fit: 0..n_features-1 are the slopes in
# feature order and index n_features is the intercept. There is no p value, for
# the same reason #446 shipped none: it needs a normal CDF accurate in the
# tail, and a hand-rolled one is worse than none.
#
# OWNERSHIP. Nothing is retained on the fit. LogisticRegression gains no field,
# logistic_regression_fit is untouched, and this call recomputes the
# probabilities at the fitted coefficients into buffers it owns and
# logistic_inference_free releases. That is #446's answer to the ownership
# question #443 left open on #353, applied unchanged.
#
# WHAT IS REFUSED, each with fitted = false and zeroed buffers.
#
#   Penalized fits. The Newton Hessian carries the alpha * I term, so its
#   inverse is a PENALIZED covariance and not the sampling covariance a reader
#   of a standard error expects. ols_inference_fit refuses the same case; this
#   follows it. After #430 the canonical benchmark always fits penalized, so
#   this surface is for callers who fit with penalty_none().
#
#   More than two classes. Above two classes the fit is the joint multinomial
#   softmax of #433, whose information matrix is a (K-1)d x (K-1)d block system
#   with cross-class blocks. That is a substantially bigger job than the binary
#   case and is deliberately out of scope, as #458 scopes it.
#
#   A separated fixture. Complete separation has no maximum likelihood
#   estimate: the coefficients diverge and any standard error read off the
#   information matrix records where the optimizer stopped rather than a
#   sampling variance. It is reported through separable = true rather than as a
#   very large finite number. The test is the fitted hyperplane classifying
#   every point correctly, which is exactly what separation means.
#
#   A singular weighted design, reported through rank_deficient = true, on the
#   same relative cutoff (1e-11 * max|R_ii|, floored at 1e-15) that #446 and
#   #450 made standard in this file.
# ============================================================================

export struct LogisticInference {
    cov: ptr<f32>,
    std_errors: ptr<f32>,
    z_stats: ptr<f32>,
    n_features: i32,
    n_params: i32,
    n_samples: i32,
    rank: i32,
    rank_deficient: bool,
    separable: bool,
    fitted: bool
}

# The binomial variance p(1-p) at a logit, as e / (1+e)^2 with e = exp(-|z|).
# Computing p first and then p * (1 - p) loses the whole quantity to
# cancellation once p rounds to 1; this form stays accurate into the tails and
# underflows smoothly to zero.
#
# exp() lives in a helper rather than at the call site because the transpiler
# miscompiles it inside a nested while loop (compiler bug #421). The name
# carries the module and issue number because non-exported functions sharing a
# name across modules collide in the generated C (compiler bug #465).
function lin458_variance_f64(z: f64) -> f64 {
    let mut az: f64 = z
    if az < 0.0 { az = 0.0 - z }
    let e: f64 = exp(0.0 - az)
    let s: f64 = 1.0 + e
    return e / (s * s)
}

# A refused result: zeroed buffers, fitted = false, and the flag that says why.
function lin458_empty(n: i32, d: i32, rank: i32, deficient: bool, separable: bool) -> LogisticInference {
    let cov: ptr<f32> = array_new_f32(d * d + 16)
    let se: ptr<f32> = array_new_f32(d + 8)
    let zs: ptr<f32> = array_new_f32(d + 8)
    return LogisticInference {
        cov: cov,
        std_errors: se,
        z_stats: zs,
        n_features: n,
        n_params: d,
        n_samples: 0,
        rank: rank,
        rank_deficient: deficient,
        separable: separable,
        fitted: false
    }
}

# Coefficient inference for an unpenalized binary logistic fit.
#
# model must be the result of fitting the same X and y that are passed here,
# with penalty_none(). The coefficients described are the ones
# logistic_decision_function reports, that is the model for classes[1]. Class
# order comes from distinct_f32, which lists labels in order of first
# appearance in y, so classes[1] is the second distinct label seen and not
# necessarily the larger one.
export function logistic_inference_fit(model: LogisticRegression, X: Matrix, y: ptr<f32>) -> LogisticInference {
    let n: i32 = X.cols
    let m: i32 = X.rows
    let d: i32 = n + 1

    if n <= 0 || m <= 0 {
        let bad0: LogisticInference = lin458_empty(n, d, 0, false, false)
        return bad0
    }
    if model.fitted == false || model.n_features != n {
        let bad1: LogisticInference = lin458_empty(n, d, 0, false, false)
        return bad1
    }
    # Penalized: refused, see the header.
    if model.penalty.kind != PENALTY_NONE {
        let bad2: LogisticInference = lin458_empty(n, d, 0, false, false)
        return bad2
    }
    # Multiclass: refused, out of scope. n_classes < 2 means y carried a single
    # label, which has no identified coefficient either.
    if model.n_classes != 2 {
        let bad3: LogisticInference = lin458_empty(n, d, 0, false, false)
        return bad3
    }
    # Fewer rows than parameters cannot support a full rank information matrix.
    if m < d {
        let bad4: LogisticInference = lin458_empty(n, d, 0, true, false)
        return bad4
    }

    let w: ptr<f32> = model.weights + n
    let bias: f32 = model.biases[1]
    let positive: f32 = model.classes[1]

    let xdata: ptr<f32> = X.data
    let stride: i32 = X.cols

    # Logits at the fitted coefficients. No exp() in this loop: it is nested.
    let zbuf: ptr<f64> = array_new_f64(m + 8)
    for i in 0 to m {
        let base: i32 = i * stride
        let mut z: f64 = bias as f64
        for j in 0 to n {
            z = z + (w[j] as f64) * (xdata[base + j] as f64)
        }
        zbuf[i] = z
    }

    # Row weights, and the separation test.
    #
    # Complete separation IS the condition that some hyperplane classifies
    # every point correctly. When one exists, scaling that hyperplane up drives
    # the log likelihood towards zero without ever attaining it, the maximum
    # likelihood estimate does not exist, and no covariance describes a
    # coefficient that is not there. So the test is a property of the data, and
    # the fitted hyperplane is the witness: if every z_i has the sign of its
    # label, the data are separable.
    #
    # This is exact where a threshold is not. An earlier draft asked whether
    # every fitted probability was within 1e-4 of its label and whether the
    # total binomial variance had collapsed. On a six point separable fixture
    # the Newton fit tripped both, and the LBFGS fit of the same data stopped
    # at a slope of 8.3 and tripped neither, so the same data got standard
    # errors from one solver and a refusal from the other. The sign test
    # catches both fits, because both found a separating hyperplane.
    #
    # A point with z_i exactly zero sits on the boundary and is counted as not
    # separated, which is the conservative direction: it answers rather than
    # refuses.
    let sw: ptr<f64> = array_new_f64(m + 8)
    let mut separable: bool = true
    for i in 0 to m {
        let zi: f64 = zbuf[i]
        sw[i] = sqrt(lin458_variance_f64(zi))
        if y[i] == positive {
            if zi <= 0.0 { separable = false }
        } else {
            if zi >= 0.0 { separable = false }
        }
    }

    if separable {
        array_free_f64(zbuf)
        array_free_f64(sw)
        let bad5: LogisticInference = lin458_empty(n, d, 0, true, true)
        return bad5
    }

    # A = diag(sqrt(v)) * [X | 1], so that A^T A is the observed information.
    let A: ptr<f64> = malloc((m as i64) * (d as i64) * 8 + 128) as ptr<f64>
    let rhs: ptr<f64> = array_new_f64(m + 8)
    for i in 0 to m {
        let base: i32 = i * stride
        let dst: i32 = i * d
        let s: f64 = sw[i]
        for j in 0 to n {
            A[dst + j] = s * (xdata[base + j] as f64)
        }
        A[dst + n] = s
        rhs[i] = 0.0
    }

    # Leaves R, the triangular factor of A, in the upper triangle of A. rhs is
    # the zero vector and its solution is discarded; only R is wanted.
    _solve_lstsq_qr(A, rhs, m, d)

    let mut maxdiag: f64 = 0.0
    for j in 0 to d {
        let dj: f64 = fabs(A[j * d + j])
        if dj > maxdiag { maxdiag = dj }
    }
    let mut tol: f64 = 0.00000000001 * maxdiag
    if tol < 0.000000000000001 { tol = 0.000000000000001 }

    let Z: ptr<f64> = array_new_f64(d * d + 16)
    let rank: i32 = lin353_invert_upper(A, Z, d, tol)

    if rank < d {
        array_free_f64(zbuf)
        array_free_f64(sw)
        free(A as ptr<void>)
        array_free_f64(rhs)
        array_free_f64(Z)
        let bad6: LogisticInference = lin458_empty(n, d, rank, true, false)
        return bad6
    }

    # cov = (A^T A)^-1 = Z Z^T, symmetric.
    let cov: ptr<f32> = array_new_f32(d * d + 16)
    let se: ptr<f32> = array_new_f32(d + 8)
    let zs: ptr<f32> = array_new_f32(d + 8)
    for a in 0 to d {
        for b in 0 to d {
            let mut s: f64 = 0.0
            for k in 0 to d {
                s = s + Z[a * d + k] * Z[b * d + k]
            }
            cov[a * d + b] = s as f32
        }
    }

    for j in 0 to d {
        let v: f32 = cov[j * d + j]
        let mut sj: f32 = 0.0
        if v > 0.0 { sj = sqrt((v as f64)) as f32 }
        se[j] = sj
        let mut coef: f32 = bias
        if j < n { coef = w[j] }
        if sj > 0.0 {
            zs[j] = coef / sj
        } else {
            zs[j] = 0.0
        }
    }

    array_free_f64(zbuf)
    array_free_f64(sw)
    free(A as ptr<void>)
    array_free_f64(rhs)
    array_free_f64(Z)

    return LogisticInference {
        cov: cov,
        std_errors: se,
        z_stats: zs,
        n_features: n,
        n_params: d,
        n_samples: m,
        rank: rank,
        rank_deficient: false,
        separable: false,
        fitted: true
    }
}

# Standard error of coefficient j. j in 0..n_features-1 is a slope, j ==
# n_features is the intercept.
export function logistic_inference_std_error(inf: LogisticInference, j: i32) -> f32 {
    if j < 0 || j >= inf.n_params { return 0.0 }
    return inf.std_errors[j]
}

# z statistic of coefficient j against the null that it is zero. The logistic
# analogue of ols_inference_t_stat: the reference distribution is normal, not
# t, because the variance is not estimated separately from the coefficients.
export function logistic_inference_z_stat(inf: LogisticInference, j: i32) -> f32 {
    if j < 0 || j >= inf.n_params { return 0.0 }
    return inf.z_stats[j]
}

# Entry (a, b) of the coefficient covariance matrix.
export function logistic_inference_cov(inf: LogisticInference, a: i32, b: i32) -> f32 {
    if a < 0 || a >= inf.n_params { return 0.0 }
    if b < 0 || b >= inf.n_params { return 0.0 }
    return inf.cov[a * inf.n_params + b]
}

export function logistic_inference_free(inf: LogisticInference) -> void {
    array_free_f32(inf.cov)
    array_free_f32(inf.std_errors)
    array_free_f32(inf.z_stats)
}

# ============================================================================
# Ridge Regression (L2-penalized linear regression with closed-form-ish GD)
# ============================================================================

export struct Ridge {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    fitted: bool
}

export function ridge_fit(X: Matrix, y: ptr<f32>, alpha: f32, epochs: i32, lr: f32) -> Ridge {
    let n: i32 = X.cols
    let m: i32 = X.rows

    # Center data in f64 for precision. X is contiguous row-major, so index
    # X.data directly; matrix_at copies the Matrix struct by value per element.
    let xdata: ptr<f32> = X.data
    let x_mean: ptr<f64> = array_new_f64(n)
    let mut y_mean: f64 = 0.0
    for i in 0 to m {
        y_mean = y_mean + (y[i] as f64)
        let base: i32 = i * n
        for j in 0 to n {
            x_mean[j] = x_mean[j] + (xdata[base + j] as f64)
        }
    }
    y_mean = y_mean / (m as f64)
    for j in 0 to n {
        x_mean[j] = x_mean[j] / (m as f64)
    }

    # Build XtX + alpha*I and Xty in f64 from centered data.
    # Each sample's centred row is built once, then its contribution to the
    # Gram matrix is one dger. The old triple loop recentred an element of X
    # through matrix_at inside the innermost step, so every row was recentred
    # n times over and the whole m * n * n product ran in scalar f64.
    #
    # dger is used per row rather than one dgemm over the whole centred design
    # on purpose. Element (j, k) of XtX still accumulates the same products in
    # the same ascending-i order, which keeps the coefficients bit-identical.
    # A single dgemm reassociates the sum and, while it agrees to about 1e-15
    # in f64, it moves the last f32 digit of a coefficient on near-collinear
    # and badly-scaled designs.
    let XtX: ptr<f64> = array_new_f64(n * n)
    let Xty: ptr<f64> = array_new_f64(n)
    let xrow: ptr<f64> = array_new_f64(n)
    for i in 0 to m {
        let base: i32 = i * n
        for j in 0 to n {
            xrow[j] = (xdata[base + j] as f64) - x_mean[j]
        }
        let yi: f64 = (y[i] as f64) - y_mean
        for j in 0 to n {
            Xty[j] = Xty[j] + xrow[j] * yi
        }
        blas_ger_ld_f64(XtX, n, n, n, xrow, 1, xrow, 1.0)
    }
    array_free_f64(xrow)

    # Add alpha * I (sklearn convention: alpha on diagonal, not alpha*m)
    let alpha_d: f64 = alpha as f64
    for j in 0 to n {
        XtX[j * n + j] = XtX[j * n + j] + alpha_d
    }

    # Solve (XtX + alpha*I) * w = Xty in f64.
    _solve_f64(XtX, Xty, n)

    # Recover bias in f64
    let mut bias_d: f64 = y_mean
    for j in 0 to n {
        bias_d = bias_d - x_mean[j] * Xty[j]
    }

    let weights: ptr<f32> = array_new_f32(n)
    for j in 0 to n {
        weights[j] = Xty[j] as f32
    }

    array_free_f64(x_mean)
    array_free_f64(XtX)
    array_free_f64(Xty)

    return Ridge { weights: weights, bias: bias_d as f32, n_features: n, alpha: alpha, fitted: true }
}

# Predictions are y = X * w + b. X is contiguous row-major, so the whole batch
# is one cblas_sgemv with the matrix row stride passed as lda; the previous loop
# called matrix_at once per element, which copies the Matrix struct by value on
# every access. The scalar f64 path is kept for the case where the model's
# feature count does not fit inside a row of X.
export function ridge_predict(model: Ridge, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return preds }

    let nf: i32 = model.n_features
    let bias: f32 = model.bias
    let w: ptr<f32> = model.weights

    if nf <= 0 || nf > X.cols {
        let data: ptr<f32> = X.data
        let stride: i32 = X.cols
        for i in 0 to rows {
            let base: i32 = i * stride
            let mut pred: f64 = bias as f64
            for j in 0 to nf {
                pred = pred + (w[j] as f64) * (data[base + j] as f64)
            }
            preds[i] = pred as f32
        }
        return preds
    }

    blas_matvec_ld(X.data, rows, nf, X.cols, w, preds, 1.0, 0.0)
    for i in 0 to rows {
        preds[i] = preds[i] + bias
    }
    return preds
}

export function ridge_free(model: Ridge) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# Lasso Regression (L1-penalized, uses soft-thresholding)
# ============================================================================

export struct Lasso {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    fitted: bool
}

# Coordinate-descent sweep over a Gram matrix.
#
# The residual r never appears. Instead the solver carries q = Xc^T r and
# updates it directly: when w_j moves by delta the residual moves by
# delta * Xc_j, so q moves by delta * G_j where G = Xc^T Xc. That turns one
# coordinate update from O(n_samples) into O(n_features), which is the whole
# point when n_samples >> n_features. rho_j = q_j + ||Xc_j||^2 * w_j, exactly
# the quantity the residual formulation computes.
#
# G is symmetric and stored row-major, so row j is contiguous. The diagonal is
# taken from col_sq so the two paths agree on it exactly.
function lasso_cd_gram_f64(gram: ptr<f64>, col_sq: ptr<f64>, q: ptr<f64>, w_d: ptr<f64>, n: i32, threshold: f64, epochs: i32) -> void {
    for epoch in 0 to epochs {
        let mut max_change: f64 = 0.0
        for j in 0 to n {
            if col_sq[j] < 0.0000000000000001 { continue }

            let rho: f64 = q[j] + col_sq[j] * w_d[j]

            let mut new_w: f64 = 0.0
            if rho > threshold {
                new_w = (rho - threshold) / col_sq[j]
            } elif rho < -threshold {
                new_w = (rho + threshold) / col_sq[j]
            }

            let delta: f64 = w_d[j] - new_w
            if delta != 0.0 {
                let gj: i32 = j * n
                for k in 0 to n {
                    q[k] = q[k] + delta * gram[gj + k]
                }
            }

            let change: f64 = new_w - w_d[j]
            let abs_change: f64 = fabs(change)
            if abs_change > max_change { max_change = abs_change }

            w_d[j] = new_w
        }

        if max_change < 0.0000000000000001 { break }
    }
}

# Coordinate-descent sweep over a materialized column-major centered matrix,
# maintaining the residual. Same values and same summation order as the
# original on-the-fly formulation; it only stops recomputing x_ij - mean_j on
# every visit and stops striding by n_features through a row-major buffer.
function lasso_cd_cols_f64(xc: ptr<f64>, col_sq: ptr<f64>, residual: ptr<f64>, w_d: ptr<f64>, n: i32, m: i32, threshold: f64, epochs: i32) -> void {
    for epoch in 0 to epochs {
        let mut max_change: f64 = 0.0
        for j in 0 to n {
            if col_sq[j] < 0.0000000000000001 { continue }
            let base: i32 = j * m

            let mut rho: f64 = 0.0
            for i in 0 to m {
                rho = rho + xc[base + i] * residual[i]
            }
            rho = rho + col_sq[j] * w_d[j]

            let mut new_w: f64 = 0.0
            if rho > threshold {
                new_w = (rho - threshold) / col_sq[j]
            } elif rho < -threshold {
                new_w = (rho + threshold) / col_sq[j]
            }

            let delta: f64 = w_d[j] - new_w
            if delta != 0.0 {
                for i in 0 to m {
                    residual[i] = residual[i] + delta * xc[base + i]
                }
            }

            let change: f64 = new_w - w_d[j]
            let abs_change: f64 = fabs(change)
            if abs_change > max_change { max_change = abs_change }

            w_d[j] = new_w
        }

        if max_change < 0.0000000000000001 { break }
    }
}

# Streaming fallback for matrices too large to materialize a centered f64 copy
# of. Byte-for-byte the original loop.
function lasso_cd_stream_f64(X: Matrix, x_mean: ptr<f64>, col_sq: ptr<f64>, residual: ptr<f64>, w_d: ptr<f64>, n: i32, m: i32, threshold: f64, epochs: i32) -> void {
    for epoch in 0 to epochs {
        let mut max_change: f64 = 0.0
        for j in 0 to n {
            if col_sq[j] < 0.0000000000000001 { continue }

            let mut rho: f64 = 0.0
            for i in 0 to m {
                let xc: f64 = (matrix_at(X, i, j) as f64) - x_mean[j]
                rho = rho + xc * residual[i]
            }
            rho = rho + col_sq[j] * w_d[j]

            let mut new_w: f64 = 0.0
            if rho > threshold {
                new_w = (rho - threshold) / col_sq[j]
            } elif rho < -threshold {
                new_w = (rho + threshold) / col_sq[j]
            }

            let delta: f64 = w_d[j] - new_w
            if delta != 0.0 {
                for i in 0 to m {
                    let xc: f64 = (matrix_at(X, i, j) as f64) - x_mean[j]
                    residual[i] = residual[i] + delta * xc
                }
            }

            let change: f64 = new_w - w_d[j]
            let abs_change: f64 = fabs(change)
            if abs_change > max_change { max_change = abs_change }

            w_d[j] = new_w
        }

        if max_change < 0.0000000000000001 { break }
    }
}

export function lasso_fit(X: Matrix, y: ptr<f32>, alpha: f32, epochs: i32, lr: f32) -> Lasso {
    let n: i32 = X.cols
    let m: i32 = X.rows

    # Center data in f64 for precision
    let x_mean: ptr<f64> = array_new_f64(n)
    let mut y_mean: f64 = 0.0
    for i in 0 to m {
        y_mean = y_mean + (y[i] as f64)
        for j in 0 to n {
            x_mean[j] = x_mean[j] + (matrix_at(X, i, j) as f64)
        }
    }
    y_mean = y_mean / (m as f64)
    for j in 0 to n {
        x_mean[j] = x_mean[j] / (m as f64)
    }

    # w_d and col_sq come from calloc, so they are already zero.
    let col_sq: ptr<f64> = array_new_f64(n)
    let w_d: ptr<f64> = array_new_f64(n)

    let alpha_d: f64 = alpha as f64
    let threshold: f64 = alpha_d * (m as f64)

    # A centered f64 copy of X costs 8 * n_samples * n_features bytes. Below the
    # cap it is always worth it; above it, fall back to recomputing on the fly.
    let cells: i64 = (m as i64) * (n as i64)
    let mut materialize: bool = true
    if cells > 8000000 { materialize = false }

    if materialize {
        # Centered columns, column-major, so a coordinate reads contiguously.
        # col_sq accumulates in ascending row order per column, which is the
        # order the original row-major pass used, so the sums are identical.
        let xc: ptr<f64> = array_new_f64(m * n)
        for j in 0 to n {
            let base: i32 = j * m
            let mj: f64 = x_mean[j]
            let mut acc: f64 = 0.0
            for i in 0 to m {
                let v: f64 = (matrix_at(X, i, j) as f64) - mj
                xc[base + i] = v
                acc = acc + v * v
            }
            col_sq[j] = acc
        }

        # The Gram path costs n_features^2 per sweep plus a one-off
        # n_samples * n_features^2 / 2 build, against 2 * n_samples *
        # n_features per sweep for the residual path. It wins whenever the
        # feature count is modest and there are enough sweeps to amortize the
        # build. n_features <= 512 also bounds the Gram matrix at 2 MB.
        let mut use_gram: bool = false
        if n <= 512 {
            if (epochs as i64) * 8 >= (n as i64) { use_gram = true }
        }

        if use_gram {
            let gram: ptr<f64> = array_new_f64(n * n)
            for j in 0 to n {
                let bj: i32 = j * m
                for k in j to n {
                    let bk: i32 = k * m
                    let mut acc: f64 = 0.0
                    for i in 0 to m {
                        acc = acc + xc[bj + i] * xc[bk + i]
                    }
                    gram[j * n + k] = acc
                    gram[k * n + j] = acc
                }
                gram[j * n + j] = col_sq[j]
            }

            # q = Xc^T r with r initialized to y - y_mean.
            let q: ptr<f64> = array_new_f64(n)
            for k in 0 to n {
                let bk: i32 = k * m
                let mut acc: f64 = 0.0
                for i in 0 to m {
                    acc = acc + xc[bk + i] * ((y[i] as f64) - y_mean)
                }
                q[k] = acc
            }

            lasso_cd_gram_f64(gram, col_sq, q, w_d, n, threshold, epochs)
            array_free_f64(gram)
            array_free_f64(q)
        } else {
            let residual: ptr<f64> = array_new_f64(m)
            for i in 0 to m {
                residual[i] = (y[i] as f64) - y_mean
            }
            lasso_cd_cols_f64(xc, col_sq, residual, w_d, n, m, threshold, epochs)
            array_free_f64(residual)
        }

        array_free_f64(xc)
    } else {
        for i in 0 to m {
            for j in 0 to n {
                let xcv: f64 = (matrix_at(X, i, j) as f64) - x_mean[j]
                col_sq[j] = col_sq[j] + xcv * xcv
            }
        }
        let residual: ptr<f64> = array_new_f64(m)
        for i in 0 to m {
            residual[i] = (y[i] as f64) - y_mean
        }
        lasso_cd_stream_f64(X, x_mean, col_sq, residual, w_d, n, m, threshold, epochs)
        array_free_f64(residual)
    }

    # Recover bias in f64
    let mut bias_d: f64 = y_mean
    for j in 0 to n {
        bias_d = bias_d - x_mean[j] * w_d[j]
    }

    let weights: ptr<f32> = array_new_f32(n)
    for j in 0 to n {
        weights[j] = w_d[j] as f32
    }

    array_free_f64(x_mean)
    array_free_f64(col_sq)
    array_free_f64(w_d)

    return Lasso { weights: weights, bias: bias_d as f32, n_features: n, alpha: alpha, fitted: true }
}

export function lasso_predict(model: Lasso, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut pred: f64 = model.bias as f64
        for j in 0 to model.n_features {
            pred = pred + (model.weights[j] as f64) * (matrix_at(X, i, j) as f64)
        }
        preds[i] = pred
    }
    return preds
}

export function lasso_free(model: Lasso) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# SGDClassifier (linear classifier with SGD, supports log/hinge loss)
# Addresses Issue #28394: predict returns probabilities, decide returns classes
# ============================================================================

export const SGD_LOSS_LOG: i32 = 0
export const SGD_LOSS_HINGE: i32 = 1
export const SGD_LOSS_MODIFIED_HUBER: i32 = 2

export struct SGDClassifier {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    classes: ptr<f32>,
    n_classes: i32,
    loss: i32,
    alpha: f32,
    fitted: bool
}

export function sgd_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, loss: i32, alpha: f32, epochs: i32, lr: f32) -> SGDClassifier {
    let n: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(n)
    let bias: f32 = 0.0

    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    for epoch in 0 to epochs {
        for i in 0 to X.rows {
            let mut z: f32 = bias
            for j in 0 to n {
                z = z + weights[j] * matrix_at(X, i, j)
            }

            let label: f32 = 0.0
            if y[i] == classes[1] {
                label = 1.0
            }

            let mut grad_z: f32 = 0.0
            if loss == SGD_LOSS_LOG {
                let p: f32 = sigmoid(z)
                grad_z = p - label
            } elif loss == SGD_LOSS_HINGE {
                let margin: f32 = label * 2.0 - 1.0
                if margin * z < 1.0 {
                    grad_z = -margin
                }
            } elif loss == SGD_LOSS_MODIFIED_HUBER {
                let margin: f32 = label * 2.0 - 1.0
                if margin * z < -1.0 {
                    grad_z = -4.0 * margin
                } elif margin * z < 1.0 {
                    grad_z = -2.0 * margin * (1.0 - margin * z)
                }
            }

            for j in 0 to n {
                weights[j] = weights[j] - lr * (grad_z * matrix_at(X, i, j) + alpha * weights[j])
            }
            bias = bias - lr * grad_z
        }
    }

    return SGDClassifier {
        weights: weights,
        bias: bias,
        n_features: n,
        classes: classes,
        n_classes: n_classes,
        loss: loss,
        alpha: alpha,
        fitted: true
    }
}

export function sgd_classifier_predict(model: SGDClassifier, X: Matrix) -> ptr<f32> {
    let probs: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut z: f32 = model.bias
        for j in 0 to model.n_features {
            z = z + model.weights[j] * matrix_at(X, i, j)
        }
        probs[i] = sigmoid(z)
    }
    return probs
}

export function sgd_classifier_decide(model: SGDClassifier, probs: ptr<f32>, n_samples: i32, threshold: f32) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(n_samples)
    for i in 0 to n_samples {
        if probs[i] >= threshold {
            labels[i] = model.classes[1]
        } else {
            labels[i] = model.classes[0]
        }
    }
    return labels
}

export function sgd_classifier_free(model: SGDClassifier) -> void {
    array_free_f32(model.weights)
    array_free_f32(model.classes)
}

# ============================================================================
# SGDRegressor (linear regression with SGD, supports squared/epsilon-insensitive)
# ============================================================================

export const SGD_REG_LOSS_SQUARED: i32 = 0
export const SGD_REG_LOSS_HUBER: i32 = 1
export const SGD_REG_LOSS_EPSILON_INSENSITIVE: i32 = 2

export struct SGDRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    epsilon: f32,
    loss: i32,
    fitted: bool
}

export function sgd_regressor_fit(X: Matrix, y: ptr<f32>, loss: i32, alpha: f32, epsilon: f32, epochs: i32, lr: f32) -> SGDRegressor {
    let n: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(n)
    let bias: f32 = 0.0

    for epoch in 0 to epochs {
        for i in 0 to X.rows {
            let mut pred: f32 = bias
            for j in 0 to n {
                pred = pred + weights[j] * matrix_at(X, i, j)
            }
            let err: f32 = pred - y[i]

            let mut grad_z: f32 = 0.0
            if loss == SGD_REG_LOSS_SQUARED {
                grad_z = err
            } elif loss == SGD_REG_LOSS_HUBER {
                if err > epsilon {
                    grad_z = 1.0
                } elif err < -epsilon {
                    grad_z = -1.0
                } else {
                    grad_z = err / epsilon
                }
            } elif loss == SGD_REG_LOSS_EPSILON_INSENSITIVE {
                if err > epsilon {
                    grad_z = 1.0
                } elif err < -epsilon {
                    grad_z = -1.0
                }
            }

            for j in 0 to n {
                weights[j] = weights[j] - lr * (grad_z * matrix_at(X, i, j) + alpha * weights[j])
            }
            bias = bias - lr * grad_z
        }
    }

    return SGDRegressor {
        weights: weights,
        bias: bias,
        n_features: n,
        alpha: alpha,
        epsilon: epsilon,
        loss: loss,
        fitted: true
    }
}

export function sgd_regressor_predict(model: SGDRegressor, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut pred: f32 = model.bias
        for j in 0 to model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
        }
        preds[i] = pred
    }
    return preds
}

export function sgd_regressor_free(model: SGDRegressor) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# MultiClassLogisticRegression (softmax regression)
# Fits one joint softmax over all classes, the same objective as
# lin433_multinomial_fit, but with plain gradient descent rather than LBFGS.
# Addresses Issue #28394: predict returns probabilities, decide returns classes.
# ============================================================================

export struct MultiClassLogisticRegression {
    weights: ptr<ptr<f32> >,
    bias: ptr<f32>,
    n_features: i32,
    classes: ptr<f32>,
    n_classes: i32,
    penalty: Penalty,
    fitted: bool
}

export function multiclass_logistic_fit(X: Matrix, y: ptr<f32>, n_classes: i32, epochs: i32, lr: f32, penalty: Penalty) -> MultiClassLogisticRegression {
    let n: i32 = X.cols

    # Issue #398: this used to append at classes[n_found] with no check against
    # n_classes, which wrote past the allocation whenever y carried more
    # distinct labels than the caller declared.
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values
    let n_found: i32 = found_classes.count

    let weights: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let bias: ptr<f32> = array_new_f32(n_classes)

    for c in 0 to n_classes {
        weights[c] = array_new_f32(n)
    }

    for epoch in 0 to epochs {
        let grads: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
        let grad_b: ptr<f32> = array_new_f32(n_classes)
        for c in 0 to n_classes {
            grads[c] = array_new_f32(n)
        }

        for i in 0 to X.rows {
            let logits: ptr<f32> = array_new_f32(n_classes)
            for c in 0 to n_classes {
                let mut z: f32 = bias[c]
                for j in 0 to n {
                    z = z + weights[c][j] * matrix_at(X, i, j)
                }
                logits[c] = z
            }

            let probs: ptr<f32> = _softmax_probs(logits, n_classes)

            let true_c: i32 = 0
            for c in 0 to n_classes {
                if classes[c] == y[i] {
                    true_c = c
                }
            }

            for c in 0 to n_classes {
                let err: f32 = probs[c]
                if c == true_c {
                    err = err - 1.0
                }
                for j in 0 to n {
                    grads[c][j] = grads[c][j] + err * matrix_at(X, i, j)
                }
                grad_b[c] = grad_b[c] + err
            }

            array_free_f32(logits)
            array_free_f32(probs)
        }

        let inv_n: f32 = 1.0 / (X.rows as f32)
        for c in 0 to n_classes {
            for j in 0 to n {
                let g: f32 = grads[c][j] * inv_n
                if penalty.kind == PENALTY_L2 || penalty.kind == PENALTY_ELASTICNET {
                    g = g + penalty.alpha * weights[c][j] * (1.0 - penalty.l1_ratio)
                }
                weights[c][j] = weights[c][j] - lr * g
            }
            bias[c] = bias[c] - lr * grad_b[c] * inv_n
            array_free_f32(grads[c])
        }
        free(grads as ptr<void>)
        array_free_f32(grad_b)
    }

    return MultiClassLogisticRegression {
        weights: weights,
        bias: bias,
        n_features: n,
        classes: classes,
        n_classes: n_classes,
        penalty: penalty,
        fitted: true
    }
}

function _softmax_probs(logits: ptr<f32>, n: i32) -> ptr<f32> {
    let mut max_val: f32 = logits[0]
    for i in 1 to n {
        if logits[i] > max_val {
            max_val = logits[i]
        }
    }

    let probs: ptr<f32> = array_new_f32(n)
    let mut sum: f32 = 0.0
    for i in 0 to n {
        probs[i] = exp((logits[i] - max_val) as f64) as f32
        sum = sum + probs[i]
    }
    for i in 0 to n {
        probs[i] = probs[i] / sum
    }
    return probs
}

export function multiclass_logistic_predict(model: MultiClassLogisticRegression, X: Matrix) -> Matrix {
    let probs: Matrix = matrix_new(X.rows, model.n_classes)
    for i in 0 to X.rows {
        let logits: ptr<f32> = array_new_f32(model.n_classes)
        for c in 0 to model.n_classes {
            let mut z: f32 = model.bias[c]
            for j in 0 to model.n_features {
                z = z + model.weights[c][j] * matrix_at(X, i, j)
            }
            logits[c] = z
        }
        let p: ptr<f32> = _softmax_probs(logits, model.n_classes)
        for c in 0 to model.n_classes {
            matrix_set(probs, i, c, p[c])
        }
        array_free_f32(logits)
        array_free_f32(p)
    }
    return probs
}

export function multiclass_logistic_decide(model: MultiClassLogisticRegression, probs: Matrix) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(probs.rows)
    for i in 0 to probs.rows {
        let mut best_c: i32 = 0
        let mut best_p: f32 = matrix_at(probs, i, 0)
        for c in 1 to model.n_classes {
            let p: f32 = matrix_at(probs, i, c)
            if p > best_p {
                best_p = p
                best_c = c
            }
        }
        labels[i] = model.classes[best_c]
    }
    return labels
}

export function multiclass_logistic_free(model: MultiClassLogisticRegression) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.weights[c])
    }
    free(model.weights as ptr<void>)
    array_free_f32(model.bias)
    array_free_f32(model.classes)
}

# ============================================================================
# ElasticNet (L1 + L2 penalized regression)
# ============================================================================

export struct ElasticNet {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    l1_ratio: f32,
    fitted: bool
}

export function elastic_net_fit(X: Matrix, y: ptr<f32>, alpha: f32, l1_ratio: f32, epochs: i32, lr: f32) -> ElasticNet {
    let n: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(n)
    let bias: f32 = 0.0

    let l1: f32 = alpha * l1_ratio
    let l2: f32 = alpha * (1.0 - l1_ratio)

    for epoch in 0 to epochs {
        let grad_w: ptr<f32> = array_new_f32(n)
        let mut grad_b: f32 = 0.0

        for i in 0 to X.rows {
            let mut pred: f32 = bias
            for j in 0 to n {
                pred = pred + weights[j] * matrix_at(X, i, j)
            }
            let err: f32 = pred - y[i]
            for j in 0 to n {
                grad_w[j] = grad_w[j] + err * matrix_at(X, i, j)
            }
            grad_b = grad_b + err
        }

        let inv_n: f32 = 1.0 / (X.rows as f32)
        for j in 0 to n {
            grad_w[j] = grad_w[j] * inv_n + l2 * weights[j]
            weights[j] = weights[j] - lr * grad_w[j]
            if weights[j] > l1 {
                weights[j] = weights[j] - l1
            } elif weights[j] < -l1 {
                weights[j] = weights[j] + l1
            } else {
                weights[j] = 0.0
            }
        }
        bias = bias - lr * grad_b * inv_n
        array_free_f32(grad_w)
    }

    return ElasticNet {
        weights: weights,
        bias: bias,
        n_features: n,
        alpha: alpha,
        l1_ratio: l1_ratio,
        fitted: true
    }
}

# Predictions are y = X * w + b over a contiguous row-major X. The old loop
# called matrix_at once per element, and matrix_at takes the Matrix struct by
# value, so every element access copied the struct.
#
# Above a work threshold the whole batch is one cblas_sgemv with the row stride
# passed as lda, then an add of the bias. Below it the scalar kernel runs, with
# matrix_at replaced by the identical row-major index it computes, so small
# batches stay bit-identical to the previous code and avoid the ~0.1 ms OpenBLAS
# thread dispatch. 65536 is the same rows * features product KMeans uses; at
# that size the scalar kernel is already ~0.08 ms per call, so the dispatch no
# longer dominates.
export function elastic_net_predict(model: ElasticNet, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let preds: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return preds }

    let nf: i32 = model.n_features
    let bias: f32 = model.bias
    let w: ptr<f32> = model.weights
    let data: ptr<f32> = X.data
    let stride: i32 = X.cols

    if nf > 0 && nf <= stride && rows * nf >= 65536 {
        blas_matvec_ld(data, rows, nf, stride, w, preds, 1.0, 0.0)
        for i in 0 to rows {
            preds[i] = preds[i] + bias
        }
        return preds
    }

    for i in 0 to rows {
        let base: i32 = i * stride
        let mut pred: f32 = bias
        for j in 0 to nf {
            pred = pred + w[j] * data[base + j]
        }
        preds[i] = pred
    }
    return preds
}

export function elastic_net_free(model: ElasticNet) -> void {
    array_free_f32(model.weights)
}

export struct RidgeClassifier {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    threshold: f32,
    fitted: bool
}

export function ridge_classifier_fit(X: Matrix, y: ptr<f32>, alpha: f32, epochs: i32, lr: f32) -> RidgeClassifier {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    for _ in 0 to epochs {
        let grad_w: ptr<f32> = array_new_f32(p)
        let mut grad_b: f32 = 0.0

        for i in 0 to n {
            let mut pred: f32 = bias
            for j in 0 to p {
                pred = pred + weights[j] * matrix_at(X, i, j)
            }
            let error: f32 = pred - y[i]
            for j in 0 to p {
                grad_w[j] = grad_w[j] + error * matrix_at(X, i, j)
            }
            grad_b = grad_b + error
        }

        for j in 0 to p {
            grad_w[j] = (grad_w[j] + alpha * weights[j]) / (n as f32)
            weights[j] = weights[j] - lr * grad_w[j]
        }
        bias = bias - lr * grad_b / (n as f32)
        array_free_f32(grad_w)
    }

    return RidgeClassifier {
        weights: weights,
        bias: bias,
        n_features: p,
        threshold: 0.5,
        fitted: true
    }
}

export function ridge_classifier_predict(model: RidgeClassifier, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut pred: f32 = model.bias
        for j in 0 to model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
        }
        if pred > model.threshold {
            result[i] = 1.0
        } else {
            result[i] = 0.0
        }
    }

    return result
}

export function ridge_classifier_decision_function(model: RidgeClassifier, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut pred: f32 = model.bias
        for j in 0 to model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = pred
    }

    return result
}

export function ridge_classifier_free(model: RidgeClassifier) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# HuberRegressor
# ============================================================================

export struct HuberRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    epsilon: f32,
    n_iter: i32,
    fitted: bool
}

export function huber_regressor_fit(X: Matrix, y: ptr<f32>, epsilon: f32, max_iter: i32, lr: f32) -> HuberRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    let mut delta: f32 = 1.0

    for iter in 0 to max_iter {
        let residuals: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            let mut pred: f32 = bias
            for j in 0 to p {
                pred = pred + weights[j] * matrix_at(X, i, j)
            }
            residuals[i] = y[i] - pred
        }

        let mut abs_resid: ptr<f32> = array_copy_f32(residuals, n)
        for i in 0 to n {
            abs_resid[i] = fabs((abs_resid[i]) as f64) as f32
        }

        for i in 1 to n {
            let key: f32 = abs_resid[i]
            let mut j: i32 = i - 1
            while j >= 0 && abs_resid[j] > key {
                abs_resid[j + 1] = abs_resid[j]
                j = j - 1
            }
            abs_resid[j + 1] = key
        }

        let q: f32 = abs_resid[n / 2]
        delta = q * epsilon

        array_free_f32(abs_resid)

        let grad_w: ptr<f32> = array_new_f32(p)
        let mut grad_b: f32 = 0.0

        for i in 0 to n {
            let r: f32 = residuals[i]
            let ar: f32 = fabs((r) as f64) as f32
            let mut scale: f32 = 1.0
            if ar > delta {
                scale = delta / ar
            }
            for j in 0 to p {
                grad_w[j] = grad_w[j] - r * scale * matrix_at(X, i, j)
            }
            grad_b = grad_b - r * scale
        }

        for j in 0 to p {
            weights[j] = weights[j] - lr * grad_w[j] / (n as f32)
        }
        bias = bias - lr * grad_b / (n as f32)

        array_free_f32(grad_w)
        array_free_f32(residuals)
    }

    return HuberRegressor {
        weights: weights, bias: bias,
        n_features: p, epsilon: epsilon,
        n_iter: max_iter, fitted: true
    }
}

# Same y = X * w + b batch as elastic_net_predict: one cblas_sgemv with the row
# stride passed as lda above the 65536 rows * features work threshold, and the
# scalar kernel with matrix_at folded into a direct row-major index below it.
export function huber_regressor_predict(model: HuberRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    if n <= 0 { return result }

    let nf: i32 = model.n_features
    let bias: f32 = model.bias
    let w: ptr<f32> = model.weights
    let data: ptr<f32> = X.data
    let stride: i32 = X.cols

    if nf > 0 && nf <= stride && n * nf >= 65536 {
        blas_matvec_ld(data, n, nf, stride, w, result, 1.0, 0.0)
        for i in 0 to n {
            result[i] = result[i] + bias
        }
        return result
    }

    for i in 0 to n {
        let base: i32 = i * stride
        let mut pred: f32 = bias
        for j in 0 to nf {
            pred = pred + w[j] * data[base + j]
        }
        result[i] = pred
    }
    return result
}

export function huber_regressor_free(model: HuberRegressor) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# BayesianRidge
# ============================================================================

export struct BayesianRidge {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    beta: f32,
    n_iter: i32,
    fitted: bool
}

export function bayesian_ridge_fit(X: Matrix, y: ptr<f32>, max_iter: i32, tol: f32) -> BayesianRidge {
    let n: i32 = X.rows
    let p: i32 = X.cols

    # Center y and X
    let y_mean: f32 = array_mean(y, n)
    let x_mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        x_mean[j] = 0.0
        for i in 0 to n {
            x_mean[j] = x_mean[j] + matrix_at(X, i, j)
        }
        x_mean[j] = x_mean[j] / (n as f32)
    }

    let yc: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        yc[i] = y[i] - y_mean
    }

    let mut alpha: f32 = 1.0
    let mut beta: f32 = 1.0
    let weights: ptr<f32> = array_new_f32(p)

    for iter in 0 to max_iter {
        # Compute weights = (beta * XtX + alpha * I)^-1 * beta * Xty
        # Build (p x p) matrix A = beta * XtX + alpha * I
        let A: ptr<f32> = array_new_f32(p * p)
        for j1 in 0 to p {
            for j2 in 0 to p {
                let mut sum: f32 = 0.0
                for i in 0 to n {
                    let xj1: f32 = matrix_at(X, i, j1) - x_mean[j1]
                    let xj2: f32 = matrix_at(X, i, j2) - x_mean[j2]
                    sum = sum + xj1 * xj2
                }
                A[j1 * p + j2] = beta * sum
            }
            A[j1 * p + j1] = A[j1 * p + j1] + alpha
        }

        # Build b = beta * Xty
        let b_vec: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            let mut sum: f32 = 0.0
            for i in 0 to n {
                let xj: f32 = matrix_at(X, i, j) - x_mean[j]
                sum = sum + xj * yc[i]
            }
            b_vec[j] = beta * sum
        }

        # Solve A * w = b_vec via Gaussian elimination
        let A_copy: ptr<f32> = array_new_f32(p * p)
        for k in 0 to p * p {
            A_copy[k] = A[k]
        }
        for col in 0 to p {
            let pivot: f32 = A_copy[col * p + col]
            let abs_pivot: f32 = fabs(pivot as f64) as f32
            if abs_pivot < 0.000000000001 {
                continue
            }
            for j in 0 to p {
                A_copy[col * p + j] = A_copy[col * p + j] / pivot
            }
            b_vec[col] = b_vec[col] / pivot
            for row in 0 to p {
                if row == col { continue }
                let factor: f32 = A_copy[row * p + col]
                for j in 0 to p {
                    A_copy[row * p + j] = A_copy[row * p + j] - factor * A_copy[col * p + j]
                }
                b_vec[row] = b_vec[row] - factor * b_vec[col]
            }
        }

        for j in 0 to p {
            weights[j] = b_vec[j]
        }

        array_free_f32(A)
        array_free_f32(A_copy)

        # Update alpha and beta
        let mut ss_res: f32 = 0.0
        for i in 0 to n {
            let mut pred: f32 = 0.0
            for j in 0 to p {
                let xj: f32 = matrix_at(X, i, j) - x_mean[j]
                pred = pred + weights[j] * xj
            }
            let d: f32 = yc[i] - pred
            ss_res = ss_res + d * d
        }

        let mut w_sq: f32 = 0.0
        for j in 0 to p {
            w_sq = w_sq + weights[j] * weights[j]
        }

        let new_alpha: f32 = (p as f32) / (w_sq + 0.0000000001)
        let new_beta: f32 = (n as f32) / (ss_res + 0.0000000001)

        let da: f32 = fabs((alpha - new_alpha) as f64) as f32
        let db: f32 = fabs((beta - new_beta) as f64) as f32
        alpha = new_alpha
        beta = new_beta

        array_free_f32(b_vec)

        if da < tol && db < tol {
            break
        }
    }

    # Compute bias
    let mut bias: f32 = y_mean
    for j in 0 to p {
        bias = bias - weights[j] * x_mean[j]
    }

    array_free_f32(x_mean)
    array_free_f32(yc)

    return BayesianRidge {
        weights: weights, bias: bias,
        n_features: p,
        alpha: alpha, beta: beta,
        n_iter: max_iter, fitted: true
    }
}

export function bayesian_ridge_predict(model: BayesianRidge, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut pred: f32 = model.bias
        for j in 0 to model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = pred
    }
    return result
}

export function bayesian_ridge_free(model: BayesianRidge) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# RANSACRegressor
# ============================================================================

export struct RANSACRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_inliers: i32,
    inlier_mask: ptr<bool>,
    n_iter: i32,
    fitted: bool
}

export function ransac_regressor_fit(X: Matrix, y: ptr<f32>, min_samples: i32, max_trials: i32, residual_threshold: f32, seed: i32) -> RANSACRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    srand(seed)

    let best_weights: ptr<f32> = array_new_f32(p)
    let best_bias: f32 = 0.0
    let mut best_inliers: i32 = 0
    let best_mask: ptr<bool> = calloc((n as i64), 1) as ptr<bool>
    let mut best_iter: i32 = 0

    for trial in 0 to max_trials {
        let sample_indices: ptr<i32> = malloc((min_samples as i64) * 4) as ptr<i32>
        for i in 0 to min_samples {
            sample_indices[i] = rand() % n
        }

        let sub_X: Matrix = matrix_new(min_samples, p)
        let sub_y: ptr<f32> = array_new_f32(min_samples)
        for i in 0 to min_samples {
            for j in 0 to p {
                matrix_set(sub_X, i, j, matrix_at(X, sample_indices[i], j))
            }
            sub_y[i] = y[sample_indices[i]]
        }

        let model: LinearRegression = linear_regression_fit(sub_X, sub_y, penalty_none())
        let preds: ptr<f32> = linear_regression_predict(model, X)

        let mask: ptr<bool> = calloc((n as i64), 1) as ptr<bool>
        let mut n_inliers: i32 = 0
        for i in 0 to n {
            let residual: f32 = fabs((y[i] - preds[i]) as f64) as f32
            if residual < residual_threshold {
                mask[i] = true
                n_inliers = n_inliers + 1
            }
        }

        if n_inliers > best_inliers {
            best_inliers = n_inliers
            for j in 0 to p { best_weights[j] = model.weights[j] }
            best_bias = model.bias
            for i in 0 to n { best_mask[i] = mask[i] }
            best_iter = trial + 1
        }

        free(sample_indices as ptr<void>)
        matrix_free(sub_X)
        array_free_f32(sub_y)
        linear_regression_free(model)
        array_free_f32(preds)
        free(mask as ptr<void>)
    }

    let inlier_X: Matrix = matrix_new(best_inliers, p)
    let inlier_y: ptr<f32> = array_new_f32(best_inliers)
    let mut idx: i32 = 0
    for i in 0 to n {
        if best_mask[i] {
            for j in 0 to p {
                matrix_set(inlier_X, idx, j, matrix_at(X, i, j))
            }
            inlier_y[idx] = y[i]
            idx = idx + 1
        }
    }

    let final_model: LinearRegression = linear_regression_fit(inlier_X, inlier_y, penalty_none())
    for j in 0 to p { best_weights[j] = final_model.weights[j] }
    best_bias = final_model.bias

    matrix_free(inlier_X)
    array_free_f32(inlier_y)
    linear_regression_free(final_model)

    return RANSACRegressor {
        weights: best_weights,
        bias: best_bias,
        n_features: p,
        n_inliers: best_inliers,
        inlier_mask: best_mask,
        n_iter: best_iter,
        fitted: true
    }
}

export function ransac_regressor_predict(model: RANSACRegressor, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut s: f32 = model.bias
        for j in 0 to model.n_features {
            s = s + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = s
    }
    return result
}

export function ransac_regressor_free(model: RANSACRegressor) -> void {
    array_free_f32(model.weights)
    free(model.inlier_mask as ptr<void>)
}

# ============================================================================
# TheilSenRegressor
# ============================================================================

export struct TheilSenRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    fitted: bool
}

export function theil_sen_regressor_fit(X: Matrix, y: ptr<f32>, n_subsamples: i32, max_iter: i32, seed: i32) -> TheilSenRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    srand(seed)

    let slopes: ptr<ptr<f32> > = malloc((max_iter as i64) * 8) as ptr<ptr<f32> >
    let intercepts: ptr<f32> = array_new_f32(max_iter)
    let mut n_estimates: i32 = 0

    for trial in 0 to max_iter {
        let indices: ptr<i32> = malloc((n_subsamples as i64) * 4) as ptr<i32>
        for i in 0 to n_subsamples {
            indices[i] = rand() % n
        }

        let sub_X: Matrix = matrix_new(n_subsamples, p)
        let sub_y: ptr<f32> = array_new_f32(n_subsamples)
        for i in 0 to n_subsamples {
            for j in 0 to p {
                matrix_set(sub_X, i, j, matrix_at(X, indices[i], j))
            }
            sub_y[i] = y[indices[i]]
        }

        let model: LinearRegression = linear_regression_fit(sub_X, sub_y, penalty_none())
        slopes[n_estimates] = array_copy_f32(model.weights, p)
        intercepts[n_estimates] = model.bias
        n_estimates = n_estimates + 1

        free(indices as ptr<void>)
        matrix_free(sub_X)
        array_free_f32(sub_y)
        linear_regression_free(model)
    }

    let weights: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let vals: ptr<f32> = array_new_f32(n_estimates)
        for i in 0 to n_estimates { vals[i] = slopes[i][j] }
        for a in 0 to n_estimates {
            for b in 0 to n_estimates - 1 - a {
                if vals[b] > vals[b + 1] {
                    let t: f32 = vals[b]
                    vals[b] = vals[b + 1]
                    vals[b + 1] = t
                }
            }
        }
        weights[j] = vals[n_estimates / 2]
        array_free_f32(vals)
    }

    let sorted_intercepts: ptr<f32> = array_copy_f32(intercepts, n_estimates)
    for a in 0 to n_estimates {
        for b in 0 to n_estimates - 1 - a {
            if sorted_intercepts[b] > sorted_intercepts[b + 1] {
                let t: f32 = sorted_intercepts[b]
                sorted_intercepts[b] = sorted_intercepts[b + 1]
                sorted_intercepts[b + 1] = t
            }
        }
    }
    let bias: f32 = sorted_intercepts[n_estimates / 2]

    for i in 0 to n_estimates { array_free_f32(slopes[i]) }
    free(slopes as ptr<void>)
    array_free_f32(intercepts)
    array_free_f32(sorted_intercepts)

    return TheilSenRegressor {
        weights: weights,
        bias: bias,
        n_features: p,
        fitted: true
    }
}

export function theil_sen_regressor_predict(model: TheilSenRegressor, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut s: f32 = model.bias
        for j in 0 to model.n_features {
            s = s + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = s
    }
    return result
}

export function theil_sen_regressor_free(model: TheilSenRegressor) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# Perceptron
# ============================================================================

export struct Perceptron {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_iter: i32,
    fitted: bool
}

export function perceptron_fit(X: Matrix, y: ptr<f32>, n_iter: i32, lr: f32, seed: i32) -> Perceptron {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    for iter in 0 to n_iter {
        for i in 0 to n {
            let mut z: f32 = bias
            for j in 0 to p {
                z = z + weights[j] * matrix_at(X, i, j)
            }
            let pred: f32 = 1.0
            if z <= 0.0 { pred = -1.0 }
            let target: f32 = y[i]
            if target == 0.0 { target = -1.0 }

            if pred != target {
                for j in 0 to p {
                    weights[j] = weights[j] + lr * target * matrix_at(X, i, j)
                }
                bias = bias + lr * target
            }
        }
    }

    return Perceptron {
        weights: weights,
        bias: bias,
        n_features: p,
        n_iter: n_iter,
        fitted: true
    }
}

export function perceptron_predict(model: Perceptron, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut z: f32 = model.bias
        for j in 0 to model.n_features {
            z = z + model.weights[j] * matrix_at(X, i, j)
        }
        if z > 0.0 { result[i] = 1.0 } else { result[i] = 0.0 }
    }
    return result
}

export function perceptron_free(model: Perceptron) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# PassiveAggressiveClassifier
# ============================================================================

export struct PassiveAggressiveClassifier {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_iter: i32,
    C: f32,
    fitted: bool
}

export function passive_aggressive_classifier_fit(X: Matrix, y: ptr<f32>, n_iter: i32, C: f32) -> PassiveAggressiveClassifier {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    for iter in 0 to n_iter {
        for i in 0 to n {
            let mut z: f32 = bias
            for j in 0 to p {
                z = z + weights[j] * matrix_at(X, i, j)
            }
            let target: f32 = y[i]
            if target == 0.0 { target = -1.0 }
            let loss: f32 = 1.0 - target * z
            if loss > 0.0 {
                let norm_sq: f32 = 1.0
                for j in 0 to p {
                    norm_sq = norm_sq + matrix_at(X, i, j) * matrix_at(X, i, j)
                }
                let tau: f32 = loss / norm_sq
                if C < tau { tau = C }
                for j in 0 to p {
                    weights[j] = weights[j] + tau * target * matrix_at(X, i, j)
                }
                bias = bias + tau * target
            }
        }
    }

    return PassiveAggressiveClassifier {
        weights: weights,
        bias: bias,
        n_features: p,
        n_iter: n_iter,
        C: C,
        fitted: true
    }
}

export function passive_aggressive_classifier_predict(model: PassiveAggressiveClassifier, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut z: f32 = model.bias
        for j in 0 to model.n_features {
            z = z + model.weights[j] * matrix_at(X, i, j)
        }
        if z > 0.0 { result[i] = 1.0 } else { result[i] = 0.0 }
    }
    return result
}

export function passive_aggressive_classifier_free(model: PassiveAggressiveClassifier) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# Lars (Least Angle Regression)
# ============================================================================

export struct Lars {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_active: i32,
    active_features: ptr<i32>,
    fitted: bool
}

export function lars_fit(X: Matrix, y: ptr<f32>, n_features_to_select: i32) -> Lars {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean_x: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        mean_x[j] = s / (n as f32)
    }
    let mean_y: f32 = 0.0
    for i in 0 to n { mean_y = mean_y + y[i] }
    mean_y = mean_y / (n as f32)

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean_x[j])
        }
    }
    let yc: ptr<f32> = array_new_f32(n)
    for i in 0 to n { yc[i] = y[i] - mean_y }

    let active: ptr<i32> = malloc((n_features_to_select as i64) * 4) as ptr<i32>
    let inactive: ptr<bool> = calloc((p as i64), 1) as ptr<bool>
    for j in 0 to p { inactive[j] = true }

    let weights: ptr<f32> = array_new_f32(p)
    for j in 0 to p { weights[j] = 0.0 }

    for step in 0 to n_features_to_select {
        let mut best_j: i32 = -1
        let mut best_corr: f32 = 0.0
        for j in 0 to p {
            if not inactive[j] { continue }
            let mut corr: f32 = 0.0
            for i in 0 to n {
                corr = corr + matrix_at(Xc, i, j) * yc[i]
            }
            corr = fabs((corr) as f64) as f32
            if corr > best_corr {
                best_corr = corr
                best_j = j
            }
        }

        if best_j < 0 { break }
        active[step] = best_j
        inactive[best_j] = false

        let mut dot_xx: f32 = 0.0
        let mut dot_xy: f32 = 0.0
        for i in 0 to n {
            dot_xx = dot_xx + matrix_at(Xc, i, best_j) * matrix_at(Xc, i, best_j)
            dot_xy = dot_xy + matrix_at(Xc, i, best_j) * yc[i]
        }
        if dot_xx > 0.0000000001 {
            let coef: f32 = dot_xy / dot_xx
            weights[best_j] = coef
            for i in 0 to n {
                yc[i] = yc[i] - coef * matrix_at(Xc, i, best_j)
            }
        }
    }

    let bias: f32 = mean_y
    for j in 0 to p {
        bias = bias - weights[j] * mean_x[j]
    }

    matrix_free(Xc)
    array_free_f32(yc)
    array_free_f32(mean_x)
    free(inactive as ptr<void>)

    return Lars {
        weights: weights,
        bias: bias,
        n_features: p,
        n_active: n_features_to_select,
        active_features: active,
        fitted: true
    }
}

# Same y = X * w + b batch as elastic_net_predict: one cblas_sgemv with the row
# stride passed as lda above the 65536 rows * features work threshold, and the
# scalar kernel with matrix_at folded into a direct row-major index below it.
export function lars_predict(model: Lars, X: Matrix) -> ptr<f32> {
    let rows: i32 = X.rows
    let result: ptr<f32> = array_new_f32(rows)
    if rows <= 0 { return result }

    let nf: i32 = model.n_features
    let bias: f32 = model.bias
    let w: ptr<f32> = model.weights
    let data: ptr<f32> = X.data
    let stride: i32 = X.cols

    if nf > 0 && nf <= stride && rows * nf >= 65536 {
        blas_matvec_ld(data, rows, nf, stride, w, result, 1.0, 0.0)
        for i in 0 to rows {
            result[i] = result[i] + bias
        }
        return result
    }

    for i in 0 to rows {
        let base: i32 = i * stride
        let mut s: f32 = bias
        for j in 0 to nf {
            s = s + w[j] * data[base + j]
        }
        result[i] = s
    }
    return result
}

export function lars_free(model: Lars) -> void {
    array_free_f32(model.weights)
    free(model.active_features as ptr<void>)
}

# ============================================================================
# ARDRegression (Automatic Relevance Determination)
# ============================================================================

export struct ARDRegression {
    weights: ptr<f32>,
    bias: f32,
    alpha: ptr<f32>,
    beta: f32,
    n_features: i32,
    n_iter: i32,
    fitted: bool
}

export function ard_regression_fit(X: Matrix, y: ptr<f32>, max_iter: i32, tol: f32) -> ARDRegression {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean_x: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        mean_x[j] = s / (n as f32)
    }
    let mean_y: f32 = 0.0
    for i in 0 to n { mean_y = mean_y + y[i] }
    mean_y = mean_y / (n as f32)

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean_x[j])
        }
    }
    let yc: ptr<f32> = array_new_f32(n)
    for i in 0 to n { yc[i] = y[i] - mean_y }

    let alpha: ptr<f32> = array_new_f32(p)
    let mut beta: f32 = 1.0
    for j in 0 to p { alpha[j] = 1.0 }

    let weights: ptr<f32> = array_new_f32(p)
    for j in 0 to p { weights[j] = 0.0 }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1

        for j in 0 to p {
            let mut dot_xy: f32 = 0.0
            let mut dot_xx: f32 = 0.0
            for i in 0 to n {
                dot_xy = dot_xy + matrix_at(Xc, i, j) * yc[i]
                dot_xx = dot_xx + matrix_at(Xc, i, j) * matrix_at(Xc, i, j)
            }
            let gamma: f32 = beta * dot_xx / (beta * dot_xx + alpha[j])
            weights[j] = gamma * dot_xy / (dot_xx + alpha[j] / beta)

            let mut residual_sq: f32 = 0.0
            for i in 0 to n {
                let pred: f32 = weights[j] * matrix_at(Xc, i, j)
                residual_sq = residual_sq + (yc[i] - pred) * (yc[i] - pred)
            }
            alpha[j] = gamma / (weights[j] * weights[j] + 0.0000000001)
        }

        let mut ss_res: f32 = 0.0
        for i in 0 to n {
            let mut pred: f32 = 0.0
            for j in 0 to p {
                pred = pred + weights[j] * matrix_at(Xc, i, j)
            }
            ss_res = ss_res + (yc[i] - pred) * (yc[i] - pred)
        }
        beta = (n as f32 - p as f32) / (ss_res + 0.0000000001)

        if ss_res / (n as f32) < tol { break }
    }

    let bias: f32 = mean_y
    for j in 0 to p {
        bias = bias - weights[j] * mean_x[j]
    }

    matrix_free(Xc)
    array_free_f32(yc)
    array_free_f32(mean_x)

    return ARDRegression {
        weights: weights,
        bias: bias,
        alpha: alpha,
        beta: beta,
        n_features: p,
        n_iter: n_iter,
        fitted: true
    }
}

export function ard_regression_predict(model: ARDRegression, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut s: f32 = model.bias
        for j in 0 to model.n_features {
            s = s + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = s
    }
    return result
}

export function ard_regression_free(model: ARDRegression) -> void {
    array_free_f32(model.weights)
    array_free_f32(model.alpha)
}

# ============================================================================
# OrthogonalMatchingPursuit (greedy sparse approximation)
# ============================================================================

export struct OrthogonalMatchingPursuit {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_nonzero_coefs: i32,
    active_features: ptr<i32>,
    fitted: bool
}

export function orthogonal_matching_pursuit_fit(X: Matrix, y: ptr<f32>, n_nonzero_coefs: i32) -> OrthogonalMatchingPursuit {
    let n: i32 = X.rows
    let p: i32 = X.cols

    # Center X and y
    let mean_x: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        mean_x[j] = s / (n as f32)
    }
    let mean_y: f32 = 0.0
    for i in 0 to n { mean_y = mean_y + y[i] }
    mean_y = mean_y / (n as f32)

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean_x[j])
        }
    }
    let yc: ptr<f32> = array_new_f32(n)
    let residual: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        yc[i] = y[i] - mean_y
        residual[i] = y[i] - mean_y
    }

    let active: ptr<i32> = malloc((n_nonzero_coefs as i64) * 4) as ptr<i32>
    let selected: ptr<bool> = calloc((p as i64), 1) as ptr<bool>
    let weights: ptr<f32> = array_new_f32(p)
    for j in 0 to p { weights[j] = 0.0 }

    let mut n_active: i32 = 0
    for step in 0 to n_nonzero_coefs {
        # Find the atom most correlated with the residual
        let mut best_j: i32 = -1
        let mut best_corr: f32 = 0.0
        for j in 0 to p {
            if selected[j] { continue }
            let mut corr: f32 = 0.0
            for i in 0 to n {
                corr = corr + matrix_at(Xc, i, j) * residual[i]
            }
            corr = fabs((corr) as f64) as f32
            if corr > best_corr {
                best_corr = corr
                best_j = j
            }
        }

        if best_j < 0 { break }
        active[n_active] = best_j
        selected[best_j] = true
        n_active = n_active + 1

        # Solve least squares on the active set via normal equations
        # b_vec must use the original centered target, not the residual
        let k: i32 = n_active
        let A: ptr<f32> = array_new_f32(k * k)
        let b_vec: ptr<f32> = array_new_f32(k)

        for a in 0 to k {
            let ja: i32 = active[a]
            for b in 0 to k {
                let jb: i32 = active[b]
                let mut sum: f32 = 0.0
                for i in 0 to n {
                    sum = sum + matrix_at(Xc, i, ja) * matrix_at(Xc, i, jb)
                }
                A[a * k + b] = sum
            }
            let mut sum_b: f32 = 0.0
            for i in 0 to n {
                sum_b = sum_b + matrix_at(Xc, i, ja) * yc[i]
            }
            b_vec[a] = sum_b
        }

        # Gaussian elimination to solve A * coef = b_vec
        for col in 0 to k {
            let pivot: f32 = A[col * k + col]
            let abs_pivot: f32 = fabs((pivot) as f64) as f32
            if abs_pivot < 0.000000000001 {
                continue
            }
            for j in 0 to k {
                A[col * k + j] = A[col * k + j] / pivot
            }
            b_vec[col] = b_vec[col] / pivot
            for row in 0 to k {
                if row == col { continue }
                let factor: f32 = A[row * k + col]
                for j in 0 to k {
                    A[row * k + j] = A[row * k + j] - factor * A[col * k + j]
                }
                b_vec[row] = b_vec[row] - factor * b_vec[col]
            }
        }

        # Update weights and residual
        for j in 0 to p { weights[j] = 0.0 }
        for a in 0 to k {
            weights[active[a]] = b_vec[a]
        }
        for i in 0 to n {
            let mut pred: f32 = 0.0
            for a in 0 to k {
                pred = pred + b_vec[a] * matrix_at(Xc, i, active[a])
            }
            residual[i] = yc[i] - pred
        }

        array_free_f32(A)
        array_free_f32(b_vec)
    }

    let bias: f32 = mean_y
    for j in 0 to p {
        bias = bias - weights[j] * mean_x[j]
    }

    matrix_free(Xc)
    array_free_f32(yc)
    array_free_f32(residual)
    array_free_f32(mean_x)
    free(selected as ptr<void>)

    return OrthogonalMatchingPursuit {
        weights: weights,
        bias: bias,
        n_features: p,
        n_nonzero_coefs: n_active,
        active_features: active,
        fitted: true
    }
}

export function orthogonal_matching_pursuit_predict(model: OrthogonalMatchingPursuit, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut s: f32 = model.bias
        for j in 0 to model.n_features {
            s = s + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = s
    }
    return result
}

export function orthogonal_matching_pursuit_free(model: OrthogonalMatchingPursuit) -> void {
    array_free_f32(model.weights)
    free(model.active_features as ptr<void>)
}

# ============================================================================
# QuantileRegressor (pinball loss with gradient descent)
# ============================================================================

export struct QuantileRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    quantile: f32,
    alpha: f32,
    fitted: bool
}

export function quantile_regressor_fit(X: Matrix, y: ptr<f32>, quantile: f32, alpha: f32, epochs: i32, lr: f32) -> QuantileRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    for epoch in 0 to epochs {
        let grad_w: ptr<f32> = array_new_f32(p)
        let mut grad_b: f32 = 0.0

        for i in 0 to n {
            let mut pred: f32 = bias
            for j in 0 to p {
                pred = pred + weights[j] * matrix_at(X, i, j)
            }
            let r: f32 = y[i] - pred
            # Pinball loss gradient w.r.t. pred:
            #   if r > 0: dL/dpred = -quantile
            #   if r < 0: dL/dpred = (1.0 - quantile)
            let mut grad_z: f32 = 0.0 - quantile
            if r < 0.0 {
                grad_z = 1.0 - quantile
            }
            if r == 0.0 {
                grad_z = 0.0
            }

            for j in 0 to p {
                grad_w[j] = grad_w[j] + grad_z * matrix_at(X, i, j)
            }
            grad_b = grad_b + grad_z
        }

        let inv_n: f32 = 1.0 / (n as f32)
        for j in 0 to p {
            grad_w[j] = grad_w[j] * inv_n + alpha * weights[j]
            weights[j] = weights[j] - lr * grad_w[j]
        }
        bias = bias - lr * grad_b * inv_n
        array_free_f32(grad_w)
    }

    return QuantileRegressor {
        weights: weights,
        bias: bias,
        n_features: p,
        quantile: quantile,
        alpha: alpha,
        fitted: true
    }
}

export function quantile_regressor_predict(model: QuantileRegressor, X: Matrix) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(X.rows)
    for i in 0 to X.rows {
        let mut s: f32 = model.bias
        for j in 0 to model.n_features {
            s = s + model.weights[j] * matrix_at(X, i, j)
        }
        result[i] = s
    }
    return result
}

export function quantile_regressor_free(model: QuantileRegressor) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# MultiTaskLasso (L1 penalty across all tasks jointly)
# Y is a Matrix with shape (n_samples, n_tasks). Predict returns Matrix.
# ============================================================================

export struct MultiTaskLasso {
    weights: ptr<ptr<f32> >,
    bias: ptr<f32>,
    n_features: i32,
    n_tasks: i32,
    alpha: f32,
    fitted: bool
}

export function multitask_lasso_fit(X: Matrix, Y: Matrix, alpha: f32, epochs: i32, lr: f32) -> MultiTaskLasso {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let t: i32 = Y.cols

    let weights: ptr<ptr<f32> > = malloc((t as i64) * 8) as ptr<ptr<f32> >
    let bias: ptr<f32> = array_new_f32(t)
    for c in 0 to t {
        weights[c] = array_new_f32(p)
    }

    for epoch in 0 to epochs {
        let grads: ptr<ptr<f32> > = malloc((t as i64) * 8) as ptr<ptr<f32> >
        let grad_b: ptr<f32> = array_new_f32(t)
        for c in 0 to t {
            grads[c] = array_new_f32(p)
        }

        for i in 0 to n {
            for c in 0 to t {
                let mut pred: f32 = bias[c]
                for j in 0 to p {
                    pred = pred + weights[c][j] * matrix_at(X, i, j)
                }
                let err: f32 = pred - matrix_at(Y, i, c)
                for j in 0 to p {
                    grads[c][j] = grads[c][j] + err * matrix_at(X, i, j)
                }
                grad_b[c] = grad_b[c] + err
            }
        }

        let inv_n: f32 = 1.0 / (n as f32)
        for c in 0 to t {
            for j in 0 to p {
                grads[c][j] = grads[c][j] * inv_n
                weights[c][j] = weights[c][j] - lr * grads[c][j]
            }
            bias[c] = bias[c] - lr * grad_b[c] * inv_n
        }

        # Group soft-thresholding: for each feature j, compute the L2 norm
        # across all tasks and shrink the whole group by alpha.
        for j in 0 to p {
            let mut norm: f32 = 0.0
            for c in 0 to t {
                norm = norm + weights[c][j] * weights[c][j]
            }
            norm = sqrt((norm) as f64) as f32
            if norm > 0.0 {
                let shrink: f32 = alpha
                if norm <= shrink {
                    for c in 0 to t {
                        weights[c][j] = 0.0
                    }
                } else {
                    let scale: f32 = 1.0 - shrink / norm
                    for c in 0 to t {
                        weights[c][j] = weights[c][j] * scale
                    }
                }
            }
        }

        for c in 0 to t {
            array_free_f32(grads[c])
        }
        free(grads as ptr<void>)
        array_free_f32(grad_b)
    }

    return MultiTaskLasso {
        weights: weights,
        bias: bias,
        n_features: p,
        n_tasks: t,
        alpha: alpha,
        fitted: true
    }
}

export function multitask_lasso_predict(model: MultiTaskLasso, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_tasks)
    for i in 0 to X.rows {
        for c in 0 to model.n_tasks {
            let mut s: f32 = model.bias[c]
            for j in 0 to model.n_features {
                s = s + model.weights[c][j] * matrix_at(X, i, j)
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function multitask_lasso_free(model: MultiTaskLasso) -> void {
    for c in 0 to model.n_tasks {
        array_free_f32(model.weights[c])
    }
    free(model.weights as ptr<void>)
    array_free_f32(model.bias)
}

# ============================================================================
# MultiTaskElasticNet (combined L1+L2 penalty across tasks)
# Y is a Matrix with shape (n_samples, n_tasks). Predict returns Matrix.
# ============================================================================

export struct MultiTaskElasticNet {
    weights: ptr<ptr<f32> >,
    bias: ptr<f32>,
    n_features: i32,
    n_tasks: i32,
    alpha: f32,
    l1_ratio: f32,
    fitted: bool
}

export function multitask_elastic_net_fit(X: Matrix, Y: Matrix, alpha: f32, l1_ratio: f32, epochs: i32, lr: f32) -> MultiTaskElasticNet {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let t: i32 = Y.cols

    let l1: f32 = alpha * l1_ratio
    let l2: f32 = alpha * (1.0 - l1_ratio)

    let weights: ptr<ptr<f32> > = malloc((t as i64) * 8) as ptr<ptr<f32> >
    let bias: ptr<f32> = array_new_f32(t)
    for c in 0 to t {
        weights[c] = array_new_f32(p)
    }

    for epoch in 0 to epochs {
        let grads: ptr<ptr<f32> > = malloc((t as i64) * 8) as ptr<ptr<f32> >
        let grad_b: ptr<f32> = array_new_f32(t)
        for c in 0 to t {
            grads[c] = array_new_f32(p)
        }

        for i in 0 to n {
            for c in 0 to t {
                let mut pred: f32 = bias[c]
                for j in 0 to p {
                    pred = pred + weights[c][j] * matrix_at(X, i, j)
                }
                let err: f32 = pred - matrix_at(Y, i, c)
                for j in 0 to p {
                    grads[c][j] = grads[c][j] + err * matrix_at(X, i, j)
                }
                grad_b[c] = grad_b[c] + err
            }
        }

        let inv_n: f32 = 1.0 / (n as f32)
        for c in 0 to t {
            for j in 0 to p {
                grads[c][j] = grads[c][j] * inv_n + l2 * weights[c][j]
                weights[c][j] = weights[c][j] - lr * grads[c][j]
            }
            bias[c] = bias[c] - lr * grad_b[c] * inv_n
        }

        # Group soft-thresholding with L1 portion
        for j in 0 to p {
            let mut norm: f32 = 0.0
            for c in 0 to t {
                norm = norm + weights[c][j] * weights[c][j]
            }
            norm = sqrt((norm) as f64) as f32
            if norm > 0.0 {
                if norm <= l1 {
                    for c in 0 to t {
                        weights[c][j] = 0.0
                    }
                } else {
                    let scale: f32 = 1.0 - l1 / norm
                    for c in 0 to t {
                        weights[c][j] = weights[c][j] * scale
                    }
                }
            }
        }

        for c in 0 to t {
            array_free_f32(grads[c])
        }
        free(grads as ptr<void>)
        array_free_f32(grad_b)
    }

    return MultiTaskElasticNet {
        weights: weights,
        bias: bias,
        n_features: p,
        n_tasks: t,
        alpha: alpha,
        l1_ratio: l1_ratio,
        fitted: true
    }
}

export function multitask_elastic_net_predict(model: MultiTaskElasticNet, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_tasks)
    for i in 0 to X.rows {
        for c in 0 to model.n_tasks {
            let mut s: f32 = model.bias[c]
            for j in 0 to model.n_features {
                s = s + model.weights[c][j] * matrix_at(X, i, j)
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function multitask_elastic_net_free(model: MultiTaskElasticNet) -> void {
    for c in 0 to model.n_tasks {
        array_free_f32(model.weights[c])
    }
    free(model.weights as ptr<void>)
    array_free_f32(model.bias)
}

# ============================================================================
# RidgeCV
# ============================================================================

export struct RidgeCV {
    alpha: f32,
    coef: ptr<f32>,
    intercept: f32,
    n_features: i32,
    fitted: bool
}

export function ridge_cv_fit(X: Matrix, y: ptr<f32>, n_alphas: i32) -> RidgeCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Generate alpha grid (logspace from 0.001 to 10)
    let alphas: ptr<f32> = array_new_f32(n_alphas)
    let mut i: i32 = 0
    while i < n_alphas {
        let t: f32 = (i as f32) / ((n_alphas - 1) as f32)
        alphas[i] = 0.001 * pow(10.0 as f64, (t * 4.0) as f64) as f32
        i = i + 1
    }

    # Try each alpha, compute 5-fold CV MSE
    let mut best_alpha: f32 = alphas[0]
    let mut best_mse: f32 = 999999.0
    let fold_size: i32 = n / 5

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let alpha: f32 = alphas[a_idx]
        let mut total_mse: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let y_train: ptr<f32> = array_new_f32(n_train)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    y_train[idx] = y[j]
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: Ridge = ridge_fit(X_train, y_train, alpha, 1000, 0.01)

            let mut fold_mse: f32 = 0.0
            let n_test: i32 = test_end - test_start
            let mut t2: i32 = test_start
            while t2 < test_end {
                let mut pred: f32 = model.bias
                let mut k2: i32 = 0
                while k2 < n_features {
                    pred = pred + model.weights[k2] * matrix_at(X, t2, k2)
                    k2 = k2 + 1
                }
                let diff: f32 = y[t2] - pred
                fold_mse = fold_mse + diff * diff
                t2 = t2 + 1
            }
            total_mse = total_mse + fold_mse / (n_test as f32)

            ridge_free(model)
            matrix_free(X_train)
            array_free_f32(y_train)
            fold = fold + 1
        }

        let avg_mse: f32 = total_mse / 5.0
        if avg_mse < best_mse {
            best_mse = avg_mse
            best_alpha = alpha
        }
        a_idx = a_idx + 1
    }

    # Refit with best alpha on all data
    let best_model: Ridge = ridge_fit(X, y, best_alpha, 1000, 0.01)
    let coef_copy: ptr<f32> = array_copy_f32(best_model.weights, n_features)
    let intercept_copy: f32 = best_model.bias
    ridge_free(best_model)
    array_free_f32(alphas)

    let result: RidgeCV = RidgeCV {
        alpha: best_alpha,
        coef: coef_copy,
        intercept: intercept_copy,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function ridge_cv_predict(model: RidgeCV, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        let mut pred: f32 = model.intercept
        let mut j: i32 = 0
        while j < model.n_features {
            pred = pred + model.coef[j] * matrix_at(X, i, j)
            j = j + 1
        }
        result[i] = pred
        i = i + 1
    }
    return result
}

export function ridge_cv_free(model: RidgeCV) -> void {
    array_free_f32(model.coef)
}

