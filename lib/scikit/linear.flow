# ============================================================================
# RidgeClassifierCV
# ============================================================================

export struct RidgeClassifierCV {
    alpha: f32,
    coef: ptr<f32>,
    intercept: f32,
    n_features: i32,
    n_classes: i32,
    fitted: bool
}

export function ridge_classifier_cv_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_alphas: i32) -> RidgeClassifierCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let alphas: ptr<f32> = array_new_f32(n_alphas)
    let mut i: i32 = 0
    while i < n_alphas {
        let t: f32 = (i as f32) / ((n_alphas - 1) as f32)
        alphas[i] = 0.001 * pow(10.0 as f64, (t * 4.0) as f64) as f32
        i = i + 1
    }

    let mut best_alpha: f32 = alphas[0]
    let mut best_acc: f32 = -1.0
    let fold_size: i32 = n / 5

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let alpha: f32 = alphas[a_idx]
        let mut total_acc: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let y_train: ptr<f32> = array_new_f32(n_train)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    y_train[idx] = y[j]
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: RidgeClassifier = ridge_classifier_fit(X_train, y_train, alpha, 1000, 0.01)

            let mut correct: i32 = 0
            let mut t2: i32 = test_start
            while t2 < test_end {
                let mut pred_val: f32 = model.bias
                let mut k2: i32 = 0
                while k2 < n_features {
                    pred_val = pred_val + model.weights[k2] * matrix_at(X, t2, k2)
                    k2 = k2 + 1
                }
                let pred_cls: f32 = 0.0
                if pred_val > 0.5 { pred_cls = 1.0 }
                if pred_val > 1.5 { pred_cls = 2.0 }
                if y[t2] == pred_cls {
                    correct = correct + 1
                }
                t2 = t2 + 1
            }
            total_acc = total_acc + (correct as f32) / ((test_end - test_start) as f32)

            ridge_classifier_free(model)
            matrix_free(X_train)
            array_free_f32(y_train)
            fold = fold + 1
        }

        let avg_acc: f32 = total_acc / 5.0
        if avg_acc > best_acc {
            best_acc = avg_acc
            best_alpha = alpha
        }
        a_idx = a_idx + 1
    }

    # Refit with best alpha
    let best_model: RidgeClassifier = ridge_classifier_fit(X, y, best_alpha, 1000, 0.01)
    let coef_copy: ptr<f32> = array_copy_f32(best_model.weights, n_features)
    let intercept_copy: f32 = best_model.bias
    ridge_classifier_free(best_model)
    array_free_f32(alphas)

    let result: RidgeClassifierCV = RidgeClassifierCV {
        alpha: best_alpha,
        coef: coef_copy,
        intercept: intercept_copy,
        n_features: n_features,
        n_classes: n_classes,
        fitted: true
    }
    return result
}

export function ridge_classifier_cv_predict(model: RidgeClassifierCV, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        let mut pred_val: f32 = model.intercept
        let mut j: i32 = 0
        while j < model.n_features {
            pred_val = pred_val + model.coef[j] * matrix_at(X, i, j)
            j = j + 1
        }
        let pred_cls: f32 = 0.0
        if pred_val > 0.5 { pred_cls = 1.0 }
        if pred_val > 1.5 { pred_cls = 2.0 }
        result[i] = pred_cls
        i = i + 1
    }
    return result
}

export function ridge_classifier_cv_free(model: RidgeClassifierCV) -> void {
    array_free_f32(model.coef)
}

# ============================================================================
# PassiveAggressiveRegressor
# ============================================================================

export struct PassiveAggressiveRegressor {
    coef: ptr<f32>,
    intercept: f32,
    n_features: i32,
    fitted: bool
}

export function passive_aggressive_regressor_fit(X: Matrix, y: ptr<f32>, C: f32, max_iter: i32) -> PassiveAggressiveRegressor {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let coef: ptr<f32> = array_new_f32(n_features)
    let mut intercept: f32 = 0.0

    let mut epoch: i32 = 0
    while epoch < max_iter {
        let mut i: i32 = 0
        while i < n {
            let mut pred: f32 = intercept
            let mut j: i32 = 0
            while j < n_features {
                pred = pred + coef[j] * matrix_at(X, i, j)
                j = j + 1
            }
            let loss: f32 = fabs((y[i] - pred) as f64) as f32

            if loss > 0.0 {
                # Compute norm squared
                let mut norm_sq: f32 = 0.0
                let mut k: i32 = 0
                while k < n_features {
                    norm_sq = norm_sq + matrix_at(X, i, k) * matrix_at(X, i, k)
                    k = k + 1
                }
                norm_sq = norm_sq + 1.0

                # PA-I: tau = min(C, loss / norm_sq)
                let tau: f32 = C
                let tau_candidate: f32 = loss / norm_sq
                if tau_candidate < tau { tau = tau_candidate }

                let sign: f32 = 0.0
                if y[i] > pred { sign = 1.0 }
                if y[i] < pred { sign = -1.0 }

                let mut k2: i32 = 0
                while k2 < n_features {
                    coef[k2] = coef[k2] + tau * sign * matrix_at(X, i, k2)
                    k2 = k2 + 1
                }
                intercept = intercept + tau * sign
            }
            i = i + 1
        }
        epoch = epoch + 1
    }

    let result: PassiveAggressiveRegressor = PassiveAggressiveRegressor {
        coef: coef,
        intercept: intercept,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function passive_aggressive_regressor_predict(model: PassiveAggressiveRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        let mut pred: f32 = model.intercept
        let mut j: i32 = 0
        while j < model.n_features {
            pred = pred + model.coef[j] * matrix_at(X, i, j)
            j = j + 1
        }
        result[i] = pred
        i = i + 1
    }
    return result
}

export function passive_aggressive_regressor_free(model: PassiveAggressiveRegressor) -> void {
    array_free_f32(model.coef)
}

# ============================================================================
# LogisticRegressionCV
# ============================================================================

export struct LogisticRegressionCV {
    C: f32,
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_classes: i32,
    fitted: bool
}

export function logistic_regression_cv_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_Cs: i32) -> LogisticRegressionCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Generate C grid (inverse regularization strength)
    let Cs: ptr<f32> = array_new_f32(n_Cs)
    let mut i: i32 = 0
    while i < n_Cs {
        let t: f32 = (i as f32) / ((n_Cs - 1) as f32)
        Cs[i] = 0.001 * pow(10.0 as f64, (t * 6.0) as f64) as f32
        i = i + 1
    }

    let mut best_C: f32 = Cs[0]
    let mut best_acc: f32 = -1.0
    let fold_size: i32 = n / 5

    let mut c_idx: i32 = 0
    while c_idx < n_Cs {
        let C: f32 = Cs[c_idx]
        let alpha: f32 = 1.0 / C
        let pen: Penalty = Penalty { kind: 2, alpha: alpha, l1_ratio: 0.0 }
        let mut total_acc: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let y_train: ptr<f32> = array_new_f32(n_train)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    y_train[idx] = y[j]
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: LogisticRegression = logistic_regression_fit(X_train, y_train, n_classes, 500, 0.1, pen)
            let preds: ptr<f32> = logistic_predict(model, X)

            let mut correct: i32 = 0
            let mut t2: i32 = test_start
            while t2 < test_end {
                if preds[t2] == y[t2] {
                    correct = correct + 1
                }
                t2 = t2 + 1
            }
            total_acc = total_acc + (correct as f32) / ((test_end - test_start) as f32)

            array_free_f32(preds)
            logistic_regression_free(model)
            matrix_free(X_train)
            array_free_f32(y_train)
            fold = fold + 1
        }

        let avg_acc: f32 = total_acc / 5.0
        if avg_acc > best_acc {
            best_acc = avg_acc
            best_C = C
        }
        c_idx = c_idx + 1
    }

    # Refit with best C
    let best_alpha: f32 = 1.0 / best_C
    let best_pen: Penalty = Penalty { kind: 2, alpha: best_alpha, l1_ratio: 0.0 }
    let best_model: LogisticRegression = logistic_regression_fit(X, y, n_classes, 500, 0.1, best_pen)
    let weights_copy: ptr<f32> = array_copy_f32(best_model.weights, n_features * n_classes)
    let bias_copy: f32 = best_model.bias
    logistic_regression_free(best_model)
    array_free_f32(Cs)

    let result: LogisticRegressionCV = LogisticRegressionCV {
        C: best_C,
        weights: weights_copy,
        bias: bias_copy,
        n_features: n_features,
        n_classes: n_classes,
        fitted: true
    }
    return result
}

export function logistic_regression_cv_predict(model: LogisticRegressionCV, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        if model.n_classes == 2 {
            # Binary: weights for class 1 are at offset 0
            let mut z: f32 = model.bias
            let mut j: i32 = 0
            while j < model.n_features {
                z = z + model.weights[j] * matrix_at(X, i, j)
                j = j + 1
            }
            let sig: f32 = 1.0 / (1.0 + exp((-z) as f64) as f32)
            if sig > 0.5 {
                result[i] = 1.0
            } else {
                result[i] = 0.0
            }
        } else {
            let mut best_score: f32 = -999999.0
            let mut best_cls: i32 = 0
            let mut c: i32 = 0
            while c < model.n_classes {
                let mut z: f32 = model.bias
                let mut j: i32 = 0
                while j < model.n_features {
                    z = z + model.weights[c * model.n_features + j] * matrix_at(X, i, j)
                    j = j + 1
                }
                if z > best_score {
                    best_score = z
                    best_cls = c
                }
                c = c + 1
            }
            result[i] = (best_cls as f32)
        }
        i = i + 1
    }
    return result
}

export function logistic_regression_cv_free(model: LogisticRegressionCV) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# LarsCV
# ============================================================================

export struct LarsCV {
    n_active: i32,
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    active_features: ptr<i32>,
    fitted: bool
}

export function lars_cv_fit(X: Matrix, y: ptr<f32>, max_features: i32) -> LarsCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # Try different n_active values and pick best via CV
    let mut best_n_active: i32 = 1
    let mut best_mse: f32 = 999999.0
    let fold_size: i32 = n / 5

    let mut n_active: i32 = 1
    while n_active <= max_features {
        let mut total_mse: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let y_train: ptr<f32> = array_new_f32(n_train)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    y_train[idx] = y[j]
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: Lars = lars_fit(X_train, y_train, n_active)
            let preds: ptr<f32> = lars_predict(model, X)

            let mut fold_mse: f32 = 0.0
            let mut t2: i32 = test_start
            while t2 < test_end {
                let diff: f32 = y[t2] - preds[t2]
                fold_mse = fold_mse + diff * diff
                t2 = t2 + 1
            }
            total_mse = total_mse + fold_mse / ((test_end - test_start) as f32)

            array_free_f32(preds)
            lars_free(model)
            matrix_free(X_train)
            array_free_f32(y_train)
            fold = fold + 1
        }

        let avg_mse: f32 = total_mse / 5.0
        if avg_mse < best_mse {
            best_mse = avg_mse
            best_n_active = n_active
        }
        n_active = n_active + 1
    }

    # Refit with best n_active
    let best_model: Lars = lars_fit(X, y, best_n_active)
    let weights_copy: ptr<f32> = array_copy_f32(best_model.weights, n_features)
    let active_copy: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>
    let mut i: i32 = 0
    while i < n_features {
        active_copy[i] = best_model.active_features[i]
        i = i + 1
    }
    let bias_copy: f32 = best_model.bias
    lars_free(best_model)

    let result: LarsCV = LarsCV {
        n_active: best_n_active,
        weights: weights_copy,
        bias: bias_copy,
        n_features: n_features,
        active_features: active_copy,
        fitted: true
    }
    return result
}

export function lars_cv_predict(model: LarsCV, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        let mut pred: f32 = model.bias
        let mut j: i32 = 0
        while j < model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
            j = j + 1
        }
        result[i] = pred
        i = i + 1
    }
    return result
}

export function lars_cv_free(model: LarsCV) -> void {
    array_free_f32(model.weights)
    free(model.active_features as ptr<void>)
}

# ============================================================================
# LassoLars
# ============================================================================

export struct LassoLars {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    n_active: i32,
    alpha: f32,
    fitted: bool
}

# Helper: compute column means of X
function _col_means(X: Matrix, n_features: i32) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(n_features)
    let mut j: i32 = 0
    while j < n_features {
        let mut s: f32 = 0.0
        let mut i: i32 = 0
        while i < X.rows {
            s = s + matrix_at(X, i, j)
            i = i + 1
        }
        result[j] = s / (X.rows as f32)
        j = j + 1
    }
    return result
}

# Helper: solve small linear system Ax = b using Gaussian elimination
# A is n x n stored as flat array, b is n, returns solution array of size n
# Uses f64 internally for numerical stability
function _solve_linear_system(A: ptr<f32>, b: ptr<f32>, n: i32) -> ptr<f32> {
    # Copy A and b to f64 for higher precision
    let M: ptr<f64> = array_new_f64(n * n)
    let rhs: ptr<f64> = array_new_f64(n)
    let mut i: i32 = 0
    while i < n * n {
        M[i] = A[i] as f64
        i = i + 1
    }
    i = 0
    while i < n {
        rhs[i] = b[i] as f64
        i = i + 1
    }

    # Forward elimination with partial pivoting
    let mut col: i32 = 0
    while col < n {
        # Find pivot
        let mut max_row: i32 = col
        let mut max_val: f64 = M[col * n + col]
        let abs_max: f64 = max_val
        if max_val < 0.0 { max_val = -max_val }
        let mut row: i32 = col + 1
        while row < n {
            let val: f64 = M[row * n + col]
            let abs_val: f64 = val
            if val < 0.0 { abs_val = -val }
            if abs_val > abs_max {
                max_row = row
                max_val = val
            }
            row = row + 1
        }

        # Swap rows
        if max_row != col {
            let mut k: i32 = 0
            while k < n {
                let tmp: f64 = M[col * n + k]
                M[col * n + k] = M[max_row * n + k]
                M[max_row * n + k] = tmp
                k = k + 1
            }
            let tmp2: f64 = rhs[col]
            rhs[col] = rhs[max_row]
            rhs[max_row] = tmp2
        }

        # Eliminate
        let pivot: f64 = M[col * n + col]
        if pivot > -0.000000000001 and pivot < 0.000000000001 {
            # Singular, return zeros
            let result: ptr<f32> = array_new_f32(n)
            array_free_f64(M)
            array_free_f64(rhs)
            return result
        }
        row = col + 1
        while row < n {
            let factor: f64 = M[row * n + col] / pivot
            let mut k2: i32 = col
            while k2 < n {
                M[row * n + k2] = M[row * n + k2] - factor * M[col * n + k2]
                k2 = k2 + 1
            }
            rhs[row] = rhs[row] - factor * rhs[col]
            row = row + 1
        }
        col = col + 1
    }

    # Back substitution
    let x: ptr<f32> = array_new_f32(n)
    let mut r: i32 = n - 1
    while r >= 0 {
        let mut sum: f64 = rhs[r]
        let mut c2: i32 = r + 1
        while c2 < n {
            sum = sum - M[r * n + c2] * (x[c2] as f64)
            c2 = c2 + 1
        }
        x[r] = (sum / M[r * n + r]) as f32
        r = r - 1
    }

    array_free_f64(M)
    array_free_f64(rhs)
    return x
}

# Helper: compute Gram matrix of active centered columns
# Returns n_active x n_active flat array
function _gram_active(X: Matrix, cmeans: ptr<f32>, active: ptr<i32>, n_active: i32) -> ptr<f32> {
    let G: ptr<f32> = array_new_f32(n_active * n_active)
    let mut a: i32 = 0
    while a < n_active {
        let mut b: i32 = 0
        while b < n_active {
            let mut s: f32 = 0.0
            let mut i: i32 = 0
            while i < X.rows {
                let va: f32 = matrix_at(X, i, active[a]) - cmeans[active[a]]
                let vb: f32 = matrix_at(X, i, active[b]) - cmeans[active[b]]
                s = s + va * vb
                i = i + 1
            }
            G[a * n_active + b] = s
            b = b + 1
        }
        a = a + 1
    }
    return G
}

# Helper: compute centered column dot with vector
function _centered_dot(X: Matrix, cmeans: ptr<f32>, k: i32, v_arr: ptr<f32>) -> f32 {
    let mut s: f32 = 0.0
    let mut i: i32 = 0
    while i < X.rows {
        s = s + (matrix_at(X, i, k) - cmeans[k]) * v_arr[i]
        i = i + 1
    }
    return s
}

export function lasso_lars_fit(X: Matrix, y: ptr<f32>, alpha: f32, max_iter: i32) -> LassoLars {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    # LARS-Lasso algorithm (Efron et al. 2004)
    # Computes the L1-regularized solution via the LARS path
    # with the Lasso modification (removing variables that cross zero).

    let y_mean: f32 = array_mean(y, n)
    let cmeans: ptr<f32> = _col_means(X, n_features)

    # Center y
    let yc: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        yc[i] = y[i] - y_mean
        i = i + 1
    }

    # Weights (coefficients in centered space)
    let beta: ptr<f32> = array_new_f32(n_features)
    i = 0
    while i < n_features {
        beta[i] = 0.0
        i = i + 1
    }

    # Active set
    let active: ptr<i32> = malloc((n_features as i64) * 4) as ptr<i32>
    let signs: ptr<f32> = array_new_f32(n_features)
    let mut n_active: i32 = 0

    # Residual = yc (since beta = 0)
    let residual: ptr<f32> = array_new_f32(n)
    i = 0
    while i < n {
        residual[i] = yc[i]
        i = i + 1
    }

    let mut iter: i32 = 0
    while iter < max_iter {
        # Compute correlations c_j = X_j^T * residual
        let corr: ptr<f32> = array_new_f32(n_features)
        let mut j: i32 = 0
        while j < n_features {
            corr[j] = _centered_dot(X, cmeans, j, residual)
            j = j + 1
        }

        # Find max absolute correlation
        let mut C: f32 = 0.0
        j = 0
        while j < n_features {
            let ac: f32 = corr[j]
            if ac < 0.0 { ac = -ac }
            if ac > C { C = ac }
            j = j + 1
        }

        # Stop if max correlation is below threshold (alpha * n)
        let threshold: f32 = alpha * (n as f32)
        if C < threshold { array_free_f32(corr); break }

        # Check KKT: add variables that are at max correlation
        let mut add_idx: i32 = -1
        let mut max_corr_inactive: f32 = 0.0
        j = 0
        while j < n_features {
            # Check if j is active
            let mut is_active: bool = false
            let mut a: i32 = 0
            while a < n_active {
                if active[a] == j { is_active = true }
                a = a + 1
            }
            if not is_active {
                let ac2: f32 = corr[j]
                if ac2 < 0.0 { ac2 = -ac2 }
                if ac2 > C - 0.001 {
                    # This variable is at max correlation, add it
                    if ac2 > max_corr_inactive {
                        max_corr_inactive = ac2
                        add_idx = j
                    }
                }
            }
            j = j + 1
        }

        if add_idx >= 0 {
            active[n_active] = add_idx
            if corr[add_idx] >= 0.0 {
                signs[n_active] = 1.0
            } else {
                signs[n_active] = -1.0
            }
            n_active = n_active + 1
        }

        if n_active == 0 { array_free_f32(corr); break }

        # Compute equiangular direction
        # G = X_A^T X_A (n_active x n_active)
        let G: ptr<f32> = _gram_active(X, cmeans, active, n_active)

        # s = signs of active variables
        let s_vec: ptr<f32> = array_new_f32(n_active)
        let mut a2: i32 = 0
        while a2 < n_active {
            s_vec[a2] = signs[a2]
            a2 = a2 + 1
        }

        # Solve G * w = s to get w = G^{-1} * s
        let w: ptr<f32> = _solve_linear_system(G, s_vec, n_active)

        # A_A = 1 / sqrt(1^T * w) = 1 / sqrt(sum(w))
        let mut sum_w: f32 = 0.0
        a2 = 0
        while a2 < n_active {
            sum_w = sum_w + w[a2]
            a2 = a2 + 1
        }

        if sum_w < 0.0000000001 {
            array_free_f32(corr)
            array_free_f32(G)
            array_free_f32(s_vec)
            array_free_f32(w)
            break
        }

        let AA: f32 = 1.0 / sqrt((sum_w) as f64) as f32

        # Equiangular direction weights: gamma_dir = AA * w
        let gamma_dir: ptr<f32> = array_new_f32(n_active)
        a2 = 0
        while a2 < n_active {
            gamma_dir[a2] = AA * w[a2]
            a2 = a2 + 1
        }

        # Compute a_j = X_j^T * u_A for all j (where u_A = X_A * gamma_dir)
        # a_j = sum over active of gamma_dir[a] * (X_j^T X_{active[a]})
        let a_vec: ptr<f32> = array_new_f32(n_features)
        j = 0
        while j < n_features {
            let mut s: f32 = 0.0
            let mut a3: i32 = 0
            while a3 < n_active {
                let mut dot: f32 = 0.0
                let mut i2: i32 = 0
                while i2 < n {
                    dot = dot + (matrix_at(X, i2, j) - cmeans[j]) * (matrix_at(X, i2, active[a3]) - cmeans[active[a3]])
                    i2 = i2 + 1
                }
                s = s + gamma_dir[a3] * dot
                a3 = a3 + 1
            }
            a_vec[j] = s
            j = j + 1
        }

        # Compute step size gamma
        # For inactive variables: gamma_j = min of (C - c_j)/(AA - a_j) and (C + c_j)/(AA + a_j)
        # Take the minimum positive gamma_j
        let mut gamma: f32 = 999999.0
        j = 0
        while j < n_features {
            let mut is_active2: bool = false
            let mut a4: i32 = 0
            while a4 < n_active {
                if active[a4] == j { is_active2 = true }
                a4 = a4 + 1
            }
            if not is_active2 {
                let t1: f32 = (C - corr[j]) / (AA - a_vec[j])
                let t2: f32 = (C + corr[j]) / (AA + a_vec[j])
                if t1 > 0.0000000001 and t1 < gamma { gamma = t1 }
                if t2 > 0.0000000001 and t2 < gamma { gamma = t2 }
            }
            j = j + 1
        }

        # Lasso modification: check if any active coefficient crosses zero
        let mut gamma_tilde: f32 = 999999.0
        let mut drop_idx: i32 = -1
        let mut a5: i32 = 0
        while a5 < n_active {
            if gamma_dir[a5] != 0.0 {
                let t: f32 = -beta[active[a5]] / gamma_dir[a5]
                if t > 0.0000000001 and t < gamma_tilde {
                    gamma_tilde = t
                    drop_idx = a5
                }
            }
            a5 = a5 + 1
        }

        # Use the smaller step
        let mut step: f32 = gamma
        if gamma_tilde < gamma {
            step = gamma_tilde
        }
        if step > 999998.0 { step = C / AA }

        # Don't step past the point where C drops below threshold
        let max_step: f32 = (C - threshold) / AA
        if step > max_step { step = max_step }
        if step < 0.0 { step = 0.0 }

        # Update beta and residual
        let mut a6: i32 = 0
        while a6 < n_active {
            let idx: i32 = active[a6]
            beta[idx] = beta[idx] + step * gamma_dir[a6]
            a6 = a6 + 1
        }

        # Update residual: r -= step * X_A * gamma_dir
        let mut i3: i32 = 0
        while i3 < n {
            let mut delta: f32 = 0.0
            let mut a7: i32 = 0
            while a7 < n_active {
                delta = delta + step * gamma_dir[a7] * (matrix_at(X, i3, active[a7]) - cmeans[active[a7]])
                a7 = a7 + 1
            }
            residual[i3] = residual[i3] - delta
            i3 = i3 + 1
        }

        # Lasso modification: drop variable if coefficient crossed zero
        if drop_idx >= 0 and gamma_tilde < gamma {
            let drop_var: i32 = active[drop_idx]
            beta[drop_var] = 0.0
            # Remove from active set
            let mut a8: i32 = drop_idx
            while a8 < n_active - 1 {
                active[a8] = active[a8 + 1]
                signs[a8] = signs[a8 + 1]
                a8 = a8 + 1
            }
            n_active = n_active - 1
        }

        array_free_f32(corr)
        array_free_f32(G)
        array_free_f32(s_vec)
        array_free_f32(w)
        array_free_f32(gamma_dir)
        array_free_f32(a_vec)

        if step < 0.0000000001 { break }
        iter = iter + 1
    }

    # Compute bias
    let bias: f32 = y_mean
    let mut j2: i32 = 0
    while j2 < n_features {
        bias = bias - beta[j2] * cmeans[j2]
        j2 = j2 + 1
    }

    array_free_f32(cmeans)
    array_free_f32(yc)
    array_free_f32(residual)
    free(active as ptr<void>)
    array_free_f32(signs)

    let result: LassoLars = LassoLars {
        weights: beta,
        bias: bias,
        n_features: n_features,
        n_active: n_active,
        alpha: alpha,
        fitted: true
    }
    return result
}

export function lasso_lars_predict(model: LassoLars, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        let mut pred: f32 = model.bias
        let mut j: i32 = 0
        while j < model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
            j = j + 1
        }
        result[i] = pred
        i = i + 1
    }
    return result
}

export function lasso_lars_free(model: LassoLars) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# LassoLarsCV
# ============================================================================

export struct LassoLarsCV {
    alpha: f32,
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    fitted: bool
}

export function lasso_lars_cv_fit(X: Matrix, y: ptr<f32>, n_alphas: i32) -> LassoLarsCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let alphas: ptr<f32> = array_new_f32(n_alphas)
    let mut i: i32 = 0
    while i < n_alphas {
        let t: f32 = (i as f32) / ((n_alphas - 1) as f32)
        alphas[i] = 0.001 * pow(10.0 as f64, (t * 3.0) as f64) as f32
        i = i + 1
    }

    let mut best_alpha: f32 = alphas[0]
    let mut best_mse: f32 = 999999.0
    let fold_size: i32 = n / 5

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let alpha: f32 = alphas[a_idx]
        let mut total_mse: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let y_train: ptr<f32> = array_new_f32(n_train)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    y_train[idx] = y[j]
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: LassoLars = lasso_lars_fit(X_train, y_train, alpha, n_features)
            let preds: ptr<f32> = lasso_lars_predict(model, X)

            let mut fold_mse: f32 = 0.0
            let mut t2: i32 = test_start
            while t2 < test_end {
                let diff: f32 = y[t2] - preds[t2]
                fold_mse = fold_mse + diff * diff
                t2 = t2 + 1
            }
            total_mse = total_mse + fold_mse / ((test_end - test_start) as f32)

            array_free_f32(preds)
            lasso_lars_free(model)
            matrix_free(X_train)
            array_free_f32(y_train)
            fold = fold + 1
        }

        let avg_mse: f32 = total_mse / 5.0
        if avg_mse < best_mse {
            best_mse = avg_mse
            best_alpha = alpha
        }
        a_idx = a_idx + 1
    }

    let best_model: LassoLars = lasso_lars_fit(X, y, best_alpha, n_features)
    let weights_copy: ptr<f32> = array_copy_f32(best_model.weights, n_features)
    let bias_copy: f32 = best_model.bias
    lasso_lars_free(best_model)
    array_free_f32(alphas)

    let result: LassoLarsCV = LassoLarsCV {
        alpha: best_alpha,
        weights: weights_copy,
        bias: bias_copy,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function lasso_lars_cv_predict(model: LassoLarsCV, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
        let mut pred: f32 = model.bias
        let mut j: i32 = 0
        while j < model.n_features {
            pred = pred + model.weights[j] * matrix_at(X, i, j)
            j = j + 1
        }
        result[i] = pred
        i = i + 1
    }
    return result
}

export function lasso_lars_cv_free(model: LassoLarsCV) -> void {
    array_free_f32(model.weights)
}

# ============================================================================
# MultiTaskLassoCV
# ============================================================================

export struct MultiTaskLassoCV {
    alpha: f32,
    weights: ptr<ptr<f32> >,
    bias: ptr<f32>,
    n_features: i32,
    n_tasks: i32,
    fitted: bool
}

export function multitask_lasso_cv_fit(X: Matrix, Y: Matrix, n_alphas: i32) -> MultiTaskLassoCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let n_tasks: i32 = Y.cols

    let alphas: ptr<f32> = array_new_f32(n_alphas)
    let mut i: i32 = 0
    while i < n_alphas {
        let t: f32 = (i as f32) / ((n_alphas - 1) as f32)
        alphas[i] = 0.001 * pow(10.0 as f64, (t * 4.0) as f64) as f32
        i = i + 1
    }

    let mut best_alpha: f32 = alphas[0]
    let mut best_mse: f32 = 999999.0
    let fold_size: i32 = n / 5

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let alpha: f32 = alphas[a_idx]
        let mut total_mse: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let Y_train: Matrix = matrix_new(n_train, n_tasks)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    let mut k2: i32 = 0
                    while k2 < n_tasks {
                        matrix_set(Y_train, idx, k2, matrix_at(Y, j, k2))
                        k2 = k2 + 1
                    }
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: MultiTaskLasso = multitask_lasso_fit(X_train, Y_train, alpha, 500, 0.01)
            let preds: Matrix = multitask_lasso_predict(model, X)

            let mut fold_mse: f32 = 0.0
            let mut t2: i32 = test_start
            while t2 < test_end {
                let mut k3: i32 = 0
                while k3 < n_tasks {
                    let diff: f32 = matrix_at(Y, t2, k3) - matrix_at(preds, t2, k3)
                    fold_mse = fold_mse + diff * diff
                    k3 = k3 + 1
                }
                t2 = t2 + 1
            }
            total_mse = total_mse + fold_mse / ((test_end - test_start) as f32 * (n_tasks as f32))

            matrix_free(preds)
            multitask_lasso_free(model)
            matrix_free(X_train)
            matrix_free(Y_train)
            fold = fold + 1
        }

        let avg_mse: f32 = total_mse / 5.0
        if avg_mse < best_mse {
            best_mse = avg_mse
            best_alpha = alpha
        }
        a_idx = a_idx + 1
    }

    let best_model: MultiTaskLasso = multitask_lasso_fit(X, Y, best_alpha, 500, 0.01)
    let weights_copy: ptr<ptr<f32> > = malloc((n_tasks as i64) * 8) as ptr<ptr<f32> >
    let bias_copy: ptr<f32> = array_new_f32(n_tasks)
    let mut t: i32 = 0
    while t < n_tasks {
        weights_copy[t] = array_copy_f32(best_model.weights[t], n_features)
        bias_copy[t] = best_model.bias[t]
        t = t + 1
    }
    multitask_lasso_free(best_model)
    array_free_f32(alphas)

    let result: MultiTaskLassoCV = MultiTaskLassoCV {
        alpha: best_alpha,
        weights: weights_copy,
        bias: bias_copy,
        n_features: n_features,
        n_tasks: n_tasks,
        fitted: true
    }
    return result
}

export function multitask_lasso_cv_predict(model: MultiTaskLassoCV, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_tasks)
    let mut i: i32 = 0
    while i < n {
        let mut t: i32 = 0
        while t < model.n_tasks {
            let mut pred: f32 = model.bias[t]
            let mut j: i32 = 0
            while j < model.n_features {
                pred = pred + model.weights[t][j] * matrix_at(X, i, j)
                j = j + 1
            }
            matrix_set(result, i, t, pred)
            t = t + 1
        }
        i = i + 1
    }
    return result
}

export function multitask_lasso_cv_free(model: MultiTaskLassoCV) -> void {
    let mut i: i32 = 0
    while i < model.n_tasks {
        array_free_f32(model.weights[i])
        i = i + 1
    }
    free(model.weights as ptr<void>)
    array_free_f32(model.bias)
}

# ============================================================================
# MultiTaskElasticNetCV
# ============================================================================

export struct MultiTaskElasticNetCV {
    alpha: f32,
    l1_ratio: f32,
    weights: ptr<ptr<f32> >,
    bias: ptr<f32>,
    n_features: i32,
    n_tasks: i32,
    fitted: bool
}

export function multitask_elastic_net_cv_fit(X: Matrix, Y: Matrix, n_alphas: i32) -> MultiTaskElasticNetCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    let n_tasks: i32 = Y.cols
    let l1_ratio: f32 = 0.5

    let alphas: ptr<f32> = array_new_f32(n_alphas)
    let mut i: i32 = 0
    while i < n_alphas {
        let t: f32 = (i as f32) / ((n_alphas - 1) as f32)
        alphas[i] = 0.001 * pow(10.0 as f64, (t * 4.0) as f64) as f32
        i = i + 1
    }

    let mut best_alpha: f32 = alphas[0]
    let mut best_mse: f32 = 999999.0
    let fold_size: i32 = n / 5

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let alpha: f32 = alphas[a_idx]
        let mut total_mse: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let Y_train: Matrix = matrix_new(n_train, n_tasks)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    let mut k2: i32 = 0
                    while k2 < n_tasks {
                        matrix_set(Y_train, idx, k2, matrix_at(Y, j, k2))
                        k2 = k2 + 1
                    }
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: MultiTaskElasticNet = multitask_elastic_net_fit(X_train, Y_train, alpha, l1_ratio, 500, 0.01)
            let preds: Matrix = multitask_elastic_net_predict(model, X)

            let mut fold_mse: f32 = 0.0
            let mut t2: i32 = test_start
            while t2 < test_end {
                let mut k3: i32 = 0
                while k3 < n_tasks {
                    let diff: f32 = matrix_at(Y, t2, k3) - matrix_at(preds, t2, k3)
                    fold_mse = fold_mse + diff * diff
                    k3 = k3 + 1
                }
                t2 = t2 + 1
            }
            total_mse = total_mse + fold_mse / ((test_end - test_start) as f32 * (n_tasks as f32))

            matrix_free(preds)
            multitask_elastic_net_free(model)
            matrix_free(X_train)
            matrix_free(Y_train)
            fold = fold + 1
        }

        let avg_mse: f32 = total_mse / 5.0
        if avg_mse < best_mse {
            best_mse = avg_mse
            best_alpha = alpha
        }
        a_idx = a_idx + 1
    }

    let best_model: MultiTaskElasticNet = multitask_elastic_net_fit(X, Y, best_alpha, l1_ratio, 500, 0.01)
    let weights_copy: ptr<ptr<f32> > = malloc((n_tasks as i64) * 8) as ptr<ptr<f32> >
    let bias_copy: ptr<f32> = array_new_f32(n_tasks)
    let mut t: i32 = 0
    while t < n_tasks {
        weights_copy[t] = array_copy_f32(best_model.weights[t], n_features)
        bias_copy[t] = best_model.bias[t]
        t = t + 1
    }
    multitask_elastic_net_free(best_model)
    array_free_f32(alphas)

    let result: MultiTaskElasticNetCV = MultiTaskElasticNetCV {
        alpha: best_alpha,
        l1_ratio: l1_ratio,
        weights: weights_copy,
        bias: bias_copy,
        n_features: n_features,
        n_tasks: n_tasks,
        fitted: true
    }
    return result
}

export function multitask_elastic_net_cv_predict(model: MultiTaskElasticNetCV, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_tasks)
    let mut i: i32 = 0
    while i < n {
        let mut t: i32 = 0
        while t < model.n_tasks {
            let mut pred: f32 = model.bias[t]
            let mut j: i32 = 0
            while j < model.n_features {
                pred = pred + model.weights[t][j] * matrix_at(X, i, j)
                j = j + 1
            }
            matrix_set(result, i, t, pred)
            t = t + 1
        }
        i = i + 1
    }
    return result
}

export function multitask_elastic_net_cv_free(model: MultiTaskElasticNetCV) -> void {
    let mut i: i32 = 0
    while i < model.n_tasks {
        array_free_f32(model.weights[i])
        i = i + 1
    }
    free(model.weights as ptr<void>)
    array_free_f32(model.bias)
}

# ============================================================================
# Generalized Linear Models: PoissonRegressor, GammaRegressor, TweedieRegressor
# All use IRLS (iteratively reweighted least squares) with canonical link.
# ============================================================================

export struct PoissonRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    max_iter: i32,
    fitted: bool
}

function _poisson_link(mu: f32) -> f32 {
    if mu < 0.0000000001 { return 0.0000000001 }
    return log(mu as f64) as f32
}

function _poisson_inverse_link(eta: f32) -> f32 {
    if eta > 30.0 { eta = 30.0 }
    if eta < -30.0 { eta = -30.0 }
    return exp(eta as f64) as f32
}

export function poisson_regressor_fit(X: Matrix, y: ptr<f32>, alpha: f32, max_iter: i32, lr: f32) -> PoissonRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    let mut y_mean: f32 = 0.0
    for i in 0 to n { y_mean = y_mean + y[i] }
    y_mean = y_mean / (n as f32)
    if y_mean < 0.0000000001 { y_mean = 0.0000000001 }
    bias = log(y_mean as f64) as f32

    for iter in 0 to max_iter {
        let grad_w: ptr<f32> = array_new_f32(p)
        let mut grad_b: f32 = 0.0
        for i in 0 to n {
            let mut eta: f32 = bias
            for j in 0 to p { eta = eta + weights[j] * matrix_at(X, i, j) }
            let mu: f32 = _poisson_inverse_link(eta)
            let resid: f32 = y[i] - mu
            for j in 0 to p { grad_w[j] = grad_w[j] + resid * matrix_at(X, i, j) }
            grad_b = grad_b + resid
        }
        for j in 0 to p {
            grad_w[j] = grad_w[j] / (n as f32) - alpha * weights[j]
            weights[j] = weights[j] + lr * grad_w[j]
        }
        bias = bias + lr * grad_b / (n as f32)
        array_free_f32(grad_w)
    }

    let result: PoissonRegressor = PoissonRegressor {
        weights: weights, bias: bias,
        n_features: p, alpha: alpha,
        max_iter: max_iter, fitted: true
    }
    return result
}

export function poisson_regressor_predict(model: PoissonRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut eta: f32 = model.bias
        for j in 0 to model.n_features { eta = eta + model.weights[j] * matrix_at(X, i, j) }
        result[i] = _poisson_inverse_link(eta)
    }
    return result
}

export function poisson_regressor_free(model: PoissonRegressor) -> void {
    array_free_f32(model.weights)
}

export struct GammaRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    max_iter: i32,
    fitted: bool
}

function _gamma_inverse_link(eta: f32) -> f32 {
    if eta > 30.0 { eta = 30.0 }
    if eta < -30.0 { eta = -30.0 }
    let e: f32 = exp(eta as f64) as f32
    if e < 0.0000000001 { return 0.0000000001 }
    return 1.0 / e
}

export function gamma_regressor_fit(X: Matrix, y: ptr<f32>, alpha: f32, max_iter: i32, lr: f32) -> GammaRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    let mut y_mean: f32 = 0.0
    for i in 0 to n { y_mean = y_mean + y[i] }
    y_mean = y_mean / (n as f32)
    if y_mean < 0.0000000001 { y_mean = 0.0000000001 }
    bias = -log(y_mean as f64) as f32

    for iter in 0 to max_iter {
        let grad_w: ptr<f32> = array_new_f32(p)
        let mut grad_b: f32 = 0.0
        for i in 0 to n {
            let mut eta: f32 = bias
            for j in 0 to p { eta = eta + weights[j] * matrix_at(X, i, j) }
            let mu: f32 = _gamma_inverse_link(eta)
            let resid: f32 = (y[i] - mu) / (mu * mu)
            for j in 0 to p { grad_w[j] = grad_w[j] + resid * matrix_at(X, i, j) * mu * mu }
            grad_b = grad_b + resid * mu * mu
        }
        for j in 0 to p {
            grad_w[j] = grad_w[j] / (n as f32) - alpha * weights[j]
            weights[j] = weights[j] + lr * grad_w[j]
        }
        bias = bias + lr * grad_b / (n as f32)
        array_free_f32(grad_w)
    }

    let result: GammaRegressor = GammaRegressor {
        weights: weights, bias: bias,
        n_features: p, alpha: alpha,
        max_iter: max_iter, fitted: true
    }
    return result
}

export function gamma_regressor_predict(model: GammaRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut eta: f32 = model.bias
        for j in 0 to model.n_features { eta = eta + model.weights[j] * matrix_at(X, i, j) }
        result[i] = _gamma_inverse_link(eta)
    }
    return result
}

export function gamma_regressor_free(model: GammaRegressor) -> void {
    array_free_f32(model.weights)
}

export const TWEEDIE_POWER_0: f32 = 0.0
export const TWEEDIE_POWER_1: f32 = 1.0
export const TWEEDIE_POWER_2: f32 = 2.0
export const TWEEDIE_POWER_3: f32 = 3.0

export struct TweedieRegressor {
    weights: ptr<f32>,
    bias: f32,
    n_features: i32,
    alpha: f32,
    power: f32,
    max_iter: i32,
    fitted: bool
}

function _tweedie_inverse_link(eta: f32, power: f32) -> f32 {
    if eta > 30.0 { eta = 30.0 }
    if eta < -30.0 { eta = -30.0 }
    if power == 0.0 { return eta }
    if power == 1.0 {
        let e: f32 = exp(eta as f64) as f32
        if e < 0.0000000001 { return 0.0000000001 }
        return e
    }
    if power == 2.0 {
        let e: f32 = exp(eta as f64) as f32
        if e < 0.0000000001 { return 0.0000000001 }
        return 1.0 / e
    }
    let p: f32 = power
    let mu: f32 = (1.0 + (1.0 - p) * eta)
    if mu < 0.0000000001 { return 0.0000000001 }
    let result: f32 = pow(mu as f64, (1.0 / (1.0 - p)) as f64) as f32
    return result
}

export function tweedie_regressor_fit(X: Matrix, y: ptr<f32>, alpha: f32, power: f32, max_iter: i32, lr: f32) -> TweedieRegressor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let weights: ptr<f32> = array_new_f32(p)
    let mut bias: f32 = 0.0

    let mut y_mean: f32 = 0.0
    for i in 0 to n { y_mean = y_mean + y[i] }
    y_mean = y_mean / (n as f32)
    if y_mean < 0.0000000001 { y_mean = 0.0000000001 }

    if power == 1.0 {
        bias = log(y_mean as f64) as f32
    } elif power == 2.0 {
        bias = -log(y_mean as f64) as f32
    } else {
        bias = (pow(y_mean as f64, (1.0 - power) as f64) as f32 - 1.0) / (1.0 - power)
    }

    for iter in 0 to max_iter {
        let grad_w: ptr<f32> = array_new_f32(p)
        let mut grad_b: f32 = 0.0
        for i in 0 to n {
            let mut eta: f32 = bias
            for j in 0 to p { eta = eta + weights[j] * matrix_at(X, i, j) }
            let mu: f32 = _tweedie_inverse_link(eta, power)
            let resid: f32 = y[i] - mu
            for j in 0 to p { grad_w[j] = grad_w[j] + resid * matrix_at(X, i, j) }
            grad_b = grad_b + resid
        }
        for j in 0 to p {
            grad_w[j] = grad_w[j] / (n as f32) - alpha * weights[j]
            weights[j] = weights[j] + lr * grad_w[j]
        }
        bias = bias + lr * grad_b / (n as f32)
        array_free_f32(grad_w)
    }

    let result: TweedieRegressor = TweedieRegressor {
        weights: weights, bias: bias,
        n_features: p, alpha: alpha,
        power: power, max_iter: max_iter,
        fitted: true
    }
    return result
}

export function tweedie_regressor_predict(model: TweedieRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut eta: f32 = model.bias
        for j in 0 to model.n_features { eta = eta + model.weights[j] * matrix_at(X, i, j) }
        result[i] = _tweedie_inverse_link(eta, model.power)
    }
    return result
}

export function tweedie_regressor_free(model: TweedieRegressor) -> void {
    array_free_f32(model.weights)
}
