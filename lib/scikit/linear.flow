export struct ElasticNetCV {
    alpha: f32,
    l1_ratio: f32,
    coef: ptr<f32>,
    intercept: f32,
    n_features: i32,
    fitted: bool
}

export function elastic_net_cv_fit(X: Matrix, y: ptr<f32>, n_alphas: i32) -> ElasticNetCV {
    let n: i32 = X.rows
    let n_features: i32 = X.cols

    let alphas: ptr<f32> = array_new_f32(n_alphas)
    let mut i: i32 = 0
    while i < n_alphas {
        let t: f32 = (i as f32) / ((n_alphas - 1) as f32)
        alphas[i] = 0.001 * pow(10.0 as f64, (t * 4.0) as f64) as f32
        i = i + 1
    }

    let l1_ratio: f32 = 0.5
    let mut best_alpha: f32 = alphas[0]
    let mut best_mse: f32 = 999999.0
    let fold_size: i32 = n / 5

    let mut a_idx: i32 = 0
    while a_idx < n_alphas {
        let alpha: f32 = alphas[a_idx]
        let mut total_mse: f32 = 0.0
        let mut fold: i32 = 0
        while fold < 5 {
            let test_start: i32 = fold * fold_size
            let test_end: i32 = test_start + fold_size
            if fold == 4 { test_end = n }
            let n_train: i32 = n - (test_end - test_start)

            let X_train: Matrix = matrix_new(n_train, n_features)
            let y_train: ptr<f32> = array_new_f32(n_train)
            let mut idx: i32 = 0
            let mut j: i32 = 0
            while j < n {
                if j < test_start || j >= test_end {
                    let mut k: i32 = 0
                    while k < n_features {
                        matrix_set(X_train, idx, k, matrix_at(X, j, k))
                        k = k + 1
                    }
                    y_train[idx] = y[j]
                    idx = idx + 1
                }
                j = j + 1
            }

            let model: ElasticNet = elastic_net_fit(X_train, y_train, alpha, l1_ratio, 1000, 0.01)

            let mut fold_mse: f32 = 0.0
            let n_test: i32 = test_end - test_start
            let mut t2: i32 = test_start
            while t2 < test_end {
                let mut pred: f32 = model.bias
                let mut k2: i32 = 0
                while k2 < n_features {
                    pred = pred + model.weights[k2] * matrix_at(X, t2, k2)
                    k2 = k2 + 1
                }
                let diff: f32 = y[t2] - pred
                fold_mse = fold_mse + diff * diff
                t2 = t2 + 1
            }
            total_mse = total_mse + fold_mse / (n_test as f32)

            elastic_net_free(model)
            matrix_free(X_train)
            array_free_f32(y_train)
            fold = fold + 1
        }

        let avg_mse: f32 = total_mse / 5.0
        if avg_mse < best_mse {
            best_mse = avg_mse
            best_alpha = alpha
        }
        a_idx = a_idx + 1
    }

    let best_model: ElasticNet = elastic_net_fit(X, y, best_alpha, l1_ratio, 1000, 0.01)
    let coef_copy: ptr<f32> = array_copy_f32(best_model.weights, n_features)
    let intercept_copy: f32 = best_model.bias
    elastic_net_free(best_model)
    array_free_f32(alphas)

    let result: ElasticNetCV = ElasticNetCV {
        alpha: best_alpha,
        l1_ratio: l1_ratio,
        coef: coef_copy,
        intercept: intercept_copy,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function elastic_net_cv_predict(model: ElasticNetCV, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < n {
