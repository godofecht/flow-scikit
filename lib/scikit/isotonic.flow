# Isotonic regression module for flow-scikit.
# Implements pool-adjacent-violators algorithm for monotonic fitting.
# Addresses: scikit-learn isotonic regression with clean API.

import "lib/scikit/matrix.flow"

export struct IsotonicRegression {
    x_min: f32,
    x_max: f32,
    increasing: bool,
    x_thresholds: ptr<f32>,
    y_values: ptr<f32>,
    n_thresholds: i32,
    fitted: bool
}

export function isotonic_fit(X: ptr<f32>, y: ptr<f32>, n: i32, increasing: bool) -> IsotonicRegression {
    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }

    for i in 1 to n {
        let key: i32 = indices[i]
        let key_val: f32 = X[key]
        let mut j: i32 = i - 1
        while j >= 0 && X[indices[j]] > key_val {
            indices[j + 1] = indices[j]
            j = j - 1
        }
        indices[j + 1] = key
    }

    let sorted_x: ptr<f32> = array_new_f32(n)
    let sorted_y: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        sorted_x[i] = X[indices[i]]
        sorted_y[i] = y[indices[i]]
    }

    let y_fit: ptr<f32> = array_copy_f32(sorted_y, n)

    let mut changed: bool = true
    while changed {
        changed = false
        let mut i: i32 = 0
        while i < n - 1 {
            if increasing {
                if y_fit[i] > y_fit[i + 1] {
                    let mut sum: f32 = y_fit[i] + y_fit[i + 1]
                    let mut count: i32 = 2
                    let mut k: i32 = i + 2
                    while k < n && y_fit[k] < y_fit[k - 1] {
                        sum = sum + y_fit[k]
                        count = count + 1
                        k = k + 1
                    }
                    let avg: f32 = sum / (count as f32)
                    for j in i to i + count {
                        y_fit[j] = avg
                    }
                    changed = true
                    i = i + count
                } else {
                    i = i + 1
                }
            } else {
                if y_fit[i] < y_fit[i + 1] {
                    let mut sum: f32 = y_fit[i] + y_fit[i + 1]
                    let mut count: i32 = 2
                    let mut k: i32 = i + 2
                    while k < n && y_fit[k] > y_fit[k - 1] {
                        sum = sum + y_fit[k]
                        count = count + 1
                        k = k + 1
                    }
                    let avg: f32 = sum / (count as f32)
                    for j in i to i + count {
                        y_fit[j] = avg
                    }
                    changed = true
                    i = i + count
                } else {
                    i = i + 1
                }
            }
        }
    }

    let mut n_unique: i32 = 1
    for i in 1 to n {
        if sorted_x[i] != sorted_x[i - 1] {
            n_unique = n_unique + 1
        }
    }

    let thresholds: ptr<f32> = array_new_f32(n_unique)
    let y_vals: ptr<f32> = array_new_f32(n_unique)
    let mut idx: i32 = 0
    thresholds[0] = sorted_x[0]
    y_vals[0] = y_fit[0]
    for i in 1 to n {
        if sorted_x[i] != sorted_x[i - 1] {
            idx = idx + 1
            thresholds[idx] = sorted_x[i]
            y_vals[idx] = y_fit[i]
        }
    }

    let x_min: f32 = thresholds[0]
    let x_max: f32 = thresholds[n_unique - 1]

    free(indices as ptr<void>)
    array_free_f32(sorted_x)
    array_free_f32(sorted_y)
    array_free_f32(y_fit)

    return IsotonicRegression {
        x_min: x_min,
        x_max: x_max,
        increasing: increasing,
        x_thresholds: thresholds,
        y_values: y_vals,
        n_thresholds: n_unique,
        fitted: true
    }
}

export function isotonic_predict(model: IsotonicRegression, X: ptr<f32>, n: i32) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let x: f32 = X[i]
        if x <= model.x_min {
            result[i] = model.y_values[0]
        } else {
            if x >= model.x_max {
                result[i] = model.y_values[model.n_thresholds - 1]
            } else {
                let mut lo: i32 = 0
                let mut hi: i32 = model.n_thresholds - 1
                while hi - lo > 1 {
                    let mid: i32 = (lo + hi) / 2
                    if model.x_thresholds[mid] <= x {
                        lo = mid
                    } else {
                        hi = mid
                    }
                }
                let x0: f32 = model.x_thresholds[lo]
                let x1: f32 = model.x_thresholds[hi]
                let y0: f32 = model.y_values[lo]
                let y1: f32 = model.y_values[hi]
                if x1 - x0 < 1e-10 {
                    result[i] = y0
                } else {
                    let t: f32 = (x - x0) / (x1 - x0)
                    result[i] = y0 + t * (y1 - y0)
                }
            }
        }
    }
    return result
}

export function isotonic_transform(model: IsotonicRegression, y: ptr<f32>, n: i32) -> ptr<f32> {
    return isotonic_predict(model, y, n)
}

export function isotonic_free(model: IsotonicRegression) -> void {
    array_free_f32(model.x_thresholds)
    array_free_f32(model.y_values)
}
