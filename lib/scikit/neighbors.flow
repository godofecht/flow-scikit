# K-Nearest Neighbors for flow-scikit.
# Addresses Issue #28394: predict returns probabilities, decide returns classes.

import "lib/scikit/matrix.flow"

export struct KNNClassifier {
    X_train: Matrix,
    y_train: ptr<f32>,
    classes: ptr<f32>,
    n_classes: i32,
    k: i32,
    fitted: bool
}

export struct KNNRegressor {
    X_train: Matrix,
    y_train: ptr<f32>,
    k: i32,
    fitted: bool
}

export struct Neighbor {
    distance: f32,
    label: f32
}

export function knn_classifier_fit(X: Matrix, y: ptr<f32>, n_classes: i32, k: i32) -> KNNClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    let n: i32 = X.rows

    # Class discovery used to rescan the whole discovered-class list for every
    # sample, which is O(n * n_classes). Label sets are almost always small
    # integers, so when they are, membership is tested against a direct-index
    # table in O(1) and the whole pass becomes O(n). First-appearance order is
    # preserved exactly, so the probability column order that
    # knn_classifier_predict_proba and knn_classifier_decide depend on is
    # unchanged.
    let mut lo: f32 = 0.0
    let mut hi: f32 = 0.0
    let mut use_table: bool = false
    if n > 0 {
        lo = y[0]
        hi = y[0]
        use_table = true
        for i in 0 to n {
            let v: f32 = y[i]
            if v < -1000000.0 || v > 1000000.0 {
                use_table = false
                break
            }
            let t: f32 = (v as i32) as f32
            if t != v {
                use_table = false
                break
            }
            if v < lo { lo = v }
            if v > hi { hi = v }
        }
    }

    let lo_i: i32 = lo as i32
    let mut span: i32 = 1
    if use_table {
        span = (hi as i32) - lo_i + 1
        if span < 1 || span > 4000000 { use_table = false }
    }

    if use_table {
        let seen: ptr<f32> = array_new_f32(span)
        for i in 0 to n {
            let v: f32 = y[i]
            let idx: i32 = (v as i32) - lo_i
            if seen[idx] == 0.0 {
                seen[idx] = 1.0
                if n_found < n_classes {
                    classes[n_found] = v
                    n_found = n_found + 1
                }
            }
        }
        array_free_f32(seen)
    } else {
        for i in 0 to n {
            let v: f32 = y[i]
            let mut found: bool = false
            for c in 0 to n_found {
                if classes[c] == v {
                    found = true
                    break
                }
            }
            if not found {
                if n_found < n_classes {
                    classes[n_found] = v
                    n_found = n_found + 1
                }
            }
        }
    }

    let X_copy: Matrix = matrix_copy(X)
    let y_copy: ptr<f32> = array_copy_f32(y, X.rows)
    let result: KNNClassifier = KNNClassifier {
        X_train: X_copy,
        y_train: y_copy,
        classes: classes,
        n_classes: n_classes,
        k: k,
        fitted: true
    }
    return result
}

export function knn_classifier_predict_proba(model: KNNClassifier, X: Matrix) -> Matrix {
    let probs: Matrix = matrix_new(X.rows, model.n_classes)
    let neighbors: ptr<Neighbor> = malloc((model.k as i64) * 12) as ptr<Neighbor>

    for i in 0 to X.rows {
        for c in 0 to model.n_classes {
            matrix_set(probs, i, c, 0.0)
        }

        for j in 0 to model.k {
            neighbors[j].distance = 9999999999.0
            neighbors[j].label = 0.0
        }

        for j in 0 to model.X_train.rows {
            # Use f64 for distance to match sklearn precision
            let mut dist: f64 = 0.0
            for f in 0 to X.cols {
                let d: f64 = (matrix_at(X, i, f) - matrix_at(model.X_train, j, f)) as f64
                dist = dist + d * d
            }
            let dist_f32: f32 = dist as f32

            let mut worst_idx: i32 = 0
            for n in 1 to model.k {
                if neighbors[n].distance > neighbors[worst_idx].distance {
                    worst_idx = n
                }
            }

            if dist_f32 < neighbors[worst_idx].distance {
                neighbors[worst_idx].distance = dist_f32
                neighbors[worst_idx].label = model.y_train[j]
            }
        }

        for n in 0 to model.k {
            let label: f32 = neighbors[n].label
            for c in 0 to model.n_classes {
                if model.classes[c] == label {
                    let cur: f32 = matrix_at(probs, i, c)
                    matrix_set(probs, i, c, cur + 1.0)
                }
            }
        }

        for c in 0 to model.n_classes {
            let v: f32 = matrix_at(probs, i, c) / (model.k as f32)
            matrix_set(probs, i, c, v)
        }
    }

    free(neighbors as ptr<void>)
    return probs
}

export function knn_classifier_predict(model: KNNClassifier, X: Matrix) -> Matrix {
    let result: Matrix = knn_classifier_predict_proba(model, X)
    return result
}

export function knn_classifier_decide(model: KNNClassifier, probs: Matrix, threshold: f32) -> ptr<f32> {
    let labels: ptr<f32> = array_new_f32(probs.rows)
    for i in 0 to probs.rows {
        let best_idx: i32 = 0
        let best_val: f32 = matrix_at(probs, i, 0)
        for c in 1 to model.n_classes {
            let val: f32 = matrix_at(probs, i, c)
            if val > best_val {
                best_val = val
                best_idx = c
            }
        }
        labels[i] = model.classes[best_idx]
    }
    return labels
}

export function knn_classifier_free(model: KNNClassifier) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.y_train)
    array_free_f32(model.classes)
}

export function knn_regressor_fit(X: Matrix, y: ptr<f32>, k: i32) -> KNNRegressor {
    let X_copy: Matrix = matrix_copy(X)
    let y_copy: ptr<f32> = array_copy_f32(y, X.rows)
    let result: KNNRegressor = KNNRegressor {
        X_train: X_copy,
        y_train: y_copy,
        k: k,
        fitted: true
    }
    return result
}

export function knn_regressor_predict(model: KNNRegressor, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let neighbors: ptr<Neighbor> = malloc((model.k as i64) * 12) as ptr<Neighbor>

    for i in 0 to X.rows {
        for j in 0 to model.k {
            neighbors[j].distance = 9999999999.0
            neighbors[j].label = 0.0
        }

        for j in 0 to model.X_train.rows {
            # Use f64 for distance to match sklearn precision
            let mut dist: f64 = 0.0
            for f in 0 to X.cols {
                let d: f64 = (matrix_at(X, i, f) - matrix_at(model.X_train, j, f)) as f64
                dist = dist + d * d
            }
            let dist_f32: f32 = dist as f32

            let mut worst_idx: i32 = 0
            for n in 1 to model.k {
                if neighbors[n].distance > neighbors[worst_idx].distance {
                    worst_idx = n
                }
            }

            if dist_f32 < neighbors[worst_idx].distance {
                neighbors[worst_idx].distance = dist_f32
                neighbors[worst_idx].label = model.y_train[j]
            }
        }

        let mut sum: f32 = 0.0
        for n in 0 to model.k {
            sum = sum + neighbors[n].label
        }
        preds[i] = sum / (model.k as f32)
    }

    free(neighbors as ptr<void>)
    return preds
}

export function knn_regressor_free(model: KNNRegressor) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.y_train)
}

export struct NearestNeighbors {
    X_train: Matrix,
    n_neighbors: i32,
    fitted: bool
}

export function nearest_neighbors_fit(X: Matrix, n_neighbors: i32) -> NearestNeighbors {
    let X_copy: Matrix = matrix_copy(X)
    let result: NearestNeighbors = NearestNeighbors {
        X_train: X_copy,
        n_neighbors: n_neighbors,
        fitted: true
    }
    return result
}

export struct NeighborResult {
    indices: ptr<i32>,
    distances: ptr<f32>,
    n_neighbors: i32
}

export function nearest_neighbors_kneighbors(model: NearestNeighbors, X: Matrix) -> ptr<NeighborResult> {
    let n: i32 = X.rows
    let results: ptr<NeighborResult> = malloc((n as i64) * 24) as ptr<NeighborResult>

    for i in 0 to n {
        let dists: ptr<f32> = array_new_f32(model.X_train.rows)
        let indices: ptr<i32> = malloc((model.X_train.rows as i64) * 4) as ptr<i32>

        for j in 0 to model.X_train.rows {
            let mut dist: f32 = 0.0
            for k in 0 to X.cols {
                let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                dist = dist + d * d
            }
            dists[j] = sqrt(dist as f64) as f32
            indices[j] = j
        }

        let k: i32 = model.n_neighbors
        if k > model.X_train.rows {
            k = model.X_train.rows
        }

        for s in 0 to k {
            let mut min_idx: i32 = s
            let mut min_val: f32 = dists[s]
            for j in s + 1 to model.X_train.rows {
                if dists[j] < min_val {
                    min_val = dists[j]
                    min_idx = j
                }
            }
            let tmp_d: f32 = dists[s]
            let tmp_i: i32 = indices[s]
            dists[s] = dists[min_idx]
            indices[s] = indices[min_idx]
            dists[min_idx] = tmp_d
            indices[min_idx] = tmp_i
        }

        let k_indices: ptr<i32> = malloc((k as i64) * 4) as ptr<i32>
        let k_dists: ptr<f32> = array_new_f32(k)
        for s in 0 to k {
            k_indices[s] = indices[s]
            k_dists[s] = dists[s]
        }

        results[i] = NeighborResult {
            indices: k_indices,
            distances: k_dists,
            n_neighbors: k
        }

        array_free_f32(dists)
        free(indices as ptr<void>)
    }

    return results
}

export function nearest_neighbors_free_results(results: ptr<NeighborResult>, n: i32) -> void {
    for i in 0 to n {
        free(results[i].indices as ptr<void>)
        array_free_f32(results[i].distances)
    }
    free(results as ptr<void>)
}

export function nearest_neighbors_free(model: NearestNeighbors) -> void {
    matrix_free(model.X_train)
}

# ============================================================================
# RadiusNeighborsClassifier
# ============================================================================

export struct RadiusNeighborsClassifier {
    X_train: Matrix,
    y_train: ptr<f32>,
    radius: f32,
    n_features: i32,
    n_classes: i32,
    outlier_label: f32,
    fitted: bool
}

export function radius_neighbors_classifier_fit(X: Matrix, y: ptr<f32>, radius: f32, n_classes: i32, outlier_label: f32) -> RadiusNeighborsClassifier {
    return RadiusNeighborsClassifier {
        X_train: X,
        y_train: y,
        radius: radius,
        n_features: X.cols,
        n_classes: n_classes,
        outlier_label: outlier_label,
        fitted: true
    }
}

export function radius_neighbors_classifier_predict(model: RadiusNeighborsClassifier, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_class: f32 = model.outlier_label
        let mut best_count: i32 = 0

        for c in 0 to model.n_classes {
            let mut count: i32 = 0
            for j in 0 to model.X_train.rows {
                if model.y_train[j] as i32 != c { continue }
                let mut s: f32 = 0.0
                for k in 0 to model.n_features {
                    let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                    s = s + d * d
                }
                if (sqrt((s as f64)) as f32) <= model.radius {
                    count = count + 1
                }
            }
            if count > best_count {
                best_count = count
                best_class = c as f32
            }
        }

        result[i] = best_class
    }

    return result
}

export function radius_neighbors_classifier_free(model: RadiusNeighborsClassifier) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.y_train)
}

# ============================================================================
# RadiusNeighborsRegressor
# ============================================================================

export struct RadiusNeighborsRegressor {
    X_train: Matrix,
    y_train: ptr<f32>,
    radius: f32,
    n_features: i32,
    fitted: bool
}

export function radius_neighbors_regressor_fit(X: Matrix, y: ptr<f32>, radius: f32) -> RadiusNeighborsRegressor {
    let result: RadiusNeighborsRegressor = RadiusNeighborsRegressor {
        X_train: X,
        y_train: y,
        radius: radius,
        n_features: X.cols,
        fitted: true
    }
    return result
}

export function radius_neighbors_regressor_predict(model: RadiusNeighborsRegressor, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut sum: f32 = 0.0
        let mut count: i32 = 0

        for j in 0 to model.X_train.rows {
            let mut s: f32 = 0.0
            for k in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                s = s + d * d
            }
            if (sqrt((s as f64)) as f32) <= model.radius {
                sum = sum + model.y_train[j]
                count = count + 1
            }
        }

        if count > 0 {
            result[i] = sum / (count as f32)
        } else {
            result[i] = 0.0
        }
    }

    return result
}

export function radius_neighbors_regressor_free(model: RadiusNeighborsRegressor) -> void {
    # X_train and y_train are borrowed, not owned
}

# ============================================================================
# NearestCentroid
# ============================================================================

export struct NearestCentroid {
    centroids: ptr<ptr<f32> >,
    n_classes: i32,
    n_features: i32,
    fitted: bool
}

export function nearest_centroid_fit(X: Matrix, y: ptr<f32>, n_classes: i32) -> NearestCentroid {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let centroids: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for c in 0 to n_classes {
        centroids[c] = array_new_f32(p)
        counts[c] = 0
        for j in 0 to p { centroids[c][j] = 0.0 }
    }

    for i in 0 to n {
        let c: i32 = y[i] as i32
        if c >= 0 && c < n_classes {
            for j in 0 to p {
                centroids[c][j] = centroids[c][j] + matrix_at(X, i, j)
            }
            counts[c] = counts[c] + 1
        }
    }

    for c in 0 to n_classes {
        if counts[c] > 0 {
            for j in 0 to p {
                centroids[c][j] = centroids[c][j] / (counts[c] as f32)
            }
        }
    }

    free(counts as ptr<void>)

    return NearestCentroid {
        centroids: centroids,
        n_classes: n_classes,
        n_features: p,
        fitted: true
    }
}

export function nearest_centroid_predict(model: NearestCentroid, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_dist: f32 = 9999999999.0
        for c in 0 to model.n_classes {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, j) - model.centroids[c][j]
                s = s + d * d
            }
            if s < best_dist {
                best_dist = s
                best_c = c
            }
        }
        result[i] = best_c as f32
    }

    return result
}

export function nearest_centroid_free(model: NearestCentroid) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.centroids[c])
    }
    free(model.centroids as ptr<void>)
}

# ============================================================================
# LocalOutlierFactor
# ============================================================================

export struct LocalOutlierFactor {
    X_train: Matrix,
    lrd: ptr<f32>,
    lof: ptr<f32>,
    n_neighbors: i32,
    n_features: i32,
    n_samples: i32,
    threshold: f32,
    fitted: bool
}

export function local_outlier_factor_fit(X: Matrix, n_neighbors: i32) -> LocalOutlierFactor {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let k: i32 = n_neighbors
    if k > n - 1 { k = n - 1 }

    let dists: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        dists[i] = array_new_f32(n)
        for j in 0 to n {
            let mut s: f32 = 0.0
            for m in 0 to p {
                let d: f32 = matrix_at(X, i, m) - matrix_at(X, j, m)
                s = s + d * d
            }
            dists[i][j] = sqrt((s as f64)) as f32
        }
    }

    let k_dist: ptr<f32> = array_new_f32(n)
    let lrd: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let sorted: ptr<f32> = array_copy_f32(dists[i], n)
        for a in 0 to n {
            for b in 0 to n - 1 - a {
                if sorted[b] > sorted[b + 1] {
                    let t: f32 = sorted[b]
                    sorted[b] = sorted[b + 1]
                    sorted[b + 1] = t
                }
            }
        }
        k_dist[i] = sorted[k]

        let mut reach_sum: f32 = 0.0
        for j in 0 to n {
            if i == j { continue }
            let reach: f32 = dists[i][j]
            if k_dist[j] > reach { reach = k_dist[j] }
            reach_sum = reach_sum + reach
        }
        lrd[i] = (k as f32) / (reach_sum + 0.0000000001)
        array_free_f32(sorted)
    }

    let lof: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut sum_lrd: f32 = 0.0
        let sorted: ptr<f32> = array_copy_f32(dists[i], n)
        let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        for j in 0 to n { indices[j] = j }
        for a in 0 to n {
            for b in 0 to n - 1 - a {
                if sorted[b] > sorted[b + 1] {
                    let t: f32 = sorted[b]
                    sorted[b] = sorted[b + 1]
                    sorted[b + 1] = t
                    let ti: i32 = indices[b]
                    indices[b] = indices[b + 1]
                    indices[b + 1] = ti
                }
            }
        }
        for j in 1 to k + 1 {
            sum_lrd = sum_lrd + lrd[indices[j]]
        }
        lof[i] = sum_lrd / (k as f32) / (lrd[i] + 0.0000000001)
        array_free_f32(sorted)
        free(indices as ptr<void>)
    }

    let mut mean_lof: f32 = 0.0
    for i in 0 to n { mean_lof = mean_lof + lof[i] }
    mean_lof = mean_lof / (n as f32)

    let mut std_lof: f32 = 0.0
    for i in 0 to n {
        let d: f32 = lof[i] - mean_lof
        std_lof = std_lof + d * d
    }
    std_lof = sqrt((std_lof / (n as f32)) as f64) as f32
    let threshold: f32 = mean_lof + 2.0 * std_lof

    for i in 0 to n { array_free_f32(dists[i]) }
    free(dists as ptr<void>)
    array_free_f32(k_dist)

    return LocalOutlierFactor {
        X_train: X,
        lrd: lrd,
        lof: lof,
        n_neighbors: k,
        n_features: p,
        n_samples: n,
        threshold: threshold,
        fitted: true
    }
}

export function local_outlier_factor_predict(model: LocalOutlierFactor) -> ptr<i32> {
    let result: ptr<i32> = malloc((model.n_samples as i64) * 4) as ptr<i32>
    for i in 0 to model.n_samples {
        if model.lof[i] > model.threshold {
            result[i] = -1
        } else {
            result[i] = 1
        }
    }
    return result
}

export function local_outlier_factor_free(model: LocalOutlierFactor) -> void {
    matrix_free(model.X_train)
    array_free_f32(model.lrd)
    array_free_f32(model.lof)
}

# ============================================================================
# KernelDensity
# ============================================================================

export struct KernelDensity {
    X_train: Matrix,
    bandwidth: f32,
    kernel: i32,
    n_samples: i32,
    n_features: i32,
    fitted: bool
}

export function kernel_density_fit(X: Matrix, bandwidth: f32, kernel: i32) -> KernelDensity {
    let X_copy: Matrix = matrix_copy(X)
    let result: KernelDensity = KernelDensity {
        X_train: X_copy,
        bandwidth: bandwidth,
        kernel: kernel,
        n_samples: X.rows,
        n_features: X.cols,
        fitted: true
    }
    return result
}

# kernel: 0 = gaussian, 1 = tophat, 2 = epanechnikov, 3 = exponential,
#         4 = linear, 5 = cosine
function _kernel_density_gaussian(d2: f32, bandwidth: f32, n_features: i32) -> f32 {
    # K(u) = (2*pi)^(-d/2) * exp(-u^2 / 2)
    # With bandwidth h: density = K(u/h) / h^d
    let h: f32 = bandwidth
    let d: f32 = (n_features as f32)
    let norm: f32 = pow(6.283185307 as f64, (-d / 2.0) as f64) as f32
    let e: f32 = exp((-d2 / (2.0 * h * h)) as f64) as f32
    let result: f32 = norm * e / pow((h) as f64, (d) as f64) as f32
    return result
}

function _kernel_density_tophat(d2: f32, bandwidth: f32, n_features: i32) -> f32 {
    # K(u) = 1 if |u| <= 1, else 0
    # Volume of unit ball in d dims: V_d = pi^(d/2) / Gamma(d/2 + 1)
    # Use approximation: V_d ~ pi^(d/2) / (d/2)!
    let h: f32 = bandwidth
    let d: f32 = (n_features as f32)
    let dist: f32 = sqrt(d2 as f64) as f32
    if dist > h { return 0.0 }
    # Volume of d-ball with radius h
    let mut vol: f32 = pow(3.141592654 as f64, (d / 2.0) as f64) as f32
    let mut gamma_denom: f32 = 1.0
    let mut g: i32 = 0
    while g < ((d / 2.0) as i32) {
        gamma_denom = gamma_denom * ((d / 2.0) - (g as f32))
        g = g + 1
    }
    if gamma_denom < 0.0000000001 { gamma_denom = 1.0 }
    vol = vol / gamma_denom
    vol = vol * pow((h) as f64, (d) as f64) as f32
    if vol < 0.0000000001 { return 0.0 }
    return 1.0 / vol
}

function _kernel_density_epanechnikov(d2: f32, bandwidth: f32, n_features: i32) -> f32 {
    # K(u) = (3/4)(1-u^2) for |u| <= 1, in 1D
    # In dD: K(u) = (d+2)/(2 * V_d) * (1 - |u|^2) for |u| <= 1
    let h: f32 = bandwidth
    let d: f32 = (n_features as f32)
    let dist_sq: f32 = d2 / (h * h)
    if dist_sq > 1.0 { return 0.0 }
    let mut vol: f32 = pow(3.141592654 as f64, (d / 2.0) as f64) as f32
    let mut gamma_denom: f32 = 1.0
    let mut g: i32 = 0
    while g < ((d / 2.0) as i32) {
        gamma_denom = gamma_denom * ((d / 2.0) - (g as f32))
        g = g + 1
    }
    if gamma_denom < 0.0000000001 { gamma_denom = 1.0 }
    vol = vol / gamma_denom
    let coeff: f32 = (d + 2.0) / (2.0 * vol)
    let result: f32 = coeff * (1.0 - dist_sq) / pow((h) as f64, (d) as f64) as f32
    return result
}

function _kernel_density_exponential(d2: f32, bandwidth: f32, n_features: i32) -> f32 {
    # K(u) = exp(-|u|) in 1D
    # In dD: K(u) = prod_d exp(-|u_i|) = exp(-sum|u_i|)
    # Approximate with exp(-|u|) / (2^d * prod factorial)
    let h: f32 = bandwidth
    let d: f32 = (n_features as f32)
    let dist: f32 = sqrt(d2 as f64) as f32
    let e: f32 = exp((-dist / h) as f64) as f32
    let norm: f32 = 1.0 / pow((2.0 * h) as f64, (d) as f64) as f32
    return norm * e
}

function _kernel_density_linear(d2: f32, bandwidth: f32, n_features: i32) -> f32 {
    # K(u) = 1 - |u| for |u| <= 1
    let h: f32 = bandwidth
    let d: f32 = (n_features as f32)
    let dist: f32 = sqrt(d2 as f64) as f32
    let u: f32 = dist / h
    if u > 1.0 { return 0.0 }
    let mut vol: f32 = pow(3.141592654 as f64, (d / 2.0) as f64) as f32
    let mut gamma_denom: f32 = 1.0
    let mut g: i32 = 0
    while g < ((d / 2.0) as i32) {
        gamma_denom = gamma_denom * ((d / 2.0) - (g as f32))
        g = g + 1
    }
    if gamma_denom < 0.0000000001 { gamma_denom = 1.0 }
    vol = vol / gamma_denom
    vol = vol * pow((h) as f64, (d) as f64) as f32
    if vol < 0.0000000001 { return 0.0 }
    let coeff: f32 = (d + 2.0) / (2.0 * vol / (h as f32))
    return coeff * (1.0 - u) / pow((h) as f64, (d) as f64) as f32
}

function _kernel_density_cosine(d2: f32, bandwidth: f32, n_features: i32) -> f32 {
    # K(u) = (pi/4) * cos(pi/2 * |u|) for |u| <= 1
    let h: f32 = bandwidth
    let d: f32 = (n_features as f32)
    let dist: f32 = sqrt(d2 as f64) as f32
    let u: f32 = dist / h
    if u > 1.0 { return 0.0 }
    let c: f32 = cos((1.5707963 * u) as f64) as f32
    let norm: f32 = pow((1.0 / h) as f64, (d) as f64) as f32
    let coeff: f32 = 0.78539815 * (d + 2.0)
    return coeff * c * norm
}

export function kernel_density_score_samples(model: KernelDensity, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    let mut i: i32 = 0
    while i < n {
        let mut total: f32 = 0.0
        let mut j: i32 = 0
        while j < model.n_samples {
            let mut d2: f32 = 0.0
            let mut k: i32 = 0
            while k < model.n_features {
                let d: f32 = matrix_at(X, i, k) - matrix_at(model.X_train, j, k)
                d2 = d2 + d * d
                k = k + 1
            }
            if model.kernel == 0 {
                total = total + _kernel_density_gaussian(d2, model.bandwidth, model.n_features)
            } elif model.kernel == 1 {
                total = total + _kernel_density_tophat(d2, model.bandwidth, model.n_features)
            } elif model.kernel == 2 {
                total = total + _kernel_density_epanechnikov(d2, model.bandwidth, model.n_features)
            } elif model.kernel == 3 {
                total = total + _kernel_density_exponential(d2, model.bandwidth, model.n_features)
            } elif model.kernel == 4 {
                total = total + _kernel_density_linear(d2, model.bandwidth, model.n_features)
            } elif model.kernel == 5 {
                total = total + _kernel_density_cosine(d2, model.bandwidth, model.n_features)
            } else {
                total = total + _kernel_density_gaussian(d2, model.bandwidth, model.n_features)
            }
            j = j + 1
        }
        result[i] = total / (model.n_samples as f32)
        i = i + 1
    }
    return result
}

export function kernel_density_sample(model: KernelDensity, n_samples: i32, seed: i32) -> Matrix {
    srand(seed)
    let result: Matrix = matrix_new(n_samples, model.n_features)
    let mut i: i32 = 0
    while i < n_samples {
        # Pick a random training point
        let idx: i32 = rand() % model.n_samples
        # Add gaussian noise
        let mut j: i32 = 0
        while j < model.n_features {
            # Box-Muller for gaussian noise
            let u1: f32 = ((rand() % 10000) as f32) / 10000.0 + 0.0001
            let u2: f32 = ((rand() % 10000) as f32) / 10000.0
            let r: f32 = sqrt((-2.0 * log((u1) as f64)) as f32)
            let z: f32 = r * cos((2.0 * 3.141592653 * u2) as f32)
            let v: f32 = matrix_at(model.X_train, idx, j) + model.bandwidth * z
            matrix_set(result, i, j, v)
            j = j + 1
        }
        i = i + 1
    }
    return result
}

export function kernel_density_free(model: KernelDensity) -> void {
    matrix_free(model.X_train)
}

# ============================================================================
# KNeighborsTransformer
# ============================================================================

export struct KNeighborsTransformer {
    X_train: Matrix,
    n_neighbors: i32,
    mode: i32,
    fitted: bool
}

export function kneighbors_transformer_fit(X: Matrix, n_neighbors: i32, mode: i32) -> KNeighborsTransformer {
    let X_copy: Matrix = matrix_copy(X)
    let result: KNeighborsTransformer = KNeighborsTransformer {
        X_train: X_copy,
        n_neighbors: n_neighbors,
        mode: mode,
        fitted: true
    }
    return result
}

export function kneighbors_transformer_transform(model: KNeighborsTransformer, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let n_train: i32 = model.X_train.rows
    let k: i32 = model.n_neighbors
    if k > n_train { k = n_train }
    let result: Matrix = matrix_new(n, n_train)
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = 0
        while j < n_train {
            matrix_set(result, i, j, 0.0)
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < n {
        let dists: ptr<f32> = array_new_f32(n_train)
        let mut j: i32 = 0
        while j < n_train {
            let mut d: f32 = 0.0
            let mut f: i32 = 0
            while f < model.X_train.cols {
                let diff: f32 = matrix_at(X, i, f) - matrix_at(model.X_train, j, f)
                d = d + diff * diff
                f = f + 1
            }
            dists[j] = sqrt((d) as f64) as f32
            j = j + 1
        }
        let mut kk: i32 = 0
        while kk < k {
            let mut best_j: i32 = -1
            let mut best_d: f32 = 9999999999.0
            let mut j2: i32 = 0
            while j2 < n_train {
                if dists[j2] < best_d && dists[j2] >= 0.0 {
                    best_d = dists[j2]
                    best_j = j2
                }
                j2 = j2 + 1
            }
            if best_j >= 0 {
                if model.mode == 1 {
                    matrix_set(result, i, best_j, best_d)
                } else {
                    matrix_set(result, i, best_j, 1.0)
                }
                dists[best_j] = -1.0
            }
            kk = kk + 1
        }
        array_free_f32(dists)
        i = i + 1
    }
    return result
}

export function kneighbors_transformer_free(model: KNeighborsTransformer) -> void {
    matrix_free(model.X_train)
}

# ============================================================================
# RadiusNeighborsTransformer
# ============================================================================

export struct RadiusNeighborsTransformer {
    X_train: Matrix,
    radius: f32,
    mode: i32,
    fitted: bool
}

export function radius_neighbors_transformer_fit(X: Matrix, radius: f32, mode: i32) -> RadiusNeighborsTransformer {
    let X_copy: Matrix = matrix_copy(X)
    let result: RadiusNeighborsTransformer = RadiusNeighborsTransformer {
        X_train: X_copy,
        radius: radius,
        mode: mode,
        fitted: true
    }
    return result
}

export function radius_neighbors_transformer_transform(model: RadiusNeighborsTransformer, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let n_train: i32 = model.X_train.rows
    let result: Matrix = matrix_new(n, n_train)
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = 0
        while j < n_train {
            let mut d: f32 = 0.0
            let mut f: i32 = 0
            while f < model.X_train.cols {
                let diff: f32 = matrix_at(X, i, f) - matrix_at(model.X_train, j, f)
                d = d + diff * diff
                f = f + 1
            }
            d = sqrt((d) as f64) as f32
            if d <= model.radius {
                if model.mode == 1 {
                    matrix_set(result, i, j, d)
                } else {
                    matrix_set(result, i, j, 1.0)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return result
}

export function radius_neighbors_transformer_free(model: RadiusNeighborsTransformer) -> void {
    matrix_free(model.X_train)
}
