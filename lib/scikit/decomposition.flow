# Decomposition module for flow-scikit.
# Implements PCA via power iteration for eigendecomposition of covariance matrix.

import "lib/scikit/matrix.flow"

extern {
    function tanh(x: f64) -> f64
    function srand(seed: i32) -> void
    function rand() -> i32
}

export struct PCA {
    components: ptr<ptr<f32>>,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    explained_variance: ptr<f32>,
    explained_variance_ratio: ptr<f32>,
    total_variance: f32,
    fitted: bool
}

export function pca_fit(X: Matrix, n_components: i32) -> PCA {
    let n_features: i32 = X.cols
    let mean: ptr<f32> = array_new_f32(n_features)

    for j in 0 to n_features {
        let col: ptr<f32> = array_new_f32(X.rows)
        for i in 0 to X.rows {
            col[i] = matrix_at(X, i, j)
        }
        mean[j] = array_mean(col, X.rows)
        array_free_f32(col)
    }

    let cov: Matrix = matrix_new(n_features, n_features)
    for j1 in 0 to n_features {
        for j2 in 0 to n_features {
            let mut sum: f32 = 0.0
            for i in 0 to X.rows {
                let d1: f32 = matrix_at(X, i, j1) - mean[j1]
                let d2: f32 = matrix_at(X, i, j2) - mean[j2]
                sum = sum + d1 * d2
            }
            matrix_set(cov, j1, j2, sum / ((X.rows as f32) - 1.0))
        }
    }

    let components: ptr<ptr<f32>> = malloc((n_components as i64) * 8) as ptr<ptr<f32>>
    let explained_variance: ptr<f32> = array_new_f32(n_components)

    let cov_copy: Matrix = matrix_copy(cov)

    for c in 0 to n_components {
        let eigvec: ptr<f32> = array_new_f32(n_features)
        for j in 0 to n_features {
            eigvec[j] = 1.0 / sqrt((n_features as f64) as f32)
        }

        for _ in 0 to 100 {
            let new_vec: ptr<f32> = array_new_f32(n_features)
            for j1 in 0 to n_features {
                let mut sum: f32 = 0.0
                for j2 in 0 to n_features {
                    sum = sum + matrix_at(cov_copy, j1, j2) * eigvec[j2]
                }
                new_vec[j1] = sum
            }

            let norm: f32 = 0.0
            for j in 0 to n_features {
                norm = norm + new_vec[j] * new_vec[j]
            }
            norm = sqrt(norm as f64) as f32
            if norm < 1e-10 {
                norm = 1.0
            }
            for j in 0 to n_features {
                eigvec[j] = new_vec[j] / norm
            }
            array_free_f32(new_vec)
        }

        let eigval: f32 = 0.0
        let tmp: ptr<f32> = array_new_f32(n_features)
        for j1 in 0 to n_features {
            let mut sum: f32 = 0.0
            for j2 in 0 to n_features {
                sum = sum + matrix_at(cov_copy, j1, j2) * eigvec[j2]
            }
            tmp[j1] = sum
        }
        for j in 0 to n_features {
            eigval = eigval + eigvec[j] * tmp[j]
        }
        array_free_f32(tmp)

        for j1 in 0 to n_features {
            for j2 in 0 to n_features {
                let val: f32 = matrix_at(cov_copy, j1, j2) - eigval * eigvec[j1] * eigvec[j2]
                matrix_set(cov_copy, j1, j2, val)
            }
        }

        components[c] = eigvec
        explained_variance[c] = eigval
    }

    let mut total_var: f32 = 0.0
    for j in 0 to n_features {
        total_var = total_var + matrix_at(cov, j, j)
    }

    let explained_variance_ratio: ptr<f32> = array_new_f32(n_components)
    for c in 0 to n_components {
        if total_var > 1e-10 {
            explained_variance_ratio[c] = explained_variance[c] / total_var
        } else {
            explained_variance_ratio[c] = 0.0
        }
    }

    matrix_free(cov)
    matrix_free(cov_copy)

    return PCA {
        components: components,
        n_components: n_components,
        n_features: n_features,
        mean: mean,
        explained_variance: explained_variance,
        explained_variance_ratio: explained_variance_ratio,
        total_variance: total_var,
        fitted: true
    }
}

export function pca_transform(model: PCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for j in 0 to model.n_features {
                sum = sum + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j]
            }
            matrix_set(result, i, c, sum)
        }
    }
    return result
}

export function pca_inverse_transform(model: PCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_features)
    for i in 0 to X.rows {
        for j in 0 to model.n_features {
            let mut sum: f32 = model.mean[j]
            for c in 0 to model.n_components {
                sum = sum + matrix_at(X, i, c) * model.components[c][j]
            }
            matrix_set(result, i, j, sum)
        }
    }
    return result
}

export function pca_free(model: PCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
    array_free_f32(model.explained_variance)
    array_free_f32(model.explained_variance_ratio)
}

export function pca_print_summary(model: PCA) -> void {
    println("PCA Summary")
    println("===========")
    let mut cumulative: f32 = 0.0
    for c in 0 to model.n_components {
        print("  PC")
        print(c + 1)
        print(": explained variance = ")
        printf("%.4f", model.explained_variance[c])
        print("  ratio = ")
        printf("%.4f", model.explained_variance_ratio[c])
        cumulative = cumulative + model.explained_variance_ratio[c]
        print("  cumulative = ")
        printf("%.4f", cumulative)
        println("")
    }
}

export struct NMF {
    W: ptr<f32>,
    H: ptr<f32>,
    n_components: i32,
    n_samples: i32,
    n_features: i32,
    reconstruction_err: f32,
    n_iter: i32,
    fitted: bool
}

export function nmf_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> NMF {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let k: i32 = n_components

    srand(seed)

    let W: ptr<f32> = array_new_f32(n * k)
    let H: ptr<f32> = array_new_f32(k * p)

    for i in 0 to n * k {
        W[i] = ((rand() % 100) as f32) / 100.0 + 0.01
    }
    for i in 0 to k * p {
        H[i] = ((rand() % 100) as f32) / 100.0 + 0.01
    }

    let mut prev_err: f32 = 1e10

    for iter in 0 to max_iter {
        let H_new: ptr<f32> = array_new_f32(k * p)
        for a in 0 to k {
            for b in 0 to p {
                let mut numerator: f32 = 0.0
                let mut denominator: f32 = 0.0
                for i in 0 to n {
                    let mut wh: f32 = 0.0
                    for j in 0 to k {
                        wh = wh + W[i * k + j] * H[j * p + b]
                    }
                    numerator = numerator + W[i * k + a] * matrix_at(X, i, b)
                    denominator = denominator + W[i * k + a] * wh
                }
                if denominator < 1e-10 { denominator = 1e-10 }
                H_new[a * p + b] = H[a * p + b] * numerator / denominator
            }
        }
        for i in 0 to k * p {
            H[i] = H_new[i]
        }
        array_free_f32(H_new)

        let W_new: ptr<f32> = array_new_f32(n * k)
        for i in 0 to n {
            for a in 0 to k {
                let mut numerator: f32 = 0.0
                let mut denominator: f32 = 0.0
                for b in 0 to p {
                    let mut wh: f32 = 0.0
                    for j in 0 to k {
                        wh = wh + W[i * k + j] * H[j * p + b]
                    }
                    numerator = numerator + H[a * p + b] * matrix_at(X, i, b)
                    denominator = denominator + wh * H[a * p + b]
                }
                if denominator < 1e-10 { denominator = 1e-10 }
                W_new[i * k + a] = W[i * k + a] * numerator / denominator
            }
        }
        for i in 0 to n * k {
            W[i] = W_new[i]
        }
        array_free_f32(W_new)

        let mut err: f32 = 0.0
        for i in 0 to n {
            for b in 0 to p {
                let mut wh: f32 = 0.0
                for j in 0 to k {
                    wh = wh + W[i * k + j] * H[j * p + b]
                }
                let d: f32 = matrix_at(X, i, b) - wh
                err = err + d * d
            }
        }
        err = sqrt(err as f64) as f32

        if fabs((prev_err - err) as f64) as f32 < tol {
            break
        }
        prev_err = err
    }

    return NMF {
        W: W,
        H: H,
        n_components: k,
        n_samples: n,
        n_features: p,
        reconstruction_err: prev_err,
        n_iter: max_iter,
        fitted: true
    }
}

export function nmf_transform(model: NMF, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    let H_trans: Matrix = matrix_new(model.n_features, model.n_components)
    for i in 0 to model.n_components {
        for j in 0 to model.n_features {
            matrix_set(H_trans, j, i, model.H[i * model.n_features + j])
        }
    }
    for i in 0 to X.rows {
        for a in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for b in 0 to X.cols {
                sum = sum + matrix_at(X, i, b) * matrix_at(H_trans, b, a)
            }
            matrix_set(result, i, a, sum)
        }
    }
    matrix_free(H_trans)
    return result
}

export function nmf_free(model: NMF) -> void {
    array_free_f32(model.W)
    array_free_f32(model.H)
}

export struct TruncatedSVD {
    components: ptr<ptr<f32>>,
    n_components: i32,
    n_features: i32,
    explained_variance: ptr<f32>,
    explained_variance_ratio: ptr<f32>,
    fitted: bool
}

export function truncated_svd_fit(X: Matrix, n_components: i32) -> TruncatedSVD {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let At: Matrix = matrix_transpose(X)
    let AtA: Matrix = matrix_multiply(At, X)

    let components: ptr<ptr<f32>> = malloc((n_components as i64) * 8) as ptr<ptr<f32>>
    let explained_variance: ptr<f32> = array_new_f32(n_components)

    let AtA_copy: Matrix = matrix_copy(AtA)

    for c in 0 to n_components {
        let eigvec: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            eigvec[j] = 1.0 / sqrt((p as f64) as f32)
        }

        for _ in 0 to 100 {
            let new_vec: ptr<f32> = array_new_f32(p)
            for j1 in 0 to p {
                let mut sum: f32 = 0.0
                for j2 in 0 to p {
                    sum = sum + matrix_at(AtA_copy, j1, j2) * eigvec[j2]
                }
                new_vec[j1] = sum
            }

            let mut norm: f32 = 0.0
            for j in 0 to p {
                norm = norm + new_vec[j] * new_vec[j]
            }
            norm = sqrt(norm as f64) as f32
            if norm < 1e-10 { norm = 1.0 }
            for j in 0 to p {
                eigvec[j] = new_vec[j] / norm
            }
            array_free_f32(new_vec)
        }

        let mut eigval: f32 = 0.0
        let tmp: ptr<f32> = array_new_f32(p)
        for j1 in 0 to p {
            let mut sum: f32 = 0.0
            for j2 in 0 to p {
                sum = sum + matrix_at(AtA_copy, j1, j2) * eigvec[j2]
            }
            tmp[j1] = sum
        }
        for j in 0 to p {
            eigval = eigval + eigvec[j] * tmp[j]
        }
        array_free_f32(tmp)

        for j1 in 0 to p {
            for j2 in 0 to p {
                let val: f32 = matrix_at(AtA_copy, j1, j2) - eigval * eigvec[j1] * eigvec[j2]
                matrix_set(AtA_copy, j1, j2, val)
            }
        }

        components[c] = eigvec
        explained_variance[c] = eigval
    }

    let mut total_var: f32 = 0.0
    for j in 0 to p {
        total_var = total_var + matrix_at(AtA, j, j)
    }

    let explained_variance_ratio: ptr<f32> = array_new_f32(n_components)
    for c in 0 to n_components {
        if total_var > 1e-10 {
            explained_variance_ratio[c] = explained_variance[c] / total_var
        } else {
            explained_variance_ratio[c] = 0.0
        }
    }

    matrix_free(At)
    matrix_free(AtA)
    matrix_free(AtA_copy)

    return TruncatedSVD {
        components: components,
        n_components: n_components,
        n_features: p,
        explained_variance: explained_variance,
        explained_variance_ratio: explained_variance_ratio,
        fitted: true
    }
}

export function truncated_svd_transform(model: TruncatedSVD, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for j in 0 to model.n_features {
                sum = sum + matrix_at(X, i, j) * model.components[c][j]
            }
            matrix_set(result, i, c, sum)
        }
    }
    return result
}

export function truncated_svd_free(model: TruncatedSVD) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.explained_variance)
    array_free_f32(model.explained_variance_ratio)
}

# ============================================================================
# FastICA
# ============================================================================

export struct FastICA {
    components: ptr<ptr<f32>>,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    mixing: ptr<ptr<f32>>,
    n_iter: i32,
    fitted: bool
}

function _tanh_derivative(x: f32) -> f32 {
    let t: f32 = tanh((x) as f64) as f32
    return 1.0 - t * t
}

function _gram_schmidt(row: ptr<f32>, basis: ptr<ptr<f32>>, n_basis: i32, n_features: i32) -> void {
    for b in 0 to n_basis {
        let mut dot: f32 = 0.0
        for j in 0 to n_features {
            dot = dot + row[j] * basis[b][j]
        }
        for j in 0 to n_features {
            row[j] = row[j] - dot * basis[b][j]
        }
    }
    let mut norm: f32 = 0.0
    for j in 0 to n_features {
        norm = norm + row[j] * row[j]
    }
    norm = sqrt((norm as f64)) as f32
    if norm > 1e-10 {
        for j in 0 to n_features {
            row[j] = row[j] / norm
        }
    }
}

export function fast_ica_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> FastICA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    # Whitening via PCA
    let cov: Matrix = matrix_new(p, p)
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                s = s + matrix_at(Xc, k, i) * matrix_at(Xc, k, j)
            }
            matrix_set(cov, i, j, s / (n as f32))
        }
    }

    let pca_model: PCA = pca_fit(X, n_components)
    let whitening: ptr<ptr<f32>> = malloc((n_components as i64) * 8) as ptr<ptr<f32>>
    for c in 0 to n_components {
        whitening[c] = array_new_f32(p)
        let ev: f32 = pca_model.explained_variance[c]
        if ev < 1e-10 { ev = 1e-10 }
        for j in 0 to p {
            whitening[c][j] = pca_model.components[c][j] / sqrt((ev as f64)) as f32
        }
    }

    let Xw: Matrix = matrix_new(n, n_components)
    for i in 0 to n {
        for c in 0 to n_components {
            let mut s: f32 = 0.0
            for j in 0 to p {
                s = s + matrix_at(Xc, i, j) * whitening[c][j]
            }
            matrix_set(Xw, i, c, s)
        }
    }

    srand(seed)

    let components: ptr<ptr<f32>> = malloc((n_components as i64) * 8) as ptr<ptr<f32>>
    let mut n_iter: i32 = 0

    for c in 0 to n_components {
        components[c] = array_new_f32(n_components)
        for j in 0 to n_components {
            components[c][j] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }
        _gram_schmidt(components[c], components, c, n_components)

        for iter in 0 to max_iter {
            n_iter = iter + 1

            let w_old: ptr<f32> = array_copy_f32(components[c], n_components)

            let gw: ptr<f32> = array_new_f32(n_components)
            let g_w: ptr<f32> = array_new_f32(n_components)

            for i in 0 to n {
                let mut dot: f32 = 0.0
                for j in 0 to n_components {
                    dot = dot + components[c][j] * matrix_at(Xw, i, j)
                }
                let t: f32 = tanh((dot) as f64) as f32
                let g_deriv: f32 = 1.0 - t * t

                for j in 0 to n_components {
                    gw[j] = gw[j] + t * matrix_at(Xw, i, j)
                    g_w[j] = g_w[j] + g_deriv * components[c][j]
                }
            }

            for j in 0 to n_components {
                components[c][j] = (gw[j] - g_w[j] * components[c][j]) / (n as f32)
            }

            _gram_schmidt(components[c], components, c, n_components)

            let mut dot: f32 = 0.0
            for j in 0 to n_components {
                dot = dot + components[c][j] * w_old[j]
            }
            let convergence: f32 = fabs((fabs((dot) as f64) as f32 - 1.0) as f64) as f32

            array_free_f32(w_old)
            array_free_f32(gw)
            array_free_f32(g_w)

            if convergence < tol { break }
        }
    }

    let mixing: ptr<ptr<f32>> = malloc((n_components as i64) * 8) as ptr<ptr<f32>>
    for c in 0 to n_components {
        mixing[c] = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n_components {
                s = s + components[c][k] * whitening[c][j]
            }
            mixing[c][j] = s
        }
    }

    for c in 0 to n_components {
        array_free_f32(whitening[c])
    }
    free(whitening as ptr<void>)
    matrix_free(Xw)
    matrix_free(Xc)
    matrix_free(cov)
    pca_free(pca_model)

    return FastICA {
        components: components,
        n_components: n_components,
        n_features: p,
        mean: mean,
        mixing: mixing,
        n_iter: n_iter,
        fitted: true
    }
}

export function fast_ica_transform(model: FastICA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.mixing[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function fast_ica_free(model: FastICA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
        array_free_f32(model.mixing[c])
    }
    free(model.components as ptr<void>)
    free(model.mixing as ptr<void>)
    array_free_f32(model.mean)
}

# ============================================================================
# SparsePCA
# ============================================================================

export struct SparsePCA {
    components: ptr<ptr<f32>>,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    alpha: f32,
    n_iter: i32,
    fitted: bool
}

export function sparse_pca_fit(X: Matrix, n_components: i32, alpha: f32, max_iter: i32, tol: f32, seed: i32) -> SparsePCA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    srand(seed)

    let components: ptr<ptr<f32>> = malloc((n_components as i64) * 8) as ptr<ptr<f32>>
    let mut n_iter: i32 = 0

    for c in 0 to n_components {
        components[c] = array_new_f32(p)
        for j in 0 to p {
            components[c][j] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }
        let mut norm: f32 = 0.0
        for j in 0 to p {
            norm = norm + components[c][j] * components[c][j]
        }
        norm = sqrt((norm as f64)) as f32
        if norm > 1e-10 {
            for j in 0 to p {
                components[c][j] = components[c][j] / norm
            }
        }

        for iter in 0 to max_iter {
            n_iter = iter + 1

            let grad: ptr<f32> = array_new_f32(p)
            for i in 0 to n {
                let mut dot: f32 = 0.0
                for j in 0 to p {
                    dot = dot + components[c][j] * matrix_at(Xc, i, j)
                }
                for j in 0 to p {
                    grad[j] = grad[j] - dot * matrix_at(Xc, i, j)
                }
            }

            for j in 0 to p {
                grad[j] = grad[j] / (n as f32)
            }

            let lr: f32 = 0.01
            for j in 0 to p {
                components[c][j] = components[c][j] - lr * grad[j]
            }

            for j in 0 to p {
                if components[c][j] > alpha {
                    components[c][j] = components[c][j] - alpha
                } elif components[c][j] < -alpha {
                    components[c][j] = components[c][j] + alpha
                } else {
                    components[c][j] = 0.0
                }
            }

            let mut norm: f32 = 0.0
            for j in 0 to p {
                norm = norm + components[c][j] * components[c][j]
            }
            norm = sqrt((norm as f64)) as f32
            if norm > 1e-10 {
                for j in 0 to p {
                    components[c][j] = components[c][j] / norm
                }
            }

            array_free_f32(grad)

            if iter > 0 && iter % 10 == 0 {
                let mut change: f32 = 0.0
                for j in 0 to p {
                    change = change + fabs((grad[j]) as f64) as f32
                }
                if change / (p as f32) < tol { break }
            }
        }
    }

    matrix_free(Xc)

    return SparsePCA {
        components: components,
        n_components: n_components,
        n_features: p,
        mean: mean,
        alpha: alpha,
        n_iter: n_iter,
        fitted: true
    }
}

export function sparse_pca_transform(model: SparsePCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function sparse_pca_free(model: SparsePCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
}
