# Decomposition module for flow-scikit.
# Implements PCA via power iteration for eigendecomposition of covariance matrix.

import "lib/scikit/matrix.flow"

extern {
    function tanh(x: f64) -> f64
    function srand(seed: u32) -> void
    function rand() -> i32
}

export struct PCA {
    components: ptr<ptr<f32> >,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    explained_variance: ptr<f32>,
    explained_variance_ratio: ptr<f32>,
    total_variance: f32,
    fitted: bool
}

export function pca_fit(X: Matrix, n_components: i32) -> PCA {
    let n_features: i32 = X.cols
    let mean: ptr<f32> = array_new_f32(n_features)

    for j in 0 to n_features {
        let col: ptr<f32> = array_new_f32(X.rows)
        for i in 0 to X.rows {
            col[i] = matrix_at(X, i, j)
        }
        mean[j] = array_mean(col, X.rows)
        array_free_f32(col)
    }

    let cov: Matrix = matrix_new(n_features, n_features)
    for j1 in 0 to n_features {
        for j2 in 0 to n_features {
            let mut sum: f32 = 0.0
            for i in 0 to X.rows {
                let d1: f32 = matrix_at(X, i, j1) - mean[j1]
                let d2: f32 = matrix_at(X, i, j2) - mean[j2]
                sum = sum + d1 * d2
            }
            matrix_set(cov, j1, j2, sum / ((X.rows as f32) - 1.0))
        }
    }

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let explained_variance: ptr<f32> = array_new_f32(n_components)

    let cov_copy: Matrix = matrix_copy(cov)

    for c in 0 to n_components {
        let eigvec: ptr<f32> = array_new_f32(n_features)
        for j in 0 to n_features {
            eigvec[j] = 1.0 / sqrt((n_features as f64) as f32)
        }

        for _ in 0 to 100 {
            let new_vec: ptr<f32> = array_new_f32(n_features)
            for j1 in 0 to n_features {
                let mut sum: f32 = 0.0
                for j2 in 0 to n_features {
                    sum = sum + matrix_at(cov_copy, j1, j2) * eigvec[j2]
                }
                new_vec[j1] = sum
            }

            let norm: f32 = 0.0
            for j in 0 to n_features {
                norm = norm + new_vec[j] * new_vec[j]
            }
            norm = sqrt(norm as f64) as f32
            if norm < 1e-10 {
                norm = 1.0
            }
            for j in 0 to n_features {
                eigvec[j] = new_vec[j] / norm
            }
            array_free_f32(new_vec)
        }

        let eigval: f32 = 0.0
        let tmp: ptr<f32> = array_new_f32(n_features)
        for j1 in 0 to n_features {
            let mut sum: f32 = 0.0
            for j2 in 0 to n_features {
                sum = sum + matrix_at(cov_copy, j1, j2) * eigvec[j2]
            }
            tmp[j1] = sum
        }
        for j in 0 to n_features {
            eigval = eigval + eigvec[j] * tmp[j]
        }
        array_free_f32(tmp)

        for j1 in 0 to n_features {
            for j2 in 0 to n_features {
                let val: f32 = matrix_at(cov_copy, j1, j2) - eigval * eigvec[j1] * eigvec[j2]
                matrix_set(cov_copy, j1, j2, val)
            }
        }

        components[c] = eigvec
        explained_variance[c] = eigval
    }

    let mut total_var: f32 = 0.0
    for j in 0 to n_features {
        total_var = total_var + matrix_at(cov, j, j)
    }

    let explained_variance_ratio: ptr<f32> = array_new_f32(n_components)
    for c in 0 to n_components {
        if total_var > 1e-10 {
            explained_variance_ratio[c] = explained_variance[c] / total_var
        } else {
            explained_variance_ratio[c] = 0.0
        }
    }

    matrix_free(cov)
    matrix_free(cov_copy)

    return PCA {
        components: components,
        n_components: n_components,
        n_features: n_features,
        mean: mean,
        explained_variance: explained_variance,
        explained_variance_ratio: explained_variance_ratio,
        total_variance: total_var,
        fitted: true
    }
}

export function pca_transform(model: PCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for j in 0 to model.n_features {
                sum = sum + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j]
            }
            matrix_set(result, i, c, sum)
        }
    }
    return result
}

export function pca_inverse_transform(model: PCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_features)
    for i in 0 to X.rows {
        for j in 0 to model.n_features {
            let mut sum: f32 = model.mean[j]
            for c in 0 to model.n_components {
                sum = sum + matrix_at(X, i, c) * model.components[c][j]
            }
            matrix_set(result, i, j, sum)
        }
    }
    return result
}

export function pca_free(model: PCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
    array_free_f32(model.explained_variance)
    array_free_f32(model.explained_variance_ratio)
}

export function pca_print_summary(model: PCA) -> void {
    println("PCA Summary")
    println("===========")
    let mut cumulative: f32 = 0.0
    for c in 0 to model.n_components {
        print("  PC")
        print(c + 1)
        print(": explained variance = ")
        printf("%.4f", model.explained_variance[c])
        print("  ratio = ")
        printf("%.4f", model.explained_variance_ratio[c])
        cumulative = cumulative + model.explained_variance_ratio[c]
        print("  cumulative = ")
        printf("%.4f", cumulative)
        println("")
    }
}

export struct NMF {
    W: ptr<f32>,
    H: ptr<f32>,
    n_components: i32,
    n_samples: i32,
    n_features: i32,
    reconstruction_err: f32,
    n_iter: i32,
    fitted: bool
}

export function nmf_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> NMF {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let k: i32 = n_components

    srand(seed)

    let W: ptr<f32> = array_new_f32(n * k)
    let H: ptr<f32> = array_new_f32(k * p)

    for i in 0 to n * k {
        W[i] = ((rand() % 100) as f32) / 100.0 + 0.01
    }
    for i in 0 to k * p {
        H[i] = ((rand() % 100) as f32) / 100.0 + 0.01
    }

    let mut prev_err: f32 = 1e10

    for iter in 0 to max_iter {
        let H_new: ptr<f32> = array_new_f32(k * p)
        for a in 0 to k {
            for b in 0 to p {
                let mut numerator: f32 = 0.0
                let mut denominator: f32 = 0.0
                for i in 0 to n {
                    let mut wh: f32 = 0.0
                    for j in 0 to k {
                        wh = wh + W[i * k + j] * H[j * p + b]
                    }
                    numerator = numerator + W[i * k + a] * matrix_at(X, i, b)
                    denominator = denominator + W[i * k + a] * wh
                }
                if denominator < 1e-10 { denominator = 1e-10 }
                H_new[a * p + b] = H[a * p + b] * numerator / denominator
            }
        }
        for i in 0 to k * p {
            H[i] = H_new[i]
        }
        array_free_f32(H_new)

        let W_new: ptr<f32> = array_new_f32(n * k)
        for i in 0 to n {
            for a in 0 to k {
                let mut numerator: f32 = 0.0
                let mut denominator: f32 = 0.0
                for b in 0 to p {
                    let mut wh: f32 = 0.0
                    for j in 0 to k {
                        wh = wh + W[i * k + j] * H[j * p + b]
                    }
                    numerator = numerator + H[a * p + b] * matrix_at(X, i, b)
                    denominator = denominator + wh * H[a * p + b]
                }
                if denominator < 1e-10 { denominator = 1e-10 }
                W_new[i * k + a] = W[i * k + a] * numerator / denominator
            }
        }
        for i in 0 to n * k {
            W[i] = W_new[i]
        }
        array_free_f32(W_new)

        let mut err: f32 = 0.0
        for i in 0 to n {
            for b in 0 to p {
                let mut wh: f32 = 0.0
                for j in 0 to k {
                    wh = wh + W[i * k + j] * H[j * p + b]
                }
                let d: f32 = matrix_at(X, i, b) - wh
                err = err + d * d
            }
        }
        err = sqrt(err as f64) as f32

        if (fabs((prev_err - err) as f64) as f32) < tol {
            break
        }
        prev_err = err
    }

    return NMF {
        W: W,
        H: H,
        n_components: k,
        n_samples: n,
        n_features: p,
        reconstruction_err: prev_err,
        n_iter: max_iter,
        fitted: true
    }
}

export function nmf_transform(model: NMF, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    let H_trans: Matrix = matrix_new(model.n_features, model.n_components)
    for i in 0 to model.n_components {
        for j in 0 to model.n_features {
            matrix_set(H_trans, j, i, model.H[i * model.n_features + j])
        }
    }
    for i in 0 to X.rows {
        for a in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for b in 0 to X.cols {
                sum = sum + matrix_at(X, i, b) * matrix_at(H_trans, b, a)
            }
            matrix_set(result, i, a, sum)
        }
    }
    matrix_free(H_trans)
    return result
}

export function nmf_free(model: NMF) -> void {
    array_free_f32(model.W)
    array_free_f32(model.H)
}

export struct TruncatedSVD {
    components: ptr<ptr<f32> >,
    n_components: i32,
    n_features: i32,
    explained_variance: ptr<f32>,
    explained_variance_ratio: ptr<f32>,
    fitted: bool
}

export function truncated_svd_fit(X: Matrix, n_components: i32) -> TruncatedSVD {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let At: Matrix = matrix_transpose(X)
    let AtA: Matrix = matrix_multiply(At, X)

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let explained_variance: ptr<f32> = array_new_f32(n_components)

    let AtA_copy: Matrix = matrix_copy(AtA)

    for c in 0 to n_components {
        let eigvec: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            eigvec[j] = 1.0 / sqrt((p as f64) as f32)
        }

        for _ in 0 to 100 {
            let new_vec: ptr<f32> = array_new_f32(p)
            for j1 in 0 to p {
                let mut sum: f32 = 0.0
                for j2 in 0 to p {
                    sum = sum + matrix_at(AtA_copy, j1, j2) * eigvec[j2]
                }
                new_vec[j1] = sum
            }

            let mut norm: f32 = 0.0
            for j in 0 to p {
                norm = norm + new_vec[j] * new_vec[j]
            }
            norm = sqrt(norm as f64) as f32
            if norm < 1e-10 { norm = 1.0 }
            for j in 0 to p {
                eigvec[j] = new_vec[j] / norm
            }
            array_free_f32(new_vec)
        }

        let mut eigval: f32 = 0.0
        let tmp: ptr<f32> = array_new_f32(p)
        for j1 in 0 to p {
            let mut sum: f32 = 0.0
            for j2 in 0 to p {
                sum = sum + matrix_at(AtA_copy, j1, j2) * eigvec[j2]
            }
            tmp[j1] = sum
        }
        for j in 0 to p {
            eigval = eigval + eigvec[j] * tmp[j]
        }
        array_free_f32(tmp)

        for j1 in 0 to p {
            for j2 in 0 to p {
                let val: f32 = matrix_at(AtA_copy, j1, j2) - eigval * eigvec[j1] * eigvec[j2]
                matrix_set(AtA_copy, j1, j2, val)
            }
        }

        components[c] = eigvec
        explained_variance[c] = eigval
    }

    let mut total_var: f32 = 0.0
    for j in 0 to p {
        total_var = total_var + matrix_at(AtA, j, j)
    }

    let explained_variance_ratio: ptr<f32> = array_new_f32(n_components)
    for c in 0 to n_components {
        if total_var > 1e-10 {
            explained_variance_ratio[c] = explained_variance[c] / total_var
        } else {
            explained_variance_ratio[c] = 0.0
        }
    }

    matrix_free(At)
    matrix_free(AtA)
    matrix_free(AtA_copy)

    return TruncatedSVD {
        components: components,
        n_components: n_components,
        n_features: p,
        explained_variance: explained_variance,
        explained_variance_ratio: explained_variance_ratio,
        fitted: true
    }
}

export function truncated_svd_transform(model: TruncatedSVD, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut sum: f32 = 0.0
            for j in 0 to model.n_features {
                sum = sum + matrix_at(X, i, j) * model.components[c][j]
            }
            matrix_set(result, i, c, sum)
        }
    }
    return result
}

export function truncated_svd_free(model: TruncatedSVD) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.explained_variance)
    array_free_f32(model.explained_variance_ratio)
}

# ============================================================================
# FastICA
# ============================================================================

export struct FastICA {
    components: ptr<ptr<f32> >,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    mixing: ptr<ptr<f32> >,
    n_iter: i32,
    fitted: bool
}

function _tanh_derivative(x: f32) -> f32 {
    let t: f32 = tanh((x) as f64) as f32
    return 1.0 - t * t
}

function _gram_schmidt(row: ptr<f32>, basis: ptr<ptr<f32> >, n_basis: i32, n_features: i32) -> void {
    for b in 0 to n_basis {
        let mut dot: f32 = 0.0
        for j in 0 to n_features {
            dot = dot + row[j] * basis[b][j]
        }
        for j in 0 to n_features {
            row[j] = row[j] - dot * basis[b][j]
        }
    }
    let mut norm: f32 = 0.0
    for j in 0 to n_features {
        norm = norm + row[j] * row[j]
    }
    norm = sqrt((norm as f64)) as f32
    if norm > 1e-10 {
        for j in 0 to n_features {
            row[j] = row[j] / norm
        }
    }
}

export function fast_ica_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> FastICA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    # Whitening via PCA
    let cov: Matrix = matrix_new(p, p)
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                s = s + matrix_at(Xc, k, i) * matrix_at(Xc, k, j)
            }
            matrix_set(cov, i, j, s / (n as f32))
        }
    }

    let pca_model: PCA = pca_fit(X, n_components)
    let whitening: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        whitening[c] = array_new_f32(p)
        let ev: f32 = pca_model.explained_variance[c]
        if ev < 1e-10 { ev = 1e-10 }
        for j in 0 to p {
            whitening[c][j] = pca_model.components[c][j] / sqrt((ev as f64)) as f32
        }
    }

    let Xw: Matrix = matrix_new(n, n_components)
    for i in 0 to n {
        for c in 0 to n_components {
            let mut s: f32 = 0.0
            for j in 0 to p {
                s = s + matrix_at(Xc, i, j) * whitening[c][j]
            }
            matrix_set(Xw, i, c, s)
        }
    }

    srand(seed)

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let mut n_iter: i32 = 0

    for c in 0 to n_components {
        components[c] = array_new_f32(n_components)
        for j in 0 to n_components {
            components[c][j] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }
        _gram_schmidt(components[c], components, c, n_components)

        for iter in 0 to max_iter {
            n_iter = iter + 1

            let w_old: ptr<f32> = array_copy_f32(components[c], n_components)

            let gw: ptr<f32> = array_new_f32(n_components)
            let g_w: ptr<f32> = array_new_f32(n_components)

            for i in 0 to n {
                let mut dot: f32 = 0.0
                for j in 0 to n_components {
                    dot = dot + components[c][j] * matrix_at(Xw, i, j)
                }
                let t: f32 = tanh((dot) as f64) as f32
                let g_deriv: f32 = 1.0 - t * t

                for j in 0 to n_components {
                    gw[j] = gw[j] + t * matrix_at(Xw, i, j)
                    g_w[j] = g_w[j] + g_deriv * components[c][j]
                }
            }

            for j in 0 to n_components {
                components[c][j] = (gw[j] - g_w[j] * components[c][j]) / (n as f32)
            }

            _gram_schmidt(components[c], components, c, n_components)

            let mut dot: f32 = 0.0
            for j in 0 to n_components {
                dot = dot + components[c][j] * w_old[j]
            }
            let convergence: f32 = fabs((fabs((dot) as f64) as f32 - 1.0) as f64) as f32

            array_free_f32(w_old)
            array_free_f32(gw)
            array_free_f32(g_w)

            if convergence < tol { break }
        }
    }

    let mixing: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        mixing[c] = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n_components {
                s = s + components[c][k] * whitening[c][j]
            }
            mixing[c][j] = s
        }
    }

    for c in 0 to n_components {
        array_free_f32(whitening[c])
    }
    free(whitening as ptr<void>)
    matrix_free(Xw)
    matrix_free(Xc)
    matrix_free(cov)
    pca_free(pca_model)

    return FastICA {
        components: components,
        n_components: n_components,
        n_features: p,
        mean: mean,
        mixing: mixing,
        n_iter: n_iter,
        fitted: true
    }
}

export function fast_ica_transform(model: FastICA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.mixing[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function fast_ica_free(model: FastICA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
        array_free_f32(model.mixing[c])
    }
    free(model.components as ptr<void>)
    free(model.mixing as ptr<void>)
    array_free_f32(model.mean)
}

# ============================================================================
# SparsePCA
# ============================================================================

export struct SparsePCA {
    components: ptr<ptr<f32> >,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    alpha: f32,
    n_iter: i32,
    fitted: bool
}

export function sparse_pca_fit(X: Matrix, n_components: i32, alpha: f32, max_iter: i32, tol: f32, seed: i32) -> SparsePCA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    srand(seed)

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let mut n_iter: i32 = 0

    for c in 0 to n_components {
        components[c] = array_new_f32(p)
        for j in 0 to p {
            components[c][j] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }
        let mut norm: f32 = 0.0
        for j in 0 to p {
            norm = norm + components[c][j] * components[c][j]
        }
        norm = sqrt((norm as f64)) as f32
        if norm > 1e-10 {
            for j in 0 to p {
                components[c][j] = components[c][j] / norm
            }
        }

        for iter in 0 to max_iter {
            n_iter = iter + 1

            let grad: ptr<f32> = array_new_f32(p)
            for i in 0 to n {
                let mut dot: f32 = 0.0
                for j in 0 to p {
                    dot = dot + components[c][j] * matrix_at(Xc, i, j)
                }
                for j in 0 to p {
                    grad[j] = grad[j] - dot * matrix_at(Xc, i, j)
                }
            }

            for j in 0 to p {
                grad[j] = grad[j] / (n as f32)
            }

            let lr: f32 = 0.01
            for j in 0 to p {
                components[c][j] = components[c][j] - lr * grad[j]
            }

            for j in 0 to p {
                if components[c][j] > alpha {
                    components[c][j] = components[c][j] - alpha
                } elif components[c][j] < -alpha {
                    components[c][j] = components[c][j] + alpha
                } else {
                    components[c][j] = 0.0
                }
            }

            let mut norm: f32 = 0.0
            for j in 0 to p {
                norm = norm + components[c][j] * components[c][j]
            }
            norm = sqrt((norm as f64)) as f32
            if norm > 1e-10 {
                for j in 0 to p {
                    components[c][j] = components[c][j] / norm
                }
            }

            array_free_f32(grad)

            if iter > 0 && iter % 10 == 0 {
                let mut change: f32 = 0.0
                for j in 0 to p {
                    change = change + fabs((grad[j]) as f64) as f32
                }
                if change / (p as f32) < tol { break }
            }
        }
    }

    matrix_free(Xc)

    return SparsePCA {
        components: components,
        n_components: n_components,
        n_features: p,
        mean: mean,
        alpha: alpha,
        n_iter: n_iter,
        fitted: true
    }
}

export function sparse_pca_transform(model: SparsePCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function sparse_pca_free(model: SparsePCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
}

# ============================================================================
# MiniBatchSparsePCA
# ============================================================================

export struct MiniBatchSparsePCA {
    components: ptr<ptr<f32> >,
    n_components: i32,
    n_features: i32,
    mean: ptr<f32>,
    alpha: f32,
    n_iter: i32,
    batch_size: i32,
    fitted: bool
}

export function minibatch_sparse_pca_fit(
    X: Matrix, n_components: i32, alpha: f32,
    max_iter: i32, batch_size: i32, tol: f32, seed: i32
) -> MiniBatchSparsePCA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    srand(seed)

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let mut n_iter: i32 = 0

    for c in 0 to n_components {
        components[c] = array_new_f32(p)
        for j in 0 to p {
            components[c][j] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }
        let mut norm: f32 = 0.0
        for j in 0 to p {
            norm = norm + components[c][j] * components[c][j]
        }
        norm = sqrt((norm as f64)) as f32
        if norm > 0.0000000001 {
            for j in 0 to p {
                components[c][j] = components[c][j] / norm
            }
        }

        for iter in 0 to max_iter {
            n_iter = iter + 1

            # Sample mini-batch
            let actual_batch: i32 = batch_size
            if actual_batch > n { actual_batch = n }

            let grad: ptr<f32> = array_new_f32(p)
            for b in 0 to actual_batch {
                let idx: i32 = rand() % n
                let mut dot: f32 = 0.0
                for j in 0 to p {
                    dot = dot + components[c][j] * matrix_at(Xc, idx, j)
                }
                for j in 0 to p {
                    grad[j] = grad[j] - dot * matrix_at(Xc, idx, j)
                }
            }

            for j in 0 to p {
                grad[j] = grad[j] / (actual_batch as f32)
            }

            let lr: f32 = 0.01
            for j in 0 to p {
                components[c][j] = components[c][j] - lr * grad[j]
            }

            # Soft-thresholding
            for j in 0 to p {
                if components[c][j] > alpha {
                    components[c][j] = components[c][j] - alpha
                } elif components[c][j] < -alpha {
                    components[c][j] = components[c][j] + alpha
                } else {
                    components[c][j] = 0.0
                }
            }

            # Normalize
            let mut norm2: f32 = 0.0
            for j in 0 to p {
                norm2 = norm2 + components[c][j] * components[c][j]
            }
            norm2 = sqrt((norm2 as f64)) as f32
            if norm2 > 0.0000000001 {
                for j in 0 to p {
                    components[c][j] = components[c][j] / norm2
                }
            }

            array_free_f32(grad)

            if iter > 0 && iter % 10 == 0 {
                let mut change: f32 = 0.0
                for j in 0 to p {
                    change = change + fabs((grad[j]) as f64) as f32
                }
                if change / (p as f32) < tol { break }
            }
        }
    }

    matrix_free(Xc)

    return MiniBatchSparsePCA {
        components: components,
        n_components: n_components,
        n_features: p,
        mean: mean,
        alpha: alpha,
        n_iter: n_iter,
        batch_size: batch_size,
        fitted: true
    }
}

export function minibatch_sparse_pca_transform(model: MiniBatchSparsePCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function minibatch_sparse_pca_free(model: MiniBatchSparsePCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
}

# ============================================================================
# KernelPCA
# ============================================================================

export struct KernelPCA {
    eigenvectors: ptr<ptr<f32> >,
    eigenvalues: ptr<f32>,
    n_components: i32,
    n_samples: i32,
    n_features: i32,
    X_train: Matrix,
    kernel: i32,
    gamma: f32,
    degree: i32,
    coef0: f32,
    fitted: bool
}

export const KERNELPCA_RBF: i32 = 0
export const KERNELPCA_LINEAR: i32 = 1
export const KERNELPCA_POLY: i32 = 2

function _kernel_compute(x1: ptr<f32>, x2: ptr<f32>, n: i32, kernel: i32, gamma: f32, degree: i32, coef0: f32) -> f32 {
    if kernel == KERNELPCA_RBF {
        let mut s: f32 = 0.0
        for i in 0 to n {
            let d: f32 = x1[i] - x2[i]
            s = s + d * d
        }
        return exp((-gamma * s) as f64) as f32
    }
    if kernel == KERNELPCA_POLY {
        let mut dot: f32 = 0.0
        for i in 0 to n {
            dot = dot + x1[i] * x2[i]
        }
        let val: f64 = (gamma * dot + coef0) as f64
        let mut result: f64 = 1.0
        for d in 0 to degree {
            result = result * val
        }
        return result as f32
    }
    let mut dot: f32 = 0.0
    for i in 0 to n {
        dot = dot + x1[i] * x2[i]
    }
    return dot
}

export function kernel_pca_fit(X: Matrix, n_components: i32, kernel: i32, gamma: f32, degree: i32, coef0: f32) -> KernelPCA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let K: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        K[i] = array_new_f32(n)
        let xi: ptr<f32> = array_new_f32(p)
        for j in 0 to p { xi[j] = matrix_at(X, i, j) }
        for j in 0 to n {
            let xj: ptr<f32> = array_new_f32(p)
            for k in 0 to p { xj[k] = matrix_at(X, j, k) }
            K[i][j] = _kernel_compute(xi, xj, p, kernel, gamma, degree, coef0)
            array_free_f32(xj)
        }
        array_free_f32(xi)
    }

    let mut row_mean: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        for j in 0 to n {
            row_mean[i] = row_mean[i] + K[i][j]
        }
        row_mean[i] = row_mean[i] / (n as f32)
    }
    let mut total_mean: f32 = 0.0
    for i in 0 to n { total_mean = total_mean + row_mean[i] }
    total_mean = total_mean / (n as f32)

    for i in 0 to n {
        for j in 0 to n {
            K[i][j] = K[i][j] - row_mean[i] - row_mean[j] + total_mean
        }
    }

    let eigenvectors: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let eigenvalues: ptr<f32> = array_new_f32(n_components)

    for c in 0 to n_components {
        eigenvectors[c] = array_new_f32(n)
        srand(42 + c)
        for i in 0 to n {
            eigenvectors[c][i] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }

        for iter in 0 to 200 {
            let Av: ptr<f32> = array_new_f32(n)
            for i in 0 to n {
                let mut s: f32 = 0.0
                for j in 0 to n {
                    s = s + K[i][j] * eigenvectors[c][j]
                }
                Av[i] = s
            }

            if c > 0 {
                for prev in 0 to c {
                    let mut dot: f32 = 0.0
                    for i in 0 to n {
                        dot = dot + Av[i] * eigenvectors[prev][i]
                    }
                    for i in 0 to n {
                        Av[i] = Av[i] - dot * eigenvectors[prev][i]
                    }
                }
            }

            let mut norm: f32 = 0.0
            for i in 0 to n { norm = norm + Av[i] * Av[i] }
            norm = sqrt((norm as f64)) as f32
            if norm < 1e-10 { norm = 1e-10 }

            let mut change: f32 = 0.0
            for i in 0 to n {
                let new_val: f32 = Av[i] / norm
                let d: f32 = fabs((new_val - eigenvectors[c][i]) as f64) as f32
                if d > change { change = d }
                eigenvectors[c][i] = new_val
            }
            array_free_f32(Av)
            if change < 1e-6 { break }
        }

        let mut lambda: f32 = 0.0
        for i in 0 to n {
            let mut s: f32 = 0.0
            for j in 0 to n {
                s = s + K[i][j] * eigenvectors[c][j]
            }
            lambda = lambda + eigenvectors[c][i] * s
        }
        eigenvalues[c] = lambda
        if eigenvalues[c] < 1e-10 { eigenvalues[c] = 1e-10 }
    }

    for c in 0 to n_components {
        let scale: f32 = 1.0 / sqrt((eigenvalues[c]) as f64) as f32
        for i in 0 to n {
            eigenvectors[c][i] = eigenvectors[c][i] * scale
        }
    }

    for i in 0 to n { array_free_f32(K[i]) }
    free(K as ptr<void>)
    array_free_f32(row_mean)

    return KernelPCA {
        eigenvectors: eigenvectors,
        eigenvalues: eigenvalues,
        n_components: n_components,
        n_samples: n,
        n_features: p,
        X_train: X,
        kernel: kernel,
        gamma: gamma,
        degree: degree,
        coef0: coef0,
        fitted: true
    }
}

export function kernel_pca_transform(model: KernelPCA, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let n_train: i32 = model.n_samples

    let K_test: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        K_test[i] = array_new_f32(n_train)
        let xi: ptr<f32> = array_new_f32(p)
        for j in 0 to p { xi[j] = matrix_at(X, i, j) }
        for j in 0 to n_train {
            let xj: ptr<f32> = array_new_f32(p)
            for k in 0 to p { xj[k] = matrix_at(model.X_train, j, k) }
            K_test[i][j] = _kernel_compute(xi, xj, p, model.kernel, model.gamma, model.degree, model.coef0)
            array_free_f32(xj)
        }
        array_free_f32(xi)
    }

    let result: Matrix = matrix_new(n, model.n_components)
    for i in 0 to n {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to n_train {
                s = s + K_test[i][j] * model.eigenvectors[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }

    for i in 0 to n { array_free_f32(K_test[i]) }
    free(K_test as ptr<void>)

    return result
}

export function kernel_pca_free(model: KernelPCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.eigenvectors[c])
    }
    free(model.eigenvectors as ptr<void>)
    array_free_f32(model.eigenvalues)
}

# ============================================================================
# FactorAnalysis
# ============================================================================

export struct FactorAnalysis {
    components: ptr<ptr<f32> >,
    mean: ptr<f32>,
    noise_variance: ptr<f32>,
    n_components: i32,
    n_features: i32,
    n_iter: i32,
    fitted: bool
}

export function factor_analysis_fit(X: Matrix, n_components: i32, max_iter: i32, tol: f32) -> FactorAnalysis {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n { m = m + matrix_at(X, i, j) }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    let cov: ptr<ptr<f32> > = malloc((p as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to p {
        cov[i] = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n { s = s + matrix_at(Xc, k, i) * matrix_at(Xc, k, j) }
            cov[i][j] = s / (n as f32)
        }
    }

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let noise_variance: ptr<f32> = array_new_f32(p)

    for j in 0 to p {
        noise_variance[j] = cov[j][j] / 2.0
    }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1

        let inv_psi: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            if noise_variance[j] < 1e-10 { noise_variance[j] = 1e-10 }
            inv_psi[j] = 1.0 / noise_variance[j]
        }

        for c in 0 to n_components {
            if c == 0 || true {
                let w: ptr<f32> = array_new_f32(p)
                for j in 0 to p {
                    w[j] = cov[j][j] * inv_psi[j] * 0.5
                }

                let beta: ptr<f32> = array_new_f32(p)
                for j in 0 to p {
                    let mut s: f32 = 0.0
                    for k in 0 to p {
                        s = s + cov[j][k] * inv_psi[k] * w[k]
                    }
                    beta[j] = s
                }

                let mut beta_sq: f32 = 0.0
                for j in 0 to p { beta_sq = beta_sq + beta[j] * beta[j] * inv_psi[j] }
                if beta_sq < 1e-10 { beta_sq = 1e-10 }

                for j in 0 to p {
                    w[j] = beta[j] / sqrt((1.0 + beta_sq) as f64) as f32
                }

                if c < n_components {
                    if c == 0 {
                        for j in 0 to p {
                            if components[c] == null {
                                components[c] = array_new_f32(p)
                            }
                            components[c][j] = w[j]
                        }
                    }
                }
                array_free_f32(w)
                array_free_f32(beta)
            }
        }

        let mut max_change: f32 = 0.0
        for j in 0 to p {
            let mut s: f32 = 0.0
            for c in 0 to n_components {
                s = s + components[c][j] * components[c][j]
            }
            let new_noise: f32 = cov[j][j] - s
            let change: f32 = fabs((new_noise - noise_variance[j]) as f64) as f32
            if change > max_change { max_change = change }
            noise_variance[j] = new_noise
        }

        array_free_f32(inv_psi)
        if max_change < tol { break }
    }

    for i in 0 to p { array_free_f32(cov[i]) }
    free(cov as ptr<void>)
    matrix_free(Xc)

    return FactorAnalysis {
        components: components,
        mean: mean,
        noise_variance: noise_variance,
        n_components: n_components,
        n_features: p,
        n_iter: n_iter,
        fitted: true
    }
}

export function factor_analysis_transform(model: FactorAnalysis, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let result: Matrix = matrix_new(n, model.n_components)

    let inv_psi: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        if model.noise_variance[j] < 1e-10 { inv_psi[j] = 1e10 }
        else { inv_psi[j] = 1.0 / model.noise_variance[j] }
    }

    for i in 0 to n {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to p {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j] * inv_psi[j]
            }
            matrix_set(result, i, c, s)
        }
    }

    array_free_f32(inv_psi)
    return result
}

export function factor_analysis_free(model: FactorAnalysis) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
    array_free_f32(model.noise_variance)
}

# ============================================================================
# IncrementalPCA
# ============================================================================

export struct IncrementalPCA {
    components: ptr<ptr<f32> >,
    mean: ptr<f32>,
    variances: ptr<f32>,
    n_components: i32,
    n_features: i32,
    n_samples_seen: i32,
    fitted: bool
}

export function incremental_pca_partial_fit(model: IncrementalPCA, X: Matrix) -> IncrementalPCA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let batch_mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut s: f32 = 0.0
        for i in 0 to n { s = s + matrix_at(X, i, j) }
        batch_mean[j] = s / (n as f32)
    }

    let total_n: i32 = model.n_samples_seen + n
    let mut new_mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        if model.n_samples_seen == 0 {
            new_mean[j] = batch_mean[j]
        } else {
            new_mean[j] = (model.n_samples_seen as f32 * model.mean[j] + n as f32 * batch_mean[j]) / (total_n as f32)
        }
    }

    for c in 0 to model.n_components {
        let Av: ptr<f32> = array_new_f32(p)
        for i in 0 to p {
            let mut s: f32 = 0.0
            for j in 0 to p {
                let cov_ij: f32 = 0.0
                if model.n_samples_seen > 0 {
                    cov_ij = model.components[c][j]
                }
                s = s + cov_ij * model.components[c][j]
            }
            Av[i] = s
        }

        for i in 0 to n {
            for j in 0 to p {
                let d: f32 = matrix_at(X, i, j) - new_mean[j]
                Av[j] = Av[j] + d * (matrix_at(X, i, j) - batch_mean[j])
            }
        }

        let mut norm: f32 = 0.0
        for j in 0 to p { norm = norm + Av[j] * Av[j] }
        norm = sqrt((norm as f64)) as f32
        if norm < 1e-10 { norm = 1e-10 }

        for j in 0 to p {
            model.components[c][j] = Av[j] / norm
        }
        array_free_f32(Av)
    }

    for j in 0 to p {
        model.mean[j] = new_mean[j]
    }
    model.n_samples_seen = total_n

    array_free_f32(batch_mean)
    array_free_f32(new_mean)

    return model
}

export function incremental_pca_init(n_components: i32, n_features: i32) -> IncrementalPCA {
    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let mean: ptr<f32> = array_new_f32(n_features)
    let variances: ptr<f32> = array_new_f32(n_features)

    for c in 0 to n_components {
        components[c] = array_new_f32(n_features)
    }
    for j in 0 to n_features {
        mean[j] = 0.0
        variances[j] = 0.0
    }

    return IncrementalPCA {
        components: components,
        mean: mean,
        variances: variances,
        n_components: n_components,
        n_features: n_features,
        n_samples_seen: 0,
        fitted: false
    }
}

export function incremental_pca_transform(model: IncrementalPCA, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_components)
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut s: f32 = 0.0
            for j in 0 to model.n_features {
                s = s + (matrix_at(X, i, j) - model.mean[j]) * model.components[c][j]
            }
            matrix_set(result, i, c, s)
        }
    }
    return result
}

export function incremental_pca_free(model: IncrementalPCA) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.components[c])
    }
    free(model.components as ptr<void>)
    array_free_f32(model.mean)
    array_free_f32(model.variances)
}

# ============================================================================
# DictionaryLearning
# ============================================================================

export struct DictionaryLearning {
    dictionary: ptr<ptr<f32> >,
    n_components: i32,
    n_features: i32,
    alpha: f32,
    n_iter: i32,
    fitted: bool
}

export function dictionary_learning_fit(X: Matrix, n_components: i32, alpha: f32, max_iter: i32, tol: f32, seed: i32) -> DictionaryLearning {
    let n: i32 = X.rows
    let p: i32 = X.cols

    srand(seed)
    let dictionary: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        dictionary[c] = array_new_f32(p)
        let idx: i32 = rand() % n
        for j in 0 to p {
            dictionary[c][j] = matrix_at(X, idx, j)
        }
        let mut norm: f32 = 0.0
        for j in 0 to p { norm = norm + dictionary[c][j] * dictionary[c][j] }
        norm = sqrt((norm as f64)) as f32
        if norm > 1e-10 {
            for j in 0 to p { dictionary[c][j] = dictionary[c][j] / norm }
        }
    }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1
        let mut total_change: f32 = 0.0

        for i in 0 to n {
            let codes: ptr<f32> = array_new_f32(n_components)

            for c in 0 to n_components {
                let mut dot: f32 = 0.0
                for j in 0 to p {
                    dot = dot + matrix_at(X, i, j) * dictionary[c][j]
                }
                if (fabs((dot) as f64) as f32) > alpha {
                    if dot > 0 {
                        codes[c] = dot - alpha
                    } else {
                        codes[c] = dot + alpha
                    }
                } else {
                    codes[c] = 0.0
                }
            }

            for c in 0 to n_components {
                if (fabs((codes[c]) as f64) as f32) < 1e-10 { continue }
                let old: ptr<f32> = array_copy_f32(dictionary[c], p)
                for j in 0 to p {
                    let residual: f32 = matrix_at(X, i, j) - codes[c] * dictionary[c][j]
                    dictionary[c][j] = dictionary[c][j] + 0.01 * codes[c] * residual
                }
                let mut norm: f32 = 0.0
                for j in 0 to p { norm = norm + dictionary[c][j] * dictionary[c][j] }
                norm = sqrt((norm as f64)) as f32
                if norm > 1e-10 {
                    for j in 0 to p { dictionary[c][j] = dictionary[c][j] / norm }
                }
                let mut change: f32 = 0.0
                for j in 0 to p {
                    change = change + fabs((dictionary[c][j] - old[j]) as f64) as f32
                }
                total_change = total_change + change
                array_free_f32(old)
            }

            array_free_f32(codes)
        }

        if total_change / (n as f32) < tol { break }
    }

    return DictionaryLearning {
        dictionary: dictionary,
        n_components: n_components,
        n_features: p,
        alpha: alpha,
        n_iter: n_iter,
        fitted: true
    }
}

export function dictionary_learning_transform(model: DictionaryLearning, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)

    for i in 0 to n {
        for c in 0 to model.n_components {
            let mut dot: f32 = 0.0
            for j in 0 to model.n_features {
                dot = dot + matrix_at(X, i, j) * model.dictionary[c][j]
            }
            if (fabs((dot) as f64) as f32) > model.alpha {
                if dot > 0 {
                    matrix_set(result, i, c, dot - model.alpha)
                } else {
                    matrix_set(result, i, c, dot + model.alpha)
                }
            } else {
                matrix_set(result, i, c, 0.0)
            }
        }
    }

    return result
}

export function dictionary_learning_free(model: DictionaryLearning) -> void {
    for c in 0 to model.n_components {
        array_free_f32(model.dictionary[c])
    }
    free(model.dictionary as ptr<void>)
}

# ============================================================================
# MiniBatchDictionaryLearning
# ============================================================================

export struct MiniBatchDictionaryLearning {
    components: Matrix,
    n_components: i32,
    n_features: i32,
    fitted: bool
}

export function minibatch_dictionary_learning_fit(X: Matrix, n_components: i32, n_iter: i32, batch_size: i32, seed: i32) -> MiniBatchDictionaryLearning {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    srand(seed)

    # Initialize dictionary with random samples from X
    let components: Matrix = matrix_new(n_components, n_features)
    let mut i: i32 = 0
    while i < n_components {
        let idx: i32 = rand() % n
        let mut j: i32 = 0
        while j < n_features {
            matrix_set(components, i, j, matrix_at(X, idx, j))
            j = j + 1
        }
        # Normalize row
        let mut norm: f32 = 0.0
        j = 0
        while j < n_features {
            let v: f32 = matrix_at(components, i, j)
            norm = norm + v * v
            j = j + 1
        }
        norm = sqrt((norm) as f64) as f32
        if norm > 0.0000000001 {
            j = 0
            while j < n_features {
                let v: f32 = matrix_at(components, i, j) / norm
                matrix_set(components, i, j, v)
                j = j + 1
            }
        }
        i = i + 1
    }

    # Mini-batch online learning
    let mut iter: i32 = 0
    while iter < n_iter {
        # Random batch
        let X_batch: Matrix = matrix_new(batch_size, n_features)
        let mut b: i32 = 0
        while b < batch_size {
            let idx: i32 = rand() % n
            let mut j: i32 = 0
            while j < n_features {
                matrix_set(X_batch, b, j, matrix_at(X, idx, j))
                j = j + 1
            }
            b = b + 1
        }

        # Sparse coding: for each sample, find sparse code
        # Simplified: just update dictionary atoms
        b = 0
        while b < batch_size {
            # Find closest atom
            let mut best_atom: i32 = 0
            let mut best_dist: f32 = 999999.0
            let mut k: i32 = 0
            while k < n_components {
                let mut dist: f32 = 0.0
                let mut j2: i32 = 0
                while j2 < n_features {
                    let d: f32 = matrix_at(X_batch, b, j2) - matrix_at(components, k, j2)
                    dist = dist + d * d
                    j2 = j2 + 1
                }
                if dist < best_dist {
                    best_dist = dist
                    best_atom = k
                }
                k = k + 1
            }

            # Update atom: move towards the sample
            let lr: f32 = 1.0 / ((iter + 1) as f32)
            let mut j3: i32 = 0
            while j3 < n_features {
                let v: f32 = matrix_at(components, best_atom, j3) + lr * (matrix_at(X_batch, b, j3) - matrix_at(components, best_atom, j3))
                matrix_set(components, best_atom, j3, v)
                j3 = j3 + 1
            }

            # Renormalize atom
            let mut norm: f32 = 0.0
            j3 = 0
            while j3 < n_features {
                let v: f32 = matrix_at(components, best_atom, j3)
                norm = norm + v * v
                j3 = j3 + 1
            }
            norm = sqrt((norm) as f64) as f32
            if norm > 0.0000000001 {
                j3 = 0
                while j3 < n_features {
                    let v: f32 = matrix_at(components, best_atom, j3) / norm
                    matrix_set(components, best_atom, j3, v)
                    j3 = j3 + 1
                }
            }
            b = b + 1
        }

        matrix_free(X_batch)
        iter = iter + 1
    }

    let result: MiniBatchDictionaryLearning = MiniBatchDictionaryLearning {
        components: components,
        n_components: n_components,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function minibatch_dictionary_learning_transform(model: MiniBatchDictionaryLearning, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    let mut i: i32 = 0
    while i < n {
        let mut k: i32 = 0
        while k < model.n_components {
            # Dot product as sparse code approximation
            let mut dot: f32 = 0.0
            let mut j: i32 = 0
            while j < model.n_features {
                dot = dot + matrix_at(X, i, j) * matrix_at(model.components, k, j)
                j = j + 1
            }
            matrix_set(result, i, k, dot)
            k = k + 1
        }
        i = i + 1
    }
    return result
}

export function minibatch_dictionary_learning_free(model: MiniBatchDictionaryLearning) -> void {
    matrix_free(model.components)
}

# ============================================================================
# LatentDirichletAllocation
# ============================================================================

export struct LatentDirichletAllocation {
    components: Matrix,
    n_topics: i32,
    n_features: i32,
    fitted: bool
}

export function lda_fit(X: Matrix, n_topics: i32, n_iter: i32, alpha: f32, eta: f32, seed: i32) -> LatentDirichletAllocation {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    srand(seed)

    # Initialize topic-word distribution randomly
    let components: Matrix = matrix_new(n_topics, n_features)
    let mut i: i32 = 0
    while i < n_topics {
        let mut j: i32 = 0
        while j < n_features {
            let v: f32 = ((rand() % 100) as f32) / 100.0 + 0.01
            matrix_set(components, i, j, v)
            j = j + 1
        }
        # Normalize row
        let mut sum: f32 = 0.0
        j = 0
        while j < n_features {
            sum = sum + matrix_at(components, i, j)
            j = j + 1
        }
        if sum > 0.0000000001 {
            j = 0
            while j < n_features {
                let v: f32 = matrix_at(components, i, j) / sum
                matrix_set(components, i, j, v)
                j = j + 1
            }
        }
        i = i + 1
    }

    # Simplified variational EM
    let mut iter: i32 = 0
    while iter < n_iter {
        # E-step: for each document, compute topic distribution
        let doc_topic: Matrix = matrix_new(n, n_topics)
        let mut d: i32 = 0
        while d < n {
            # Initialize topic distribution uniformly
            let mut t: i32 = 0
            while t < n_topics {
                matrix_set(doc_topic, d, t, 1.0 / (n_topics as f32))
                t = t + 1
            }
            # Update: topic_dist = normalize(sum over words of X[d,w] * components[:,w])
            let mut topic_sum: ptr<f32> = array_new_f32(n_topics)
            t = 0
            while t < n_topics {
                let mut s: f32 = 0.0
                let mut w: i32 = 0
                while w < n_features {
                    s = s + matrix_at(X, d, w) * matrix_at(components, t, w)
                    w = w + 1
                }
                topic_sum[t] = s + alpha
                t = t + 1
            }
            # Normalize
            let mut total: f32 = 0.0
            t = 0
            while t < n_topics {
                total = total + topic_sum[t]
                t = t + 1
            }
            if total > 0.0000000001 {
                t = 0
                while t < n_topics {
                    matrix_set(doc_topic, d, t, topic_sum[t] / total)
                    t = t + 1
                }
            }
            array_free_f32(topic_sum)
            d = d + 1
        }

        # M-step: update components
        let new_components: Matrix = matrix_new(n_topics, n_features)
        let mut t2: i32 = 0
        while t2 < n_topics {
            let mut w: i32 = 0
            while w < n_features {
                let mut s: f32 = 0.0
                let mut d2: i32 = 0
                while d2 < n {
                    s = s + matrix_at(doc_topic, d2, t2) * matrix_at(X, d2, w)
                    d2 = d2 + 1
                }
                matrix_set(new_components, t2, w, s + eta)
                w = w + 1
            }
            # Normalize
            let mut sum: f32 = 0.0
            w = 0
            while w < n_features {
                sum = sum + matrix_at(new_components, t2, w)
                w = w + 1
            }
            if sum > 0.0000000001 {
                w = 0
                while w < n_features {
                    let v: f32 = matrix_at(new_components, t2, w) / sum
                    matrix_set(new_components, t2, w, v)
                    w = w + 1
                }
            }
            t2 = t2 + 1
        }

        # Copy new components
        t2 = 0
        while t2 < n_topics {
            let mut w2: i32 = 0
            while w2 < n_features {
                matrix_set(components, t2, w2, matrix_at(new_components, t2, w2))
                w2 = w2 + 1
            }
            t2 = t2 + 1
        }

        matrix_free(new_components)
        matrix_free(doc_topic)
        iter = iter + 1
    }

    let result: LatentDirichletAllocation = LatentDirichletAllocation {
        components: components,
        n_topics: n_topics,
        n_features: n_features,
        fitted: true
    }
    return result
}

export function lda_transform(model: LatentDirichletAllocation, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_topics)
    let mut d: i32 = 0
    while d < n {
        let mut t: i32 = 0
        while t < model.n_topics {
            let mut s: f32 = 0.0
            let mut w: i32 = 0
            while w < model.n_features {
                s = s + matrix_at(X, d, w) * matrix_at(model.components, t, w)
                w = w + 1
            }
            matrix_set(result, d, t, s)
            t = t + 1
        }
        # Normalize
        let mut sum: f32 = 0.0
        t = 0
        while t < model.n_topics {
            sum = sum + matrix_at(result, d, t)
            t = t + 1
        }
        if sum > 0.0000000001 {
            t = 0
            while t < model.n_topics {
                let v: f32 = matrix_at(result, d, t) / sum
                matrix_set(result, d, t, v)
                t = t + 1
            }
        }
        d = d + 1
    }
    return result
}

export function lda_free(model: LatentDirichletAllocation) -> void {
    matrix_free(model.components)
}

# ============================================================================
# MiniBatchNMF
# ============================================================================

export struct MiniBatchNMF {
    W: ptr<f32>,
    H: ptr<f32>,
    n_components: i32,
    n_samples: i32,
    n_features: i32,
    reconstruction_err: f32,
    n_iter: i32,
    fitted: bool
}

export function minibatch_nmf_fit(X: Matrix, n_components: i32, max_iter: i32, batch_size: i32, tol: f32, seed: i32) -> MiniBatchNMF {
    let n: i32 = X.rows
    let n_features: i32 = X.cols
    srand(seed)

    # Initialize W and H with random non-negative values
    let W: ptr<f32> = array_new_f32(n * n_components)
    let H: ptr<f32> = array_new_f32(n_components * n_features)

    let mut i: i32 = 0
    while i < n * n_components {
        W[i] = ((rand() % 100) as f32) / 100.0 + 0.01
        i = i + 1
    }
    i = 0
    while i < n_components * n_features {
        H[i] = ((rand() % 100) as f32) / 100.0 + 0.01
        i = i + 1
    }

    # Mini-batch updates
    let mut iter: i32 = 0
    let mut prev_err: f32 = 999999.0
    while iter < max_iter {
        # Random batch
        let X_batch: Matrix = matrix_new(batch_size, n_features)
        let batch_idx: ptr<i32> = malloc((batch_size as i64) * 4) as ptr<i32>
        let mut b: i32 = 0
        while b < batch_size {
            let idx: i32 = rand() % n
            batch_idx[b] = idx
            let mut j: i32 = 0
            while j < n_features {
                matrix_set(X_batch, b, j, matrix_at(X, idx, j))
                j = j + 1
            }
            b = b + 1
        }

        # Update W for batch samples and H globally
        # W update: W[i,k] *= (X @ H^T)[i,k] / (W @ H @ H^T)[i,k]
        b = 0
        while b < batch_size {
            let idx: i32 = batch_idx[b]
            let mut k: i32 = 0
            while k < n_components {
                # Numerator: sum_j X[idx,j] * H[k,j]
                let mut num: f32 = 0.0
                let mut j: i32 = 0
                while j < n_features {
                    num = num + matrix_at(X_batch, b, j) * H[k * n_features + j]
                    j = j + 1
                }
                # Denominator: sum_j W[idx,k'] * H[k',j] * H[k,j]
                let mut den: f32 = 0.0
                let mut k2: i32 = 0
                while k2 < n_components {
                    let mut s: f32 = 0.0
                    let mut j2: i32 = 0
                    while j2 < n_features {
                        s = s + H[k2 * n_features + j2] * H[k * n_features + j2]
                        j2 = j2 + 1
                    }
                    den = den + W[idx * n_components + k2] * s
                    k2 = k2 + 1
                }
                if den < 0.0000000001 { den = 0.0000000001 }
                W[idx * n_components + k] = W[idx * n_components + k] * num / den
                k = k + 1
            }
            b = b + 1
        }

        # H update: H[k,j] *= (W^T @ X)[k,j] / (W^T @ W @ H)[k,j]
        let mut k3: i32 = 0
        while k3 < n_components {
            let mut j3: i32 = 0
            while j3 < n_features {
                let mut num2: f32 = 0.0
                let mut b2: i32 = 0
                while b2 < batch_size {
                    num2 = num2 + W[batch_idx[b2] * n_components + k3] * matrix_at(X_batch, b2, j3)
                    b2 = b2 + 1
                }
                let mut den2: f32 = 0.0
                let mut k4: i32 = 0
                while k4 < n_components {
                    let mut ws: f32 = 0.0
                    let mut b3: i32 = 0
                    while b3 < batch_size {
                        ws = ws + W[batch_idx[b3] * n_components + k4] * W[batch_idx[b3] * n_components + k3]
                        b3 = b3 + 1
                    }
                    den2 = den2 + ws * H[k4 * n_features + j3]
                    k4 = k4 + 1
                }
                if den2 < 0.0000000001 { den2 = 0.0000000001 }
                H[k3 * n_features + j3] = H[k3 * n_features + j3] * num2 / den2
                j3 = j3 + 1
            }
            k3 = k3 + 1
        }

        matrix_free(X_batch)
        free(batch_idx as ptr<void>)
        iter = iter + 1
    }

    # Compute reconstruction error
    let mut recon_err: f32 = 0.0
    let mut i2: i32 = 0
    while i2 < n {
        let mut j4: i32 = 0
        while j4 < n_features {
            let mut pred: f32 = 0.0
            let mut k5: i32 = 0
            while k5 < n_components {
                pred = pred + W[i2 * n_components + k5] * H[k5 * n_features + j4]
                k5 = k5 + 1
            }
            let diff: f32 = matrix_at(X, i2, j4) - pred
            recon_err = recon_err + diff * diff
            j4 = j4 + 1
        }
        i2 = i2 + 1
    }
    recon_err = sqrt((recon_err) as f64) as f32

    let result: MiniBatchNMF = MiniBatchNMF {
        W: W,
        H: H,
        n_components: n_components,
        n_samples: n,
        n_features: n_features,
        reconstruction_err: recon_err,
        n_iter: max_iter,
        fitted: true
    }
    return result
}

export function minibatch_nmf_transform(model: MiniBatchNMF, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    let mut i: i32 = 0
    while i < n {
        let mut k: i32 = 0
        while k < model.n_components {
            let mut dot: f32 = 0.0
            let mut j: i32 = 0
            while j < model.n_features {
                dot = dot + matrix_at(X, i, j) * model.H[k * model.n_features + j]
                j = j + 1
            }
            matrix_set(result, i, k, dot)
            k = k + 1
        }
        i = i + 1
    }
    return result
}

export function minibatch_nmf_free(model: MiniBatchNMF) -> void {
    array_free_f32(model.W)
    array_free_f32(model.H)
}
