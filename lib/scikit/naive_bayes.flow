# Naive Bayes module for flow-scikit.
# Implements GaussianNB for continuous features.

import "lib/scikit/matrix.flow"

export struct GaussianNB {
    classes: ptr<f32>,
    n_classes: i32,
    means: ptr<ptr<f32> >,
    variances: ptr<ptr<f32> >,
    priors: ptr<f32>,
    n_features: i32,
    var_smoothing: f32,
    fitted: bool
}

export function gaussian_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, var_smoothing: f32) -> GaussianNB {
    let n_features: i32 = X.cols
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0

    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let means: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let variances: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let priors: ptr<f32> = array_new_f32(n_classes)

    let global_var: ptr<f32> = array_new_f32(n_features)
    for j in 0 to n_features {
        let col: ptr<f32> = array_new_f32(X.rows)
        for i in 0 to X.rows {
            col[i] = matrix_at(X, i, j)
        }
        let mean: f32 = array_mean(col, X.rows)
        global_var[j] = array_std(col, X.rows, mean)
        global_var[j] = global_var[j] * global_var[j]
        array_free_f32(col)
    }

    let max_var: f32 = array_max_val(global_var, n_features)

    for c in 0 to n_classes {
        means[c] = array_new_f32(n_features)
        variances[c] = array_new_f32(n_features)

        let mut count: i32 = 0
        for i in 0 to X.rows {
            if y[i] == classes[c] {
                count = count + 1
            }
        }

        priors[c] = (count as f32) / (X.rows as f32)

        for j in 0 to n_features {
            let vals: ptr<f32> = array_new_f32(count)
            let mut idx: i32 = 0
            for i in 0 to X.rows {
                if y[i] == classes[c] {
                    vals[idx] = matrix_at(X, i, j)
                    idx = idx + 1
                }
            }
            means[c][j] = array_mean(vals, count)
            let v: f32 = array_std(vals, count, means[c][j])
            variances[c][j] = v * v + var_smoothing * max_var
            array_free_f32(vals)
        }
    }

    array_free_f32(global_var)

    return GaussianNB {
        classes: classes,
        n_classes: n_classes,
        means: means,
        variances: variances,
        priors: priors,
        n_features: n_features,
        var_smoothing: var_smoothing,
        fitted: true
    }
}

export function gaussian_nb_predict(model: GaussianNB, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)

    for i in 0 to X.rows {
        let mut best_class: i32 = 0
        let mut best_log_prob: f32 = -1e30

        for c in 0 to model.n_classes {
            let mut log_prob: f32 = log(model.priors[c] as f64) as f32

            for j in 0 to model.n_features {
                let val: f32 = matrix_at(X, i, j)
                let mean: f32 = model.means[c][j]
                let var: f32 = model.variances[c][j]
                let diff: f32 = val - mean
                let log_lik: f32 = -0.5 * log((2.0 * 3.14159265358979) as f64) as f32 - 0.5 * log(var as f64) as f32 - diff * diff / (2.0 * var)
                log_prob = log_prob + log_lik
            }

            if log_prob > best_log_prob {
                best_log_prob = log_prob
                best_class = c
            }
        }

        preds[i] = model.classes[best_class]
    }

    return preds
}

export function gaussian_nb_predict_proba(model: GaussianNB, X: Matrix) -> Matrix {
    let probs: Matrix = matrix_new(X.rows, model.n_classes)

    for i in 0 to X.rows {
        let log_probs: ptr<f32> = array_new_f32(model.n_classes)
        let mut max_lp: f32 = -1e30

        for c in 0 to model.n_classes {
            let mut lp: f32 = log(model.priors[c] as f64) as f32
            for j in 0 to model.n_features {
                let val: f32 = matrix_at(X, i, j)
                let mean: f32 = model.means[c][j]
                let var: f32 = model.variances[c][j]
                let diff: f32 = val - mean
                lp = lp - 0.5 * log((2.0 * 3.14159265358979) as f64) as f32 - 0.5 * log(var as f64) as f32 - diff * diff / (2.0 * var)
            }
            log_probs[c] = lp
            if lp > max_lp {
                max_lp = lp
            }
        }

        let mut sum: f32 = 0.0
        for c in 0 to model.n_classes {
            log_probs[c] = log_probs[c] - max_lp
            let p: f32 = exp(log_probs[c] as f64) as f32
            matrix_set(probs, i, c, p)
            sum = sum + p
        }

        for c in 0 to model.n_classes {
            let p: f32 = matrix_at(probs, i, c) / sum
            matrix_set(probs, i, c, p)
        }

        array_free_f32(log_probs)
    }

    return probs
}

export function gaussian_nb_free(model: GaussianNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.means[c])
        array_free_f32(model.variances[c])
    }
    free(model.means as ptr<void>)
    free(model.variances as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.priors)
}

export struct MultinomialNB {
    classes: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    feature_log_prob: ptr<ptr<f32> >,
    class_log_prior: ptr<f32>,
    fitted: bool
}

export function multinomial_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, alpha: f32) -> MultinomialNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    let mut class_idx: i32 = 0
    for i in 0 to n {
        let found: bool = false
        for c in 0 to class_idx {
            if classes[c] == y[i] {
                class_counts[c] = class_counts[c] + 1
                found = true
                break
            }
        }
        if not found {
            classes[class_idx] = y[i]
            class_counts[class_idx] = 1
            class_idx = class_idx + 1
        }
    }

    let feature_log_prob: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)

    for c in 0 to n_classes {
        let feature_counts: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            feature_counts[j] = alpha
        }

        for i in 0 to n {
            if y[i] == classes[c] {
                for j in 0 to p {
                    feature_counts[j] = feature_counts[j] + matrix_at(X, i, j)
                }
            }
        }

        let mut total: f32 = 0.0
        for j in 0 to p {
            total = total + feature_counts[j]
        }

        feature_log_prob[c] = array_new_f32(p)
        for j in 0 to p {
            feature_log_prob[c][j] = log((feature_counts[j] / total) as f64) as f32
        }
        array_free_f32(feature_counts)

        class_log_prior[c] = log(((class_counts[c] as f32) / (n as f32)) as f64) as f32
    }

    free(class_counts as ptr<void>)

    return MultinomialNB {
        classes: classes,
        n_classes: n_classes,
        n_features: p,
        feature_log_prob: feature_log_prob,
        class_log_prior: class_log_prior,
        fitted: true
    }
}

export function multinomial_nb_predict(model: MultinomialNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -1e10
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                score = score + matrix_at(X, i, j) * model.feature_log_prob[c][j]
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = model.classes[best_c]
    }

    return result
}

export function multinomial_nb_predict_proba(model: MultinomialNB, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_classes)

    for i in 0 to n {
        let log_probs: ptr<f32> = array_new_f32(model.n_classes)
        let mut max_lp: f32 = -1e10

        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                score = score + matrix_at(X, i, j) * model.feature_log_prob[c][j]
            }
            log_probs[c] = score
            if score > max_lp {
                max_lp = score
            }
        }

        let mut sum_exp: f32 = 0.0
        for c in 0 to model.n_classes {
            log_probs[c] = exp((log_probs[c] - max_lp) as f64) as f32
            sum_exp = sum_exp + log_probs[c]
        }
        for c in 0 to model.n_classes {
            matrix_set(result, i, c, log_probs[c] / sum_exp)
        }
        array_free_f32(log_probs)
    }

    return result
}

export function multinomial_nb_free(model: MultinomialNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.feature_log_prob[c])
    }
    free(model.feature_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}

export struct BernoulliNB {
    classes: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    feature_log_prob: ptr<ptr<f32> >,
    class_log_prior: ptr<f32>,
    fitted: bool
}

export function bernoulli_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, alpha: f32) -> BernoulliNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    let mut class_idx: i32 = 0
    for i in 0 to n {
        let found: bool = false
        for c in 0 to class_idx {
            if classes[c] == y[i] {
                class_counts[c] = class_counts[c] + 1
                found = true
                break
            }
        }
        if not found {
            classes[class_idx] = y[i]
            class_counts[class_idx] = 1
            class_idx = class_idx + 1
        }
    }

    let feature_log_prob: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)

    for c in 0 to n_classes {
        let feature_present: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            feature_present[j] = alpha
        }

        for i in 0 to n {
            if y[i] == classes[c] {
                for j in 0 to p {
                    if matrix_at(X, i, j) > 0.5 {
                        feature_present[j] = feature_present[j] + 1.0
                    }
                }
            }
        }

        let count: f32 = (class_counts[c] as f32) + 2.0 * alpha

        feature_log_prob[c] = array_new_f32(p)
        for j in 0 to p {
            feature_log_prob[c][j] = log((feature_present[j] / count) as f64) as f32
        }
        array_free_f32(feature_present)

        class_log_prior[c] = log(((class_counts[c] as f32) / (n as f32)) as f64) as f32
    }

    free(class_counts as ptr<void>)

    return BernoulliNB {
        classes: classes,
        n_classes: n_classes,
        n_features: p,
        feature_log_prob: feature_log_prob,
        class_log_prior: class_log_prior,
        fitted: true
    }
}

export function bernoulli_nb_predict(model: BernoulliNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -1e10
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                let x_ij: f32 = matrix_at(X, i, j)
                if x_ij > 0.5 {
                    score = score + model.feature_log_prob[c][j]
                } else {
                    score = score + log((1.0 - exp(model.feature_log_prob[c][j] as f64) as f32) as f64) as f32
                }
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = model.classes[best_c]
    }

    return result
}

export function bernoulli_nb_free(model: BernoulliNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.feature_log_prob[c])
    }
    free(model.feature_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}

# ============================================================================
# ComplementNB
# ============================================================================

export struct ComplementNB {
    feature_log_prob: ptr<ptr<f32> >,
    classes: ptr<f32>,
    class_log_prior: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    alpha: f32,
    fitted: bool
}

export function complement_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, alpha: f32) -> ComplementNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes { classes[c] = c as f32 }

    let class_log_prior: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes {
        let mut count: i32 = 0
        for i in 0 to n {
            if y[i] as i32 == c { count = count + 1 }
        }
        if count > 0 {
            class_log_prior[c] = log((count as f64) as f32 as f64) as f32
        } else {
            class_log_prior[c] = -1e10
        }
    }

    let feature_log_prob: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >

    let class_feature_counts: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_classes {
        class_feature_counts[c] = array_new_f32(p)
        for j in 0 to p { class_feature_counts[c][j] = 0.0 }
    }

    for i in 0 to n {
        let c: i32 = y[i] as i32
        for j in 0 to p {
            class_feature_counts[c][j] = class_feature_counts[c][j] + matrix_at(X, i, j)
        }
    }

    let total_counts: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        for c in 0 to n_classes {
            total_counts[j] = total_counts[j] + class_feature_counts[c][j]
        }
    }

    for c in 0 to n_classes {
        feature_log_prob[c] = array_new_f32(p)
        for j in 0 to p {
            let complement_count: f32 = total_counts[j] - class_feature_counts[c][j]
            let smoothed: f32 = complement_count + alpha
            let total_complement: f32 = 0.0
            for k in 0 to p {
                total_complement = total_complement + (total_counts[k] - class_feature_counts[c][k]) + alpha
            }
            if total_complement > 0 {
                feature_log_prob[c][j] = -log((smoothed / total_complement) as f64) as f32
            } else {
                feature_log_prob[c][j] = 0.0
            }
        }
    }

    for c in 0 to n_classes { array_free_f32(class_feature_counts[c]) }
    free(class_feature_counts as ptr<void>)
    array_free_f32(total_counts)

    return ComplementNB {
        feature_log_prob: feature_log_prob,
        classes: classes,
        class_log_prior: class_log_prior,
        n_classes: n_classes,
        n_features: p,
        alpha: alpha,
        fitted: true
    }
}

export function complement_nb_predict(model: ComplementNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -1e30
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                score = score + matrix_at(X, i, j) * model.feature_log_prob[c][j]
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = best_c as f32
    }
    return result
}

export function complement_nb_free(model: ComplementNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.feature_log_prob[c])
    }
    free(model.feature_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}

# ============================================================================
# CategoricalNB
# ============================================================================

export struct CategoricalNB {
    category_log_prob: ptr<ptr<ptr<f32> > >,
    n_categories: ptr<i32>,
    classes: ptr<f32>,
    class_log_prior: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    alpha: f32,
    fitted: bool
}

export function categorical_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_categories: ptr<i32>, alpha: f32) -> CategoricalNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes {
        classes[c] = c as f32
        let mut count: i32 = 0
        for i in 0 to n {
            if y[i] as i32 == c { count = count + 1 }
        }
        if count > 0 {
            class_log_prior[c] = log((count as f64) as f32 as f64) as f32
        } else {
            class_log_prior[c] = -1e10
        }
    }

    let category_log_prob: ptr<ptr<ptr<f32> > > = malloc((p as i64) * 8) as ptr<ptr<ptr<f32> > >
    for j in 0 to p {
        category_log_prob[j] = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
        for c in 0 to n_classes {
            let nc: i32 = n_categories[j]
            category_log_prob[j][c] = array_new_f32(nc)
            let counts: ptr<i32> = malloc((nc as i64) * 4) as ptr<i32>
            for cat in 0 to nc { counts[cat] = 0 }
            let mut total: i32 = 0
            for i in 0 to n {
                if y[i] as i32 == c {
                    let cat: i32 = matrix_at(X, i, j) as i32
                    if cat >= 0 && cat < nc {
                        counts[cat] = counts[cat] + 1
                        total = total + 1
                    }
                }
            }
            for cat in 0 to nc {
                let smoothed: f32 = (counts[cat] as f32) + alpha
                let denom: f32 = (total as f32) + alpha * (nc as f32)
                if denom > 0 {
                    category_log_prob[j][c][cat] = log((smoothed / denom) as f64) as f32
                } else {
                    category_log_prob[j][c][cat] = 0.0
                }
            }
            free(counts as ptr<void>)
        }
    }

    return CategoricalNB {
        category_log_prob: category_log_prob,
        n_categories: n_categories,
        classes: classes,
        class_log_prior: class_log_prior,
        n_classes: n_classes,
        n_features: p,
        alpha: alpha,
        fitted: true
    }
}

export function categorical_nb_predict(model: CategoricalNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -1e30
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                let cat: i32 = matrix_at(X, i, j) as i32
                if cat >= 0 && cat < model.n_categories[j] {
                    score = score + model.category_log_prob[j][c][cat]
                }
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = best_c as f32
    }
    return result
}

export function categorical_nb_free(model: CategoricalNB) -> void {
    for j in 0 to model.n_features {
        for c in 0 to model.n_classes {
            array_free_f32(model.category_log_prob[j][c])
        }
        free(model.category_log_prob[j] as ptr<void>)
    }
    free(model.category_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}
