# Naive Bayes module for flow-scikit.
# Implements GaussianNB for continuous features.

import "lib/scikit/matrix.flow"

export struct GaussianNB {
    classes: ptr<f32>,
    n_classes: i32,
    means: ptr<ptr<f32> >,
    variances: ptr<ptr<f32> >,
    priors: ptr<f32>,
    n_features: i32,
    var_smoothing: f32,
    fitted: bool
}

export function gaussian_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, var_smoothing: f32) -> GaussianNB {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let class_indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut n_found: i32 = 0

    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    # Discover classes once and cache each sample's class index.  The previous
    # implementation rediscovered membership for every class/feature pair.
    for i in 0 to n {
        let mut class_id: i32 = -1
        for c in 0 to n_found {
            if classes[c] == y[i] {
                class_id = c
                break
            }
        }
        if class_id < 0 {
            class_id = n_found
            classes[class_id] = y[i]
            n_found = n_found + 1
        }
        class_indices[i] = class_id
        class_counts[class_id] = class_counts[class_id] + 1
    }

    let means: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let variances: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let priors: ptr<f32> = array_new_f32(n_classes)
    let global_mean: ptr<f32> = array_new_f32(p)
    let global_var: ptr<f32> = array_new_f32(p)
    let class_sums: ptr<f32> = array_new_f32(n_classes * p)
    let class_var_sums: ptr<f32> = array_new_f32(n_classes * p)

    for c in 0 to n_classes {
        means[c] = array_new_f32(p)
        variances[c] = array_new_f32(p)
    }

    # First contiguous pass: global and per-class sufficient statistics.
    for i in 0 to n {
        let c: i32 = class_indices[i]
        let row_base: i32 = i * p
        let class_base: i32 = c * p
        for j in 0 to p {
            let value: f32 = X.data[row_base + j]
            global_mean[j] = global_mean[j] + value
            class_sums[class_base + j] = class_sums[class_base + j] + value
        }
    }

    if n > 0 {
        for j in 0 to p {
            global_mean[j] = global_mean[j] / (n as f32)
        }
    }

    for c in 0 to n_classes {
        let count: i32 = class_counts[c]
        priors[c] = 0.0
        if n > 0 {
            priors[c] = (count as f32) / (n as f32)
        }
        if count > 0 {
            let base: i32 = c * p
            for j in 0 to p {
                means[c][j] = class_sums[base + j] / (count as f32)
            }
        }
    }

    # Second contiguous pass: squared deviations.  This preserves the existing
    # ddof=0 population-variance semantics without temporary column/value arrays.
    for i in 0 to n {
        let c: i32 = class_indices[i]
        let row_base: i32 = i * p
        let class_base: i32 = c * p
        for j in 0 to p {
            let value: f32 = X.data[row_base + j]
            let gd: f32 = value - global_mean[j]
            let cd: f32 = value - means[c][j]
            global_var[j] = global_var[j] + gd * gd
            class_var_sums[class_base + j] = class_var_sums[class_base + j] + cd * cd
        }
    }

    if n > 0 {
        for j in 0 to p {
            global_var[j] = global_var[j] / (n as f32)
        }
    }
    let max_var: f32 = array_max_val(global_var, p)

    for c in 0 to n_classes {
        let count: i32 = class_counts[c]
        let base: i32 = c * p
        for j in 0 to p {
            let class_var: f32 = 0.0
            if count > 0 {
                class_var = class_var_sums[base + j] / (count as f32)
            }
            variances[c][j] = class_var + var_smoothing * max_var
        }
    }

    free(class_counts as ptr<void>)
    free(class_indices as ptr<void>)
    array_free_f32(global_mean)
    array_free_f32(global_var)
    array_free_f32(class_sums)
    array_free_f32(class_var_sums)

    return GaussianNB {
        classes: classes,
        n_classes: n_classes,
        means: means,
        variances: variances,
        priors: priors,
        n_features: p,
        var_smoothing: var_smoothing,
        fitted: true
    }
}

# Precompute the terms that are constant for every sample in a prediction call.
# Keeping them out of the sample/class/feature hot loop avoids repeated log()
# evaluation while leaving fit latency and the public model layout unchanged.
function _gaussian_nb_prepare_terms(
    model: GaussianNB,
    class_log_prior: ptr<f32>,
    log_norm: ptr<f32>,
    inv_two_var: ptr<f32>
) -> void {
    let log_two_pi: f32 = log((2.0 * 3.14159265358979) as f64) as f32
    let p: i32 = model.n_features
    for c in 0 to model.n_classes {
        class_log_prior[c] = log(model.priors[c] as f64) as f32
        let base: i32 = c * p
        for j in 0 to p {
            let var: f32 = model.variances[c][j]
            log_norm[base + j] = -0.5 * log_two_pi - 0.5 * (log(var as f64) as f32)
            inv_two_var[base + j] = 1.0 / (2.0 * var)
        }
    }
}

export function gaussian_nb_predict(model: GaussianNB, X: Matrix) -> ptr<f32> {
    let preds: ptr<f32> = array_new_f32(X.rows)
    let p: i32 = model.n_features
    let terms: i32 = model.n_classes * p
    let class_log_prior: ptr<f32> = array_new_f32(model.n_classes)
    let log_norm: ptr<f32> = array_new_f32(terms)
    let inv_two_var: ptr<f32> = array_new_f32(terms)
    _gaussian_nb_prepare_terms(model, class_log_prior, log_norm, inv_two_var)

    for i in 0 to X.rows {
        let mut best_class: i32 = 0
        let mut best_log_prob: f32 = -9999999999.0
        let row_base: i32 = i * p

        for c in 0 to model.n_classes {
            let mut log_prob: f32 = class_log_prior[c]
            let class_base: i32 = c * p
            for j in 0 to p {
                let diff: f32 = X.data[row_base + j] - model.means[c][j]
                let term_idx: i32 = class_base + j
                log_prob = log_prob + log_norm[term_idx] - diff * diff * inv_two_var[term_idx]
            }

            if log_prob > best_log_prob {
                best_log_prob = log_prob
                best_class = c
            }
        }

        preds[i] = model.classes[best_class]
    }

    array_free_f32(class_log_prior)
    array_free_f32(log_norm)
    array_free_f32(inv_two_var)
    return preds
}

export function gaussian_nb_predict_proba(model: GaussianNB, X: Matrix) -> Matrix {
    let probs: Matrix = matrix_new(X.rows, model.n_classes)
    let p: i32 = model.n_features
    let terms: i32 = model.n_classes * p
    let class_log_prior: ptr<f32> = array_new_f32(model.n_classes)
    let log_norm: ptr<f32> = array_new_f32(terms)
    let inv_two_var: ptr<f32> = array_new_f32(terms)
    let log_probs: ptr<f32> = array_new_f32(model.n_classes)
    _gaussian_nb_prepare_terms(model, class_log_prior, log_norm, inv_two_var)

    for i in 0 to X.rows {
        let mut max_lp: f32 = -9999999999.0
        let row_base: i32 = i * p
        let prob_base: i32 = i * model.n_classes

        for c in 0 to model.n_classes {
            let mut lp: f32 = class_log_prior[c]
            let class_base: i32 = c * p
            for j in 0 to p {
                let diff: f32 = X.data[row_base + j] - model.means[c][j]
                let term_idx: i32 = class_base + j
                lp = lp + log_norm[term_idx] - diff * diff * inv_two_var[term_idx]
            }
            log_probs[c] = lp
            if lp > max_lp {
                max_lp = lp
            }
        }

        let mut sum: f32 = 0.0
        for c in 0 to model.n_classes {
            let probability: f32 = exp((log_probs[c] - max_lp) as f64) as f32
            probs.data[prob_base + c] = probability
            sum = sum + probability
        }

        for c in 0 to model.n_classes {
            probs.data[prob_base + c] = probs.data[prob_base + c] / sum
        }
    }

    array_free_f32(class_log_prior)
    array_free_f32(log_norm)
    array_free_f32(inv_two_var)
    array_free_f32(log_probs)
    return probs
}

export function gaussian_nb_free(model: GaussianNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.means[c])
        array_free_f32(model.variances[c])
    }
    free(model.means as ptr<void>)
    free(model.variances as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.priors)
}

export struct MultinomialNB {
    classes: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    feature_log_prob: ptr<ptr<f32> >,
    class_log_prior: ptr<f32>,
    fitted: bool
}

export function multinomial_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, alpha: f32) -> MultinomialNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    let mut class_idx: i32 = 0
    for i in 0 to n {
        let found: bool = false
        for c in 0 to class_idx {
            if classes[c] == y[i] {
                class_counts[c] = class_counts[c] + 1
                found = true
                break
            }
        }
        if not found {
            classes[class_idx] = y[i]
            class_counts[class_idx] = 1
            class_idx = class_idx + 1
        }
    }

    let feature_log_prob: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)

    for c in 0 to n_classes {
        let feature_counts: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            feature_counts[j] = alpha
        }

        for i in 0 to n {
            if y[i] == classes[c] {
                for j in 0 to p {
                    feature_counts[j] = feature_counts[j] + matrix_at(X, i, j)
                }
            }
        }

        let mut total: f32 = 0.0
        for j in 0 to p {
            total = total + feature_counts[j]
        }

        feature_log_prob[c] = array_new_f32(p)
        for j in 0 to p {
            feature_log_prob[c][j] = log((feature_counts[j] / total) as f64) as f32
        }
        array_free_f32(feature_counts)

        class_log_prior[c] = log(((class_counts[c] as f32) / (n as f32)) as f64) as f32
    }

    free(class_counts as ptr<void>)

    return MultinomialNB {
        classes: classes,
        n_classes: n_classes,
        n_features: p,
        feature_log_prob: feature_log_prob,
        class_log_prior: class_log_prior,
        fitted: true
    }
}

export function multinomial_nb_predict(model: MultinomialNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -10000000000.0
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                score = score + matrix_at(X, i, j) * model.feature_log_prob[c][j]
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = model.classes[best_c]
    }

    return result
}

export function multinomial_nb_predict_proba(model: MultinomialNB, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_classes)

    for i in 0 to n {
        let log_probs: ptr<f32> = array_new_f32(model.n_classes)
        let mut max_lp: f32 = -10000000000.0

        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                score = score + matrix_at(X, i, j) * model.feature_log_prob[c][j]
            }
            log_probs[c] = score
            if score > max_lp {
                max_lp = score
            }
        }

        let mut sum_exp: f32 = 0.0
        for c in 0 to model.n_classes {
            log_probs[c] = exp((log_probs[c] - max_lp) as f64) as f32
            sum_exp = sum_exp + log_probs[c]
        }
        for c in 0 to model.n_classes {
            matrix_set(result, i, c, log_probs[c] / sum_exp)
        }
        array_free_f32(log_probs)
    }

    return result
}

export function multinomial_nb_free(model: MultinomialNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.feature_log_prob[c])
    }
    free(model.feature_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}

export struct BernoulliNB {
    classes: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    feature_log_prob: ptr<ptr<f32> >,
    class_log_prior: ptr<f32>,
    fitted: bool
}

export function bernoulli_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, alpha: f32) -> BernoulliNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        class_counts[c] = 0
    }

    let mut class_idx: i32 = 0
    for i in 0 to n {
        let found: bool = false
        for c in 0 to class_idx {
            if classes[c] == y[i] {
                class_counts[c] = class_counts[c] + 1
                found = true
                break
            }
        }
        if not found {
            classes[class_idx] = y[i]
            class_counts[class_idx] = 1
            class_idx = class_idx + 1
        }
    }

    let feature_log_prob: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)

    for c in 0 to n_classes {
        let feature_present: ptr<f32> = array_new_f32(p)
        for j in 0 to p {
            feature_present[j] = alpha
        }

        for i in 0 to n {
            if y[i] == classes[c] {
                for j in 0 to p {
                    if matrix_at(X, i, j) > 0.5 {
                        feature_present[j] = feature_present[j] + 1.0
                    }
                }
            }
        }

        let count: f32 = (class_counts[c] as f32) + 2.0 * alpha

        feature_log_prob[c] = array_new_f32(p)
        for j in 0 to p {
            feature_log_prob[c][j] = log((feature_present[j] / count) as f64) as f32
        }
        array_free_f32(feature_present)

        class_log_prior[c] = log(((class_counts[c] as f32) / (n as f32)) as f64) as f32
    }

    free(class_counts as ptr<void>)

    return BernoulliNB {
        classes: classes,
        n_classes: n_classes,
        n_features: p,
        feature_log_prob: feature_log_prob,
        class_log_prior: class_log_prior,
        fitted: true
    }
}

# log(1 - p) for an absent feature, expressed exactly as the original inline
# formulation so the accumulated float32 score is unchanged.
function _bernoulli_nb_absent_term(present_log_prob: f32) -> f32 {
    return log((1.0 - exp(present_log_prob as f64) as f32) as f64) as f32
}

# The absent-feature contribution depends only on fitted state, so it is the
# same for every sample.  Building the table once per predict call replaces
# n_samples * n_classes * n_features exp()/log() pairs with n_classes *
# n_features of them.
function _bernoulli_nb_prepare_absent(model: BernoulliNB, absent_log_prob: ptr<f32>) -> void {
    let p: i32 = model.n_features
    for c in 0 to model.n_classes {
        let base: i32 = c * p
        let present: ptr<f32> = model.feature_log_prob[c]
        for j in 0 to p {
            absent_log_prob[base + j] = _bernoulli_nb_absent_term(present[j])
        }
    }
}

export function bernoulli_nb_predict(model: BernoulliNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let result: ptr<f32> = array_new_f32(n)
    let absent_log_prob: ptr<f32> = array_new_f32(model.n_classes * p)
    _bernoulli_nb_prepare_absent(model, absent_log_prob)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -10000000000.0
        let row_base: i32 = i * p
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            let present: ptr<f32> = model.feature_log_prob[c]
            let class_base: i32 = c * p
            for j in 0 to p {
                if X.data[row_base + j] > 0.5 {
                    score = score + present[j]
                } else {
                    score = score + absent_log_prob[class_base + j]
                }
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = model.classes[best_c]
    }

    array_free_f32(absent_log_prob)
    return result
}

export function bernoulli_nb_free(model: BernoulliNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.feature_log_prob[c])
    }
    free(model.feature_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}

# ============================================================================
# ComplementNB
# ============================================================================

export struct ComplementNB {
    feature_log_prob: ptr<ptr<f32> >,
    classes: ptr<f32>,
    class_log_prior: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    alpha: f32,
    fitted: bool
}

export function complement_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, alpha: f32) -> ComplementNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes { classes[c] = c as f32 }

    let class_log_prior: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes {
        let mut count: i32 = 0
        for i in 0 to n {
            if y[i] as i32 == c { count = count + 1 }
        }
        if count > 0 {
            class_log_prior[c] = log((count as f64) as f32 as f64) as f32
        } else {
            class_log_prior[c] = -10000000000.0
        }
    }

    let feature_log_prob: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >

    let class_feature_counts: ptr<ptr<f32> > = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_classes {
        class_feature_counts[c] = array_new_f32(p)
        for j in 0 to p { class_feature_counts[c][j] = 0.0 }
    }

    for i in 0 to n {
        let c: i32 = y[i] as i32
        for j in 0 to p {
            class_feature_counts[c][j] = class_feature_counts[c][j] + matrix_at(X, i, j)
        }
    }

    let total_counts: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        for c in 0 to n_classes {
            total_counts[j] = total_counts[j] + class_feature_counts[c][j]
        }
    }

    for c in 0 to n_classes {
        feature_log_prob[c] = array_new_f32(p)
        for j in 0 to p {
            let complement_count: f32 = total_counts[j] - class_feature_counts[c][j]
            let smoothed: f32 = complement_count + alpha
            let total_complement: f32 = 0.0
            for k in 0 to p {
                total_complement = total_complement + (total_counts[k] - class_feature_counts[c][k]) + alpha
            }
            if total_complement > 0 {
                feature_log_prob[c][j] = -log((smoothed / total_complement) as f64) as f32
            } else {
                feature_log_prob[c][j] = 0.0
            }
        }
    }

    for c in 0 to n_classes { array_free_f32(class_feature_counts[c]) }
    free(class_feature_counts as ptr<void>)
    array_free_f32(total_counts)

    return ComplementNB {
        feature_log_prob: feature_log_prob,
        classes: classes,
        class_log_prior: class_log_prior,
        n_classes: n_classes,
        n_features: p,
        alpha: alpha,
        fitted: true
    }
}

export function complement_nb_predict(model: ComplementNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let n_classes: i32 = model.n_classes
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -9999999999.0
        let row_base: i32 = i * p
        for c in 0 to n_classes {
            let mut score: f32 = model.class_log_prior[c]
            # Hoisting the class weight row out of the feature loop turns a
            # double pointer dereference per element into one per class.
            let weights: ptr<f32> = model.feature_log_prob[c]
            for j in 0 to p {
                score = score + X.data[row_base + j] * weights[j]
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = best_c as f32
    }
    return result
}

export function complement_nb_free(model: ComplementNB) -> void {
    for c in 0 to model.n_classes {
        array_free_f32(model.feature_log_prob[c])
    }
    free(model.feature_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}

# ============================================================================
# CategoricalNB
# ============================================================================

export struct CategoricalNB {
    category_log_prob: ptr<ptr<ptr<f32> > >,
    n_categories: ptr<i32>,
    classes: ptr<f32>,
    class_log_prior: ptr<f32>,
    n_classes: i32,
    n_features: i32,
    alpha: f32,
    fitted: bool
}

# One smoothed category cell.  Extracted so the normalisation pass keeps log()
# out of a triply nested loop body.
function _categorical_nb_log_ratio(smoothed: f32, denom: f32) -> f32 {
    if denom > 0 {
        return log((smoothed / denom) as f64) as f32
    }
    return 0.0
}

export function categorical_nb_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_categories: ptr<i32>, alpha: f32) -> CategoricalNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        classes[c] = c as f32
        class_counts[c] = 0
    }

    # Resolve each sample's class once.  The previous implementation rescanned
    # the whole label vector for every (feature, class) pair, so the count pass
    # cost n_features * n_classes * n_samples instead of n_samples * n_features.
    let sample_class: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        let c: i32 = y[i] as i32
        sample_class[i] = c
        if c >= 0 && c < n_classes {
            class_counts[c] = class_counts[c] + 1
        }
    }

    for c in 0 to n_classes {
        if class_counts[c] > 0 {
            class_log_prior[c] = log((class_counts[c] as f64) as f32 as f64) as f32
        } else {
            class_log_prior[c] = -10000000000.0
        }
    }

    # Flat count table addressed as feature_offset[j] + c * n_categories[j] + cat,
    # so the gather pass walks X row-major instead of striding down a column
    # once per class.
    let feature_offset: ptr<i32> = malloc((p as i64) * 4) as ptr<i32>
    let mut slot_count: i32 = 0
    for j in 0 to p {
        feature_offset[j] = slot_count
        slot_count = slot_count + n_categories[j] * n_classes
    }

    let category_counts: ptr<i32> = malloc((slot_count as i64) * 4) as ptr<i32>
    for s in 0 to slot_count {
        category_counts[s] = 0
    }
    let cell_totals: ptr<i32> = malloc(((p * n_classes) as i64) * 4) as ptr<i32>
    for s in 0 to p * n_classes {
        cell_totals[s] = 0
    }

    for i in 0 to n {
        let c: i32 = sample_class[i]
        if c >= 0 && c < n_classes {
            let row_base: i32 = i * p
            for j in 0 to p {
                let nc: i32 = n_categories[j]
                let cat: i32 = X.data[row_base + j] as i32
                if cat >= 0 && cat < nc {
                    let slot: i32 = feature_offset[j] + c * nc + cat
                    category_counts[slot] = category_counts[slot] + 1
                    let cell: i32 = j * n_classes + c
                    cell_totals[cell] = cell_totals[cell] + 1
                }
            }
        }
    }

    let category_log_prob: ptr<ptr<ptr<f32> > > = malloc((p as i64) * 8) as ptr<ptr<ptr<f32> > >
    for j in 0 to p {
        let nc: i32 = n_categories[j]
        category_log_prob[j] = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
        for c in 0 to n_classes {
            let probs: ptr<f32> = array_new_f32(nc)
            category_log_prob[j][c] = probs
            let base: i32 = feature_offset[j] + c * nc
            let total: i32 = cell_totals[j * n_classes + c]
            let denom: f32 = (total as f32) + alpha * (nc as f32)
            for cat in 0 to nc {
                let smoothed: f32 = (category_counts[base + cat] as f32) + alpha
                probs[cat] = _categorical_nb_log_ratio(smoothed, denom)
            }
        }
    }

    free(class_counts as ptr<void>)
    free(sample_class as ptr<void>)
    free(feature_offset as ptr<void>)
    free(category_counts as ptr<void>)
    free(cell_totals as ptr<void>)

    return CategoricalNB {
        category_log_prob: category_log_prob,
        n_categories: n_categories,
        classes: classes,
        class_log_prior: class_log_prior,
        n_classes: n_classes,
        n_features: p,
        alpha: alpha,
        fitted: true
    }
}

export function categorical_nb_predict(model: CategoricalNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let p: i32 = model.n_features
    let n_classes: i32 = model.n_classes
    let result: ptr<f32> = array_new_f32(n)
    # One score buffer and one code buffer for the whole call, not per sample.
    let scores: ptr<f32> = array_new_f32(n_classes)
    let codes: ptr<i32> = malloc((p as i64) * 4) as ptr<i32>

    for i in 0 to n {
        # Decode and range-check the row's category codes once instead of once
        # per class.  Out of range stays -1 and contributes nothing, as before.
        let row_base: i32 = i * p
        for j in 0 to p {
            let cat: i32 = X.data[row_base + j] as i32
            if cat >= 0 && cat < model.n_categories[j] {
                codes[j] = cat
            } else {
                codes[j] = -1
            }
        }

        for c in 0 to n_classes {
            scores[c] = model.class_log_prior[c]
        }

        # Feature-outer accumulation keeps one feature's category table hot for
        # every class instead of walking p separate allocations once per class.
        # Each class still sums its terms in ascending feature order, so the
        # accumulated float32 score is unchanged.
        for j in 0 to p {
            let cat: i32 = codes[j]
            if cat >= 0 {
                let feature_table: ptr<ptr<f32> > = model.category_log_prob[j]
                for c in 0 to n_classes {
                    scores[c] = scores[c] + feature_table[c][cat]
                }
            }
        }

        let mut best_c: i32 = 0
        let mut best_score: f32 = -9999999999.0
        for c in 0 to n_classes {
            if scores[c] > best_score {
                best_score = scores[c]
                best_c = c
            }
        }
        result[i] = best_c as f32
    }

    array_free_f32(scores)
    free(codes as ptr<void>)
    return result
}

export function categorical_nb_free(model: CategoricalNB) -> void {
    for j in 0 to model.n_features {
        for c in 0 to model.n_classes {
            array_free_f32(model.category_log_prob[j][c])
        }
        free(model.category_log_prob[j] as ptr<void>)
    }
    free(model.category_log_prob as ptr<void>)
    array_free_f32(model.classes)
    array_free_f32(model.class_log_prior)
}
