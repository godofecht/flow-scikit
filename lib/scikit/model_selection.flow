# Model selection module for flow-scikit.
# Addresses Issue #28394: train_test_split takes X and y explicitly, auto-stratifies.
# Addresses Issues #30852, #32946: GridSearchCV uses Progress effect system
#   instead of confusing verbose integer levels.

import "lib/scikit/matrix.flow"
import "lib/scikit/metrics.flow"
import "lib/scikit/progress.flow"
import "lib/scikit/linear.flow"
import "lib/scikit/validation.flow"
import "lib/scikit/tree.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

# ============================================================================
# train_test_split (Issue #28394)
# Takes X and y as explicit named parameters. Auto-stratifies for classification.
# ============================================================================

export const STRATIFY_NONE: i32 = 0
export const STRATIFY_AUTO: i32 = 1
export const STRATIFY_EXPLICIT: i32 = 2

export struct TrainTestSplit {
    X_train: Matrix,
    X_test: Matrix,
    y_train: ptr<f32>,
    y_test: ptr<f32>,
    n_train: i32,
    n_test: i32
}

export function train_test_split(X: Matrix, y: ptr<f32>, test_size: f32, stratify_mode: i32) -> TrainTestSplit {
    let n: i32 = X.rows
    let n_test: i32 = ((n as f32) * test_size) as i32
    let n_train: i32 = n - n_test

    let indices: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        indices[i] = i
    }

    srand(42)
    for i in 0 to n {
        let j: i32 = rand() % n
        let tmp: i32 = indices[i]
        indices[i] = indices[j]
        indices[j] = tmp
    }

    let should_stratify: bool = false
    if stratify_mode == STRATIFY_AUTO {
        let mut all_int: bool = true
        for i in 0 to n {
            let val: f32 = y[i]
            if val != (val as i32) as f32 {
                all_int = false
            }
            if val < 0.0 {
                all_int = false
            }
        }
        let mut n_unique: i32 = 0
        let unique: ptr<f32> = array_new_f32(n)
        for i in 0 to n {
            let mut found: bool = false
            for k in 0 to n_unique {
                if unique[k] == y[i] {
                    found = true
                }
            }
            if not found {
                unique[n_unique] = y[i]
                n_unique = n_unique + 1
            }
        }
        array_free_f32(unique)
        if all_int && n_unique <= 20 && n_unique > 1 {
            should_stratify = true
        }
    }

    if should_stratify {
        _stratified_shuffle(indices, y, n, n_test)
    }

    let X_train: Matrix = matrix_new(n_train, X.cols)
    let X_test: Matrix = matrix_new(n_test, X.cols)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let y_test: ptr<f32> = array_new_f32(n_test)

    for i in 0 to n_train {
        let idx: i32 = indices[i]
        y_train[i] = y[idx]
        for j in 0 to X.cols {
            matrix_set(X_train, i, j, matrix_at(X, idx, j))
        }
    }

    for i in 0 to n_test {
        let idx: i32 = indices[n_train + i]
        y_test[i] = y[idx]
        for j in 0 to X.cols {
            matrix_set(X_test, i, j, matrix_at(X, idx, j))
        }
    }

    free(indices as ptr<void>)

    return TrainTestSplit {
        X_train: X_train,
        X_test: X_test,
        y_train: y_train,
        y_test: y_test,
        n_train: n_train,
        n_test: n_test
    }
}

function _stratified_shuffle(indices: ptr<i32>, y: ptr<f32>, n: i32, n_test: i32) -> void {
    let unique: ptr<f32> = array_new_f32(n)
    let mut n_classes: i32 = 0
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_classes {
            if unique[k] == y[i] {
                found = true
            }
        }
        if not found {
            unique[n_classes] = y[i]
            n_classes = n_classes + 1
        }
    }

    let class_indices: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        class_indices[c] = malloc((n as i64) * 4) as ptr<i32>
        class_counts[c] = 0
    }

    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == unique[c] {
                class_indices[c][class_counts[c]] = i
                class_counts[c] = class_counts[c] + 1
            }
        }
    }

    for c in 0 to n_classes {
        for i in 0 to class_counts[c] {
            let j: i32 = rand() % class_counts[c]
            let tmp: i32 = class_indices[c][i]
            class_indices[c][i] = class_indices[c][j]
            class_indices[c][j] = tmp
        }
    }

    let mut train_pos: i32 = 0
    let mut test_pos: i32 = 0
    let n_train: i32 = n - n_test

    for c in 0 to n_classes {
        let n_c: i32 = class_counts[c]
        let n_test_c: i32 = ((n_c as f32) / (n as f32) * (n_test as f32)) as i32
        let n_train_c: i32 = n_c - n_test_c

        for i in 0 to n_train_c {
            indices[train_pos] = class_indices[c][i]
            train_pos = train_pos + 1
        }
        for i in 0 to n_test_c {
            indices[n_train + test_pos] = class_indices[c][n_train_c + i]
            test_pos = test_pos + 1
        }
    }

    for c in 0 to n_classes {
        free(class_indices[c] as ptr<void>)
    }
    free(class_indices as ptr<void>)
    free(class_counts as ptr<void>)
    array_free_f32(unique)
}

export function train_test_split_free(split: TrainTestSplit) -> void {
    matrix_free(split.X_train)
    matrix_free(split.X_test)
    array_free_f32(split.y_train)
    array_free_f32(split.y_test)
}

# ============================================================================
# cross_validate
# ============================================================================

export struct CVResult {
    scores: ptr<f32>,
    n_folds: i32,
    mean_score: f32,
    std_score: f32
}

export function cross_validate_score(X: Matrix, y: ptr<f32>, n_classes: i32, n_folds: i32, epochs: i32, lr: f32) -> CVResult {
    let n: i32 = X.rows
    let fold_size: i32 = n / n_folds
    let scores: ptr<f32> = array_new_f32(n_folds)

    for fold in 0 to n_folds {
        let test_start: i32 = fold * fold_size
        let test_end: i32 = test_start + fold_size
        if fold == n_folds - 1 {
            test_end = n
        }
        let n_test: i32 = test_end - test_start
        let n_train: i32 = n - n_test

        let X_train: Matrix = matrix_new(n_train, X.cols)
        let y_train: ptr<f32> = array_new_f32(n_train)
        let mut train_pos: i32 = 0
        for i in 0 to n {
            if i < test_start || i >= test_end {
                y_train[train_pos] = y[i]
                for j in 0 to X.cols {
                    matrix_set(X_train, train_pos, j, matrix_at(X, i, j))
                }
                train_pos = train_pos + 1
            }
        }

        let X_test: Matrix = matrix_new(n_test, X.cols)
        let y_test: ptr<f32> = array_new_f32(n_test)
        for i in 0 to n_test {
            y_test[i] = y[test_start + i]
            for j in 0 to X.cols {
                matrix_set(X_test, i, j, matrix_at(X, test_start + i, j))
            }
        }

        let penalty: Penalty = penalty_l2(0.01)
        let model: LogisticRegression = logistic_regression_fit(X_train, y_train, n_classes, epochs, lr, penalty)
        let probs: ptr<f32> = logistic_predict(model, X_test)
        let preds: ptr<f32> = logistic_decide(model, probs, n_test, 0.5)

        scores[fold] = accuracy_score(y_test, preds, n_test)

        array_free_f32(probs)
        array_free_f32(preds)
        logistic_regression_free(model)
        matrix_free(X_train)
        matrix_free(X_test)
        array_free_f32(y_train)
        array_free_f32(y_test)
    }

    let mean: f32 = array_mean(scores, n_folds)
    let std: f32 = array_std(scores, n_folds, mean)

    return CVResult { scores: scores, n_folds: n_folds, mean_score: mean, std_score: std }
}

export function cv_result_free(result: CVResult) -> void {
    array_free_f32(result.scores)
}

# ============================================================================
# GridSearchCV (Issues #30852, #32946)
# Uses Progress effect system instead of confusing verbose integer levels.
# ============================================================================

export struct ParamGrid {
    C_values: ptr<f32>,
    n_C: i32,
    lr_values: ptr<f32>,
    n_lr: i32
}

export struct GridSearchResult {
    best_C: f32,
    best_lr: f32,
    best_score: f32,
    all_scores: ptr<f32>,
    all_C: ptr<f32>,
    all_lr: ptr<f32>,
    n_candidates: i32
}

export function grid_search_logistic(X: Matrix, y: ptr<f32>, n_classes: i32, grid: ParamGrid, n_folds: i32, epochs: i32) -> GridSearchResult {
    let n_candidates: i32 = grid.n_C * grid.n_lr
    let all_scores: ptr<f32> = array_new_f32(n_candidates)
    let all_C: ptr<f32> = array_new_f32(n_candidates)
    let all_lr: ptr<f32> = array_new_f32(n_candidates)

    let mut candidate_idx: i32 = 0
    let mut best_score: f32 = 0.0
    let mut best_C: f32 = grid.C_values[0]
    let mut best_lr: f32 = grid.lr_values[0]

    for ci in 0 to grid.n_C {
        for li in 0 to grid.n_lr {
            let C: f32 = grid.C_values[ci]
            let lr: f32 = grid.lr_values[li]

            Progress.on_fit_start(candidate_idx, n_candidates, "C=, lr=")

            let penalty: Penalty = penalty_l2(C)
            let cv: CVResult = _cv_logistic_single(X, y, n_classes, n_folds, epochs, lr, penalty)

            all_scores[candidate_idx] = cv.mean_score
            all_C[candidate_idx] = C
            all_lr[candidate_idx] = lr

            Progress.on_fit_end(candidate_idx, n_candidates, cv.mean_score)

            if cv.mean_score > best_score {
                best_score = cv.mean_score
                best_C = C
                best_lr = lr
            }

            cv_result_free(cv)
            candidate_idx = candidate_idx + 1
        }
    }

    Progress.on_complete("Best score achieved")

    return GridSearchResult {
        best_C: best_C,
        best_lr: best_lr,
        best_score: best_score,
        all_scores: all_scores,
        all_C: all_C,
        all_lr: all_lr,
        n_candidates: n_candidates
    }
}

function _cv_logistic_single(X: Matrix, y: ptr<f32>, n_classes: i32, n_folds: i32, epochs: i32, lr: f32, penalty: Penalty) -> CVResult {
    let n: i32 = X.rows
    let fold_size: i32 = n / n_folds
    let scores: ptr<f32> = array_new_f32(n_folds)

    for fold in 0 to n_folds {
        let test_start: i32 = fold * fold_size
        let test_end: i32 = test_start + fold_size
        if fold == n_folds - 1 {
            test_end = n
        }
        let n_test: i32 = test_end - test_start
        let n_train: i32 = n - n_test

        let X_train: Matrix = matrix_new(n_train, X.cols)
        let y_train: ptr<f32> = array_new_f32(n_train)
        let mut train_pos: i32 = 0
        for i in 0 to n {
            if i < test_start || i >= test_end {
                y_train[train_pos] = y[i]
                for j in 0 to X.cols {
                    matrix_set(X_train, train_pos, j, matrix_at(X, i, j))
                }
                train_pos = train_pos + 1
            }
        }

        let X_test: Matrix = matrix_new(n_test, X.cols)
        let y_test: ptr<f32> = array_new_f32(n_test)
        for i in 0 to n_test {
            y_test[i] = y[test_start + i]
            for j in 0 to X.cols {
                matrix_set(X_test, i, j, matrix_at(X, test_start + i, j))
            }
        }

        let model: LogisticRegression = logistic_regression_fit(X_train, y_train, n_classes, epochs, lr, penalty)
        let probs: ptr<f32> = logistic_predict(model, X_test)
        let preds: ptr<f32> = logistic_decide(model, probs, n_test, 0.5)

        scores[fold] = accuracy_score(y_test, preds, n_test)

        array_free_f32(probs)
        array_free_f32(preds)
        logistic_regression_free(model)
        matrix_free(X_train)
        matrix_free(X_test)
        array_free_f32(y_train)
        array_free_f32(y_test)
    }

    let mean: f32 = array_mean(scores, n_folds)
    let std: f32 = array_std(scores, n_folds, mean)

    return CVResult { scores: scores, n_folds: n_folds, mean_score: mean, std_score: std }
}

export function print_grid_search_result(result: GridSearchResult) -> void {
    println("")
    println("Grid Search Results")
    println("===================")
    for i in 0 to result.n_candidates {
        print("  Candidate ")
        print(i + 1)
        print(": C=")
        printf("%.4f", result.all_C[i])
        print("  lr=")
        printf("%.4f", result.all_lr[i])
        print("  score=")
        printf("%.4f", result.all_scores[i])
        println("")
    }
    println("")
    print("  Best: C=")
    printf("%.4f", result.best_C)
    print("  lr=")
    printf("%.4f", result.best_lr)
    print("  score=")
    printf("%.4f", result.best_score)
    println("")
}

export function grid_search_result_free(result: GridSearchResult) -> void {
    array_free_f32(result.all_scores)
    array_free_f32(result.all_C)
    array_free_f32(result.all_lr)
}

# ============================================================================
# RandomizedSearchCV (Issues #30852, #32946)
# Samples n_iter random parameter combinations from the grid.
# Uses Progress effect system for reporting.
# ============================================================================

export struct RandomizedSearchResult {
    best_C: f32,
    best_lr: f32,
    best_score: f32,
    all_scores: ptr<f32>,
    all_C: ptr<f32>,
    all_lr: ptr<f32>,
    n_candidates: i32
}

export function randomized_search_logistic(X: Matrix, y: ptr<f32>, n_classes: i32, grid: ParamGrid, n_folds: i32, epochs: i32, n_iter: i32, seed: i32) -> RandomizedSearchResult {
    let all_scores: ptr<f32> = array_new_f32(n_iter)
    let all_C: ptr<f32> = array_new_f32(n_iter)
    let all_lr: ptr<f32> = array_new_f32(n_iter)

    let mut best_score: f32 = 0.0
    let mut best_C: f32 = grid.C_values[0]
    let mut best_lr: f32 = grid.lr_values[0]

    srand(seed)

    for iter in 0 to n_iter {
        let ci: i32 = rand() % grid.n_C
        let li: i32 = rand() % grid.n_lr
        let C: f32 = grid.C_values[ci]
        let lr: f32 = grid.lr_values[li]

        Progress.on_fit_start(iter, n_iter, "C=, lr=")

        let penalty: Penalty = penalty_l2(C)
        let cv: CVResult = _cv_logistic_single(X, y, n_classes, n_folds, epochs, lr, penalty)

        all_scores[iter] = cv.mean_score
        all_C[iter] = C
        all_lr[iter] = lr

        Progress.on_fit_end(iter, n_iter, cv.mean_score)

        if cv.mean_score > best_score {
            best_score = cv.mean_score
            best_C = C
            best_lr = lr
        }

        cv_result_free(cv)
    }

    Progress.on_complete("Randomized search complete")

    return RandomizedSearchResult {
        best_C: best_C,
        best_lr: best_lr,
        best_score: best_score,
        all_scores: all_scores,
        all_C: all_C,
        all_lr: all_lr,
        n_candidates: n_iter
    }
}

export function randomized_search_result_free(result: RandomizedSearchResult) -> void {
    array_free_f32(result.all_scores)
    array_free_f32(result.all_C)
    array_free_f32(result.all_lr)
}

# ============================================================================
# KFold
# ============================================================================

export struct KFold {
    n_splits: i32,
    shuffle: bool,
    seed: i32
}

export struct FoldIndices {
    train_indices: ptr<i32>,
    n_train: i32,
    test_indices: ptr<i32>,
    n_test: i32
}

export function kfold_init(n_splits: i32, shuffle: bool, seed: i32) -> KFold {
    return KFold { n_splits: n_splits, shuffle: shuffle, seed: seed }
}

export function kfold_get_fold(kf: KFold, n_samples: i32, fold: i32) -> FoldIndices {
    let fold_size: i32 = n_samples / kf.n_splits
    let test_start: i32 = fold * fold_size
    let test_end: i32 = test_start + fold_size
    if fold == kf.n_splits - 1 {
        test_end = n_samples
    }
    let n_test: i32 = test_end - test_start
    let n_train: i32 = n_samples - n_test

    let indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    for i in 0 to n_samples {
        indices[i] = i
    }

    if kf.shuffle {
        srand(kf.seed + fold)
        for i in 0 to n_samples {
            let j: i32 = rand() % n_samples
            let tmp: i32 = indices[i]
            indices[i] = indices[j]
            indices[j] = tmp
        }
    }

    let train_indices: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
    let test_indices: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>
    let mut train_pos: i32 = 0
    let mut test_pos: i32 = 0

    for i in 0 to n_samples {
        if i >= test_start && i < test_end {
            test_indices[test_pos] = indices[i]
            test_pos = test_pos + 1
        } else {
            train_indices[train_pos] = indices[i]
            train_pos = train_pos + 1
        }
    }

    free(indices as ptr<void>)

    return FoldIndices {
        train_indices: train_indices,
        n_train: n_train,
        test_indices: test_indices,
        n_test: n_test
    }
}

export function fold_indices_free(fold: FoldIndices) -> void {
    free(fold.train_indices as ptr<void>)
    free(fold.test_indices as ptr<void>)
}

# ============================================================================
# StratifiedKFold
# ============================================================================

export struct StratifiedKFold {
    n_splits: i32,
    shuffle: bool,
    seed: i32
}

export function stratified_kfold_init(n_splits: i32, shuffle: bool, seed: i32) -> StratifiedKFold {
    return StratifiedKFold { n_splits: n_splits, shuffle: shuffle, seed: seed }
}

export function stratified_kfold_get_fold(skf: StratifiedKFold, y: ptr<f32>, n_samples: i32, fold: i32) -> FoldIndices {
    let unique: ptr<f32> = array_new_f32(n_samples)
    let mut n_classes: i32 = 0
    for i in 0 to n_samples {
        let mut found: bool = false
        for k in 0 to n_classes {
            if unique[k] == y[i] {
                found = true
            }
        }
        if not found {
            unique[n_classes] = y[i]
            n_classes = n_classes + 1
        }
    }

    let class_indices: ptr<ptr<i32> > = malloc((n_classes as i64) * 8) as ptr<ptr<i32> >
    let class_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes {
        class_indices[c] = malloc((n_samples as i64) * 4) as ptr<i32>
        class_counts[c] = 0
    }

    for i in 0 to n_samples {
        for c in 0 to n_classes {
            if y[i] == unique[c] {
                class_indices[c][class_counts[c]] = i
                class_counts[c] = class_counts[c] + 1
            }
        }
    }

    if skf.shuffle {
        srand(skf.seed + fold)
        for c in 0 to n_classes {
            for i in 0 to class_counts[c] {
                let j: i32 = rand() % class_counts[c]
                let tmp: i32 = class_indices[c][i]
                class_indices[c][i] = class_indices[c][j]
                class_indices[c][j] = tmp
            }
        }
    }

    let n_test: i32 = 0
    let n_train: i32 = 0
    for c in 0 to n_classes {
        let n_c: i32 = class_counts[c]
        let n_test_c: i32 = n_c / skf.n_splits
        n_test = n_test + n_test_c
        n_train = n_train + (n_c - n_test_c)
    }

    let train_indices: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
    let test_indices: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>
    let mut train_pos: i32 = 0
    let mut test_pos: i32 = 0

    for c in 0 to n_classes {
        let n_c: i32 = class_counts[c]
        let n_test_c: i32 = n_c / skf.n_splits
        let test_start: i32 = fold * n_test_c
        if fold == skf.n_splits - 1 {
            n_test_c = n_c - test_start
        }

        for i in 0 to test_start {
            train_indices[train_pos] = class_indices[c][i]
            train_pos = train_pos + 1
        }
        for i in 0 to n_test_c {
            test_indices[test_pos] = class_indices[c][test_start + i]
            test_pos = test_pos + 1
        }
        for i in test_start + n_test_c to n_c {
            train_indices[train_pos] = class_indices[c][i]
            train_pos = train_pos + 1
        }
    }

    for c in 0 to n_classes {
        free(class_indices[c] as ptr<void>)
    }
    free(class_indices as ptr<void>)
    free(class_counts as ptr<void>)
    array_free_f32(unique)

    return FoldIndices {
        train_indices: train_indices,
        n_train: n_train,
        test_indices: test_indices,
        n_test: n_test
    }
}

# ============================================================================
# Learning curve
# ============================================================================

export struct LearningCurveResult {
    train_sizes: ptr<i32>,
    train_scores: ptr<f32>,
    test_scores: ptr<f32>,
    n_points: i32
}

export function learning_curve(X: Matrix, y: ptr<f32>, n_classes: i32, train_sizes: ptr<i32>, n_sizes: i32, epochs: i32, lr: f32) -> LearningCurveResult {
    let train_scores: ptr<f32> = array_new_f32(n_sizes)
    let test_scores: ptr<f32> = array_new_f32(n_sizes)

    let n: i32 = X.rows
    let n_test: i32 = n / 5

    for s in 0 to n_sizes {
        let n_train: i32 = train_sizes[s]
        if n_train > n - n_test {
            n_train = n - n_test
        }

        let X_train: Matrix = matrix_new(n_train, X.cols)
        let y_train: ptr<f32> = array_new_f32(n_train)
        let X_test: Matrix = matrix_new(n_test, X.cols)
        let y_test: ptr<f32> = array_new_f32(n_test)

        for i in 0 to n_train {
            y_train[i] = y[i]
            for j in 0 to X.cols {
                matrix_set(X_train, i, j, matrix_at(X, i, j))
            }
        }
        for i in 0 to n_test {
            y_test[i] = y[n_train + i]
            for j in 0 to X.cols {
                matrix_set(X_test, i, j, matrix_at(X, n_train + i, j))
            }
        }

        let penalty: Penalty = penalty_l2(0.01)
        let model: LogisticRegression = logistic_regression_fit(X_train, y_train, n_classes, epochs, lr, penalty)

        let train_probs: ptr<f32> = logistic_predict(model, X_train)
        let train_preds: ptr<f32> = logistic_decide(model, train_probs, n_train, 0.5)
        train_scores[s] = accuracy_score(y_train, train_preds, n_train)

        let test_probs: ptr<f32> = logistic_predict(model, X_test)
        let test_preds: ptr<f32> = logistic_decide(model, test_probs, n_test, 0.5)
        test_scores[s] = accuracy_score(y_test, test_preds, n_test)

        array_free_f32(train_probs)
        array_free_f32(train_preds)
        array_free_f32(test_probs)
        array_free_f32(test_preds)
        logistic_regression_free(model)
        matrix_free(X_train)
        matrix_free(X_test)
        array_free_f32(y_train)
        array_free_f32(y_test)
    }

    return LearningCurveResult {
        train_sizes: train_sizes,
        train_scores: train_scores,
        test_scores: test_scores,
        n_points: n_sizes
    }
}

export function print_learning_curve(result: LearningCurveResult) -> void {
    println("")
    println("Learning Curve")
    println("===============")
    println("  train_size  train_score  test_score")
    for i in 0 to result.n_points {
        print("  ")
        print(result.train_sizes[i])
        print("          ")
        printf("%.4f", result.train_scores[i])
        print("      ")
        printf("%.4f", result.test_scores[i])
        println("")
    }
}

export function learning_curve_free(result: LearningCurveResult) -> void {
    array_free_f32(result.train_scores)
    array_free_f32(result.test_scores)
}

# ============================================================================
# Validation curve
# ============================================================================

export struct ValidationCurveResult {
    param_values: ptr<f32>,
    train_scores: ptr<f32>,
    test_scores: ptr<f32>,
    n_points: i32
}

export function validation_curve(X: Matrix, y: ptr<f32>, n_classes: i32, param_values: ptr<f32>, n_points: i32, epochs: i32, lr: f32) -> ValidationCurveResult {
    let train_scores: ptr<f32> = array_new_f32(n_points)
    let test_scores: ptr<f32> = array_new_f32(n_points)

    let n: i32 = X.rows
    let n_test: i32 = n / 5
    let n_train: i32 = n - n_test

    let X_train: Matrix = matrix_new(n_train, X.cols)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let X_test: Matrix = matrix_new(n_test, X.cols)
    let y_test: ptr<f32> = array_new_f32(n_test)

    for i in 0 to n_train {
        y_train[i] = y[i]
        for j in 0 to X.cols {
            matrix_set(X_train, i, j, matrix_at(X, i, j))
        }
    }
    for i in 0 to n_test {
        y_test[i] = y[n_train + i]
        for j in 0 to X.cols {
            matrix_set(X_test, i, j, matrix_at(X, n_train + i, j))
        }
    }

    for p in 0 to n_points {
        let alpha: f32 = param_values[p]
        let penalty: Penalty = penalty_l2(alpha)
        let model: LogisticRegression = logistic_regression_fit(X_train, y_train, n_classes, epochs, lr, penalty)

        let train_probs: ptr<f32> = logistic_predict(model, X_train)
        let train_preds: ptr<f32> = logistic_decide(model, train_probs, n_train, 0.5)
        train_scores[p] = accuracy_score(y_train, train_preds, n_train)

        let test_probs: ptr<f32> = logistic_predict(model, X_test)
        let test_preds: ptr<f32> = logistic_decide(model, test_probs, n_test, 0.5)
        test_scores[p] = accuracy_score(y_test, test_preds, n_test)

        array_free_f32(train_probs)
        array_free_f32(train_preds)
        array_free_f32(test_probs)
        array_free_f32(test_preds)
        logistic_regression_free(model)
    }

    matrix_free(X_train)
    matrix_free(X_test)
    array_free_f32(y_train)
    array_free_f32(y_test)

    return ValidationCurveResult {
        param_values: param_values,
        train_scores: train_scores,
        test_scores: test_scores,
        n_points: n_points
    }
}

export function validation_curve_free(result: ValidationCurveResult) -> void {
    array_free_f32(result.train_scores)
    array_free_f32(result.test_scores)
}

# ============================================================================
# ShuffleSplit
# ============================================================================

export struct ShuffleSplit {
    n_splits: i32,
    test_size: f32,
    seed: i32
}

export function shuffle_split_init(n_splits: i32, test_size: f32, seed: i32) -> ShuffleSplit {
    return ShuffleSplit { n_splits: n_splits, test_size: test_size, seed: seed }
}

export function shuffle_split_get_split(ss: ShuffleSplit, n_samples: i32, split: i32) -> FoldIndices {
    let n_test: i32 = ((n_samples as f32) * ss.test_size) as i32
    let n_train: i32 = n_samples - n_test

    let indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    for i in 0 to n_samples {
        indices[i] = i
    }

    srand(ss.seed + split)
    for i in 0 to n_samples {
        let j: i32 = rand() % n_samples
        let tmp: i32 = indices[i]
        indices[i] = indices[j]
        indices[j] = tmp
    }

    let train_indices: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
    let test_indices: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>
    for i in 0 to n_train {
        train_indices[i] = indices[i]
    }
    for i in 0 to n_test {
        test_indices[i] = indices[n_train + i]
    }

    free(indices as ptr<void>)

    return FoldIndices {
        train_indices: train_indices,
        n_train: n_train,
        test_indices: test_indices,
        n_test: n_test
    }
}

# ============================================================================
# RepeatedKFold
# ============================================================================

export struct RepeatedKFold {
    n_splits: i32,
    n_repeats: i32,
    seed: i32
}

export function repeated_kfold_init(n_splits: i32, n_repeats: i32, seed: i32) -> RepeatedKFold {
    return RepeatedKFold {
        n_splits: n_splits,
        n_repeats: n_repeats,
        seed: seed
    }
}

export function repeated_kfold_get_fold(rkf: RepeatedKFold, n_samples: i32, repeat: i32, fold: i32) -> FoldIndices {
    let current_seed: i32 = rkf.seed + repeat * 1000 + fold
    let kf: KFold = kfold_init(rkf.n_splits, true, current_seed)
    return kfold_get_fold(kf, n_samples, fold)
}

# ============================================================================
# TimeSeriesSplit
# ============================================================================

export function time_series_split(n_samples: i32, n_splits: i32, fold: i32) -> FoldIndices {
    let n_test: i32 = n_samples / (n_splits + 1)
    if n_test < 1 { n_test = 1 }
    let n_train: i32 = n_test * (fold + 1)
    let test_start: i32 = n_train
    let test_end: i32 = test_start + n_test
    if test_end > n_samples { test_end = n_samples }

    let train_indices: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
    let test_indices: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>

    for i in 0 to n_train {
        train_indices[i] = i
    }
    for i in 0 to n_test {
        test_indices[i] = test_start + i
    }

    return FoldIndices {
        train_indices: train_indices,
        n_train: n_train,
        test_indices: test_indices,
        n_test: n_test
    }
}

# ============================================================================
# LeaveOneOut
# ============================================================================

export function leave_one_out(n_samples: i32, fold: i32) -> FoldIndices {
    let n_train: i32 = n_samples - 1
    let n_test: i32 = 1

    let train_indices: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
    let test_indices: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>

    test_indices[0] = fold
    let mut idx: i32 = 0
    for i in 0 to n_samples {
        if i == fold { continue }
        train_indices[idx] = i
        idx = idx + 1
    }

    return FoldIndices {
        train_indices: train_indices,
        n_train: n_train,
        test_indices: test_indices,
        n_test: n_test
    }
}

# ============================================================================
# cross_val_predict
# ============================================================================

export function cross_val_predict(
    X: Matrix,
    y: ptr<f32>,
    n_splits: i32,
    predict_fn: ptr<void>,
    n_samples: i32,
    n_features: i32
) -> ptr<f32> {
    let predictions: ptr<f32> = array_new_f32(n_samples)
    let fold_size: i32 = n_samples / n_splits

    for fold in 0 to n_splits {
        let test_start: i32 = fold * fold_size
        let test_end: i32 = test_start + fold_size
        if fold == n_splits - 1 { test_end = n_samples }

        let n_train: i32 = n_samples - (test_end - test_start)
        let train_indices: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
        let mut idx: i32 = 0
        for i in 0 to n_samples {
            if i >= test_start && i < test_end { continue }
            train_indices[idx] = i
            idx = idx + 1
        }

        let X_train: Matrix = matrix_new(n_train, n_features)
        let y_train: ptr<f32> = array_new_f32(n_train)
        for i in 0 to n_train {
            for j in 0 to n_features {
                matrix_set(X_train, i, j, matrix_at(X, train_indices[i], j))
            }
            y_train[i] = y[train_indices[i]]
        }

        let X_test: Matrix = matrix_new(test_end - test_start, n_features)
        for i in test_start to test_end {
            for j in 0 to n_features {
                matrix_set(X_test, i - test_start, j, matrix_at(X, i, j))
            }
        }

        let model: LinearRegression = linear_regression_fit(X_train, y_train, penalty_none())
        let preds: ptr<f32> = linear_regression_predict(model, X_test)
        for i in test_start to test_end {
            predictions[i] = preds[i - test_start]
        }

        free(train_indices as ptr<void>)
        matrix_free(X_train)
        array_free_f32(y_train)
        matrix_free(X_test)
        linear_regression_free(model)
        array_free_f32(preds)
    }

    return predictions
}

# ============================================================================
# repeated_k_fold (Issue #28394)
# Repeats KFold n_repeats times with different seeds.
# Returns a struct with an array of per-fold scores.
# ============================================================================

export struct RepeatedKFoldResult {
    scores: ptr<f32>,
    n_scores: i32,
    fitted: bool
}

export function repeated_k_fold(X: Matrix, y: ptr<f32>, n_splits: i32, n_repeats: i32, seed: i32) -> RepeatedKFoldResult {
    let n: i32 = X.rows
    let total: i32 = n_splits * n_repeats
    let scores: ptr<f32> = array_new_f32(total)

    let mut n_classes: i32 = 0
    let classes: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_classes {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_classes] = y[i]
            n_classes = n_classes + 1
        }
    }
    array_free_f32(classes)

    let mut pos: i32 = 0
    for r in 0 to n_repeats {
        let current_seed: i32 = seed + r * 1000
        let kf: KFold = kfold_init(n_splits, true, current_seed)

        for fold in 0 to n_splits {
            let fi: FoldIndices = kfold_get_fold(kf, n, fold)

            let X_train: Matrix = matrix_new(fi.n_train, X.cols)
            let y_train: ptr<f32> = array_new_f32(fi.n_train)
            for i in 0 to fi.n_train {
                let idx: i32 = fi.train_indices[i]
                y_train[i] = y[idx]
                for j in 0 to X.cols {
                    matrix_set(X_train, i, j, matrix_at(X, idx, j))
                }
            }

            let X_test: Matrix = matrix_new(fi.n_test, X.cols)
            let y_test: ptr<f32> = array_new_f32(fi.n_test)
            for i in 0 to fi.n_test {
                let idx: i32 = fi.test_indices[i]
                y_test[i] = y[idx]
                for j in 0 to X.cols {
                    matrix_set(X_test, i, j, matrix_at(X, idx, j))
                }
            }

            let tree: DecisionTreeClassifier = decision_tree_classifier_fit(X_train, y_train, n_classes, 5, CRITERION_GINI)
            let preds: ptr<f32> = decision_tree_classifier_predict(tree, X_test)
            scores[pos] = accuracy_score(y_test, preds, fi.n_test)

            array_free_f32(preds)
            decision_tree_classifier_free(tree)
            matrix_free(X_train)
            matrix_free(X_test)
            array_free_f32(y_train)
            array_free_f32(y_test)
            fold_indices_free(fi)

            pos = pos + 1
        }
    }

    let result: RepeatedKFoldResult = RepeatedKFoldResult {
        scores: scores,
        n_scores: total,
        fitted: true
    }
    return result
}

export function repeated_kfold_result_free(result: RepeatedKFoldResult) -> void {
    array_free_f32(result.scores)
}

# ============================================================================
# cross_val_score
# Performs k-fold cross-validation and returns an array of scores.
# metric_type: 0=accuracy, 1=r2, 2=mse.
# ============================================================================

export function cross_val_score(X: Matrix, y: ptr<f32>, n_folds: i32, metric_type: i32) -> ptr<f32> {
    let n: i32 = X.rows
    let fold_size: i32 = n / n_folds
    let scores: ptr<f32> = array_new_f32(n_folds)

    let mut n_classes: i32 = 0
    let classes: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_classes {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_classes] = y[i]
            n_classes = n_classes + 1
        }
    }
    array_free_f32(classes)

    for fold in 0 to n_folds {
        let test_start: i32 = fold * fold_size
        let test_end: i32 = test_start + fold_size
        if fold == n_folds - 1 {
            test_end = n
        }
        let n_test: i32 = test_end - test_start
        let n_train: i32 = n - n_test

        let X_train: Matrix = matrix_new(n_train, X.cols)
        let y_train: ptr<f32> = array_new_f32(n_train)
        let mut train_pos: i32 = 0
        for i in 0 to n {
            if i < test_start || i >= test_end {
                y_train[train_pos] = y[i]
                for j in 0 to X.cols {
                    matrix_set(X_train, train_pos, j, matrix_at(X, i, j))
                }
                train_pos = train_pos + 1
            }
        }

        let X_test: Matrix = matrix_new(n_test, X.cols)
        let y_test: ptr<f32> = array_new_f32(n_test)
        for i in 0 to n_test {
            y_test[i] = y[test_start + i]
            for j in 0 to X.cols {
                matrix_set(X_test, i, j, matrix_at(X, test_start + i, j))
            }
        }

        if metric_type == 0 {
            let tree: DecisionTreeClassifier = decision_tree_classifier_fit(X_train, y_train, n_classes, 5, CRITERION_GINI)
            let preds: ptr<f32> = decision_tree_classifier_predict(tree, X_test)
            scores[fold] = accuracy_score(y_test, preds, n_test)
            array_free_f32(preds)
            decision_tree_classifier_free(tree)
        } else {
            let model: LinearRegression = linear_regression_fit(X_train, y_train, penalty_none())
            let preds: ptr<f32> = linear_regression_predict(model, X_test)
            if metric_type == 1 {
                scores[fold] = r2_score(y_test, preds, n_test)
            } else {
                scores[fold] = mean_squared_error(y_test, preds, n_test)
            }
            array_free_f32(preds)
            linear_regression_free(model)
        }

        matrix_free(X_train)
        matrix_free(X_test)
        array_free_f32(y_train)
        array_free_f32(y_test)
    }

    return scores
}

# ============================================================================
# check_cv
# Returns info about the CV splitter.
# If cv is 0, uses default 5-fold.
# Note: CVResult is already used by cross_validate_score, so this returns
# CVSplitInfo to avoid a struct redefinition conflict.
# ============================================================================

export struct CVSplit {
    train_indices: ptr<i32>,
    n_train: i32,
    test_indices: ptr<i32>,
    n_test: i32
}

export struct CVSplitInfo {
    n_splits: i32,
    is_stratified: bool
}

export function check_cv(cv: i32, n_samples: i32) -> CVSplitInfo {
    let n_splits: i32 = cv
    if n_splits == 0 {
        n_splits = 5
    }
    if n_splits < 2 {
        n_splits = 2
    }
    if n_splits > n_samples {
        n_splits = n_samples
    }

    let result: CVSplitInfo = CVSplitInfo {
        n_splits: n_splits,
        is_stratified: false
    }
    return result
}

# ============================================================================
# permutation_test_score
# Computes the actual score and permutation scores.
# Returns a struct with the true score, mean permutation score, and p-value.
# ============================================================================

export struct PermutationTestResult {
    true_score: f32,
    perm_mean: f32,
    p_value: f32
}

export function permutation_test_score(X: Matrix, y: ptr<f32>, n_permutations: i32, seed: i32) -> PermutationTestResult {
    let n: i32 = X.rows
    let n_test: i32 = n / 5
    if n_test < 1 {
        n_test = 1
    }
    let n_train: i32 = n - n_test

    let mut n_classes: i32 = 0
    let classes: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_classes {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_classes] = y[i]
            n_classes = n_classes + 1
        }
    }
    array_free_f32(classes)

    let X_train: Matrix = matrix_new(n_train, X.cols)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let X_test: Matrix = matrix_new(n_test, X.cols)
    let y_test: ptr<f32> = array_new_f32(n_test)

    for i in 0 to n_train {
        y_train[i] = y[i]
        for j in 0 to X.cols {
            matrix_set(X_train, i, j, matrix_at(X, i, j))
        }
    }
    for i in 0 to n_test {
        y_test[i] = y[n_train + i]
        for j in 0 to X.cols {
            matrix_set(X_test, i, j, matrix_at(X, n_train + i, j))
        }
    }

    let true_tree: DecisionTreeClassifier = decision_tree_classifier_fit(X_train, y_train, n_classes, 5, CRITERION_GINI)
    let true_preds: ptr<f32> = decision_tree_classifier_predict(true_tree, X_test)
    let true_score: f32 = accuracy_score(y_test, true_preds, n_test)
    array_free_f32(true_preds)
    decision_tree_classifier_free(true_tree)

    let perm_scores: ptr<f32> = array_new_f32(n_permutations)
    let y_perm: ptr<f32> = array_new_f32(n_train)

    srand(seed)
    for p in 0 to n_permutations {
        for i in 0 to n_train {
            y_perm[i] = y_train[i]
        }
        for i in 0 to n_train {
            let j: i32 = rand() % n_train
            let tmp: f32 = y_perm[i]
            y_perm[i] = y_perm[j]
            y_perm[j] = tmp
        }

        let tree: DecisionTreeClassifier = decision_tree_classifier_fit(X_train, y_perm, n_classes, 5, CRITERION_GINI)
        let preds: ptr<f32> = decision_tree_classifier_predict(tree, X_test)
        perm_scores[p] = accuracy_score(y_test, preds, n_test)
        array_free_f32(preds)
        decision_tree_classifier_free(tree)
    }

    let mut perm_sum: f32 = 0.0
    let mut count_ge: i32 = 0
    for p in 0 to n_permutations {
        perm_sum = perm_sum + perm_scores[p]
        if perm_scores[p] >= true_score {
            count_ge = count_ge + 1
        }
    }
    let perm_mean: f32 = perm_sum / (n_permutations as f32)
    let p_value: f32 = ((count_ge + 1) as f32) / ((n_permutations + 1) as f32)

    array_free_f32(perm_scores)
    array_free_f32(y_perm)
    matrix_free(X_train)
    matrix_free(X_test)
    array_free_f32(y_train)
    array_free_f32(y_test)

    let result: PermutationTestResult = PermutationTestResult {
        true_score: true_score,
        perm_mean: perm_mean,
        p_value: p_value
    }
    return result
}

# ============================================================================
# LeavePOut
# Leave p out cross-validation. n_splits = C(n, p), capped at 100.
# ============================================================================

export struct LeavePOut {
    n: i32,
    p: i32,
    n_splits: i32
}

function _binomial_capped(n: i32, k: i32) -> i32 {
    if k > n {
        return 0
    }
    if k == 0 || k == n {
        return 1
    }
    let mut result: i32 = 1
    let mut i: i32 = 0
    while i < k {
        result = result * (n - i)
        result = result / (i + 1)
        if result > 100 {
            return 100
        }
        i = i + 1
    }
    if result > 100 {
        return 100
    }
    return result
}

function _leave_p_out_nth_combo(n: i32, p: i32, target: i32, combo: ptr<i32>) -> bool {
    for i in 0 to p {
        combo[i] = i
    }
    let mut count: i32 = 0
    if count == target {
        return true
    }
    while true {
        let mut i: i32 = p - 1
        let mut found: bool = false
        while i >= 0 && not found {
            if combo[i] < n - p + i {
                found = true
            } else {
                i = i - 1
            }
        }
        if not found {
            return false
        }
        combo[i] = combo[i] + 1
        let mut j: i32 = i + 1
        while j < p {
            combo[j] = combo[j - 1] + 1
            j = j + 1
        }
        count = count + 1
        if count == target {
            return true
        }
        if count >= 100 {
            return false
        }
    }
    return false
}

export function leave_p_out_init(n: i32, p: i32) -> LeavePOut {
    let ns: i32 = _binomial_capped(n, p)
    let result: LeavePOut = LeavePOut {
        n: n,
        p: p,
        n_splits: ns
    }
    return result
}

export function leave_p_out_get_split(splitter: LeavePOut, split_idx: i32) -> TrainTestSplit {
    let n: i32 = splitter.n
    let p: i32 = splitter.p

    let combo: ptr<i32> = malloc((p as i64) * 4) as ptr<i32>
    _leave_p_out_nth_combo(n, p, split_idx, combo)

    let n_test: i32 = p
    let n_train: i32 = n - p

    let is_test: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        is_test[i] = 0
    }
    for i in 0 to p {
        is_test[combo[i]] = 1
    }

    let X_train: Matrix = matrix_new(n_train, 0)
    let X_test: Matrix = matrix_new(n_test, 0)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let y_test: ptr<f32> = array_new_f32(n_test)

    let mut train_pos: i32 = 0
    let mut test_pos: i32 = 0
    for i in 0 to n {
        if is_test[i] == 1 {
            y_test[test_pos] = 0.0
            test_pos = test_pos + 1
        } else {
            y_train[train_pos] = 0.0
            train_pos = train_pos + 1
        }
    }

    free(combo as ptr<void>)
    free(is_test as ptr<void>)

    let result: TrainTestSplit = TrainTestSplit {
        X_train: X_train,
        X_test: X_test,
        y_train: y_train,
        y_test: y_test,
        n_train: n_train,
        n_test: n_test
    }
    return result
}

# ============================================================================
# StratifiedShuffleSplit
# Stratified random split. Shuffles within each class and takes test_size
# fraction from each class.
# ============================================================================

export struct StratifiedShuffleSplit {
    n_splits: i32,
    test_size: f32,
    n: i32,
    n_classes: i32,
    seed: i32
}

export function stratified_shuffle_split_init(n_splits: i32, test_size: f32, n: i32, n_classes: i32, seed: i32) -> StratifiedShuffleSplit {
    let result: StratifiedShuffleSplit = StratifiedShuffleSplit {
        n_splits: n_splits,
        test_size: test_size,
        n: n,
        n_classes: n_classes,
        seed: seed
    }
    return result
}

export function stratified_shuffle_split_get_split(splitter: StratifiedShuffleSplit, split_idx: i32, y: ptr<f32>) -> TrainTestSplit {
    let n: i32 = splitter.n
    let test_size: f32 = splitter.test_size

    let unique: ptr<f32> = array_new_f32(n)
    let mut n_found: i32 = 0
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_found {
            if unique[k] == y[i] {
                found = true
            }
        }
        if not found {
            unique[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let class_indices: ptr<ptr<i32> > = malloc((n_found as i64) * 8) as ptr<ptr<i32> >
    let class_counts: ptr<i32> = malloc((n_found as i64) * 4) as ptr<i32>
    for c in 0 to n_found {
        class_indices[c] = malloc((n as i64) * 4) as ptr<i32>
        class_counts[c] = 0
    }

    for i in 0 to n {
        for c in 0 to n_found {
            if y[i] == unique[c] {
                class_indices[c][class_counts[c]] = i
                class_counts[c] = class_counts[c] + 1
            }
        }
    }

    srand(splitter.seed + split_idx)
    for c in 0 to n_found {
        let cnt: i32 = class_counts[c]
        for i in 0 to cnt {
            let j: i32 = rand() % cnt
            let tmp: i32 = class_indices[c][i]
            class_indices[c][i] = class_indices[c][j]
            class_indices[c][j] = tmp
        }
    }

    let is_test: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        is_test[i] = 0
    }

    let mut test_count: i32 = 0
    for c in 0 to n_found {
        let cnt: i32 = class_counts[c]
        let n_test_c: i32 = ((cnt as f32) * test_size) as i32
        for i in 0 to n_test_c {
            is_test[class_indices[c][i]] = 1
            test_count = test_count + 1
        }
    }

    let n_test: i32 = test_count
    let n_train: i32 = n - n_test

    let X_train: Matrix = matrix_new(n_train, 0)
    let X_test: Matrix = matrix_new(n_test, 0)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let y_test: ptr<f32> = array_new_f32(n_test)

    let mut train_pos: i32 = 0
    let mut test_pos: i32 = 0
    for i in 0 to n {
        if is_test[i] == 1 {
            y_test[test_pos] = y[i]
            test_pos = test_pos + 1
        } else {
            y_train[train_pos] = y[i]
            train_pos = train_pos + 1
        }
    }

    for c in 0 to n_found {
        free(class_indices[c] as ptr<void>)
    }
    free(class_indices as ptr<void>)
    free(class_counts as ptr<void>)
    array_free_f32(unique)
    free(is_test as ptr<void>)

    let result: TrainTestSplit = TrainTestSplit {
        X_train: X_train,
        X_test: X_test,
        y_train: y_train,
        y_test: y_test,
        n_train: n_train,
        n_test: n_test
    }
    return result
}

# ============================================================================
# GroupKFold
# K-fold with group awareness. Same group does not appear in both train and
# test. Groups are assigned to folds round-robin.
# ============================================================================

export struct GroupKFold {
    n_splits: i32,
    n: i32
}

export function group_kfold_init(n_splits: i32, n: i32) -> GroupKFold {
    let result: GroupKFold = GroupKFold {
        n_splits: n_splits,
        n: n
    }
    return result
}

export function group_kfold_split(splitter: GroupKFold, groups: ptr<i32>, n: i32) -> GroupCVResult {
    let n_splits: i32 = splitter.n_splits

    let unique_groups: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut n_found: i32 = 0
    for i in 0 to n {
        let mut found: bool = false
        for k in 0 to n_found {
            if unique_groups[k] == groups[i] {
                found = true
            }
        }
        if not found {
            unique_groups[n_found] = groups[i]
            n_found = n_found + 1
        }
    }

    let group_fold: ptr<i32> = malloc((n_found as i64) * 4) as ptr<i32>
    for g in 0 to n_found {
        group_fold[g] = g % n_splits
    }

    let train_ptrs: ptr<ptr<i32> > = malloc((n_splits as i64) * 8) as ptr<ptr<i32> >
    let test_ptrs: ptr<ptr<i32> > = malloc((n_splits as i64) * 8) as ptr<ptr<i32> >
    let n_train_arr: ptr<i32> = malloc((n_splits as i64) * 4) as ptr<i32>
    let n_test_arr: ptr<i32> = malloc((n_splits as i64) * 4) as ptr<i32>

    for split_idx in 0 to n_splits {
        let is_test: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        for i in 0 to n {
            is_test[i] = 0
        }

        let mut n_test: i32 = 0
        for i in 0 to n {
            let mut g_idx: i32 = 0
            let mut found: bool = false
            while g_idx < n_found && not found {
                if unique_groups[g_idx] == groups[i] {
                    found = true
                } else {
                    g_idx = g_idx + 1
                }
            }
            if group_fold[g_idx] == split_idx {
                is_test[i] = 1
                n_test = n_test + 1
            }
        }

        let n_train: i32 = n - n_test
        let train_idx: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
        let test_idx: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>

        let mut ti: i32 = 0
        let mut tei: i32 = 0
        for i in 0 to n {
            if is_test[i] == 1 {
                test_idx[tei] = i
                tei = tei + 1
            } else {
                train_idx[ti] = i
                ti = ti + 1
            }
        }

        train_ptrs[split_idx] = train_idx
        test_ptrs[split_idx] = test_idx
        n_train_arr[split_idx] = n_train
        n_test_arr[split_idx] = n_test

        free(is_test as ptr<void>)
    }

    free(unique_groups as ptr<void>)
    free(group_fold as ptr<void>)

    let result: GroupCVResult = GroupCVResult {
        train_ptrs: train_ptrs,
        test_ptrs: test_ptrs,
        n_train_arr: n_train_arr,
        n_test_arr: n_test_arr,
        n_splits: n_splits
    }
    return result
}

# ============================================================================

# ============================================================================
# GroupCVResult - uses separate arrays instead of ptr<CVSplit> to avoid
# Flow compiler bug with arrays of structs containing pointers
# ============================================================================

export struct GroupCVResult {
    train_ptrs: ptr<ptr<i32> >,
    test_ptrs: ptr<ptr<i32> >,
    n_train_arr: ptr<i32>,
    n_test_arr: ptr<i32>,
    n_splits: i32
}

export function group_cv_result_free(result: GroupCVResult) -> void {
    let mut i: i32 = 0
    while i < result.n_splits {
        free(result.train_ptrs[i] as ptr<void>)
        free(result.test_ptrs[i] as ptr<void>)
        i = i + 1
    }
    free(result.train_ptrs as ptr<void>)
    free(result.test_ptrs as ptr<void>)
    free(result.n_train_arr as ptr<void>)
    free(result.n_test_arr as ptr<void>)
}

# ============================================================================
# RepeatedStratifiedKFold
# ============================================================================

export struct RepeatedStratifiedKFold {
    n_splits: i32,
    n_repeats: i32,
    seed: i32,
    fitted: bool
}

export function repeated_stratified_k_fold(y: ptr<f32>, n: i32, n_splits: i32, n_repeats: i32, seed: i32) -> RepeatedStratifiedKFold {
    let result: RepeatedStratifiedKFold = RepeatedStratifiedKFold {
        n_splits: n_splits,
        n_repeats: n_repeats,
        seed: seed,
        fitted: true
    }
    return result
}

export function repeated_stratified_k_fold_split(cv: RepeatedStratifiedKFold, y: ptr<f32>, n: i32) -> GroupCVResult {
    let total_splits: i32 = cv.n_splits * cv.n_repeats
    let train_ptrs: ptr<ptr<i32> > = malloc((total_splits as i64) * 8) as ptr<ptr<i32> >
    let test_ptrs: ptr<ptr<i32> > = malloc((total_splits as i64) * 8) as ptr<ptr<i32> >
    let n_train_arr: ptr<i32> = malloc((total_splits as i64) * 4) as ptr<i32>
    let n_test_arr: ptr<i32> = malloc((total_splits as i64) * 4) as ptr<i32>

    srand(cv.seed)

    let n_classes: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let c: i32 = y[i] as i32
        if c + 1 > n_classes { n_classes = c + 1 }
        i = i + 1
    }

    let mut idx: i32 = 0
    let mut rep: i32 = 0
    while rep < cv.n_repeats {
        let perm: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
        i = 0
        while i < n {
            perm[i] = i
            i = i + 1
        }
        i = n - 1
        while i > 0 {
            let j: i32 = rand() % (i + 1)
            let tmp: i32 = perm[i]
            perm[i] = perm[j]
            perm[j] = tmp
            i = i - 1
        }

        let test_size: i32 = n / cv.n_splits
        let train_size: i32 = n - test_size

        let mut s: i32 = 0
        while s < cv.n_splits {
            let test_start: i32 = s * test_size
            let test_end: i32 = test_start + test_size
            if s == cv.n_splits - 1 { test_end = n }

            let n_test: i32 = test_end - test_start
            let n_train: i32 = n - n_test

            let train_idx: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
            let test_idx: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>

            let mut ti: i32 = 0
            let mut tei: i32 = 0
            i = 0
            while i < n {
                if i >= test_start && i < test_end {
                    test_idx[tei] = perm[i]
                    tei = tei + 1
                } else {
                    train_idx[ti] = perm[i]
                    ti = ti + 1
                }
                i = i + 1
            }

            train_ptrs[idx] = train_idx
            test_ptrs[idx] = test_idx
            n_train_arr[idx] = n_train
            n_test_arr[idx] = n_test
            idx = idx + 1
            s = s + 1
        }

        free(perm as ptr<void>)
        rep = rep + 1
    }

    let result: GroupCVResult = GroupCVResult {
        train_ptrs: train_ptrs,
        test_ptrs: test_ptrs,
        n_train_arr: n_train_arr,
        n_test_arr: n_test_arr,
        n_splits: total_splits
    }
    return result
}

# ============================================================================
# LeaveOneGroupOut
# ============================================================================

export struct LeaveOneGroupOut {
    fitted: bool
}

export function leave_one_group_out() -> LeaveOneGroupOut {
    let result: LeaveOneGroupOut = LeaveOneGroupOut { fitted: true }
    return result
}

export function leave_one_group_out_split(groups: ptr<f32>, n: i32) -> GroupCVResult {
    let unique_groups: ptr<f32> = malloc((n as i64) * 4) as ptr<f32>
    let mut z: i32 = 0
    while z < n {
        unique_groups[z] = 0.0
        z = z + 1
    }

    let n_groups: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let mut found: bool = false
        let mut j: i32 = 0
        while j < n_groups {
            if unique_groups[j] == groups[i] {
                found = true
            }
            j = j + 1
        }
        if not found {
            unique_groups[n_groups] = groups[i]
            n_groups = n_groups + 1
        }
        i = i + 1
    }

    let train_ptrs: ptr<ptr<i32> > = malloc((n_groups as i64) * 8) as ptr<ptr<i32> >
    let test_ptrs: ptr<ptr<i32> > = malloc((n_groups as i64) * 8) as ptr<ptr<i32> >
    let n_train_arr: ptr<i32> = malloc((n_groups as i64) * 4) as ptr<i32>
    let n_test_arr: ptr<i32> = malloc((n_groups as i64) * 4) as ptr<i32>

    let mut g: i32 = 0
    while g < n_groups {
        let group_val: f32 = unique_groups[g]
        let n_test: i32 = 0
        i = 0
        while i < n {
            if groups[i] == group_val {
                n_test = n_test + 1
            }
            i = i + 1
        }
        let n_train: i32 = n - n_test
        let train_idx: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
        let test_idx: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>
        let mut ti: i32 = 0
        let mut tei: i32 = 0
        i = 0
        while i < n {
            if groups[i] == group_val {
                test_idx[tei] = i
                tei = tei + 1
            } else {
                train_idx[ti] = i
                ti = ti + 1
            }
            i = i + 1
        }
        train_ptrs[g] = train_idx
        test_ptrs[g] = test_idx
        n_train_arr[g] = n_train
        n_test_arr[g] = n_test
        g = g + 1
    }

    let result: GroupCVResult = GroupCVResult {
        train_ptrs: train_ptrs,
        test_ptrs: test_ptrs,
        n_train_arr: n_train_arr,
        n_test_arr: n_test_arr,
        n_splits: n_groups
    }
    return result
}

# ============================================================================
# LeavePGroupOut
# ============================================================================

export struct LeavePGroupOut {
    p: i32,
    fitted: bool
}

export function leave_p_group_out(p: i32) -> LeavePGroupOut {
    let result: LeavePGroupOut = LeavePGroupOut { p: p, fitted: true }
    return result
}

export function leave_p_group_out_split(groups: ptr<f32>, n: i32, p: i32) -> GroupCVResult {
    let unique_groups: ptr<f32> = malloc((n as i64) * 4) as ptr<f32>
    let mut z: i32 = 0
    while z < n {
        unique_groups[z] = 0.0
        z = z + 1
    }

    let n_groups: i32 = 0
    let mut i: i32 = 0
    while i < n {
        let mut found: bool = false
        let mut j: i32 = 0
        while j < n_groups {
            if unique_groups[j] == groups[i] {
                found = true
            }
            j = j + 1
        }
        if not found {
            unique_groups[n_groups] = groups[i]
            n_groups = n_groups + 1
        }
        i = i + 1
    }

    # Count combinations C(n_groups, p)
    let n_splits: i32 = 1
    let mut k: i32 = 0
    while k < p {
        n_splits = n_splits * (n_groups - k) / (k + 1)
        k = k + 1
    }

    let train_ptrs: ptr<ptr<i32> > = malloc((n_splits as i64) * 8) as ptr<ptr<i32> >
    let test_ptrs: ptr<ptr<i32> > = malloc((n_splits as i64) * 8) as ptr<ptr<i32> >
    let n_train_arr: ptr<i32> = malloc((n_splits as i64) * 4) as ptr<i32>
    let n_test_arr: ptr<i32> = malloc((n_splits as i64) * 4) as ptr<i32>

    let split_idx: i32 = 0

    # Generate all p-sized subsets of groups
    let combo: ptr<i32> = malloc((p as i64) * 4) as ptr<i32>
    k = 0
    while k < p {
        combo[k] = k
        k = k + 1
    }

    let mut done: bool = false
    while not done {
        # Build test set from combo groups
        let n_test: i32 = 0
        let mut i2: i32 = 0
        while i2 < n {
            let mut in_combo: bool = false
            let mut j: i32 = 0
            while j < p {
                if unique_groups[combo[j]] == groups[i2] {
                    in_combo = true
                }
                j = j + 1
            }
            if in_combo {
                n_test = n_test + 1
            }
            i2 = i2 + 1
        }
        let n_train: i32 = n - n_test
        let train_idx: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
        let test_idx: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>
        let mut ti: i32 = 0
        let mut tei: i32 = 0
        i2 = 0
        while i2 < n {
            let mut in_combo: bool = false
            let mut j: i32 = 0
            while j < p {
                if unique_groups[combo[j]] == groups[i2] {
                    in_combo = true
                }
                j = j + 1
            }
            if in_combo {
                test_idx[tei] = i2
                tei = tei + 1
            } else {
                train_idx[ti] = i2
                ti = ti + 1
            }
            i2 = i2 + 1
        }
        train_ptrs[split_idx] = train_idx
        test_ptrs[split_idx] = test_idx
        n_train_arr[split_idx] = n_train
        n_test_arr[split_idx] = n_test
        split_idx = split_idx + 1

        # Next combination
        let mut pos: i32 = p - 1
        while pos >= 0 {
            if combo[pos] < n_groups - p + pos {
                combo[pos] = combo[pos] + 1
                let mut pos2: i32 = pos + 1
                while pos2 < p {
                    combo[pos2] = combo[pos2 - 1] + 1
                    pos2 = pos2 + 1
                }
                break
            }
            pos = pos - 1
        }
        if pos < 0 {
            done = true
        }
    }

    free(combo as ptr<void>)
    free(unique_groups as ptr<void>)

    let result: GroupCVResult = GroupCVResult {
        train_ptrs: train_ptrs,
        test_ptrs: test_ptrs,
        n_train_arr: n_train_arr,
        n_test_arr: n_test_arr,
        n_splits: n_splits
    }
    return result
}

# ============================================================================
# GroupShuffleSplit
# Shuffle-Group(s)-Out cross-validation iterator.
# ============================================================================

export struct GroupShuffleSplit {
    n_splits: i32,
    test_size: f32,
    seed: i32
}

export function group_shuffle_split_init(n_splits: i32, test_size: f32, seed: i32) -> GroupShuffleSplit {
    let result: GroupShuffleSplit = GroupShuffleSplit {
        n_splits: n_splits, test_size: test_size, seed: seed
    }
    return result
}

export function group_shuffle_split_get_split(
    gss: GroupShuffleSplit, groups: ptr<i32>, n: i32, n_groups: i32, split: i32
) -> TrainTestSplit {
    # Issue #398: unique_groups held exactly n_groups entries and the loop
    # appended one entry per distinct group id with no check, so a caller
    # understating n_groups wrote past the allocation. The buffer now grows to
    # hold every distinct group id.
    let found_groups: DistinctI32 = distinct_i32(groups, n, n_groups)
    let unique_groups: ptr<i32> = found_groups.values
    let n_found: i32 = found_groups.count
    let mut i: i32 = 0

    let n_test_groups: i32 = ((n_found as f32) * gss.test_size) as i32
    if n_test_groups < 1 { n_test_groups = 1 }
    let n_train_groups: i32 = n_found - n_test_groups

    srand(gss.seed + split)

    let perm: ptr<i32> = malloc((n_found as i64) * 4) as ptr<i32>
    i = 0
    while i < n_found {
        perm[i] = i
        i = i + 1
    }
    i = n_found - 1
    while i > 0 {
        let j: i32 = rand() % (i + 1)
        let tmp: i32 = perm[i]
        perm[i] = perm[j]
        perm[j] = tmp
        i = i - 1
    }

    let is_test_group: ptr<i32> = malloc((n_found as i64) * 4) as ptr<i32>
    i = 0
    while i < n_found {
        is_test_group[i] = 0
        i = i + 1
    }
    i = 0
    while i < n_test_groups {
        is_test_group[perm[i]] = 1
        i = i + 1
    }

    let mut n_test: i32 = 0
    i = 0
    while i < n {
        let mut g_idx: i32 = 0
        let mut found: bool = false
        while g_idx < n_found && not found {
            if unique_groups[g_idx] == groups[i] { found = true }
            else { g_idx = g_idx + 1 }
        }
        if is_test_group[g_idx] == 1 { n_test = n_test + 1 }
        i = i + 1
    }

    let n_train: i32 = n - n_test

    let X_train: Matrix = matrix_new(n_train, 0)
    let X_test: Matrix = matrix_new(n_test, 0)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let y_test: ptr<f32> = array_new_f32(n_test)

    let mut train_pos: i32 = 0
    let mut test_pos: i32 = 0
    i = 0
    while i < n {
        let mut g_idx: i32 = 0
        let mut found: bool = false
        while g_idx < n_found && not found {
            if unique_groups[g_idx] == groups[i] { found = true }
            else { g_idx = g_idx + 1 }
        }
        if is_test_group[g_idx] == 1 {
            y_test[test_pos] = 0.0
            test_pos = test_pos + 1
        } else {
            y_train[train_pos] = 0.0
            train_pos = train_pos + 1
        }
        i = i + 1
    }

    free(unique_groups as ptr<void>)
    free(perm as ptr<void>)
    free(is_test_group as ptr<void>)

    let result: TrainTestSplit = TrainTestSplit {
        X_train: X_train, y_train: y_train, n_train: n_train,
        X_test: X_test, y_test: y_test, n_test: n_test
    }
    return result
}
