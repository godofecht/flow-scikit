# Semi-supervised learning for flow-scikit.
# Implements LabelPropagation, LabelSpreading, SelfTrainingClassifier.

import "lib/scikit/matrix.flow"
import "lib/scikit/blas.flow"
import "lib/scikit/linear.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function exp(x: f64) -> f64
    function sqrt(x: f64) -> f64
    function fabs(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

const UNLABELED: i32 = -1

# ============================================================================
# LabelPropagation
# ============================================================================

export struct LabelPropagation {
    labels: ptr<i32>,
    label_distributions: ptr<ptr<f32> >,
    n_classes: i32,
    n_samples: i32,
    n_features: i32,
    n_iter: i32,
    fitted: bool
}

function _build_affinity(X: Matrix, gamma: f32) -> ptr<ptr<f32> > {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let W: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        W[i] = array_new_f32(n)
    }
    # The RBF affinity matrix is symmetric, so only the strict upper triangle is
    # computed and the result is mirrored. The mirror is exact rather than
    # approximate: (a - b) * (a - b) and (b - a) * (b - a) are the same IEEE-754
    # value, so W[j][i] is bit-identical to what the full double loop produced.
    # The diagonal is exp(-gamma * 0) for every row, so it is evaluated once.
    # Row bases index X.data directly instead of calling matrix_at twice per
    # element, which is a real function call at FLOW_OPT_LEVEL=0.
    let self_affinity: f32 = exp((-gamma * 0.0) as f64) as f32
    for i in 0 to n {
        let row_i: ptr<f32> = W[i]
        let base_i: i32 = i * p
        row_i[i] = self_affinity
        for j in i + 1 to n {
            let base_j: i32 = j * p
            # A while loop with a constant step, because Flow emits a range
            # loop with a stride chosen at runtime and LLVM will not vectorize
            # that. Flow issue #1004.
            let mut s: f32 = 0.0
            let mut k: i32 = 0
            while k < p {
                let d: f32 = X.data[base_i + k] - X.data[base_j + k]
                s = s + d * d
                k = k + 1
            }
            let w: f32 = exp((-gamma * s) as f64) as f32
            row_i[j] = w
            W[j][i] = w
        }
    }
    return W
}

export function label_propagation_fit(X: Matrix, y: ptr<i32>, n_classes: i32, gamma: f32, max_iter: i32, tol: f32) -> LabelPropagation {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let W: ptr<ptr<f32> > = _build_affinity(X, gamma)

    let mut deg: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let row_deg: ptr<f32> = W[i]
        let mut d: f32 = 0.0
        for j in 0 to n {
            d = d + row_deg[j]
        }
        deg[i] = d
        # Zero-affinity rows get uniform transition probabilities.
        # Addresses sklearn #34351: zero-affinity fallback should be
        # a mathematically valid uniform distribution, not all-zeros.
        if deg[i] < 0.0000000001 {
            deg[i] = 1.0
            for j in 0 to n {
                row_deg[j] = 1.0 / (n as f32)
            }
        }
    }

    # W is never read again after this point, so the row-stochastic transition
    # matrix is written back over it instead of allocating a second n x n
    # buffer. The division is kept as a division, not turned into a multiply by
    # a reciprocal, so every entry is bit-identical to the old T.
    for i in 0 to n {
        let row_t: ptr<f32> = W[i]
        let dv: f32 = deg[i]
        for j in 0 to n {
            row_t[j] = row_t[j] / dv
        }
    }

    let Y: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    let clamp: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        Y[i] = array_new_f32(n_classes)
        clamp[i] = array_new_f32(n_classes)
        if y[i] >= 0 && y[i] < n_classes {
            clamp[i][y[i]] = 1.0
            Y[i][y[i]] = 1.0
        }
    }

    # The propagation scratch buffer is allocated once instead of n mallocs and
    # n frees on every iteration.
    let new_Y: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        new_Y[i] = array_new_f32(n_classes)
    }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1
        let mut max_change: f32 = 0.0

        # Loop order is unchanged: interchanging the class and neighbour loops
        # was measured and is a 1.7x loss at FLOW_OPT_LEVEL=0, because n_classes
        # is small and the extra loop setup costs more than the saved loads. The
        # transition row pointer and the output row pointer are hoisted out of
        # the class loop instead, which keeps the accumulation order and so the
        # result bit-identical.
        for i in 0 to n {
            let row_p: ptr<f32> = W[i]
            let acc: ptr<f32> = new_Y[i]
            for c in 0 to n_classes {
                let mut s: f32 = 0.0
                for j in 0 to n {
                    s = s + row_p[j] * Y[j][c]
                }
                acc[c] = s
            }
        }

        for i in 0 to n {
            if y[i] >= 0 {
                for c in 0 to n_classes {
                    new_Y[i][c] = clamp[i][c]
                }
            }
            for c in 0 to n_classes {
                let change: f32 = fabs((new_Y[i][c] - Y[i][c]) as f64) as f32
                if change > max_change { max_change = change }
                Y[i][c] = new_Y[i][c]
            }
        }

        if max_change < tol { break }
    }

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_val: f32 = -9999999999.0
        for c in 0 to n_classes {
            if Y[i][c] > best_val {
                best_val = Y[i][c]
                best_c = c
            }
        }
        labels[i] = best_c
    }

    for i in 0 to n {
        array_free_f32(W[i])
        array_free_f32(new_Y[i])
        array_free_f32(clamp[i])
    }
    free(W as ptr<void>)
    free(new_Y as ptr<void>)
    free(clamp as ptr<void>)
    array_free_f32(deg)

    return LabelPropagation {
        labels: labels,
        label_distributions: Y,
        n_classes: n_classes,
        n_samples: n,
        n_features: p,
        n_iter: n_iter,
        fitted: true
    }
}

export function label_propagation_predict(model: LabelPropagation) -> ptr<i32> {
    let result: ptr<i32> = malloc((model.n_samples as i64) * 4) as ptr<i32>
    for i in 0 to model.n_samples {
        result[i] = model.labels[i]
    }
    return result
}

export function label_propagation_predict_proba(model: LabelPropagation) -> ptr<ptr<f32> > {
    let result: ptr<ptr<f32> > = malloc((model.n_samples as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to model.n_samples {
        result[i] = array_new_f32(model.n_classes)
        let mut s: f32 = 0.0
        for c in 0 to model.n_classes {
            s = s + model.label_distributions[i][c]
        }
        if s < 0.0000000001 { s = 1.0 }
        for c in 0 to model.n_classes {
            result[i][c] = model.label_distributions[i][c] / s
        }
    }
    return result
}

export function label_propagation_free(model: LabelPropagation) -> void {
    for i in 0 to model.n_samples {
        array_free_f32(model.label_distributions[i])
    }
    free(model.label_distributions as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# LabelSpreading
# ============================================================================

export struct LabelSpreading {
    labels: ptr<i32>,
    label_distributions: ptr<ptr<f32> >,
    n_classes: i32,
    n_samples: i32,
    n_features: i32,
    n_iter: i32,
    alpha: f32,
    fitted: bool
}

export function label_spreading_fit(X: Matrix, y: ptr<i32>, n_classes: i32, gamma: f32, alpha: f32, max_iter: i32, tol: f32) -> LabelSpreading {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let W: ptr<ptr<f32> > = _build_affinity(X, gamma)

    let mut deg: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        for j in 0 to n {
            deg[i] = deg[i] + W[i][j]
        }
        # Zero-affinity rows get uniform transition probabilities.
        # Addresses sklearn #34351.
        if deg[i] < 0.0000000001 {
            deg[i] = 1.0
            for j in 0 to n {
                W[i][j] = 1.0 / (n as f32)
            }
        }
    }

    # The propagation is new_Y = S * Y, a matrix product, so it is one sgemm
    # against contiguous storage. It used to be a scalar triple loop that
    # walked Y down a column of an array of row allocations, which is a cache
    # miss per element, and it allocated a fresh n by n_classes set of rows on
    # every iteration.
    let Sc: ptr<f32> = array_new_f32(n * n)
    for i in 0 to n {
        let srow: ptr<f32> = Sc + i * n
        let wrow: ptr<f32> = W[i]
        let scale: f32 = alpha / deg[i]
        let mut j: i32 = 0
        while j < n {
            srow[j] = scale * wrow[j]
            j = j + 1
        }
    }

    let nc: i32 = n_classes
    let Yc: ptr<f32> = array_new_f32(n * nc)
    let Ync: ptr<f32> = array_new_f32(n * nc)
    let clampc: ptr<f32> = array_new_f32(n * nc)
    for i in 0 to n {
        if y[i] >= 0 && y[i] < nc {
            clampc[i * nc + y[i]] = 1.0
            Yc[i * nc + y[i]] = 1.0
        }
    }

    let hold: f32 = 1.0 - alpha
    let total: i32 = n * nc
    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1
        let mut max_change: f32 = 0.0

        blas_matmat(Sc, Yc, Ync, n, nc, n, 1.0, 0.0)

        let mut idx: i32 = 0
        while idx < total {
            let v: f32 = Ync[idx] + hold * clampc[idx]
            let change: f32 = fabs((v - Yc[idx]) as f64) as f32
            if change > max_change { max_change = change }
            Yc[idx] = v
            idx = idx + 1
        }

        if max_change < tol { break }
    }

    # The model hands back its distributions a row at a time, so the rows are
    # built once here.
    let Y: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        let row: ptr<f32> = array_new_f32(nc)
        let src: ptr<f32> = Yc + i * nc
        for c in 0 to nc { row[c] = src[c] }
        Y[i] = row
    }
    array_free_f32(Sc)
    array_free_f32(Yc)
    array_free_f32(Ync)
    array_free_f32(clampc)

    let labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_val: f32 = -9999999999.0
        for c in 0 to n_classes {
            if Y[i][c] > best_val {
                best_val = Y[i][c]
                best_c = c
            }
        }
        labels[i] = best_c
    }

    for i in 0 to n {
        array_free_f32(W[i])
    }
    free(W as ptr<void>)
    array_free_f32(deg)

    return LabelSpreading {
        labels: labels,
        label_distributions: Y,
        n_classes: n_classes,
        n_samples: n,
        n_features: p,
        n_iter: n_iter,
        alpha: alpha,
        fitted: true
    }
}

export function label_spreading_predict(model: LabelSpreading) -> ptr<i32> {
    let result: ptr<i32> = malloc((model.n_samples as i64) * 4) as ptr<i32>
    for i in 0 to model.n_samples {
        result[i] = model.labels[i]
    }
    return result
}

export function label_spreading_free(model: LabelSpreading) -> void {
    for i in 0 to model.n_samples {
        array_free_f32(model.label_distributions[i])
    }
    free(model.label_distributions as ptr<void>)
    free(model.labels as ptr<void>)
}

# ============================================================================
# SelfTrainingClassifier
# ============================================================================

export struct SelfTrainingClassifier {
    labels: ptr<i32>,
    confidence: ptr<f32>,
    n_iter: i32,
    n_labeled: i32,
    n_samples: i32,
    threshold: f32,
    fitted: bool
}

# Self training with the base estimator refitted every round, which is what
# scikit-learn's SelfTrainingClassifier does.
#
# The function below takes class probabilities as input, so its cost is the
# labelling loop alone while the class it is named after also fits its base
# estimator on every round. That is the expensive half, and leaving it out
# compares a part against the whole.
#
# Unlabelled rows carry a negative label, as they do in scikit-learn.
export function self_training_classifier_full_fit(X: Matrix, y_initial: ptr<i32>, n_classes: i32, threshold: f32, max_iter: i32, base_iter: i32, lr: f32) -> SelfTrainingClassifier {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let xdata: ptr<f32> = X.data

    let labels: ptr<i32> = malloc((n as i64) * 4 + 64) as ptr<i32>
    let confidence: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        labels[i] = y_initial[i]
        confidence[i] = 0.0
    }

    let scores: ptr<f32> = array_new_f32(n * n_classes)
    let y_lab: ptr<f32> = array_new_f32(n)
    let mut n_iter: i32 = 0

    for iter in 0 to max_iter {
        n_iter = iter + 1

        let mut n_lab: i32 = 0
        for i2 in 0 to n {
            if labels[i2] >= 0 { n_lab = n_lab + 1 }
        }
        if n_lab < 2 { break }

        # The labelled rows, gathered for this round's fit.
        let X_lab: Matrix = matrix_new(n_lab, p)
        let dst: ptr<f32> = X_lab.data
        let mut at: i32 = 0
        for i3 in 0 to n {
            if labels[i3] >= 0 {
                let src: ptr<f32> = xdata + i3 * p
                let drow: ptr<f32> = dst + at * p
                let mut j: i32 = 0
                while j < p {
                    drow[j] = src[j]
                    j = j + 1
                }
                y_lab[at] = labels[i3] as f32
                at = at + 1
            }
        }

        let base: LogisticRegression = logistic_regression_fit(X_lab, y_lab, n_classes, base_iter, lr, penalty_none())

        # Per-class scores for every row, then a softmax, which is the
        # confidence the threshold is compared against.
        let nc: i32 = base.n_classes
        blas_matmat_nt(xdata, base.weights, scores, n, nc, p, p, p, 1.0, 0.0)
        let mut newly: i32 = 0
        for i4 in 0 to n {
            if labels[i4] < 0 {
                let srow: ptr<f32> = scores + i4 * nc
                let mut best: i32 = 0
                let mut best_s: f32 = srow[0] + base.biases[0]
                let mut c: i32 = 1
                while c < nc {
                    let s: f32 = srow[c] + base.biases[c]
                    if s > best_s {
                        best_s = s
                        best = c
                    }
                    c = c + 1
                }
                let mut total: f32 = 0.0
                let mut c2: i32 = 0
                while c2 < nc {
                    total = total + (exp((srow[c2] + base.biases[c2] - best_s) as f64) as f32)
                    c2 = c2 + 1
                }
                let prob: f32 = 1.0 / total
                if prob >= threshold {
                    labels[i4] = best
                    confidence[i4] = prob
                    newly = newly + 1
                }
            }
        }

        logistic_regression_free(base)
        matrix_free(X_lab)
        if newly == 0 { break }
    }

    let mut n_labeled: i32 = 0
    for i5 in 0 to n {
        if labels[i5] >= 0 { n_labeled = n_labeled + 1 }
    }

    array_free_f32(scores)
    array_free_f32(y_lab)

    return SelfTrainingClassifier {
        labels: labels,
        confidence: confidence,
        n_iter: n_iter,
        n_labeled: n_labeled,
        n_samples: n,
        threshold: threshold,
        fitted: true
    }
}

export function self_training_classifier_fit(
    y_initial: ptr<i32>,
    probabilities: ptr<ptr<f32> >,
    n_samples: i32,
    n_classes: i32,
    threshold: f32,
    max_iter: i32
) -> SelfTrainingClassifier {
    let labels: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
    let confidence: ptr<f32> = array_new_f32(n_samples)

    for i in 0 to n_samples {
        labels[i] = y_initial[i]
        confidence[i] = 0.0
    }

    let mut n_iter: i32 = 0
    let mut n_labeled: i32 = 0

    for i in 0 to n_samples {
        if labels[i] >= 0 { n_labeled = n_labeled + 1 }
    }

    for iter in 0 to max_iter {
        n_iter = iter + 1
        let mut newly_labeled: i32 = 0

        for i in 0 to n_samples {
            if labels[i] >= 0 { continue }

            let mut best_c: i32 = 0
            let mut best_p: f32 = -1.0
            for c in 0 to n_classes {
                if probabilities[i][c] > best_p {
                    best_p = probabilities[i][c]
                    best_c = c
                }
            }

            if best_p >= threshold {
                labels[i] = best_c
                confidence[i] = best_p
                newly_labeled = newly_labeled + 1
                n_labeled = n_labeled + 1
            }
        }

        if newly_labeled == 0 { break }
    }

    return SelfTrainingClassifier {
        labels: labels,
        confidence: confidence,
        n_iter: n_iter,
        n_labeled: n_labeled,
        n_samples: n_samples,
        threshold: threshold,
        fitted: true
    }
}

export function self_training_classifier_predict(model: SelfTrainingClassifier) -> ptr<i32> {
    let result: ptr<i32> = malloc((model.n_samples as i64) * 4) as ptr<i32>
    for i in 0 to model.n_samples {
        result[i] = model.labels[i]
    }
    return result
}

export function self_training_classifier_free(model: SelfTrainingClassifier) -> void {
    free(model.labels as ptr<void>)
    array_free_f32(model.confidence)
}
