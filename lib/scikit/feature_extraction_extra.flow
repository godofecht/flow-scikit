# Additional feature extraction for flow-scikit.
# Implements DictVectorizer, FeatureHasher, HashingVectorizer, PatchExtractor.

import "lib/scikit/matrix.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function printf(fmt: string, ...) -> i32
}

# ============================================================================
# DictVectorizer: converts feature dicts to a matrix.
# Each dict maps feature name (as string) to value.
# Since Flow has no dict type, we use parallel arrays of keys and values.
# ============================================================================

export struct DictVectorizer {
    feature_names: ptr<ptr<i32> >,
    n_features: i32,
    fitted: bool
}

# Locates `key` in the ascending array `sorted_keys` of length `n`.
# Returns the index when the key is present, otherwise -(insertion_point) - 1.
# Small vocabularies use a linear scan with an early exit, which beats the branch
# overhead of a binary search; larger ones binary search.
# Module-unique name per compiler bug #465.
function _fe_extra_dv_find(sorted_keys: ptr<i32>, n: i32, key: i32) -> i32 {
    if n <= 12 {
        let mut out: i32 = 0 - n - 1
        let mut i: i32 = 0
        let mut done: bool = false
        while i < n && not done {
            let v: i32 = sorted_keys[i]
            if v == key {
                out = i
                done = true
            } else {
                if v > key {
                    out = 0 - i - 1
                    done = true
                }
            }
            i = i + 1
        }
        return out
    }

    let mut lo: i32 = 0
    let mut hi: i32 = n - 1
    let mut found: i32 = 0 - 1
    while lo <= hi && found < 0 {
        let mid: i32 = (lo + hi) / 2
        let v: i32 = sorted_keys[mid]
        if v == key {
            found = mid
        } else {
            if v < key {
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
    }
    if found >= 0 {
        return found
    }
    return 0 - lo - 1
}

export function dict_vectorizer_fit(X_keys: ptr<ptr<i32> >, X_vals: ptr<ptr<f32> >, n_samples: i32, n_keys_per_sample: ptr<i32>) -> DictVectorizer {
    # Collect all unique feature keys (represented as integer hashes)
    let max_features: i32 = 0
    for i in 0 to n_samples {
        max_features = max_features + n_keys_per_sample[i]
    }

    let all_keys: ptr<i32> = array_new_f32(max_features) as ptr<i32>
    # Mirror of all_keys held in ascending order so membership is a search over
    # sorted data instead of a full scan of every key seen so far.
    let probe_keys: ptr<i32> = array_new_f32(max_features) as ptr<i32>
    let mut n_unique: i32 = 0

    for i in 0 to n_samples {
        for k in 0 to n_keys_per_sample[i] {
            let key: i32 = X_keys[i][k]
            let pos: i32 = _fe_extra_dv_find(probe_keys, n_unique, key)
            if pos < 0 {
                let ins: i32 = 0 - pos - 1
                let mut m: i32 = n_unique
                while m > ins {
                    probe_keys[m] = probe_keys[m - 1]
                    m = m - 1
                }
                probe_keys[ins] = key
                # all_keys stays in first-seen order, so the emitted feature
                # columns are identical to the previous implementation's.
                all_keys[n_unique] = key
                n_unique = n_unique + 1
            }
        }
    }

    array_free_f32(probe_keys as ptr<f32>)

    let feature_names: ptr<ptr<i32> > = malloc((n_unique as i64) * 8) as ptr<ptr<i32> >
    for i in 0 to n_unique {
        feature_names[i] = array_new_f32(1) as ptr<i32>
        feature_names[i][0] = all_keys[i]
    }

    array_free_f32(all_keys as ptr<f32>)

    return DictVectorizer {
        feature_names: feature_names,
        n_features: n_unique,
        fitted: true
    }
}

# Sifts one element down a max-heap keyed on `keys`, carrying `cols` along.
# Module-unique name per compiler bug #465.
function _fe_extra_dv_sift(keys: ptr<i32>, cols: ptr<i32>, start: i32, n: i32) -> void {
    let mut root: i32 = start
    let mut running: bool = true
    while running {
        let child: i32 = 2 * root + 1
        if child >= n {
            running = false
        } else {
            let mut target: i32 = root
            if keys[target] < keys[child] { target = child }
            if child + 1 < n {
                if keys[target] < keys[child + 1] { target = child + 1 }
            }
            if target == root {
                running = false
            } else {
                let tk: i32 = keys[root]
                keys[root] = keys[target]
                keys[target] = tk
                let tc: i32 = cols[root]
                cols[root] = cols[target]
                cols[target] = tc
                root = target
            }
        }
    }
}

# Sorts the (key, column) pairs ascending by key in O(V log V) with no
# allocation. Heapsort rather than insertion sort so a wide vocabulary does not
# reintroduce a quadratic term.
function _fe_extra_dv_sort_pairs(keys: ptr<i32>, cols: ptr<i32>, n: i32) -> void {
    let mut start: i32 = n / 2 - 1
    while start >= 0 {
        _fe_extra_dv_sift(keys, cols, start, n)
        start = start - 1
    }
    let mut end: i32 = n - 1
    while end > 0 {
        let tk: i32 = keys[0]
        keys[0] = keys[end]
        keys[end] = tk
        let tc: i32 = cols[0]
        cols[0] = cols[end]
        cols[end] = tc
        _fe_extra_dv_sift(keys, cols, 0, end)
        end = end - 1
    }
}

export function dict_vectorizer_transform(model: DictVectorizer, X_keys: ptr<ptr<i32> >, X_vals: ptr<ptr<f32> >, n_samples: i32, n_keys_per_sample: ptr<i32>) -> Matrix {
    # matrix_new is calloc-backed, so the output starts zeroed. The previous
    # O(n_samples * n_features) clearing pass wrote zeros over zeros.
    let result: Matrix = matrix_new(n_samples, model.n_features)
    let n_feat: i32 = model.n_features
    if n_feat <= 0 {
        return result
    }

    let mut total_keys: i32 = 0
    for i in 0 to n_samples {
        total_keys = total_keys + n_keys_per_sample[i]
    }

    # Work threshold. Scanning costs n_feat per lookup. Indexing costs one
    # heapsort of the vocabulary plus about log2(n_feat) per lookup. 24 is a
    # conservative stand-in for that log factor plus the per-lookup overhead,
    # so the crossover sits above the point where indexing actually pays. Below
    # it the original scan runs and its output is bit-identical to the previous
    # code, which is a parity bonus.
    let scan_ops: i64 = (total_keys as i64) * (n_feat as i64)
    let index_ops: i64 = ((total_keys as i64) + (n_feat as i64)) * 24

    # Build the key -> column index once per call instead of rescanning the
    # whole vocabulary for every key of every sample.
    let mut use_index: bool = scan_ops > index_ops
    let idx_keys: ptr<i32> = array_new_f32(n_feat) as ptr<i32>
    let idx_cols: ptr<i32> = array_new_f32(n_feat) as ptr<i32>

    if use_index {
        for j in 0 to n_feat {
            idx_keys[j] = model.feature_names[j][0]
            idx_cols[j] = j
        }
        _fe_extra_dv_sort_pairs(idx_keys, idx_cols, n_feat)

        # A vocabulary built by dict_vectorizer_fit is duplicate free, but the
        # struct is exported and can be assembled by hand. The old loop wrote
        # the value into every matching column; a single-column index cannot
        # reproduce that, so fall back to the scan when duplicates are present.
        for j in 1 to n_feat {
            if idx_keys[j] == idx_keys[j - 1] { use_index = false }
        }
    }

    if not use_index {
        array_free_f32(idx_keys as ptr<f32>)
        array_free_f32(idx_cols as ptr<f32>)
        for i in 0 to n_samples {
            for k in 0 to n_keys_per_sample[i] {
                let key: i32 = X_keys[i][k]
                for j in 0 to n_feat {
                    if model.feature_names[j][0] == key {
                        matrix_set(result, i, j, X_vals[i][k])
                    }
                }
            }
        }
        return result
    }

    for i in 0 to n_samples {
        let row_base: i32 = i * n_feat
        for k in 0 to n_keys_per_sample[i] {
            let pos: i32 = _fe_extra_dv_find(idx_keys, n_feat, X_keys[i][k])
            if pos >= 0 {
                result.data[row_base + idx_cols[pos]] = X_vals[i][k]
            }
        }
    }

    array_free_f32(idx_keys as ptr<f32>)
    array_free_f32(idx_cols as ptr<f32>)
    return result
}

export function dict_vectorizer_free(model: DictVectorizer) -> void {
    for i in 0 to model.n_features {
        array_free_f32(model.feature_names[i] as ptr<f32>)
    }
    free(model.feature_names as ptr<void>)
}

# ============================================================================
# FeatureHasher: hashes feature names to columns using a hash function.
# Implements the "hashing trick" for dimensionality reduction.
# ============================================================================

export struct FeatureHasher {
    n_features: i32,
    fitted: bool
}

export function feature_hasher_new(n_features: i32) -> FeatureHasher {
    return FeatureHasher {
        n_features: n_features,
        fitted: true
    }
}

export function feature_hasher_transform(model: FeatureHasher, keys: ptr<ptr<i32> >, vals: ptr<ptr<f32> >, n_samples: i32, n_keys_per_sample: ptr<i32>) -> Matrix {
    let result: Matrix = matrix_new(n_samples, model.n_features)
    for i in 0 to n_samples {
        for j in 0 to model.n_features {
            matrix_set(result, i, j, 0.0)
        }
        for k in 0 to n_keys_per_sample[i] {
            let key: i32 = keys[i][k]
            let col: i32 = (key % model.n_features + model.n_features) % model.n_features
            let current: f32 = matrix_at(result, i, col)
            matrix_set(result, i, col, current + vals[i][k])
        }
    }
    return result
}

export function feature_hasher_free(model: FeatureHasher) -> void {
}

# ============================================================================
# HashingVectorizer: hashes text tokens to a fixed-dimensional matrix.
# Uses a simple hash of token characters.
# ============================================================================

export struct HashingVectorizer {
    n_features: i32,
    fitted: bool
}

export function hashing_vectorizer_new(n_features: i32) -> HashingVectorizer {
    return HashingVectorizer {
        n_features: n_features,
        fitted: true
    }
}

export function hashing_vectorizer_transform(model: HashingVectorizer, tokens: ptr<ptr<i32> >, n_samples: i32, n_tokens_per_sample: ptr<i32>) -> Matrix {
    # matrix_new is calloc-backed, so the output is already zeroed.  Avoid the
    # previous O(n_samples * n_features) clearing pass and make runtime scale
    # with the number of observed tokens instead of the hash-space width.
    let result: Matrix = matrix_new(n_samples, model.n_features)
    for i in 0 to n_samples {
        let row_base: i32 = i * model.n_features
        for k in 0 to n_tokens_per_sample[i] {
            let token: i32 = tokens[i][k]
            let col: i32 = (token % model.n_features + model.n_features) % model.n_features
            let idx: i32 = row_base + col
            result.data[idx] = result.data[idx] + 1.0
        }
    }
    return result
}

export function hashing_vectorizer_free(model: HashingVectorizer) -> void {
}

# ============================================================================
# PatchExtractor: extracts patches from images (matrices).
# Used for feature extraction from image data.
# ============================================================================

export struct PatchExtractor {
    patch_size: i32,
    max_patches: i32,
    fitted: bool
}

export function patch_extractor_new(patch_size: i32, max_patches: i32) -> PatchExtractor {
    return PatchExtractor {
        patch_size: patch_size,
        max_patches: max_patches,
        fitted: true
    }
}

export function patch_extractor_transform(model: PatchExtractor, images: ptr<Matrix>, n_images: i32) -> Matrix {
    let ps: i32 = model.patch_size
    let total_patches: i32 = 0
    for img_idx in 0 to n_images {
        let img: Matrix = images[img_idx]
        let n_rows: i32 = img.rows - ps + 1
        let n_cols: i32 = img.cols - ps + 1
        if n_rows < 0 { n_rows = 0 }
        if n_cols < 0 { n_cols = 0 }
        let patches_per_image: i32 = n_rows * n_cols
        if patches_per_image > model.max_patches {
            patches_per_image = model.max_patches
        }
        total_patches = total_patches + patches_per_image
    }

    let result: Matrix = matrix_new(total_patches, ps * ps)
    let mut row_idx: i32 = 0
    for img_idx in 0 to n_images {
        let img: Matrix = images[img_idx]
        let n_rows: i32 = img.rows - ps + 1
        let n_cols: i32 = img.cols - ps + 1
        if n_rows < 0 { n_rows = 0 }
        if n_cols < 0 { n_cols = 0 }
        let mut count: i32 = 0
        for r in 0 to n_rows {
            for c in 0 to n_cols {
                if count >= model.max_patches { break }
                let mut col_idx: i32 = 0
                for pr in 0 to ps {
                    for pc in 0 to ps {
                        matrix_set(result, row_idx, col_idx, matrix_at(img, r + pr, c + pc))
                        col_idx = col_idx + 1
                    }
                }
                row_idx = row_idx + 1
                count = count + 1
            }
            if count >= model.max_patches { break }
        }
    }
    return result
}

export function patch_extractor_free(model: PatchExtractor) -> void {
}
