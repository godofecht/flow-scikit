# Grid search demo for flow-scikit.
# Demonstrates:
#   - GridSearchCV with Progress effect system (Issues #30852, #32946)
#   - ConsoleProgress capability for progress reporting
#   - VerboseProgress capability for detailed logging
#   - SilentProgress capability for no output
#
# Run: ./flow run examples/grid_search_demo.flow

import "lib/scikit/scikit.flow"

function make_classification_data() -> Dataset {
    let n: i32 = 60
    let n_features: i32 = 2
    let X: Matrix = matrix_new(n, n_features)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to 30 {
        let x0: f32 = _demo_gauss(i * 7 + 1) * 0.5 + 1.0
        let x1: f32 = _demo_gauss(i * 13 + 3) * 0.5 + 1.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        y[i] = 0.0
    }

    for i in 0 to 30 {
        let x0: f32 = _demo_gauss(i * 11 + 5) * 0.5 - 1.0
        let x1: f32 = _demo_gauss(i * 17 + 7) * 0.5 - 1.0
        matrix_set(X, 30 + i, 0, x0)
        matrix_set(X, 30 + i, 1, x1)
        y[30 + i] = 1.0
    }

    return Dataset {
        X: X,
        y: y,
        n_samples: n,
        n_features: n_features,
        n_classes: 2,
        is_classification: true
    }
}

function _demo_gauss(seed: i32) -> f32 {
    let s: i32 = seed * 1103515245 + 12345
    let n: i32 = (s % 10000 + 10000) % 10000
    return ((n as f32) / 5000.0 - 1.0)
}

function main() -> i32 {
    println("flow-scikit: Grid Search Demo")
    println("=============================")
    println("")

    let data: Dataset = make_classification_data()
    print("Dataset: ")
    print(data.n_samples)
    print(" samples, ")
    print(data.n_features)
    println(" features, 2 classes")
    println("")

    let scaler: StandardScaler = standard_scaler_fit(data.X)
    let X_scaled: Matrix = standard_scaler_transform(scaler, data.X)

    let C_values: ptr<f32> = array_new_f32(3)
    C_values[0] = 0.001
    C_values[1] = 0.01
    C_values[2] = 0.1

    let lr_values: ptr<f32> = array_new_f32(2)
    lr_values[0] = 0.05
    lr_values[1] = 0.1

    let grid: ParamGrid = ParamGrid {
        C_values: C_values,
        n_C: 3,
        lr_values: lr_values,
        n_lr: 2
    }

    println("Running GridSearchCV with ConsoleProgress (progress bar)...")
    println("-----------------------------------------------------------")
    handle Progress with ConsoleProgress {
        let result: GridSearchResult = grid_search_logistic(X_scaled, data.y, 2, grid, 3, 300)
        print_grid_search_result(result)
        grid_search_result_free(result)
    }

    println("")
    println("Running GridSearchCV with VerboseProgress (detailed logging)...")
    println("----------------------------------------------------------------")
    handle Progress with VerboseProgress {
        let result: GridSearchResult = grid_search_logistic(X_scaled, data.y, 2, grid, 3, 300)
        print_grid_search_result(result)
        grid_search_result_free(result)
    }

    println("")
    println("Running GridSearchCV with SilentProgress (no output)...")
    println("--------------------------------------------------------")
    handle Progress with SilentProgress {
        let result: GridSearchResult = grid_search_logistic(X_scaled, data.y, 2, grid, 3, 300)
        print_grid_search_result(result)
        grid_search_result_free(result)
    }

    println("")
    println("The Progress effect system replaces the confusing verbose=0/1/2/3+")
    println("integer parameter. Each capability provides clear, documented behavior:")
    println("  - SilentProgress:  no output (replaces verbose=0)")
    println("  - ConsoleProgress: progress bar + score (replaces verbose=1-2)")
    println("  - VerboseProgress:  per-candidate + per-epoch detail (replaces verbose>10)")
    println("  - Custom:          write your own capability for any output format")

    array_free_f32(C_values)
    array_free_f32(lr_values)
    standard_scaler_free(scaler)
    matrix_free(X_scaled)
    matrix_free(data.X)
    array_free_f32(data.y)

    return 0
}
