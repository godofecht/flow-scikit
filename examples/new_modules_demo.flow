# Demo showcasing new modules: isotonic, kernel ridge, PLS, t-SNE, NMF.
# Run: ./flow run examples/new_modules_demo.flow

import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: i32) -> void
}

function main() -> i32 {
    println("=== flow-scikit New Modules Demo ===")
    println("")

    srand(42)

    let n: i32 = 60
    let X: Matrix = matrix_new(n, 3)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        let x2: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        matrix_set(X, i, 2, x2)
        y[i] = 2.0 * x0 + 3.0 * x1 - x2 + 1.0
    }

    println("--- IsotonicRegression ---")
    let x_col: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        x_col[i] = matrix_at(X, i, 0)
    }
    let iso: IsotonicRegression = isotonic_fit(x_col, y, n, true)
    let iso_preds: ptr<f32> = isotonic_predict(iso, x_col, n)
    print("  First 5 predictions: ")
    for i in 0 to 5 {
        printf("%.2f", iso_preds[i])
        print(" ")
    }
    println("")
    isotonic_free(iso)
    array_free_f32(iso_preds)
    array_free_f32(x_col)
    println("")

    println("--- KernelRidge (RBF) ---")
    let kr: KernelRidge = kernel_ridge_fit(X, y, 1.0, KERNEL_TYPE_RBF, 0.1, 3, 0.0)
    let kr_preds: ptr<f32> = kernel_ridge_predict(kr, X)
    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    let y_mean: f32 = array_mean(y, n)
    for i in 0 to n {
        let d: f32 = y[i] - kr_preds[i]
        ss_res = ss_res + d * d
        let d2: f32 = y[i] - y_mean
        ss_tot = ss_tot + d2 * d2
    }
    let kr_r2: f32 = 1.0 - ss_res / ss_tot
    print("  R2 = ")
    printf("%.4f", kr_r2)
    println("")
    kernel_ridge_free(kr)
    array_free_f32(kr_preds)
    println("")

    println("--- KernelRidge (linear) ---")
    let krl: KernelRidge = kernel_ridge_fit(X, y, 0.1, KERNEL_TYPE_LINEAR, 1.0, 1, 0.0)
    let krl_preds: ptr<f32> = kernel_ridge_predict(krl, X)
    let mut ss_res2: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y[i] - krl_preds[i]
        ss_res2 = ss_res2 + d * d
    }
    let krl_r2: f32 = 1.0 - ss_res2 / ss_tot
    print("  R2 = ")
    printf("%.4f", krl_r2)
    println("")
    kernel_ridge_free(krl)
    array_free_f32(krl_preds)
    println("")

    println("--- PLSRegression ---")
    let Y: Matrix = matrix_new(n, 2)
    for i in 0 to n {
        matrix_set(Y, i, 0, y[i])
        matrix_set(Y, i, 1, y[i] * 0.5 + 2.0)
    }
    let pls: PLSRegression = pls_fit(X, Y, 2, 500, 1e-6)
    let pls_preds: Matrix = pls_predict(pls, X)
    let pls_trans: Matrix = pls_transform(pls, X)
    print("  First 3 transformed samples: ")
    for i in 0 to 3 {
        print("[")
        printf("%.2f", matrix_at(pls_trans, i, 0))
        print(", ")
        printf("%.2f", matrix_at(pls_trans, i, 1))
        print("] ")
    }
    println("")
    pls_free(pls)
    matrix_free(pls_preds)
    matrix_free(pls_trans)
    matrix_free(Y)
    println("")

    println("--- NMF ---")
    let X_nonneg: Matrix = matrix_new(n, 3)
    for i in 0 to n {
        for j in 0 to 3 {
            let val: f32 = matrix_at(X, i, j)
            if val < 0.0 {
                matrix_set(X_nonneg, i, j, 0.0)
            } else {
                matrix_set(X_nonneg, i, j, val)
            }
        }
    }
    let nmf_model: NMF = nmf_fit(X_nonneg, 2, 200, 1e-4, 42)
    print("  Reconstruction error = ")
    printf("%.4f", nmf_model.reconstruction_err)
    println("")
    nmf_free(nmf_model)
    matrix_free(X_nonneg)
    println("")

    println("--- TSNE ---")
    let embedding: Matrix = tsne_fit_transform(X, 2, 10.0, 200.0, 100, 42)
    print("  Embedding shape: ")
    print(embedding.rows)
    print("x")
    print(embedding.cols)
    println("")
    print("  First 3 points: ")
    for i in 0 to 3 {
        print("[")
        printf("%.2f", matrix_at(embedding, i, 0))
        print(", ")
        printf("%.2f", matrix_at(embedding, i, 1))
        print("] ")
    }
    println("")
    matrix_free(embedding)
    println("")

    println("--- Metrics ---")
    let preds_simple: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        preds_simple[i] = y[i] + 0.1
    }
    let mae: f32 = mean_absolute_error(y, preds_simple, n)
    let medae: f32 = median_absolute_error(y, preds_simple, n)
    let maxe: f32 = max_error(y, preds_simple, n)
    let msle: f32 = mean_squared_log_error(y, preds_simple, n)
    print("  MAE = ")
    printf("%.4f", mae)
    print("  MedAE = ")
    printf("%.4f", medae)
    print("  MaxError = ")
    printf("%.4f", maxe)
    print("  MSLE = ")
    printf("%.6f", msle)
    println("")
    array_free_f32(preds_simple)
    println("")

    println("=== Done ===")
    matrix_free(X)
    array_free_f32(y)
    return 0
}
