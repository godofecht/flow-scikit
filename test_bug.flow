export struct CVSplit {
    train_indices: ptr<i32>,
    n_train: i32,
    test_indices: ptr<i32>,
    n_test: i32
}

export struct GroupCVResult {
    splits: ptr<CVSplit>,
    n_splits: i32
}

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function printf(fmt: ptr<i8>, ...) -> void
}

function test_bug() -> GroupCVResult {
    let n_splits: i32 = 2
    let splits: ptr<CVSplit> = malloc((n_splits as i64) * 32) as ptr<CVSplit>

    let t0: ptr<i32> = malloc(4 as i64) as ptr<i32>
    t0[0] = 100
    splits[0] = CVSplit { train_indices: t0, n_train: 1, test_indices: t0, n_test: 1 }

    let t1: ptr<i32> = malloc(4 as i64) as ptr<i32>
    t1[0] = 200
    splits[1] = CVSplit { train_indices: t1, n_train: 1, test_indices: t1, n_test: 1 }

    return GroupCVResult { splits: splits, n_splits: n_splits }
}

function main() -> i32 {
    let res: GroupCVResult = test_bug()
    if res.splits[0].train_indices[0] != 100 {
        return 1
    }
    if res.splits[1].train_indices[0] != 200 {
        return 1
    }
    return 0
}
