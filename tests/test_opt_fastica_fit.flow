# Regression test for the optimized FastICA.fit (issue #270).
# Re-implements the pre-optimization fit verbatim, including the covariance
# matrix that was computed and thrown away, and requires the optimized fit to
# produce bit-identical components, mixing, mean and n_iter.

import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

function opt_ica_fit_close(a: f32, b: f32, tolerance: f32) -> bool {
    let mut d: f32 = a - b
    if d < 0.0 { d = -d }
    return d <= tolerance
}

# Module-unique copy of the private _gram_schmidt helper (compiler bug #465).
function opt_ica_fit_gs(row: ptr<f32>, basis: ptr<ptr<f32> >, n_basis: i32, n_features: i32) -> void {
    for b in 0 to n_basis {
        let mut dot: f32 = 0.0
        for j in 0 to n_features {
            dot = dot + row[j] * basis[b][j]
        }
        for j in 0 to n_features {
            row[j] = row[j] - dot * basis[b][j]
        }
    }
    let mut norm: f32 = 0.0
    for j in 0 to n_features {
        norm = norm + row[j] * row[j]
    }
    norm = sqrt((norm as f64)) as f32
    if norm > 0.0000000001 {
        for j in 0 to n_features {
            row[j] = row[j] / norm
        }
    }
}

# The pre-optimization implementation, kept here as the parity reference.
function opt_ica_fit_reference(X: Matrix, n_components: i32, max_iter: i32, tol: f32, seed: i32) -> FastICA {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let mean: ptr<f32> = array_new_f32(p)
    for j in 0 to p {
        let mut m: f32 = 0.0
        for i in 0 to n {
            m = m + matrix_at(X, i, j)
        }
        mean[j] = m / (n as f32)
    }

    let Xc: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(Xc, i, j, matrix_at(X, i, j) - mean[j])
        }
    }

    let cov: Matrix = matrix_new(p, p)
    for i in 0 to p {
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n {
                s = s + matrix_at(Xc, k, i) * matrix_at(Xc, k, j)
            }
            matrix_set(cov, i, j, s / (n as f32))
        }
    }

    let pca_model: PCA = pca_fit(X, n_components)
    let whitening: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        whitening[c] = array_new_f32(p)
        let ev: f32 = pca_model.explained_variance[c]
        if ev < 0.0000000001 { ev = 0.0000000001 }
        for j in 0 to p {
            whitening[c][j] = pca_model.components[c][j] / sqrt((ev as f64)) as f32
        }
    }

    let Xw: Matrix = matrix_new(n, n_components)
    for i in 0 to n {
        for c in 0 to n_components {
            let mut s: f32 = 0.0
            for j in 0 to p {
                s = s + matrix_at(Xc, i, j) * whitening[c][j]
            }
            matrix_set(Xw, i, c, s)
        }
    }

    srand(seed)

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let mut n_iter: i32 = 0

    for c in 0 to n_components {
        components[c] = array_new_f32(n_components)
        for j in 0 to n_components {
            components[c][j] = ((rand() % 1000) as f32) / 500.0 - 1.0
        }
        opt_ica_fit_gs(components[c], components, c, n_components)

        for iter in 0 to max_iter {
            n_iter = iter + 1

            let w_old: ptr<f32> = array_copy_f32(components[c], n_components)

            let gw: ptr<f32> = array_new_f32(n_components)
            let g_w: ptr<f32> = array_new_f32(n_components)

            for i in 0 to n {
                let mut dot: f32 = 0.0
                for j in 0 to n_components {
                    dot = dot + components[c][j] * matrix_at(Xw, i, j)
                }
                let t: f32 = tanh((dot) as f64) as f32
                let g_deriv: f32 = 1.0 - t * t

                for j in 0 to n_components {
                    gw[j] = gw[j] + t * matrix_at(Xw, i, j)
                    g_w[j] = g_w[j] + g_deriv * components[c][j]
                }
            }

            for j in 0 to n_components {
                components[c][j] = (gw[j] - g_w[j] * components[c][j]) / (n as f32)
            }

            opt_ica_fit_gs(components[c], components, c, n_components)

            let mut dot: f32 = 0.0
            for j in 0 to n_components {
                dot = dot + components[c][j] * w_old[j]
            }
            let convergence: f32 = fabs((fabs((dot) as f64) as f32 - 1.0) as f64) as f32

            array_free_f32(w_old)
            array_free_f32(gw)
            array_free_f32(g_w)

            if convergence < tol { break }
        }
    }

    let mixing: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        mixing[c] = array_new_f32(p)
        for j in 0 to p {
            let mut s: f32 = 0.0
            for k in 0 to n_components {
                s = s + components[c][k] * whitening[c][j]
            }
            mixing[c][j] = s
        }
    }

    for c in 0 to n_components {
        array_free_f32(whitening[c])
    }
    free(whitening as ptr<void>)
    matrix_free(Xw)
    matrix_free(Xc)
    matrix_free(cov)
    pca_free(pca_model)

    let model: FastICA = FastICA {
        components: components,
        n_components: n_components,
        n_features: p,
        mean: mean,
        mixing: mixing,
        n_iter: n_iter,
        fitted: true
    }
    return model
}

function opt_ica_fit_fill(X: Matrix, seed: i32) -> void {
    for i in 0 to X.rows {
        for j in 0 to X.cols {
            let s1: f32 = sin(((i * 3 + j) as f64) * 0.17) as f32
            let s2: f32 = cos(((i * 5 + j * 2 + seed) as f64) * 0.09) as f32
            matrix_set(X, i, j, s1 + 0.5 * s2 * ((j + 1) as f32))
        }
    }
}

# Fit both implementations on the same data and compare element-wise.
# Returns the number of differing values, or -1 on a shape/n_iter mismatch.
function opt_ica_fit_parity(n: i32, p: i32, k: i32, max_iter: i32, tol: f32, seed: i32, fill_seed: i32) -> i32 {
    let X: Matrix = matrix_new(n, p)
    opt_ica_fit_fill(X, fill_seed)

    let got: FastICA = fast_ica_fit(X, k, max_iter, tol, seed)
    let want: FastICA = opt_ica_fit_reference(X, k, max_iter, tol, seed)

    let mut bad: i32 = 0
    if got.n_iter != want.n_iter { bad = -1 }
    if got.n_components != want.n_components || got.n_features != want.n_features { bad = -1 }

    if bad == 0 {
        for j in 0 to p {
            if got.mean[j] != want.mean[j] { bad = bad + 1 }
        }
        for c in 0 to k {
            for j in 0 to k {
                if got.components[c][j] != want.components[c][j] { bad = bad + 1 }
            }
            for j in 0 to p {
                if got.mixing[c][j] != want.mixing[c][j] { bad = bad + 1 }
            }
        }

        let Tg: Matrix = fast_ica_transform(got, X)
        let Tw: Matrix = fast_ica_transform(want, X)
        for i in 0 to n {
            for c in 0 to k {
                if matrix_at(Tg, i, c) != matrix_at(Tw, i, c) { bad = bad + 1 }
            }
        }
        matrix_free(Tg)
        matrix_free(Tw)
    }

    fast_ica_free(got)
    fast_ica_free(want)
    matrix_free(X)
    return bad
}

function main() -> i32 {
    # --- 1. Known-correct structural properties ----------------------------
    let X1: Matrix = matrix_new(60, 4)
    opt_ica_fit_fill(X1, 1)
    let m1: FastICA = fast_ica_fit(X1, 3, 100, 0.0001, 42)

    if m1.n_components != 3 || m1.n_features != 4 {
        println("FAIL: fitted model shape")
        return 1
    }
    if not m1.fitted {
        println("FAIL: fitted flag")
        return 1
    }
    # The mean must be the column mean of X.
    for j in 0 to 4 {
        let mut s: f32 = 0.0
        for i in 0 to 60 { s = s + matrix_at(X1, i, j) }
        if not opt_ica_fit_close(m1.mean[j], s / 60.0, 0.0001) {
            println("FAIL: stored mean is not the column mean")
            return 1
        }
    }
    # Gram-Schmidt leaves every unmixing row unit norm.
    for c in 0 to 3 {
        let mut norm: f32 = 0.0
        for j in 0 to 3 { norm = norm + m1.components[c][j] * m1.components[c][j] }
        norm = sqrt((norm as f64)) as f32
        if not opt_ica_fit_close(norm, 1.0, 0.001) {
            println("FAIL: unmixing row is not unit norm")
            return 1
        }
    }
    # Transform must produce one column per component.
    let T1: Matrix = fast_ica_transform(m1, X1)
    if T1.rows != 60 || T1.cols != 3 {
        println("FAIL: transform output shape")
        return 1
    }
    matrix_free(T1)
    fast_ica_free(m1)
    matrix_free(X1)

    # --- 2. Element-wise parity with the original implementation -----------
    # Small workload, in the region the scaled benchmark covers.
    if opt_ica_fit_parity(100, 8, 3, 100, 0.0001, 42, 3) != 0 {
        println("FAIL: parity mismatch on small workload")
        return 1
    }
    # Realistic workload.
    if opt_ica_fit_parity(800, 20, 6, 100, 0.0001, 42, 11) != 0 {
        println("FAIL: parity mismatch on realistic workload")
        return 1
    }
    # Single component.
    if opt_ica_fit_parity(200, 6, 1, 50, 0.0001, 7, 17) != 0 {
        println("FAIL: parity mismatch with a single component")
        return 1
    }
    # n_components equal to n_features.
    if opt_ica_fit_parity(150, 5, 5, 60, 0.0001, 13, 23) != 0 {
        println("FAIL: parity mismatch with n_components == n_features")
        return 1
    }
    # Tolerance tight enough that the loop runs to max_iter: n_iter must match.
    if opt_ica_fit_parity(120, 6, 3, 25, 0.0, 29, 31) != 0 {
        println("FAIL: parity mismatch or n_iter drift without early stopping")
        return 1
    }
    # Wide features relative to samples.
    if opt_ica_fit_parity(60, 24, 4, 50, 0.0001, 5, 37) != 0 {
        println("FAIL: parity mismatch on wide-feature workload")
        return 1
    }

    println("PASS: FastICA.fit optimization")
    return 0
}
