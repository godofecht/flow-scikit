# Issue #357: explicit solver choice for logistic regression.
#
# LBFGS stays the default and its behaviour is unchanged. A caller can now ask
# for Newton / IRLS, which is the textbook update and the one R's glm runs.
#
# Seven checks, in order:
#   1. The default path is still LBFGS, bit for bit against an explicit
#      LOGISTIC_SOLVER_LBFGS request.
#   2. Newton reaches the true optimum of the penalized objective, computed
#      independently with scipy on the same fixture in f64.
#   3. Newton and LBFGS agree on that optimum, and Newton gets there in fewer
#      iterations.
#   4. The one-vs-rest model for the other class is the exact mirror, which is
#      what the log loss requires.
#   5. A perfectly collinear design gives a singular Hessian. The fit stays
#      finite and lands on the same linear predictor as the full-rank fit, with
#      the collinear pair sharing one column's weight.
#   6. A nearly singular Hessian leaves the coefficients badly determined, and
#      both solvers say the same badly determined thing. The fitted
#      probabilities agree.
#   7. With more than two classes the fit is the joint multinomial softmax and
#      runs LBFGS whichever solver was asked for.
#
# Reference optima, from scipy.optimize.minimize on the same objective (mean
# log loss plus 0.5 * alpha * ||w||^2, intercept unpenalized), gradient norm
# below 1e-10 in both cases:
#
#   alpha = 0.25 : w = [ 0.439164819,  0.177912193, -0.360812169]  b = -0.151761677
#   alpha = 0.0  : w = [ 2.398670968,  1.391838596, -3.675177191]  b = -0.076716830

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
}

function t357_abs(x: f32) -> f32 {
    if x < 0.0 { return 0.0 - x }
    return x
}

# True for NaN and for either infinity.
function t357_not_finite(x: f32) -> bool {
    if x != x { return true }
    if x > 1000000000000000000000000000000000.0 { return true }
    if x < -1000000000000000000000000000000000.0 { return true }
    return false
}

function t357_check(name: string, got: f32, want: f32, tol: f32) -> i32 {
    let diff: f32 = t357_abs(got - want)
    if t357_not_finite(got) || diff > tol {
        printf("  FAIL: %s got %.7f want %.7f diff %.7f tol %.7f\n", name, got, want, diff, tol)
        return 1
    }
    printf("  OK: %s %.7f (want %.7f, diff %.7f)\n", name, got, want, diff)
    return 0
}

# The shared fixture: 30 samples, 3 features, labels from a linear rule with
# every seventh label flipped so the design is not separable and the
# unpenalized optimum exists. Every value is a multiple of 0.25, so the f32
# fixture is the f64 fixture exactly.
function t357_fixture_X() -> Matrix {
    let m: i32 = 30
    let X: Matrix = matrix_new(m, 3)
    for i in 0 to m {
        let x0: f32 = ((i % 5) as f32 - 2.0) * 0.5
        let x1: f32 = ((i / 5) % 3) as f32 - 1.0
        let x2: f32 = ((i % 7) as f32 - 3.0) * 0.25
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        matrix_set(X, i, 2, x2)
    }
    return X
}

function t357_fixture_y() -> ptr<f32> {
    let m: i32 = 30
    let y: ptr<f32> = array_new_f32(m)
    for i in 0 to m {
        let x0: f32 = ((i % 5) as f32 - 2.0) * 0.5
        let x1: f32 = ((i / 5) % 3) as f32 - 1.0
        let x2: f32 = ((i % 7) as f32 - 3.0) * 0.25
        let s: f32 = x0 + 0.5 * x1 - x2
        let mut lab: f32 = 0.0
        if s > 0.0 { lab = 1.0 }
        if i % 7 == 3 { lab = 1.0 - lab }
        y[i] = lab
    }
    return y
}

# ---- 1. The default is still LBFGS ----
function test_default_is_lbfgs() -> i32 {
    println("Test: the default solver is still LBFGS")
    let X: Matrix = t357_fixture_X()
    let y: ptr<f32> = t357_fixture_y()
    let pen: Penalty = penalty_l2(0.25)

    let a: LogisticRegression = logistic_regression_fit(X, y, 2, 200, 0.1, pen)
    let b: LogisticRegression = logistic_regression_fit_solver(X, y, 2, 200, 0.1, pen, 0)

    let mut failures: i32 = 0
    if a.n_iter != b.n_iter {
        printf("  FAIL: iteration counts differ, %d vs %d\n", a.n_iter, b.n_iter)
        failures = failures + 1
    }
    for j in 0 to 6 {
        if a.weights[j] != b.weights[j] {
            printf("  FAIL: weight %d differs, %.9f vs %.9f\n", j, a.weights[j], b.weights[j])
            failures = failures + 1
        }
    }
    for c in 0 to 2 {
        if a.biases[c] != b.biases[c] {
            printf("  FAIL: intercept %d differs, %.9f vs %.9f\n", c, a.biases[c], b.biases[c])
            failures = failures + 1
        }
    }
    if failures == 0 {
        printf("  OK: identical to an explicit LBFGS request, %d iterations\n", a.n_iter)
    }

    logistic_regression_free(a)
    logistic_regression_free(b)
    array_free_f32(y)
    matrix_free(X)
    return failures
}

# ---- 2, 3, 4. Newton against the true optimum and against LBFGS ----
function test_newton_optimum() -> i32 {
    println("Test: Newton reaches the penalized optimum, in fewer iterations")
    let X: Matrix = t357_fixture_X()
    let y: ptr<f32> = t357_fixture_y()
    let pen: Penalty = penalty_l2(0.25)

    let lb: LogisticRegression = logistic_regression_fit_solver(X, y, 2, 200, 0.1, pen, 0)
    let nw: LogisticRegression = logistic_regression_fit_solver(X, y, 2, 200, 0.1, pen, 1)

    let mut failures: i32 = 0
    if nw.classes[0] != 0.0 || nw.classes[1] != 1.0 {
        printf("  FAIL: unexpected class order %.1f %.1f\n", nw.classes[0], nw.classes[1])
        failures = failures + 1
    }

    # Class 1 is the positive class, so its one-vs-rest model is the reference
    # fit. Newton is held to 5e-4, which is where a f32 iterate can sit against
    # an f64 optimum on this fixture.
    failures = failures + t357_check("newton w0", nw.weights[3], 0.439164819, 0.0005)
    failures = failures + t357_check("newton w1", nw.weights[4], 0.177912193, 0.0005)
    failures = failures + t357_check("newton w2", nw.weights[5], -0.360812169, 0.0005)
    failures = failures + t357_check("newton b", nw.biases[1], -0.151761677, 0.0005)

    # Check 4: the class-0 model is the exact mirror of the class-1 model.
    failures = failures + t357_check("newton mirror w0", nw.weights[0], -nw.weights[3], 0.0005)
    failures = failures + t357_check("newton mirror w1", nw.weights[1], -nw.weights[4], 0.0005)
    failures = failures + t357_check("newton mirror w2", nw.weights[2], -nw.weights[5], 0.0005)
    failures = failures + t357_check("newton mirror b", nw.biases[0], -nw.biases[1], 0.0005)

    # Check 3: LBFGS lands on the same optimum. Its own stopping rule is a
    # gradient norm of 1e-4 with no line search, so it is held to 5e-3.
    failures = failures + t357_check("lbfgs w0 vs newton", lb.weights[3], nw.weights[3], 0.005)
    failures = failures + t357_check("lbfgs w1 vs newton", lb.weights[4], nw.weights[4], 0.005)
    failures = failures + t357_check("lbfgs w2 vs newton", lb.weights[5], nw.weights[5], 0.005)
    failures = failures + t357_check("lbfgs b vs newton", lb.biases[1], nw.biases[1], 0.005)

    printf("  iterations: newton %d, lbfgs %d\n", nw.n_iter, lb.n_iter)
    if nw.n_iter * 2 > lb.n_iter {
        printf("  FAIL: newton took %d iterations against lbfgs %d\n", nw.n_iter, lb.n_iter)
        failures = failures + 1
    } else {
        printf("  OK: newton needed at most half the iterations\n")
    }

    logistic_regression_free(lb)
    logistic_regression_free(nw)
    array_free_f32(y)
    matrix_free(X)
    return failures
}

# ---- 5. Singular Hessian from a perfectly collinear design ----
#
# Column 3 is exactly twice column 0, so X^T W X is rank deficient and has no
# inverse. The system is still consistent, because the gradient lies in the row
# space of the design, so the solve puts a zero in the degenerate coordinate
# and solves the rest. The fit stays finite and the two collinear columns
# together carry the weight the single column carries in the full-rank fit:
#
#     w0 + 2 * w3  ==  w0 of the full-rank fit
#
# Unpenalized, so nothing but the design keeps the Hessian singular.
function test_newton_singular_hessian() -> i32 {
    println("Test: Newton on a singular Hessian (perfectly collinear design)")
    let m: i32 = 30
    let X3: Matrix = t357_fixture_X()
    let y: ptr<f32> = t357_fixture_y()

    let X4: Matrix = matrix_new(m, 4)
    for i in 0 to m {
        matrix_set(X4, i, 0, matrix_at(X3, i, 0))
        matrix_set(X4, i, 1, matrix_at(X3, i, 1))
        matrix_set(X4, i, 2, matrix_at(X3, i, 2))
        matrix_set(X4, i, 3, 2.0 * matrix_at(X3, i, 0))
    }

    let none: Penalty = penalty_none()
    let full: LogisticRegression = logistic_regression_fit_solver(X3, y, 2, 200, 0.1, none, 1)
    let sing: LogisticRegression = logistic_regression_fit_solver(X4, y, 2, 200, 0.1, none, 1)

    let mut failures: i32 = 0
    for j in 0 to 8 {
        if t357_not_finite(sing.weights[j]) {
            printf("  FAIL: coefficient %d is not finite\n", j)
            failures = failures + 1
        }
    }
    for c in 0 to 2 {
        if t357_not_finite(sing.biases[c]) {
            printf("  FAIL: intercept %d is not finite\n", c)
            failures = failures + 1
        }
    }
    printf("  singular fit coefficients: %.6f %.6f %.6f %.6f b %.6f, %d iterations\n", sing.weights[4], sing.weights[5], sing.weights[6], sing.weights[7], sing.biases[1], sing.n_iter)

    # The full-rank unpenalized fit against the independently computed optimum.
    failures = failures + t357_check("full-rank w0", full.weights[3], 2.398670968, 0.006)
    failures = failures + t357_check("full-rank w1", full.weights[4], 1.391838596, 0.006)
    failures = failures + t357_check("full-rank w2", full.weights[5], -3.675177191, 0.010)
    failures = failures + t357_check("full-rank b", full.biases[1], -0.076716830, 0.006)

    let combined: f32 = sing.weights[4] + 2.0 * sing.weights[7]
    failures = failures + t357_check("collinear w0 + 2*w3", combined, full.weights[3], 0.010)
    failures = failures + t357_check("collinear w1", sing.weights[5], full.weights[4], 0.010)
    failures = failures + t357_check("collinear w2", sing.weights[6], full.weights[5], 0.015)
    failures = failures + t357_check("collinear b", sing.biases[1], full.biases[1], 0.010)

    logistic_regression_free(full)
    logistic_regression_free(sing)
    array_free_f32(y)
    matrix_free(X4)
    matrix_free(X3)
    return failures
}

# ---- 5b. Nearly singular Hessian ----
#
# Column 3 is twice column 0 plus a small jitter that no other column carries,
# so the Hessian is not singular, it is merely close to it. The individual
# coefficients are then genuinely large: the data does not pin them down, and
# both solvers say so. What the data does pin down is the fitted probability,
# so that is what is compared here. Newton and LBFGS are held to each other
# rather than to a stored constant, because a coefficient that large moves with
# the BLAS implementation.
function test_newton_near_singular_hessian() -> i32 {
    println("Test: Newton on a nearly singular Hessian")
    let m: i32 = 30
    let X3: Matrix = t357_fixture_X()
    let y: ptr<f32> = t357_fixture_y()

    let X4: Matrix = matrix_new(m, 4)
    for i in 0 to m {
        let jitter: f32 = ((i * 7) % 11) as f32 - 5.0
        matrix_set(X4, i, 0, matrix_at(X3, i, 0))
        matrix_set(X4, i, 1, matrix_at(X3, i, 1))
        matrix_set(X4, i, 2, matrix_at(X3, i, 2))
        matrix_set(X4, i, 3, 2.0 * matrix_at(X3, i, 0) + 0.00390625 * jitter)
    }

    let none: Penalty = penalty_none()
    let nw: LogisticRegression = logistic_regression_fit_solver(X4, y, 2, 200, 0.1, none, 1)
    let lb: LogisticRegression = logistic_regression_fit_solver(X4, y, 2, 200, 0.1, none, 0)

    let mut failures: i32 = 0
    for j in 0 to 8 {
        if t357_not_finite(nw.weights[j]) {
            printf("  FAIL: coefficient %d is not finite\n", j)
            failures = failures + 1
        }
    }
    printf("  newton coefficients: %.4f %.4f %.4f %.4f b %.4f, %d iterations\n", nw.weights[4], nw.weights[5], nw.weights[6], nw.weights[7], nw.biases[1], nw.n_iter)
    printf("  lbfgs coefficients:  %.4f %.4f %.4f %.4f b %.4f, %d iterations\n", lb.weights[4], lb.weights[5], lb.weights[6], lb.weights[7], lb.biases[1], lb.n_iter)

    let p_nw: ptr<f32> = logistic_predict_proba(nw, X4)
    let p_lb: ptr<f32> = logistic_predict_proba(lb, X4)
    let mut worst: f32 = 0.0
    for i in 0 to m {
        if t357_not_finite(p_nw[i]) {
            printf("  FAIL: probability %d is not finite\n", i)
            failures = failures + 1
        }
        let diff: f32 = t357_abs(p_nw[i] - p_lb[i])
        if diff > worst { worst = diff }
    }
    failures = failures + t357_check("worst probability gap vs lbfgs", worst, 0.0, 0.02)

    array_free_f32(p_nw)
    array_free_f32(p_lb)
    logistic_regression_free(nw)
    logistic_regression_free(lb)
    array_free_f32(y)
    matrix_free(X4)
    matrix_free(X3)
    return failures
}

# ---- 6. More than two classes stays on the multinomial LBFGS path ----
function test_newton_multiclass_falls_back() -> i32 {
    println("Test: more than two classes runs the multinomial softmax either way")
    let m: i32 = 30
    let X: Matrix = t357_fixture_X()
    let y: ptr<f32> = array_new_f32(m)
    for i in 0 to m {
        y[i] = (i % 3) as f32
    }
    let pen: Penalty = penalty_l2(0.1)

    let a: LogisticRegression = logistic_regression_fit_solver(X, y, 3, 200, 0.1, pen, 0)
    let b: LogisticRegression = logistic_regression_fit_solver(X, y, 3, 200, 0.1, pen, 1)

    let mut failures: i32 = 0
    if a.n_classes != 3 || b.n_classes != 3 {
        printf("  FAIL: expected 3 classes, got %d and %d\n", a.n_classes, b.n_classes)
        failures = failures + 1
    }
    for j in 0 to 9 {
        if a.weights[j] != b.weights[j] {
            printf("  FAIL: weight %d differs, %.9f vs %.9f\n", j, a.weights[j], b.weights[j])
            failures = failures + 1
        }
    }
    if failures == 0 {
        printf("  OK: identical multinomial fit, %d iterations\n", b.n_iter)
    }

    logistic_regression_free(a)
    logistic_regression_free(b)
    array_free_f32(y)
    matrix_free(X)
    return failures
}

function main() -> i32 {
    println("Running logistic regression solver tests (issue #357)...")
    println("=======================================================")
    println("")

    let mut failures: i32 = 0

    failures = failures + test_default_is_lbfgs()
    println("")
    failures = failures + test_newton_optimum()
    println("")
    failures = failures + test_newton_singular_hessian()
    println("")
    failures = failures + test_newton_near_singular_hessian()
    println("")
    failures = failures + test_newton_multiclass_falls_back()

    println("")
    if failures == 0 {
        println("All logistic regression solver tests passed!")
        return 0
    }
    print("FAILED: ")
    print(failures)
    println(" checks")
    return 1
}
