function test_huber_regressor() -> i32 {
    println("Test: HuberRegressor")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 1)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let x: f32 = (i as f32) * 0.3
        matrix_set(X, i, 0, x)
        y[i] = 2.0 * x + 1.0 + _noise(i) * 0.1
    }
    y[15] = 100.0
    y[20] = -100.0

    let model: HuberRegressor = huber_regressor_fit(X, y, 1.35, 100, 0.01)
    let preds: ptr<f32> = huber_regressor_predict(model, X)

    let mut clean_ss: f32 = 0.0
    for i in 0 to n {
        if i != 15 && i != 20 {
            let d: f32 = y[i] - preds[i]
            clean_ss = clean_ss + d * d
        }
    }
    let clean_rmse: f32 = sqrt((clean_ss / 28.0) as f64) as f32

    if clean_rmse > 0.5 {
        println("  FAIL: HuberRegressor should be robust to outliers")
        return 1
    }

    print("  OK: clean RMSE = ")
    printf("%.4f", clean_rmse)
    print(", weight = ")
    printf("%.4f", model.weights[0])
    println("")

    huber_regressor_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_bayesian_ridge() -> i32 {
    println("Test: BayesianRidge")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)

    srand(42)
    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        y[i] = 2.0 * x0 + 3.0 * x1 + _noise(i) * 0.1
    }

    let model: BayesianRidge = bayesian_ridge_fit(X, y, 200, 0.0001)
    let preds: ptr<f32> = bayesian_ridge_predict(model, X)
    let r2: f32 = r2_score(y, preds, n)

    if r2 < 0.9 {
        println("  FAIL: BayesianRidge R2 should be > 0.9")
        print("  R2 = ")
        printf("%.4f", r2)
        println("")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    print(", alpha = ")
    printf("%.4f", model.alpha)
    print(", beta = ")
    printf("%.4f", model.beta)
    println("")

    bayesian_ridge_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_power_transformer() -> i32 {
    println("Test: PowerTransformer")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 1)
    srand(42)
    for i in 0 to n {
        let val: f32 = ((rand() % 100) as f32) / 10.0 + 0.1
        matrix_set(X, i, 0, val * val)
    }

    let pt: PowerTransformer = power_transformer_fit(X, POWER_YEO_JOHNSON)
    let transformed: Matrix = power_transformer_transform(pt, X)

    let mut mean: f32 = 0.0
    for i in 0 to n {
        mean = mean + matrix_at(transformed, i, 0)
    }
    mean = mean / (n as f32)

    let mut std: f32 = 0.0
    for i in 0 to n {
        let d: f32 = matrix_at(transformed, i, 0) - mean
        std = std + d * d
    }
    std = sqrt((std / (n as f32)) as f64) as f32

    if fabs((mean) as f64) as f32 > 0.1 {
        println("  FAIL: transformed mean should be ~0")
        return 1
    }
    if fabs((std - 1.0) as f64) as f32 > 0.1 {
        println("  FAIL: transformed std should be ~1")
        return 1
    }

    print("  OK: mean = ")
    printf("%.4f", mean)
    print(", std = ")
    printf("%.4f", std)
    println("")

    matrix_free(transformed)
    power_transformer_free(pt)
    matrix_free(X)
    return 0
}

function test_quantile_transformer() -> i32 {
    println("Test: QuantileTransformer")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 1)
    srand(42)
    for i in 0 to n {
        let val: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, val * val)
    }

    let qt: QuantileTransformer = quantile_transformer_fit(X, 10, QUANTILE_OUTPUT_UNIFORM)
    let transformed: Matrix = quantile_transformer_transform(qt, X)

    let min_val: f32 = array_min_val(transformed.data, n)
    let max_val: f32 = array_max_val(transformed.data, n)

    if min_val < -0.1 || max_val > 1.1 {
        println("  FAIL: uniform output should be in [0, 1]")
        return 1
    }

    print("  OK: range [")
    printf("%.4f", min_val)
    print(", ")
    printf("%.4f", max_val)
    println("]")

    matrix_free(transformed)
    quantile_transformer_free(qt)
    matrix_free(X)
    return 0
}

function test_fast_ica() -> i32 {
    println("Test: FastICA")
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 3)

    srand(42)
    for i in 0 to n {
        let s1: f32 = sin((i as f64) * 0.3) as f32
        let s2: f32 = ((rand() % 100) as f32) / 50.0 - 1.0
        let s3: f32 = _noise(i) * 2.0
        matrix_set(X, i, 0, 0.5 * s1 + 0.2 * s2 + 0.1 * s3)
        matrix_set(X, i, 1, 0.3 * s1 + 0.7 * s2 + 0.2 * s3)
        matrix_set(X, i, 2, 0.1 * s1 + 0.4 * s2 + 0.9 * s3)
    }

    let ica: FastICA = fast_ica_fit(X, 2, 100, 0.0001, 42)
    let transformed: Matrix = fast_ica_transform(ica, X)

    if transformed.cols != 2 {
        println("  FAIL: should have 2 components")
        return 1
    }

    let mut total_var: f32 = 0.0
    for i in 0 to n {
        for c in 0 to 2 {
            let v: f32 = matrix_at(transformed, i, c)
            total_var = total_var + v * v
        }
    }

    if total_var < 0.1 {
        println("  FAIL: transformed data should have variance")
        return 1
    }

    print("  OK: 2 components, n_iter = ")
    print(ica.n_iter)
    println("")

    matrix_free(transformed)
    fast_ica_free(ica)
    matrix_free(X)
    return 0
}

function test_sparse_pca() -> i32 {
    println("Test: SparsePCA")
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 4)

    srand(42)
    for i in 0 to n {
        let s1: f32 = sin((i as f64) * 0.3) as f32
        let s2: f32 = ((rand() % 100) as f32) / 50.0 - 1.0
        matrix_set(X, i, 0, s1 + _noise(i) * 0.05)
        matrix_set(X, i, 1, s1 + _noise(i + 10) * 0.05)
        matrix_set(X, i, 2, s2 + _noise(i + 20) * 0.05)
        matrix_set(X, i, 3, s2 + _noise(i + 30) * 0.05)
    }

    let spca: SparsePCA = sparse_pca_fit(X, 2, 0.1, 200, 0.0001, 42)
    let transformed: Matrix = sparse_pca_transform(spca, X)

    if transformed.cols != 2 {
        println("  FAIL: should have 2 components")
        return 1
    }

    let mut n_zeros: i32 = 0
    for c in 0 to 2 {
        for j in 0 to 4 {
            if (fabs((spca.components[c][j]) as f64) as f32) < 0.000001 {
                n_zeros = n_zeros + 1
            }
        }
    }

    print("  OK: 2 components, ")
    print(n_zeros)
    println(" sparse zeros in loading vectors")

    matrix_free(transformed)
    sparse_pca_free(spca)
    matrix_free(X)
    return 0
}

