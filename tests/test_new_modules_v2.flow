function test_mlp_classifier() -> i32 {
    println("Test: MLPClassifier")
    let ds: Dataset = make_classification(60, 4, 2, 4, 0, 2.0, 42)
    let split: TrainTestSplit = train_test_split(ds.X, ds.y, 0.33, 0)

    let hidden: array<i32, 1> = [8]
    let model: MLPClassifier = mlp_classifier_fit(
        split.X_train, split.y_train, 2,
        hidden, 1, MLP_ACT_RELU, 200, 0.01, 0.9, 42
    )

    let probs: Matrix = mlp_classifier_predict(model, split.X_test)
    let preds: ptr<f32> = mlp_classifier_decide(model, probs)
    let acc: f32 = accuracy_score(split.y_test, preds, split.n_test)

    if acc < 0.6 {
        println("  FAIL: MLPClassifier accuracy should be > 0.6")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    mlp_classifier_free(model)
    matrix_free(probs)
    array_free_f32(preds)
    train_test_split_free(split)
    dataset_free(ds)
    return 0
}

function test_mlp_regressor() -> i32 {
    println("Test: MLPRegressor")
    let ds: Dataset = make_regression(60, 3, 3, 0.1, 1.0, 42)
    let split: TrainTestSplit = train_test_split(ds.X, ds.y, 0.33, 0)

    let hidden: array<i32, 1> = [16]
    let model: MLPRegressor = mlp_regressor_fit(
        split.X_train, split.y_train,
        hidden, 1, MLP_ACT_RELU, 300, 0.005, 0.9, 42
    )

    let preds: ptr<f32> = mlp_regressor_predict(model, split.X_test)
    let r2: f32 = r2_score(split.y_test, preds, split.n_test)

    if r2 < 0.3 {
        println("  FAIL: MLPRegressor R2 should be > 0.3")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    mlp_regressor_free(model)
    array_free_f32(preds)
    train_test_split_free(split)
    dataset_free(ds)
    return 0
}

function test_gaussian_mixture() -> i32 {
    println("Test: GaussianMixture")
    let ds: Dataset = make_blobs(60, 2, 3, 0.3, -3.0, 3.0, 42)

    let gmm: GaussianMixture = gaussian_mixture_fit(ds.X, 3, 100, 0.001, 42)
    let labels: ptr<i32> = gaussian_mixture_predict(gmm, ds.X)

    let mut cluster_counts: array<i32, 3> = [0, 0, 0]
    for i in 0 to 60 {
        if labels[i] >= 0 && labels[i] < 3 {
            cluster_counts[labels[i]] = cluster_counts[labels[i]] + 1
        }
    }

    let mut all_found: bool = true
    for c in 0 to 3 {
        if cluster_counts[c] == 0 { all_found = false }
    }

    if not all_found {
        println("  FAIL: GMM should find all 3 components")
        return 1
    }

    print("  OK: 3 components found, log_likelihood = ")
    printf("%.4f", gmm.log_likelihood)
    println("")

    free(labels as ptr<void>)
    gaussian_mixture_free(gmm)
    dataset_free(ds)
    return 0
}

function test_dummy_classifier() -> i32 {
    println("Test: DummyClassifier (prior)")
    let y: ptr<f32> = array_new_f32(20)
    for i in 0 to 12 { y[i] = 0.0 }
    for i in 0 to 8 { y[12 + i] = 1.0 }

    let model: DummyClassifier = dummy_classifier_fit(y, 20, 2, DUMMY_STRATEGY_PRIOR, 0.0, 42)
    let preds: ptr<f32> = dummy_classifier_predict(model, 10)

    let mut all_prior: bool = true
    for i in 0 to 10 {
        if preds[i] != 0.0 { all_prior = false }
    }

    if not all_prior {
        println("  FAIL: prior strategy should predict most frequent class (0)")
        return 1
    }

    println("  OK: all predictions are class 0 (most frequent)")

    array_free_f32(preds)
    dummy_classifier_free(model)
    array_free_f32(y)
    return 0
}

function test_dummy_regressor() -> i32 {
    println("Test: DummyRegressor (mean)")
    let y: ptr<f32> = array_new_f32(10)
    for i in 0 to 10 {
        y[i] = (i as f32) * 2.0
    }

    let model: DummyRegressor = dummy_regressor_fit(y, 10, DUMMY_REG_MEAN, 0.0)
    let preds: ptr<f32> = dummy_regressor_predict(model, 5)

    let expected: f32 = 9.0
    if fabs((preds[0] - expected) as f64) as f32 > 0.01 {
        println("  FAIL: mean strategy should predict 9.0")
        return 1
    }

    print("  OK: all predictions = ")
    printf("%.4f", preds[0])
    println("")

    array_free_f32(preds)
    dummy_regressor_free(model)
    array_free_f32(y)
    return 0
}

function test_column_transformer() -> i32 {
    println("Test: ColumnTransformer")
    let X: Matrix = matrix_new(10, 4)
    srand(42)
    for i in 0 to 10 {
        for j in 0 to 4 {
            matrix_set(X, i, j, ((rand() % 100) as f32) / 10.0)
        }
    }

    let ct: ColumnTransformer = column_transformer_init(2)
    let cols1: ptr<i32> = malloc(8) as ptr<i32>
    cols1[0] = 0; cols1[1] = 1
    let cols2: ptr<i32> = malloc(8) as ptr<i32>
    cols2[0] = 2; cols2[1] = 3
    column_transformer_set_spec(ct, 0, TRANSFORMER_STANDARD_SCALER, cols1, 2)
    column_transformer_set_spec(ct, 1, TRANSFORMER_MINMAX_SCALER, cols2, 2)

    let ct2: ColumnTransformer = column_transformer_fit(ct, X)
    let transformed: Matrix = column_transformer_transform(ct2, X)

    if transformed.cols != 4 {
        println("  FAIL: should have 4 output features")
        print("  got: ")
        printf("%d", transformed.cols)
        println("")
        return 1
    }

    let mut col0_mean: f32 = 0.0
    for i in 0 to 10 {
        col0_mean = col0_mean + matrix_at(transformed, i, 0)
    }
    col0_mean = col0_mean / 10.0

    if fabs((col0_mean) as f64) as f32 > 0.01 {
        println("  FAIL: standard scaler col should have ~0 mean")
        return 1
    }

    println("  OK: 4 output features, scaler col mean ~ 0")

    matrix_free(transformed)
    column_transformer_free(ct2)
    matrix_free(X)
    return 0
}

function test_count_vectorizer() -> i32 {
    println("Test: CountVectorizer")
    let docs: array<string, 4> = [
        "the quick brown fox",
        "the lazy dog",
        "quick brown dog",
        "the fox and the dog"
    ]

    let cv: CountVectorizer = count_vectorizer_fit(docs, 4, 50)
    let counts: Matrix = count_vectorizer_transform(cv, docs, 4)

    if cv.n_features < 3 {
        println("  FAIL: should find at least 3 unique words")
        return 1
    }

    let mut total: f32 = 0.0
    for i in 0 to 4 {
        for j in 0 to cv.n_features {
            total = total + matrix_at(counts, i, j)
        }
    }

    if total < 8.0 {
        println("  FAIL: total word count should be at least 8")
        return 1
    }

    print("  OK: ")
    print(cv.n_features)
    print(" features, total count = ")
    printf("%.0f", total)
    println("")

    matrix_free(counts)
    count_vectorizer_free(cv)
    return 0
}

function test_tfidf_vectorizer() -> i32 {
    println("Test: TfidfVectorizer")
    let docs: array<string, 4> = [
        "the quick brown fox",
        "the lazy dog",
        "quick brown dog",
        "the fox and the dog"
    ]

    let tfidf: TfidfVectorizer = tfidf_vectorizer_fit(docs, 4, 50)
    let result: Matrix = tfidf_vectorizer_transform(tfidf, docs, 4)

    for i in 0 to 4 {
        let mut norm: f32 = 0.0
        for j in 0 to tfidf.n_features {
            norm = norm + matrix_at(result, i, j) * matrix_at(result, i, j)
        }
        norm = sqrt((norm as f64)) as f32
        if fabs((norm - 1.0) as f64) as f32 > 0.01 {
            println("  FAIL: row should be L2-normalized")
            return 1
        }
    }

    println("  OK: all rows L2-normalized")

    matrix_free(result)
    tfidf_vectorizer_free(tfidf)
    return 0
}

function test_gaussian_process() -> i32 {
    println("Test: GaussianProcessRegressor")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 1)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let x: f32 = (i as f32) * 0.2
        matrix_set(X, i, 0, x)
        y[i] = sin((x as f64)) as f32 + _noise(i) * 0.05
    }

    let gp: GaussianProcessRegressor = gaussian_process_regressor_fit(X, y, 0.01, 0.5, GP_KERNEL_RBF)
    let preds: ptr<f32> = gaussian_process_regressor_predict(gp, X)

    let mut ss_res: f32 = 0.0
    for i in 0 to n {
        let d: f32 = y[i] - preds[i]
        ss_res = ss_res + d * d
    }
    let rmse: f32 = sqrt((ss_res / (n as f32)) as f64) as f32

    if rmse > 0.3 {
        println("  FAIL: GP RMSE should be < 0.3")
        return 1
    }

    print("  OK: RMSE = ")
    printf("%.4f", rmse)
    println("")

    array_free_f32(preds)
    gaussian_process_regressor_free(gp)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_multi_output_regressor() -> i32 {
    println("Test: MultiOutputRegressor")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 2)
    let Y: Matrix = matrix_new(n, 2)

    srand(42)
    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        matrix_set(Y, i, 0, 2.0 * x0 + 1.0 * x1 + _noise(i) * 0.1)
        matrix_set(Y, i, 1, 0.5 * x0 + 3.0 * x1 + _noise(i + 100) * 0.1)
    }

    let model: MultiOutputRegressor = multi_output_regressor_fit(X, Y, 2)
    let preds: Matrix = multi_output_regressor_predict(model, X)

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    for i in 0 to n {
        for o in 0 to 2 {
            let d: f32 = matrix_at(Y, i, o) - matrix_at(preds, i, o)
            ss_res = ss_res + d * d
            let dm: f32 = matrix_at(Y, i, o) - 5.0
            ss_tot = ss_tot + dm * dm
        }
    }

    let r2: f32 = 1.0 - ss_res / ss_tot
    if r2 < 0.8 {
        println("  FAIL: MultiOutputRegressor R2 should be > 0.8")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    matrix_free(preds)
    multi_output_regressor_free(model)
    matrix_free(X)
    matrix_free(Y)
    return 0
}

function test_regressor_chain() -> i32 {
    println("Test: RegressorChain")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 2)
    let Y: ptr<ptr<f32> > = malloc((2 as i64) * 8) as ptr<ptr<f32> >
    for o in 0 to 2 { Y[o] = array_new_f32(n) }

    srand(42)
    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        Y[0][i] = 2.0 * x0 + 1.0 * x1 + _noise(i) * 0.1
        Y[1][i] = 0.5 * x0 + 3.0 * x1 + Y[0][i] * 0.5 + _noise(i + 100) * 0.1
    }

    let model: RegressorChain = regressor_chain_fit(X, Y, n, 2, 2)
    let preds: ptr<ptr<f32> > = regressor_chain_predict(model, X)

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    for i in 0 to n {
        for o in 0 to 2 {
            let d: f32 = Y[o][i] - preds[i][o]
            ss_res = ss_res + d * d
            let dm: f32 = Y[o][i] - 10.0
            ss_tot = ss_tot + dm * dm
        }
    }

    let r2: f32 = 1.0 - ss_res / ss_tot
    if r2 < 0.8 {
        println("  FAIL: RegressorChain R2 should be > 0.8")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    for i in 0 to n { array_free_f32(preds[i]) }
    free(preds as ptr<void>)
    regressor_chain_free(model)
    matrix_free(X)
    for o in 0 to 2 { array_free_f32(Y[o]) }
    free(Y as ptr<void>)
    return 0
}

