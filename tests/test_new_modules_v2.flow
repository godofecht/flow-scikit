# Tests for new modules: datasets, neural_network, mixture, dummy,
# compose, feature_extraction, gaussian_process, multioutput,
# ExtraTrees, MeanShift, Birch, HuberRegressor, BayesianRidge,
# PowerTransformer, QuantileTransformer.
#
# Run: ./flow run tests/test_new_modules_v2.flow

import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

function _noise(seed: i32) -> f32 {
    let s: i64 = (seed as i64) * 1103515245 + 12345
    let n: i32 = ((s % 100) + 100) % 100
    return ((n as f32) / 100.0 - 0.5) * 0.3
}

function test_make_classification() -> i32 {
    println("Test: make_classification")
    let ds: Dataset = make_classification(60, 4, 2, 2, 0, 2.0, 42)

    if ds.n_samples != 60 {
        println("  FAIL: n_samples should be 60")
        return 1
    }
    if ds.n_features != 4 {
        println("  FAIL: n_features should be 4")
        return 1
    }
    if ds.n_classes != 2 {
        println("  FAIL: n_classes should be 2")
        return 1
    }

    let mut class0: i32 = 0
    let mut class1: i32 = 0
    for i in 0 to 60 {
        if ds.y[i] == 0.0 { class0 = class0 + 1 }
        if ds.y[i] == 1.0 { class1 = class1 + 1 }
    }

    if class0 == 0 || class1 == 0 {
        println("  FAIL: should have both classes")
        return 1
    }

    print("  OK: 60 samples, 4 features, 2 classes (")
    print(class0)
    print("/")
    print(class1)
    println(")")

    dataset_free(ds)
    return 0
}

function test_make_regression() -> i32 {
    println("Test: make_regression")
    let ds: Dataset = make_regression(50, 3, 2, 0.1, 1.0, 42)

    if ds.n_samples != 50 {
        println("  FAIL: n_samples should be 50")
        return 1
    }

    let mut y_mean: f32 = 0.0
    for i in 0 to 50 {
        y_mean = y_mean + ds.y[i]
    }
    y_mean = y_mean / 50.0

    let mut y_std: f32 = 0.0
    for i in 0 to 50 {
        let d: f32 = ds.y[i] - y_mean
        y_std = y_std + d * d
    }
    y_std = sqrt((y_std / 50.0) as f64) as f32

    if y_std < 0.1 {
        println("  FAIL: y should have variance")
        return 1
    }

    print("  OK: 50 samples, y std = ")
    printf("%.4f", y_std)
    println("")

    dataset_free(ds)
    return 0
}

function test_make_blobs() -> i32 {
    println("Test: make_blobs")
    let ds: Dataset = make_blobs(60, 2, 3, 0.5, -5.0, 5.0, 42)

    if ds.n_classes != 3 {
        println("  FAIL: should have 3 centers")
        return 1
    }

    let mut found: array<bool, 3> = [false, false, false]
    for i in 0 to 60 {
        let c: i32 = ds.y[i] as i32
        if c >= 0 && c < 3 { found[c] = true }
    }

    for c in 0 to 3 {
        if not found[c] {
            println("  FAIL: missing cluster")
            return 1
        }
    }

    println("  OK: 60 samples, 3 blobs, all clusters present")
    dataset_free(ds)
    return 0
}

