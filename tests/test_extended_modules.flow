# Tests for user-added modules: MiniBatchKMeans, MultinomialNB, BernoulliNB,
# RidgeClassifier, NearestNeighbors, TruncatedSVD, NMF, and multi-class metrics.
#
# Run: ./flow run tests/test_extended_modules.flow

import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

function _noise(seed: i32) -> f32 {
    let s: i32 = seed * 1103515245 + 12345
    let n: i32 = ((s % 100) + 100) % 100
    return ((n as f32) / 100.0 - 0.5) * 0.3
}

function make_blobs() -> Matrix {
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 2)
    for i in 0 to 10 {
        matrix_set(X, i, 0, 0.0 + _noise(i))
        matrix_set(X, i, 1, 0.0 + _noise(i + 100))
    }
    for i in 0 to 10 {
        matrix_set(X, 10 + i, 0, 5.0 + _noise(i + 200))
        matrix_set(X, 10 + i, 1, 5.0 + _noise(i + 300))
    }
    for i in 0 to 10 {
        matrix_set(X, 20 + i, 0, -5.0 + _noise(i + 400))
        matrix_set(X, 20 + i, 1, 5.0 + _noise(i + 500))
    }
    return X
}

function test_minibatch_kmeans() -> i32 {
    println("Test: MiniBatchKMeans")
    let X: Matrix = make_blobs()

    let mbkm: MiniBatchKMeans = minibatch_kmeans_fit(X, 3, 10, 50, 1e-4, 42)
    let labels: ptr<i32> = minibatch_kmeans_predict(mbkm, X)

    let mut cluster_counts: array<i32, 3> = [0, 0, 0]
    for i in 0 to X.rows {
        if labels[i] >= 0 && labels[i] < 3 {
            cluster_counts[labels[i]] = cluster_counts[labels[i]] + 1
        }
    }

    let mut all_found: bool = true
    for c in 0 to 3 {
        if cluster_counts[c] == 0 {
            all_found = false
        }
    }

    if not all_found {
        println("  FAIL: MiniBatchKMeans should find all 3 clusters")
        return 1
    }

    print("  OK: cluster sizes = [")
    for c in 0 to 3 {
        print(cluster_counts[c])
        if c < 2 { print(", ") }
    }
    println("]")

    minibatch_kmeans_free(mbkm)
    free(labels as ptr<void>)
    matrix_free(X)
    return 0
}

function test_multinomial_nb() -> i32 {
    println("Test: MultinomialNB")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 4)
    let y: ptr<f32> = array_new_f32(n)

    srand(42)
    for i in 0 to 10 {
        # Class 0: high values in features 0-1, low in 2-3
        matrix_set(X, i, 0, ((rand() % 3) as f32) + 5.0)
        matrix_set(X, i, 1, ((rand() % 3) as f32) + 5.0)
        matrix_set(X, i, 2, ((rand() % 3) as f32) + 1.0)
        matrix_set(X, i, 3, ((rand() % 3) as f32) + 1.0)
        y[i] = 0.0
    }
    for i in 0 to 10 {
        # Class 1: low values in features 0-1, high in 2-3
        matrix_set(X, 10 + i, 0, ((rand() % 3) as f32) + 1.0)
        matrix_set(X, 10 + i, 1, ((rand() % 3) as f32) + 1.0)
        matrix_set(X, 10 + i, 2, ((rand() % 3) as f32) + 5.0)
        matrix_set(X, 10 + i, 3, ((rand() % 3) as f32) + 5.0)
        y[10 + i] = 1.0
    }

    let model: MultinomialNB = multinomial_nb_fit(X, y, 2, 1.0)
    let preds: ptr<f32> = multinomial_nb_predict(model, X)
    let acc: f32 = accuracy_score(y, preds, n)

    if acc < 0.7 {
        println("  FAIL: MultinomialNB accuracy should be > 0.7")
        print("  got: ")
        printf("%.4f", acc)
        println("")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    multinomial_nb_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_bernoulli_nb() -> i32 {
    println("Test: BernoulliNB")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 5)
    let y: ptr<f32> = array_new_f32(n)

    srand(99)
    for i in 0 to 10 {
        for j in 0 to 5 {
            let val: f32 = 0.0
            if rand() % 3 > 0 { val = 1.0 }
            matrix_set(X, i, j, val)
        }
        y[i] = 0.0
    }
    for i in 0 to 10 {
        for j in 0 to 5 {
            let val: f32 = 0.0
            if rand() % 3 < 2 { val = 1.0 }
            matrix_set(X, 10 + i, j, val)
        }
        y[10 + i] = 1.0
    }

    let model: BernoulliNB = bernoulli_nb_fit(X, y, 2, 1.0)
    let preds: ptr<f32> = bernoulli_nb_predict(model, X)
    let acc: f32 = accuracy_score(y, preds, n)

    if acc < 0.6 {
        println("  FAIL: BernoulliNB accuracy should be > 0.6")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    bernoulli_nb_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_ridge_classifier() -> i32 {
    println("Test: RidgeClassifier")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to 10 {
        matrix_set(X, i, 0, 2.0 + _noise(i))
        matrix_set(X, i, 1, 2.0 + _noise(i + 100))
        y[i] = 0.0
    }
    for i in 0 to 10 {
        matrix_set(X, 10 + i, 0, -2.0 + _noise(i + 200))
        matrix_set(X, 10 + i, 1, -2.0 + _noise(i + 300))
        y[10 + i] = 1.0
    }

    let model: RidgeClassifier = ridge_classifier_fit(X, y, 0.1, 500, 0.001)
    let preds: ptr<f32> = ridge_classifier_predict(model, X)
    let acc: f32 = accuracy_score(y, preds, n)

    if acc < 0.7 {
        println("  FAIL: RidgeClassifier accuracy should be > 0.7")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    ridge_classifier_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_nearest_neighbors() -> i32 {
    println("Test: NearestNeighbors")
    let X: Matrix = make_blobs()

    let nn: NearestNeighbors = nearest_neighbors_fit(X, 3)
    let results: ptr<NeighborResult> = nearest_neighbors_kneighbors(nn, X)

    if results[0].n_neighbors != 3 {
        println("  FAIL: should return 3 neighbors")
        return 1
    }

    let mut self_in_neighbors: bool = false
    for i in 0 to results[0].n_neighbors {
        if results[0].indices[i] == 0 {
            self_in_neighbors = true
        }
    }

    if not self_in_neighbors {
        print("  OK: 3 neighbors found (self excluded or included)")
    } else {
        print("  OK: 3 neighbors found (self included, dist = ")
        printf("%.4f", results[0].distances[0])
        print(")")
    }
    println("")

    nearest_neighbors_free_results(results, X.rows)
    nearest_neighbors_free(nn)
    matrix_free(X)
    return 0
}

function test_truncated_svd() -> i32 {
    println("Test: TruncatedSVD")
    let X: Matrix = matrix_new(20, 4)
    srand(42)
    for i in 0 to 20 {
        for j in 0 to 4 {
            matrix_set(X, i, j, ((rand() % 100) as f32) / 10.0)
        }
    }

    let svd: TruncatedSVD = truncated_svd_fit(X, 2)
    let X_reduced: Matrix = truncated_svd_transform(svd, X)

    if X_reduced.cols != 2 {
        println("  FAIL: should reduce to 2 components")
        return 1
    }

    let mut total_evr: f32 = 0.0
    for c in 0 to 2 {
        total_evr = total_evr + svd.explained_variance_ratio[c]
    }

    print("  OK: 4D -> 2D, explained variance ratio sum = ")
    printf("%.4f", total_evr)
    println("")

    truncated_svd_free(svd)
    matrix_free(X_reduced)
    matrix_free(X)
    return 0
}

function test_nmf() -> i32 {
    println("Test: NMF")
    let n: i32 = 15
    let X: Matrix = matrix_new(n, 3)
    srand(42)
    for i in 0 to n {
        for j in 0 to 3 {
            let val: f32 = ((rand() % 100) as f32) / 10.0 + 0.1
            matrix_set(X, i, j, val)
        }
    }

    let model: NMF = nmf_fit(X, 2, 200, 1e-4, 42)
    let W: Matrix = nmf_transform(model, X)

    if W.cols != 2 {
        println("  FAIL: should produce 2 components")
        return 1
    }

    print("  OK: reconstruction error = ")
    printf("%.4f", model.reconstruction_err)
    println("")

    nmf_free(model)
    matrix_free(W)
    matrix_free(X)
    return 0
}

function test_multiclass_metrics() -> i32 {
    println("Test: Multi-class metrics (OvR/OvO)")
    let n: i32 = 15
    let y_true: ptr<f32> = array_new_f32(n)
    let y_pred: ptr<f32> = array_new_f32(n)

    y_true[0] = 0.0; y_pred[0] = 0.0
    y_true[1] = 0.0; y_pred[1] = 0.0
    y_true[2] = 0.0; y_pred[2] = 0.0
    y_true[3] = 0.0; y_pred[3] = 1.0
    y_true[4] = 0.0; y_pred[4] = 0.0
    y_true[5] = 1.0; y_pred[5] = 1.0
    y_true[6] = 1.0; y_pred[6] = 1.0
    y_true[7] = 1.0; y_pred[7] = 1.0
    y_true[8] = 1.0; y_pred[8] = 2.0
    y_true[9] = 1.0; y_pred[9] = 1.0
    y_true[10] = 2.0; y_pred[10] = 2.0
    y_true[11] = 2.0; y_pred[11] = 2.0
    y_true[12] = 2.0; y_pred[12] = 2.0
    y_true[13] = 2.0; y_pred[13] = 0.0
    y_true[14] = 2.0; y_pred[14] = 2.0

    let classes: ptr<f32> = array_new_f32(3)
    classes[0] = 0.0; classes[1] = 1.0; classes[2] = 2.0

    let prec: MultiClassMetric = multiclass_precision_ovr(y_true, y_pred, n, classes, 3)
    let rec: MultiClassMetric = multiclass_recall_ovr(y_true, y_pred, n, classes, 3)
    let f1: MultiClassMetric = multiclass_f1_ovr(y_true, y_pred, n, classes, 3)

    let prec_ovo: OvOResult = multiclass_precision_ovo(y_true, y_pred, n, classes, 3)

    if prec.macro_avg < 0.5 {
        println("  FAIL: macro precision should be > 0.5")
        return 1
    }

    if rec.macro_avg < 0.5 {
        println("  FAIL: macro recall should be > 0.5")
        return 1
    }

    if f1.macro_avg < 0.5 {
        println("  FAIL: macro F1 should be > 0.5")
        return 1
    }

    if prec_ovo.n_pairs != 3 {
        println("  FAIL: OvO should have 3 pairs for 3 classes")
        return 1
    }

    print("  OK: OvR macro precision = ")
    printf("%.4f", prec.macro_avg)
    print(", recall = ")
    printf("%.4f", rec.macro_avg)
    print(", F1 = ")
    printf("%.4f", f1.macro_avg)
    print(" | OvO avg precision = ")
    printf("%.4f", prec_ovo.avg)
    println("")

    multiclass_metric_free(prec)
    multiclass_metric_free(rec)
    multiclass_metric_free(f1)
    ovo_result_free(prec_ovo)
    array_free_f32(classes)
    array_free_f32(y_true)
    array_free_f32(y_pred)
    return 0
}

function test_silhouette() -> i32 {
    println("Test: silhouette_score")
    let X: Matrix = make_blobs()

    let km: KMeans = kmeans_fit(X, 3, 100, 1e-4, 42)
    let sil: f32 = silhouette_score(X, km.labels, X.rows)

    if sil < 0.3 {
        println("  FAIL: silhouette should be > 0.3 for well-separated blobs")
        return 1
    }

    print("  OK: silhouette = ")
    printf("%.4f", sil)
    println("")

    kmeans_free(km)
    matrix_free(X)
    return 0
}

function main() -> i32 {
    println("=== Extended Module Tests ===")
    println("")

    let mut failures: i32 = 0

    if test_minibatch_kmeans() != 0 { failures = failures + 1 }
    println("")
    if test_multinomial_nb() != 0 { failures = failures + 1 }
    println("")
    if test_bernoulli_nb() != 0 { failures = failures + 1 }
    println("")
    if test_ridge_classifier() != 0 { failures = failures + 1 }
    println("")
    if test_nearest_neighbors() != 0 { failures = failures + 1 }
    println("")
    if test_truncated_svd() != 0 { failures = failures + 1 }
    println("")
    if test_nmf() != 0 { failures = failures + 1 }
    println("")
    if test_multiclass_metrics() != 0 { failures = failures + 1 }
    println("")
    if test_silhouette() != 0 { failures = failures + 1 }

    println("")
    if failures == 0 {
        println("All extended module tests passed!")
        return 0
    }
    print("FAILED: ")
    print(failures)
    println(" tests")
    return 1
}
