# Regression test for the optimized DictionaryLearning.transform
# (issues #265 and #397).
#
# Checks exact hand-computed sparse codes, soft-threshold edge cases, a wider
# than n_features input, and parity against the original naive triple-loop
# formulation across several workload sizes.
#
# Parity comes in two grades because the implementation has two paths.
#
# Below the n * n_components * n_features work threshold the scalar kernel runs
# and parity is bit-exact, element for element.
#
# Above it the projection is one cblas_sgemm. BLAS reassociates the inner sums,
# so coefficient values can differ by a few f32 ulps from the scalar loop, and
# cross-BLAS bit identity is not a valid contract (PR #377). What matters for
# this estimator is the SPARSITY PATTERN, since a soft threshold against alpha
# turns a last-ulp difference into a discrete zero/non-zero change. So the gemm
# path is checked three ways:
#
#   1. the set of exactly-zero coefficients must match the reference element for
#      element, with no tolerance,
#   2. non-zero coefficients must agree to 1e-5 absolute and 1e-4 relative,
#      the tolerance PR #377 established,
#   3. the fixture itself must keep every coefficient at least 1e-5 away from
#      alpha. That margin is what makes check 1 safe on a BLAS this machine
#      cannot run: the largest drift any accumulation-order perturbation
#      produced on these shapes was 1.5e-6, so the fixture has at least a 7x
#      margin over it. If a future fixture edit drifts a coefficient onto the
#      threshold, check 3 fails and says so rather than letting check 1 turn
#      into a coin flip that depends on which BLAS built the binary.

import "lib/scikit/scikit.flow"

function opt_dl_tf_close(a: f32, b: f32, tolerance: f32) -> bool {
    let mut d: f32 = a - b
    if d < 0.0 { d = -d }
    return d <= tolerance
}

# The pre-optimization implementation, kept here as the parity reference.
function opt_dl_tf_reference(model: DictionaryLearning, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)

    for i in 0 to n {
        for c in 0 to model.n_components {
            let mut dot: f32 = 0.0
            for j in 0 to model.n_features {
                dot = dot + matrix_at(X, i, j) * model.dictionary[c][j]
            }
            if (fabs((dot) as f64) as f32) > model.alpha {
                if dot > 0 {
                    matrix_set(result, i, c, dot - model.alpha)
                } else {
                    matrix_set(result, i, c, dot + model.alpha)
                }
            } else {
                matrix_set(result, i, c, 0.0)
            }
        }
    }

    return result
}

function opt_dl_tf_make_model(n_features: i32, n_components: i32, alpha: f32) -> DictionaryLearning {
    let dictionary: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    for c in 0 to n_components {
        dictionary[c] = array_new_f32(n_features)
    }
    let model: DictionaryLearning = DictionaryLearning {
        dictionary: dictionary,
        n_components: n_components,
        n_features: n_features,
        alpha: alpha,
        n_iter: 1,
        fitted: true
    }
    return model
}

function opt_dl_tf_fill(X: Matrix, seed: i32) -> void {
    for i in 0 to X.rows {
        for j in 0 to X.cols {
            let s: i32 = (i * 37 + j * 17 + seed) % 211
            let v: f32 = ((s as f32) / 105.0) - 1.0
            matrix_set(X, i, j, v)
        }
    }
}

# Smallest distance any coefficient's raw projection sits from the threshold.
# If this is comfortably larger than the drift a BLAS can introduce, the
# sparsity pattern cannot depend on which BLAS is linked.
function opt_dl_tf_min_margin(model: DictionaryLearning, X: Matrix) -> f32 {
    let mut best: f32 = 1000000.0
    for i in 0 to X.rows {
        for c in 0 to model.n_components {
            let mut dot: f32 = 0.0
            for j in 0 to model.n_features {
                dot = dot + matrix_at(X, i, j) * model.dictionary[c][j]
            }
            let mut gap: f32 = (fabs((dot) as f64) as f32) - model.alpha
            if gap < 0.0 { gap = -gap }
            if gap < best { best = gap }
        }
    }
    return best
}

# Compare against the reference implementation. require_exact selects the
# below-threshold contract (bit-exact) or the gemm contract (identical sparsity
# pattern, values within tolerance, fixture clear of the threshold).
# Returns 0 on success, otherwise a code naming the check that failed.
function opt_dl_tf_parity(n: i32, p: i32, k: i32, alpha: f32, seed: i32, require_exact: bool) -> i32 {
    let X: Matrix = matrix_new(n, p)
    opt_dl_tf_fill(X, seed)

    let model: DictionaryLearning = opt_dl_tf_make_model(p, k, alpha)
    for c in 0 to k {
        let mut norm: f32 = 0.0
        for j in 0 to p {
            let s: i32 = (c * 53 + j * 29 + 7) % 197
            let v: f32 = ((s as f32) / 98.0) - 1.0
            model.dictionary[c][j] = v
            norm = norm + v * v
        }
        norm = sqrt((norm as f64)) as f32
        if norm > 0.0000000001 {
            for j in 0 to p { model.dictionary[c][j] = model.dictionary[c][j] / norm }
        }
    }

    let got: Matrix = dictionary_learning_transform(model, X)
    let want: Matrix = opt_dl_tf_reference(model, X)

    let mut code: i32 = 0
    if got.rows != want.rows || got.cols != want.cols { code = 1 }

    if code == 0 {
        for i in 0 to n {
            for c in 0 to k {
                let g: f32 = matrix_at(got, i, c)
                let w: f32 = matrix_at(want, i, c)
                # 2: sparsity pattern must match exactly, on both paths.
                if (g == 0.0) != (w == 0.0) { code = 2 }
                if require_exact {
                    # 3: below the work threshold the scalar kernel is unchanged.
                    if g != w { code = 3 }
                } else {
                    # 4: value tolerance, 1e-5 absolute plus 1e-4 relative.
                    let tol: f32 = 0.00001 + 0.0001 * (fabs((w) as f64) as f32)
                    if not opt_dl_tf_close(g, w, tol) { code = 4 }
                }
            }
        }
    }

    # 5: the fixture must not park a coefficient on the threshold, or check 2
    # would be asserting something the arithmetic cannot guarantee.
    if code == 0 {
        if opt_dl_tf_min_margin(model, X) <= 0.00001 { code = 5 }
    }

    matrix_free(got)
    matrix_free(want)
    dictionary_learning_free(model)
    matrix_free(X)
    return code
}

function main() -> i32 {
    # --- 1. Exact hand-computed sparse codes -------------------------------
    # alpha = 0.5, dictionary rows (1,0,0) and (0,1,0).
    let m1: DictionaryLearning = opt_dl_tf_make_model(3, 2, 0.5)
    m1.dictionary[0][0] = 1.0; m1.dictionary[0][1] = 0.0; m1.dictionary[0][2] = 0.0
    m1.dictionary[1][0] = 0.0; m1.dictionary[1][1] = 1.0; m1.dictionary[1][2] = 0.0

    let X1: Matrix = matrix_new(3, 3)
    # row 0: dot0 = 2.0 -> 1.5, dot1 = -3.0 -> -2.5
    matrix_set(X1, 0, 0, 2.0); matrix_set(X1, 0, 1, -3.0); matrix_set(X1, 0, 2, 9.0)
    # row 1: dot0 = 0.25 (below alpha) -> 0, dot1 = -0.25 -> 0
    matrix_set(X1, 1, 0, 0.25); matrix_set(X1, 1, 1, -0.25); matrix_set(X1, 1, 2, 1.0)
    # row 2: dot0 = 0.5 exactly at alpha -> 0 (strict >), dot1 = -0.5 -> 0
    matrix_set(X1, 2, 0, 0.5); matrix_set(X1, 2, 1, -0.5); matrix_set(X1, 2, 2, 0.0)

    let T1: Matrix = dictionary_learning_transform(m1, X1)
    if T1.rows != 3 || T1.cols != 2 {
        println("FAIL: transform output shape changed")
        return 1
    }
    if not opt_dl_tf_close(matrix_at(T1, 0, 0), 1.5, 0.000001) {
        println("FAIL: positive soft threshold row 0 component 0")
        return 1
    }
    if not opt_dl_tf_close(matrix_at(T1, 0, 1), -2.5, 0.000001) {
        println("FAIL: negative soft threshold row 0 component 1")
        return 1
    }
    if matrix_at(T1, 1, 0) != 0.0 || matrix_at(T1, 1, 1) != 0.0 {
        println("FAIL: sub-threshold codes must be exactly zero")
        return 1
    }
    if matrix_at(T1, 2, 0) != 0.0 || matrix_at(T1, 2, 1) != 0.0 {
        println("FAIL: code exactly at alpha must be zero (strict comparison)")
        return 1
    }
    matrix_free(T1)

    # --- 2. Single row and single component --------------------------------
    let X2: Matrix = matrix_new(1, 3)
    matrix_set(X2, 0, 0, 4.0); matrix_set(X2, 0, 1, 0.0); matrix_set(X2, 0, 2, 0.0)
    let T2: Matrix = dictionary_learning_transform(m1, X2)
    if T2.rows != 1 || T2.cols != 2 {
        println("FAIL: single-row shape")
        return 1
    }
    if not opt_dl_tf_close(matrix_at(T2, 0, 0), 3.5, 0.000001) {
        println("FAIL: single-row code")
        return 1
    }
    matrix_free(T2)
    matrix_free(X2)

    # --- 3. X has more columns than n_features -----------------------------
    # The dot product must still run over only the first n_features entries
    # of each row, with X.cols as the row stride.
    let X3: Matrix = matrix_new(2, 5)
    matrix_set(X3, 0, 0, 2.0); matrix_set(X3, 0, 1, -3.0); matrix_set(X3, 0, 2, 9.0)
    matrix_set(X3, 0, 3, 100.0); matrix_set(X3, 0, 4, 100.0)
    matrix_set(X3, 1, 0, 6.0); matrix_set(X3, 1, 1, 1.0); matrix_set(X3, 1, 2, 0.0)
    matrix_set(X3, 1, 3, 100.0); matrix_set(X3, 1, 4, 100.0)
    let T3: Matrix = dictionary_learning_transform(m1, X3)
    if not opt_dl_tf_close(matrix_at(T3, 0, 0), 1.5, 0.000001) {
        println("FAIL: wide-X stride handling row 0")
        return 1
    }
    if not opt_dl_tf_close(matrix_at(T3, 1, 0), 5.5, 0.000001) {
        println("FAIL: wide-X stride handling row 1")
        return 1
    }
    if not opt_dl_tf_close(matrix_at(T3, 1, 1), 0.5, 0.000001) {
        println("FAIL: wide-X stride handling row 1 component 1")
        return 1
    }
    matrix_free(T3)
    matrix_free(X3)
    matrix_free(X1)
    dictionary_learning_free(m1)

    # --- 4. Parity with the reference implementation -----------------------
    # The work threshold is n * n_components * n_features >= 65536.
    #
    # Below it, bit-exact. 100 * 4 * 8 = 3200.
    if opt_dl_tf_parity(100, 8, 4, 0.1, 3, true) != 0 {
        println("FAIL: parity mismatch on small workload")
        return 1
    }
    # 400 * 8 * 16 = 51200, still the scalar kernel, and alpha large enough
    # that most codes are thresholded to zero.
    if opt_dl_tf_parity(400, 16, 8, 0.9, 5, true) != 0 {
        println("FAIL: parity mismatch under heavy thresholding")
        return 1
    }
    # Above it, the gemm path: identical sparsity pattern, values within
    # tolerance, fixture clear of the threshold. 600 * 8 * 16 = 76800.
    if opt_dl_tf_parity(600, 16, 8, 0.1, 11, false) != 0 {
        println("FAIL: parity mismatch on realistic workload")
        return 1
    }
    # Wide features. 500 * 10 * 64 = 320000.
    if opt_dl_tf_parity(500, 64, 10, 0.05, 29, false) != 0 {
        println("FAIL: parity mismatch on wide-feature workload")
        return 1
    }
    # Larger projection. 1000 * 16 * 32 = 512000.
    if opt_dl_tf_parity(1000, 32, 16, 0.08, 13, false) != 0 {
        println("FAIL: parity mismatch on large workload")
        return 1
    }

    # --- 5. End-to-end with a fitted model ---------------------------------
    # 300 * 6 * 12 = 21600, below the threshold, so bit-exact.
    let X5: Matrix = matrix_new(300, 12)
    opt_dl_tf_fill(X5, 17)
    let fitted: DictionaryLearning = dictionary_learning_fit(X5, 6, 0.1, 5, 0.0001, 42)
    let got5: Matrix = dictionary_learning_transform(fitted, X5)
    let want5: Matrix = opt_dl_tf_reference(fitted, X5)
    for i in 0 to 300 {
        for c in 0 to 6 {
            if matrix_at(got5, i, c) != matrix_at(want5, i, c) {
                println("FAIL: parity mismatch on fitted model")
                return 1
            }
        }
    }
    matrix_free(got5)
    matrix_free(want5)
    dictionary_learning_free(fitted)
    matrix_free(X5)

    # --- 6. End-to-end with a fitted model on the gemm path ----------------
    # 800 * 10 * 20 = 160000. n_zero_coefs is the reported quantity, so the
    # count and the pattern behind it are both asserted.
    let X6: Matrix = matrix_new(800, 20)
    opt_dl_tf_fill(X6, 23)
    let fitted6: DictionaryLearning = dictionary_learning_fit(X6, 10, 0.05, 5, 0.0001, 42)
    let got6: Matrix = dictionary_learning_transform(fitted6, X6)
    let want6: Matrix = opt_dl_tf_reference(fitted6, X6)
    let mut zeros_got: i32 = 0
    let mut zeros_want: i32 = 0
    for i in 0 to 800 {
        for c in 0 to 10 {
            let g: f32 = matrix_at(got6, i, c)
            let w: f32 = matrix_at(want6, i, c)
            if g == 0.0 { zeros_got = zeros_got + 1 }
            if w == 0.0 { zeros_want = zeros_want + 1 }
            if (g == 0.0) != (w == 0.0) {
                println("FAIL: sparsity pattern differs on fitted model, gemm path")
                return 1
            }
            let tol6: f32 = 0.00001 + 0.0001 * (fabs((w) as f64) as f32)
            if not opt_dl_tf_close(g, w, tol6) {
                println("FAIL: coefficient value out of tolerance on fitted model")
                return 1
            }
        }
    }
    if zeros_got != zeros_want {
        println("FAIL: n_zero_coefs differs on fitted model, gemm path")
        return 1
    }
    if opt_dl_tf_min_margin(fitted6, X6) <= 0.00001 {
        println("FAIL: fitted fixture parks a coefficient on the alpha threshold")
        return 1
    }
    matrix_free(got6)
    matrix_free(want6)
    dictionary_learning_free(fitted6)
    matrix_free(X6)

    println("PASS: DictionaryLearning.transform optimization")
    return 0
}
