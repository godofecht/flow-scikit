# Tests for SVM, multi-class logistic, gradient boosting, DBSCAN, and extended metrics.
# Run: ./flow run tests/test_advanced_estimators.flow

import "lib/scikit/scikit.flow"

function _noise(seed: i32) -> f32 {
    let s: i32 = seed * 1103515245 + 12345
    let n: i32 = ((s % 100) + 100) % 100
    return ((n as f32) / 100.0 - 0.5) * 0.3
}

function make_binary_data() -> Dataset {
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to 20 {
        matrix_set(X, i, 0, 2.0 + _noise(i))
        matrix_set(X, i, 1, 2.0 + _noise(i + 100))
        y[i] = 0.0
    }
    for i in 0 to 20 {
        matrix_set(X, 20 + i, 0, -2.0 + _noise(i + 200))
        matrix_set(X, 20 + i, 1, -2.0 + _noise(i + 300))
        y[20 + i] = 1.0
    }

    return Dataset { X: X, y: y, n_samples: n, n_features: 2, n_classes: 2, is_classification: true }
}

function make_multiclass_data() -> Dataset {
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)

    for i in 0 to 10 {
        matrix_set(X, i, 0, 3.0 + _noise(i))
        matrix_set(X, i, 1, 3.0 + _noise(i + 50))
        y[i] = 0.0
    }
    for i in 0 to 10 {
        matrix_set(X, 10 + i, 0, -3.0 + _noise(i + 200))
        matrix_set(X, 10 + i, 1, 3.0 + _noise(i + 250))
        y[10 + i] = 1.0
    }
    for i in 0 to 10 {
        matrix_set(X, 20 + i, 0, 0.0 + _noise(i + 400))
        matrix_set(X, 20 + i, 1, -3.0 + _noise(i + 450))
        y[20 + i] = 2.0
    }

    return Dataset { X: X, y: y, n_samples: n, n_features: 2, n_classes: 3, is_classification: true }
}

function test_linear_svc() -> i32 {
    println("Test: LinearSVC")
    let data: Dataset = make_binary_data()

    let svc: LinearSVC = linear_svc_fit(data.X, data.y, 2, 1.0, 300, 0.01)
    let scores: ptr<f32> = linear_svc_predict(svc, data.X)
    let preds: ptr<f32> = linear_svc_decide(svc, scores, data.n_samples)

    let acc: f32 = accuracy_score(data.y, preds, data.n_samples)
    if acc < 0.8 {
        println("  FAIL: LinearSVC accuracy should be > 0.8")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    linear_svc_free(svc)
    array_free_f32(scores)
    array_free_f32(preds)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_kernel_svc() -> i32 {
    println("Test: KernelSVC (RBF)")
    let data: Dataset = make_binary_data()

    let svc: KernelSVC = kernel_svc_fit(data.X, data.y, 2, 1.0, 0.5, 50)
    let scores: ptr<f32> = kernel_svc_predict(svc, data.X)
    let preds: ptr<f32> = kernel_svc_decide(svc, scores, data.n_samples)

    let acc: f32 = accuracy_score(data.y, preds, data.n_samples)
    if acc < 0.7 {
        println("  FAIL: KernelSVC accuracy should be > 0.7")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    kernel_svc_free(svc)
    array_free_f32(scores)
    array_free_f32(preds)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_linear_svr() -> i32 {
    println("Test: LinearSVR")
    let X: Matrix = matrix_new(15, 1)
    let y: ptr<f32> = array_new_f32(15)
    for i in 0 to 15 {
        let x: f32 = (i as f32) * 0.5
        matrix_set(X, i, 0, x)
        y[i] = 3.0 * x + 2.0
    }

    let svr: LinearSVR = linear_svr_fit(X, y, 1.0, 0.1, 500, 0.001)
    let preds: ptr<f32> = linear_svr_predict(svr, X)
    let r2: f32 = r2_score(y, preds, 15)

    if r2 < 0.9 {
        println("  FAIL: LinearSVR R2 should be > 0.9")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    linear_svr_free(svr)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_multiclass_logistic() -> i32 {
    println("Test: MultiClassLogisticRegression")
    let data: Dataset = make_multiclass_data()

    let model: MultiClassLogisticRegression = multiclass_logistic_fit(data.X, data.y, 3, 500, 0.1, penalty_l2(0.01))
    let probs: Matrix = multiclass_logistic_predict(model, data.X)
    let preds: ptr<f32> = multiclass_logistic_decide(model, probs)

    let acc: f32 = accuracy_score(data.y, preds, data.n_samples)
    if acc < 0.7 {
        println("  FAIL: MultiClassLogistic accuracy should be > 0.7")
        return 1
    }

    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")

    multiclass_logistic_free(model)
    matrix_free(probs)
    array_free_f32(preds)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

