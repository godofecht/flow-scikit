# Regression test for the BaggingClassifier.fit optimization
# (roadmap rank 25, issue #234).
#
# The optimization only moves allocations out of the estimator loop and
# replaces per-element accessor pairs with a row-major memcpy. It must not
# touch the random draw order or the bootstrap sampling scheme, so the fitted
# ensemble has to be identical for a given seed. This test proves that by
# comparing the two fits node by node, not just by comparing accuracy.
#
# Per issue #359 the tree builder leaves some TreeNode fields unwritten
# depending on the node kind: a leaf never writes feature or threshold, and an
# internal node never writes value. Those fields hold whatever malloc handed
# back, so they differ run to run on main alone. The comparison below skips
# them for the kind that does not write them.

import "lib/scikit/scikit.flow"

extern {
    function timespec_get(ts: ptr<i64>, base: i32) -> i32
    function printf(fmt: string, ...) -> i32
}

const BCF_TIME_UTC: i32 = 1

function bcf_now_ns() -> i64 {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    timespec_get(ts, BCF_TIME_UTC)
    let value: i64 = ts[0] * 1000000000 + ts[1]
    free(ts as ptr<void>)
    return value
}

# Pre-#234 reference implementation, kept only for A/B parity and timing.
function bcf_reference_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_estimators: i32, max_depth: i32, seed: i32) -> BaggingClassifier {
    let classes: ptr<f32> = array_new_f32(n_classes)
    let mut n_found: i32 = 0
    for i in 0 to X.rows {
        let mut found: bool = false
        for k in 0 to n_found {
            if classes[k] == y[i] {
                found = true
            }
        }
        if not found {
            classes[n_found] = y[i]
            n_found = n_found + 1
        }
    }

    let trees: ptr<DecisionTreeClassifier> = malloc((n_estimators as i64) * 128) as ptr<DecisionTreeClassifier>
    srand(seed)

    for t in 0 to n_estimators {
        let n_samples: i32 = X.rows
        let indices: ptr<i32> = malloc((n_samples as i64) * 4) as ptr<i32>
        for i in 0 to n_samples {
            indices[i] = rand() % n_samples
        }

        let X_boot: Matrix = matrix_new(n_samples, X.cols)
        let y_boot: ptr<f32> = array_new_f32(n_samples)
        for i in 0 to n_samples {
            y_boot[i] = y[indices[i]]
            for j in 0 to X.cols {
                matrix_set(X_boot, i, j, matrix_at(X, indices[i], j))
            }
        }

        trees[t] = decision_tree_classifier_fit(X_boot, y_boot, n_classes, max_depth, CRITERION_GINI)

        free(indices as ptr<void>)
        matrix_free(X_boot)
        array_free_f32(y_boot)
    }

    let out: BaggingClassifier = BaggingClassifier {
        trees: trees,
        n_estimators: n_estimators,
        n_classes: n_classes,
        classes: classes,
        max_depth: max_depth,
        fitted: true
    }
    return out
}

# Element-wise comparison of two fitted ensembles, skipping the TreeNode
# fields the builder never writes for that node kind (issue #359).
function bcf_same_ensemble(a: BaggingClassifier, b: BaggingClassifier) -> bool {
    if a.n_estimators != b.n_estimators { return false }
    if a.n_classes != b.n_classes { return false }
    for c in 0 to a.n_classes {
        if a.classes[c] != b.classes[c] { return false }
    }
    for t in 0 to a.n_estimators {
        let ta: DecisionTreeClassifier = a.trees[t]
        let tb: DecisionTreeClassifier = b.trees[t]
        if ta.n_nodes != tb.n_nodes { return false }
        if ta.n_classes != tb.n_classes { return false }
        if ta.max_depth != tb.max_depth { return false }
        if ta.criterion != tb.criterion { return false }
        for c in 0 to ta.n_classes {
            if ta.classes[c] != tb.classes[c] { return false }
        }
        for k in 0 to ta.n_nodes {
            let na: ptr<TreeNode> = ta.nodes + k
            let nb: ptr<TreeNode> = tb.nodes + k
            if na.is_leaf != nb.is_leaf { return false }
            if na.n_samples != nb.n_samples { return false }
            if na.impurity != nb.impurity { return false }
            if na.left != nb.left { return false }
            if na.right != nb.right { return false }
            if na.is_leaf {
                # feature and threshold are never written for a leaf
                if na.value != nb.value { return false }
            } else {
                # value is never written for an internal node
                if na.feature != nb.feature { return false }
                if na.threshold != nb.threshold { return false }
            }
        }
    }
    return true
}

function bcf_same_preds(a: ptr<f32>, b: ptr<f32>, n: i32) -> bool {
    for i in 0 to n {
        if a[i] != b[i] { return false }
    }
    return true
}

function bcf_accuracy(preds: ptr<f32>, y: ptr<f32>, n: i32) -> f32 {
    let mut hits: i32 = 0
    for i in 0 to n {
        if preds[i] == y[i] { hits = hits + 1 }
    }
    return (hits as f32) / (n as f32)
}

function bcf_check_case(X: Matrix, y: ptr<f32>, n_classes: i32, n_estimators: i32, max_depth: i32, seed: i32, label: string) -> i32 {
    let reference: BaggingClassifier = bcf_reference_fit(X, y, n_classes, n_estimators, max_depth, seed)
    let optimized: BaggingClassifier = bagging_classifier_fit(X, y, n_classes, n_estimators, max_depth, seed)

    if not bcf_same_ensemble(reference, optimized) {
        print("FAIL: fitted ensemble differs for ")
        println(label)
        return 1
    }

    let p_ref: ptr<f32> = bagging_classifier_predict(reference, X)
    let p_opt: ptr<f32> = bagging_classifier_predict(optimized, X)
    if not bcf_same_preds(p_ref, p_opt, X.rows) {
        print("FAIL: predictions differ for ")
        println(label)
        return 1
    }
    array_free_f32(p_ref)
    array_free_f32(p_opt)

    bagging_classifier_free(reference)
    bagging_classifier_free(optimized)
    return 0
}

function main() -> i32 {
    # ---------------------------------------------------------------
    # 1. Realistic workload: digits, 10 estimators, depth 8, seed 42.
    # ---------------------------------------------------------------
    let digits: Dataset = load_digits()
    let reference: BaggingClassifier = bcf_reference_fit(digits.X, digits.y, 10, 10, 8, 42)
    let optimized: BaggingClassifier = bagging_classifier_fit(digits.X, digits.y, 10, 10, 8, 42)

    if not bcf_same_ensemble(reference, optimized) {
        println("FAIL: digits ensemble is not identical for seed 42")
        return 1
    }

    let p_ref: ptr<f32> = bagging_classifier_predict(reference, digits.X)
    let p_opt: ptr<f32> = bagging_classifier_predict(optimized, digits.X)
    if not bcf_same_preds(p_ref, p_opt, digits.X.rows) {
        println("FAIL: digits predictions diverged")
        return 1
    }
    let acc: f32 = bcf_accuracy(p_opt, digits.y, digits.X.rows)
    if acc < 0.9 {
        println("FAIL: digits training accuracy collapsed")
        return 1
    }
    printf("BaggingClassifier fit digits: train accuracy=%.6f trees=%d\n", acc as f64, optimized.n_estimators)
    array_free_f32(p_ref)
    array_free_f32(p_opt)
    bagging_classifier_free(reference)
    bagging_classifier_free(optimized)

    # ---------------------------------------------------------------
    # 2. A/B timing on the digits workload.
    # ---------------------------------------------------------------
    let repeats: i32 = 3
    let start_reference: i64 = bcf_now_ns()
    for r in 0 to repeats {
        let m: BaggingClassifier = bcf_reference_fit(digits.X, digits.y, 10, 10, 8, 42)
        bagging_classifier_free(m)
    }
    let end_reference: i64 = bcf_now_ns()

    let start_optimized: i64 = bcf_now_ns()
    for r in 0 to repeats {
        let m: BaggingClassifier = bagging_classifier_fit(digits.X, digits.y, 10, 10, 8, 42)
        bagging_classifier_free(m)
    }
    let end_optimized: i64 = bcf_now_ns()

    let reference_ms: f64 = ((end_reference - start_reference) as f64) / 1000000.0 / (repeats as f64)
    let optimized_ms: f64 = ((end_optimized - start_optimized) as f64) / 1000000.0 / (repeats as f64)
    printf("BaggingClassifier fit A/B (digits): reference=%.3f ms optimized=%.3f ms speedup=%.3fx\n", reference_ms, optimized_ms, reference_ms / optimized_ms)

    # ---------------------------------------------------------------
    # 3. Edge cases.
    # ---------------------------------------------------------------
    let small_X: Matrix = matrix_new(20, 4)
    let small_y: ptr<f32> = array_new_f32(20)
    for i in 0 to 20 {
        let cls: i32 = i % 3
        small_y[i] = cls as f32
        matrix_set(small_X, i, 0, (cls as f32) * 5.0 + (i as f32) * 0.1)
        matrix_set(small_X, i, 1, (i as f32) * 0.25)
        matrix_set(small_X, i, 2, 3.0)
        matrix_set(small_X, i, 3, ((i % 2) as f32) * -1.0)
    }

    # a single estimator
    if bcf_check_case(small_X, small_y, 3, 1, 4, 7, "single estimator") != 0 { return 1 }
    # depth 0, so every tree is a single leaf
    if bcf_check_case(small_X, small_y, 3, 5, 0, 3, "depth 0") != 0 { return 1 }
    # more estimators than rows
    if bcf_check_case(small_X, small_y, 3, 30, 3, 9, "30 estimators") != 0 { return 1 }
    # n_classes declared larger than the data contains
    if bcf_check_case(small_X, small_y, 5, 6, 4, 13, "padded n_classes") != 0 { return 1 }
    # a different seed must still agree between the two fits
    if bcf_check_case(small_X, small_y, 3, 6, 4, 12345, "seed 12345") != 0 { return 1 }

    # a single-row training set, the smallest bootstrap the loop can draw
    let one_X: Matrix = matrix_new(1, 4)
    let one_y: ptr<f32> = array_new_f32(1)
    for j in 0 to 4 { matrix_set(one_X, 0, j, matrix_at(small_X, 0, j)) }
    one_y[0] = small_y[0]
    if bcf_check_case(one_X, one_y, 3, 4, 4, 21, "single training row") != 0 { return 1 }
    matrix_free(one_X)
    array_free_f32(one_y)

    # a degenerate single-class training set
    let flat_y: ptr<f32> = array_new_f32(20)
    for i in 0 to 20 { flat_y[i] = 2.0 }
    if bcf_check_case(small_X, flat_y, 1, 6, 4, 11, "single class") != 0 { return 1 }
    array_free_f32(flat_y)

    matrix_free(small_X)
    array_free_f32(small_y)

    println("PASS: test_opt_baggingclassifier_fit")
    return 0
}
