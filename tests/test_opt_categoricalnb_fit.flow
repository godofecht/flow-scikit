import "lib/scikit/scikit.flow"

extern {
    function timespec_get(ts: ptr<i64>, base: i32) -> i32
    function log(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

const TIME_UTC: i32 = 1

function catfit_now_ns() -> i64 {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    timespec_get(ts, TIME_UTC)
    let value: i64 = ts[0] * 1000000000 + ts[1]
    free(ts as ptr<void>)
    return value
}

# Verbatim copy of the pre-optimization categorical_nb_fit from origin/main.
# Kept so the A/B timing and the parity check run against real reference state.
function catfit_reference_fit(X: Matrix, y: ptr<f32>, n_classes: i32, n_categories: ptr<i32>, alpha: f32) -> CategoricalNB {
    let n: i32 = X.rows
    let p: i32 = X.cols

    let classes: ptr<f32> = array_new_f32(n_classes)
    let class_log_prior: ptr<f32> = array_new_f32(n_classes)
    for c in 0 to n_classes {
        classes[c] = c as f32
        let mut count: i32 = 0
        for i in 0 to n {
            if y[i] as i32 == c {
                count = count + 1
            }
        }
        if count > 0 {
            class_log_prior[c] = log((count as f64) as f32 as f64) as f32
        } else {
            class_log_prior[c] = -10000000000.0
        }
    }

    let category_log_prob: ptr<ptr<ptr<f32> > > = malloc((p as i64) * 8) as ptr<ptr<ptr<f32> > >
    for j in 0 to p {
        category_log_prob[j] = malloc((n_classes as i64) * 8) as ptr<ptr<f32> >
        for c in 0 to n_classes {
            let nc: i32 = n_categories[j]
            category_log_prob[j][c] = array_new_f32(nc)
            let counts: ptr<i32> = malloc((nc as i64) * 4) as ptr<i32>
            for cat in 0 to nc {
                counts[cat] = 0
            }
            let mut total: i32 = 0
            for i in 0 to n {
                if y[i] as i32 == c {
                    let cat: i32 = matrix_at(X, i, j) as i32
                    if cat >= 0 && cat < nc {
                        counts[cat] = counts[cat] + 1
                        total = total + 1
                    }
                }
            }
            for cat in 0 to nc {
                let smoothed: f32 = (counts[cat] as f32) + alpha
                let denom: f32 = (total as f32) + alpha * (nc as f32)
                if denom > 0 {
                    category_log_prob[j][c][cat] = log((smoothed / denom) as f64) as f32
                } else {
                    category_log_prob[j][c][cat] = 0.0
                }
            }
            free(counts as ptr<void>)
        }
    }

    return CategoricalNB {
        category_log_prob: category_log_prob,
        n_categories: n_categories,
        classes: classes,
        class_log_prior: class_log_prior,
        n_classes: n_classes,
        n_features: p,
        alpha: alpha,
        fitted: true
    }
}

# Every fitted number must match bit for bit; the change only reorders how the
# integer counts are gathered.
function catfit_compare(reference: CategoricalNB, optimized: CategoricalNB) -> i32 {
    let mut status: i32 = 0
    if reference.n_classes != optimized.n_classes {
        println("FAIL: CategoricalNB fit n_classes changed")
        return 1
    }
    if reference.n_features != optimized.n_features {
        println("FAIL: CategoricalNB fit n_features changed")
        return 1
    }
    for c in 0 to reference.n_classes {
        if reference.classes[c] != optimized.classes[c] {
            println("FAIL: CategoricalNB fit classes changed")
            status = 1
        }
        if reference.class_log_prior[c] != optimized.class_log_prior[c] {
            println("FAIL: CategoricalNB fit class_log_prior changed")
            status = 1
        }
    }
    for j in 0 to reference.n_features {
        for c in 0 to reference.n_classes {
            for cat in 0 to reference.n_categories[j] {
                if reference.category_log_prob[j][c][cat] != optimized.category_log_prob[j][c][cat] {
                    println("FAIL: CategoricalNB fit category_log_prob changed")
                    status = 1
                }
            }
        }
    }
    return status
}

function catfit_close(a: f32, b: f32) -> bool {
    let mut d: f32 = a - b
    if d < 0.0 {
        d = -d
    }
    return d < 0.00001
}

function catfit_check_known_values() -> i32 {
    # Six samples, three categorical features with three levels each, two
    # classes, alpha = 1.  Expected values were derived independently from the
    # CategoricalNB definition.
    let train: Matrix = matrix_new(6, 3)
    matrix_set(train, 0, 0, 0.0)
    matrix_set(train, 0, 1, 1.0)
    matrix_set(train, 0, 2, 2.0)
    matrix_set(train, 1, 0, 0.0)
    matrix_set(train, 1, 1, 2.0)
    matrix_set(train, 1, 2, 1.0)
    matrix_set(train, 2, 0, 1.0)
    matrix_set(train, 2, 1, 0.0)
    matrix_set(train, 2, 2, 0.0)
    matrix_set(train, 3, 0, 2.0)
    matrix_set(train, 3, 1, 0.0)
    matrix_set(train, 3, 2, 1.0)
    matrix_set(train, 4, 0, 0.0)
    matrix_set(train, 4, 1, 1.0)
    matrix_set(train, 4, 2, 2.0)
    matrix_set(train, 5, 0, 1.0)
    matrix_set(train, 5, 1, 2.0)
    matrix_set(train, 5, 2, 0.0)

    let labels: ptr<f32> = array_new_f32(6)
    labels[0] = 0.0
    labels[1] = 0.0
    labels[2] = 1.0
    labels[3] = 1.0
    labels[4] = 0.0
    labels[5] = 1.0

    let n_categories: ptr<i32> = malloc(3 * 4) as ptr<i32>
    n_categories[0] = 3
    n_categories[1] = 3
    n_categories[2] = 3

    let model: CategoricalNB = categorical_nb_fit(train, labels, 2, n_categories, 1.0)
    let mut status: i32 = 0

    if not catfit_close(model.class_log_prior[0], 1.0986123) {
        println("FAIL: CategoricalNB class_log_prior[0]")
        status = 1
    }
    if not catfit_close(model.class_log_prior[1], 1.0986123) {
        println("FAIL: CategoricalNB class_log_prior[1]")
        status = 1
    }
    # Feature 0, class 0: category counts (3, 0, 0) over total 3, alpha 1.
    if not catfit_close(model.category_log_prob[0][0][0], -0.40546507) {
        println("FAIL: CategoricalNB category_log_prob[0][0][0]")
        status = 1
    }
    if not catfit_close(model.category_log_prob[0][0][1], -1.7917595) {
        println("FAIL: CategoricalNB category_log_prob[0][0][1]")
        status = 1
    }
    if not catfit_close(model.category_log_prob[0][0][2], -1.7917595) {
        println("FAIL: CategoricalNB category_log_prob[0][0][2]")
        status = 1
    }
    # Feature 2, class 1: category counts (2, 1, 0) over total 3.
    if not catfit_close(model.category_log_prob[2][1][0], -0.6931472) {
        println("FAIL: CategoricalNB category_log_prob[2][1][0]")
        status = 1
    }
    if not catfit_close(model.category_log_prob[2][1][1], -1.0986123) {
        println("FAIL: CategoricalNB category_log_prob[2][1][1]")
        status = 1
    }
    if not catfit_close(model.category_log_prob[2][1][2], -1.7917595) {
        println("FAIL: CategoricalNB category_log_prob[2][1][2]")
        status = 1
    }

    let reference: CategoricalNB = catfit_reference_fit(train, labels, 2, n_categories, 1.0)
    if catfit_compare(reference, model) != 0 {
        status = 1
    }

    categorical_nb_free(reference)
    categorical_nb_free(model)
    matrix_free(train)
    array_free_f32(labels)
    free(n_categories as ptr<void>)
    return status
}

function catfit_check_edge_cases() -> i32 {
    # An empty class, a category level that never occurs, and out-of-range
    # category codes that must be ignored by both implementations.
    let train: Matrix = matrix_new(4, 2)
    matrix_set(train, 0, 0, 0.0)
    matrix_set(train, 0, 1, 9.0)
    matrix_set(train, 1, 0, 1.0)
    matrix_set(train, 1, 1, 0.0)
    matrix_set(train, 2, 0, 0.0)
    matrix_set(train, 2, 1, 1.0)
    matrix_set(train, 3, 0, 1.0)
    matrix_set(train, 3, 1, 0.0)

    let labels: ptr<f32> = array_new_f32(4)
    labels[0] = 0.0
    labels[1] = 0.0
    labels[2] = 1.0
    labels[3] = 1.0

    let n_categories: ptr<i32> = malloc(2 * 4) as ptr<i32>
    n_categories[0] = 4
    n_categories[1] = 2

    # Three classes declared, only two present: class 2 must stay at the
    # sentinel prior.
    let model: CategoricalNB = categorical_nb_fit(train, labels, 3, n_categories, 1.0)
    let reference: CategoricalNB = catfit_reference_fit(train, labels, 3, n_categories, 1.0)

    let mut status: i32 = catfit_compare(reference, model)
    if model.class_log_prior[2] != -10000000000.0 {
        println("FAIL: CategoricalNB empty class prior sentinel")
        status = 1
    }

    categorical_nb_free(reference)
    categorical_nb_free(model)
    matrix_free(train)
    array_free_f32(labels)
    free(n_categories as ptr<void>)
    return status
}

function main() -> i32 {
    let mut status: i32 = 0
    status = status + catfit_check_known_values()
    status = status + catfit_check_edge_cases()
    if status != 0 {
        return 1
    }

    let n: i32 = 2000
    let p: i32 = 32
    let n_classes: i32 = 8
    let levels: i32 = 6
    let repeats: i32 = 5

    let train: Matrix = matrix_new(n, p)
    let labels: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        labels[i] = (i % n_classes) as f32
        for j in 0 to p {
            let level: i32 = (i * 37 + j * 19) % levels
            matrix_set(train, i, j, level as f32)
        }
    }

    let n_categories: ptr<i32> = malloc((p as i64) * 4) as ptr<i32>
    for j in 0 to p {
        n_categories[j] = levels
    }

    # Element-wise parity on the realistic workload before any timing.
    let reference_once: CategoricalNB = catfit_reference_fit(train, labels, n_classes, n_categories, 1.0)
    let optimized_once: CategoricalNB = categorical_nb_fit(train, labels, n_classes, n_categories, 1.0)
    if catfit_compare(reference_once, optimized_once) != 0 {
        return 1
    }
    categorical_nb_free(reference_once)
    categorical_nb_free(optimized_once)

    # Warm both paths so the timed loops measure steady state, not first touch.
    for r in 0 to 2 {
        let warm_reference: CategoricalNB = catfit_reference_fit(train, labels, n_classes, n_categories, 1.0)
        categorical_nb_free(warm_reference)
        let warm_optimized: CategoricalNB = categorical_nb_fit(train, labels, n_classes, n_categories, 1.0)
        categorical_nb_free(warm_optimized)
    }

    # Interleave the two paths so scheduler drift over the run hits both equally.
    let mut reference_ns: i64 = 0
    let mut optimized_ns: i64 = 0
    for r in 0 to repeats {
        let t0: i64 = catfit_now_ns()
        let reference_model: CategoricalNB = catfit_reference_fit(train, labels, n_classes, n_categories, 1.0)
        let t1: i64 = catfit_now_ns()
        categorical_nb_free(reference_model)

        let t2: i64 = catfit_now_ns()
        let optimized_model: CategoricalNB = categorical_nb_fit(train, labels, n_classes, n_categories, 1.0)
        let t3: i64 = catfit_now_ns()
        categorical_nb_free(optimized_model)

        reference_ns = reference_ns + (t1 - t0)
        optimized_ns = optimized_ns + (t3 - t2)
    }

    let reference_ms: f64 = (reference_ns as f64) / 1000000.0
    let optimized_ms: f64 = (optimized_ns as f64) / 1000000.0
    printf("CategoricalNB fit A/B: reference=%.6f ms optimized=%.6f ms speedup=%.3fx\n", reference_ms, optimized_ms, reference_ms / optimized_ms)

    matrix_free(train)
    array_free_f32(labels)
    free(n_categories as ptr<void>)

    println("OK: CategoricalNB fit reproduces reference learned state")
    return 0
}
