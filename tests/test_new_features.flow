        matrix_set(Y, i, 0, 2.0 * x0 + 1.0 * x1)
        matrix_set(Y, i, 1, 1.0 * x0 + 3.0 * x2)
    }

    let model: MultiTaskElasticNet = multitask_elastic_net_fit(X, Y, 0.01, 0.5, 200, 0.01)
    let preds: Matrix = multitask_elastic_net_predict(model, X)

    let mut ss_res: f32 = 0.0
