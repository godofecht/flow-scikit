            ss_res = ss_res + d * d
            let dm: f32 = matrix_at(Y, i, o) - 5.0
            ss_tot = ss_tot + dm * dm
        }
    }
    let r2: f32 = 1.0 - ss_res / ss_tot

    if r2 < 0.8 {
        println("  FAIL: MultiTaskElasticNet R2 should be > 0.8")
