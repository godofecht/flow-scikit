    println("")
    hist_gradient_boosting_regressor_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_target_encoder() -> i32 {
    println("Test: TargetEncoder")
    let n: i32 = 10
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    # Category 0 in col 0 maps to y=1, category 1 maps to y=10
    let mut i: i32 = 0
    while i < 5 {
        matrix_set(X, i, 0, 0.0)
        matrix_set(X, i, 1, 1.0)
        y[i] = 1.0
        i = i + 1
    }
    while i < 10 {
        matrix_set(X, i, 0, 1.0)
        matrix_set(X, i, 1, 2.0)
        y[i] = 10.0
        i = i + 1
    }

    let model: TargetEncoder = target_encoder_fit(X, y, n, 1.0)
    let transformed: Matrix = target_encoder_transform(model, X)

    # Category 0 should encode to ~1, category 1 to ~10
    let enc0: f32 = matrix_at(transformed, 0, 0)
    let enc1: f32 = matrix_at(transformed, 5, 0)

    if enc0 > 3.0 || enc1 < 7.0 {
        println("  FAIL: TargetEncoder encodings wrong")
        print("  enc0 = ")
        printf("%.4f", enc0)
        print("  enc1 = ")
        printf("%.4f", enc1)
        println("")
        return 1
    }
    print("  OK: enc0 = ")
    printf("%.4f", enc0)
    print(", enc1 = ")
    printf("%.4f", enc1)
    println("")
    target_encoder_free(model)
    matrix_free(transformed)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_export_graphviz() -> i32 {
    println("Test: export_graphviz")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < 10 {
        matrix_set(X, i, 0, 1.0 + (i as f32) * 0.1)
        matrix_set(X, i, 1, 2.0 + (i as f32) * 0.1)
        y[i] = 0.0
        i = i + 1
    }
    while i < 20 {
        matrix_set(X, i, 0, 5.0 + ((i - 10) as f32) * 0.1)
        matrix_set(X, i, 1, 6.0 + ((i - 10) as f32) * 0.1)
        y[i] = 1.0
        i = i + 1
    }

    let model: DecisionTreeClassifier = decision_tree_classifier_fit(X, y, 2, 3, CRITERION_GINI)
    println("  DOT output:")
    export_graphviz(model)

    decision_tree_classifier_free(model)
    matrix_free(X)
    array_free_f32(y)
    println("  OK: graphviz exported")
    return 0
}

function test_average_precision_score() -> i32 {
    println("Test: average_precision_score")
    let y_true: ptr<f32> = array_new_f32(5)
    let y_score: ptr<f32> = array_new_f32(5)
    y_true[0] = 0.0; y_true[1] = 1.0; y_true[2] = 0.0; y_true[3] = 1.0; y_true[4] = 1.0
    y_score[0] = 0.1; y_score[1] = 0.9; y_score[2] = 0.2; y_score[3] = 0.8; y_score[4] = 0.7

    let ap: f32 = average_precision_score(y_true, y_score, 5, 1.0)

    if ap < 0.9 {
        println("  FAIL: AP should be > 0.9 for good ranking")
        return 1
    }
    print("  OK: AP = ")
    printf("%.4f", ap)
    println("")
    array_free_f32(y_true)
    array_free_f32(y_score)
    return 0
}

