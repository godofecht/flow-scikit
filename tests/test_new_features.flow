    print(", JL(1000, 0.05) = ")
    print(dim2)
    println("")
    return 0
}

function test_missing_indicator() -> i32 {
    println("Test: MissingIndicator")
    let X: Matrix = matrix_new(4, 3)
    matrix_set(X, 0, 0, 1.0); matrix_set(X, 0, 1, 2.0); matrix_set(X, 0, 2, -999999.0)
    matrix_set(X, 1, 0, -999999.0); matrix_set(X, 1, 1, 5.0); matrix_set(X, 1, 2, 6.0)
    matrix_set(X, 2, 0, 7.0); matrix_set(X, 2, 1, -999999.0); matrix_set(X, 2, 2, 9.0)
    matrix_set(X, 3, 0, 10.0); matrix_set(X, 3, 1, 11.0); matrix_set(X, 3, 2, 12.0)

    let mi: MissingIndicator = missing_indicator_fit(X, -999999.0, MISSING_FEATURES_ALL)
    let indicator: Matrix = missing_indicator_transform(mi, X)

    let mut count: i32 = 0
    let mut i: i32 = 0
    while i < 4 {
        let mut j: i32 = 0
        while j < 3 {
            if matrix_at(indicator, i, j) > 0.5 { count = count + 1 }
            j = j + 1
        }
        i = i + 1
    }

    if count != 3 {
        println("  FAIL: expected 3 missing values, got")
        print(count)
        missing_indicator_free(mi)
        matrix_free(indicator)
        matrix_free(X)
        return 1
    }

    println("  OK: 3 missing values detected")
    missing_indicator_free(mi)
    matrix_free(indicator)
    matrix_free(X)
    return 0
}

function test_voting_regressor() -> i32 {
    println("Test: VotingRegressor")
    let data: Dataset = make_regression(50, 3, 3, 0.5, 1.0, 42)

    let estimators: ptr<DecisionTreeRegressor> = malloc(2 * 128) as ptr<DecisionTreeRegressor>
    estimators[0] = decision_tree_regressor_fit(data.X, data.y, 3, CRITERION_MSE)
    estimators[1] = decision_tree_regressor_fit(data.X, data.y, 5, CRITERION_MSE)

    let weights: ptr<f32> = array_new_f32(2)
    weights[0] = 0.5
    weights[1] = 0.5

    let model: VotingRegressor = voting_regressor_fit(estimators, 2, weights)
    let preds: ptr<f32> = voting_regressor_predict(model, data.X)

    let r2: f32 = r2_score(data.y, preds, data.n_samples)
    if r2 < 0.5 {
        println("  FAIL: R2 should be > 0.5")
        return 1
    }
    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    array_free_f32(preds)
    voting_regressor_free(model)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_dataset_loaders() -> i32 {
    println("Test: load_digits / load_wine / load_breast_cancer / load_diabetes")

    let digits: Dataset = load_digits()
    if digits.n_samples != 1797 || digits.n_features != 64 || digits.n_classes != 10 {
        println("  FAIL: load_digits dimensions wrong")
        dataset_free(digits)
        return 1
    }
    dataset_free(digits)

    let wine: Dataset = load_wine()
    if wine.n_samples != 178 || wine.n_features != 13 || wine.n_classes != 3 {
        println("  FAIL: load_wine dimensions wrong")
        dataset_free(wine)
        return 1
    }
    dataset_free(wine)

    let cancer: Dataset = load_breast_cancer()
    if cancer.n_samples != 569 || cancer.n_features != 30 || cancer.n_classes != 2 {
        println("  FAIL: load_breast_cancer dimensions wrong")
        dataset_free(cancer)
        return 1
    }
    dataset_free(cancer)

    let diabetes: Dataset = load_diabetes()
    if diabetes.n_samples != 442 || diabetes.n_features != 10 || diabetes.is_classification {
        println("  FAIL: load_diabetes dimensions wrong")
        dataset_free(diabetes)
        return 1
    }
    dataset_free(diabetes)

    println("  OK: all dataset loaders return correct dimensions")
    return 0
}

