function test_export_tree_text() -> i32 {
    println("Test: export_tree_text")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    for i in 0 to 10 {
        matrix_set(X, i, 0, 1.0 + (i as f32) * 0.1)
        matrix_set(X, i, 1, 2.0 + (i as f32) * 0.1)
        y[i] = 0.0
    }
    for i in 0 to 10 {
        matrix_set(X, 10 + i, 0, 5.0 + (i as f32) * 0.1)
        matrix_set(X, 10 + i, 1, 6.0 + (i as f32) * 0.1)
        y[10 + i] = 1.0
    }

    let model: DecisionTreeClassifier = decision_tree_classifier_fit(X, y, 2, 3, CRITERION_GINI)
    println("  Tree structure:")
    export_tree_text(model, 5)

    decision_tree_classifier_free(model)
    matrix_free(X)
    array_free_f32(y)
    println("  OK: tree exported")
    return 0
}

function test_radius_neighbors_regressor() -> i32 {
    println("Test: RadiusNeighborsRegressor")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    srand(42)
    let mut i: i32 = 0
    while i < 10 {
        matrix_set(X, i, 0, ((rand() % 10) as f32) / 10.0)
        matrix_set(X, i, 1, ((rand() % 10) as f32) / 10.0)
        y[i] = 1.0
        i = i + 1
    }
    i = 0
    while i < 10 {
        matrix_set(X, 10 + i, 0, 5.0 + ((rand() % 10) as f32) / 10.0)
        matrix_set(X, 10 + i, 1, 5.0 + ((rand() % 10) as f32) / 10.0)
        y[10 + i] = 10.0
        i = i + 1
    }

    let model: RadiusNeighborsRegressor = radius_neighbors_regressor_fit(X, y, 2.0)
    let preds: ptr<f32> = radius_neighbors_regressor_predict(model, X)

    let mut n_correct: i32 = 0
    let mut j: i32 = 0
    while j < n {
        let diff: f32 = fabs((preds[j] - y[j]) as f64) as f32
        if diff < 1.0 {
            n_correct = n_correct + 1
        }
        j = j + 1
    }
    let acc: f32 = (n_correct as f32) / (n as f32)

    if acc < 0.9 {
        println("  FAIL: RadiusNeighborsRegressor should predict within 1.0 for most points")
        return 1
    }
    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")
    radius_neighbors_regressor_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_minibatch_sparse_pca() -> i32 {
    println("Test: MiniBatchSparsePCA")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 5)
    srand(42)
    for i in 0 to n {
        for j in 0 to 5 {
            matrix_set(X, i, j, ((rand() % 100) as f32) / 10.0)
        }
    }

    let model: MiniBatchSparsePCA = minibatch_sparse_pca_fit(X, 2, 0.1, 100, 10, 0.001, 42)
    let transformed: Matrix = minibatch_sparse_pca_transform(model, X)

    if transformed.rows != n || transformed.cols != 2 {
        println("  FAIL: wrong output shape")
        return 1
    }
    println("  OK: 30x2 output")
    minibatch_sparse_pca_free(model)
    matrix_free(transformed)
    matrix_free(X)
    return 0
}

function test_svc_rbf() -> i32 {
    println("Test: SVC (RBF kernel)")
    let ds: Dataset = make_classification(60, 4, 2, 4, 0, 2.0, 42)
    let split: TrainTestSplit = train_test_split(ds.X, ds.y, 0.33, 0)

    let model: SVC = svc_fit(split.X_train, split.y_train, 2, 1.0, 0, 0.5, 3, 0.0)
    let preds: ptr<f32> = svc_predict(model, split.X_test)
    let acc: f32 = accuracy_score(split.y_test, preds, split.n_test)

    if acc < 0.6 {
        println("  FAIL: SVC RBF accuracy should be > 0.6")
        return 1
    }
    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")
    svc_free(model)
    array_free_f32(preds)
    train_test_split_free(split)
    dataset_free(ds)
    return 0
}

