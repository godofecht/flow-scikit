    feature_union_free(fu_fitted)
    matrix_free(result)
    dataset_free(data)
    return 0
}

function test_skewed_chi2_sampler() -> i32 {
    println("Test: SkewedChi2Sampler")
    let sampler: SkewedChi2Sampler = skewed_chi2_sampler_fit(4, 1.0, 10, 42)
    let X: Matrix = matrix_new(5, 4)
    let mut i: i32 = 0
    while i < 5 {
        let mut j: i32 = 0
        while j < 4 {
            matrix_set(X, i, j, 1.0 + ((i + j) as f32) * 0.1)
            j = j + 1
        }
        i = i + 1
    }
    let result: Matrix = skewed_chi2_sampler_transform(sampler, X)

    if result.rows != 5 || result.cols != 10 {
        println("  FAIL: expected 5x10 output")
        skewed_chi2_sampler_free(sampler)
        matrix_free(result)
        matrix_free(X)
        return 1
    }

    println("  OK: SkewedChi2Sampler 5x10 output")
    skewed_chi2_sampler_free(sampler)
    matrix_free(result)
    matrix_free(X)
    return 0
}

function test_johnson_lindenstrauss() -> i32 {
    println("Test: johnson_lindenstrauss_min_dim")
    let dim: i32 = johnson_lindenstrauss_min_dim(100, 0.1)
