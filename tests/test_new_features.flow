    if r2 < 0.8 {
        println("  FAIL: QuantileRegressor R2 should be > 0.8")
        return 1
    }
    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")
    quantile_regressor_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_multitask_lasso() -> i32 {
    println("Test: MultiTaskLasso")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 3)
    let Y: Matrix = matrix_new(n, 2)
    srand(42)
    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        let x2: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        matrix_set(X, i, 2, x2)
        matrix_set(Y, i, 0, 2.0 * x0 + 1.0 * x1)
        matrix_set(Y, i, 1, 1.0 * x0 + 3.0 * x2)
    }

    let model: MultiTaskLasso = multitask_lasso_fit(X, Y, 0.01, 200, 0.01)
    let preds: Matrix = multitask_lasso_predict(model, X)

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    for i in 0 to n {
        for o in 0 to 2 {
            let d: f32 = matrix_at(Y, i, o) - matrix_at(preds, i, o)
            ss_res = ss_res + d * d
            let dm: f32 = matrix_at(Y, i, o) - 5.0
            ss_tot = ss_tot + dm * dm
        }
    }
    let r2: f32 = 1.0 - ss_res / ss_tot

    if r2 < 0.8 {
        println("  FAIL: MultiTaskLasso R2 should be > 0.8")
        return 1
    }
    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")
    multitask_lasso_free(model)
    matrix_free(preds)
    matrix_free(X)
    matrix_free(Y)
    return 0
}

