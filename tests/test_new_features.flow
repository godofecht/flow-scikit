    }
    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")
    array_free_f32(preds)
    lasso_lars_free(model)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_minibatch_nmf() -> i32 {
    println("Test: MiniBatchNMF")
    let n: i32 = 20
    let n_features: i32 = 4
    let X: Matrix = matrix_new(n, n_features)
    srand(42)
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = 0
        while j < n_features {
            let v: f32 = ((rand() % 100) as f32) / 10.0
            matrix_set(X, i, j, v)
            j = j + 1
        }
        i = i + 1
    }
    let model: MiniBatchNMF = minibatch_nmf_fit(X, 2, 50, 10, 0.001, 42)
    let transformed: Matrix = minibatch_nmf_transform(model, X)
    if transformed.cols != 2 {
        println("  FAIL: should have 2 components")
        return 1
    }
    if model.reconstruction_err < 0.0 {
        println("  FAIL: reconstruction error should be non-negative")
        return 1
    }
    print("  OK: 20x2, err = ")
    printf("%.4f", model.reconstruction_err)
    println("")
    matrix_free(transformed)
    minibatch_nmf_free(model)
    matrix_free(X)
    return 0
}

function test_extra_metrics() -> i32 {
    println("Test: extra metrics")
    let y_true: ptr<f32> = array_new_f32(6)
    let y_pred: ptr<f32> = array_new_f32(6)
    y_true[0] = 3.0; y_true[1] = 5.0; y_true[2] = 2.5; y_true[3] = 7.0; y_true[4] = 1.0; y_true[5] = 4.0
    y_pred[0] = 2.5; y_pred[1] = 5.0; y_pred[2] = 3.0; y_pred[3] = 6.5; y_pred[4] = 1.5; y_pred[5] = 4.0

    let pinball: f32 = mean_pinball_loss(y_true, y_pred, 6, 0.5)
    let d2_abs: f32 = d2_absolute_error_score(y_true, y_pred, 6)

    if pinball < 0.0 {
        println("  FAIL: pinball loss should be non-negative")
        return 1
    }
    if d2_abs > 1.0 || d2_abs < -1.0 {
        println("  FAIL: d2 absolute error should be in [-1, 1]")
        return 1
    }

    # Test pair confusion matrix
    let labels_a: ptr<f32> = array_new_f32(4)
    let labels_b: ptr<f32> = array_new_f32(4)
    labels_a[0] = 0.0; labels_a[1] = 0.0; labels_a[2] = 1.0; labels_a[3] = 1.0
    labels_b[0] = 0.0; labels_b[1] = 0.0; labels_b[2] = 1.0; labels_b[3] = 1.0
    let pcm: PairConfusionMatrix = pair_confusion_matrix(labels_a, labels_b, 4)
    if pcm.tp != 2 {
        println("  FAIL: TP should be 2 for perfect clustering")
        return 1
    }

    # Test adjusted mutual info
    let ami: f32 = adjusted_mutual_info_score(labels_a, labels_b, 4)
    if ami < 0.99 {
        println("  FAIL: AMI should be ~1.0 for perfect labels")
        return 1
    }

    print("  OK: pinball = ")
    printf("%.4f", pinball)
    print(", d2_abs = ")
    printf("%.4f", d2_abs)
    print(", AMI = ")
    printf("%.4f", ami)
    println("")
    array_free_f32(y_true)
    array_free_f32(y_pred)
    array_free_f32(labels_a)
    array_free_f32(labels_b)
    return 0
}

function test_neighbors_transformers() -> i32 {
    println("Test: KNeighborsTransformer / RadiusNeighborsTransformer")
    let n: i32 = 10
    let X: Matrix = matrix_new(n, 2)
    srand(42)
    let mut i: i32 = 0
    while i < n {
        matrix_set(X, i, 0, ((rand() % 100) as f32) / 10.0)
        matrix_set(X, i, 1, ((rand() % 100) as f32) / 10.0)
        i = i + 1
    }

    let knn_t: KNeighborsTransformer = kneighbors_transformer_fit(X, 3, 0)
    let graph: Matrix = kneighbors_transformer_transform(knn_t, X)
    if graph.rows != n || graph.cols != n {
        println("  FAIL: graph should be 10x10")
        return 1
    }
    # Each row should have exactly 3 non-zero entries
    let mut i2: i32 = 0
    while i2 < n {
        let mut nnz: i32 = 0
        let mut j: i32 = 0
        while j < n {
            if matrix_at(graph, i2, j) > 0.0 { nnz = nnz + 1 }
            j = j + 1
        }
        if nnz != 3 {
            println("  FAIL: each row should have 3 nonzeros")
            return 1
        }
        i2 = i2 + 1
    }

    let rnn_t: RadiusNeighborsTransformer = radius_neighbors_transformer_fit(X, 5.0, 0)
    let rgraph: Matrix = radius_neighbors_transformer_transform(rnn_t, X)

    let mut has_edge: bool = false
    let mut i3: i32 = 0
    while i3 < n {
        let mut j3: i32 = 0
        while j3 < n {
            if matrix_at(rgraph, i3, j3) > 0.0 { has_edge = true }
            j3 = j3 + 1
        }
        i3 = i3 + 1
    }
    if not has_edge {
        println("  FAIL: radius graph should have at least one edge")
        return 1
    }

    print("  OK: KNN graph 10x10 with 3 nnz/row, radius graph has edges")
    println("")
    matrix_free(graph)
    matrix_free(rgraph)
    kneighbors_transformer_free(knn_t)
    radius_neighbors_transformer_free(rnn_t)
    matrix_free(X)
    return 0
}

function test_group_cv() -> i32 {
    println("Test: RepeatedStratifiedKFold / LeaveOneGroupOut / LeavePGroupOut")
    let n: i32 = 20
    let y: ptr<f32> = array_new_f32(n)
    let groups: ptr<f32> = array_new_f32(n)

    let mut i: i32 = 0
    while i < n {
        if i < 10 { y[i] = 0.0 } else { y[i] = 1.0 }
        groups[i] = (i / 5) as f32
        i = i + 1
    }

    # RepeatedStratifiedKFold
    let rskf: RepeatedStratifiedKFold = repeated_stratified_k_fold(y, n, 2, 3, 42)
    let rs_result: GroupCVResult = repeated_stratified_k_fold_split(rskf, y, n)
    if rs_result.n_splits != 6 {
        println("  FAIL: should have 6 splits")
        return 1
    }
    group_cv_result_free(rs_result)

    # LeaveOneGroupOut
    let lo_result: GroupCVResult = leave_one_group_out_split(groups, n)
    if lo_result.n_splits != 4 {
        println("  FAIL: should have 4 splits")
        return 1
    }
    let mut all_ok: bool = true
    i = 0
    while i < lo_result.n_splits {
        if lo_result.n_test_arr[i] + lo_result.n_train_arr[i] != n {
            all_ok = false
        }
        i = i + 1
    }
    if not all_ok {
        println("  FAIL: LOGO splits should cover all samples")
        return 1
    }
    group_cv_result_free(lo_result)

    # LeavePGroupOut
    let lp_result: GroupCVResult = leave_p_group_out_split(groups, n, 2)
    if lp_result.n_splits != 6 {
        println("  FAIL: should have 6 splits for C(4,2)")
        return 1
    }
    group_cv_result_free(lp_result)

    print("  OK: RSKF 6 splits, LOGO 4 splits, LPGO 6 splits")
    println("")
    array_free_f32(y)
    array_free_f32(groups)
    return 0
}

function test_glm_regressors() -> i32 {
    println("Test: PoissonRegressor / GammaRegressor / TweedieRegressor")
    let data: Dataset = make_regression(50, 3, 3, 0.5, 5.0, 42)
    let y_pos: ptr<f32> = array_new_f32(50)
    let mut i: i32 = 0
    while i < 50 {
        let v: f32 = data.y[i]
        if v < 0.1 { v = 0.1 }
        y_pos[i] = v
        i = i + 1
    }

    let pois: PoissonRegressor = poisson_regressor_fit(data.X, y_pos, 0.01, 200, 0.01)
    let pois_pred: ptr<f32> = poisson_regressor_predict(pois, data.X)
    let mut pois_ok: bool = true
    i = 0
    while i < 50 {
        if pois_pred[i] < 0.0 { pois_ok = false }
        i = i + 1
    }
    if not pois_ok {
        println("  FAIL: PoissonRegressor produced negative predictions")
        poisson_regressor_free(pois)
        array_free_f32(pois_pred)
        array_free_f32(y_pos)
        dataset_free(data)
        return 1
    }
    poisson_regressor_free(pois)
    array_free_f32(pois_pred)

    let gamma: GammaRegressor = gamma_regressor_fit(data.X, y_pos, 0.01, 200, 0.01)
    let gamma_pred: ptr<f32> = gamma_regressor_predict(gamma, data.X)
    let mut gamma_ok: bool = true
    i = 0
    while i < 50 {
        if gamma_pred[i] < 0.0 { gamma_ok = false }
        i = i + 1
    }
    if not gamma_ok {
        println("  FAIL: GammaRegressor produced negative predictions")
        gamma_regressor_free(gamma)
        array_free_f32(gamma_pred)
        array_free_f32(y_pos)
        dataset_free(data)
        return 1
    }
    gamma_regressor_free(gamma)
    array_free_f32(gamma_pred)

    let tweedie: TweedieRegressor = tweedie_regressor_fit(data.X, y_pos, 0.01, 1.0, 200, 0.01)
    let tweedie_pred: ptr<f32> = tweedie_regressor_predict(tweedie, data.X)
    let mut tweedie_ok: bool = true
    i = 0
    while i < 50 {
        if tweedie_pred[i] < 0.0 { tweedie_ok = false }
        i = i + 1
    }
    if not tweedie_ok {
        println("  FAIL: TweedieRegressor produced negative predictions")
        tweedie_regressor_free(tweedie)
        array_free_f32(tweedie_pred)
        array_free_f32(y_pos)
        dataset_free(data)
        return 1
    }
    tweedie_regressor_free(tweedie)
    array_free_f32(tweedie_pred)

    println("  OK: all GLM regressors produce non-negative predictions")
    array_free_f32(y_pos)
    dataset_free(data)
    return 0
}

function test_random_trees_embedding() -> i32 {
    println("Test: RandomTreesEmbedding")
    let data: Dataset = make_classification(40, 4, 2, 2, 0, 1.0, 42)
    let rte: RandomTreesEmbedding = random_trees_embedding_fit(data.X, 5, 3, 42)
    let embedded: Matrix = random_trees_embedding_transform(rte, data.X)

    if embedded.cols < 1 {
        println("  FAIL: embedding has no columns")
        random_trees_embedding_free(rte)
        matrix_free(embedded)
        dataset_free(data)
        return 1
    }

    let mut nnz: i32 = 0
    let mut i: i32 = 0
    while i < embedded.rows {
        let mut j: i32 = 0
        while j < embedded.cols {
            if matrix_at(embedded, i, j) > 0.5 { nnz = nnz + 1 }
            j = j + 1
        }
        i = i + 1
    }

    if nnz != embedded.rows * 5 {
        println("  FAIL: each sample should activate exactly one leaf per tree")
        random_trees_embedding_free(rte)
        matrix_free(embedded)
        dataset_free(data)
        return 1
    }

    print("  OK: embedding ")
    print(embedded.cols)
    print(" cols, ")
    print(nnz)
    println(" nonzeros")
    random_trees_embedding_free(rte)
    matrix_free(embedded)
    dataset_free(data)
    return 0
}

function test_label_binarizer() -> i32 {
    println("Test: LabelBinarizer")
    let y: ptr<f32> = array_new_f32(6)
    y[0] = 0.0; y[1] = 1.0; y[2] = 2.0; y[3] = 0.0; y[4] = 1.0; y[5] = 2.0

    let lb: LabelBinarizer = label_binarizer_fit(y, 6, 0.0, 1.0)
    let Y: Matrix = label_binarizer_transform(lb, y, 6)

    if lb.n_classes != 3 {
        println("  FAIL: expected 3 classes")
        label_binarizer_free(lb)
        matrix_free(Y)
        array_free_f32(y)
        return 1
    }

    if matrix_at(Y, 0, 0) != 1.0 || matrix_at(Y, 0, 1) != 0.0 || matrix_at(Y, 0, 2) != 0.0 {
        println("  FAIL: row 0 should be [1, 0, 0]")
        label_binarizer_free(lb)
        matrix_free(Y)
        array_free_f32(y)
        return 1
    }

    if matrix_at(Y, 1, 0) != 0.0 || matrix_at(Y, 1, 1) != 1.0 || matrix_at(Y, 1, 2) != 0.0 {
        println("  FAIL: row 1 should be [0, 1, 0]")
        label_binarizer_free(lb)
        matrix_free(Y)
        array_free_f32(y)
        return 1
    }

    let inv: ptr<f32> = label_binarizer_inverse_transform(lb, Y, 6)
    let mut inv_ok: bool = true
    let mut i: i32 = 0
    while i < 6 {
        if inv[i] != y[i] { inv_ok = false }
        i = i + 1
    }
    if not inv_ok {
        println("  FAIL: inverse transform does not match original")
        label_binarizer_free(lb)
        matrix_free(Y)
        array_free_f32(inv)
        array_free_f32(y)
        return 1
    }

    println("  OK: 3 classes, transform and inverse correct")
    label_binarizer_free(lb)
    matrix_free(Y)
    array_free_f32(inv)
    array_free_f32(y)
    return 0
}

function test_chi2_f_classif_f_regression() -> i32 {
    println("Test: chi2 / f_classif / f_regression")
    let data: Dataset = make_classification(50, 5, 2, 3, 0, 2.0, 42)

    let chi2_res: Chi2Result = chi2(data.X, data.y)
    let mut chi2_ok: bool = true
    let mut i: i32 = 0
    while i < 5 {
        if chi2_res.scores[i] < 0.0 { chi2_ok = false }
        i = i + 1
    }
    if not chi2_ok {
        println("  FAIL: chi2 scores should be non-negative")
        chi2_result_free(chi2_res)
        dataset_free(data)
        return 1
    }
    chi2_result_free(chi2_res)

    let fclassif_res: FResult = f_classif(data.X, data.y)
    let mut fclassif_ok: bool = true
    i = 0
    while i < 5 {
        if fclassif_res.scores[i] < 0.0 { fclassif_ok = false }
        i = i + 1
    }
    if not fclassif_ok {
        println("  FAIL: f_classif scores should be non-negative")
        f_result_free(fclassif_res)
        dataset_free(data)
        return 1
    }
    f_result_free(fclassif_res)

    let reg_data: Dataset = make_regression(50, 5, 3, 0.5, 1.0, 42)
    let freg_res: FResult = f_regression(reg_data.X, reg_data.y)
    let mut freg_ok: bool = true
    i = 0
    while i < 5 {
        if freg_res.scores[i] < 0.0 { freg_ok = false }
        i = i + 1
    }
    if not freg_ok {
        println("  FAIL: f_regression scores should be non-negative")
        f_result_free(freg_res)
        dataset_free(data)
        dataset_free(reg_data)
        return 1
    }
    f_result_free(freg_res)

    println("  OK: all scoring functions return non-negative scores")
    dataset_free(data)
    dataset_free(reg_data)
    return 0
}

function test_group_shuffle_split() -> i32 {
    println("Test: GroupShuffleSplit")
    let n: i32 = 20
    let groups: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut i: i32 = 0
    while i < n {
        groups[i] = i / 5
        i = i + 1
    }

    let gss: GroupShuffleSplit = group_shuffle_split_init(3, 0.5, 42)
    let split0: TrainTestSplit = group_shuffle_split_get_split(gss, groups, n, 4, 0)

    if split0.n_train + split0.n_test != n {
        println("  FAIL: train + test should equal n")
        free(groups as ptr<void>)
        train_test_split_free(split0)
        return 1
    }

    if split0.n_test == 0 || split0.n_train == 0 {
        println("  FAIL: split should have both train and test")
        free(groups as ptr<void>)
        train_test_split_free(split0)
        return 1
    }

    print("  OK: split 0 has ")
    print(split0.n_train)
    print(" train, ")
    print(split0.n_test)
    println(" test")
    free(groups as ptr<void>)
    train_test_split_free(split0)
    return 0
}

function test_silhouette_samples_rand_score() -> i32 {
    println("Test: silhouette_samples / rand_score")
    let data: Dataset = make_blobs(30, 2, 3, 0.5, -5.0, 5.0, 42)
    let km: KMeans = kmeans_fit(data.X, 3, 50, 0.001, 42)
    let preds: ptr<f32> = kmeans_predict(km, data.X)

    let labels: ptr<i32> = malloc((30 as i64) * 4) as ptr<i32>
    let mut i: i32 = 0
    while i < 30 {
        labels[i] = preds[i] as i32
        i = i + 1
    }

    let sil_samples: ptr<f32> = silhouette_samples(data.X, labels, 30)
    let mut sil_ok: bool = true
    i = 0
    while i < 30 {
        if sil_samples[i] < -1.01 || sil_samples[i] > 1.01 { sil_ok = false }
        i = i + 1
    }
    if not sil_ok {
        println("  FAIL: silhouette samples should be in [-1, 1]")
        array_free_f32(sil_samples)
        free(labels as ptr<void>)
        array_free_f32(preds)
        kmeans_free(km)
        dataset_free(data)
        return 1
    }
    array_free_f32(sil_samples)

    let rs: f32 = rand_score(data.y, preds, 30)
    if rs < 0.0 || rs > 1.01 {
        println("  FAIL: rand_score should be in [0, 1]")
        free(labels as ptr<void>)
        array_free_f32(preds)
        kmeans_free(km)
        dataset_free(data)
        return 1
    }

    print("  OK: rand_score = ")
    print(rs)
    println("")
    free(labels as ptr<void>)
    array_free_f32(preds)
    kmeans_free(km)
    dataset_free(data)
    return 0
}

function test_estimate_bandwidth_kmeans_pp() -> i32 {
    println("Test: estimate_bandwidth / kmeans_plusplus_init")
    let data: Dataset = make_blobs(50, 2, 3, 0.5, -5.0, 5.0, 42)

    let bw: f32 = estimate_bandwidth(data.X, 0.3, 20, 42)
    if bw <= 0.0 {
        println("  FAIL: bandwidth should be positive")
        dataset_free(data)
        return 1
    }

    let centers: Matrix = kmeans_plusplus_init(data.X, 3, 42)
    if centers.rows != 3 {
        println("  FAIL: kmeans++ should return 3 centers")
        matrix_free(centers)
        dataset_free(data)
        return 1
    }

    let mut is_distinct: bool = false
    if matrix_at(centers, 0, 0) != matrix_at(centers, 1, 0) { is_distinct = true }
    if matrix_at(centers, 1, 0) != matrix_at(centers, 2, 0) { is_distinct = true }
    if not is_distinct {
        println("  FAIL: kmeans++ centers should be distinct")
        matrix_free(centers)
        dataset_free(data)
        return 1
    }

    print("  OK: bandwidth = ")
    print(bw)
    print(", kmeans++ 3 distinct centers")
    println("")
    matrix_free(centers)
    dataset_free(data)
    return 0
}

function test_feature_union() -> i32 {
