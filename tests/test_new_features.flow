import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

function _noise(seed: i32) -> f32 {
    let v: f32 = ((seed * 37 + 13) % 100) as f32
    return v / 100.0
}

function test_zero_one_loss() -> i32 {
    println("Test: zero_one_loss")
    let y_true: ptr<f32> = array_new_f32(5)
    let y_pred: ptr<f32> = array_new_f32(5)
    y_true[0] = 0.0; y_true[1] = 1.0; y_true[2] = 1.0; y_true[3] = 0.0; y_true[4] = 1.0
    y_pred[0] = 0.0; y_pred[1] = 1.0; y_pred[2] = 0.0; y_pred[3] = 1.0; y_pred[4] = 1.0

    let loss: f32 = zero_one_loss(y_true, y_pred, 5)
    if fabs((loss - 0.4) as f64) as f32 > 0.001 {
        println("  FAIL: zero_one_loss should be 0.4")
        return 1
    }
    println("  OK: loss = 0.4000")
    array_free_f32(y_true)
    array_free_f32(y_pred)
    return 0
}

function test_hamming_loss() -> i32 {
    println("Test: hamming_loss")
    let y_true: ptr<f32> = array_new_f32(4)
    let y_pred: ptr<f32> = array_new_f32(4)
    y_true[0] = 0.0; y_true[1] = 1.0; y_true[2] = 2.0; y_true[3] = 0.0
    y_pred[0] = 0.0; y_pred[1] = 1.0; y_pred[2] = 2.0; y_pred[3] = 1.0

    let loss: f32 = hamming_loss(y_true, y_pred, 4)
    if fabs((loss - 0.25) as f64) as f32 > 0.001 {
        println("  FAIL: hamming_loss should be 0.25")
        return 1
    }
    println("  OK: loss = 0.2500")
    array_free_f32(y_true)
    array_free_f32(y_pred)
    return 0
}

function test_dcg_ndcg() -> i32 {
    println("Test: dcg_score / ndcg_score")
    let y_true: ptr<f32> = array_new_f32(5)
    let y_score: ptr<f32> = array_new_f32(5)
    y_true[0] = 3.0; y_true[1] = 2.0; y_true[2] = 3.0; y_true[3] = 0.0; y_true[4] = 1.0
    y_score[0] = 3.0; y_score[1] = 2.0; y_score[2] = 3.0; y_score[3] = 0.0; y_score[4] = 1.0

    let dcg: f32 = dcg_score(y_true, y_score, 5)
    let ndcg: f32 = ndcg_score(y_true, y_score, 5)

    if ndcg < 0.99 {
        println("  FAIL: ndcg should be ~1.0 for perfect ranking")
        return 1
    }
    print("  OK: dcg = ")
    printf("%.4f", dcg)
    print(", ndcg = ")
    printf("%.4f", ndcg)
    println("")
    array_free_f32(y_true)
    array_free_f32(y_score)
    return 0
}

function test_coverage_error() -> i32 {
    println("Test: coverage_error")
    let y_true: ptr<f32> = array_new_f32(12)
    let y_score: ptr<f32> = array_new_f32(12)
    y_true[0] = 1.0; y_true[1] = 1.0; y_true[2] = 0.0; y_true[3] = 0.0
    y_score[0] = 0.9; y_score[1] = 0.8; y_score[2] = 0.3; y_score[3] = 0.1
    y_true[4] = 0.0; y_true[5] = 0.0; y_true[6] = 1.0; y_true[7] = 0.0
    y_score[4] = 0.1; y_score[5] = 0.2; y_score[6] = 0.7; y_score[7] = 0.3
    y_true[8] = 1.0; y_true[9] = 0.0; y_true[10] = 0.0; y_true[11] = 1.0
    y_score[8] = 0.8; y_score[9] = 0.4; y_score[10] = 0.2; y_score[11] = 0.9

    let cov: f32 = coverage_error(y_true, y_score, 3, 4)
    if cov < 0.0 || cov > 1.0 {
        println("  FAIL: coverage_error out of range")
        return 1
    }
    print("  OK: coverage = ")
    printf("%.4f", cov)
    println("")
    array_free_f32(y_true)
    array_free_f32(y_score)
    return 0
}

function test_label_ranking_loss() -> i32 {
    println("Test: label_ranking_loss")
    let y_true: ptr<f32> = array_new_f32(6)
    let y_score: ptr<f32> = array_new_f32(6)
    y_true[0] = 3.0; y_true[1] = 2.0; y_true[2] = 1.0
    y_score[0] = 0.9; y_score[1] = 0.5; y_score[2] = 0.1
    y_true[3] = 1.0; y_true[4] = 2.0; y_true[5] = 3.0
    y_score[3] = 0.9; y_score[4] = 0.5; y_score[5] = 0.1

    let loss: f32 = label_ranking_loss(y_true, y_score, 2, 3)
    if fabs((loss - 0.5) as f64) as f32 > 0.01 {
        println("  FAIL: label_ranking_loss should be ~0.5")
        return 1
    }
    print("  OK: loss = ")
    printf("%.4f", loss)
    println("")
    array_free_f32(y_true)
    array_free_f32(y_score)
    return 0
}

function test_orthogonal_matching_pursuit() -> i32 {
    println("Test: OrthogonalMatchingPursuit")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 5)
    let y: ptr<f32> = array_new_f32(n)
    srand(42)
    for i in 0 to n {
        for j in 0 to 5 {
            matrix_set(X, i, j, ((rand() % 100) as f32) / 10.0)
        }
        y[i] = 3.0 * matrix_at(X, i, 0) + 2.0 * matrix_at(X, i, 2) + _noise(i) * 0.01
    }

    let model: OrthogonalMatchingPursuit = orthogonal_matching_pursuit_fit(X, y, 2)
    let preds: ptr<f32> = orthogonal_matching_pursuit_predict(model, X)
    let r2: f32 = r2_score(y, preds, n)

    if r2 < 0.95 {
        println("  FAIL: OMP R2 should be > 0.95")
        return 1
    }
    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")
    orthogonal_matching_pursuit_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

