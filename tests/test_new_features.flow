function test_clustering_metrics() -> i32 {
    println("Test: clustering metrics")
    let n: i32 = 12
    let X: Matrix = matrix_new(n, 2)
    let labels: ptr<f32> = array_new_f32(n)
    let mut i: i32 = 0
    while i < 6 {
        matrix_set(X, i, 0, 1.0 + (i as f32) * 0.1)
        matrix_set(X, i, 1, 2.0 + (i as f32) * 0.1)
        labels[i] = 0.0
        i = i + 1
    }
    while i < 12 {
        matrix_set(X, i, 0, 8.0 + ((i - 6) as f32) * 0.1)
        matrix_set(X, i, 1, 9.0 + ((i - 6) as f32) * 0.1)
        labels[i] = 1.0
        i = i + 1
    }
    let ch: f32 = calinski_harabasz_score(X, labels, 2, n)
    let db: f32 = davies_bouldin_score(X, labels, 2, n)
    let homo: f32 = homogeneity_score(labels, labels, n)
    if ch <= 0.0 {
        println("  FAIL: CH should be positive")
        return 1
    }
    if db < 0.0 {
        println("  FAIL: DB should be non-negative")
        return 1
    }
    if homo < 0.99 {
        println("  FAIL: homogeneity should be ~1.0 for perfect labels")
        return 1
    }
    print("  OK: CH = ")
    printf("%.2f", ch)
    print(", DB = ")
    printf("%.4f", db)
    print(", homo = ")
    printf("%.4f", homo)
    println("")
    array_free_f32(labels)
    matrix_free(X)
    return 0
}

function test_logistic_regression_cv() -> i32 {
    println("Test: LogisticRegressionCV")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    srand(42)
    let mut i: i32 = 0
    while i < n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        if x0 + x1 > 10.0 {
            y[i] = 1.0
        } else {
            y[i] = 0.0
        }
        i = i + 1
    }
    let model: LogisticRegressionCV = logistic_regression_cv_fit(X, y, 2, 5)
    let preds: ptr<f32> = logistic_regression_cv_predict(model, X)
    let mut correct: i32 = 0
    i = 0
    while i < n {
        if preds[i] == y[i] {
            correct = correct + 1
        }
        i = i + 1
    }
    let acc: f32 = (correct as f32) / (n as f32)
    if acc < 0.5 {
        println("  FAIL: accuracy should be > 0.5")
        return 1
    }
    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")
    array_free_f32(preds)
    logistic_regression_cv_free(model)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

