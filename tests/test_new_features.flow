    let X: Matrix = matrix_new(n, 4)
    srand(42)
    let mut i: i32 = 0
    while i < n {
        let mut j: i32 = 0
        while j < 4 {
            let v: f32 = ((rand() % 100) as f32) / 100.0
            if v > 0.5 {
                matrix_set(X, i, j, 1.0)
            } else {
                matrix_set(X, i, j, 0.0)
            }
            j = j + 1
        }
        i = i + 1
    }

    let model: BernoulliRBM = bernoulli_rbm_fit(X, 2, 0.01, 50, 10, 42)
    let transformed: Matrix = bernoulli_rbm_transform(model, X)

    if transformed.rows != n || transformed.cols != 2 {
        println("  FAIL: wrong output shape")
        return 1
    }
    println("  OK: 20x2 output")
    matrix_free(transformed)
    bernoulli_rbm_free(model)
    matrix_free(X)
    return 0
}

