function test_cross_val_score() -> i32 {
    println("Test: cross_val_score")
    let ds: Dataset = make_classification(60, 4, 2, 4, 0, 2.0, 42)
    let scores: ptr<f32> = cross_val_score(ds.X, ds.y, 5, 0)

    let mut total: f32 = 0.0
    for i in 0 to 5 {
        total = total + scores[i]
    }
    let mean: f32 = total / 5.0

    if mean < 0.5 {
        println("  FAIL: mean CV accuracy should be > 0.5")
        return 1
    }
    print("  OK: mean CV = ")
    printf("%.4f", mean)
    println("")
    array_free_f32(scores)
    dataset_free(ds)
    return 0
}

function test_repeated_k_fold() -> i32 {
    println("Test: repeated_k_fold")
    let ds: Dataset = make_classification(60, 4, 2, 4, 0, 2.0, 42)
    let result: RepeatedKFoldResult = repeated_k_fold(ds.X, ds.y, 3, 2, 42)

    if result.n_scores < 1 {
        println("  FAIL: should have scores")
        return 1
    }
    let mut total: f32 = 0.0
    for i in 0 to result.n_scores {
        total = total + result.scores[i]
    }
    let mean: f32 = total / (result.n_scores as f32)
    print("  OK: mean = ")
    printf("%.4f", mean)
    println("")
    repeated_kfold_result_free(result)
    dataset_free(ds)
    return 0
}

function test_hdbscan() -> i32 {
    println("Test: HDBSCAN")
    let n: i32 = 20
    let X: Matrix = matrix_new(n, 2)
    let mut i: i32 = 0
    while i < 10 {
        matrix_set(X, i, 0, 1.0 + (i as f32) * 0.1)
        matrix_set(X, i, 1, 2.0 + (i as f32) * 0.1)
        i = i + 1
    }
    while i < 20 {
        matrix_set(X, i, 0, 8.0 + ((i - 10) as f32) * 0.1)
        matrix_set(X, i, 1, 9.0 + ((i - 10) as f32) * 0.1)
        i = i + 1
    }

    let model: HDBSCAN = hdbscan_fit(X, 3, 3)
    let labels: ptr<f32> = hdbscan_labels(model)

    if model.n_clusters < 1 {
        println("  FAIL: should find at least 1 cluster")
        return 1
    }
    print("  OK: n_clusters = ")
    print(model.n_clusters)
    println("")
    array_free_f32(labels)
    hdbscan_free(model)
    matrix_free(X)
    return 0
}

