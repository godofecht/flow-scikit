function test_svr_rbf() -> i32 {
    println("Test: SVR (RBF kernel)")
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    srand(42)
    let mut i: i32 = 0
    while i < n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        y[i] = 2.0 * x0 + 3.0 * x1 + 1.0
        i = i + 1
    }

    let model: SVR = svr_fit(X, y, 10.0, 0.01, 0, 0.01, 3, 0.0)
    let preds: ptr<f32> = svr_predict(model, X)
    let r2: f32 = r2_score(y, preds, n)

    if r2 < 0.5 {
        println("  FAIL: SVR R2 should be > 0.5")
        return 1
    }
    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")
    svr_free(model)
    array_free_f32(preds)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_hist_gradient_boosting() -> i32 {
    println("Test: HistGradientBoostingClassifier")
    let ds: Dataset = make_classification(60, 4, 2, 4, 0, 2.0, 42)
    let split: TrainTestSplit = train_test_split(ds.X, ds.y, 0.33, 0)

    let model: HistGradientBoostingClassifier = hist_gradient_boosting_classifier_fit(
        split.X_train, split.y_train, split.n_train, 2, 20, 0.1, 3
    )
    let preds: ptr<f32> = hist_gradient_boosting_classifier_predict(model, split.X_test)
    let acc: f32 = accuracy_score(split.y_test, preds, split.n_test)

    if acc < 0.6 {
        println("  FAIL: HistGB accuracy should be > 0.6")
        return 1
    }
    print("  OK: accuracy = ")
    printf("%.4f", acc)
    println("")
    hist_gradient_boosting_classifier_free(model)
    array_free_f32(preds)
    train_test_split_free(split)
    dataset_free(ds)
    return 0
}

function main() -> i32 {
    println("=== New Features Tests ===")
    println("")
    let mut failures: i32 = 0

    if test_zero_one_loss() != 0 { failures = failures + 1 }
    println("")
    if test_hamming_loss() != 0 { failures = failures + 1 }
    println("")
    if test_dcg_ndcg() != 0 { failures = failures + 1 }
    println("")
    if test_coverage_error() != 0 { failures = failures + 1 }
    println("")
    if test_label_ranking_loss() != 0 { failures = failures + 1 }
    println("")
    if test_orthogonal_matching_pursuit() != 0 { failures = failures + 1 }
    println("")
    if test_quantile_regressor() != 0 { failures = failures + 1 }
    println("")
    if test_multitask_lasso() != 0 { failures = failures + 1 }
    println("")
    if test_multitask_elasticnet() != 0 { failures = failures + 1 }
    println("")
    if test_export_tree_text() != 0 { failures = failures + 1 }
    println("")
    if test_radius_neighbors_regressor() != 0 { failures = failures + 1 }
    println("")
    if test_minibatch_sparse_pca() != 0 { failures = failures + 1 }
    println("")
    if test_svc_rbf() != 0 { failures = failures + 1 }
    println("")
    if test_svc_linear() != 0 { failures = failures + 1 }
    println("")
    if test_svr_rbf() != 0 { failures = failures + 1 }
    println("")
    if test_hist_gradient_boosting() != 0 { failures = failures + 1 }

    println("")
    println("----------------------------------------")
    if failures == 0 {
        println("All new feature tests passed!")
    } else {
        print("FAILED: ")
        print(failures)
        println(" tests")
    }
    println("----------------------------------------")
    return failures
}
