import "lib/scikit/scikit.flow"

extern {
    function timespec_get(ts: ptr<i64>, base: i32) -> i32
    function log(x: f64) -> f64
    function exp(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

const TIME_UTC: i32 = 1

function bnb_now_ns() -> i64 {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    timespec_get(ts, TIME_UTC)
    let value: i64 = ts[0] * 1000000000 + ts[1]
    free(ts as ptr<void>)
    return value
}

# Verbatim copy of the pre-optimization bernoulli_nb_predict from origin/main,
# kept only so the A/B timing and the parity check run against real reference
# output rather than a remembered number.
function bnb_reference_predict(model: BernoulliNB, X: Matrix) -> ptr<f32> {
    let n: i32 = X.rows
    let result: ptr<f32> = array_new_f32(n)

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_score: f32 = -10000000000.0
        for c in 0 to model.n_classes {
            let mut score: f32 = model.class_log_prior[c]
            for j in 0 to model.n_features {
                let x_ij: f32 = matrix_at(X, i, j)
                if x_ij > 0.5 {
                    score = score + model.feature_log_prob[c][j]
                } else {
                    score = score + log((1.0 - exp(model.feature_log_prob[c][j] as f64) as f32) as f64) as f32
                }
            }
            if score > best_score {
                best_score = score
                best_c = c
            }
        }
        result[i] = model.classes[best_c]
    }

    return result
}

# argmax hides small drift, so compare the accumulated log-scores themselves.
# The inline form is the origin/main expression; the table form is what the
# optimized predict accumulates.  They must agree bit for bit.
function bnb_absent_term(present_log_prob: f32) -> f32 {
    return log((1.0 - exp(present_log_prob as f64) as f32) as f64) as f32
}

function bnb_check_score_parity(model: BernoulliNB, X: Matrix) -> i32 {
    let p: i32 = model.n_features
    let absent: ptr<f32> = array_new_f32(model.n_classes * p)
    for c in 0 to model.n_classes {
        let base: i32 = c * p
        for j in 0 to p {
            absent[base + j] = bnb_absent_term(model.feature_log_prob[c][j])
        }
    }

    let mut status: i32 = 0
    for i in 0 to X.rows {
        let row_base: i32 = i * p
        for c in 0 to model.n_classes {
            let mut inline_score: f32 = model.class_log_prior[c]
            let mut table_score: f32 = model.class_log_prior[c]
            let class_base: i32 = c * p
            for j in 0 to p {
                if matrix_at(X, i, j) > 0.5 {
                    inline_score = inline_score + model.feature_log_prob[c][j]
                } else {
                    inline_score = inline_score + bnb_absent_term(model.feature_log_prob[c][j])
                }
                if X.data[row_base + j] > 0.5 {
                    table_score = table_score + model.feature_log_prob[c][j]
                } else {
                    table_score = table_score + absent[class_base + j]
                }
            }
            if inline_score != table_score {
                status = 1
            }
        }
    }

    array_free_f32(absent)
    if status != 0 {
        println("FAIL: BernoulliNB predict log-scores are not bit-identical")
    }
    return status
}

function bnb_check_known_values() -> i32 {
    # Six samples, four binary features, two classes.  Expected predictions were
    # derived independently from the BernoulliNB definition with alpha = 1.
    let train: Matrix = matrix_new(6, 4)
    let labels: ptr<f32> = array_new_f32(6)

    matrix_set(train, 0, 0, 1.0)
    matrix_set(train, 0, 1, 1.0)
    matrix_set(train, 0, 2, 0.0)
    matrix_set(train, 0, 3, 0.0)
    matrix_set(train, 1, 0, 1.0)
    matrix_set(train, 1, 1, 1.0)
    matrix_set(train, 1, 2, 1.0)
    matrix_set(train, 1, 3, 0.0)
    matrix_set(train, 2, 0, 0.0)
    matrix_set(train, 2, 1, 0.0)
    matrix_set(train, 2, 2, 1.0)
    matrix_set(train, 2, 3, 1.0)
    matrix_set(train, 3, 0, 0.0)
    matrix_set(train, 3, 1, 1.0)
    matrix_set(train, 3, 2, 1.0)
    matrix_set(train, 3, 3, 1.0)
    matrix_set(train, 4, 0, 1.0)
    matrix_set(train, 4, 1, 1.0)
    matrix_set(train, 4, 2, 0.0)
    matrix_set(train, 4, 3, 1.0)
    matrix_set(train, 5, 0, 0.0)
    matrix_set(train, 5, 1, 0.0)
    matrix_set(train, 5, 2, 0.0)
    matrix_set(train, 5, 3, 1.0)

    labels[0] = 0.0
    labels[1] = 0.0
    labels[2] = 1.0
    labels[3] = 1.0
    labels[4] = 0.0
    labels[5] = 1.0

    let model: BernoulliNB = bernoulli_nb_fit(train, labels, 2, 1.0)

    # Query includes an all-absent row and an all-present row so both branches of
    # the feature loop are exercised end to end.
    let query: Matrix = matrix_new(4, 4)
    matrix_set(query, 0, 0, 1.0)
    matrix_set(query, 0, 1, 1.0)
    matrix_set(query, 0, 2, 0.0)
    matrix_set(query, 0, 3, 0.0)
    matrix_set(query, 1, 0, 0.0)
    matrix_set(query, 1, 1, 0.0)
    matrix_set(query, 1, 2, 1.0)
    matrix_set(query, 1, 3, 1.0)
    matrix_set(query, 2, 0, 0.0)
    matrix_set(query, 2, 1, 0.0)
    matrix_set(query, 2, 2, 0.0)
    matrix_set(query, 2, 3, 0.0)
    matrix_set(query, 3, 0, 1.0)
    matrix_set(query, 3, 1, 1.0)
    matrix_set(query, 3, 2, 1.0)
    matrix_set(query, 3, 3, 1.0)

    let expected: ptr<f32> = array_new_f32(4)
    expected[0] = 0.0
    expected[1] = 1.0
    expected[2] = 1.0
    expected[3] = 0.0

    let preds: ptr<f32> = bernoulli_nb_predict(model, query)
    let mut status: i32 = 0
    for i in 0 to 4 {
        if preds[i] != expected[i] {
            println("FAIL: BernoulliNB predict known-value case")
            status = 1
        }
    }

    array_free_f32(preds)
    array_free_f32(expected)
    matrix_free(query)
    bernoulli_nb_free(model)
    matrix_free(train)
    array_free_f32(labels)
    return status
}

function bnb_check_single_feature() -> i32 {
    # Degenerate width: one feature, two classes, perfectly separable.
    let train: Matrix = matrix_new(4, 1)
    let labels: ptr<f32> = array_new_f32(4)
    matrix_set(train, 0, 0, 1.0)
    labels[0] = 0.0
    matrix_set(train, 1, 0, 1.0)
    labels[1] = 0.0
    matrix_set(train, 2, 0, 0.0)
    labels[2] = 1.0
    matrix_set(train, 3, 0, 0.0)
    labels[3] = 1.0

    let model: BernoulliNB = bernoulli_nb_fit(train, labels, 2, 1.0)
    let query: Matrix = matrix_new(2, 1)
    matrix_set(query, 0, 0, 1.0)
    matrix_set(query, 1, 0, 0.0)

    let preds: ptr<f32> = bernoulli_nb_predict(model, query)
    let reference: ptr<f32> = bnb_reference_predict(model, query)
    let mut status: i32 = 0
    if preds[0] != 0.0 { println("FAIL: single-feature BernoulliNB predict row 0") status = 1 }
    if preds[1] != 1.0 { println("FAIL: single-feature BernoulliNB predict row 1") status = 1 }
    for i in 0 to 2 {
        if preds[i] != reference[i] {
            println("FAIL: single-feature BernoulliNB predict diverged from reference")
            status = 1
        }
    }

    array_free_f32(preds)
    array_free_f32(reference)
    matrix_free(query)
    bernoulli_nb_free(model)
    matrix_free(train)
    array_free_f32(labels)
    return status
}

function main() -> i32 {
    let mut status: i32 = 0
    status = status + bnb_check_known_values()
    status = status + bnb_check_single_feature()
    if status != 0 {
        return 1
    }

    let n_train: i32 = 800
    let n_query: i32 = 800
    let p: i32 = 64
    let n_classes: i32 = 4
    let repeats: i32 = 5

    let train: Matrix = matrix_new(n_train, p)
    let labels: ptr<f32> = array_new_f32(n_train)
    for i in 0 to n_train {
        let cls: i32 = i % n_classes
        labels[i] = cls as f32
        for j in 0 to p {
            let bit: i32 = (i * 37 + j * 19 + cls * 11) % 7
            let mut value: f32 = 0.0
            if bit < 3 + cls {
                value = 1.0
            }
            matrix_set(train, i, j, value)
        }
    }

    let model: BernoulliNB = bernoulli_nb_fit(train, labels, n_classes, 1.0)

    let query: Matrix = matrix_new(n_query, p)
    for i in 0 to n_query {
        let cls: i32 = (i + 1) % n_classes
        for j in 0 to p {
            let bit: i32 = (i * 29 + j * 13 + cls * 17) % 7
            let mut value: f32 = 0.0
            if bit < 3 + cls {
                value = 1.0
            }
            matrix_set(query, i, j, value)
        }
    }

    # Element-wise parity on the realistic workload before any timing.
    let reference_once: ptr<f32> = bnb_reference_predict(model, query)
    let optimized_once: ptr<f32> = bernoulli_nb_predict(model, query)
    for i in 0 to n_query {
        if reference_once[i] != optimized_once[i] {
            println("FAIL: optimized BernoulliNB predict changed a label")
            return 1
        }
    }
    array_free_f32(reference_once)
    array_free_f32(optimized_once)

    if bnb_check_score_parity(model, query) != 0 {
        return 1
    }

    let start_reference: i64 = bnb_now_ns()
    for r in 0 to repeats {
        let output: ptr<f32> = bnb_reference_predict(model, query)
        array_free_f32(output)
    }
    let end_reference: i64 = bnb_now_ns()

    let start_optimized: i64 = bnb_now_ns()
    for r in 0 to repeats {
        let output: ptr<f32> = bernoulli_nb_predict(model, query)
        array_free_f32(output)
    }
    let end_optimized: i64 = bnb_now_ns()

    let reference_ms: f64 = ((end_reference - start_reference) as f64) / 1000000.0
    let optimized_ms: f64 = ((end_optimized - start_optimized) as f64) / 1000000.0
    printf("BernoulliNB predict A/B: reference=%.6f ms optimized=%.6f ms speedup=%.3fx\n", reference_ms, optimized_ms, reference_ms / optimized_ms)

    matrix_free(query)
    bernoulli_nb_free(model)
    matrix_free(train)
    array_free_f32(labels)

    println("OK: BernoulliNB predict matches reference labels")
    return 0
}
