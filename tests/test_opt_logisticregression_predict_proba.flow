# Regression test for logistic_predict_proba after it was routed through the
# BLAS-backed logistic_decision_function. Checks hand-computed probabilities,
# the identity predict_proba == sigmoid(decision_function), the wide-X row
# stride path, and a realistic fitted workload against a scalar reference.

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
}

function optpp_close(a: f32, b: f32, tolerance: f32) -> bool {
    let d: f32 = a - b
    if d < 0.0 { d = -d }
    return d <= tolerance
}

# Independent scalar reference for sigmoid(X * w + b).
function optpp_reference(w: ptr<f32>, bias: f32, nf: i32, X: Matrix, out: ptr<f32>) -> void {
    for i in 0 to X.rows {
        let mut z: f32 = bias
        for j in 0 to nf {
            z = z + w[j] * matrix_at(X, i, j)
        }
        out[i] = sigmoid(z)
    }
}

function main() -> i32 {
    let pen: Penalty = penalty_l2(0.0)

    let w1: ptr<f32> = array_new_f32(3)
    w1[0] = 2.0
    w1[1] = -1.0
    w1[2] = 0.5
    let b1: ptr<f32> = array_new_f32(2)
    b1[0] = 0.25
    b1[1] = 0.0
    let cls1: ptr<f32> = array_new_f32(2)
    cls1[0] = 0.0
    cls1[1] = 1.0

    let m1: LogisticRegression = LogisticRegression {
        weights: w1,
        bias: 0.25,
        biases: b1,
        n_features: 3,
        classes: cls1,
        n_classes: 2,
        penalty: pen,
        fitted: true
    }

    # ---- Case 1: hand-computed probabilities on a 3x3 problem ----
    # The three decision scores are 2.25, 0.25 and -5.75.
    let X1: Matrix = matrix_new(3, 3)
    matrix_set(X1, 0, 0, 1.0); matrix_set(X1, 0, 1, 2.0); matrix_set(X1, 0, 2, 4.0)
    matrix_set(X1, 1, 0, 0.0); matrix_set(X1, 1, 1, 0.0); matrix_set(X1, 1, 2, 0.0)
    matrix_set(X1, 2, 0, -3.0); matrix_set(X1, 2, 1, 1.0); matrix_set(X1, 2, 2, 2.0)

    let p1: ptr<f32> = logistic_predict_proba(m1, X1)
    if not optpp_close(p1[0], 0.90465054, 0.0000005) {
        println("FAIL: predict_proba row 0 probability changed")
        return 1
    }
    if not optpp_close(p1[1], 0.56217650, 0.0000005) {
        println("FAIL: predict_proba zero row must be sigmoid of the bias")
        return 1
    }
    if not optpp_close(p1[2], 0.00317268, 0.0000005) {
        println("FAIL: predict_proba row 2 probability changed")
        return 1
    }
    array_free_f32(p1)
    matrix_free(X1)

    # ---- Case 2: X wider than the model, exercising the row-stride path ----
    let X2: Matrix = matrix_new(2, 4)
    matrix_set(X2, 0, 0, 1.0); matrix_set(X2, 0, 1, 2.0)
    matrix_set(X2, 0, 2, 4.0); matrix_set(X2, 0, 3, 1000.0)
    matrix_set(X2, 1, 0, -3.0); matrix_set(X2, 1, 1, 1.0)
    matrix_set(X2, 1, 2, 2.0); matrix_set(X2, 1, 3, -1000.0)

    let p2: ptr<f32> = logistic_predict_proba(m1, X2)
    if not optpp_close(p2[0], 0.90465054, 0.0000005) || not optpp_close(p2[1], 0.00317268, 0.0000005) {
        println("FAIL: predict_proba read past the model feature count")
        return 1
    }
    array_free_f32(p2)
    matrix_free(X2)

    # ---- Case 3: single row ----
    let X3: Matrix = matrix_new(1, 3)
    matrix_set(X3, 0, 0, 1.0); matrix_set(X3, 0, 1, 2.0); matrix_set(X3, 0, 2, 4.0)
    let p3: ptr<f32> = logistic_predict_proba(m1, X3)
    if not optpp_close(p3[0], 0.90465054, 0.0000005) {
        println("FAIL: predict_proba single-row case changed")
        return 1
    }
    array_free_f32(p3)
    matrix_free(X3)

    array_free_f32(w1)
    array_free_f32(b1)
    array_free_f32(cls1)

    # ---- Case 4: realistic fitted workload, 400 x 12 ----
    let n_rows: i32 = 400
    let n_cols: i32 = 12
    let X4: Matrix = matrix_new(n_rows, n_cols)
    let y4: ptr<f32> = array_new_f32(n_rows)
    let mut seed: i32 = 12345
    for i in 0 to n_rows {
        let mut acc: f32 = 0.0
        for j in 0 to n_cols {
            seed = (seed * 1103515245 + 12345) % 2147483647
            if seed < 0 { seed = -seed }
            let v: f32 = ((seed % 2000) as f32) / 1000.0 - 1.0
            matrix_set(X4, i, j, v)
            if j < 4 { acc = acc + v }
        }
        if acc > 0.0 { y4[i] = 1.0 } else { y4[i] = 0.0 }
    }

    let model4: LogisticRegression = logistic_regression_fit(X4, y4, 2, 200, 0.1, pen)
    let proba4: ptr<f32> = logistic_predict_proba(model4, X4)
    let expect4: ptr<f32> = array_new_f32(n_rows)
    optpp_reference(model4.weights, model4.bias, model4.n_features, X4, expect4)

    let mut worst: f32 = 0.0
    for i in 0 to n_rows {
        if proba4[i] < 0.0 || proba4[i] > 1.0 {
            println("FAIL: predict_proba left the unit interval")
            return 1
        }
        let mut d: f32 = proba4[i] - expect4[i]
        if d < 0.0 { d = -d }
        if d > worst { worst = d }
    }
    # Single-precision reductions with different association order agree to a
    # few ulps of the score, which the sigmoid only contracts.
    if worst > 0.00001 {
        println("FAIL: predict_proba diverged from the scalar reference")
        printf("  worst absolute deviation: %.9f\n", worst)
        return 1
    }

    # predict_proba must stay exactly the sigmoid of decision_function.
    let scores4: ptr<f32> = logistic_decision_function(model4, X4)
    for i in 0 to n_rows {
        let s: f32 = sigmoid(scores4[i])
        if proba4[i] != s {
            println("FAIL: predict_proba is no longer sigmoid(decision_function)")
            return 1
        }
    }

    array_free_f32(scores4)
    array_free_f32(expect4)
    array_free_f32(proba4)
    logistic_regression_free(model4)
    array_free_f32(y4)
    matrix_free(X4)

    println("OK: logistic_predict_proba matches sigmoid of the decision scores")
    return 0
}
