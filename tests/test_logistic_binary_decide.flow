# Issue #435: logistic_predict_proba and logistic_decide must compose to a
# correct binary label.
#
# The one-vs-rest fit stores the class-c classifier in weights row c, so row 0
# is the class-0 model and sigmoid of its score is P(class 0). logistic_decide
# maps a probability at or above the threshold to classes[1]. Before the fix
# the binary decision function read row 0, so predict_proba returned P(class 0)
# and every binary label came out inverted: 0 of 6 correct on a perfectly
# separable problem, worse than a constant classifier.
#
# The convention pinned here is scikit-learn's. predict_proba is P(classes[1]),
# decision_function is the score for classes[1], and the threshold argument
# means what a caller assumes it means: raising it makes classes[1] rarer.
#
# A test that exercises only logistic_predict passes either way, which is why
# this survived. Every case below goes through predict_proba then decide.
#
# Helper names carry the issue number because non-exported functions sharing a
# name across modules collide in the generated C (compiler bug #465).

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
}

# Separable 1-D problem: class low at x = -1, class high at x = +1.
function lbd435_fixture(X: Matrix, y: ptr<f32>, low: f32, high: f32) -> void {
    matrix_set(X, 0, 0, -1.0); y[0] = low
    matrix_set(X, 1, 0, -1.0); y[1] = low
    matrix_set(X, 2, 0, -1.0); y[2] = low
    matrix_set(X, 3, 0, 1.0);  y[3] = high
    matrix_set(X, 4, 0, 1.0);  y[4] = high
    matrix_set(X, 5, 0, 1.0);  y[5] = high
}

# The reproduction from the issue, with labels 0 and 1.
function test_binary_proba_decide_composes() -> i32 {
    println("Test: predict_proba then decide on a separable binary problem")

    let X: Matrix = matrix_new(6, 1)
    let y: ptr<f32> = array_new_f32(6)
    lbd435_fixture(X, y, 0.0, 1.0)

    let model: LogisticRegression = logistic_regression_fit(X, y, 2, 300, 0.5, penalty_none())
    let probs: ptr<f32> = logistic_predict_proba(model, X)
    let decided: ptr<f32> = logistic_decide(model, probs, 6, 0.5)

    let mut failed: i32 = 0
    for i in 0 to 6 {
        printf("  x=%.1f  true=%.1f  proba=%.6f  decided=%.1f\n", matrix_at(X, i, 0), y[i], probs[i], decided[i])
    }

    let acc: f32 = accuracy_score(y, decided, 6)
    printf("  accuracy through predict_proba then decide: %.6f\n", acc)
    if acc < 0.999 {
        println("  FAIL: separable binary problem must be classified perfectly")
        failed = 1
    }

    # Pin the convention, not just the composition. predict_proba is
    # P(classes[1]), so it must be high exactly where the true label is
    # classes[1]. Flipping logistic_decide instead of the probability would
    # satisfy the accuracy check above and fail this one.
    for i in 0 to 6 {
        if y[i] == 1.0 {
            if probs[i] <= 0.5 {
                println("  FAIL: predict_proba must return P(classes[1])")
                failed = 1
            }
        } else {
            if probs[i] >= 0.5 {
                println("  FAIL: predict_proba must return P(classes[1])")
                failed = 1
            }
        }
    }

    array_free_f32(probs)
    array_free_f32(decided)
    logistic_regression_free(model)
    array_free_f32(y)
    matrix_free(X)

    if failed == 0 { println("  OK") }
    return failed
}

# Labels that are not 0 and 1, so nothing can pass by coincidence.
function test_binary_non_unit_labels() -> i32 {
    println("Test: predict_proba then decide with class labels 3 and 7")

    let X: Matrix = matrix_new(6, 1)
    let y: ptr<f32> = array_new_f32(6)
    lbd435_fixture(X, y, 3.0, 7.0)

    let model: LogisticRegression = logistic_regression_fit(X, y, 2, 300, 0.5, penalty_none())
    let probs: ptr<f32> = logistic_predict_proba(model, X)
    let decided: ptr<f32> = logistic_decide(model, probs, 6, 0.5)

    let mut failed: i32 = 0
    let acc: f32 = accuracy_score(y, decided, 6)
    printf("  accuracy: %.6f  classes[0]=%.1f classes[1]=%.1f\n", acc, model.classes[0], model.classes[1])
    if acc < 0.999 {
        println("  FAIL: separable binary problem must be classified perfectly")
        failed = 1
    }

    for i in 0 to 6 {
        if probs[i] < 0.0 || probs[i] > 1.0 {
            println("  FAIL: predict_proba left the unit interval")
            failed = 1
        }
    }

    array_free_f32(probs)
    array_free_f32(decided)
    logistic_regression_free(model)
    array_free_f32(y)
    matrix_free(X)

    if failed == 0 { println("  OK") }
    return failed
}

# The threshold argument is the whole point of the decide API. Raising it must
# make classes[1] rarer, never more common.
function test_threshold_direction() -> i32 {
    println("Test: raising the decide threshold makes classes[1] rarer")

    let X: Matrix = matrix_new(6, 1)
    let y: ptr<f32> = array_new_f32(6)
    lbd435_fixture(X, y, 0.0, 1.0)

    let model: LogisticRegression = logistic_regression_fit(X, y, 2, 300, 0.5, penalty_none())
    let probs: ptr<f32> = logistic_predict_proba(model, X)

    let low: ptr<f32> = logistic_decide(model, probs, 6, 0.0)
    let high: ptr<f32> = logistic_decide(model, probs, 6, 1.5)

    let mut failed: i32 = 0
    for i in 0 to 6 {
        if low[i] != model.classes[1] {
            println("  FAIL: threshold 0.0 must label everything classes[1]")
            failed = 1
        }
        if high[i] != model.classes[0] {
            println("  FAIL: threshold above 1.0 must label everything classes[0]")
            failed = 1
        }
    }

    array_free_f32(low)
    array_free_f32(high)
    array_free_f32(probs)
    logistic_regression_free(model)
    array_free_f32(y)
    matrix_free(X)

    if failed == 0 { println("  OK") }
    return failed
}

# predict_proba is documented as sigmoid of the decision scores. The fix moves
# both to the classes[1] side together, so the identity has to survive it.
function test_proba_is_sigmoid_of_decision() -> i32 {
    println("Test: predict_proba equals sigmoid(decision_function)")

    let X: Matrix = matrix_new(6, 1)
    let y: ptr<f32> = array_new_f32(6)
    lbd435_fixture(X, y, 0.0, 1.0)

    let model: LogisticRegression = logistic_regression_fit(X, y, 2, 300, 0.5, penalty_none())
    let probs: ptr<f32> = logistic_predict_proba(model, X)
    let scores: ptr<f32> = logistic_decision_function(model, X)

    let mut failed: i32 = 0
    for i in 0 to 6 {
        if probs[i] != sigmoid(scores[i]) {
            println("  FAIL: predict_proba is no longer sigmoid(decision_function)")
            failed = 1
        }
        # Positive score means classes[1], the scikit-learn sign convention.
        if y[i] == 1.0 {
            if scores[i] <= 0.0 {
                println("  FAIL: decision_function must be positive for classes[1]")
                failed = 1
            }
        } else {
            if scores[i] >= 0.0 {
                println("  FAIL: decision_function must be negative for classes[0]")
                failed = 1
            }
        }
    }

    array_free_f32(scores)
    array_free_f32(probs)
    logistic_regression_free(model)
    array_free_f32(y)
    matrix_free(X)

    if failed == 0 { println("  OK") }
    return failed
}

# logistic_predict is the argmax path and was never inverted. It must stay that
# way, and it must agree with the decide path at threshold 0.5.
function test_predict_agrees_with_decide() -> i32 {
    println("Test: argmax predict agrees with the decide path")

    let X: Matrix = matrix_new(6, 1)
    let y: ptr<f32> = array_new_f32(6)
    lbd435_fixture(X, y, 0.0, 1.0)

    let model: LogisticRegression = logistic_regression_fit(X, y, 2, 300, 0.5, penalty_none())
    let argmax_labels: ptr<f32> = logistic_predict(model, X)
    let probs: ptr<f32> = logistic_predict_proba(model, X)
    let decided: ptr<f32> = logistic_decide(model, probs, 6, 0.5)

    let mut failed: i32 = 0
    for i in 0 to 6 {
        if argmax_labels[i] != y[i] {
            println("  FAIL: argmax predict lost the separable fixture")
            failed = 1
        }
        if argmax_labels[i] != decided[i] {
            println("  FAIL: argmax predict and the decide path disagree")
            failed = 1
        }
    }

    array_free_f32(decided)
    array_free_f32(probs)
    array_free_f32(argmax_labels)
    logistic_regression_free(model)
    array_free_f32(y)
    matrix_free(X)

    if failed == 0 { println("  OK") }
    return failed
}

# Multiclass is a different code path: logistic_predict returns labels and
# logistic_decide passes them through. Guard it so a binary-only fix cannot
# disturb it.
function test_multiclass_decide_passthrough() -> i32 {
    println("Test: multiclass decide passes argmax labels through")

    let X: Matrix = matrix_new(6, 2)
    let y: ptr<f32> = array_new_f32(6)
    matrix_set(X, 0, 0, -2.0); matrix_set(X, 0, 1, 0.0); y[0] = 0.0
    matrix_set(X, 1, 0, -2.0); matrix_set(X, 1, 1, 0.5); y[1] = 0.0
    matrix_set(X, 2, 0, 0.0);  matrix_set(X, 2, 1, 2.0); y[2] = 1.0
    matrix_set(X, 3, 0, 0.5);  matrix_set(X, 3, 1, 2.0); y[3] = 1.0
    matrix_set(X, 4, 0, 2.0);  matrix_set(X, 4, 1, -2.0); y[4] = 2.0
    matrix_set(X, 5, 0, 2.5);  matrix_set(X, 5, 1, -2.0); y[5] = 2.0

    let model: LogisticRegression = logistic_regression_fit(X, y, 3, 300, 0.5, penalty_none())
    let labels: ptr<f32> = logistic_predict(model, X)
    let decided: ptr<f32> = logistic_decide(model, labels, 6, 0.5)

    let mut failed: i32 = 0
    for i in 0 to 6 {
        if decided[i] != labels[i] {
            println("  FAIL: multiclass decide must pass the argmax label through")
            failed = 1
        }
    }
    let acc: f32 = accuracy_score(y, decided, 6)
    printf("  three-class accuracy: %.6f\n", acc)
    if acc < 0.999 {
        println("  FAIL: separable three-class problem must be classified perfectly")
        failed = 1
    }

    array_free_f32(decided)
    array_free_f32(labels)
    logistic_regression_free(model)
    array_free_f32(y)
    matrix_free(X)

    if failed == 0 { println("  OK") }
    return failed
}

function main() -> i32 {
    println("Running issue #435 binary decide tests...")
    println("========================================")
    println("")

    let mut failures: i32 = 0

    if test_binary_proba_decide_composes() != 0 { failures = failures + 1 }
    println("")
    if test_binary_non_unit_labels() != 0 { failures = failures + 1 }
    println("")
    if test_threshold_direction() != 0 { failures = failures + 1 }
    println("")
    if test_proba_is_sigmoid_of_decision() != 0 { failures = failures + 1 }
    println("")
    if test_predict_agrees_with_decide() != 0 { failures = failures + 1 }
    println("")
    if test_multiclass_decide_passthrough() != 0 { failures = failures + 1 }

    println("")
    if failures == 0 {
        println("All issue #435 binary decide tests passed!")
        return 0
    }
    print("FAILED: ")
    print(failures)
    println(" tests")
    return 1
}
