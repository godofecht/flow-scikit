# Regression test for the DecisionTreeClassifier.fit optimization (issue #396).
#
# The builder no longer sorts anything per node: decision_tree_classifier_fit
# sorts each column of X once and the builder carries each feature's order down
# the tree, splitting it while preserving relative order. That is only sound
# because the split scan reads counts at boundaries where consecutive values
# differ, and at such a boundary the left side is exactly the samples at or
# below that value whatever order the equal values came in. The counts are
# integers, so the impurity, the chosen feature and the threshold are all
# bit-identical.
#
# This test proves that by fitting the pre-#396 builder alongside the current
# one and comparing the trees node by node, not by comparing accuracy. It also
# pins the behaviour the argument depends on: constant columns are skipped, and
# among features tied at the same weighted impurity the lowest index still
# wins (issue #204, pinned separately by tests/test_tree_split_tiebreak.flow).
#
# Node arrays are allocated with calloc on both sides (issue #359), so every
# field is defined and the comparison covers all eight of them.

import "lib/scikit/scikit.flow"

extern {
    function timespec_get(ts: ptr<i64>, base: i32) -> i32
    function printf(fmt: string, ...) -> i32
    function calloc(count: i64, size: i64) -> ptr<void>
}

const DTCF_TIME_UTC: i32 = 1

function dtcf_now_ns() -> i64 {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    timespec_get(ts, DTCF_TIME_UTC)
    let value: i64 = ts[0] * 1000000000 + ts[1]
    free(ts as ptr<void>)
    return value
}

# --------------------------------------------------------------------------
# Pre-#396 reference: tree.flow as it stood on main before this change.
# --------------------------------------------------------------------------

function dtcf_gini(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { counts[c] = 0 }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] { counts[c] = counts[c] + 1 }
        }
    }
    let mut impurity: f32 = 1.0
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / (n as f32)
        impurity = impurity - p * p
    }
    free(counts as ptr<void>)
    return impurity
}

function dtcf_majority_class(y: ptr<f32>, n: i32, classes: ptr<f32>, n_classes: i32) -> f32 {
    let counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { counts[c] = 0 }
    for i in 0 to n {
        for c in 0 to n_classes {
            if y[i] == classes[c] { counts[c] = counts[c] + 1 }
        }
    }
    let mut best_c: i32 = 0
    let mut best_count: i32 = 0
    for c in 0 to n_classes {
        if counts[c] > best_count {
            best_count = counts[c]
            best_c = c
        }
    }
    free(counts as ptr<void>)
    return classes[best_c]
}

function dtcf_sort_pairs(values: ptr<f32>, companions: ptr<i32>, n: i32) -> void {
    let mut gap: i32 = 1
    while gap < n / 3 {
        gap = 3 * gap + 1
    }
    while gap > 0 {
        let mut i: i32 = gap
        while i < n {
            let key_v: f32 = values[i]
            let key_c: i32 = companions[i]
            let mut j: i32 = i
            while j >= gap && values[j - gap] > key_v {
                values[j] = values[j - gap]
                companions[j] = companions[j - gap]
                j = j - gap
            }
            values[j] = key_v
            companions[j] = key_c
            i = i + 1
        }
        gap = (gap - 1) / 3
    }
}

function dtcf_gini_from_counts(counts: ptr<i32>, n_classes: i32, n: i32) -> f32 {
    if n <= 0 { return 0.0 }
    let mut sum_sq: f32 = 0.0
    let nf: f32 = n as f32
    for c in 0 to n_classes {
        let p: f32 = (counts[c] as f32) / nf
        sum_sq = sum_sq + p * p
    }
    return 1.0 - sum_sq
}

function dtcf_build(
    nodes: ptr<TreeNode>,
    n_nodes: ptr<i32>,
    X: Matrix,
    y: ptr<f32>,
    indices: ptr<i32>,
    n_indices: i32,
    depth: i32,
    max_depth: i32,
    criterion: i32,
    classes: ptr<f32>,
    n_classes: i32
) -> i32 {
    let node_idx: i32 = n_nodes[0]
    n_nodes[0] = n_nodes[0] + 1

    let should_stop: bool = depth >= max_depth || n_indices < 2

    if should_stop {
        let y_subset: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices { y_subset[i] = y[indices[i]] }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = dtcf_majority_class(y_subset, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = dtcf_gini(y_subset, n_indices, classes, n_classes)
        array_free_f32(y_subset)
        return node_idx
    }

    let mut best_feature: i32 = -1
    let mut best_threshold: f32 = 0.0
    let mut best_impurity: f32 = 9999999999.0

    let class_idx: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    for i in 0 to n_indices {
        let mut ci: i32 = 0
        for c in 0 to n_classes {
            if y[indices[i]] == classes[c] { ci = c }
        }
        class_idx[i] = ci
    }

    let total_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    for c in 0 to n_classes { total_counts[c] = 0 }
    for i in 0 to n_indices { total_counts[class_idx[i]] = total_counts[class_idx[i]] + 1 }
    let parent_impurity: f32 = dtcf_gini_from_counts(total_counts, n_classes, n_indices)
    free(total_counts as ptr<void>)

    let sort_values: ptr<f32> = array_new_f32(n_indices)
    let sort_classes: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let left_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>
    let right_counts: ptr<i32> = malloc((n_classes as i64) * 4) as ptr<i32>

    for f in 0 to X.cols {
        for i in 0 to n_indices {
            sort_values[i] = matrix_at(X, indices[i], f)
            sort_classes[i] = class_idx[i]
        }
        dtcf_sort_pairs(sort_values, sort_classes, n_indices)

        for c in 0 to n_classes {
            left_counts[c] = 0
            right_counts[c] = 0
        }
        for i in 0 to n_indices {
            right_counts[sort_classes[i]] = right_counts[sort_classes[i]] + 1
        }

        for i in 0 to n_indices - 1 {
            left_counts[sort_classes[i]] = left_counts[sort_classes[i]] + 1
            right_counts[sort_classes[i]] = right_counts[sort_classes[i]] - 1

            if sort_values[i] == sort_values[i + 1] { continue }

            let n_left: i32 = i + 1
            let n_right: i32 = n_indices - n_left
            if n_left < 1 || n_right < 1 { continue }

            let gini_left: f32 = dtcf_gini_from_counts(left_counts, n_classes, n_left)
            let gini_right: f32 = dtcf_gini_from_counts(right_counts, n_classes, n_right)
            let nf: f32 = n_indices as f32
            let weighted: f32 = (n_left as f32) / nf * gini_left + (n_right as f32) / nf * gini_right

            if weighted < best_impurity {
                best_impurity = weighted
                best_feature = f
                best_threshold = (sort_values[i] + sort_values[i + 1]) / 2.0
            }
        }
    }

    array_free_f32(sort_values)
    free(sort_classes as ptr<void>)
    free(left_counts as ptr<void>)
    free(right_counts as ptr<void>)
    free(class_idx as ptr<void>)

    if best_feature < 0 || best_impurity >= parent_impurity - 0.0000000001 {
        let y_sub: ptr<f32> = array_new_f32(n_indices)
        for i in 0 to n_indices { y_sub[i] = y[indices[i]] }
        nodes[node_idx].is_leaf = true
        nodes[node_idx].value = dtcf_majority_class(y_sub, n_indices, classes, n_classes)
        nodes[node_idx].n_samples = n_indices
        nodes[node_idx].left = -1
        nodes[node_idx].right = -1
        nodes[node_idx].impurity = parent_impurity
        array_free_f32(y_sub)
        return node_idx
    }

    let left_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let right_indices: ptr<i32> = malloc((n_indices as i64) * 4) as ptr<i32>
    let mut left_n: i32 = 0
    let mut right_n: i32 = 0

    for i in 0 to n_indices {
        if matrix_at(X, indices[i], best_feature) <= best_threshold {
            left_indices[left_n] = indices[i]
            left_n = left_n + 1
        } else {
            right_indices[right_n] = indices[i]
            right_n = right_n + 1
        }
    }

    nodes[node_idx].is_leaf = false
    nodes[node_idx].feature = best_feature
    nodes[node_idx].threshold = best_threshold
    nodes[node_idx].n_samples = n_indices
    nodes[node_idx].impurity = parent_impurity

    let left_idx: i32 = dtcf_build(nodes, n_nodes, X, y, left_indices, left_n, depth + 1, max_depth, criterion, classes, n_classes)
    let right_idx: i32 = dtcf_build(nodes, n_nodes, X, y, right_indices, right_n, depth + 1, max_depth, criterion, classes, n_classes)

    nodes[node_idx].left = left_idx
    nodes[node_idx].right = right_idx

    free(left_indices as ptr<void>)
    free(right_indices as ptr<void>)

    return node_idx
}

function dtcf_reference_fit(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, criterion: i32) -> DecisionTreeClassifier {
    let found_classes: DistinctF32 = distinct_f32(y, X.rows, n_classes)
    let classes: ptr<f32> = found_classes.values

    let max_nodes: i32 = 2 * X.rows + 1
    let nodes: ptr<TreeNode> = calloc(max_nodes as i64, 36) as ptr<TreeNode>
    let n_nodes_ptr: ptr<i32> = malloc(4) as ptr<i32>
    n_nodes_ptr[0] = 0

    let indices: ptr<i32> = malloc((X.rows as i64) * 4) as ptr<i32>
    for i in 0 to X.rows { indices[i] = i }

    let final_n: i32 = dtcf_build(nodes, n_nodes_ptr, X, y, indices, X.rows, 0, max_depth, criterion, classes, n_classes)

    free(indices as ptr<void>)
    let n_nodes: i32 = n_nodes_ptr[0]
    free(n_nodes_ptr as ptr<void>)

    return DecisionTreeClassifier {
        nodes: nodes,
        n_nodes: n_nodes,
        max_depth: max_depth,
        criterion: criterion,
        n_classes: n_classes,
        classes: classes,
        fitted: true
    }
}

# --------------------------------------------------------------------------

function dtcf_same_tree(a: DecisionTreeClassifier, b: DecisionTreeClassifier) -> bool {
    if a.n_nodes != b.n_nodes { return false }
    if a.n_classes != b.n_classes { return false }
    if a.max_depth != b.max_depth { return false }
    if a.criterion != b.criterion { return false }
    for c in 0 to a.n_classes {
        if a.classes[c] != b.classes[c] { return false }
    }
    for k in 0 to a.n_nodes {
        let na: ptr<TreeNode> = a.nodes + k
        let nb: ptr<TreeNode> = b.nodes + k
        if na.feature != nb.feature { return false }
        if na.threshold != nb.threshold { return false }
        if na.left != nb.left { return false }
        if na.right != nb.right { return false }
        if na.is_leaf != nb.is_leaf { return false }
        if na.value != nb.value { return false }
        if na.n_samples != nb.n_samples { return false }
        if na.impurity != nb.impurity { return false }
    }
    return true
}

function dtcf_same_preds(a: ptr<f32>, b: ptr<f32>, n: i32) -> bool {
    for i in 0 to n {
        if a[i] != b[i] { return false }
    }
    return true
}

function dtcf_accuracy(preds: ptr<f32>, y: ptr<f32>, n: i32) -> f32 {
    let mut hits: i32 = 0
    for i in 0 to n {
        if preds[i] == y[i] { hits = hits + 1 }
    }
    return (hits as f32) / (n as f32)
}

function dtcf_check_case(X: Matrix, y: ptr<f32>, n_classes: i32, max_depth: i32, label: string) -> i32 {
    let reference: DecisionTreeClassifier = dtcf_reference_fit(X, y, n_classes, max_depth, CRITERION_GINI)
    let optimized: DecisionTreeClassifier = decision_tree_classifier_fit(X, y, n_classes, max_depth, CRITERION_GINI)

    if not dtcf_same_tree(reference, optimized) {
        print("FAIL: fitted tree differs for ")
        println(label)
        return 1
    }

    let p_ref: ptr<f32> = decision_tree_classifier_predict(reference, X)
    let p_opt: ptr<f32> = decision_tree_classifier_predict(optimized, X)
    if not dtcf_same_preds(p_ref, p_opt, X.rows) {
        print("FAIL: predictions differ for ")
        println(label)
        return 1
    }
    array_free_f32(p_ref)
    array_free_f32(p_opt)

    decision_tree_classifier_free(reference)
    decision_tree_classifier_free(optimized)
    print("ok: ")
    println(label)
    return 0
}

function main() -> i32 {
    # ---------------------------------------------------------------
    # 1. Realistic workload: digits, 1797 x 64, depth 10.
    # ---------------------------------------------------------------
    let digits: Dataset = load_digits()
    let reference: DecisionTreeClassifier = dtcf_reference_fit(digits.X, digits.y, 10, 10, CRITERION_GINI)
    let optimized: DecisionTreeClassifier = decision_tree_classifier_fit(digits.X, digits.y, 10, 10, CRITERION_GINI)

    if not dtcf_same_tree(reference, optimized) {
        println("FAIL: digits tree is not identical to the pre-optimization builder")
        return 1
    }

    let p_ref: ptr<f32> = decision_tree_classifier_predict(reference, digits.X)
    let p_opt: ptr<f32> = decision_tree_classifier_predict(optimized, digits.X)
    if not dtcf_same_preds(p_ref, p_opt, digits.X.rows) {
        println("FAIL: digits predictions diverged")
        return 1
    }
    let acc: f32 = dtcf_accuracy(p_opt, digits.y, digits.X.rows)
    if acc < 0.9 {
        println("FAIL: digits training accuracy collapsed")
        return 1
    }
    printf("DecisionTreeClassifier fit digits: train accuracy=%.6f n_nodes=%d\n", acc as f64, optimized.n_nodes)
    array_free_f32(p_ref)
    array_free_f32(p_opt)
    decision_tree_classifier_free(reference)
    decision_tree_classifier_free(optimized)

    # ---------------------------------------------------------------
    # 2. A/B timing on the same workload.
    # ---------------------------------------------------------------
    let repeats: i32 = 3
    let start_reference: i64 = dtcf_now_ns()
    for r in 0 to repeats {
        let m: DecisionTreeClassifier = dtcf_reference_fit(digits.X, digits.y, 10, 10, CRITERION_GINI)
        decision_tree_classifier_free(m)
    }
    let end_reference: i64 = dtcf_now_ns()

    let start_optimized: i64 = dtcf_now_ns()
    for r in 0 to repeats {
        let m: DecisionTreeClassifier = decision_tree_classifier_fit(digits.X, digits.y, 10, 10, CRITERION_GINI)
        decision_tree_classifier_free(m)
    }
    let end_optimized: i64 = dtcf_now_ns()

    let reference_ms: f64 = ((end_reference - start_reference) as f64) / 1000000.0 / (repeats as f64)
    let optimized_ms: f64 = ((end_optimized - start_optimized) as f64) / 1000000.0 / (repeats as f64)
    printf("DecisionTreeClassifier fit A/B (digits): reference=%.3f ms optimized=%.3f ms speedup=%.3fx\n", reference_ms, optimized_ms, reference_ms / optimized_ms)

    # ---------------------------------------------------------------
    # 3. iris, a small shape.
    # ---------------------------------------------------------------
    let iris: Dataset = load_iris()
    if dtcf_check_case(iris.X, iris.y, 3, 5, "iris 150x4 depth 5") != 0 { return 1 }

    # ---------------------------------------------------------------
    # 4. Edge cases.
    # ---------------------------------------------------------------

    # A single row. The root stops immediately.
    let X1: Matrix = matrix_new(1, 3)
    matrix_set(X1, 0, 0, 1.0); matrix_set(X1, 0, 1, 2.0); matrix_set(X1, 0, 2, 3.0)
    let y1: ptr<f32> = array_new_f32(1)
    y1[0] = 1.0
    if dtcf_check_case(X1, y1, 2, 4, "single row") != 0 { return 1 }
    let t1: DecisionTreeClassifier = decision_tree_classifier_fit(X1, y1, 2, 4, CRITERION_GINI)
    if t1.n_nodes != 1 || not t1.nodes[0].is_leaf {
        println("FAIL: single row did not produce a single leaf")
        return 1
    }
    decision_tree_classifier_free(t1)

    # Every column constant. No candidate exists, so the root is a leaf.
    let Xc: Matrix = matrix_new(6, 3)
    let yc: ptr<f32> = array_new_f32(6)
    for i in 0 to 6 {
        matrix_set(Xc, i, 0, 4.0)
        matrix_set(Xc, i, 1, -1.0)
        matrix_set(Xc, i, 2, 0.0)
        yc[i] = (i % 2) as f32
    }
    if dtcf_check_case(Xc, yc, 2, 4, "all columns constant") != 0 { return 1 }
    let tc: DecisionTreeClassifier = decision_tree_classifier_fit(Xc, yc, 2, 4, CRITERION_GINI)
    if tc.n_nodes != 1 || not tc.nodes[0].is_leaf {
        println("FAIL: an all-constant X did not produce a single leaf")
        return 1
    }
    decision_tree_classifier_free(tc)

    # A single class. The root splits nothing because parent impurity is 0.
    let Xs: Matrix = matrix_new(8, 2)
    let ys: ptr<f32> = array_new_f32(8)
    for i in 0 to 8 {
        matrix_set(Xs, i, 0, i as f32)
        matrix_set(Xs, i, 1, (8 - i) as f32)
        ys[i] = 7.0
    }
    if dtcf_check_case(Xs, ys, 1, 4, "single class") != 0 { return 1 }
    let ts: DecisionTreeClassifier = decision_tree_classifier_fit(Xs, ys, 1, 4, CRITERION_GINI)
    if ts.n_nodes != 1 || not ts.nodes[0].is_leaf || ts.nodes[0].value != 7.0 {
        println("FAIL: a single-class fit did not produce one leaf holding that class")
        return 1
    }
    decision_tree_classifier_free(ts)

    # A constant column sitting in front of a useful one. The constant column
    # is skipped rather than evaluated, and column 1 is chosen.
    let Xk: Matrix = matrix_new(6, 2)
    let yk: ptr<f32> = array_new_f32(6)
    for i in 0 to 6 {
        matrix_set(Xk, i, 0, 2.5)
        matrix_set(Xk, i, 1, i as f32)
        if i < 3 { yk[i] = 0.0 } else { yk[i] = 1.0 }
    }
    if dtcf_check_case(Xk, yk, 2, 4, "constant column before a useful one") != 0 { return 1 }
    let tk: DecisionTreeClassifier = decision_tree_classifier_fit(Xk, yk, 2, 4, CRITERION_GINI)
    if tk.nodes[0].is_leaf || tk.nodes[0].feature != 1 || tk.nodes[0].threshold != 2.5 {
        println("FAIL: the constant column was not skipped in favour of column 1")
        return 1
    }
    decision_tree_classifier_free(tk)

    # Duplicate feature values carrying different labels. The scan must not
    # split inside a run of equal values, so the only candidate is the
    # boundary between 1.0 and 2.0.
    let Xd: Matrix = matrix_new(6, 1)
    let yd: ptr<f32> = array_new_f32(6)
    matrix_set(Xd, 0, 0, 1.0); yd[0] = 0.0
    matrix_set(Xd, 1, 0, 1.0); yd[1] = 1.0
    matrix_set(Xd, 2, 0, 1.0); yd[2] = 0.0
    matrix_set(Xd, 3, 0, 2.0); yd[3] = 1.0
    matrix_set(Xd, 4, 0, 2.0); yd[4] = 1.0
    matrix_set(Xd, 5, 0, 2.0); yd[5] = 1.0
    if dtcf_check_case(Xd, yd, 2, 3, "ties inside a column") != 0 { return 1 }
    let td: DecisionTreeClassifier = decision_tree_classifier_fit(Xd, yd, 2, 3, CRITERION_GINI)
    if td.nodes[0].is_leaf || td.nodes[0].threshold != 1.5 {
        println("FAIL: the split did not land between the two runs of equal values")
        return 1
    }
    decision_tree_classifier_free(td)

    # Two rows, identical features, different labels. Nothing separates them.
    let Xt: Matrix = matrix_new(2, 2)
    let yt: ptr<f32> = array_new_f32(2)
    matrix_set(Xt, 0, 0, 3.0); matrix_set(Xt, 0, 1, 4.0); yt[0] = 0.0
    matrix_set(Xt, 1, 0, 3.0); matrix_set(Xt, 1, 1, 4.0); yt[1] = 1.0
    if dtcf_check_case(Xt, yt, 2, 4, "two identical rows, different labels") != 0 { return 1 }

    println("PASS: DecisionTreeClassifier.fit is unchanged node for node after #396")
    return 0
}
