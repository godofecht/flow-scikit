# Regression test for the LabelPropagation.fit optimization (roadmap rank 93,
# issue #302).
#
# The affinity build now fills only the strict upper triangle and mirrors it,
# indexes X.data directly, normalizes the transition matrix in place over W
# instead of allocating a second n x n buffer, and allocates the propagation
# scratch buffer once instead of once per iteration. All of that is meant to be
# bit-identical, so this test carries a copy of the pre-optimization fit and
# compares the fitted label distributions element by element, plus the hard
# labels and the iteration count.
#
# The iteration count and convergence criterion are deliberately untouched, so
# n_iter must match the reference exactly on every case.

import "lib/scikit/semi_supervised.flow"

extern {
    function timespec_get(ts: ptr<i64>, base: i32) -> i32
}

const OPTLP_TIME_UTC: i32 = 1

function optlp_now_ns() -> i64 {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    timespec_get(ts, OPTLP_TIME_UTC)
    let value: i64 = ts[0] * 1000000000 + ts[1]
    free(ts as ptr<void>)
    return value
}

# Copy of the pre-optimization affinity build: full double loop, matrix_at per
# element, no symmetry.
function optlp_reference_affinity(X: Matrix, gamma: f32) -> ptr<ptr<f32> > {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let W: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        W[i] = array_new_f32(n)
    }
    for i in 0 to n {
        for j in 0 to n {
            let mut s: f32 = 0.0
            for k in 0 to p {
                let d: f32 = matrix_at(X, i, k) - matrix_at(X, j, k)
                s = s + d * d
            }
            W[i][j] = exp((-gamma * s) as f64) as f32
        }
    }
    return W
}

# Copy of the pre-optimization label_propagation_fit. Writes the hard labels
# into out_labels and out_n_iter[0], and returns the label distributions.
function optlp_reference_fit(X: Matrix, y: ptr<i32>, n_classes: i32, gamma: f32, max_iter: i32, tol: f32, out_labels: ptr<i32>, out_n_iter: ptr<i32>) -> ptr<ptr<f32> > {
    let n: i32 = X.rows

    let W: ptr<ptr<f32> > = optlp_reference_affinity(X, gamma)

    let mut deg: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        for j in 0 to n {
            deg[i] = deg[i] + W[i][j]
        }
        if deg[i] < 0.0000000001 {
            deg[i] = 1.0
            for j in 0 to n {
                W[i][j] = 1.0 / (n as f32)
            }
        }
    }

    let T: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        T[i] = array_new_f32(n)
        for j in 0 to n {
            T[i][j] = W[i][j] / deg[i]
        }
    }

    let Y: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    let clamp: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n {
        Y[i] = array_new_f32(n_classes)
        clamp[i] = array_new_f32(n_classes)
        if y[i] >= 0 && y[i] < n_classes {
            clamp[i][y[i]] = 1.0
            Y[i][y[i]] = 1.0
        }
    }

    let mut n_iter: i32 = 0
    for iter in 0 to max_iter {
        n_iter = iter + 1
        let mut max_change: f32 = 0.0

        let new_Y: ptr<ptr<f32> > = malloc((n as i64) * 8) as ptr<ptr<f32> >
        for i in 0 to n {
            new_Y[i] = array_new_f32(n_classes)
        }

        for i in 0 to n {
            for c in 0 to n_classes {
                let mut s: f32 = 0.0
                for j in 0 to n {
                    s = s + T[i][j] * Y[j][c]
                }
                new_Y[i][c] = s
            }
        }

        for i in 0 to n {
            if y[i] >= 0 {
                for c in 0 to n_classes {
                    new_Y[i][c] = clamp[i][c]
                }
            }
            for c in 0 to n_classes {
                let change: f32 = fabs((new_Y[i][c] - Y[i][c]) as f64) as f32
                if change > max_change { max_change = change }
                Y[i][c] = new_Y[i][c]
            }
            array_free_f32(new_Y[i])
        }
        free(new_Y as ptr<void>)

        if max_change < tol { break }
    }

    for i in 0 to n {
        let mut best_c: i32 = 0
        let mut best_val: f32 = -9999999999.0
        for c in 0 to n_classes {
            if Y[i][c] > best_val {
                best_val = Y[i][c]
                best_c = c
            }
        }
        out_labels[i] = best_c
    }

    for i in 0 to n {
        array_free_f32(W[i])
        array_free_f32(T[i])
        array_free_f32(clamp[i])
    }
    free(W as ptr<void>)
    free(T as ptr<void>)
    free(clamp as ptr<void>)
    array_free_f32(deg)

    out_n_iter[0] = n_iter
    return Y
}

function optlp_free_rows(Y: ptr<ptr<f32> >, n: i32) -> void {
    for i in 0 to n {
        array_free_f32(Y[i])
    }
    free(Y as ptr<void>)
}

function optlp_case(name: string, n: i32, p: i32, n_classes: i32, gamma: f32, max_iter: i32, tol: f32, label_every: i32, degenerate: i32) -> i32 {
    let X: Matrix = matrix_new(n, p)
    let y: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let mut seed: i32 = 29
    for i in 0 to n {
        for j in 0 to p {
            seed = (seed * 1103515245 + 12345) % 100000
            if degenerate == 1 {
                # Identical rows: every pairwise distance is zero, so every
                # affinity is exactly 1 and the symmetry mirror is exercised on
                # a fully saturated matrix.
                matrix_set(X, i, j, 0.5)
            } else {
                matrix_set(X, i, j, (seed as f32) / 50000.0 - 1.0)
            }
        }
        if i % label_every == 0 {
            y[i] = i % n_classes
        } else {
            y[i] = -1
        }
    }

    let ref_labels: ptr<i32> = malloc((n as i64) * 4) as ptr<i32>
    let ref_iter: ptr<i32> = malloc(16) as ptr<i32>
    let ref_Y: ptr<ptr<f32> > = optlp_reference_fit(X, y, n_classes, gamma, max_iter, tol, ref_labels, ref_iter)

    let model: LabelPropagation = label_propagation_fit(X, y, n_classes, gamma, max_iter, tol)

    let mut bad: i32 = 0
    if model.n_iter != ref_iter[0] {
        bad = bad + 1
        printf("  MISMATCH %s n_iter got %d want %d\n", name, model.n_iter, ref_iter[0])
    }
    for i in 0 to n {
        if model.labels[i] != ref_labels[i] {
            bad = bad + 1
            printf("  MISMATCH %s label row %d got %d want %d\n", name, i, model.labels[i], ref_labels[i])
        }
        for c in 0 to n_classes {
            if model.label_distributions[i][c] != ref_Y[i][c] {
                bad = bad + 1
                if bad < 10 {
                    printf("  MISMATCH %s dist row %d class %d got %.9f want %.9f\n", name, i, c, model.label_distributions[i][c] as f64, ref_Y[i][c] as f64)
                }
            }
        }
    }

    # predict and predict_proba must also line up. Probabilities are the
    # reference distributions put through the same normalization the library
    # applies, including its all-zero-row fallback, so the comparison is exact.
    let pred: ptr<i32> = label_propagation_predict(model)
    let proba: ptr<ptr<f32> > = label_propagation_predict_proba(model)
    for i in 0 to n {
        if pred[i] != ref_labels[i] {
            bad = bad + 1
            printf("  MISMATCH %s predict row %d got %d want %d\n", name, i, pred[i], ref_labels[i])
        }
        let mut s: f32 = 0.0
        for c in 0 to n_classes {
            s = s + ref_Y[i][c]
        }
        if s < 0.0000000001 { s = 1.0 }
        for c in 0 to n_classes {
            let want: f32 = ref_Y[i][c] / s
            if proba[i][c] != want {
                bad = bad + 1
                if bad < 10 {
                    printf("  MISMATCH %s proba row %d class %d got %.9f want %.9f\n", name, i, c, proba[i][c] as f64, want as f64)
                }
            }
        }
    }

    if bad == 0 {
        printf("  ok %s (n_iter %d)\n", name, model.n_iter)
    }

    optlp_free_rows(proba, n)
    free(pred as ptr<void>)
    optlp_free_rows(ref_Y, n)
    free(ref_labels as ptr<void>)
    free(ref_iter as ptr<void>)
    label_propagation_free(model)
    matrix_free(X)
    free(y as ptr<void>)
    return bad
}

function main() -> i32 {
    printf("test_opt_labelpropagation_fit\n")
    let mut failures: i32 = 0

    # Small, every sample labelled.
    failures = failures + optlp_case("all_labelled_12x3", 12, 3, 3, 0.5, 30, 0.001, 1, 0)
    # Mixed labelled and unlabelled, converges early.
    failures = failures + optlp_case("mixed_60x6", 60, 6, 4, 0.5, 50, 0.001, 4, 0)
    # Tight tolerance, runs many iterations.
    failures = failures + optlp_case("many_iters_80x4", 80, 4, 5, 0.5, 200, 0.0000001, 3, 0)
    # Degenerate: all rows identical, affinity saturated at 1 everywhere.
    failures = failures + optlp_case("identical_rows_20x3", 20, 3, 3, 0.5, 40, 0.001, 5, 1)
    # Single sample.
    failures = failures + optlp_case("single_sample", 1, 3, 2, 0.5, 10, 0.001, 1, 0)
    # Wide feature count, the case the affinity build is heaviest on.
    failures = failures + optlp_case("wide_100x40", 100, 40, 3, 0.5, 30, 0.001, 4, 0)

    # LabelSpreading shares _build_affinity, so it must be unaffected. Fit it and
    # check the distributions are finite and the rows are a valid distribution.
    let ns: i32 = 40
    let ps: i32 = 5
    let Xs: Matrix = matrix_new(ns, ps)
    let ys: ptr<i32> = malloc((ns as i64) * 4) as ptr<i32>
    let mut seed: i32 = 91
    for i in 0 to ns {
        for j in 0 to ps {
            seed = (seed * 1103515245 + 12345) % 100000
            matrix_set(Xs, i, j, (seed as f32) / 50000.0 - 1.0)
        }
        if i % 3 == 0 { ys[i] = i % 3 } else { ys[i] = -1 }
    }
    let spread: LabelSpreading = label_spreading_fit(Xs, ys, 3, 0.5, 0.2, 30, 0.001)
    for i in 0 to ns {
        if spread.labels[i] < 0 || spread.labels[i] >= 3 {
            failures = failures + 1
            printf("  MISMATCH label_spreading row %d label %d out of range\n", i, spread.labels[i])
        }
    }
    printf("  ok label_spreading unaffected (n_iter %d)\n", spread.n_iter)
    label_spreading_free(spread)
    matrix_free(Xs)
    free(ys as ptr<void>)

    # Timing on a realistic workload, reported for the record.
    let nb: i32 = 300
    let pb: i32 = 20
    let Xb: Matrix = matrix_new(nb, pb)
    let yb: ptr<i32> = malloc((nb as i64) * 4) as ptr<i32>
    for i in 0 to nb {
        for j in 0 to pb {
            seed = (seed * 1103515245 + 12345) % 100000
            Xb.data[i * pb + j] = (seed as f32) / 50000.0 - 1.0
        }
        if i % 4 == 0 { yb[i] = i % 3 } else { yb[i] = -1 }
    }
    let reps: i32 = 5
    let t0: i64 = optlp_now_ns()
    for r in 0 to reps {
        let m: LabelPropagation = label_propagation_fit(Xb, yb, 3, 0.5, 30, 0.001)
        label_propagation_free(m)
    }
    let t1: i64 = optlp_now_ns()
    printf("  fit 300 by 20, 3 classes: %f ms per call\n", ((t1 - t0) as f64) / 1000000.0 / (reps as f64))
    matrix_free(Xb)
    free(yb as ptr<void>)

    if failures == 0 {
        printf("PASS test_opt_labelpropagation_fit\n")
        return 0
    }
    printf("FAIL test_opt_labelpropagation_fit: %d mismatches\n", failures)
    return 1
}
