# Tests for isotonic regression, kernel ridge, PLS, and t-SNE.
# Run: ./flow run tests/test_new_modules.flow

import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

function make_regression_data() -> Dataset {
    let n: i32 = 50
    let X: Matrix = matrix_new(n, 3)
    let y: ptr<f32> = array_new_f32(n)

    srand(42)
    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        let x2: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        matrix_set(X, i, 2, x2)
        y[i] = 2.0 * x0 + 3.0 * x1 - x2 + 1.0
    }

    return Dataset { X: X, y: y, n_samples: n, n_features: 3, n_classes: 0, is_classification: false }
}

function make_monotonic_data() -> Dataset {
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 1)
    let y: ptr<f32> = array_new_f32(n)

    srand(123)
    for i in 0 to n {
        let x: f32 = (i as f32) * 0.3
        matrix_set(X, i, 0, x)
        y[i] = x * 0.5 + ((rand() % 10) as f32) / 50.0 - 0.1
    }

    return Dataset { X: X, y: y, n_samples: n, n_features: 1, n_classes: 0, is_classification: false }
}

function make_multitarget_data() -> Dataset {
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 3)
    let y: ptr<f32> = array_new_f32(n * 2)

    srand(77)
    for i in 0 to n {
        let x0: f32 = ((rand() % 100) as f32) / 10.0
        let x1: f32 = ((rand() % 100) as f32) / 10.0
        let x2: f32 = ((rand() % 100) as f32) / 10.0
        matrix_set(X, i, 0, x0)
        matrix_set(X, i, 1, x1)
        matrix_set(X, i, 2, x2)
        y[i * 2] = x0 + x1 + 1.0
        y[i * 2 + 1] = x1 - x2 + 2.0
    }

    return Dataset { X: X, y: y, n_samples: n, n_features: 3, n_classes: 0, is_classification: false }
}

function test_isotonic() -> i32 {
    println("Test: IsotonicRegression")
    let data: Dataset = make_monotonic_data()

    let x_col: ptr<f32> = array_new_f32(data.n_samples)
    for i in 0 to data.n_samples {
        x_col[i] = matrix_at(data.X, i, 0)
    }

    let model: IsotonicRegression = isotonic_fit(x_col, data.y, data.n_samples, true)
    let preds: ptr<f32> = isotonic_predict(model, x_col, data.n_samples)

    let mut is_monotonic: bool = true
    for i in 1 to data.n_samples {
        if x_col[i] > x_col[i - 1] && preds[i] < preds[i - 1] - 0.01 {
            is_monotonic = false
        }
    }

    if !is_monotonic {
        println("  FAIL: predictions should be monotonic")
        return 1
    }

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    let y_mean: f32 = array_mean(data.y, data.n_samples)
    for i in 0 to data.n_samples {
        let d: f32 = data.y[i] - preds[i]
        ss_res = ss_res + d * d
        let d2: f32 = data.y[i] - y_mean
        ss_tot = ss_tot + d2 * d2
    }
    let r2: f32 = 1.0 - ss_res / ss_tot

    if r2 < 0.8 {
        println("  FAIL: R2 should be > 0.8")
        print("  R2 = ")
        printf("%.4f", r2)
        println("")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println(", monotonic = true")

    isotonic_free(model)
    array_free_f32(preds)
    array_free_f32(x_col)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_kernel_ridge_rbf() -> i32 {
    println("Test: KernelRidge (RBF)")
    let data: Dataset = make_regression_data()

    let model: KernelRidge = kernel_ridge_fit(data.X, data.y, 1.0, KERNEL_TYPE_RBF, 0.1, 3, 0.0)
    let preds: ptr<f32> = kernel_ridge_predict(model, data.X)

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    let y_mean: f32 = array_mean(data.y, data.n_samples)
    for i in 0 to data.n_samples {
        let d: f32 = data.y[i] - preds[i]
        ss_res = ss_res + d * d
        let d2: f32 = data.y[i] - y_mean
        ss_tot = ss_tot + d2 * d2
    }
    let r2: f32 = 1.0 - ss_res / ss_tot

    if r2 < 0.7 {
        println("  FAIL: R2 should be > 0.7 for RBF kernel on training data")
        print("  R2 = ")
        printf("%.4f", r2)
        println("")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    kernel_ridge_free(model)
    array_free_f32(preds)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_kernel_ridge_linear() -> i32 {
    println("Test: KernelRidge (linear)")
    let data: Dataset = make_regression_data()

    let model: KernelRidge = kernel_ridge_fit(data.X, data.y, 0.1, KERNEL_TYPE_LINEAR, 1.0, 1, 0.0)
    let preds: ptr<f32> = kernel_ridge_predict(model, data.X)

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    let y_mean: f32 = array_mean(data.y, data.n_samples)
    for i in 0 to data.n_samples {
        let d: f32 = data.y[i] - preds[i]
        ss_res = ss_res + d * d
        let d2: f32 = data.y[i] - y_mean
        ss_tot = ss_tot + d2 * d2
    }
    let r2: f32 = 1.0 - ss_res / ss_tot

    if r2 < 0.8 {
        println("  FAIL: R2 should be > 0.8 for linear kernel on linear data")
        print("  R2 = ")
        printf("%.4f", r2)
        println("")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    kernel_ridge_free(model)
    array_free_f32(preds)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_pls_regression() -> i32 {
    println("Test: PLSRegression")
    let data: Dataset = make_multitarget_data()

    let Y: Matrix = matrix_new(data.n_samples, 2)
    for i in 0 to data.n_samples {
        matrix_set(Y, i, 0, data.y[i * 2])
        matrix_set(Y, i, 1, data.y[i * 2 + 1])
    }

    let model: PLSRegression = pls_fit(data.X, Y, 2, 500, 1e-6)
    let preds: Matrix = pls_predict(model, data.X)

    let mut ss_res: f32 = 0.0
    let mut ss_tot: f32 = 0.0
    for j in 0 to 2 {
        let mut col_mean: f32 = 0.0
        for i in 0 to data.n_samples {
            col_mean = col_mean + matrix_at(Y, i, j)
        }
        col_mean = col_mean / (data.n_samples as f32)
        for i in 0 to data.n_samples {
            let d: f32 = matrix_at(Y, i, j) - matrix_at(preds, i, j)
            ss_res = ss_res + d * d
            let d2: f32 = matrix_at(Y, i, j) - col_mean
            ss_tot = ss_tot + d2 * d2
        }
    }
    let r2: f32 = 1.0 - ss_res / ss_tot

    if r2 < 0.7 {
        println("  FAIL: R2 should be > 0.7 for PLS on training data")
        print("  R2 = ")
        printf("%.4f", r2)
        println("")
        return 1
    }

    print("  OK: R2 = ")
    printf("%.4f", r2)
    println("")

    pls_free(model)
    matrix_free(preds)
    matrix_free(Y)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function test_tsne() -> i32 {
    println("Test: TSNE")
    let data: Dataset = make_regression_data()

    let result: Matrix = tsne_fit_transform(data.X, 2, 10.0, 200.0, 200, 42)

    if result.rows != data.n_samples {
        println("  FAIL: embedding should have same number of samples")
        return 1
    }

    if result.cols != 2 {
        println("  FAIL: embedding should have 2 components")
        return 1
    }

    let mut all_zero: bool = true
    for i in 0 to result.rows {
        for j in 0 to result.cols {
            if fabs(matrix_at(result, i, j) as f64) as f32 > 1e-10 {
                all_zero = false
            }
        }
    }
    if all_zero {
        println("  FAIL: embedding should not be all zeros")
        return 1
    }

    print("  OK: embedding shape = ")
    print(result.rows)
    print("x")
    print(result.cols)
    println("")

    matrix_free(result)
    matrix_free(data.X)
    array_free_f32(data.y)
    return 0
}

function main() -> i32 {
    println("=== New Modules Tests ===")
    println("")

    let mut failures: i32 = 0

    if test_isotonic() != 0 { failures = failures + 1 }
    println("")
    if test_kernel_ridge_linear() != 0 { failures = failures + 1 }
    println("")
    if test_kernel_ridge_rbf() != 0 { failures = failures + 1 }
    println("")
    if test_pls_regression() != 0 { failures = failures + 1 }
    println("")
    if test_tsne() != 0 { failures = failures + 1 }

    println("")
    if failures == 0 {
        println("All new module tests passed!")
        return 0
    }
    print("FAILED: ")
    print(failures)
    println(" tests")
    return 1
}
