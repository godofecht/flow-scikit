# Regression test for the optimized FeatureUnion.transform (roadmap rank 65).
#
# fuopt_reference_transform is a literal copy of the pre-optimization body:
# per-element matrix_set/matrix_at copies and val^d recomputed from scratch for
# every degree. The optimized path must agree with it bit for bit, including
# output column ordering, which callers depend on.
#
# Run: flow run tests/test_opt_featureunion_transform.flow

import "lib/scikit/scikit.flow"

extern {
    function timespec_get(ts: ptr<i64>, base: i32) -> i32
}

const FUOPT_TIME_UTC: i32 = 1

function fuopt_now_ns() -> i64 {
    let ts: ptr<i64> = malloc(16) as ptr<i64>
    timespec_get(ts, FUOPT_TIME_UTC)
    let value: i64 = ts[0] * 1000000000 + ts[1]
    free(ts as ptr<void>)
    return value
}

function fuopt_reference_transform(fu: FeatureUnion, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let p: i32 = X.cols
    let result: Matrix = matrix_new(n, fu.n_output_features)
    let mut out_col: i32 = 0

    let mut s: i32 = 0
    while s < fu.n_transformers {
        if fu.transformer_types[s] == FU_TRANSFORMER_STANDARD_SCALER {
            let transformed: Matrix = standard_scaler_transform(fu.scalers[s], X)
            let mut i: i32 = 0
            while i < n {
                let mut j: i32 = 0
                while j < p {
                    matrix_set(result, i, out_col + j, matrix_at(transformed, i, j))
                    j = j + 1
                }
                i = i + 1
            }
            matrix_free(transformed)
            out_col = out_col + p
        } elif fu.transformer_types[s] == FU_TRANSFORMER_MINMAX_SCALER {
            let transformed: Matrix = minmax_scaler_transform(fu.minmax_scalers[s], X)
            let mut i: i32 = 0
            while i < n {
                let mut j: i32 = 0
                while j < p {
                    matrix_set(result, i, out_col + j, matrix_at(transformed, i, j))
                    j = j + 1
                }
                i = i + 1
            }
            matrix_free(transformed)
            out_col = out_col + p
        } elif fu.transformer_types[s] == FU_TRANSFORMER_PASSTHROUGH {
            let mut i: i32 = 0
            while i < n {
                let mut j: i32 = 0
                while j < p {
                    matrix_set(result, i, out_col + j, matrix_at(X, i, j))
                    j = j + 1
                }
                i = i + 1
            }
            out_col = out_col + p
        } elif fu.transformer_types[s] == FU_TRANSFORMER_POLYNOMIAL {
            let deg: i32 = fu.poly_degrees[s]
            let mut i: i32 = 0
            while i < n {
                let mut j: i32 = 0
                while j < p {
                    let val: f32 = matrix_at(X, i, j)
                    let mut d: i32 = 1
                    while d <= deg {
                        let mut powered: f32 = 1.0
                        let mut k: i32 = 0
                        while k < d {
                            powered = powered * val
                            k = k + 1
                        }
                        matrix_set(result, i, out_col + j * deg + (d - 1), powered)
                        d = d + 1
                    }
                    j = j + 1
                }
                i = i + 1
            }
            out_col = out_col + p * deg
        }
        s = s + 1
    }
    return result
}

# Exact element-wise comparison. Returns the number of differing cells.
function fuopt_count_diffs(a: Matrix, b: Matrix) -> i32 {
    if a.rows != b.rows {
        return -1
    }
    if a.cols != b.cols {
        return -1
    }
    let mut diffs: i32 = 0
    let total: i32 = a.rows * a.cols
    for i in 0 to total {
        if a.data[i] != b.data[i] {
            diffs = diffs + 1
        }
    }
    return diffs
}

function fuopt_make_matrix(n: i32, p: i32) -> Matrix {
    let X: Matrix = matrix_new(n, p)
    let mut s: i64 = 987654321
    for i in 0 to n {
        for j in 0 to p {
            s = (s * 1103515245 + 12345) % 2147483647
            matrix_set(X, i, j, ((s % 1000) as f32) / 100.0 - 5.0)
        }
    }
    return X
}

# Hand-checked values: passthrough then degree-2 polynomial on a 2x2 matrix.
function fuopt_test_known_values() -> i32 {
    println("Test: FeatureUnion.transform known values")
    let X: Matrix = matrix_new(2, 2)
    matrix_set(X, 0, 0, 1.0)
    matrix_set(X, 0, 1, 2.0)
    matrix_set(X, 1, 0, 3.0)
    matrix_set(X, 1, 1, 4.0)

    let fu: FeatureUnion = feature_union_init(2)
    feature_union_set_transformer(fu, 0, FU_TRANSFORMER_PASSTHROUGH, 0)
    feature_union_set_transformer(fu, 1, FU_TRANSFORMER_POLYNOMIAL, 2)
    let fitted: FeatureUnion = feature_union_fit(fu, X)

    if fitted.n_output_features != 6 {
        println("  FAIL: expected 6 output features")
        return 1
    }

    let out: Matrix = feature_union_transform(fitted, X)

    let expected: Matrix = matrix_new(2, 6)
    matrix_set(expected, 0, 0, 1.0)
    matrix_set(expected, 0, 1, 2.0)
    matrix_set(expected, 0, 2, 1.0)
    matrix_set(expected, 0, 3, 1.0)
    matrix_set(expected, 0, 4, 2.0)
    matrix_set(expected, 0, 5, 4.0)
    matrix_set(expected, 1, 0, 3.0)
    matrix_set(expected, 1, 1, 4.0)
    matrix_set(expected, 1, 2, 3.0)
    matrix_set(expected, 1, 3, 9.0)
    matrix_set(expected, 1, 4, 4.0)
    matrix_set(expected, 1, 5, 16.0)

    let diffs: i32 = fuopt_count_diffs(out, expected)
    matrix_free(out)
    matrix_free(expected)
    feature_union_free(fitted)
    matrix_free(X)

    if diffs != 0 {
        println("  FAIL: output differs from hand-checked values")
        return 1
    }
    println("  OK: column order and values match")
    return 0
}

# Constant columns, a single row, and degree 1 and 0 polynomials.
function fuopt_test_edge_cases() -> i32 {
    println("Test: FeatureUnion.transform edge cases")
    let mut failures: i32 = 0

    # Constant columns: std collapses to 1.0, min-max range collapses to 0.0.
    let flat: Matrix = matrix_new(4, 3)
    for i in 0 to 4 {
        for j in 0 to 3 {
            matrix_set(flat, i, j, 2.5)
        }
    }
    let fu_flat: FeatureUnion = feature_union_init(3)
    feature_union_set_transformer(fu_flat, 0, FU_TRANSFORMER_STANDARD_SCALER, 0)
    feature_union_set_transformer(fu_flat, 1, FU_TRANSFORMER_MINMAX_SCALER, 0)
    feature_union_set_transformer(fu_flat, 2, FU_TRANSFORMER_POLYNOMIAL, 1)
    let flat_fitted: FeatureUnion = feature_union_fit(fu_flat, flat)
    let flat_opt: Matrix = feature_union_transform(flat_fitted, flat)
    let flat_ref: Matrix = fuopt_reference_transform(flat_fitted, flat)
    if fuopt_count_diffs(flat_opt, flat_ref) != 0 {
        println("  FAIL: constant-column output differs from reference")
        failures = failures + 1
    }
    if matrix_at(flat_opt, 0, 0) != 0.0 {
        println("  FAIL: constant column should scale to 0.0")
        failures = failures + 1
    }
    if matrix_at(flat_opt, 0, 3) != 0.0 {
        println("  FAIL: zero-range min-max column should be 0.0")
        failures = failures + 1
    }
    if matrix_at(flat_opt, 0, 6) != 2.5 {
        println("  FAIL: degree-1 polynomial should reproduce the input")
        failures = failures + 1
    }
    matrix_free(flat_opt)
    matrix_free(flat_ref)
    feature_union_free(flat_fitted)
    matrix_free(flat)

    # Single row.
    let one: Matrix = matrix_new(1, 4)
    for j in 0 to 4 {
        matrix_set(one, 0, j, (j as f32) - 1.5)
    }
    let fu_one: FeatureUnion = feature_union_init(2)
    feature_union_set_transformer(fu_one, 0, FU_TRANSFORMER_MINMAX_SCALER, 0)
    feature_union_set_transformer(fu_one, 1, FU_TRANSFORMER_POLYNOMIAL, 4)
    let one_fitted: FeatureUnion = feature_union_fit(fu_one, one)
    let one_opt: Matrix = feature_union_transform(one_fitted, one)
    let one_ref: Matrix = fuopt_reference_transform(one_fitted, one)
    if fuopt_count_diffs(one_opt, one_ref) != 0 {
        println("  FAIL: single-row output differs from reference")
        failures = failures + 1
    }
    matrix_free(one_opt)
    matrix_free(one_ref)
    feature_union_free(one_fitted)
    matrix_free(one)

    # Degree 0 contributes no columns at all.
    let zero: Matrix = fuopt_make_matrix(5, 3)
    let fu_zero: FeatureUnion = feature_union_init(2)
    feature_union_set_transformer(fu_zero, 0, FU_TRANSFORMER_POLYNOMIAL, 0)
    feature_union_set_transformer(fu_zero, 1, FU_TRANSFORMER_PASSTHROUGH, 0)
    let zero_fitted: FeatureUnion = feature_union_fit(fu_zero, zero)
    if zero_fitted.n_output_features != 3 {
        println("  FAIL: degree-0 polynomial should contribute no columns")
        failures = failures + 1
    }
    let zero_opt: Matrix = feature_union_transform(zero_fitted, zero)
    let zero_ref: Matrix = fuopt_reference_transform(zero_fitted, zero)
    if fuopt_count_diffs(zero_opt, zero_ref) != 0 {
        println("  FAIL: degree-0 output differs from reference")
        failures = failures + 1
    }
    matrix_free(zero_opt)
    matrix_free(zero_ref)
    feature_union_free(zero_fitted)
    matrix_free(zero)

    if failures == 0 {
        println("  OK: edge cases match the reference")
    }
    return failures
}

# Realistic workload: every branch active, exact parity plus an A/B timing.
function fuopt_test_workload() -> i32 {
    println("Test: FeatureUnion.transform realistic workload")
    let n: i32 = 800
    let p: i32 = 16
    let X: Matrix = fuopt_make_matrix(n, p)

    let fu: FeatureUnion = feature_union_init(4)
    feature_union_set_transformer(fu, 0, FU_TRANSFORMER_STANDARD_SCALER, 0)
    feature_union_set_transformer(fu, 1, FU_TRANSFORMER_MINMAX_SCALER, 0)
    feature_union_set_transformer(fu, 2, FU_TRANSFORMER_PASSTHROUGH, 0)
    feature_union_set_transformer(fu, 3, FU_TRANSFORMER_POLYNOMIAL, 3)
    let fitted: FeatureUnion = feature_union_fit(fu, X)

    if fitted.n_output_features != 6 * p {
        println("  FAIL: unexpected output width")
        return 1
    }

    let opt: Matrix = feature_union_transform(fitted, X)
    let reference: Matrix = fuopt_reference_transform(fitted, X)
    let diffs: i32 = fuopt_count_diffs(opt, reference)
    if diffs != 0 {
        printf("  FAIL: %d cells differ from the reference\n", diffs)
        return 1
    }

    let repeats: i32 = 20
    let start_ref: i64 = fuopt_now_ns()
    for r in 0 to repeats {
        let out_ref: Matrix = fuopt_reference_transform(fitted, X)
        matrix_free(out_ref)
    }
    let end_ref: i64 = fuopt_now_ns()

    let start_opt: i64 = fuopt_now_ns()
    for r in 0 to repeats {
        let out_opt: Matrix = feature_union_transform(fitted, X)
        matrix_free(out_opt)
    }
    let end_opt: i64 = fuopt_now_ns()

    let ref_ms: f64 = ((end_ref - start_ref) as f64) / 1000000.0
    let opt_ms: f64 = ((end_opt - start_opt) as f64) / 1000000.0
    let speedup: f64 = ref_ms / opt_ms
    printf("FeatureUnion.transform A/B: reference=%.6f ms optimized=%.6f ms speedup=%.3fx\n", ref_ms, opt_ms, speedup)

    matrix_free(opt)
    matrix_free(reference)
    feature_union_free(fitted)
    matrix_free(X)
    println("  OK: 76800 cells identical to the reference")
    return 0
}

function main() -> i32 {
    let mut failures: i32 = 0
    failures = failures + fuopt_test_known_values()
    failures = failures + fuopt_test_edge_cases()
    failures = failures + fuopt_test_workload()

    println("")
    if failures != 0 {
        println("FAILED: FeatureUnion.transform optimization regression test")
        return 1
    }
    println("All FeatureUnion.transform optimization tests passed!")
    return 0
}
