function test_ledoit_wolf_shrinkage() -> i32 {
    println("Test: LedoitWolf shrinkage estimation (#34660)")
    let n: i32 = 50
    let p: i32 = 3
    let X: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(X, i, j, _noise(i * p + j) * 2.0)
        }
    }

    let shrinkage: f32 = ledoit_wolf_estimate(X)

    if shrinkage < 0.0 || shrinkage > 1.0 {
        println("  FAIL: shrinkage should be in [0, 1], got ")
        print(shrinkage)
        println("")
        matrix_free(X)
        return 1
    }

    # With random noise data, shrinkage should be positive
    if shrinkage < 0.001 {
        println("  FAIL: shrinkage too close to 0 for noisy data")
        matrix_free(X)
        return 1
    }

    println("  OK: shrinkage = ")
    print(shrinkage)
    println(" (in [0, 1])")
    matrix_free(X)
    return 0
}

function test_ledoit_wolf_weighted() -> i32 {
    println("Test: LedoitWolf weighted shrinkage (#34660)")
    let n: i32 = 50
    let p: i32 = 3
    let X: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(X, i, j, _noise(i * p + j) * 2.0)
        }
    }

    let weights: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        weights[i] = 1.0
    }
    # Give some samples higher weight
    for i in 0 to 10 {
        weights[i] = 5.0
    }

    let shrinkage: f32 = ledoit_wolf_estimate_weighted(X, weights)

    if shrinkage < 0.0 || shrinkage > 1.0 {
        println("  FAIL: weighted shrinkage should be in [0, 1], got ")
        print(shrinkage)
        println("")
        matrix_free(X)
        array_free_f32(weights)
        return 1
    }

    # Test that weighted fit produces a valid covariance
    let model: ShrunkCovariance = ledoit_wolf_fit_weighted(X, weights)
    if not model.fitted {
        println("  FAIL: weighted fit did not set fitted=true")
        shrunk_covariance_free(model)
        matrix_free(X)
        array_free_f32(weights)
        return 1
    }

    # Check covariance is symmetric and diagonal is positive
    let mut ok: bool = true
    for i in 0 to p {
        if model.covariance[i][i] < 0.0 {
            ok = false
        }
        for j in 0 to p {
            let diff: f32 = model.covariance[i][j] - model.covariance[j][i]
            if fabs((diff) as f64) as f32 > 1e-5 {
                ok = false
            }
        }
    }

    if not ok {
        println("  FAIL: covariance not symmetric or diagonal not positive")
        shrunk_covariance_free(model)
        matrix_free(X)
        array_free_f32(weights)
        return 1
    }

    println("  OK: weighted shrinkage = ")
    print(shrinkage)
    println(", covariance is symmetric with positive diagonal")
    shrunk_covariance_free(model)
    matrix_free(X)
    array_free_f32(weights)
    return 0
}

function test_gradient_boosting_regressor_feature_importances() -> i32 {
    println("Test: GradientBoostingRegressor feature_importances_ (#34472)")
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let xv: f32 = (i as f32) * 0.1
        matrix_set(X, i, 0, xv + _noise(i))
        matrix_set(X, i, 1, _noise(i + 100))
        y[i] = xv * 2.0 + _noise(i + 200)
    }

    let model: GradientBoostingRegressor = gradient_boosting_regressor_fit(X, y, 20, 0.1, 3)
    let importances: ptr<f32> = gradient_boosting_regressor_feature_importances(model, 2)

    if importances[0] <= importances[1] {
        println("  FAIL: expected feature 0 to be more important")
        array_free_f32(importances)
        gradient_boosting_regressor_free(model)
        matrix_free(X)
        array_free_f32(y)
        return 1
    }

    println("  OK: feature 0 is most important")
    array_free_f32(importances)
    gradient_boosting_regressor_free(model)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function main() -> i32 {
    println("Running sklearn parity fix tests (batch 2)...")
    println("===============================================")
    println("")

    let mut failures: i32 = 0

    if test_decision_tree_feature_importances() != 0 { failures = failures + 1 }
    println("")
    if test_random_forest_feature_importances() != 0 { failures = failures + 1 }
    println("")
    if test_adaboost_classifier_feature_importances() != 0 { failures = failures + 1 }
    println("")
    if test_adaboost_regressor() != 0 { failures = failures + 1 }
    println("")
    if test_adaboost_regressor_feature_importances() != 0 { failures = failures + 1 }
    println("")
    if test_ledoit_wolf_shrinkage() != 0 { failures = failures + 1 }
    println("")
    if test_ledoit_wolf_weighted() != 0 { failures = failures + 1 }
    println("")
    if test_gradient_boosting_regressor_feature_importances() != 0 { failures = failures + 1 }

    println("")
    if failures == 0 {
        println("All parity fix tests (batch 2) passed!")
        return 0
    }
    print("FAILED: ")
    print(failures)
    println(" tests")
    return 1
}
