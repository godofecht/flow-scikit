# Tests for sklearn parity fixes (batch 2).
# Run: ./flow run tests/test_parity_fixes_v2.flow
#
# Tests:
#   1. DecisionTreeClassifier feature_importances_ (#34472)
#   2. RandomForestClassifier feature_importances_ (#34472)
#   3. AdaBoostClassifier feature_importances_ (#34472)
#   4. AdaBoostRegressor fit and predict
#   5. AdaBoostRegressor feature_importances_ (#34472)
#   6. LedoitWolf shrinkage estimation (#34660)
#   7. LedoitWolf weighted shrinkage (#34660)
#   8. GradientBoostingRegressor feature_importances_ (#34472)

import "lib/scikit/scikit.flow"

function _noise(seed: i32) -> f32 {
    let s: i32 = seed * 1103515245 + 12345
    let n: i32 = (s % 100 + 100) % 100
    return ((n as f32) / 100.0 - 0.5) * 0.3
}

function test_decision_tree_feature_importances() -> i32 {
    println("Test: DecisionTreeClassifier feature_importances_ (#34472)")
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 2)
    let y: ptr<f32> = array_new_f32(n)
    for i in 0 to 20 {
        matrix_set(X, i, 0, 1.0 + _noise(i))
        matrix_set(X, i, 1, _noise(i + 100))
        y[i] = 0.0
    }
    for i in 0 to 20 {
        matrix_set(X, 20 + i, 0, -1.0 + _noise(i + 200))
        matrix_set(X, 20 + i, 1, _noise(i + 300))
        y[20 + i] = 1.0
    }

    let tree: DecisionTreeClassifier = decision_tree_classifier_fit(X, y, 2, 5, CRITERION_GINI)
    let importances: ptr<f32> = decision_tree_classifier_feature_importances(tree, 2)

    # Feature 0 is informative, feature 1 is noise
    if importances[0] <= importances[1] {
        println("  FAIL: expected feature 0 to be more important than feature 1")
        print("  importance[0]=")
        print(importances[0])
        print(" importance[1]=")
        print(importances[1])
        println("")
        array_free_f32(importances)
        decision_tree_classifier_free(tree)
        matrix_free(X)
        array_free_f32(y)
        return 1
    }

    # Importances should sum to ~1.0
    let mut total: f32 = importances[0] + importances[1]
    if total < 0.99 || total > 1.01 {
        println("  FAIL: importances should sum to 1.0, got ")
        print(total)
        println("")
        array_free_f32(importances)
        decision_tree_classifier_free(tree)
        matrix_free(X)
        array_free_f32(y)
        return 1
    }

    println("  OK: feature 0 is most important, importances sum to 1.0")
    array_free_f32(importances)
    decision_tree_classifier_free(tree)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

function test_random_forest_feature_importances() -> i32 {
    println("Test: RandomForestClassifier feature_importances_ (#34472)")
    let n: i32 = 40
    let X: Matrix = matrix_new(n, 3)
    let y: ptr<f32> = array_new_f32(n)
    for i in 0 to 20 {
        matrix_set(X, i, 0, 1.0 + _noise(i))
        matrix_set(X, i, 1, _noise(i + 100))
        matrix_set(X, i, 2, _noise(i + 200))
        y[i] = 0.0
    }
    for i in 0 to 20 {
        matrix_set(X, 20 + i, 0, -1.0 + _noise(i + 300))
        matrix_set(X, 20 + i, 1, _noise(i + 400))
        matrix_set(X, 20 + i, 2, _noise(i + 500))
        y[20 + i] = 1.0
    }

    let rf: RandomForestClassifier = random_forest_classifier_fit(X, y, 2, 10, 5, 42)
    let importances: ptr<f32> = random_forest_classifier_feature_importances(rf, 3)

    # Feature 0 is informative, features 1 and 2 are noise
    if importances[0] <= importances[1] {
        println("  FAIL: expected feature 0 to be most important")
        array_free_f32(importances)
        random_forest_classifier_free(rf)
        matrix_free(X)
        array_free_f32(y)
        return 1
    }

    let mut total: f32 = 0.0
    for f in 0 to 3 {
        total = total + importances[f]
    }
    if total < 0.99 || total > 1.01 {
        println("  FAIL: importances should sum to 1.0, got ")
        print(total)
        println("")
        array_free_f32(importances)
        random_forest_classifier_free(rf)
        matrix_free(X)
        array_free_f32(y)
        return 1
    }

    println("  OK: feature 0 is most important, importances sum to 1.0")
    array_free_f32(importances)
    random_forest_classifier_free(rf)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

