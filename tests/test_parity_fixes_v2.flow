    return 0
}

function test_adaboost_regressor() -> i32 {
    println("Test: AdaBoostRegressor fit and predict")
    let n: i32 = 30
    let X: Matrix = matrix_new(n, 1)
    let y: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        let xv: f32 = (i as f32) * 0.1
        matrix_set(X, i, 0, xv)
        y[i] = xv * 2.0 + _noise(i)
    }

    let model: AdaBoostRegressor = adaboost_regressor_fit(X, y, 10, 4, 42)
    let preds: ptr<f32> = adaboost_regressor_predict(model, X)

    # Check that predictions are roughly correlated with y
    let mut total_err: f32 = 0.0
    for i in 0 to n {
        let err: f32 = fabs((y[i] - preds[i]) as f64) as f32
        total_err = total_err + err
    }
    let mean_err: f32 = total_err / (n as f32)

    if mean_err > 2.0 {
        println("  FAIL: mean error too high: ")
        print(mean_err)
        println("")
        array_free_f32(preds)
        adaboost_regressor_free(model)
        matrix_free(X)
        array_free_f32(y)
        return 1
    }

    println("  OK: mean error = ")
    print(mean_err)
    println("")
    array_free_f32(preds)
    adaboost_regressor_free(model)
    matrix_free(X)
    array_free_f32(y)
    return 0
}

