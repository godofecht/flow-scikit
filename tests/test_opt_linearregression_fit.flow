# Regression test for the BLAS-backed Householder QR least squares solver
# behind linear_regression_fit.
# Covers exact recovery of known coefficients, the intercept, a rank-deficient
# design (duplicated column), a single-feature problem, the L2 penalty branch
# that goes through the normal equations instead of QR, and a realistic
# workload where the fitted model must reproduce a noiseless linear target.

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
}

function optlrf_close(a: f32, b: f32, tolerance: f32) -> bool {
    let d: f32 = a - b
    if d < 0.0 { d = -d }
    return d <= tolerance
}

function optlrf_is_finite(x: f32) -> bool {
    if x != x { return false }
    if x > 100000000.0 { return false }
    if x < -100000000.0 { return false }
    return true
}

function main() -> i32 {
    let pen: Penalty = penalty_none()

    # ---- Case 1: exact recovery of y = 2*x0 - 1*x1 + 0.5 ----
    let X1: Matrix = matrix_new(5, 2)
    matrix_set(X1, 0, 0, 1.0); matrix_set(X1, 0, 1, 0.0)
    matrix_set(X1, 1, 0, 0.0); matrix_set(X1, 1, 1, 1.0)
    matrix_set(X1, 2, 0, 2.0); matrix_set(X1, 2, 1, 3.0)
    matrix_set(X1, 3, 0, -1.0); matrix_set(X1, 3, 1, 4.0)
    matrix_set(X1, 4, 0, 5.0); matrix_set(X1, 4, 1, -2.0)
    let y1: ptr<f32> = array_new_f32(5)
    for i in 0 to 5 {
        y1[i] = 2.0 * matrix_at(X1, i, 0) - matrix_at(X1, i, 1) + 0.5
    }
    let m1: LinearRegression = linear_regression_fit(X1, y1, pen)
    if not optlrf_close(m1.weights[0], 2.0, 0.0005) {
        println("FAIL: linear_regression_fit lost coefficient 0")
        printf("  got %.9f expected 2.0\n", m1.weights[0])
        return 1
    }
    if not optlrf_close(m1.weights[1], -1.0, 0.0005) {
        println("FAIL: linear_regression_fit lost coefficient 1")
        printf("  got %.9f expected -1.0\n", m1.weights[1])
        return 1
    }
    if not optlrf_close(m1.bias, 0.5, 0.0005) {
        println("FAIL: linear_regression_fit lost the intercept")
        printf("  got %.9f expected 0.5\n", m1.bias)
        return 1
    }
    linear_regression_free(m1)
    array_free_f32(y1)
    matrix_free(X1)

    # ---- Case 2: single feature, y = -3*x + 7 ----
    let X2: Matrix = matrix_new(6, 1)
    let y2: ptr<f32> = array_new_f32(6)
    for i in 0 to 6 {
        let v: f32 = (i as f32) - 2.5
        matrix_set(X2, i, 0, v)
        y2[i] = -3.0 * v + 7.0
    }
    let m2: LinearRegression = linear_regression_fit(X2, y2, pen)
    if not optlrf_close(m2.weights[0], -3.0, 0.0005) || not optlrf_close(m2.bias, 7.0, 0.0005) {
        println("FAIL: single-feature fit changed")
        printf("  w=%.9f b=%.9f\n", m2.weights[0], m2.bias)
        return 1
    }
    linear_regression_free(m2)
    array_free_f32(y2)
    matrix_free(X2)

    # ---- Case 3: rank-deficient design, duplicated column ----
    # The reflector for the second column has zero norm, so that column is
    # skipped and back-substitution zeroes its coefficient. The fit must stay
    # finite and must still reproduce the target.
    let X3: Matrix = matrix_new(6, 2)
    let y3: ptr<f32> = array_new_f32(6)
    for i in 0 to 6 {
        let v: f32 = (i as f32) - 2.5
        matrix_set(X3, i, 0, v)
        matrix_set(X3, i, 1, v)
        y3[i] = 4.0 * v + 1.0
    }
    let m3: LinearRegression = linear_regression_fit(X3, y3, pen)
    if not optlrf_is_finite(m3.weights[0]) || not optlrf_is_finite(m3.weights[1]) || not optlrf_is_finite(m3.bias) {
        println("FAIL: rank-deficient fit produced a non-finite coefficient")
        return 1
    }
    let p3: ptr<f32> = linear_regression_predict(m3, X3)
    for i in 0 to 6 {
        if not optlrf_close(p3[i], y3[i], 0.005) {
            println("FAIL: rank-deficient fit no longer reproduces the target")
            printf("  row %d: got %.9f expected %.9f\n", i, p3[i], y3[i])
            return 1
        }
    }
    array_free_f32(p3)
    linear_regression_free(m3)
    array_free_f32(y3)
    matrix_free(X3)

    # ---- Case 4: L2 penalty branch (normal equations, not QR) ----
    let X4: Matrix = matrix_new(40, 3)
    let y4: ptr<f32> = array_new_f32(40)
    let mut seed4: i32 = 777
    for i in 0 to 40 {
        let mut acc: f32 = 0.0
        for j in 0 to 3 {
            seed4 = (seed4 * 1103515245 + 12345) % 2147483647
            if seed4 < 0 { seed4 = -seed4 }
            let v: f32 = ((seed4 % 2000) as f32) / 1000.0 - 1.0
            matrix_set(X4, i, j, v)
            acc = acc + v * (((j % 3) + 1) as f32)
        }
        y4[i] = acc + 2.0
    }
    let m4: LinearRegression = linear_regression_fit(X4, y4, penalty_l2(0.001))
    for j in 0 to 3 {
        if not optlrf_is_finite(m4.weights[j]) {
            println("FAIL: L2 branch produced a non-finite coefficient")
            return 1
        }
    }
    # With a tiny penalty the shrunk fit must still be close to the generator.
    if not optlrf_close(m4.weights[0], 1.0, 0.05) || not optlrf_close(m4.weights[1], 2.0, 0.05) || not optlrf_close(m4.weights[2], 3.0, 0.05) {
        println("FAIL: L2 branch coefficients moved")
        printf("  %.9f %.9f %.9f\n", m4.weights[0], m4.weights[1], m4.weights[2])
        return 1
    }
    linear_regression_free(m4)
    array_free_f32(y4)
    matrix_free(X4)

    # ---- Case 5: realistic workload, 800 x 24, noiseless linear target ----
    let n_rows: i32 = 800
    let n_cols: i32 = 24
    let X5: Matrix = matrix_new(n_rows, n_cols)
    let y5: ptr<f32> = array_new_f32(n_rows)
    let mut seed: i32 = 20250818
    for i in 0 to n_rows {
        let mut acc: f32 = 0.0
        for j in 0 to n_cols {
            seed = (seed * 1103515245 + 12345) % 2147483647
            if seed < 0 { seed = -seed }
            let v: f32 = ((seed % 4000) as f32) / 1000.0 - 2.0
            matrix_set(X5, i, j, v)
            acc = acc + v * (((j % 5) + 1) as f32)
        }
        y5[i] = acc * 0.5 + 3.25
    }

    let m5: LinearRegression = linear_regression_fit(X5, y5, pen)
    if not optlrf_close(m5.bias, 3.25, 0.005) {
        println("FAIL: intercept drifted on the realistic workload")
        printf("  got %.9f expected 3.25\n", m5.bias)
        return 1
    }
    for j in 0 to n_cols {
        let want_j: f32 = ((((j % 5) + 1) as f32)) * 0.5
        if not optlrf_close(m5.weights[j], want_j, 0.005) {
            println("FAIL: coefficient drifted on the realistic workload")
            printf("  j=%d got %.9f expected %.9f\n", j, m5.weights[j], want_j)
            return 1
        }
    }

    let p5: ptr<f32> = linear_regression_predict(m5, X5)
    let mut worst: f32 = 0.0
    for i in 0 to n_rows {
        let mut d: f32 = p5[i] - y5[i]
        if d < 0.0 { d = -d }
        if d > worst { worst = d }
    }
    if worst > 0.02 {
        println("FAIL: fitted model no longer reproduces the linear target")
        printf("  worst absolute residual: %.9f\n", worst)
        return 1
    }

    array_free_f32(p5)
    linear_regression_free(m5)
    array_free_f32(y5)
    matrix_free(X5)

    println("OK: linear_regression_fit coefficients unchanged after the BLAS QR rewrite")
    return 0
}
