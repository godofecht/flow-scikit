function test_transformed_target_regressor() -> i32 {
    println("Test: TransformedTargetRegressor")
    let X: Matrix = _make_simple_data(30, 4, 42)
    let y: ptr<f32> = array_new_f32(30)
    for i in 0 to 30 { y[i] = ((i + 1) as f32) * 0.5 }
    let model: TransformedTargetRegressor = transformed_target_regressor_fit(X, y, TTR_STANDARD)
    let preds: ptr<f32> = transformed_target_regressor_predict(model, X)

    if preds[0] < 0.0 {
        println("  FAIL: predictions should be reasonable")
        transformed_target_regressor_free(model)
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    transformed_target_regressor_free(model)
    array_free_f32(preds)
    return 0
}

# ============================================================================
# Metrics tests
# ============================================================================

function test_ari() -> i32 {
    println("Test: AdjustedRandIndex")
    let y_true: ptr<f32> = array_new_f32(10)
    let y_pred: ptr<f32> = array_new_f32(10)
    for i in 0 to 5 { y_true[i] = 0.0; y_pred[i] = 0.0 }
    for i in 5 to 10 { y_true[i] = 1.0; y_pred[i] = 1.0 }

    let score: f32 = adjusted_rand_index(y_true, y_pred, 10)
    if score < 0.99 {
        println("  FAIL: ARI should be 1.0 for perfect clustering")
        array_free_f32(y_true)
        array_free_f32(y_pred)
        return 1
    }
    println("  PASS")
    array_free_f32(y_true)
    array_free_f32(y_pred)
    return 0
}

function test_nmi() -> i32 {
    println("Test: NormalizedMutualInfo")
    let y_true: ptr<f32> = array_new_f32(10)
    let y_pred: ptr<f32> = array_new_f32(10)
    for i in 0 to 5 { y_true[i] = 0.0; y_pred[i] = 0.0 }
    for i in 5 to 10 { y_true[i] = 1.0; y_pred[i] = 1.0 }

    let score: f32 = normalized_mutual_info(y_true, y_pred, 10)
    if score < 0.99 {
        println("  FAIL: NMI should be 1.0 for perfect clustering")
        array_free_f32(y_true)
        array_free_f32(y_pred)
        return 1
    }
    println("  PASS")
    array_free_f32(y_true)
    array_free_f32(y_pred)
    return 0
}

function test_jaccard_score() -> i32 {
    println("Test: JaccardScore")
    let y_true: ptr<f32> = array_new_f32(6)
    let y_pred: ptr<f32> = array_new_f32(6)
    y_true[0] = 1.0; y_pred[0] = 1.0
    y_true[1] = 1.0; y_pred[1] = 1.0
    y_true[2] = 1.0; y_pred[2] = 0.0
    y_true[3] = 0.0; y_pred[3] = 1.0
    y_true[4] = 0.0; y_pred[4] = 0.0
    y_true[5] = 0.0; y_pred[5] = 0.0

    let score: f32 = jaccard_score(y_true, y_pred, 6)
    if score < 0.01 || score > 0.99 {
        println("  FAIL: jaccard should be between 0 and 1")
        array_free_f32(y_true)
        array_free_f32(y_pred)
        return 1
    }
    println("  PASS")
    array_free_f32(y_true)
    array_free_f32(y_pred)
    return 0
}

function test_brier_score() -> i32 {
    println("Test: BrierScoreLoss")
    let y_true: ptr<f32> = array_new_f32(5)
    let y_prob: ptr<f32> = array_new_f32(5)
    y_true[0] = 1.0; y_prob[0] = 0.9
    y_true[1] = 0.0; y_prob[1] = 0.1
    y_true[2] = 1.0; y_prob[2] = 0.8
    y_true[3] = 0.0; y_prob[3] = 0.2
    y_true[4] = 1.0; y_prob[4] = 0.7

    let score: f32 = brier_score_loss(y_true, y_prob, 5)
    if score < 0.0 {
        println("  FAIL: brier score should be non-negative")
        array_free_f32(y_true)
        array_free_f32(y_prob)
        return 1
    }
    println("  PASS")
    array_free_f32(y_true)
    array_free_f32(y_prob)
    return 0
}

function test_pairwise_distances() -> i32 {
    println("Test: PairwiseDistances")
    let X: Matrix = _make_simple_data(10, 3, 42)
    let D_euc: Matrix = euclidean_distances(X, X)
    let D_man: Matrix = manhattan_distances(X, X)
    let D_cos: Matrix = cosine_distances(X, X)

    if D_euc.rows != 10 || D_euc.cols != 10 {
        println("  FAIL: euclidean distances shape wrong")
        matrix_free(D_euc); matrix_free(D_man); matrix_free(D_cos)
        return 1
    }
    let diag0: f32 = matrix_at(D_euc, 0, 0)
    if diag0 > 0.01 {
        println("  FAIL: diagonal of euclidean distances should be ~0")
        matrix_free(D_euc); matrix_free(D_man); matrix_free(D_cos)
        return 1
    }
    println("  PASS")
    matrix_free(D_euc)
    matrix_free(D_man)
    matrix_free(D_cos)
    return 0
}

# ============================================================================
# Model selection tests
# ============================================================================

function test_time_series_split() -> i32 {
    println("Test: TimeSeriesSplit")
    let fold: FoldIndices = time_series_split(30, 5, 0)

    if fold.n_train <= 0 || fold.n_test <= 0 {
        println("  FAIL: split sizes should be positive")
        free(fold.train_indices as ptr<void>)
        free(fold.test_indices as ptr<void>)
        return 1
    }
    println("  PASS")
    free(fold.train_indices as ptr<void>)
    free(fold.test_indices as ptr<void>)
    return 0
}

function test_leave_one_out() -> i32 {
    println("Test: LeaveOneOut")
    let fold: FoldIndices = leave_one_out(10, 0)

    if fold.n_train != 9 || fold.n_test != 1 {
        println("  FAIL: LOO should have 9 train, 1 test for n=10")
        free(fold.train_indices as ptr<void>)
        free(fold.test_indices as ptr<void>)
        return 1
    }
    println("  PASS")
    free(fold.train_indices as ptr<void>)
    free(fold.test_indices as ptr<void>)
    return 0
}

function test_cross_val_predict() -> i32 {
    println("Test: cross_val_predict")
    let X: Matrix = _make_simple_data(20, 3, 42)
    let y: ptr<f32> = array_new_f32(20)
    for i in 0 to 20 { y[i] = (i as f32) * 0.1 }
    let preds: ptr<f32> = cross_val_predict(X, y, 5, null, 20, 3)

    let mut ok: bool = true
    for i in 0 to 20 {
        if preds[i] != preds[i] { ok = false }
    }
    if not ok {
        println("  FAIL: predictions contain NaN")
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    array_free_f32(preds)
    return 0
}

# ============================================================================
# Cross decomposition tests
# ============================================================================

function test_cca() -> i32 {
    println("Test: CCA")
    let X: Matrix = _make_simple_data(20, 4, 42)
    let Y: Matrix = _make_simple_data(20, 3, 43)
    let model: CCA = cca_fit(X, Y, 2, 100, 0.001)
    let result: Matrix = cca_transform(model, X)

    if result.rows != 20 || result.cols != 2 {
        println("  FAIL: transform shape wrong")
        cca_free(model)
        matrix_free(result)
        return 1
    }
    println("  PASS")
    cca_free(model)
    matrix_free(result)
    return 0
}

