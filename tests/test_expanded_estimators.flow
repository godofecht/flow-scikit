# ============================================================================
# Naive Bayes tests
# ============================================================================

function test_complement_nb() -> i32 {
    println("Test: ComplementNB")
    let X: Matrix = matrix_new(20, 5)
    srand(42)
    for i in 0 to 20 {
        for j in 0 to 5 {
            matrix_set(X, i, j, ((rand() % 10) as f32))
        }
    }
    let y: ptr<f32> = _make_labels(20, 2, 42)
    let model: ComplementNB = complement_nb_fit(X, y, 2, 1.0)
    let preds: ptr<f32> = complement_nb_predict(model, X)

    let mut ok: bool = true
    for i in 0 to 20 {
        if preds[i] != 0.0 && preds[i] != 1.0 { ok = false }
    }
    if not ok {
        println("  FAIL: predictions should be 0 or 1")
        complement_nb_free(model)
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    complement_nb_free(model)
    array_free_f32(preds)
    return 0
}

function test_categorical_nb() -> i32 {
    println("Test: CategoricalNB")
    let X: Matrix = matrix_new(20, 3)
    srand(42)
    for i in 0 to 20 {
        for j in 0 to 3 {
            matrix_set(X, i, j, ((rand() % 4) as f32))
        }
    }
    let y: ptr<f32> = _make_labels(20, 2, 42)
    let n_cats: ptr<i32> = malloc((3 as i64) * 4) as ptr<i32>
    n_cats[0] = 4; n_cats[1] = 4; n_cats[2] = 4
    let model: CategoricalNB = categorical_nb_fit(X, y, 2, n_cats, 1.0)
    let preds: ptr<f32> = categorical_nb_predict(model, X)

    let mut ok: bool = true
    for i in 0 to 20 {
        if preds[i] != 0.0 && preds[i] != 1.0 { ok = false }
    }
    if not ok {
        println("  FAIL: predictions should be 0 or 1")
        categorical_nb_free(model)
        array_free_f32(preds)
        free(n_cats as ptr<void>)
        return 1
    }
    println("  PASS")
    categorical_nb_free(model)
    array_free_f32(preds)
    free(n_cats as ptr<void>)
    return 0
}

