function test_pls_svd() -> i32 {
    println("Test: PLSSVD")
    let X: Matrix = _make_simple_data(20, 4, 42)
    let Y: Matrix = _make_simple_data(20, 3, 43)
    let model: PLSSVD = pls_svd_fit(X, Y, 2)
    let result: Matrix = pls_svd_transform(model, X)

    if result.rows != 20 || result.cols != 2 {
        println("  FAIL: transform shape wrong")
        pls_svd_free(model)
        matrix_free(result)
        return 1
    }
    println("  PASS")
    pls_svd_free(model)
    matrix_free(result)
    return 0
}

# ============================================================================
# Datasets tests
# ============================================================================

function test_load_iris() -> i32 {
    println("Test: load_iris")
    let ds: Dataset = load_iris()

    if ds.n_samples != 150 {
        println("  FAIL: iris should have 150 samples")
        dataset_free(ds)
        return 1
    }
    if ds.n_features != 4 {
        println("  FAIL: iris should have 4 features")
        dataset_free(ds)
        return 1
    }
    if ds.n_classes != 3 {
        println("  FAIL: iris should have 3 classes")
        dataset_free(ds)
        return 1
    }
    println("  PASS")
    dataset_free(ds)
    return 0
}

function test_make_s_curve() -> i32 {
    println("Test: make_s_curve")
    let ds: Dataset = make_s_curve(50, 0.1, 42)

