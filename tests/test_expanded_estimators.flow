# Tests for expanded estimators across all modules.
# Tests manifold, neighbors, svm, tree, naive_bayes, feature_selection,
# gaussian_process, mixture, multioutput, compose, metrics,
# model_selection, cross_decomposition, and datasets additions.
#
# Run: ./flow run tests/test_expanded_estimators.flow

import "lib/scikit/scikit.flow"

extern {
    function rand() -> i32
    function srand(seed: u32) -> void
}

function _make_simple_data(n: i32, p: i32, seed: i32) -> Matrix {
    srand(seed)
    let X: Matrix = matrix_new(n, p)
    for i in 0 to n {
        for j in 0 to p {
            matrix_set(X, i, j, ((rand() % 1000) as f32) / 100.0)
        }
    }
    return X
}

function _make_labels(n: i32, n_classes: i32, seed: i32) -> ptr<f32> {
    srand(seed)
    let y: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        y[i] = ((rand() % n_classes) as f32)
    }
    return y
}

# ============================================================================
# Manifold tests
# ============================================================================

function test_isomap() -> i32 {
    println("Test: Isomap")
    let X: Matrix = _make_simple_data(20, 3, 42)
    let model: Isomap = isomap_fit(X, 2, 5)
    let result: Matrix = isomap_embedding(model)

    if result.rows != 20 {
        println("  FAIL: embedding rows should be 20")
        isomap_free(model)
        matrix_free(result)
        return 1
    }
    if result.cols != 2 {
        println("  FAIL: embedding cols should be 2")
        isomap_free(model)
        matrix_free(result)
        return 1
    }
    println("  PASS")
    isomap_free(model)
    matrix_free(result)
    return 0
}

