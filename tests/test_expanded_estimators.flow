function test_mds() -> i32 {
    println("Test: MDS")
    let X: Matrix = _make_simple_data(15, 3, 42)
    let model: MDS = mds_fit(X, 2, 50, 0.01, 42)
    let result: Matrix = mds_embedding(model)

    if result.rows != 15 {
        println("  FAIL: embedding rows should be 15")
        mds_free(model)
        matrix_free(result)
        return 1
    }
    if result.cols != 2 {
        println("  FAIL: embedding cols should be 2")
        mds_free(model)
        matrix_free(result)
        return 1
    }
    if model.stress < 0.0 {
        println("  FAIL: stress should be non-negative")
        mds_free(model)
        matrix_free(result)
        return 1
    }
    println("  PASS")
    mds_free(model)
    matrix_free(result)
    return 0
}

# ============================================================================
# Neighbors tests
# ============================================================================

function test_radius_neighbors_classifier() -> i32 {
    println("Test: RadiusNeighborsClassifier")
    let X: Matrix = _make_simple_data(30, 4, 42)
    let y: ptr<f32> = _make_labels(30, 2, 42)
    let model: RadiusNeighborsClassifier = radius_neighbors_classifier_fit(X, y, 10.0, 2, -1.0)
    let preds: ptr<f32> = radius_neighbors_classifier_predict(model, X)

    if preds[0] < 0.0 {
        println("  FAIL: predictions should be non-negative for in-sample")
        radius_neighbors_classifier_free(model)
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    radius_neighbors_classifier_free(model)
    array_free_f32(preds)
    return 0
}

function test_nearest_centroid() -> i32 {
    println("Test: NearestCentroid")
    let X: Matrix = _make_simple_data(30, 4, 42)
    let y: ptr<f32> = _make_labels(30, 3, 42)
    let model: NearestCentroid = nearest_centroid_fit(X, y, 3)
    let preds: ptr<f32> = nearest_centroid_predict(model, X)

    let mut ok: bool = true
    for i in 0 to 30 {
        if preds[i] < 0.0 || preds[i] >= 3.0 { ok = false }
    }
    if not ok {
        println("  FAIL: predictions out of range")
        nearest_centroid_free(model)
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    nearest_centroid_free(model)
    array_free_f32(preds)
    return 0
}

function test_local_outlier_factor() -> i32 {
    println("Test: LocalOutlierFactor")
    let X: Matrix = _make_simple_data(20, 3, 42)
    let model: LocalOutlierFactor = local_outlier_factor_fit(X, 5)
    let preds: ptr<i32> = local_outlier_factor_predict(model)

    let mut has_outlier: bool = false
    let mut has_inlier: bool = false
    for i in 0 to 20 {
        if preds[i] == -1 { has_outlier = true }
        if preds[i] == 1 { has_inlier = true }
    }
    if not has_inlier {
        println("  FAIL: should have at least one inlier")
        local_outlier_factor_free(model)
        free(preds as ptr<void>)
        return 1
    }
    println("  PASS")
    local_outlier_factor_free(model)
    free(preds as ptr<void>)
    return 0
}

# ============================================================================
# SVM tests
# ============================================================================

function test_nu_svc() -> i32 {
    println("Test: NuSVC")
    let X: Matrix = _make_simple_data(30, 4, 42)
    let y: ptr<f32> = _make_labels(30, 2, 42)
    let model: NuSVC = nu_svc_fit(X, y, 0.5, 0.1, 50, 1.0)
    let preds: ptr<f32> = nu_svc_predict(model, X)

    let mut ok: bool = true
    for i in 0 to 30 {
        if preds[i] != 0.0 && preds[i] != 1.0 { ok = false }
    }
    if not ok {
        println("  FAIL: predictions should be 0 or 1")
        nu_svc_free(model)
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    nu_svc_free(model)
    array_free_f32(preds)
    return 0
}

function test_nu_svr() -> i32 {
    println("Test: NuSVR")
    let X: Matrix = _make_simple_data(30, 4, 42)
    let y: ptr<f32> = array_new_f32(30)
    for i in 0 to 30 { y[i] = (i as f32) * 0.1 }
    let model: NuSVR = nu_svr_fit(X, y, 0.5, 1.0, 0.1, 50)
    let preds: ptr<f32> = nu_svr_predict(model, X)

    if preds[0] == preds[1] && preds[1] == preds[2] {
        println("  FAIL: predictions should vary")
        nu_svr_free(model)
        array_free_f32(preds)
        return 1
    }
    println("  PASS")
    nu_svr_free(model)
    array_free_f32(preds)
    return 0
}

function test_one_class_svm() -> i32 {
    println("Test: OneClassSVM")
    let X: Matrix = _make_simple_data(20, 3, 42)
    let model: OneClassSVM = one_class_svm_fit(X, 0.1, 0.1, 50)
    let preds: ptr<i32> = one_class_svm_predict(model, X)

    let mut has_pos: bool = false
    for i in 0 to 20 {
        if preds[i] == 1 { has_pos = true }
    }
    if not has_pos {
        println("  FAIL: should have at least one positive prediction")
        one_class_svm_free(model)
        free(preds as ptr<void>)
        return 1
    }
    println("  PASS")
    one_class_svm_free(model)
    free(preds as ptr<void>)
    return 0
}

