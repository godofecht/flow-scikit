# Regression test for the optimized GaussianMixture.predict_proba (issue #279).
#
# The optimization precomputes the per-component normalisation constants
# once per call instead of once per sample. This test pins the numeric
# output against known-correct values and against a verbatim copy of the
# previous implementation.
#
# Run: FLOW_HOST=python flow run tests/test_opt_gaussianmixture_predict_proba.flow

import "lib/scikit/mixture.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function exp(x: f64) -> f64
    function log(x: f64) -> f64
    function fabs(x: f64) -> f64
    function printf(fmt: string, ...) -> i32
}

# ---------------------------------------------------------------------------
# Verbatim copy of the pre-optimization implementation, used as the parity
# reference. Names are module-unique (Flow compiler bug #465).
# ---------------------------------------------------------------------------

function gmpp_ref_log_gaussian(x: ptr<f32>, mean: ptr<f32>, var: ptr<f32>, n_features: i32) -> f32 {
    let mut log_prob: f32 = 0.0
    for j in 0 to n_features {
        let d: f32 = x[j] - mean[j]
        let v: f32 = var[j]
        if v < 0.0000000001 { v = 0.0000000001 }
        log_prob = log_prob - 0.5 * log((2.0 * 3.14159265 * v) as f64) as f32
        log_prob = log_prob - 0.5 * d * d / v
    }
    return log_prob
}

function gmpp_ref_predict_proba(model: GaussianMixture, X: Matrix) -> Matrix {
    let n: i32 = X.rows
    let result: Matrix = matrix_new(n, model.n_components)
    let x_row: ptr<f32> = array_new_f32(model.n_features)

    for i in 0 to n {
        for j in 0 to model.n_features {
            x_row[j] = matrix_at(X, i, j)
        }

        let mut max_log: f32 = -10000000000.0
        for k in 0 to model.n_components {
            let lg: f32 = log((model.weights[k] as f64)) as f32 + gmpp_ref_log_gaussian(x_row, model.means[k], model.variances[k], model.n_features)
            matrix_set(result, i, k, lg)
            if lg > max_log { max_log = lg }
        }

        let mut sum_exp: f32 = 0.0
        for k in 0 to model.n_components {
            let val: f32 = exp((matrix_at(result, i, k) - max_log) as f64) as f32
            matrix_set(result, i, k, val)
            sum_exp = sum_exp + val
        }
        for k in 0 to model.n_components {
            matrix_set(result, i, k, matrix_at(result, i, k) / sum_exp)
        }
    }

    array_free_f32(x_row)
    return result
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

function gmpp_make_model(n_components: i32, n_features: i32) -> GaussianMixture {
    let means: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let variances: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let weights: ptr<f32> = array_new_f32(n_components)
    for k in 0 to n_components {
        means[k] = array_new_f32(n_features)
        variances[k] = array_new_f32(n_features)
        for j in 0 to n_features {
            means[k][j] = 0.0
            variances[k][j] = 1.0
        }
        weights[k] = 1.0 / (n_components as f32)
    }
    return GaussianMixture {
        means: means, variances: variances, weights: weights,
        n_components: n_components, n_features: n_features,
        log_likelihood: 0.0, n_iter: 0, converged: true, fitted: true
    }
}

function gmpp_close(a: f32, b: f32, tol: f32) -> bool {
    return (fabs((a - b) as f64) as f32) < tol
}

function gmpp_synthetic(n: i32, d: i32, k: i32) -> Matrix {
    let X: Matrix = matrix_new(n, d)
    let mut s: i64 = 12345
    for i in 0 to n {
        let comp: i32 = i % k
        for j in 0 to d {
            s = (s * 1103515245 + 12345) % 2147483648
            let u: f32 = ((s % 1000) as f32) / 1000.0 - 0.5
            matrix_set(X, i, j, (comp as f32) * 1.7 + (j as f32) * 0.05 + u * 2.0)
        }
    }
    return X
}

# ---------------------------------------------------------------------------
# 1. Known-correct values on a hand-built two-component model.
#    1 feature, means 0 and 10, unit variances, equal weights.
#    p(comp0 | x) = 1 / (1 + exp(10x - 50)).
# ---------------------------------------------------------------------------

function gmpp_test_known_values() -> i32 {
    println("Test: predict_proba known values (2 components, 1 feature)")
    let model: GaussianMixture = gmpp_make_model(2, 1)
    model.means[0][0] = 0.0
    model.means[1][0] = 10.0

    let X: Matrix = matrix_new(3, 1)
    matrix_set(X, 0, 0, 0.0)
    matrix_set(X, 1, 0, 5.0)
    matrix_set(X, 2, 0, 10.0)

    let P: Matrix = gaussian_mixture_predict_proba(model, X)

    let mut fail: i32 = 0

    # x = 0 sits on component 0
    if not gmpp_close(matrix_at(P, 0, 0), 1.0, 0.0001) { fail = 1 }
    if not gmpp_close(matrix_at(P, 0, 1), 0.0, 0.0001) { fail = 1 }
    # x = 5 is exactly halfway
    if not gmpp_close(matrix_at(P, 1, 0), 0.5, 0.0001) { fail = 1 }
    if not gmpp_close(matrix_at(P, 1, 1), 0.5, 0.0001) { fail = 1 }
    # x = 10 sits on component 1
    if not gmpp_close(matrix_at(P, 2, 0), 0.0, 0.0001) { fail = 1 }
    if not gmpp_close(matrix_at(P, 2, 1), 1.0, 0.0001) { fail = 1 }

    # every row is a distribution
    for i in 0 to 3 {
        let mut s: f32 = 0.0
        for k in 0 to 2 { s = s + matrix_at(P, i, k) }
        if not gmpp_close(s, 1.0, 0.00001) { fail = 1 }
    }

    matrix_free(P)
    matrix_free(X)
    gaussian_mixture_free(model)

    if fail != 0 {
        println("  FAIL: known values wrong")
        return 1
    }
    println("  OK")
    return 0
}

# ---------------------------------------------------------------------------
# 2. Unequal weights shift the posterior by exactly log(w1/w0).
#    weights 0.25 / 0.75, means 0 and 10, x = 5 gives 0.25 / 0.75.
# ---------------------------------------------------------------------------

function gmpp_test_weight_effect() -> i32 {
    println("Test: predict_proba honours mixing weights")
    let model: GaussianMixture = gmpp_make_model(2, 1)
    model.means[0][0] = 0.0
    model.means[1][0] = 10.0
    model.weights[0] = 0.25
    model.weights[1] = 0.75

    let X: Matrix = matrix_new(1, 1)
    matrix_set(X, 0, 0, 5.0)

    let P: Matrix = gaussian_mixture_predict_proba(model, X)
    let mut fail: i32 = 0
    if not gmpp_close(matrix_at(P, 0, 0), 0.25, 0.0001) { fail = 1 }
    if not gmpp_close(matrix_at(P, 0, 1), 0.75, 0.0001) { fail = 1 }

    matrix_free(P)
    matrix_free(X)
    gaussian_mixture_free(model)

    if fail != 0 {
        println("  FAIL: weights not applied correctly")
        return 1
    }
    println("  OK")
    return 0
}

# ---------------------------------------------------------------------------
# 3. Edge cases: a single component, and a variance below the 1e-10 clamp.
# ---------------------------------------------------------------------------

function gmpp_test_edge_cases() -> i32 {
    println("Test: predict_proba edge cases")
    let mut fail: i32 = 0

    # single component: everything is probability 1
    let m1: GaussianMixture = gmpp_make_model(1, 3)
    let X1: Matrix = matrix_new(4, 3)
    for i in 0 to 4 {
        for j in 0 to 3 { matrix_set(X1, i, j, (i as f32) * 2.0 - (j as f32)) }
    }
    let P1: Matrix = gaussian_mixture_predict_proba(m1, X1)
    for i in 0 to 4 {
        if not gmpp_close(matrix_at(P1, i, 0), 1.0, 0.000001) { fail = 1 }
    }
    let R1: Matrix = gmpp_ref_predict_proba(m1, X1)
    for i in 0 to 4 {
        if matrix_at(P1, i, 0) != matrix_at(R1, i, 0) { fail = 1 }
    }
    matrix_free(R1)
    matrix_free(P1)
    matrix_free(X1)
    gaussian_mixture_free(m1)

    # zero variance: exercises the 1e-10 clamp branch on both paths.
    # Query points keep the clamped feature close to its mean so the
    # log-sum-exp sentinel (-1e10, pre-existing on main) is not overrun.
    let m2: GaussianMixture = gmpp_make_model(2, 2)
    m2.means[0][0] = 0.0
    m2.means[0][1] = 0.0
    m2.means[1][0] = 3.0
    m2.means[1][1] = 3.0
    m2.variances[0][0] = 0.0
    let X2: Matrix = matrix_new(4, 2)
    matrix_set(X2, 0, 0, 0.0)
    matrix_set(X2, 0, 1, 0.0)
    matrix_set(X2, 1, 0, 0.0)
    matrix_set(X2, 1, 1, 1.0)
    matrix_set(X2, 2, 0, 0.0)
    matrix_set(X2, 2, 1, 2.5)
    matrix_set(X2, 3, 0, 0.0001)
    matrix_set(X2, 3, 1, 1.5)
    let P2: Matrix = gaussian_mixture_predict_proba(m2, X2)
    let R2: Matrix = gmpp_ref_predict_proba(m2, X2)
    let mut clamp_mismatch: i32 = 0
    for i in 0 to 4 {
        let mut s: f32 = 0.0
        for k in 0 to 2 {
            if matrix_at(P2, i, k) != matrix_at(R2, i, k) { clamp_mismatch = clamp_mismatch + 1 }
            s = s + matrix_at(P2, i, k)
        }
        if not gmpp_close(s, 1.0, 0.0001) { fail = 1 }
    }
    if clamp_mismatch != 0 { fail = 1 }
    matrix_free(R2)
    matrix_free(P2)
    matrix_free(X2)
    gaussian_mixture_free(m2)

    # single row, single feature, single component
    let m3: GaussianMixture = gmpp_make_model(1, 1)
    let X3: Matrix = matrix_new(1, 1)
    matrix_set(X3, 0, 0, 7.25)
    let P3: Matrix = gaussian_mixture_predict_proba(m3, X3)
    if not gmpp_close(matrix_at(P3, 0, 0), 1.0, 0.000001) { fail = 1 }
    matrix_free(P3)
    matrix_free(X3)
    gaussian_mixture_free(m3)

    if fail != 0 {
        println("  FAIL: edge cases diverge")
        return 1
    }
    println("  OK")
    return 0
}

# ---------------------------------------------------------------------------
# 4. Realistic workload, element-wise bit-exact parity against the reference.
# ---------------------------------------------------------------------------

function gmpp_test_workload_parity() -> i32 {
    println("Test: predict_proba parity on 600 x 12, 6 components")
    let n: i32 = 600
    let d: i32 = 12
    let k: i32 = 6

    let X: Matrix = gmpp_synthetic(n, d, k)
    let model: GaussianMixture = gaussian_mixture_fit(X, k, 20, 0.000001, 7)

    let P: Matrix = gaussian_mixture_predict_proba(model, X)
    let R: Matrix = gmpp_ref_predict_proba(model, X)

    let mut mismatched: i32 = 0
    let mut bad_rows: i32 = 0
    for i in 0 to n {
        let mut s: f32 = 0.0
        for c in 0 to k {
            if matrix_at(P, i, c) != matrix_at(R, i, c) { mismatched = mismatched + 1 }
            s = s + matrix_at(P, i, c)
        }
        if not gmpp_close(s, 1.0, 0.0001) { bad_rows = bad_rows + 1 }
    }

    # predict must stay the argmax of predict_proba
    let labels: ptr<i32> = gaussian_mixture_predict(model, X)
    let mut label_mismatch: i32 = 0
    for i in 0 to n {
        let mut best: i32 = 0
        let mut best_p: f32 = -1.0
        for c in 0 to k {
            if matrix_at(P, i, c) > best_p {
                best_p = matrix_at(P, i, c)
                best = c
            }
        }
        if labels[i] != best { label_mismatch = label_mismatch + 1 }
    }

    printf("  mismatched elements: %d of %d\n", mismatched, n * k)
    printf("  rows not summing to 1: %d\n", bad_rows)
    printf("  predict/argmax disagreements: %d\n", label_mismatch)

    free(labels as ptr<void>)
    matrix_free(R)
    matrix_free(P)
    gaussian_mixture_free(model)
    matrix_free(X)

    if mismatched != 0 {
        println("  FAIL: output is not bit-identical to the reference")
        return 1
    }
    if bad_rows != 0 {
        println("  FAIL: rows do not normalise")
        return 1
    }
    if label_mismatch != 0 {
        println("  FAIL: predict disagrees with argmax of predict_proba")
        return 1
    }
    println("  OK")
    return 0
}

function main() -> i32 {
    println("=== GaussianMixture.predict_proba optimization regression (#279) ===")
    let mut failures: i32 = 0
    if gmpp_test_known_values() != 0 { failures = failures + 1 }
    if gmpp_test_weight_effect() != 0 { failures = failures + 1 }
    if gmpp_test_edge_cases() != 0 { failures = failures + 1 }
    if gmpp_test_workload_parity() != 0 { failures = failures + 1 }

    println("")
    if failures == 0 {
        println("All GaussianMixture.predict_proba optimization tests passed!")
        return 0
    }
    print("FAILED: ")
    print(failures)
    println(" tests")
    return 1
}
