# Regression test for the optimized PCA.fit (issue #211).
# Checks analytic mean / explained variance / ratio / components on a hand
# built dataset, then A/B compares the optimized fit against the
# pre-optimization implementation on deterministic tall-narrow and wide
# matrices, with components compared after sign alignment.

import "lib/scikit/scikit.flow"

function opt_pca_fit_close(a: f32, b: f32, tolerance: f32) -> bool {
    let mut d: f32 = a - b
    if d < 0.0 { d = -d }
    return d <= tolerance
}

# The pre-optimization pca_fit, kept here as the parity reference.
function opt_pca_fit_reference(X: Matrix, n_components: i32) -> PCA {
    let n_features: i32 = X.cols
    let mean: ptr<f32> = array_new_f32(n_features)

    for j in 0 to n_features {
        let col: ptr<f32> = array_new_f32(X.rows)
        for i in 0 to X.rows {
            col[i] = matrix_at(X, i, j)
        }
        mean[j] = array_mean(col, X.rows)
        array_free_f32(col)
    }

    let cov: Matrix = matrix_new(n_features, n_features)
    for j1 in 0 to n_features {
        for j2 in 0 to n_features {
            let mut sum: f32 = 0.0
            for i in 0 to X.rows {
                let d1: f32 = matrix_at(X, i, j1) - mean[j1]
                let d2: f32 = matrix_at(X, i, j2) - mean[j2]
                sum = sum + d1 * d2
            }
            matrix_set(cov, j1, j2, sum / ((X.rows as f32) - 1.0))
        }
    }

    let components: ptr<ptr<f32> > = malloc((n_components as i64) * 8) as ptr<ptr<f32> >
    let explained_variance: ptr<f32> = array_new_f32(n_components)
    let cov_copy: Matrix = matrix_copy(cov)

    for c in 0 to n_components {
        let eigvec: ptr<f32> = array_new_f32(n_features)
        for j in 0 to n_features {
            eigvec[j] = 1.0 / sqrt((n_features as f64) as f32)
        }

        for _ in 0 to 100 {
            let new_vec: ptr<f32> = array_new_f32(n_features)
            for j1 in 0 to n_features {
                let mut sum: f32 = 0.0
                for j2 in 0 to n_features {
                    sum = sum + matrix_at(cov_copy, j1, j2) * eigvec[j2]
                }
                new_vec[j1] = sum
            }
            let mut norm: f32 = 0.0
            for j in 0 to n_features {
                norm = norm + new_vec[j] * new_vec[j]
            }
            norm = sqrt(norm as f64) as f32
            if norm < 0.0000000001 {
                norm = 1.0
            }
            for j in 0 to n_features {
                eigvec[j] = new_vec[j] / norm
            }
            array_free_f32(new_vec)
        }

        let mut eigval: f32 = 0.0
        let tmp: ptr<f32> = array_new_f32(n_features)
        for j1 in 0 to n_features {
            let mut sum: f32 = 0.0
            for j2 in 0 to n_features {
                sum = sum + matrix_at(cov_copy, j1, j2) * eigvec[j2]
            }
            tmp[j1] = sum
        }
        for j in 0 to n_features {
            eigval = eigval + eigvec[j] * tmp[j]
        }
        array_free_f32(tmp)

        for j1 in 0 to n_features {
            for j2 in 0 to n_features {
                let val: f32 = matrix_at(cov_copy, j1, j2) - eigval * eigvec[j1] * eigvec[j2]
                matrix_set(cov_copy, j1, j2, val)
            }
        }

        components[c] = eigvec
        explained_variance[c] = eigval
    }

    let mut total_var: f32 = 0.0
    for j in 0 to n_features {
        total_var = total_var + matrix_at(cov, j, j)
    }

    let explained_variance_ratio: ptr<f32> = array_new_f32(n_components)
    for c in 0 to n_components {
        if total_var > 0.0000000001 {
            explained_variance_ratio[c] = explained_variance[c] / total_var
        } else {
            explained_variance_ratio[c] = 0.0
        }
    }

    matrix_free(cov)
    matrix_free(cov_copy)

    let model: PCA = PCA {
        components: components,
        n_components: n_components,
        n_features: n_features,
        mean: mean,
        explained_variance: explained_variance,
        explained_variance_ratio: explained_variance_ratio,
        total_variance: total_var,
        fitted: true
    }
    return model
}

# Sign convention: flip so the largest-magnitude entry is positive.
function opt_pca_fit_align(v: ptr<f32>, n: i32) -> void {
    let mut best: i32 = 0
    let mut best_abs: f32 = 0.0
    for j in 0 to n {
        let mut a: f32 = v[j]
        if a < 0.0 { a = -a }
        if a > best_abs {
            best_abs = a
            best = j
        }
    }
    if v[best] < 0.0 {
        for j in 0 to n {
            v[j] = -v[j]
        }
    }
}

function opt_pca_fit_make(rows: i32, cols: i32, seed: i32) -> Matrix {
    let m: Matrix = matrix_new(rows, cols)
    let scales: ptr<f32> = array_new_f32(cols)
    let mut s: f32 = 40.0
    for j in 0 to cols {
        if s < 0.05 { s = 0.05 }
        scales[j] = s
        s = s * 0.6
    }
    let mut state: i32 = seed
    for i in 0 to rows {
        for j in 0 to cols {
            state = (state * 1103515 + 12345) % 2147483
            if state < 0 { state = -state }
            let r: f32 = ((state % 10000) as f32) / 10000.0
            matrix_set(m, i, j, (r * 2.0 - 1.0) * scales[j] + ((j % 5) as f32))
        }
    }
    array_free_f32(scales)
    return m
}

function opt_pca_fit_ab(rows: i32, cols: i32, k: i32, seed: i32, label: i32) -> bool {
    let X: Matrix = opt_pca_fit_make(rows, cols, seed)
    let fast: PCA = pca_fit(X, k)
    let slow: PCA = opt_pca_fit_reference(X, k)

    let mut ok: bool = true

    for j in 0 to cols {
        if not opt_pca_fit_close(fast.mean[j], slow.mean[j], 0.0005) {
            print("FAIL: mean mismatch, shape ")
            print(label)
            print(" feature ")
            print(j)
            println("")
            ok = false
        }
    }

    if not opt_pca_fit_close(fast.total_variance, slow.total_variance, 0.01) {
        print("FAIL: total variance mismatch, shape ")
        print(label)
        println("")
        ok = false
    }

    for c in 0 to k {
        let ev_tol: f32 = 0.001 * (1.0 + slow.explained_variance[c])
        if not opt_pca_fit_close(fast.explained_variance[c], slow.explained_variance[c], ev_tol) {
            print("FAIL: explained variance mismatch, shape ")
            print(label)
            print(" component ")
            print(c)
            println("")
            ok = false
        }
        if not opt_pca_fit_close(fast.explained_variance_ratio[c], slow.explained_variance_ratio[c], 0.0005) {
            print("FAIL: explained variance ratio mismatch, shape ")
            print(label)
            print(" component ")
            print(c)
            println("")
            ok = false
        }

        opt_pca_fit_align(fast.components[c], cols)
        opt_pca_fit_align(slow.components[c], cols)
        for j in 0 to cols {
            if not opt_pca_fit_close(fast.components[c][j], slow.components[c][j], 0.0005) {
                print("FAIL: sign-aligned component mismatch, shape ")
                print(label)
                print(" component ")
                print(c)
                print(" feature ")
                print(j)
                println("")
                ok = false
            }
        }
    }

    pca_free(fast)
    pca_free(slow)
    matrix_free(X)
    return ok
}

function main() -> i32 {
    # --- 1. Analytic dataset -----------------------------------------------
    # Two uncorrelated features, sample variance 4/3 and 16/3.
    let X: Matrix = matrix_new(4, 2)
    matrix_set(X, 0, 0, 1.0);  matrix_set(X, 0, 1, 2.0)
    matrix_set(X, 1, 0, -1.0); matrix_set(X, 1, 1, -2.0)
    matrix_set(X, 2, 0, 1.0);  matrix_set(X, 2, 1, -2.0)
    matrix_set(X, 3, 0, -1.0); matrix_set(X, 3, 1, 2.0)

    let m: PCA = pca_fit(X, 2)

    if not opt_pca_fit_close(m.mean[0], 0.0, 0.000001) || not opt_pca_fit_close(m.mean[1], 0.0, 0.000001) {
        println("FAIL: analytic mean")
        return 1
    }
    if not opt_pca_fit_close(m.total_variance, 6.6666667, 0.0001) {
        println("FAIL: analytic total variance")
        return 1
    }
    if not opt_pca_fit_close(m.explained_variance[0], 5.3333333, 0.0005) {
        println("FAIL: analytic explained variance PC0")
        return 1
    }
    if not opt_pca_fit_close(m.explained_variance[1], 1.3333333, 0.0005) {
        println("FAIL: analytic explained variance PC1")
        return 1
    }
    if not opt_pca_fit_close(m.explained_variance_ratio[0], 0.8, 0.0005) {
        println("FAIL: analytic explained variance ratio PC0")
        return 1
    }
    if not opt_pca_fit_close(m.explained_variance_ratio[1], 0.2, 0.0005) {
        println("FAIL: analytic explained variance ratio PC1")
        return 1
    }
    # PC0 must be the second axis, PC1 the first, both sign-aligned positive.
    opt_pca_fit_align(m.components[0], 2)
    opt_pca_fit_align(m.components[1], 2)
    if not opt_pca_fit_close(m.components[0][0], 0.0, 0.0005) || not opt_pca_fit_close(m.components[0][1], 1.0, 0.0005) {
        println("FAIL: analytic component 0")
        return 1
    }
    if not opt_pca_fit_close(m.components[1][0], 1.0, 0.0005) || not opt_pca_fit_close(m.components[1][1], 0.0, 0.0005) {
        println("FAIL: analytic component 1")
        return 1
    }
    pca_free(m)
    matrix_free(X)

    # --- 2. Edge case: single feature ---------------------------------------
    let X1: Matrix = matrix_new(3, 1)
    matrix_set(X1, 0, 0, 1.0)
    matrix_set(X1, 1, 0, 3.0)
    matrix_set(X1, 2, 0, 5.0)
    let m1: PCA = pca_fit(X1, 1)
    if not opt_pca_fit_close(m1.mean[0], 3.0, 0.000001) {
        println("FAIL: single feature mean")
        return 1
    }
    if not opt_pca_fit_close(m1.explained_variance[0], 4.0, 0.0001) {
        println("FAIL: single feature explained variance")
        return 1
    }
    if not opt_pca_fit_close(m1.explained_variance_ratio[0], 1.0, 0.0001) {
        println("FAIL: single feature explained variance ratio")
        return 1
    }
    pca_free(m1)
    matrix_free(X1)

    # --- 3. Edge case: constant column (zero variance) -----------------------
    let X2: Matrix = matrix_new(4, 2)
    matrix_set(X2, 0, 0, 7.0); matrix_set(X2, 0, 1, 1.0)
    matrix_set(X2, 1, 0, 7.0); matrix_set(X2, 1, 1, 2.0)
    matrix_set(X2, 2, 0, 7.0); matrix_set(X2, 2, 1, 3.0)
    matrix_set(X2, 3, 0, 7.0); matrix_set(X2, 3, 1, 4.0)
    let m2: PCA = pca_fit(X2, 1)
    if not opt_pca_fit_close(m2.mean[0], 7.0, 0.000001) {
        println("FAIL: constant column mean")
        return 1
    }
    if not opt_pca_fit_close(m2.explained_variance[0], 1.6666667, 0.0005) {
        println("FAIL: constant column explained variance")
        return 1
    }
    opt_pca_fit_align(m2.components[0], 2)
    if not opt_pca_fit_close(m2.components[0][0], 0.0, 0.0005) || not opt_pca_fit_close(m2.components[0][1], 1.0, 0.0005) {
        println("FAIL: constant column component")
        return 1
    }
    pca_free(m2)
    matrix_free(X2)

    # --- 4. A/B against the pre-optimization implementation ------------------
    # tall and narrow
    if not opt_pca_fit_ab(500, 6, 3, 424242, 1) {
        return 1
    }
    # wider than tall-ish
    if not opt_pca_fit_ab(60, 40, 5, 90210, 2) {
        return 1
    }
    # square-ish, more components
    if not opt_pca_fit_ab(200, 20, 8, 13579, 3) {
        return 1
    }

    println("OK: optimized PCA.fit matches analytic values and the reference implementation")
    return 0
}
