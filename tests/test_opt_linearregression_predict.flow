# Regression test for the BLAS-backed linear_regression_predict.
# Covers hand-computed predictions, a wide feature matrix where
# model.n_features is smaller than X.cols (the leading-dimension path), a
# single-row matrix, a zero-weight model, and a realistic fitted workload
# checked against an independent scalar reference.

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
}

function optlrp_close(a: f32, b: f32, tolerance: f32) -> bool {
    let d: f32 = a - b
    if d < 0.0 { d = -d }
    return d <= tolerance
}

# Independent scalar reference for y = X * w + b, written the long way on
# purpose so it does not share code with the implementation under test.
function optlrp_reference(w: ptr<f32>, bias: f32, nf: i32, X: Matrix, out: ptr<f32>) -> void {
    for i in 0 to X.rows {
        let mut acc: f64 = bias as f64
        for j in 0 to nf {
            acc = acc + (w[j] as f64) * (matrix_at(X, i, j) as f64)
        }
        out[i] = acc as f32
    }
}

function main() -> i32 {
    let pen: Penalty = penalty_none()

    # ---- Case 1: hand-computed predictions on a 3x3 problem ----
    let w1: ptr<f32> = array_new_f32(3)
    w1[0] = 2.0
    w1[1] = -1.0
    w1[2] = 0.5

    let m1: LinearRegression = LinearRegression {
        weights: w1,
        bias: 0.25,
        n_features: 3,
        penalty: pen,
        fitted: true
    }

    let X1: Matrix = matrix_new(3, 3)
    matrix_set(X1, 0, 0, 1.0); matrix_set(X1, 0, 1, 2.0); matrix_set(X1, 0, 2, 4.0)
    matrix_set(X1, 1, 0, 0.0); matrix_set(X1, 1, 1, 0.0); matrix_set(X1, 1, 2, 0.0)
    matrix_set(X1, 2, 0, -3.0); matrix_set(X1, 2, 1, 1.0); matrix_set(X1, 2, 2, 2.0)

    # row 0: 2*1 + (-1)*2 + 0.5*4 + 0.25 = 2.25
    # row 1: 0 + 0.25 = 0.25
    # row 2: 2*(-3) + (-1)*1 + 0.5*2 + 0.25 = -5.75
    let p1: ptr<f32> = linear_regression_predict(m1, X1)
    if not optlrp_close(p1[0], 2.25, 0.000001) {
        println("FAIL: linear_regression_predict row 0 changed")
        return 1
    }
    if not optlrp_close(p1[1], 0.25, 0.000001) {
        println("FAIL: linear_regression_predict zero row must return the bias")
        return 1
    }
    if not optlrp_close(p1[2], -5.75, 0.000001) {
        println("FAIL: linear_regression_predict row 2 changed")
        return 1
    }
    array_free_f32(p1)
    matrix_free(X1)

    # ---- Case 2: X wider than the model, exercising the row-stride path ----
    # Only the first 3 columns must be consumed; column 3 is poisoned.
    let X2: Matrix = matrix_new(2, 4)
    matrix_set(X2, 0, 0, 1.0); matrix_set(X2, 0, 1, 2.0)
    matrix_set(X2, 0, 2, 4.0); matrix_set(X2, 0, 3, 1000.0)
    matrix_set(X2, 1, 0, -3.0); matrix_set(X2, 1, 1, 1.0)
    matrix_set(X2, 1, 2, 2.0); matrix_set(X2, 1, 3, -1000.0)

    let p2: ptr<f32> = linear_regression_predict(m1, X2)
    if not optlrp_close(p2[0], 2.25, 0.000001) || not optlrp_close(p2[1], -5.75, 0.000001) {
        println("FAIL: linear_regression_predict read past the model feature count")
        return 1
    }
    array_free_f32(p2)
    matrix_free(X2)

    # ---- Case 3: single row ----
    let X3: Matrix = matrix_new(1, 3)
    matrix_set(X3, 0, 0, 1.0); matrix_set(X3, 0, 1, 2.0); matrix_set(X3, 0, 2, 4.0)
    let p3: ptr<f32> = linear_regression_predict(m1, X3)
    if not optlrp_close(p3[0], 2.25, 0.000001) {
        println("FAIL: linear_regression_predict single-row case changed")
        return 1
    }
    array_free_f32(p3)
    matrix_free(X3)
    array_free_f32(w1)

    # ---- Case 4: all-zero weights must return the bias for every row ----
    let w4: ptr<f32> = array_new_f32(3)
    let m4: LinearRegression = LinearRegression {
        weights: w4,
        bias: -1.5,
        n_features: 3,
        penalty: pen,
        fitted: true
    }
    let X4: Matrix = matrix_new(4, 3)
    for i in 0 to 4 {
        for j in 0 to 3 {
            matrix_set(X4, i, j, ((i * 3 + j) as f32) - 5.0)
        }
    }
    let p4: ptr<f32> = linear_regression_predict(m4, X4)
    for i in 0 to 4 {
        if not optlrp_close(p4[i], -1.5, 0.000001) {
            println("FAIL: zero-weight model no longer returns the bias")
            return 1
        }
    }
    array_free_f32(p4)
    matrix_free(X4)
    array_free_f32(w4)

    # ---- Case 5: realistic fitted workload, 600 x 16 ----
    let n_rows: i32 = 600
    let n_cols: i32 = 16
    let X5: Matrix = matrix_new(n_rows, n_cols)
    let y5: ptr<f32> = array_new_f32(n_rows)
    let mut seed: i32 = 20250818
    for i in 0 to n_rows {
        let mut acc: f32 = 0.0
        for j in 0 to n_cols {
            seed = (seed * 1103515245 + 12345) % 2147483647
            if seed < 0 { seed = -seed }
            let v: f32 = ((seed % 4000) as f32) / 1000.0 - 2.0
            matrix_set(X5, i, j, v)
            acc = acc + v * (((j % 5) + 1) as f32)
        }
        y5[i] = acc * 0.5 + 3.25
    }

    let model5: LinearRegression = linear_regression_fit(X5, y5, pen)
    let preds5: ptr<f32> = linear_regression_predict(model5, X5)
    let expect5: ptr<f32> = array_new_f32(n_rows)
    optlrp_reference(model5.weights, model5.bias, model5.n_features, X5, expect5)

    let mut worst: f32 = 0.0
    for i in 0 to n_rows {
        let mut d: f32 = preds5[i] - expect5[i]
        if d < 0.0 { d = -d }
        let mut scale: f32 = expect5[i]
        if scale < 0.0 { scale = -scale }
        if scale < 1.0 { scale = 1.0 }
        let rel: f32 = d / scale
        if rel > worst { worst = rel }
    }
    # Single-precision reductions with different association order agree to a
    # few ulps; past 1e-4 relative means the predictions really moved.
    if worst > 0.0001 {
        println("FAIL: linear_regression_predict diverged from the scalar reference")
        printf("  worst relative deviation: %.9f\n", worst)
        return 1
    }

    # The fit is on a noiseless linear target, so the predictions must also
    # track y itself closely. This catches a wrong weight/stride pairing that
    # still happens to agree with the reference loop.
    let mut worst_y: f32 = 0.0
    for i in 0 to n_rows {
        let mut d: f32 = preds5[i] - y5[i]
        if d < 0.0 { d = -d }
        if d > worst_y { worst_y = d }
    }
    if worst_y > 0.01 {
        println("FAIL: linear_regression_predict no longer recovers the linear target")
        printf("  worst absolute deviation from y: %.9f\n", worst_y)
        return 1
    }

    array_free_f32(expect5)
    array_free_f32(preds5)
    linear_regression_free(model5)
    array_free_f32(y5)
    matrix_free(X5)

    println("OK: linear_regression_predict unchanged after the BLAS rewrite")
    return 0
}
