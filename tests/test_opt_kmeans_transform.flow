# Regression test for the optimized kmeans_transform.
# Checks hand-computed distances, the zero-distance edge case, a single-cluster
# model, and a realistic workload cross-checked against the direct
# per-pair squared-distance formula that kmeans_transform used before.
# Run: FLOW_HOST=python flow run tests/test_opt_kmeans_transform.flow

import "lib/scikit/scikit.flow"

function opt_km_tf_close(a: f32, b: f32, tolerance: f32) -> bool {
    let mut d: f32 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tolerance
}

# The pre-optimization kernel, kept here as the parity reference.
function opt_km_tf_reference(model: KMeans, X: Matrix) -> Matrix {
    let result: Matrix = matrix_new(X.rows, model.n_clusters)
    for i in 0 to X.rows {
        for k in 0 to model.n_clusters {
            let mut dist: f32 = 0.0
            for j in 0 to model.n_features {
                let d: f32 = matrix_at(X, i, j) - model.centroids[k][j]
                dist = dist + d * d
            }
            matrix_set(result, i, k, sqrt(dist as f64) as f32)
        }
    }
    return result
}

function opt_km_tf_model(n_clusters: i32, n_features: i32) -> KMeans {
    let centroids: ptr<ptr<f32> > = malloc((n_clusters as i64) * 8) as ptr<ptr<f32> >
    for k in 0 to n_clusters {
        centroids[k] = array_new_f32(n_features)
    }
    let labels: ptr<i32> = malloc(128) as ptr<i32>
    let model: KMeans = KMeans {
        centroids: centroids,
        n_clusters: n_clusters,
        n_features: n_features,
        labels: labels,
        inertia: 0.0,
        n_iter: 0,
        max_iter: 0,
        tol: 0.0,
        fitted: true
    }
    return model
}

function opt_km_tf_known_values() -> i32 {
    let model: KMeans = opt_km_tf_model(2, 2)
    model.centroids[0][0] = 0.0
    model.centroids[0][1] = 0.0
    model.centroids[1][0] = 3.0
    model.centroids[1][1] = 4.0

    let X: Matrix = matrix_new(3, 2)
    matrix_set(X, 0, 0, 0.0); matrix_set(X, 0, 1, 0.0)
    matrix_set(X, 1, 0, 3.0); matrix_set(X, 1, 1, 4.0)
    matrix_set(X, 2, 0, 1.0); matrix_set(X, 2, 1, 1.0)

    let D: Matrix = kmeans_transform(model, X)

    let mut failed: i32 = 0
    # Sample sitting exactly on a centroid must give exactly zero, never a
    # negative value leaking out of the expansion.
    if not opt_km_tf_close(matrix_at(D, 0, 0), 0.0, 0.0001) { failed = 1 }
    if matrix_at(D, 0, 0) < 0.0 { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 0, 1), 5.0, 0.0001) { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 1, 0), 5.0, 0.0001) { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 1, 1), 0.0, 0.0001) { failed = 1 }
    if matrix_at(D, 1, 1) < 0.0 { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 2, 0), 1.4142135, 0.0001) { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 2, 1), 3.6055512, 0.0001) { failed = 1 }

    if failed != 0 {
        println("FAIL: kmeans_transform known distances changed")
        printf("  got %.6f %.6f %.6f %.6f %.6f %.6f\n",
            matrix_at(D, 0, 0), matrix_at(D, 0, 1),
            matrix_at(D, 1, 0), matrix_at(D, 1, 1),
            matrix_at(D, 2, 0), matrix_at(D, 2, 1))
    }

    matrix_free(D)
    matrix_free(X)
    kmeans_free(model)
    return failed
}

function opt_km_tf_single_cluster() -> i32 {
    let model: KMeans = opt_km_tf_model(1, 3)
    model.centroids[0][0] = 1.0
    model.centroids[0][1] = 2.0
    model.centroids[0][2] = 2.0

    let X: Matrix = matrix_new(2, 3)
    matrix_set(X, 0, 0, 1.0); matrix_set(X, 0, 1, 2.0); matrix_set(X, 0, 2, 2.0)
    matrix_set(X, 1, 0, 2.0); matrix_set(X, 1, 1, 4.0); matrix_set(X, 1, 2, 4.0)

    let D: Matrix = kmeans_transform(model, X)
    let mut failed: i32 = 0
    if D.rows != 2 || D.cols != 1 { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 0, 0), 0.0, 0.0001) { failed = 1 }
    if not opt_km_tf_close(matrix_at(D, 1, 0), 3.0, 0.0001) { failed = 1 }
    if failed != 0 {
        println("FAIL: kmeans_transform single-cluster case changed")
    }

    matrix_free(D)
    matrix_free(X)
    kmeans_free(model)
    return failed
}

function opt_km_tf_workload() -> i32 {
    let n: i32 = 400
    let d: i32 = 16
    let k: i32 = 5
    let X: Matrix = matrix_new(n, d)
    let mut state: i64 = 20240517
    for i in 0 to n {
        for j in 0 to d {
            state = (state * 1103515245 + 12345) % 2147483648
            let base: f32 = ((i % k) as f32) * 2.0
            X.data[i * d + j] = base + ((state % 1000) as f32) / 1000.0
        }
    }

    let model: KMeans = kmeans_fit(X, k, 50, 0.0001, 42)
    let D: Matrix = kmeans_transform(model, X)
    let R: Matrix = opt_km_tf_reference(model, X)

    let mut failed: i32 = 0
    let mut max_diff: f32 = 0.0
    for i in 0 to n * k {
        if D.data[i] < 0.0 { failed = 1 }
        let mut diff: f32 = D.data[i] - R.data[i]
        if diff < 0.0 { diff = 0.0 - diff }
        if diff > max_diff { max_diff = diff }
    }
    if max_diff > 0.001 {
        failed = 1
        println("FAIL: kmeans_transform diverged from the direct distance formula")
        printf("  max abs diff %.9f\n", max_diff)
    }

    # The nearest centroid implied by transform must be the predicted label,
    # and the squared nearest distances must reproduce the fitted inertia.
    let preds: ptr<i32> = kmeans_predict(model, X)
    let mut sum_sq: f64 = 0.0
    for i in 0 to n {
        let mut best_k: i32 = 0
        let mut best: f32 = D.data[i * k]
        for kk in 1 to k {
            if D.data[i * k + kk] < best {
                best = D.data[i * k + kk]
                best_k = kk
            }
        }
        if best_k != preds[i] { failed = 1 }
        sum_sq = sum_sq + (best as f64) * (best as f64)
    }
    let inertia: f64 = model.inertia as f64
    let mut rel: f64 = sum_sq - inertia
    if rel < 0.0 { rel = 0.0 - rel }
    if inertia > 0.0 { rel = rel / inertia }
    if rel > 0.001 {
        failed = 1
        println("FAIL: kmeans_transform nearest distances do not reproduce inertia")
        printf("  sum_sq %.6f inertia %.6f\n", sum_sq, inertia)
    }

    if failed != 0 {
        println("FAIL: kmeans_transform realistic workload changed")
    } else {
        printf("  OK: 400x16 into 5 clusters, max abs diff %.9f\n", max_diff)
    }

    free(preds as ptr<void>)
    matrix_free(R)
    matrix_free(D)
    kmeans_free(model)
    matrix_free(X)
    return failed
}

function main() -> i32 {
    println("Test: optimized KMeans.transform")
    let mut failed: i32 = 0
    failed = failed + opt_km_tf_known_values()
    failed = failed + opt_km_tf_single_cluster()
    failed = failed + opt_km_tf_workload()
    if failed != 0 {
        println("FAILED")
        return 1
    }
    println("OK: KMeans.transform optimization preserves distances")
    return 0
}
