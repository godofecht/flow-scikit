import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fflush(stream: ptr<void>) -> i32
}

function ms_between(start: i64, finish: i64) -> f32 {
    return ((((finish - start) as f64) / 1000000.0) as f32)
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()
    let X_c: Matrix = iris.X
    let y_c: ptr<f32> = iris.y
    let n_c: i32 = X_c.rows
    let f_c: i32 = X_c.cols
    let X_r: Matrix = diabetes.X
    let y_r: ptr<f32> = diabetes.y
    let n_r: i32 = X_r.rows
    let f_r: i32 = X_r.cols

    let yi_c: ptr<i32> = malloc((n_c as i64) * 4) as ptr<i32>
    for i in 0 to n_c { yi_c[i] = y_c[i] as i32 }
    let yi_r: ptr<i32> = malloc((n_r as i64) * 4) as ptr<i32>
    for i in 0 to n_r { yi_r[i] = y_r[i] as i32 }

    # A two-column target for the cross-decomposition estimators.
    let Y_multi: Matrix = matrix_new(n_r, 2)
    for i in 0 to n_r {
        matrix_set(Y_multi, i, 0, y_r[i])
        matrix_set(Y_multi, i, 1, y_r[i] * 0.5)
    }

    # Label-valued targets for the multi-output classifiers.
    let Y_labels: Matrix = matrix_new(n_c, 2)
    let Y_label_rows: ptr<ptr<f32> > = malloc((n_c as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_c {
        let a: f32 = y_c[i]
        let b: f32 = ((((y_c[i] as i32) + 1) % 3) as f32)
        matrix_set(Y_labels, i, 0, a)
        matrix_set(Y_labels, i, 1, b)
        let lrow: ptr<f32> = array_new_f32(2)
        lrow[0] = a
        lrow[1] = b
        Y_label_rows[i] = lrow
    }

    let Y_rows: ptr<ptr<f32> > = malloc((n_r as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_r {
        let row: ptr<f32> = array_new_f32(2)
        row[0] = y_r[i]
        row[1] = y_r[i] * 0.5
        Y_rows[i] = row
    }

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ---- label_propagation (classification) ----
    t0 = flow_now_ns()
    let m_label_propagation: LabelPropagation = label_propagation_fit(X_c, yi_c, 3, 0.1, 100, 0.0001)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|label_propagation|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    label_propagation_free(m_label_propagation)

    # ---- label_spreading (classification) ----
    t0 = flow_now_ns()
    let m_label_spreading: LabelSpreading = label_spreading_fit(X_c, yi_c, 3, 0.1, 1.0, 100, 0.0001)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|label_spreading|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    label_spreading_free(m_label_spreading)

    # ---- lars_cv (regression) ----
    t0 = flow_now_ns()
    let m_lars_cv: LarsCV = lars_cv_fit(X_r, y_r, 2)
    t1 = flow_now_ns()
    let o_lars_cv: ptr<f32> = lars_cv_predict(m_lars_cv, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lars_cv)
    printf("ESTIMATOR|lars_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lars_cv_free(m_lars_cv)

    # ---- lars (regression) ----
    t0 = flow_now_ns()
    let m_lars: Lars = lars_fit(X_r, y_r, 2)
    t1 = flow_now_ns()
    let o_lars: ptr<f32> = lars_predict(m_lars, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lars)
    printf("ESTIMATOR|lars|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lars_free(m_lars)

    # ---- lasso_cv (regression) ----
    t0 = flow_now_ns()
    let m_lasso_cv: LassoCV = lasso_cv_fit(X_r, y_r, 10)
    t1 = flow_now_ns()
    let o_lasso_cv: ptr<f32> = lasso_cv_predict(m_lasso_cv, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lasso_cv)
    printf("ESTIMATOR|lasso_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lasso_cv_free(m_lasso_cv)

    # ---- lasso (regression) ----
    t0 = flow_now_ns()
    let m_lasso: Lasso = lasso_fit(X_r, y_r, 1.0, 50, 0.01)
    t1 = flow_now_ns()
    let o_lasso: ptr<f32> = lasso_predict(m_lasso, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lasso)
    printf("ESTIMATOR|lasso|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lasso_free(m_lasso)

    # ---- lasso_lars_cv (regression) ----
    t0 = flow_now_ns()
    let m_lasso_lars_cv: LassoLarsCV = lasso_lars_cv_fit(X_r, y_r, 10)
    t1 = flow_now_ns()
    let o_lasso_lars_cv: ptr<f32> = lasso_lars_cv_predict(m_lasso_lars_cv, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lasso_lars_cv)
    printf("ESTIMATOR|lasso_lars_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lasso_lars_cv_free(m_lasso_lars_cv)

    # ---- lasso_lars (regression) ----
    t0 = flow_now_ns()
    let m_lasso_lars: LassoLars = lasso_lars_fit(X_r, y_r, 1.0, 100)
    t1 = flow_now_ns()
    let o_lasso_lars: ptr<f32> = lasso_lars_predict(m_lasso_lars, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lasso_lars)
    printf("ESTIMATOR|lasso_lars|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lasso_lars_free(m_lasso_lars)

    # ---- lasso_lars_ic (regression) ----
    t0 = flow_now_ns()
    let m_lasso_lars_ic: LassoLarsIC = lasso_lars_ic_fit(X_r, y_r, 0)
    t1 = flow_now_ns()
    let o_lasso_lars_ic: ptr<f32> = lasso_lars_ic_predict(m_lasso_lars_ic, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_lasso_lars_ic)
    printf("ESTIMATOR|lasso_lars_ic|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lasso_lars_ic_free(m_lasso_lars_ic)

    # ---- lda (unsupervised) ----
    t0 = flow_now_ns()
    let m_lda: LatentDirichletAllocation = lda_fit(X_c, 3, 50, 1.0, 0.1, 42)
    t1 = flow_now_ns()
    let o_lda: Matrix = lda_transform(m_lda, X_c)
    t2 = flow_now_ns()
    matrix_free(o_lda)
    printf("ESTIMATOR|lda|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lda_free(m_lda)

    # ---- ledoit_wolf_estimator (unsupervised) ----
    t0 = flow_now_ns()
    let m_ledoit_wolf_estimator: ShrunkCovariance = ledoit_wolf_estimator_fit(X_c)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|ledoit_wolf_estimator|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)

    # ---- linear_regression (regression) ----
    t0 = flow_now_ns()
    let m_linear_regression: LinearRegression = linear_regression_fit(X_r, y_r, penalty_none())
    t1 = flow_now_ns()
    let o_linear_regression: ptr<f32> = linear_regression_predict(m_linear_regression, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_linear_regression)
    printf("ESTIMATOR|linear_regression|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    linear_regression_free(m_linear_regression)

    # ---- linear_svc (classification) ----
    t0 = flow_now_ns()
    let m_linear_svc: LinearSVC = linear_svc_fit(X_c, y_c, 3, 1.0, 50, 0.01)
    t1 = flow_now_ns()
    let o_linear_svc: ptr<f32> = linear_svc_predict(m_linear_svc, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_linear_svc)
    printf("ESTIMATOR|linear_svc|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    linear_svc_free(m_linear_svc)

    # ---- linear_svc_multi (classification) ----
    t0 = flow_now_ns()
    let m_linear_svc_multi: LinearSVCMulti = linear_svc_multi_fit(X_c, y_c, 3, 1.0, 50)
    t1 = flow_now_ns()
    let o_linear_svc_multi: ptr<f32> = linear_svc_multi_predict(m_linear_svc_multi, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_linear_svc_multi)
    printf("ESTIMATOR|linear_svc_multi|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    linear_svc_multi_free(m_linear_svc_multi)

    # ---- linear_svr (regression) ----
    t0 = flow_now_ns()
    let m_linear_svr: LinearSVR = linear_svr_fit(X_r, y_r, 1.0, 0.1, 50, 0.01)
    t1 = flow_now_ns()
    let o_linear_svr: ptr<f32> = linear_svr_predict(m_linear_svr, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_linear_svr)
    printf("ESTIMATOR|linear_svr|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    linear_svr_free(m_linear_svr)

    # ---- lle (unsupervised) ----
    t0 = flow_now_ns()
    let m_lle: LLE = lle_fit(X_c, 2, 5)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|lle|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    lle_free(m_lle)

    # ---- local_outlier_factor (unsupervised) ----
    t0 = flow_now_ns()
    let m_local_outlier_factor: LocalOutlierFactor = local_outlier_factor_fit(X_c, 5)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|local_outlier_factor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    local_outlier_factor_free(m_local_outlier_factor)

    # ---- logistic_regression_cv (classification) ----
    t0 = flow_now_ns()
    let m_logistic_regression_cv: LogisticRegressionCV = logistic_regression_cv_fit(X_c, y_c, 3, 5)
    t1 = flow_now_ns()
    let o_logistic_regression_cv: ptr<f32> = logistic_regression_cv_predict(m_logistic_regression_cv, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_logistic_regression_cv)
    printf("ESTIMATOR|logistic_regression_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    logistic_regression_cv_free(m_logistic_regression_cv)

    # ---- logistic_regression (classification) ----
    t0 = flow_now_ns()
    let m_logistic_regression: LogisticRegression = logistic_regression_fit(X_c, y_c, 3, 50, 0.01, penalty_none())
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|logistic_regression|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    logistic_regression_free(m_logistic_regression)

    # ---- maxabs_scaler (unsupervised) ----
    t0 = flow_now_ns()
    let m_maxabs_scaler: MaxAbsScaler = maxabs_scaler_fit(X_c)
    t1 = flow_now_ns()
    let o_maxabs_scaler: Matrix = maxabs_scaler_transform(m_maxabs_scaler, X_c)
    t2 = flow_now_ns()
    matrix_free(o_maxabs_scaler)
    printf("ESTIMATOR|maxabs_scaler|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    maxabs_scaler_free(m_maxabs_scaler)

    for i in 0 to n_c { array_free_f32(Y_label_rows[i]) }
    free(Y_label_rows as ptr<void>)
    matrix_free(Y_labels)
    for i in 0 to n_r { array_free_f32(Y_rows[i]) }
    free(Y_rows as ptr<void>)
    matrix_free(Y_multi)
    free(yi_c as ptr<void>)
    free(yi_r as ptr<void>)
    return 0
}
