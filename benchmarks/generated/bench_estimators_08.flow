# Generated by benchmarks/generate_estimator_bench.py. Do not edit.
#
# One timing block per Flow estimator that the registry marks runnable.
# Regenerate with:
#   python benchmarks/estimator_coverage.py
#   python benchmarks/generate_estimator_bench.py

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fflush(stream: ptr<void>) -> i32
}

function ms_between(start: i64, finish: i64) -> f32 {
    return ((((finish - start) as f64) / 1000000.0) as f32)
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()
    let X_c: Matrix = iris.X
    let y_c: ptr<f32> = iris.y
    let n_c: i32 = X_c.rows
    let f_c: i32 = X_c.cols
    let X_r: Matrix = diabetes.X
    let y_r: ptr<f32> = diabetes.y
    let n_r: i32 = X_r.rows
    let f_r: i32 = X_r.cols

    let yi_c: ptr<i32> = malloc((n_c as i64) * 4) as ptr<i32>
    for i in 0 to n_c { yi_c[i] = y_c[i] as i32 }
    let yi_r: ptr<i32> = malloc((n_r as i64) * 4) as ptr<i32>
    for i in 0 to n_r { yi_r[i] = y_r[i] as i32 }

    # A two-column target for the cross-decomposition estimators.
    let Y_multi: Matrix = matrix_new(n_r, 2)
    for i in 0 to n_r {
        matrix_set(Y_multi, i, 0, y_r[i])
        matrix_set(Y_multi, i, 1, y_r[i] * 0.5)
    }

    # Label-valued targets for the multi-output classifiers.
    let Y_labels: Matrix = matrix_new(n_c, 2)
    let Y_label_rows: ptr<ptr<f32> > = malloc((n_c as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_c {
        let a: f32 = y_c[i]
        let b: f32 = ((((y_c[i] as i32) + 1) % 3) as f32)
        matrix_set(Y_labels, i, 0, a)
        matrix_set(Y_labels, i, 1, b)
        let lrow: ptr<f32> = array_new_f32(2)
        lrow[0] = a
        lrow[1] = b
        Y_label_rows[i] = lrow
    }

    let Y_rows: ptr<ptr<f32> > = malloc((n_r as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_r {
        let row: ptr<f32> = array_new_f32(2)
        row[0] = y_r[i]
        row[1] = y_r[i] * 0.5
        Y_rows[i] = row
    }

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ---- spline_transformer (unsupervised) ----
    t0 = flow_now_ns()
    let m_spline_transformer: SplineTransformer = spline_transformer_fit(X_c, 4, 2)
    t1 = flow_now_ns()
    let o_spline_transformer: Matrix = spline_transformer_transform(m_spline_transformer, X_c)
    t2 = flow_now_ns()
    matrix_free(o_spline_transformer)
    printf("ESTIMATOR|spline_transformer|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    spline_transformer_free(m_spline_transformer)

    # ---- stacking_regressor (regression) ----
    t0 = flow_now_ns()
    let m_stacking_regressor: StackingRegressor = stacking_regressor_fit(X_r, y_r, 3, 5, 42)
    t1 = flow_now_ns()
    let o_stacking_regressor: ptr<f32> = stacking_regressor_predict(m_stacking_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_stacking_regressor)
    printf("ESTIMATOR|stacking_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    stacking_regressor_free(m_stacking_regressor)

    # ---- standard_scaler (unsupervised) ----
    t0 = flow_now_ns()
    let m_standard_scaler: StandardScaler = standard_scaler_fit(X_c)
    t1 = flow_now_ns()
    let o_standard_scaler: Matrix = standard_scaler_transform(m_standard_scaler, X_c)
    t2 = flow_now_ns()
    matrix_free(o_standard_scaler)
    printf("ESTIMATOR|standard_scaler|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    standard_scaler_free(m_standard_scaler)

    # ---- svc (classification) ----
    t0 = flow_now_ns()
    let m_svc: SVC = svc_fit(X_c, y_c, 3, 1.0, 0, 0.1, 2, 0.0)
    t1 = flow_now_ns()
    let o_svc: ptr<f32> = svc_predict(m_svc, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_svc)
    printf("ESTIMATOR|svc|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    svc_free(m_svc)

    # ---- svr (regression) ----
    t0 = flow_now_ns()
    let m_svr: SVR = svr_fit(X_r, y_r, 1.0, 0.1, 0, 0.1, 2, 0.0)
    t1 = flow_now_ns()
    let o_svr: ptr<f32> = svr_predict(m_svr, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_svr)
    printf("ESTIMATOR|svr|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    svr_free(m_svr)

    # ---- target_encoder (regression) ----
    t0 = flow_now_ns()
    let m_target_encoder: TargetEncoder = target_encoder_fit(X_r, y_r, n_r, 1.0)
    t1 = flow_now_ns()
    let o_target_encoder: Matrix = target_encoder_transform(m_target_encoder, X_r)
    t2 = flow_now_ns()
    matrix_free(o_target_encoder)
    printf("ESTIMATOR|target_encoder|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    target_encoder_free(m_target_encoder)

    # ---- theil_sen_regressor (regression) ----
    t0 = flow_now_ns()
    let m_theil_sen_regressor: TheilSenRegressor = theil_sen_regressor_fit(X_r, y_r, 10, 100, 42)
    t1 = flow_now_ns()
    let o_theil_sen_regressor: ptr<f32> = theil_sen_regressor_predict(m_theil_sen_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_theil_sen_regressor)
    printf("ESTIMATOR|theil_sen_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    theil_sen_regressor_free(m_theil_sen_regressor)

    # ---- transformed_target_regressor (regression) ----
    t0 = flow_now_ns()
    let m_transformed_target_regressor: TransformedTargetRegressor = transformed_target_regressor_fit(X_r, y_r, 0)
    t1 = flow_now_ns()
    let o_transformed_target_regressor: ptr<f32> = transformed_target_regressor_predict(m_transformed_target_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_transformed_target_regressor)
    printf("ESTIMATOR|transformed_target_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    transformed_target_regressor_free(m_transformed_target_regressor)

    # ---- truncated_svd (unsupervised) ----
    t0 = flow_now_ns()
    let m_truncated_svd: TruncatedSVD = truncated_svd_fit(X_c, 2)
    t1 = flow_now_ns()
    let o_truncated_svd: Matrix = truncated_svd_transform(m_truncated_svd, X_c)
    t2 = flow_now_ns()
    matrix_free(o_truncated_svd)
    printf("ESTIMATOR|truncated_svd|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    truncated_svd_free(m_truncated_svd)

    # ---- tsne (unsupervised) ----
    t0 = flow_now_ns()
    let m_tsne: TSNE = tsne_fit(X_c, 2, 5.0, 0.1, 50, 42)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|tsne|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    tsne_free(m_tsne)

    # ---- tweedie_regressor (regression) ----
    t0 = flow_now_ns()
    let m_tweedie_regressor: TweedieRegressor = tweedie_regressor_fit(X_r, y_r, 1.0, 1.5, 100, 0.01)
    t1 = flow_now_ns()
    let o_tweedie_regressor: ptr<f32> = tweedie_regressor_predict(m_tweedie_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_tweedie_regressor)
    printf("ESTIMATOR|tweedie_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    tweedie_regressor_free(m_tweedie_regressor)

    # ---- variance_threshold (unsupervised) ----
    t0 = flow_now_ns()
    let m_variance_threshold: VarianceThreshold = variance_threshold_fit(X_c, 0.5)
    t1 = flow_now_ns()
    let o_variance_threshold: Matrix = variance_threshold_transform(m_variance_threshold, X_c)
    t2 = flow_now_ns()
    matrix_free(o_variance_threshold)
    printf("ESTIMATOR|variance_threshold|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    variance_threshold_free(m_variance_threshold)

    for i in 0 to n_c { array_free_f32(Y_label_rows[i]) }
    free(Y_label_rows as ptr<void>)
    matrix_free(Y_labels)
    for i in 0 to n_r { array_free_f32(Y_rows[i]) }
    free(Y_rows as ptr<void>)
    matrix_free(Y_multi)
    free(yi_c as ptr<void>)
    free(yi_r as ptr<void>)
    return 0
}
