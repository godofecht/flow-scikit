import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fflush(stream: ptr<void>) -> i32
}

function ms_between(start: i64, finish: i64) -> f32 {
    return ((((finish - start) as f64) / 1000000.0) as f32)
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()
    let X_c: Matrix = iris.X
    let y_c: ptr<f32> = iris.y
    let n_c: i32 = X_c.rows
    let f_c: i32 = X_c.cols
    let X_r: Matrix = diabetes.X
    let y_r: ptr<f32> = diabetes.y
    let n_r: i32 = X_r.rows
    let f_r: i32 = X_r.cols

    let yi_c: ptr<i32> = malloc((n_c as i64) * 4) as ptr<i32>
    for i in 0 to n_c { yi_c[i] = y_c[i] as i32 }
    let yi_r: ptr<i32> = malloc((n_r as i64) * 4) as ptr<i32>
    for i in 0 to n_r { yi_r[i] = y_r[i] as i32 }

    # A two-column target for the cross-decomposition estimators.
    let Y_multi: Matrix = matrix_new(n_r, 2)
    for i in 0 to n_r {
        matrix_set(Y_multi, i, 0, y_r[i])
        matrix_set(Y_multi, i, 1, y_r[i] * 0.5)
    }

    # Label-valued targets for the multi-output classifiers.
    let Y_labels: Matrix = matrix_new(n_c, 2)
    let Y_label_rows: ptr<ptr<f32> > = malloc((n_c as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_c {
        let a: f32 = y_c[i]
        let b: f32 = ((((y_c[i] as i32) + 1) % 3) as f32)
        matrix_set(Y_labels, i, 0, a)
        matrix_set(Y_labels, i, 1, b)
        let lrow: ptr<f32> = array_new_f32(2)
        lrow[0] = a
        lrow[1] = b
        Y_label_rows[i] = lrow
    }

    let Y_rows: ptr<ptr<f32> > = malloc((n_r as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_r {
        let row: ptr<f32> = array_new_f32(2)
        row[0] = y_r[i]
        row[1] = y_r[i] * 0.5
        Y_rows[i] = row
    }

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ---- mds (unsupervised) ----
    t0 = flow_now_ns()
    let m_mds: MDS = mds_fit(X_c, 2, 100, 0.0001, 42)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|mds|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    mds_free(m_mds)

    # ---- mean_shift (unsupervised) ----
    t0 = flow_now_ns()
    let m_mean_shift: MeanShift = mean_shift_fit(X_c, 1.0, 100)
    t1 = flow_now_ns()
    let o_mean_shift: ptr<i32> = mean_shift_predict(m_mean_shift, X_c)
    t2 = flow_now_ns()
    printf("ESTIMATOR|mean_shift|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    mean_shift_free(m_mean_shift)

    # ---- min_cov_det (unsupervised) ----
    t0 = flow_now_ns()
    let m_min_cov_det: MinCovDet = min_cov_det_fit(X_c, 0.75, 100, 42)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|min_cov_det|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    min_cov_det_free(m_min_cov_det)

    # ---- minibatch_dictionary_learning (unsupervised) ----
    t0 = flow_now_ns()
    let m_minibatch_dictionary_learning: MiniBatchDictionaryLearning = minibatch_dictionary_learning_fit(X_c, 2, 50, 32, 42)
    t1 = flow_now_ns()
    let o_minibatch_dictionary_learning: Matrix = minibatch_dictionary_learning_transform(m_minibatch_dictionary_learning, X_c)
    t2 = flow_now_ns()
    matrix_free(o_minibatch_dictionary_learning)
    printf("ESTIMATOR|minibatch_dictionary_learning|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    minibatch_dictionary_learning_free(m_minibatch_dictionary_learning)

    # ---- minibatch_kmeans (unsupervised) ----
    t0 = flow_now_ns()
    let m_minibatch_kmeans: MiniBatchKMeans = minibatch_kmeans_fit(X_c, 3, 32, 100, 0.0001, 42)
    t1 = flow_now_ns()
    let o_minibatch_kmeans: ptr<i32> = minibatch_kmeans_predict(m_minibatch_kmeans, X_c)
    t2 = flow_now_ns()
    printf("ESTIMATOR|minibatch_kmeans|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    minibatch_kmeans_free(m_minibatch_kmeans)

    # ---- minibatch_nmf (unsupervised) ----
    t0 = flow_now_ns()
    let m_minibatch_nmf: MiniBatchNMF = minibatch_nmf_fit(X_c, 2, 100, 32, 0.0001, 42)
    t1 = flow_now_ns()
    let o_minibatch_nmf: Matrix = minibatch_nmf_transform(m_minibatch_nmf, X_c)
    t2 = flow_now_ns()
    matrix_free(o_minibatch_nmf)
    printf("ESTIMATOR|minibatch_nmf|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    minibatch_nmf_free(m_minibatch_nmf)

    # ---- minibatch_sparse_pca (unsupervised) ----
    t0 = flow_now_ns()
    let m_minibatch_sparse_pca: MiniBatchSparsePCA = minibatch_sparse_pca_fit(X_c, 2, 1.0, 100, 32, 0.0001, 42)
    t1 = flow_now_ns()
    let o_minibatch_sparse_pca: Matrix = minibatch_sparse_pca_transform(m_minibatch_sparse_pca, X_c)
    t2 = flow_now_ns()
    matrix_free(o_minibatch_sparse_pca)
    printf("ESTIMATOR|minibatch_sparse_pca|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    minibatch_sparse_pca_free(m_minibatch_sparse_pca)

    # ---- minmax_scaler (unsupervised) ----
    t0 = flow_now_ns()
    let m_minmax_scaler: MinMaxScaler = minmax_scaler_fit(X_c)
    t1 = flow_now_ns()
    let o_minmax_scaler: Matrix = minmax_scaler_transform(m_minmax_scaler, X_c)
    t2 = flow_now_ns()
    matrix_free(o_minmax_scaler)
    printf("ESTIMATOR|minmax_scaler|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    minmax_scaler_free(m_minmax_scaler)

    # ---- missing_indicator (unsupervised) ----
    t0 = flow_now_ns()
    let m_missing_indicator: MissingIndicator = missing_indicator_fit(X_c, 0.0, 0)
    t1 = flow_now_ns()
    let o_missing_indicator: Matrix = missing_indicator_transform(m_missing_indicator, X_c)
    t2 = flow_now_ns()
    matrix_free(o_missing_indicator)
    printf("ESTIMATOR|missing_indicator|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    missing_indicator_free(m_missing_indicator)

    # ---- mlp_classifier (classification) ----
    let hidden_sizes_mlp_classifier: array<i32, 1> = [8]
    t0 = flow_now_ns()
    let m_mlp_classifier: MLPClassifier = mlp_classifier_fit(X_c, y_c, 3, hidden_sizes_mlp_classifier, 1, 0, 50, 0.01, 0.9, 42)
    t1 = flow_now_ns()
    let o_mlp_classifier: Matrix = mlp_classifier_predict(m_mlp_classifier, X_c)
    t2 = flow_now_ns()
    matrix_free(o_mlp_classifier)
    printf("ESTIMATOR|mlp_classifier|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    mlp_classifier_free(m_mlp_classifier)

    # ---- mlp_regressor (regression) ----
    let hidden_sizes_mlp_regressor: array<i32, 1> = [8]
    t0 = flow_now_ns()
    let m_mlp_regressor: MLPRegressor = mlp_regressor_fit(X_r, y_r, hidden_sizes_mlp_regressor, 1, 0, 50, 0.01, 0.9, 42)
    t1 = flow_now_ns()
    let o_mlp_regressor: ptr<f32> = mlp_regressor_predict(m_mlp_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_mlp_regressor)
    printf("ESTIMATOR|mlp_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    mlp_regressor_free(m_mlp_regressor)

    # ---- multi_output_classifier (multioutput_class) ----
    t0 = flow_now_ns()
    let m_multi_output_classifier: MultiOutputClassifier = multi_output_classifier_fit(X_c, Y_labels, 2, 1, 50, 0.01)
    t1 = flow_now_ns()
    let o_multi_output_classifier: Matrix = multi_output_classifier_predict(m_multi_output_classifier, X_c)
    t2 = flow_now_ns()
    matrix_free(o_multi_output_classifier)
    printf("ESTIMATOR|multi_output_classifier|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multi_output_classifier_free(m_multi_output_classifier)

    # ---- multi_output_regressor (multioutput) ----
    t0 = flow_now_ns()
    let m_multi_output_regressor: MultiOutputRegressor = multi_output_regressor_fit(X_r, Y_multi, 2)
    t1 = flow_now_ns()
    let o_multi_output_regressor: Matrix = multi_output_regressor_predict(m_multi_output_regressor, X_r)
    t2 = flow_now_ns()
    matrix_free(o_multi_output_regressor)
    printf("ESTIMATOR|multi_output_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multi_output_regressor_free(m_multi_output_regressor)

    # ---- multiclass_logistic (classification) ----
    t0 = flow_now_ns()
    let m_multiclass_logistic: MultiClassLogisticRegression = multiclass_logistic_fit(X_c, y_c, 3, 50, 0.01, penalty_none())
    t1 = flow_now_ns()
    let o_multiclass_logistic: Matrix = multiclass_logistic_predict(m_multiclass_logistic, X_c)
    t2 = flow_now_ns()
    matrix_free(o_multiclass_logistic)
    printf("ESTIMATOR|multiclass_logistic|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multiclass_logistic_free(m_multiclass_logistic)

    # ---- multinomial_nb (classification) ----
    t0 = flow_now_ns()
    let m_multinomial_nb: MultinomialNB = multinomial_nb_fit(X_c, y_c, 3, 1.0)
    t1 = flow_now_ns()
    let o_multinomial_nb: ptr<f32> = multinomial_nb_predict(m_multinomial_nb, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_multinomial_nb)
    printf("ESTIMATOR|multinomial_nb|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multinomial_nb_free(m_multinomial_nb)

    # ---- multitask_elastic_net_cv (multioutput) ----
    t0 = flow_now_ns()
    let m_multitask_elastic_net_cv: MultiTaskElasticNetCV = multitask_elastic_net_cv_fit(X_r, Y_multi, 10)
    t1 = flow_now_ns()
    let o_multitask_elastic_net_cv: Matrix = multitask_elastic_net_cv_predict(m_multitask_elastic_net_cv, X_r)
    t2 = flow_now_ns()
    matrix_free(o_multitask_elastic_net_cv)
    printf("ESTIMATOR|multitask_elastic_net_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multitask_elastic_net_cv_free(m_multitask_elastic_net_cv)

    # ---- multitask_elastic_net (multioutput) ----
    t0 = flow_now_ns()
    let m_multitask_elastic_net: MultiTaskElasticNet = multitask_elastic_net_fit(X_r, Y_multi, 1.0, 0.5, 50, 0.01)
    t1 = flow_now_ns()
    let o_multitask_elastic_net: Matrix = multitask_elastic_net_predict(m_multitask_elastic_net, X_r)
    t2 = flow_now_ns()
    matrix_free(o_multitask_elastic_net)
    printf("ESTIMATOR|multitask_elastic_net|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multitask_elastic_net_free(m_multitask_elastic_net)

    # ---- multitask_lasso_cv (multioutput) ----
    t0 = flow_now_ns()
    let m_multitask_lasso_cv: MultiTaskLassoCV = multitask_lasso_cv_fit(X_r, Y_multi, 10)
    t1 = flow_now_ns()
    let o_multitask_lasso_cv: Matrix = multitask_lasso_cv_predict(m_multitask_lasso_cv, X_r)
    t2 = flow_now_ns()
    matrix_free(o_multitask_lasso_cv)
    printf("ESTIMATOR|multitask_lasso_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multitask_lasso_cv_free(m_multitask_lasso_cv)

    # ---- multitask_lasso (multioutput) ----
    t0 = flow_now_ns()
    let m_multitask_lasso: MultiTaskLasso = multitask_lasso_fit(X_r, Y_multi, 1.0, 50, 0.01)
    t1 = flow_now_ns()
    let o_multitask_lasso: Matrix = multitask_lasso_predict(m_multitask_lasso, X_r)
    t2 = flow_now_ns()
    matrix_free(o_multitask_lasso)
    printf("ESTIMATOR|multitask_lasso|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    multitask_lasso_free(m_multitask_lasso)

    # ---- nca (regression) ----
    t0 = flow_now_ns()
    let m_nca: NeighborhoodComponentsAnalysis = nca_fit(X_r, y_r, 2, 50, 0.01)
    t1 = flow_now_ns()
    let o_nca: Matrix = nca_transform(m_nca, X_r)
    t2 = flow_now_ns()
    matrix_free(o_nca)
    printf("ESTIMATOR|nca|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nca_free(m_nca)

    for i in 0 to n_c { array_free_f32(Y_label_rows[i]) }
    free(Y_label_rows as ptr<void>)
    matrix_free(Y_labels)
    for i in 0 to n_r { array_free_f32(Y_rows[i]) }
    free(Y_rows as ptr<void>)
    matrix_free(Y_multi)
    free(yi_c as ptr<void>)
    free(yi_r as ptr<void>)
    return 0
}
