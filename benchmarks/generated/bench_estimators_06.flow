    # ---- radius_neighbors_transformer (unsupervised) ----
    t0 = flow_now_ns()
    let m_radius_neighbors_transformer: RadiusNeighborsTransformer = radius_neighbors_transformer_fit(X_c, 1.0, 0)
    t1 = flow_now_ns()
    let o_radius_neighbors_transformer: Matrix = radius_neighbors_transformer_transform(m_radius_neighbors_transformer, X_c)
    t2 = flow_now_ns()
    matrix_free(o_radius_neighbors_transformer)
    printf("ESTIMATOR|radius_neighbors_transformer|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
