    # ---- quantile_regressor (regression) ----
    t0 = flow_now_ns()
    let m_quantile_regressor: QuantileRegressor = quantile_regressor_fit(X_r, y_r, 0.5, 1.0, 50, 0.01)
    t1 = flow_now_ns()
    let o_quantile_regressor: ptr<f32> = quantile_regressor_predict(m_quantile_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_quantile_regressor)
    printf("ESTIMATOR|quantile_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
