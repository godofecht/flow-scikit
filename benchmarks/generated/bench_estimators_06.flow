    # ---- random_forest_regressor (regression) ----
    t0 = flow_now_ns()
    let m_random_forest_regressor: RandomForestRegressor = random_forest_regressor_fit(X_r, y_r, 10, 5, 42)
    t1 = flow_now_ns()
    let o_random_forest_regressor: ptr<f32> = random_forest_regressor_predict(m_random_forest_regressor, X_r)
