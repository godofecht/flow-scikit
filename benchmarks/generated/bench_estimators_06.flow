    let o_radius_neighbors_regressor: ptr<f32> = radius_neighbors_regressor_predict(m_radius_neighbors_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_radius_neighbors_regressor)
    printf("ESTIMATOR|radius_neighbors_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
