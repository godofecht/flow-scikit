    radius_neighbors_transformer_free(m_radius_neighbors_transformer)

    # ---- random_forest_classifier (classification) ----
    t0 = flow_now_ns()
    let m_random_forest_classifier: RandomForestClassifier = random_forest_classifier_fit(X_c, y_c, 3, 10, 5, 42)
    t1 = flow_now_ns()
    let o_random_forest_classifier: ptr<f32> = random_forest_classifier_predict(m_random_forest_classifier, X_c)
    t2 = flow_now_ns()
