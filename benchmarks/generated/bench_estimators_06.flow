    # ---- quantile_transformer (unsupervised) ----
    t0 = flow_now_ns()
    let m_quantile_transformer: QuantileTransformer = quantile_transformer_fit(X_c, 10, 0)
    t1 = flow_now_ns()
    let o_quantile_transformer: Matrix = quantile_transformer_transform(m_quantile_transformer, X_c)
    t2 = flow_now_ns()
    matrix_free(o_quantile_transformer)
