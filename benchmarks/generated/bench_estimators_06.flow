    # ---- random_trees_embedding (unsupervised) ----
    t0 = flow_now_ns()
    let m_random_trees_embedding: RandomTreesEmbedding = random_trees_embedding_fit(X_c, 10, 5, 42)
    t1 = flow_now_ns()
    let o_random_trees_embedding: Matrix = random_trees_embedding_transform(m_random_trees_embedding, X_c)
    t2 = flow_now_ns()
