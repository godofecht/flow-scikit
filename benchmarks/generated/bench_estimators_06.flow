    # ---- ransac_regressor (regression) ----
    t0 = flow_now_ns()
    let m_ransac_regressor: RANSACRegressor = ransac_regressor_fit(X_r, y_r, 5, 10, 1.0, 42)
    t1 = flow_now_ns()
    let o_ransac_regressor: ptr<f32> = ransac_regressor_predict(m_ransac_regressor, X_r)
    t2 = flow_now_ns()
