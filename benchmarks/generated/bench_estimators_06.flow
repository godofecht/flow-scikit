    # ---- regressor_chain (multioutput_class) ----
    t0 = flow_now_ns()
    let m_regressor_chain: RegressorChain = regressor_chain_fit(X_c, Y_label_rows, n_c, f_c, 2)
    t1 = flow_now_ns()
