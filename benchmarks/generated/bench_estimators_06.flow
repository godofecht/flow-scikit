    let o_poisson_regressor: ptr<f32> = poisson_regressor_predict(m_poisson_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_poisson_regressor)
    printf("ESTIMATOR|poisson_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    poisson_regressor_free(m_poisson_regressor)

    # ---- power_transformer (unsupervised) ----
    t0 = flow_now_ns()
    let m_power_transformer: PowerTransformer = power_transformer_fit(X_c, 0)
    t1 = flow_now_ns()
    let o_power_transformer: Matrix = power_transformer_transform(m_power_transformer, X_c)
    t2 = flow_now_ns()
    matrix_free(o_power_transformer)
    printf("ESTIMATOR|power_transformer|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    power_transformer_free(m_power_transformer)

    # ---- qda (classification) ----
    t0 = flow_now_ns()
    let m_qda: QuadraticDiscriminantAnalysis = qda_fit(X_c, y_c, 3)
