import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fflush(stream: ptr<void>) -> i32
}

function ms_between(start: i64, finish: i64) -> f32 {
    return ((((finish - start) as f64) / 1000000.0) as f32)
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()
    let X_c: Matrix = iris.X
    let y_c: ptr<f32> = iris.y
    let n_c: i32 = X_c.rows
    let f_c: i32 = X_c.cols
    let X_r: Matrix = diabetes.X
    let y_r: ptr<f32> = diabetes.y
    let n_r: i32 = X_r.rows
    let f_r: i32 = X_r.cols

    let yi_c: ptr<i32> = malloc((n_c as i64) * 4) as ptr<i32>
    for i in 0 to n_c { yi_c[i] = y_c[i] as i32 }
    let yi_r: ptr<i32> = malloc((n_r as i64) * 4) as ptr<i32>
    for i in 0 to n_r { yi_r[i] = y_r[i] as i32 }

    # A two-column target for the cross-decomposition estimators.
    let Y_multi: Matrix = matrix_new(n_r, 2)
    for i in 0 to n_r {
        matrix_set(Y_multi, i, 0, y_r[i])
        matrix_set(Y_multi, i, 1, y_r[i] * 0.5)
    }

    # Label-valued targets for the multi-output classifiers.
    let Y_labels: Matrix = matrix_new(n_c, 2)
    let Y_label_rows: ptr<ptr<f32> > = malloc((n_c as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_c {
        let a: f32 = y_c[i]
        let b: f32 = ((((y_c[i] as i32) + 1) % 3) as f32)
        matrix_set(Y_labels, i, 0, a)
        matrix_set(Y_labels, i, 1, b)
        let lrow: ptr<f32> = array_new_f32(2)
        lrow[0] = a
        lrow[1] = b
        Y_label_rows[i] = lrow
    }

    let Y_rows: ptr<ptr<f32> > = malloc((n_r as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_r {
        let row: ptr<f32> = array_new_f32(2)
        row[0] = y_r[i]
        row[1] = y_r[i] * 0.5
        Y_rows[i] = row
    }

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ---- gradient_boosting_regressor (regression) ----
    t0 = flow_now_ns()
    let m_gradient_boosting_regressor: GradientBoostingRegressor = gradient_boosting_regressor_fit(X_r, y_r, 10, 0.1, 5)
    t1 = flow_now_ns()
    let o_gradient_boosting_regressor: ptr<f32> = gradient_boosting_regressor_predict(m_gradient_boosting_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_gradient_boosting_regressor)
    printf("ESTIMATOR|gradient_boosting_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    gradient_boosting_regressor_free(m_gradient_boosting_regressor)

    # ---- graphical_lasso (unsupervised) ----
    t0 = flow_now_ns()
    let m_graphical_lasso: GraphicalLasso = graphical_lasso_fit(X_c, 1.0, 100, 0.0001)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|graphical_lasso|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    graphical_lasso_free(m_graphical_lasso)

    # ---- hdbscan (unsupervised) ----
    t0 = flow_now_ns()
    let m_hdbscan: HDBSCAN = hdbscan_fit(X_c, 5, 5)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|hdbscan|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    hdbscan_free(m_hdbscan)

    # ---- hist_gradient_boosting_classifier (classification) ----
    t0 = flow_now_ns()
    let m_hist_gradient_boosting_classifier: HistGradientBoostingClassifier = hist_gradient_boosting_classifier_fit(X_c, y_c, n_c, 3, 10, 0.1, 5)
    t1 = flow_now_ns()
    let o_hist_gradient_boosting_classifier: ptr<f32> = hist_gradient_boosting_classifier_predict(m_hist_gradient_boosting_classifier, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_hist_gradient_boosting_classifier)
    printf("ESTIMATOR|hist_gradient_boosting_classifier|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    hist_gradient_boosting_classifier_free(m_hist_gradient_boosting_classifier)

    # ---- hist_gradient_boosting_regressor (regression) ----
    t0 = flow_now_ns()
    let m_hist_gradient_boosting_regressor: HistGradientBoostingRegressor = hist_gradient_boosting_regressor_fit(X_r, y_r, n_r, 10, 0.1, 5)
    t1 = flow_now_ns()
    let o_hist_gradient_boosting_regressor: ptr<f32> = hist_gradient_boosting_regressor_predict(m_hist_gradient_boosting_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_hist_gradient_boosting_regressor)
    printf("ESTIMATOR|hist_gradient_boosting_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
