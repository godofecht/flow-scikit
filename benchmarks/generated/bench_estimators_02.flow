    # ---- iterative_imputer (unsupervised) ----
    t0 = flow_now_ns()
    let m_iterative_imputer: IterativeImputer = iterative_imputer_fit(X_c, 100, 0.0001, 42)
    t1 = flow_now_ns()
    let o_iterative_imputer: Matrix = iterative_imputer_transform(m_iterative_imputer, X_c)
    t2 = flow_now_ns()
    matrix_free(o_iterative_imputer)
    printf("ESTIMATOR|iterative_imputer|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
