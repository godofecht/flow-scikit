    # ---- kernel_svc_multi (classification) ----
    t0 = flow_now_ns()
    let m_kernel_svc_multi: KernelSVCMulti = kernel_svc_multi_fit(X_c, y_c, 3, 0.1, 1.0, 100)
    t1 = flow_now_ns()
    let o_kernel_svc_multi: ptr<f32> = kernel_svc_multi_predict(m_kernel_svc_multi, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_kernel_svc_multi)
    printf("ESTIMATOR|kernel_svc_multi|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    kernel_svc_multi_free(m_kernel_svc_multi)

    # ---- kmeans (unsupervised) ----
    t0 = flow_now_ns()
    let m_kmeans: KMeans = kmeans_fit(X_c, 3, 100, 0.0001, 42)
    t1 = flow_now_ns()
    let o_kmeans: ptr<i32> = kmeans_predict(m_kmeans, X_c)
    t2 = flow_now_ns()
    printf("ESTIMATOR|kmeans|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
