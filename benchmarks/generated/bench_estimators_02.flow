    # ---- huber_regressor (regression) ----
    t0 = flow_now_ns()
    let m_huber_regressor: HuberRegressor = huber_regressor_fit(X_r, y_r, 0.1, 100, 0.01)
    t1 = flow_now_ns()
    let o_huber_regressor: ptr<f32> = huber_regressor_predict(m_huber_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_huber_regressor)
    printf("ESTIMATOR|huber_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    huber_regressor_free(m_huber_regressor)

    # ---- isolation_forest (unsupervised) ----
    t0 = flow_now_ns()
    let m_isolation_forest: IsolationForest = isolation_forest_fit(X_c, 10, 5, 42)
    t1 = flow_now_ns()
    let o_isolation_forest: ptr<i32> = isolation_forest_predict(m_isolation_forest, X_c)
    t2 = flow_now_ns()
    printf("ESTIMATOR|isolation_forest|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
