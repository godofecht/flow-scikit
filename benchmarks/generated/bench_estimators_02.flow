    # ---- kernel_pca (unsupervised) ----
    t0 = flow_now_ns()
    let m_kernel_pca: KernelPCA = kernel_pca_fit(X_c, 2, 0, 0.1, 2, 0.0)
    t1 = flow_now_ns()
    let o_kernel_pca: Matrix = kernel_pca_transform(m_kernel_pca, X_c)
    t2 = flow_now_ns()
    matrix_free(o_kernel_pca)
    printf("ESTIMATOR|kernel_pca|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    kernel_pca_free(m_kernel_pca)

    # ---- kernel_ridge (regression) ----
    t0 = flow_now_ns()
    let m_kernel_ridge: KernelRidge = kernel_ridge_fit(X_r, y_r, 1.0, 0, 0.1, 2, 0.0)
    t1 = flow_now_ns()
    let o_kernel_ridge: ptr<f32> = kernel_ridge_predict(m_kernel_ridge, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_kernel_ridge)
    printf("ESTIMATOR|kernel_ridge|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
