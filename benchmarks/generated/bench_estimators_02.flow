    # ---- kneighbors_transformer (unsupervised) ----
    t0 = flow_now_ns()
    let m_kneighbors_transformer: KNeighborsTransformer = kneighbors_transformer_fit(X_c, 5, 0)
    t1 = flow_now_ns()
    let o_kneighbors_transformer: Matrix = kneighbors_transformer_transform(m_kneighbors_transformer, X_c)
