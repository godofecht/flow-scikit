    # ---- kbins_discretizer (unsupervised) ----
    t0 = flow_now_ns()
    let m_kbins_discretizer: KBinsDiscretizer = kbins_discretizer_fit(X_c, 4, 0)
    t1 = flow_now_ns()
    let o_kbins_discretizer: Matrix = kbins_discretizer_transform(m_kbins_discretizer, X_c)
    t2 = flow_now_ns()
    matrix_free(o_kbins_discretizer)
    printf("ESTIMATOR|kbins_discretizer|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    kbins_discretizer_free(m_kbins_discretizer)

    # ---- kernel_density (unsupervised) ----
    t0 = flow_now_ns()
    let m_kernel_density: KernelDensity = kernel_density_fit(X_c, 1.0, 0)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|kernel_density|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
