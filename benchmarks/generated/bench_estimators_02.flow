    # ---- kernel_svc (classification) ----
    t0 = flow_now_ns()
    let m_kernel_svc: KernelSVC = kernel_svc_fit(X_c, y_c, 3, 1.0, 0.1, 100)
    t1 = flow_now_ns()
    let o_kernel_svc: ptr<f32> = kernel_svc_predict(m_kernel_svc, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_kernel_svc)
    printf("ESTIMATOR|kernel_svc|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
