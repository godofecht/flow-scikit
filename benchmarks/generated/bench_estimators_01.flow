    t0 = flow_now_ns()
    let m_gaussian_nb: GaussianNB = gaussian_nb_fit(X_c, y_c, 3, 0.000000001)
    t1 = flow_now_ns()
    let o_gaussian_nb: ptr<f32> = gaussian_nb_predict(m_gaussian_nb, X_c)
