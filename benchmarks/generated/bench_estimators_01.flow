    # ---- elastic_net (regression) ----
    t0 = flow_now_ns()
    let m_elastic_net: ElasticNet = elastic_net_fit(X_r, y_r, 1.0, 0.5, 50, 0.01)
    t1 = flow_now_ns()
    let o_elastic_net: ptr<f32> = elastic_net_predict(m_elastic_net, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_elastic_net)
    printf("ESTIMATOR|elastic_net|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
