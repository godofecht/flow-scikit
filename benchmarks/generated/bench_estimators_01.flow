    # ---- factor_analysis (unsupervised) ----
    t0 = flow_now_ns()
    let m_factor_analysis: FactorAnalysis = factor_analysis_fit(X_c, 2, 100, 0.0001)
    t1 = flow_now_ns()
    let o_factor_analysis: Matrix = factor_analysis_transform(m_factor_analysis, X_c)
    t2 = flow_now_ns()
