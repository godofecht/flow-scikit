    # ---- feature_agglomeration (unsupervised) ----
    t0 = flow_now_ns()
    let m_feature_agglomeration: FeatureAgglomeration = feature_agglomeration_fit(X_c, 3)
    t1 = flow_now_ns()
    let o_feature_agglomeration: Matrix = feature_agglomeration_transform(m_feature_agglomeration, X_c)
    t2 = flow_now_ns()
