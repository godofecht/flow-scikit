    let o_extra_trees_regressor: ptr<f32> = extra_trees_regressor_predict(m_extra_trees_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_extra_trees_regressor)
    printf("ESTIMATOR|extra_trees_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
