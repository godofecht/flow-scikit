    # ---- fast_ica (unsupervised) ----
    t0 = flow_now_ns()
    let m_fast_ica: FastICA = fast_ica_fit(X_c, 2, 100, 0.0001, 42)
    t1 = flow_now_ns()
    let o_fast_ica: Matrix = fast_ica_transform(m_fast_ica, X_c)
    t2 = flow_now_ns()
