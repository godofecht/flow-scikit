    # ---- empirical_covariance (unsupervised) ----
    t0 = flow_now_ns()
    let m_empirical_covariance: EmpiricalCovariance = empirical_covariance_fit(X_c)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|empirical_covariance|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    empirical_covariance_free(m_empirical_covariance)

    # ---- extra_tree_classifier (classification) ----
    t0 = flow_now_ns()
    let m_extra_tree_classifier: ExtraTreeClassifier = extra_tree_classifier_fit(X_c, y_c, n_c, f_c, 3, 5, 42)
    t1 = flow_now_ns()
    let o_extra_tree_classifier: ptr<f32> = extra_tree_classifier_predict(m_extra_tree_classifier, X_c)
