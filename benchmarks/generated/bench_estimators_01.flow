    # ---- gamma_regressor (regression) ----
    t0 = flow_now_ns()
    let m_gamma_regressor: GammaRegressor = gamma_regressor_fit(X_r, y_r, 1.0, 100, 0.01)
    t1 = flow_now_ns()
    let o_gamma_regressor: ptr<f32> = gamma_regressor_predict(m_gamma_regressor, X_r)
