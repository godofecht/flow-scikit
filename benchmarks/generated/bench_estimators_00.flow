    # ---- bernoulli_nb (classification) ----
    t0 = flow_now_ns()
    let m_bernoulli_nb: BernoulliNB = bernoulli_nb_fit(X_c, y_c, 3, 1.0)
    t1 = flow_now_ns()
    let o_bernoulli_nb: ptr<f32> = bernoulli_nb_predict(m_bernoulli_nb, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_bernoulli_nb)
    printf("ESTIMATOR|bernoulli_nb|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    bernoulli_nb_free(m_bernoulli_nb)

    # ---- bernoulli_rbm (unsupervised) ----
    t0 = flow_now_ns()
    let m_bernoulli_rbm: BernoulliRBM = bernoulli_rbm_fit(X_c, 2, 0.1, 50, 32, 42)
    t1 = flow_now_ns()
    let o_bernoulli_rbm: Matrix = bernoulli_rbm_transform(m_bernoulli_rbm, X_c)
    t2 = flow_now_ns()
    matrix_free(o_bernoulli_rbm)
    printf("ESTIMATOR|bernoulli_rbm|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    bernoulli_rbm_free(m_bernoulli_rbm)

    # ---- birch (unsupervised) ----
    t0 = flow_now_ns()
    let m_birch: Birch = birch_fit(X_c, 0.5, 50)
    t1 = flow_now_ns()
    let o_birch: ptr<i32> = birch_predict(m_birch, X_c)
    t2 = flow_now_ns()
    printf("ESTIMATOR|birch|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
