    # ---- calibrated_classifier_cv (classification) ----
    t0 = flow_now_ns()
    let m_calibrated_classifier_cv: CalibratedClassifierCV = calibrated_classifier_cv_fit(X_c, y_c, 3, 3, 0)
    t1 = flow_now_ns()
    let o_calibrated_classifier_cv: ptr<f32> = calibrated_classifier_cv_predict(m_calibrated_classifier_cv, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_calibrated_classifier_cv)
    printf("ESTIMATOR|calibrated_classifier_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    calibrated_classifier_cv_free(m_calibrated_classifier_cv)

    # ---- categorical_nb (classification) ----
    let n_categories_categorical_nb: array<i32, 4> = [4, 4, 4, 4]
    t0 = flow_now_ns()
    let m_categorical_nb: CategoricalNB = categorical_nb_fit(X_c, y_c, 3, n_categories_categorical_nb, 1.0)
    t1 = flow_now_ns()
    let o_categorical_nb: ptr<f32> = categorical_nb_predict(m_categorical_nb, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_categorical_nb)
    printf("ESTIMATOR|categorical_nb|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    categorical_nb_free(m_categorical_nb)

    # ---- cca (multioutput) ----
    t0 = flow_now_ns()
    let m_cca: CCA = cca_fit(X_r, Y_multi, 2, 100, 0.0001)
    t1 = flow_now_ns()
    let o_cca: Matrix = cca_transform(m_cca, X_r)
    t2 = flow_now_ns()
    matrix_free(o_cca)
    printf("ESTIMATOR|cca|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    cca_free(m_cca)

    # ---- classifier_chain (multioutput_class) ----
    t0 = flow_now_ns()
    let m_classifier_chain: ClassifierChain = classifier_chain_fit(X_c, Y_label_rows, n_c, f_c, 2, 0.01, 50)
    t1 = flow_now_ns()
