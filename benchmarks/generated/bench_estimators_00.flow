import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fflush(stream: ptr<void>) -> i32
}

function ms_between(start: i64, finish: i64) -> f32 {
    return ((((finish - start) as f64) / 1000000.0) as f32)
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()
    let X_c: Matrix = iris.X
    let y_c: ptr<f32> = iris.y
    let n_c: i32 = X_c.rows
    let f_c: i32 = X_c.cols
    let X_r: Matrix = diabetes.X
    let y_r: ptr<f32> = diabetes.y
    let n_r: i32 = X_r.rows
    let f_r: i32 = X_r.cols

    let yi_c: ptr<i32> = malloc((n_c as i64) * 4) as ptr<i32>
    for i in 0 to n_c { yi_c[i] = y_c[i] as i32 }
    let yi_r: ptr<i32> = malloc((n_r as i64) * 4) as ptr<i32>
    for i in 0 to n_r { yi_r[i] = y_r[i] as i32 }

    # A two-column target for the cross-decomposition estimators.
    let Y_multi: Matrix = matrix_new(n_r, 2)
    for i in 0 to n_r {
        matrix_set(Y_multi, i, 0, y_r[i])
        matrix_set(Y_multi, i, 1, y_r[i] * 0.5)
    }

    # Label-valued targets for the multi-output classifiers.
    let Y_labels: Matrix = matrix_new(n_c, 2)
    let Y_label_rows: ptr<ptr<f32> > = malloc((n_c as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_c {
        let a: f32 = y_c[i]
        let b: f32 = ((((y_c[i] as i32) + 1) % 3) as f32)
        matrix_set(Y_labels, i, 0, a)
        matrix_set(Y_labels, i, 1, b)
        let lrow: ptr<f32> = array_new_f32(2)
        lrow[0] = a
        lrow[1] = b
        Y_label_rows[i] = lrow
    }

    let Y_rows: ptr<ptr<f32> > = malloc((n_r as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_r {
        let row: ptr<f32> = array_new_f32(2)
        row[0] = y_r[i]
        row[1] = y_r[i] * 0.5
        Y_rows[i] = row
    }

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ---- adaboost_classifier (classification) ----
    t0 = flow_now_ns()
    let m_adaboost_classifier: AdaBoostClassifier = adaboost_classifier_fit(X_c, y_c, 3, 10, 5, 42)
    t1 = flow_now_ns()
    let o_adaboost_classifier: ptr<f32> = adaboost_classifier_predict(m_adaboost_classifier, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_adaboost_classifier)
    printf("ESTIMATOR|adaboost_classifier|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    adaboost_classifier_free(m_adaboost_classifier)

    # ---- adaboost_regressor (regression) ----
    t0 = flow_now_ns()
    let m_adaboost_regressor: AdaBoostRegressor = adaboost_regressor_fit(X_r, y_r, 10, 5, 42)
    t1 = flow_now_ns()
    let o_adaboost_regressor: ptr<f32> = adaboost_regressor_predict(m_adaboost_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_adaboost_regressor)
    printf("ESTIMATOR|adaboost_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    adaboost_regressor_free(m_adaboost_regressor)

    # ---- affinity_propagation (unsupervised) ----
    t0 = flow_now_ns()
    let m_affinity_propagation: AffinityPropagation = affinity_propagation_fit(X_c, 0.5, 100, 15)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|affinity_propagation|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    affinity_propagation_free(m_affinity_propagation)

    # ---- agglomerative_clustering (unsupervised) ----
    t0 = flow_now_ns()
    let m_agglomerative_clustering: AgglomerativeClustering = agglomerative_clustering_fit(X_c, 3)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|agglomerative_clustering|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    agglomerative_clustering_free(m_agglomerative_clustering)

    # ---- ard_regression (regression) ----
    t0 = flow_now_ns()
    let m_ard_regression: ARDRegression = ard_regression_fit(X_r, y_r, 100, 0.0001)
    t1 = flow_now_ns()
    let o_ard_regression: ptr<f32> = ard_regression_predict(m_ard_regression, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_ard_regression)
    printf("ESTIMATOR|ard_regression|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    ard_regression_free(m_ard_regression)

    # ---- bagging_classifier (classification) ----
    t0 = flow_now_ns()
    let m_bagging_classifier: BaggingClassifier = bagging_classifier_fit(X_c, y_c, 3, 10, 5, 42)
    t1 = flow_now_ns()
    let o_bagging_classifier: ptr<f32> = bagging_classifier_predict(m_bagging_classifier, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_bagging_classifier)
    printf("ESTIMATOR|bagging_classifier|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    bagging_classifier_free(m_bagging_classifier)

    # ---- bagging_regressor (regression) ----
    t0 = flow_now_ns()
    let m_bagging_regressor: BaggingRegressor = bagging_regressor_fit(X_r, y_r, 10, 5, 42)
    t1 = flow_now_ns()
    let o_bagging_regressor: ptr<f32> = bagging_regressor_predict(m_bagging_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_bagging_regressor)
    printf("ESTIMATOR|bagging_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    bagging_regressor_free(m_bagging_regressor)

    # ---- bayesian_gaussian_mixture (unsupervised) ----
    t0 = flow_now_ns()
    let m_bayesian_gaussian_mixture: BayesianGaussianMixture = bayesian_gaussian_mixture_fit(X_c, 2, 100, 0.0001, 42)
    t1 = flow_now_ns()
    let o_bayesian_gaussian_mixture: ptr<f32> = bayesian_gaussian_mixture_predict(m_bayesian_gaussian_mixture, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_bayesian_gaussian_mixture)
    printf("ESTIMATOR|bayesian_gaussian_mixture|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    bayesian_gaussian_mixture_free(m_bayesian_gaussian_mixture)

    # ---- bayesian_ridge (regression) ----
    t0 = flow_now_ns()
    let m_bayesian_ridge: BayesianRidge = bayesian_ridge_fit(X_r, y_r, 100, 0.0001)
    t1 = flow_now_ns()
    let o_bayesian_ridge: ptr<f32> = bayesian_ridge_predict(m_bayesian_ridge, X_r)
    t2 = flow_now_ns()
