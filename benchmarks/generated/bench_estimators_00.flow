    # ---- bisecting_kmeans (unsupervised) ----
    t0 = flow_now_ns()
    let m_bisecting_kmeans: BisectingKMeans = bisecting_kmeans_fit(X_c, 3, 100, 42)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|bisecting_kmeans|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
