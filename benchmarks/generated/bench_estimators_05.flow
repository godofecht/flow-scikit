import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function fflush(stream: ptr<void>) -> i32
}

function ms_between(start: i64, finish: i64) -> f32 {
    return ((((finish - start) as f64) / 1000000.0) as f32)
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()
    let X_c: Matrix = iris.X
    let y_c: ptr<f32> = iris.y
    let n_c: i32 = X_c.rows
    let f_c: i32 = X_c.cols
    let X_r: Matrix = diabetes.X
    let y_r: ptr<f32> = diabetes.y
    let n_r: i32 = X_r.rows
    let f_r: i32 = X_r.cols

    let yi_c: ptr<i32> = malloc((n_c as i64) * 4) as ptr<i32>
    for i in 0 to n_c { yi_c[i] = y_c[i] as i32 }
    let yi_r: ptr<i32> = malloc((n_r as i64) * 4) as ptr<i32>
    for i in 0 to n_r { yi_r[i] = y_r[i] as i32 }

    # A two-column target for the cross-decomposition estimators.
    let Y_multi: Matrix = matrix_new(n_r, 2)
    for i in 0 to n_r {
        matrix_set(Y_multi, i, 0, y_r[i])
        matrix_set(Y_multi, i, 1, y_r[i] * 0.5)
    }

    # Label-valued targets for the multi-output classifiers.
    let Y_labels: Matrix = matrix_new(n_c, 2)
    let Y_label_rows: ptr<ptr<f32> > = malloc((n_c as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_c {
        let a: f32 = y_c[i]
        let b: f32 = ((((y_c[i] as i32) + 1) % 3) as f32)
        matrix_set(Y_labels, i, 0, a)
        matrix_set(Y_labels, i, 1, b)
        let lrow: ptr<f32> = array_new_f32(2)
        lrow[0] = a
        lrow[1] = b
        Y_label_rows[i] = lrow
    }

    let Y_rows: ptr<ptr<f32> > = malloc((n_r as i64) * 8) as ptr<ptr<f32> >
    for i in 0 to n_r {
        let row: ptr<f32> = array_new_f32(2)
        row[0] = y_r[i]
        row[1] = y_r[i] * 0.5
        Y_rows[i] = row
    }

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ---- nearest_centroid (classification) ----
    t0 = flow_now_ns()
    let m_nearest_centroid: NearestCentroid = nearest_centroid_fit(X_c, y_c, 3)
    t1 = flow_now_ns()
    let o_nearest_centroid: ptr<f32> = nearest_centroid_predict(m_nearest_centroid, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_nearest_centroid)
    printf("ESTIMATOR|nearest_centroid|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nearest_centroid_free(m_nearest_centroid)

    # ---- nearest_neighbors (unsupervised) ----
    t0 = flow_now_ns()
    let m_nearest_neighbors: NearestNeighbors = nearest_neighbors_fit(X_c, 5)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|nearest_neighbors|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nearest_neighbors_free(m_nearest_neighbors)

    # ---- nmf (unsupervised) ----
    t0 = flow_now_ns()
    let m_nmf: NMF = nmf_fit(X_c, 2, 100, 0.0001, 42)
    t1 = flow_now_ns()
    let o_nmf: Matrix = nmf_transform(m_nmf, X_c)
    t2 = flow_now_ns()
    matrix_free(o_nmf)
    printf("ESTIMATOR|nmf|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nmf_free(m_nmf)

    # ---- nu_svc (regression) ----
    t0 = flow_now_ns()
    let m_nu_svc: NuSVC = nu_svc_fit(X_r, y_r, 0.5, 0.1, 100, 1.0)
    t1 = flow_now_ns()
    let o_nu_svc: ptr<f32> = nu_svc_predict(m_nu_svc, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_nu_svc)
    printf("ESTIMATOR|nu_svc|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nu_svc_free(m_nu_svc)

    # ---- nu_svr (regression) ----
    t0 = flow_now_ns()
    let m_nu_svr: NuSVR = nu_svr_fit(X_r, y_r, 0.5, 1.0, 0.1, 100)
    t1 = flow_now_ns()
    let o_nu_svr: ptr<f32> = nu_svr_predict(m_nu_svr, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_nu_svr)
    printf("ESTIMATOR|nu_svr|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nu_svr_free(m_nu_svr)

    # ---- nystroem (unsupervised) ----
    t0 = flow_now_ns()
    let m_nystroem: Nystroem = nystroem_fit(X_c, 2, 0.1, 0, 42)
    t1 = flow_now_ns()
    let o_nystroem: Matrix = nystroem_transform(m_nystroem, X_c)
    t2 = flow_now_ns()
    matrix_free(o_nystroem)
    printf("ESTIMATOR|nystroem|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    nystroem_free(m_nystroem)

    # ---- oas_estimator (unsupervised) ----
    t0 = flow_now_ns()
    let m_oas_estimator: ShrunkCovariance = oas_estimator_fit(X_c)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|oas_estimator|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)

    # ---- omp_cv (regression) ----
    t0 = flow_now_ns()
    let m_omp_cv: OrthogonalMatchingPursuitCV = omp_cv_fit(X_r, y_r, 3)
    t1 = flow_now_ns()
    let o_omp_cv: ptr<f32> = omp_cv_predict(m_omp_cv, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_omp_cv)
    printf("ESTIMATOR|omp_cv|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    omp_cv_free(m_omp_cv)

    # ---- one_class_svm (unsupervised) ----
    t0 = flow_now_ns()
    let m_one_class_svm: OneClassSVM = one_class_svm_fit(X_c, 0.5, 0.1, 100)
    t1 = flow_now_ns()
    let o_one_class_svm: ptr<i32> = one_class_svm_predict(m_one_class_svm, X_c)
    t2 = flow_now_ns()
    printf("ESTIMATOR|one_class_svm|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    one_class_svm_free(m_one_class_svm)

    # ---- one_vs_one (classification) ----
    t0 = flow_now_ns()
    let m_one_vs_one: OneVsOneClassifier = one_vs_one_fit(X_c, y_c, 3, 50, 0.01, penalty_none())
    t1 = flow_now_ns()
    let o_one_vs_one: ptr<f32> = one_vs_one_predict(m_one_vs_one, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_one_vs_one)
    printf("ESTIMATOR|one_vs_one|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    one_vs_one_free(m_one_vs_one)

    # ---- one_vs_rest (classification) ----
    t0 = flow_now_ns()
    let m_one_vs_rest: OneVsRestClassifier = one_vs_rest_fit(X_c, y_c, 3, 50, 0.01, penalty_none())
    t1 = flow_now_ns()
    let o_one_vs_rest: ptr<f32> = one_vs_rest_predict(m_one_vs_rest, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_one_vs_rest)
    printf("ESTIMATOR|one_vs_rest|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    one_vs_rest_free(m_one_vs_rest)

    # ---- onehot_encoder (unsupervised) ----
    t0 = flow_now_ns()
    let m_onehot_encoder: OneHotEncoder = onehot_encoder_fit(X_c, 0)
    t1 = flow_now_ns()
    let o_onehot_encoder: Matrix = onehot_encoder_transform(m_onehot_encoder, X_c)
    t2 = flow_now_ns()
    matrix_free(o_onehot_encoder)
    printf("ESTIMATOR|onehot_encoder|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    onehot_encoder_free(m_onehot_encoder)

    # ---- optics (unsupervised) ----
    t0 = flow_now_ns()
    let m_optics: OPTICS = optics_fit(X_c, 0.5, 5)
    t1 = flow_now_ns()
    t2 = t1
    printf("ESTIMATOR|optics|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    optics_free(m_optics)

    # ---- ordinal_encoder (unsupervised) ----
    t0 = flow_now_ns()
    let m_ordinal_encoder: OrdinalEncoder = ordinal_encoder_fit(X_c, 0)
    t1 = flow_now_ns()
    let o_ordinal_encoder: Matrix = ordinal_encoder_transform(m_ordinal_encoder, X_c)
    t2 = flow_now_ns()
    matrix_free(o_ordinal_encoder)
    printf("ESTIMATOR|ordinal_encoder|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    ordinal_encoder_free(m_ordinal_encoder)

    # ---- orthogonal_matching_pursuit (regression) ----
    t0 = flow_now_ns()
    let m_orthogonal_matching_pursuit: OrthogonalMatchingPursuit = orthogonal_matching_pursuit_fit(X_r, y_r, 3)
    t1 = flow_now_ns()
    let o_orthogonal_matching_pursuit: ptr<f32> = orthogonal_matching_pursuit_predict(m_orthogonal_matching_pursuit, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_orthogonal_matching_pursuit)
    printf("ESTIMATOR|orthogonal_matching_pursuit|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    orthogonal_matching_pursuit_free(m_orthogonal_matching_pursuit)

    # ---- output_code (classification) ----
    t0 = flow_now_ns()
    let m_output_code: OutputCodeClassifier = output_code_fit(X_c, y_c, 3, 4, 50, 0.01, penalty_none())
    t1 = flow_now_ns()
    let o_output_code: ptr<f32> = output_code_predict(m_output_code, X_c)
    t2 = flow_now_ns()
    array_free_f32(o_output_code)
    printf("ESTIMATOR|output_code|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    output_code_free(m_output_code)

    # ---- passive_aggressive_classifier (regression) ----
    t0 = flow_now_ns()
    let m_passive_aggressive_classifier: PassiveAggressiveClassifier = passive_aggressive_classifier_fit(X_r, y_r, 50, 1.0)
    t1 = flow_now_ns()
    let o_passive_aggressive_classifier: ptr<f32> = passive_aggressive_classifier_predict(m_passive_aggressive_classifier, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_passive_aggressive_classifier)
    printf("ESTIMATOR|passive_aggressive_classifier|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    passive_aggressive_classifier_free(m_passive_aggressive_classifier)

    # ---- passive_aggressive_regressor (regression) ----
    t0 = flow_now_ns()
    let m_passive_aggressive_regressor: PassiveAggressiveRegressor = passive_aggressive_regressor_fit(X_r, y_r, 1.0, 100)
    t1 = flow_now_ns()
    let o_passive_aggressive_regressor: ptr<f32> = passive_aggressive_regressor_predict(m_passive_aggressive_regressor, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_passive_aggressive_regressor)
    printf("ESTIMATOR|passive_aggressive_regressor|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    passive_aggressive_regressor_free(m_passive_aggressive_regressor)

    # ---- pca (unsupervised) ----
    t0 = flow_now_ns()
    let m_pca: PCA = pca_fit(X_c, 2)
    t1 = flow_now_ns()
    let o_pca: Matrix = pca_transform(m_pca, X_c)
    t2 = flow_now_ns()
    matrix_free(o_pca)
    printf("ESTIMATOR|pca|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    pca_free(m_pca)

    # ---- perceptron (regression) ----
    t0 = flow_now_ns()
    let m_perceptron: Perceptron = perceptron_fit(X_r, y_r, 50, 0.01, 42)
    t1 = flow_now_ns()
    let o_perceptron: ptr<f32> = perceptron_predict(m_perceptron, X_r)
    t2 = flow_now_ns()
    array_free_f32(o_perceptron)
    printf("ESTIMATOR|perceptron|%.9f|%.9f|ok\n", ms_between(t0, t1), ms_between(t1, t2))
    fflush(null)
    perceptron_free(m_perceptron)

    for i in 0 to n_c { array_free_f32(Y_label_rows[i]) }
    free(Y_label_rows as ptr<void>)
    matrix_free(Y_labels)
    for i in 0 to n_r { array_free_f32(Y_rows[i]) }
    free(Y_rows as ptr<void>)
    matrix_free(Y_multi)
    free(yi_c as ptr<void>)
    free(yi_r as ptr<void>)
    return 0
}
