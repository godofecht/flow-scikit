    array_free_f32(gbr_dia_preds)
    gradient_boosting_regressor_free(gbr_dia)

    # --- AdaBoostRegressor ---
    t0 = clock()
    let abr_dia: AdaBoostRegressor = adaboost_regressor_fit(X_train_dia, split_dia.y_train, 10, 3, 42)
    t1 = clock()
    let abr_dia_preds: ptr<f32> = adaboost_regressor_predict(abr_dia, X_test_dia)
    t2 = clock()
    let abr_dia_r2: f32 = r2_score(split_dia.y_test, abr_dia_preds, split_dia.n_test)
    printf("RESULT|AdaBoostRegressor|diabetes|r2|%.6f|%.6f|%.6f\n", abr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(abr_dia_preds)
    adaboost_regressor_free(abr_dia)

    # --- KNeighborsRegressor ---
    t0 = clock()
    let knnr_dia: KNNRegressor = knn_regressor_fit(X_train_dia, split_dia.y_train, 5)
    t1 = clock()
    let knnr_dia_preds: ptr<f32> = knn_regressor_predict(knnr_dia, X_test_dia)
    t2 = clock()
    let knnr_dia_r2: f32 = r2_score(split_dia.y_test, knnr_dia_preds, split_dia.n_test)
    printf("RESULT|KNeighborsRegressor|diabetes|r2|%.6f|%.6f|%.6f\n", knnr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(knnr_dia_preds)
    knn_regressor_free(knnr_dia)

    # --- MLPRegressor ---
    let mlp_reg_hidden: ptr<i32> = malloc(4) as ptr<i32>
    mlp_reg_hidden[0] = 100
    t0 = clock()
    let mlpr_dia: MLPRegressor = mlp_regressor_fit(X_train_dia, split_dia.y_train, mlp_reg_hidden, 1, MLP_ACT_RELU, 500, 0.01, 0.9, 42)
    t1 = clock()
    let mlpr_dia_preds: ptr<f32> = mlp_regressor_predict(mlpr_dia, X_test_dia)
    t2 = clock()
    let mlpr_dia_r2: f32 = r2_score(split_dia.y_test, mlpr_dia_preds, split_dia.n_test)
    printf("RESULT|MLPRegressor|diabetes|r2|%.6f|%.6f|%.6f\n", mlpr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(mlpr_dia_preds)
    mlp_regressor_free(mlpr_dia)
    free(mlp_reg_hidden as ptr<void>)

    # --- DummyRegressor (mean) ---
    t0 = clock()
    let dr_dia: DummyRegressor = dummy_regressor_fit(split_dia.y_train, split_dia.n_train, DUMMY_REG_MEAN, 0.0)
    t1 = clock()
    let dr_dia_preds: ptr<f32> = dummy_regressor_predict(dr_dia, split_dia.n_test)
    t2 = clock()
    let dr_dia_r2: f32 = r2_score(split_dia.y_test, dr_dia_preds, split_dia.n_test)
    printf("RESULT|DummyRegressor|diabetes|r2|%.6f|%.6f|%.6f\n", dr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dr_dia_preds)
    dummy_regressor_free(dr_dia)

    # Cleanup diabetes regression
    standard_scaler_free(scaler_dia)
    matrix_free(X_train_dia)
    matrix_free(X_test_dia)
    free_split(split_dia)
    dataset_free(ds_dia)

    # ================================================================
    # DIMENSIONALITY REDUCTION (iris, full dataset)
    # ================================================================
    printf("\n# === DIMENSIONALITY REDUCTION (iris) ===\n")

    # PCA
    t0 = clock()
    let pca_model: PCA = pca_fit(ds_iris.X, 2)
    t1 = clock()
    let pca_result: Matrix = pca_transform(pca_model, ds_iris.X)
    t2 = clock()
    let pca_evr: f32 = pca_model.explained_variance_ratio[0]
    printf("RESULT|PCA|iris|explained_variance_ratio_0|%.6f|%.6f|%.6f\n", pca_evr, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    matrix_free(pca_result)
    pca_free(pca_model)

    # TruncatedSVD
    t0 = clock()
    let svd_model: TruncatedSVD = truncated_svd_fit(ds_iris.X, 2)
    t1 = clock()
    let svd_result: Matrix = truncated_svd_transform(svd_model, ds_iris.X)
    t2 = clock()
    let svd_evr: f32 = svd_model.explained_variance_ratio[0]
    printf("RESULT|TruncatedSVD|iris|explained_variance_ratio_0|%.6f|%.6f|%.6f\n", svd_evr, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    matrix_free(svd_result)
    truncated_svd_free(svd_model)

    # NMF (iris features are non-negative)
    t0 = clock()
    let nmf_model: NMF = nmf_fit(ds_iris.X, 2, 200, 0.001, 42)
    t1 = clock()
    let nmf_result: Matrix = nmf_transform(nmf_model, ds_iris.X)
    t2 = clock()
    let nmf_err: f32 = nmf_model.reconstruction_err
    printf("RESULT|NMF|iris|reconstruction_error|%.6f|%.6f|%.6f\n", nmf_err, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    matrix_free(nmf_result)
    nmf_free(nmf_model)

    # FastICA
    t0 = clock()
    let ica_model: FastICA = fast_ica_fit(ds_iris.X, 2, 200, 0.001, 42)
    t1 = clock()
    let ica_result: Matrix = fast_ica_transform(ica_model, ds_iris.X)
    t2 = clock()
    let ica_kurt: f32 = kurtosis_first_component(ica_result)
    printf("RESULT|FastICA|iris|kurtosis_first_component|%.6f|%.6f|%.6f\n", ica_kurt, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    matrix_free(ica_result)
    fast_ica_free(ica_model)

    # ================================================================
    # CLUSTERING (iris, full dataset, adjusted_rand_index)
    # ================================================================
    printf("\n# === CLUSTERING (iris) ===\n")

    let n_iris_full: i32 = ds_iris.n_samples
    let y_true_iris: ptr<f32> = ds_iris.y

    # KMeans
    t0 = clock()
    let km_clust: KMeans = kmeans_fit(ds_iris.X, 3, 100, 0.001, 42)
    t1 = clock()
    let km_clust_labels_f32: ptr<f32> = i32_labels_to_f32(km_clust.labels, n_iris_full)
    t2 = clock()
    let km_ari: f32 = adjusted_rand_index(y_true_iris, km_clust_labels_f32, n_iris_full)
    printf("RESULT|KMeans|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", km_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(km_clust_labels_f32)
    kmeans_free(km_clust)

    # AgglomerativeClustering
    t0 = clock()
    let agg_clust: AgglomerativeClustering = agglomerative_clustering_fit(ds_iris.X, 3)
    t1 = clock()
    let agg_labels_f32: ptr<f32> = i32_labels_to_f32(agg_clust.labels, n_iris_full)
    t2 = clock()
    let agg_ari: f32 = adjusted_rand_index(y_true_iris, agg_labels_f32, n_iris_full)
    printf("RESULT|AgglomerativeClustering|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", agg_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(agg_labels_f32)
    agglomerative_clustering_free(agg_clust)

    # DBSCAN
    t0 = clock()
    let dbscan_clust: DBSCAN = dbscan_fit(ds_iris.X, 0.5, 5)
    t1 = clock()
    let dbscan_labels_f32: ptr<f32> = i32_labels_to_f32(dbscan_clust.labels, n_iris_full)
    t2 = clock()
    let dbscan_ari: f32 = adjusted_rand_index(y_true_iris, dbscan_labels_f32, n_iris_full)
    printf("RESULT|DBSCAN|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", dbscan_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dbscan_labels_f32)
    dbscan_free(dbscan_clust)

    # SpectralClustering
    t0 = clock()
    let spectral_clust: SpectralClustering = spectral_clustering_fit(ds_iris.X, 3, 1.0, 42)
    t1 = clock()
    let spectral_labels_f32: ptr<f32> = i32_labels_to_f32(spectral_clust.labels, n_iris_full)
    t2 = clock()
    let spectral_ari: f32 = adjusted_rand_index(y_true_iris, spectral_labels_f32, n_iris_full)
    printf("RESULT|SpectralClustering|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", spectral_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(spectral_labels_f32)
    spectral_clustering_free(spectral_clust)

    # MeanShift
    t0 = clock()
    let ms_clust: MeanShift = mean_shift_fit(ds_iris.X, 1.0, 100)
    t1 = clock()
    let ms_labels_f32: ptr<f32> = i32_labels_to_f32(ms_clust.labels, n_iris_full)
    t2 = clock()
    let ms_ari: f32 = adjusted_rand_index(y_true_iris, ms_labels_f32, n_iris_full)
    printf("RESULT|MeanShift|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", ms_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(ms_labels_f32)
    mean_shift_free(ms_clust)

    # Birch
    t0 = clock()
    let birch_clust: Birch = birch_fit(ds_iris.X, 0.5, 50)
    t1 = clock()
    let birch_labels_f32: ptr<f32> = i32_labels_to_f32(birch_clust.labels, n_iris_full)
    t2 = clock()
    let birch_ari: f32 = adjusted_rand_index(y_true_iris, birch_labels_f32, n_iris_full)
    printf("RESULT|Birch|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", birch_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(birch_labels_f32)
    birch_free(birch_clust)

    # AffinityPropagation
    t0 = clock()
    let ap_clust: AffinityPropagation = affinity_propagation_fit(ds_iris.X, 0.5, 200, 15)
    t1 = clock()
    let ap_labels_f32: ptr<f32> = i32_labels_to_f32(ap_clust.labels, n_iris_full)
    t2 = clock()
    let ap_ari: f32 = adjusted_rand_index(y_true_iris, ap_labels_f32, n_iris_full)
    printf("RESULT|AffinityPropagation|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", ap_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(ap_labels_f32)
    affinity_propagation_free(ap_clust)

    # OPTICS
    t0 = clock()
    let optics_clust: OPTICS = optics_fit(ds_iris.X, 0.5, 5)
    t1 = clock()
    let optics_labels_f32: ptr<f32> = i32_labels_to_f32(optics_clust.labels, n_iris_full)
    t2 = clock()
    let optics_ari: f32 = adjusted_rand_index(y_true_iris, optics_labels_f32, n_iris_full)
    printf("RESULT|OPTICS|iris|adjusted_rand_score|%.6f|%.6f|%.6f\n", optics_ari, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(optics_labels_f32)
    optics_free(optics_clust)

    # Final cleanup
    dataset_free(ds_iris)
    dataset_free(ds_dig)

    printf("\n# Benchmark complete.\n")
    return 0
}
