# Comprehensive flow-scikit benchmark.
# Mirrors benchmarks/bench_comprehensive.py.
# Covers classification, regression, dimensionality reduction, and clustering.
#
# Output format: RESULT|{algorithm}|{dataset}|{metric}|{score:.6f}|{fit_time:.6f}|{pred_time:.6f}

import "lib/scikit/scikit.flow"

extern {
    function clock() -> i64
    function printf(fmt: string, ...) -> i32
    function exit(code: i32) -> void
    function fopen(path: string, mode: string) -> ptr<void>
    function fclose(fp: ptr<void>) -> i32
    function fread(ptr: ptr<void>, size: i64, count: i64, fp: ptr<void>) -> i64
}

const CLOCKS_PER_SEC: i64 = 1000000

function elapsed_ms(start: i64, end: i64) -> f32 {
    return ((end - start) as f32) / ((CLOCKS_PER_SEC) as f32) * 1000.0
}

# Split data using precomputed sklearn indices for exact parity.
# Reads from benchmarks/split_<name>.bin (generated by Python).
function split_data_exact(X: Matrix, y: ptr<f32>, path: string) -> SplitResult {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == 0 as ptr<void> {
        printf("ERROR: cannot open %s\n", path)
        exit(1)
    }

    let dims: ptr<i32> = malloc(8) as ptr<i32>
    let r1: i64 = fread(dims as ptr<void>, 4, 2, fp)
    let n_train: i32 = dims[0]
    let n_test: i32 = dims[1]

    let train_idx: ptr<i32> = malloc((n_train as i64) * 4) as ptr<i32>
    let test_idx: ptr<i32> = malloc((n_test as i64) * 4) as ptr<i32>
    let r2: i64 = fread(train_idx as ptr<void>, 4, n_train as i64, fp)
    let r3: i64 = fread(test_idx as ptr<void>, 4, n_test as i64, fp)
    fclose(fp)
    free(dims as ptr<void>)

    let X_train: Matrix = matrix_new(n_train, X.cols)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let X_test: Matrix = matrix_new(n_test, X.cols)
    let y_test: ptr<f32> = array_new_f32(n_test)

    for i in 0 to n_train {
        for j in 0 to X.cols {
            matrix_set(X_train, i, j, matrix_at(X, train_idx[i], j))
        }
        y_train[i] = y[train_idx[i]]
    }
    for i in 0 to n_test {
        for j in 0 to X.cols {
            matrix_set(X_test, i, j, matrix_at(X, test_idx[i], j))
        }
        y_test[i] = y[test_idx[i]]
    }

    free(train_idx as ptr<void>)
    free(test_idx as ptr<void>)

    return SplitResult {
        X_train: X_train,
        y_train: y_train,
        X_test: X_test,
        y_test: y_test,
        n_train: n_train,
        n_test: n_test
    }
}

struct SplitResult {
    X_train: Matrix,
    y_train: ptr<f32>,
    X_test: Matrix,
    y_test: ptr<f32>,
    n_train: i32,
    n_test: i32
}

# Load dataset from binary file (generated by Python for exact sklearn parity).
# Format: [n: i32][p: i32][X: n*p f32][y: n f32]
function load_dataset_file(path: string) -> Dataset {
    let fp: ptr<void> = fopen(path, "rb")
    if fp == 0 as ptr<void> {
        printf("ERROR: cannot open %s\n", path)
        exit(1)
    }
    let dims: ptr<i32> = malloc(8) as ptr<i32>
    let r0: i64 = fread(dims as ptr<void>, 4, 2, fp)
    let n: i32 = dims[0]
    let p: i32 = dims[1]
    free(dims as ptr<void>)

    let X: Matrix = matrix_new(n, p)
    let y: ptr<f32> = array_new_f32(n)

    let x_data: ptr<f32> = malloc((n as i64) * (p as i64) * 4) as ptr<f32>
    let r1: i64 = fread(x_data as ptr<void>, 4, (n as i64) * (p as i64), fp)
    let r2: i64 = fread(y as ptr<void>, 4, n as i64, fp)
    fclose(fp)

    for i in 0 to n {
        for j in 0 to p {
            matrix_set(X, i, j, x_data[i * p + j])
        }
    }
    free(x_data as ptr<void>)

    return Dataset { X: X, y: y, n_samples: n, n_features: p, n_classes: 0, is_classification: false }
}

function free_split(s: SplitResult) -> void {
    matrix_free(s.X_train)
    array_free_f32(s.y_train)
    matrix_free(s.X_test)
    array_free_f32(s.y_test)
}

# Convert ptr<i32> labels to ptr<f32> for adjusted_rand_index.
function i32_labels_to_f32(labels: ptr<i32>, n: i32) -> ptr<f32> {
    let result: ptr<f32> = array_new_f32(n)
    for i in 0 to n {
        result[i] = labels[i] as f32
    }
    return result
}

# Compute kurtosis of an array: mean((x-mean)^4) / (var^2) - 3.0
function kurtosis_first_component(X: Matrix) -> f32 {
    let n: i32 = X.rows
    let mut mean: f32 = 0.0
    for i in 0 to n {
        mean = mean + matrix_at(X, i, 0)
    }
    mean = mean / (n as f32)

    let mut m2: f32 = 0.0
    let mut m4: f32 = 0.0
    for i in 0 to n {
        let d: f32 = matrix_at(X, i, 0) - mean
        let d2: f32 = d * d
        m2 = m2 + d2
        m4 = m4 + d2 * d2
    }
    m2 = m2 / (n as f32)
    m4 = m4 / (n as f32)

    if m2 < 0.0000000001 {
        return 0.0
    }
    return m4 / (m2 * m2) - 3.0
}

function main() -> i32 {
    printf("# Comprehensive flow-scikit benchmark\n")
    printf("# Format: RESULT|algorithm|dataset|metric|score|fit_time|pred_time\n\n")

    let no_penalty: Penalty = penalty_none()
    let l2_penalty: Penalty = penalty_l2(0.001)

    let mut t0: i64 = 0
    let mut t1: i64 = 0
    let mut t2: i64 = 0

    # ================================================================
    # CLASSIFICATION (iris)
    # ================================================================
    printf("# === CLASSIFICATION (iris) ===\n")
    let ds_iris: Dataset = load_dataset_file("benchmarks/dataset_iris.bin")
    let split_iris: SplitResult = split_data_exact(ds_iris.X, ds_iris.y, "benchmarks/split_iris.bin")

    let scaler_iris: StandardScaler = standard_scaler_fit(split_iris.X_train)
    let X_train_iris: Matrix = standard_scaler_transform(scaler_iris, split_iris.X_train)
    let X_test_iris: Matrix = standard_scaler_transform(scaler_iris, split_iris.X_test)

    # Also keep a raw (non-scaled) split for MultinomialNB
    let split_iris_raw: SplitResult = split_data_exact(ds_iris.X, ds_iris.y, "benchmarks/split_iris.bin")

    let n_classes_iris: i32 = 3

    # --- LogisticRegression ---
    t0 = clock()
    let lr_iris: LogisticRegression = logistic_regression_fit(X_train_iris, split_iris.y_train, n_classes_iris, 200, 0.1, l2_penalty)
    t1 = clock()
    let lr_iris_probs: ptr<f32> = logistic_predict(lr_iris, X_test_iris)
    let lr_iris_preds: ptr<f32> = logistic_decide(lr_iris, lr_iris_probs, split_iris.n_test, 0.5)
    t2 = clock()
    let lr_iris_acc: f32 = accuracy_score(split_iris.y_test, lr_iris_preds, split_iris.n_test)
    printf("RESULT|LogisticRegression|iris|accuracy|%.6f|%.6f|%.6f\n", lr_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(lr_iris_probs)
    array_free_f32(lr_iris_preds)
    logistic_regression_free(lr_iris)

    # --- LinearSVC ---
    t0 = clock()
    let lsvc_iris: LinearSVCMulti = linear_svc_multi_fit(X_train_iris, split_iris.y_train, n_classes_iris, 1.0, 5000)
    t1 = clock()
    let lsvc_iris_preds: ptr<f32> = linear_svc_multi_predict(lsvc_iris, X_test_iris)
    t2 = clock()
    let lsvc_iris_acc: f32 = accuracy_score(split_iris.y_test, lsvc_iris_preds, split_iris.n_test)
    printf("RESULT|LinearSVC|iris|accuracy|%.6f|%.6f|%.6f\n", lsvc_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(lsvc_iris_preds)
    linear_svc_multi_free(lsvc_iris)

    # --- SVC_RBF (KernelSVC) ---
    t0 = clock()
    let ksvc_iris: KernelSVCMulti = kernel_svc_multi_fit(X_train_iris, split_iris.y_train, n_classes_iris, 0.5, 1.0, 1000)
    t1 = clock()
    let ksvc_iris_preds: ptr<f32> = kernel_svc_multi_predict(ksvc_iris, X_test_iris)
    t2 = clock()
    let ksvc_iris_acc: f32 = accuracy_score(split_iris.y_test, ksvc_iris_preds, split_iris.n_test)
    printf("RESULT|SVC_RBF|iris|accuracy|%.6f|%.6f|%.6f\n", ksvc_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(ksvc_iris_preds)
    kernel_svc_multi_free(ksvc_iris)

    # --- RidgeClassifier ---
    t0 = clock()
    let rc_iris: RidgeClassifier = ridge_classifier_fit(X_train_iris, split_iris.y_train, 1.0, 1000, 0.01)
    t1 = clock()
    let rc_iris_preds: ptr<f32> = ridge_classifier_predict(rc_iris, X_test_iris)
    t2 = clock()
    let rc_iris_acc: f32 = accuracy_score(split_iris.y_test, rc_iris_preds, split_iris.n_test)
    printf("RESULT|RidgeClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", rc_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(rc_iris_preds)
    ridge_classifier_free(rc_iris)

    # --- SGDClassifier ---
    t0 = clock()
    let sgd_iris: SGDClassifier = sgd_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, SGD_LOSS_HINGE, 0.0001, 1000, 0.01)
    t1 = clock()
    let sgd_iris_preds: ptr<f32> = sgd_classifier_predict(sgd_iris, X_test_iris)
    t2 = clock()
    let sgd_iris_acc: f32 = accuracy_score(split_iris.y_test, sgd_iris_preds, split_iris.n_test)
    printf("RESULT|SGDClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", sgd_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(sgd_iris_preds)
    sgd_classifier_free(sgd_iris)

    # --- PassiveAggressiveClassifier ---
    t0 = clock()
    let pac_iris: PassiveAggressiveClassifier = passive_aggressive_classifier_fit(X_train_iris, split_iris.y_train, 1000, 1.0)
    t1 = clock()
    let pac_iris_preds: ptr<f32> = passive_aggressive_classifier_predict(pac_iris, X_test_iris)
    t2 = clock()
    let pac_iris_acc: f32 = accuracy_score(split_iris.y_test, pac_iris_preds, split_iris.n_test)
    printf("RESULT|PassiveAggressiveClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", pac_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(pac_iris_preds)
    passive_aggressive_classifier_free(pac_iris)

    # --- Perceptron ---
    t0 = clock()
    let perc_iris: Perceptron = perceptron_fit(X_train_iris, split_iris.y_train, 1000, 0.01, 42)
    t1 = clock()
    let perc_iris_preds: ptr<f32> = perceptron_predict(perc_iris, X_test_iris)
    t2 = clock()
    let perc_iris_acc: f32 = accuracy_score(split_iris.y_test, perc_iris_preds, split_iris.n_test)
    printf("RESULT|Perceptron|iris|accuracy|%.6f|%.6f|%.6f\n", perc_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(perc_iris_preds)
    perceptron_free(perc_iris)

    # --- DecisionTreeClassifier ---
    t0 = clock()
    let dt_iris: DecisionTreeClassifier = decision_tree_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 5, 42)
    t1 = clock()
    let dt_iris_preds: ptr<f32> = decision_tree_classifier_predict(dt_iris, X_test_iris)
    t2 = clock()
    let dt_iris_acc: f32 = accuracy_score(split_iris.y_test, dt_iris_preds, split_iris.n_test)
    printf("RESULT|DecisionTreeClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", dt_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dt_iris_preds)
    decision_tree_classifier_free(dt_iris)

    # --- RandomForestClassifier ---
    t0 = clock()
    let rf_iris: RandomForestClassifier = random_forest_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 10, 5, 42)
    t1 = clock()
    let rf_iris_preds: ptr<f32> = random_forest_classifier_predict(rf_iris, X_test_iris)
    t2 = clock()
    let rf_iris_acc: f32 = accuracy_score(split_iris.y_test, rf_iris_preds, split_iris.n_test)
    printf("RESULT|RandomForestClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", rf_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(rf_iris_preds)
    random_forest_classifier_free(rf_iris)

    # --- GradientBoostingClassifier ---
    t0 = clock()
    let gb_iris: GradientBoostingClassifier = gradient_boosting_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 10, 0.1, 3, 42)
    t1 = clock()
    let gb_iris_preds: ptr<f32> = gradient_boosting_classifier_predict(gb_iris, X_test_iris)
    t2 = clock()
    let gb_iris_acc: f32 = accuracy_score(split_iris.y_test, gb_iris_preds, split_iris.n_test)
    printf("RESULT|GradientBoostingClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", gb_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(gb_iris_preds)
    gradient_boosting_classifier_free(gb_iris)

    # --- AdaBoostClassifier ---
    t0 = clock()
    let ab_iris: AdaBoostClassifier = adaboost_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 10, 3, 42)
    t1 = clock()
    let ab_iris_preds: ptr<f32> = adaboost_classifier_predict(ab_iris, X_test_iris)
    t2 = clock()
    let ab_iris_acc: f32 = accuracy_score(split_iris.y_test, ab_iris_preds, split_iris.n_test)
    printf("RESULT|AdaBoostClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", ab_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(ab_iris_preds)
    adaboost_classifier_free(ab_iris)

    # --- ExtraTreesClassifier ---
    t0 = clock()
    let et_iris: ExtraTreesClassifier = extra_trees_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 10, 5, 42)
    t1 = clock()
    let et_iris_preds: ptr<f32> = extra_trees_classifier_predict(et_iris, X_test_iris)
    t2 = clock()
    let et_iris_acc: f32 = accuracy_score(split_iris.y_test, et_iris_preds, split_iris.n_test)
    printf("RESULT|ExtraTreesClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", et_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(et_iris_preds)
    extra_trees_classifier_free(et_iris)

    # --- BaggingClassifier ---
    t0 = clock()
    let bg_iris: BaggingClassifier = bagging_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 10, 5, 42)
    t1 = clock()
    let bg_iris_preds: ptr<f32> = bagging_classifier_predict(bg_iris, X_test_iris)
    t2 = clock()
    let bg_iris_acc: f32 = accuracy_score(split_iris.y_test, bg_iris_preds, split_iris.n_test)
    printf("RESULT|BaggingClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", bg_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(bg_iris_preds)
    bagging_classifier_free(bg_iris)

    # --- GaussianNB ---
    t0 = clock()
    let gnb_iris: GaussianNB = gaussian_nb_fit(X_train_iris, split_iris.y_train, n_classes_iris, 0.0000000001)
    t1 = clock()
    let gnb_iris_preds: ptr<f32> = gaussian_nb_predict(gnb_iris, X_test_iris)
    t2 = clock()
    let gnb_iris_acc: f32 = accuracy_score(split_iris.y_test, gnb_iris_preds, split_iris.n_test)
    printf("RESULT|GaussianNB|iris|accuracy|%.6f|%.6f|%.6f\n", gnb_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(gnb_iris_preds)
    gaussian_nb_free(gnb_iris)

    # --- BernoulliNB ---
    t0 = clock()
    let bnb_iris: BernoulliNB = bernoulli_nb_fit(X_train_iris, split_iris.y_train, n_classes_iris, 1.0)
    t1 = clock()
    let bnb_iris_preds: ptr<f32> = bernoulli_nb_predict(bnb_iris, X_test_iris)
    t2 = clock()
    let bnb_iris_acc: f32 = accuracy_score(split_iris.y_test, bnb_iris_preds, split_iris.n_test)
    printf("RESULT|BernoulliNB|iris|accuracy|%.6f|%.6f|%.6f\n", bnb_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(bnb_iris_preds)
    bernoulli_nb_free(bnb_iris)

    # --- MultinomialNB (raw, non-scaled data) ---
    t0 = clock()
    let mnb_iris: MultinomialNB = multinomial_nb_fit(split_iris_raw.X_train, split_iris_raw.y_train, n_classes_iris, 1.0)
    t1 = clock()
    let mnb_iris_preds: ptr<f32> = multinomial_nb_predict(mnb_iris, split_iris_raw.X_test)
    t2 = clock()
    let mnb_iris_acc: f32 = accuracy_score(split_iris_raw.y_test, mnb_iris_preds, split_iris_raw.n_test)
    printf("RESULT|MultinomialNB|iris|accuracy|%.6f|%.6f|%.6f\n", mnb_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(mnb_iris_preds)
    multinomial_nb_free(mnb_iris)

    # --- KNeighborsClassifier ---
    t0 = clock()
    let knn_iris: KNNClassifier = knn_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, 5)
    t1 = clock()
    let knn_iris_probs: Matrix = knn_classifier_predict(knn_iris, X_test_iris)
    let knn_iris_preds: ptr<f32> = knn_classifier_decide(knn_iris, knn_iris_probs, 0.5)
    t2 = clock()
    let knn_iris_acc: f32 = accuracy_score(split_iris.y_test, knn_iris_preds, split_iris.n_test)
    printf("RESULT|KNeighborsClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", knn_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(knn_iris_preds)
    matrix_free(knn_iris_probs)
    knn_classifier_free(knn_iris)

    # --- LinearDiscriminantAnalysis ---
    t0 = clock()
    let lda_iris: LinearDiscriminantAnalysis = discriminant_lda_fit(X_train_iris, split_iris.y_train, n_classes_iris)
    t1 = clock()
    let lda_iris_preds: ptr<f32> = discriminant_lda_predict(lda_iris, X_test_iris)
    t2 = clock()
    let lda_iris_acc: f32 = accuracy_score(split_iris.y_test, lda_iris_preds, split_iris.n_test)
    printf("RESULT|LinearDiscriminantAnalysis|iris|accuracy|%.6f|%.6f|%.6f\n", lda_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(lda_iris_preds)
    discriminant_lda_free(lda_iris)

    # --- QuadraticDiscriminantAnalysis ---
    t0 = clock()
    let qda_iris: QuadraticDiscriminantAnalysis = qda_fit(X_train_iris, split_iris.y_train, n_classes_iris)
    t1 = clock()
    let qda_iris_preds: ptr<f32> = qda_predict(qda_iris, X_test_iris)
    t2 = clock()
    let qda_iris_acc: f32 = accuracy_score(split_iris.y_test, qda_iris_preds, split_iris.n_test)
    printf("RESULT|QuadraticDiscriminantAnalysis|iris|accuracy|%.6f|%.6f|%.6f\n", qda_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(qda_iris_preds)
    qda_free(qda_iris)

    # --- MLPClassifier ---
    let mlp_hidden_iris: ptr<i32> = malloc(4) as ptr<i32>
    mlp_hidden_iris[0] = 100
    t0 = clock()
    let mlp_iris: MLPClassifier = mlp_classifier_fit(X_train_iris, split_iris.y_train, n_classes_iris, mlp_hidden_iris, 1, MLP_ACT_RELU, 500, 0.01, 0.9, 42)
    t1 = clock()
    let mlp_iris_probs: Matrix = mlp_classifier_predict(mlp_iris, X_test_iris)
    let mlp_iris_preds: ptr<f32> = mlp_classifier_decide(mlp_iris, mlp_iris_probs)
    t2 = clock()
    let mlp_iris_acc: f32 = accuracy_score(split_iris.y_test, mlp_iris_preds, split_iris.n_test)
    printf("RESULT|MLPClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", mlp_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(mlp_iris_preds)
    matrix_free(mlp_iris_probs)
    mlp_classifier_free(mlp_iris)
    free(mlp_hidden_iris as ptr<void>)

    # --- DummyClassifier (most_frequent) ---
    t0 = clock()
    let dc_iris: DummyClassifier = dummy_classifier_fit(split_iris.y_train, split_iris.n_train, n_classes_iris, DUMMY_STRATEGY_MOST_FREQUENT, 0.0, 42)
    t1 = clock()
    let dc_iris_preds: ptr<f32> = dummy_classifier_predict(dc_iris, split_iris.n_test)
    t2 = clock()
    let dc_iris_acc: f32 = accuracy_score(split_iris.y_test, dc_iris_preds, split_iris.n_test)
    printf("RESULT|DummyClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", dc_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dc_iris_preds)
    dummy_classifier_free(dc_iris)

    # --- KMeansClassifier (majority label per cluster) ---
    t0 = clock()
    let kmc_iris: KMeans = kmeans_fit(X_train_iris, n_classes_iris, 100, 0.001, 42)
    t1 = clock()
    let kmc_iris_clusters: ptr<i32> = kmeans_predict(kmc_iris, X_test_iris)
    t2 = clock()
    # Map clusters to majority label using test set (greedy)
    let kmc_cluster_labels: ptr<i32> = malloc((n_classes_iris as i64) * 4) as ptr<i32>
    for c in 0 to n_classes_iris {
        let counts: ptr<i32> = malloc((n_classes_iris as i64) * 4) as ptr<i32>
        for k in 0 to n_classes_iris { counts[k] = 0 }
        for i in 0 to split_iris.n_test {
            if kmc_iris_clusters[i] == c {
                let label: i32 = split_iris.y_test[i] as i32
                if label >= 0 && label < n_classes_iris { counts[label] = counts[label] + 1 }
            }
        }
        let mut best_label: i32 = 0
        let mut best_count: i32 = 0
        for k in 0 to n_classes_iris {
            if counts[k] > best_count { best_count = counts[k]; best_label = k }
        }
        kmc_cluster_labels[c] = best_label
        free(counts as ptr<void>)
    }
    let mut kmc_correct: i32 = 0
    for i in 0 to split_iris.n_test {
        if kmc_cluster_labels[kmc_iris_clusters[i]] == (split_iris.y_test[i] as i32) {
            kmc_correct = kmc_correct + 1
        }
    }
    let kmc_iris_acc: f32 = (kmc_correct as f32) / (split_iris.n_test as f32)
    printf("RESULT|KMeansClassifier|iris|accuracy|%.6f|%.6f|%.6f\n", kmc_iris_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    free(kmc_cluster_labels as ptr<void>)
    free(kmc_iris_clusters as ptr<void>)
    kmeans_free(kmc_iris)

    # Cleanup iris classification
    standard_scaler_free(scaler_iris)
    matrix_free(X_train_iris)
    matrix_free(X_test_iris)
    free_split(split_iris)
    free_split(split_iris_raw)

    # ================================================================
    # CLASSIFICATION (digits)
    # ================================================================
    printf("\n# === CLASSIFICATION (digits) ===\n")
    let ds_dig: Dataset = load_dataset_file("benchmarks/dataset_digits.bin")
    let split_dig: SplitResult = split_data_exact(ds_dig.X, ds_dig.y, "benchmarks/split_digits.bin")

    let scaler_dig: StandardScaler = standard_scaler_fit(split_dig.X_train)
    let X_train_dig: Matrix = standard_scaler_transform(scaler_dig, split_dig.X_train)
    let X_test_dig: Matrix = standard_scaler_transform(scaler_dig, split_dig.X_test)

    let split_dig_raw: SplitResult = split_data_exact(ds_dig.X, ds_dig.y, "benchmarks/split_digits.bin")

    let n_classes_dig: i32 = 10

    # --- LogisticRegression ---
    t0 = clock()
    let lr_dig: LogisticRegression = logistic_regression_fit(X_train_dig, split_dig.y_train, n_classes_dig, 200, 0.1, l2_penalty)
    t1 = clock()
    let lr_dig_probs: ptr<f32> = logistic_predict(lr_dig, X_test_dig)
    let lr_dig_preds: ptr<f32> = logistic_decide(lr_dig, lr_dig_probs, split_dig.n_test, 0.5)
    t2 = clock()
    let lr_dig_acc: f32 = accuracy_score(split_dig.y_test, lr_dig_preds, split_dig.n_test)
    printf("RESULT|LogisticRegression|digits|accuracy|%.6f|%.6f|%.6f\n", lr_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(lr_dig_probs)
    array_free_f32(lr_dig_preds)
    logistic_regression_free(lr_dig)

    # --- LinearSVC ---
    t0 = clock()
    let lsvc_dig: LinearSVCMulti = linear_svc_multi_fit(X_train_dig, split_dig.y_train, n_classes_dig, 1.0, 5000)
    t1 = clock()
    let lsvc_dig_preds: ptr<f32> = linear_svc_multi_predict(lsvc_dig, X_test_dig)
    t2 = clock()
    let lsvc_dig_acc: f32 = accuracy_score(split_dig.y_test, lsvc_dig_preds, split_dig.n_test)
    printf("RESULT|LinearSVC|digits|accuracy|%.6f|%.6f|%.6f\n", lsvc_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(lsvc_dig_preds)
    linear_svc_multi_free(lsvc_dig)

    # --- SVC_RBF ---
    t0 = clock()
    let ksvc_dig: KernelSVCMulti = kernel_svc_multi_fit(X_train_dig, split_dig.y_train, n_classes_dig, 0.001, 1.0, 1000)
    t1 = clock()
    let ksvc_dig_preds: ptr<f32> = kernel_svc_multi_predict(ksvc_dig, X_test_dig)
    t2 = clock()
    let ksvc_dig_acc: f32 = accuracy_score(split_dig.y_test, ksvc_dig_preds, split_dig.n_test)
    printf("RESULT|SVC_RBF|digits|accuracy|%.6f|%.6f|%.6f\n", ksvc_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(ksvc_dig_preds)
    kernel_svc_multi_free(ksvc_dig)

    # --- RidgeClassifier ---
    t0 = clock()
    let rc_dig: RidgeClassifier = ridge_classifier_fit(X_train_dig, split_dig.y_train, 1.0, 1000, 0.01)
    t1 = clock()
    let rc_dig_preds: ptr<f32> = ridge_classifier_predict(rc_dig, X_test_dig)
    t2 = clock()
    let rc_dig_acc: f32 = accuracy_score(split_dig.y_test, rc_dig_preds, split_dig.n_test)
    printf("RESULT|RidgeClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", rc_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(rc_dig_preds)
    ridge_classifier_free(rc_dig)

    # --- SGDClassifier ---
    t0 = clock()
    let sgd_dig: SGDClassifier = sgd_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, SGD_LOSS_HINGE, 0.0001, 1000, 0.01)
    t1 = clock()
    let sgd_dig_preds: ptr<f32> = sgd_classifier_predict(sgd_dig, X_test_dig)
    t2 = clock()
    let sgd_dig_acc: f32 = accuracy_score(split_dig.y_test, sgd_dig_preds, split_dig.n_test)
    printf("RESULT|SGDClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", sgd_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(sgd_dig_preds)
    sgd_classifier_free(sgd_dig)

    # --- PassiveAggressiveClassifier ---
    t0 = clock()
    let pac_dig: PassiveAggressiveClassifier = passive_aggressive_classifier_fit(X_train_dig, split_dig.y_train, 1000, 1.0)
    t1 = clock()
    let pac_dig_preds: ptr<f32> = passive_aggressive_classifier_predict(pac_dig, X_test_dig)
    t2 = clock()
    let pac_dig_acc: f32 = accuracy_score(split_dig.y_test, pac_dig_preds, split_dig.n_test)
    printf("RESULT|PassiveAggressiveClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", pac_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(pac_dig_preds)
    passive_aggressive_classifier_free(pac_dig)

    # --- Perceptron ---
    t0 = clock()
    let perc_dig: Perceptron = perceptron_fit(X_train_dig, split_dig.y_train, 1000, 0.01, 42)
    t1 = clock()
    let perc_dig_preds: ptr<f32> = perceptron_predict(perc_dig, X_test_dig)
    t2 = clock()
    let perc_dig_acc: f32 = accuracy_score(split_dig.y_test, perc_dig_preds, split_dig.n_test)
    printf("RESULT|Perceptron|digits|accuracy|%.6f|%.6f|%.6f\n", perc_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(perc_dig_preds)
    perceptron_free(perc_dig)

    # --- DecisionTreeClassifier ---
    t0 = clock()
    let dt_dig: DecisionTreeClassifier = decision_tree_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 10, 42)
    t1 = clock()
    let dt_dig_preds: ptr<f32> = decision_tree_classifier_predict(dt_dig, X_test_dig)
    t2 = clock()
    let dt_dig_acc: f32 = accuracy_score(split_dig.y_test, dt_dig_preds, split_dig.n_test)
    printf("RESULT|DecisionTreeClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", dt_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dt_dig_preds)
    decision_tree_classifier_free(dt_dig)

    # --- RandomForestClassifier ---
    t0 = clock()
    let rf_dig: RandomForestClassifier = random_forest_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 10, 10, 42)
    t1 = clock()
    let rf_dig_preds: ptr<f32> = random_forest_classifier_predict(rf_dig, X_test_dig)
    t2 = clock()
    let rf_dig_acc: f32 = accuracy_score(split_dig.y_test, rf_dig_preds, split_dig.n_test)
    printf("RESULT|RandomForestClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", rf_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(rf_dig_preds)
    random_forest_classifier_free(rf_dig)

    # --- GradientBoostingClassifier ---
    t0 = clock()
    let gb_dig: GradientBoostingClassifier = gradient_boosting_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 10, 0.1, 3, 42)
    t1 = clock()
    let gb_dig_preds: ptr<f32> = gradient_boosting_classifier_predict(gb_dig, X_test_dig)
    t2 = clock()
    let gb_dig_acc: f32 = accuracy_score(split_dig.y_test, gb_dig_preds, split_dig.n_test)
    printf("RESULT|GradientBoostingClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", gb_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(gb_dig_preds)
    gradient_boosting_classifier_free(gb_dig)

    # --- AdaBoostClassifier ---
    t0 = clock()
    let ab_dig: AdaBoostClassifier = adaboost_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 10, 3, 42)
    t1 = clock()
    let ab_dig_preds: ptr<f32> = adaboost_classifier_predict(ab_dig, X_test_dig)
    t2 = clock()
    let ab_dig_acc: f32 = accuracy_score(split_dig.y_test, ab_dig_preds, split_dig.n_test)
    printf("RESULT|AdaBoostClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", ab_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(ab_dig_preds)
    adaboost_classifier_free(ab_dig)

    # --- ExtraTreesClassifier ---
    t0 = clock()
    let et_dig: ExtraTreesClassifier = extra_trees_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 10, 10, 42)
    t1 = clock()
    let et_dig_preds: ptr<f32> = extra_trees_classifier_predict(et_dig, X_test_dig)
    t2 = clock()
    let et_dig_acc: f32 = accuracy_score(split_dig.y_test, et_dig_preds, split_dig.n_test)
    printf("RESULT|ExtraTreesClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", et_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(et_dig_preds)
    extra_trees_classifier_free(et_dig)

    # --- BaggingClassifier ---
    t0 = clock()
    let bg_dig: BaggingClassifier = bagging_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 10, 10, 42)
    t1 = clock()
    let bg_dig_preds: ptr<f32> = bagging_classifier_predict(bg_dig, X_test_dig)
    t2 = clock()
    let bg_dig_acc: f32 = accuracy_score(split_dig.y_test, bg_dig_preds, split_dig.n_test)
    printf("RESULT|BaggingClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", bg_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(bg_dig_preds)
    bagging_classifier_free(bg_dig)

    # --- GaussianNB ---
    t0 = clock()
    let gnb_dig: GaussianNB = gaussian_nb_fit(X_train_dig, split_dig.y_train, n_classes_dig, 0.0000000001)
    t1 = clock()
    let gnb_dig_preds: ptr<f32> = gaussian_nb_predict(gnb_dig, X_test_dig)
    t2 = clock()
    let gnb_dig_acc: f32 = accuracy_score(split_dig.y_test, gnb_dig_preds, split_dig.n_test)
    printf("RESULT|GaussianNB|digits|accuracy|%.6f|%.6f|%.6f\n", gnb_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(gnb_dig_preds)
    gaussian_nb_free(gnb_dig)

    # --- BernoulliNB ---
    t0 = clock()
    let bnb_dig: BernoulliNB = bernoulli_nb_fit(X_train_dig, split_dig.y_train, n_classes_dig, 1.0)
    t1 = clock()
    let bnb_dig_preds: ptr<f32> = bernoulli_nb_predict(bnb_dig, X_test_dig)
    t2 = clock()
    let bnb_dig_acc: f32 = accuracy_score(split_dig.y_test, bnb_dig_preds, split_dig.n_test)
    printf("RESULT|BernoulliNB|digits|accuracy|%.6f|%.6f|%.6f\n", bnb_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(bnb_dig_preds)
    bernoulli_nb_free(bnb_dig)

    # --- MultinomialNB (raw, non-scaled data) ---
    t0 = clock()
    let mnb_dig: MultinomialNB = multinomial_nb_fit(split_dig_raw.X_train, split_dig_raw.y_train, n_classes_dig, 1.0)
    t1 = clock()
    let mnb_dig_preds: ptr<f32> = multinomial_nb_predict(mnb_dig, split_dig_raw.X_test)
    t2 = clock()
    let mnb_dig_acc: f32 = accuracy_score(split_dig_raw.y_test, mnb_dig_preds, split_dig_raw.n_test)
    printf("RESULT|MultinomialNB|digits|accuracy|%.6f|%.6f|%.6f\n", mnb_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(mnb_dig_preds)
    multinomial_nb_free(mnb_dig)

    # --- KNeighborsClassifier ---
    t0 = clock()
    let knn_dig: KNNClassifier = knn_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, 5)
    t1 = clock()
    let knn_dig_probs: Matrix = knn_classifier_predict(knn_dig, X_test_dig)
    let knn_dig_preds: ptr<f32> = knn_classifier_decide(knn_dig, knn_dig_probs, 0.5)
    t2 = clock()
    let knn_dig_acc: f32 = accuracy_score(split_dig.y_test, knn_dig_preds, split_dig.n_test)
    printf("RESULT|KNeighborsClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", knn_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(knn_dig_preds)
    matrix_free(knn_dig_probs)
    knn_classifier_free(knn_dig)

    # --- LinearDiscriminantAnalysis ---
    t0 = clock()
    let lda_dig: LinearDiscriminantAnalysis = discriminant_lda_fit(X_train_dig, split_dig.y_train, n_classes_dig)
    t1 = clock()
    let lda_dig_preds: ptr<f32> = discriminant_lda_predict(lda_dig, X_test_dig)
    t2 = clock()
    let lda_dig_acc: f32 = accuracy_score(split_dig.y_test, lda_dig_preds, split_dig.n_test)
    printf("RESULT|LinearDiscriminantAnalysis|digits|accuracy|%.6f|%.6f|%.6f\n", lda_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(lda_dig_preds)
    discriminant_lda_free(lda_dig)

    # --- QuadraticDiscriminantAnalysis ---
    t0 = clock()
    let qda_dig: QuadraticDiscriminantAnalysis = qda_fit(X_train_dig, split_dig.y_train, n_classes_dig)
    t1 = clock()
    let qda_dig_preds: ptr<f32> = qda_predict(qda_dig, X_test_dig)
    t2 = clock()
    let qda_dig_acc: f32 = accuracy_score(split_dig.y_test, qda_dig_preds, split_dig.n_test)
    printf("RESULT|QuadraticDiscriminantAnalysis|digits|accuracy|%.6f|%.6f|%.6f\n", qda_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(qda_dig_preds)
    qda_free(qda_dig)

    # --- MLPClassifier ---
    let mlp_hidden_dig: ptr<i32> = malloc(4) as ptr<i32>
    mlp_hidden_dig[0] = 100
    t0 = clock()
    let mlp_dig: MLPClassifier = mlp_classifier_fit(X_train_dig, split_dig.y_train, n_classes_dig, mlp_hidden_dig, 1, MLP_ACT_RELU, 500, 0.01, 0.9, 42)
    t1 = clock()
    let mlp_dig_probs: Matrix = mlp_classifier_predict(mlp_dig, X_test_dig)
    let mlp_dig_preds: ptr<f32> = mlp_classifier_decide(mlp_dig, mlp_dig_probs)
    t2 = clock()
    let mlp_dig_acc: f32 = accuracy_score(split_dig.y_test, mlp_dig_preds, split_dig.n_test)
    printf("RESULT|MLPClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", mlp_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(mlp_dig_preds)
    matrix_free(mlp_dig_probs)
    mlp_classifier_free(mlp_dig)
    free(mlp_hidden_dig as ptr<void>)

    # --- DummyClassifier (most_frequent) ---
    t0 = clock()
    let dc_dig: DummyClassifier = dummy_classifier_fit(split_dig.y_train, split_dig.n_train, n_classes_dig, DUMMY_STRATEGY_MOST_FREQUENT, 0.0, 42)
    t1 = clock()
    let dc_dig_preds: ptr<f32> = dummy_classifier_predict(dc_dig, split_dig.n_test)
    t2 = clock()
    let dc_dig_acc: f32 = accuracy_score(split_dig.y_test, dc_dig_preds, split_dig.n_test)
    printf("RESULT|DummyClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", dc_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dc_dig_preds)
    dummy_classifier_free(dc_dig)

    # --- KMeansClassifier (majority label per cluster) ---
    t0 = clock()
    let kmc_dig: KMeans = kmeans_fit(X_train_dig, n_classes_dig, 100, 0.001, 42)
    t1 = clock()
    let kmc_dig_clusters: ptr<i32> = kmeans_predict(kmc_dig, X_test_dig)
    t2 = clock()
    let kmc_dig_labels: ptr<i32> = malloc((n_classes_dig as i64) * 4) as ptr<i32>
    for c in 0 to n_classes_dig {
        let counts: ptr<i32> = malloc((n_classes_dig as i64) * 4) as ptr<i32>
        for k in 0 to n_classes_dig { counts[k] = 0 }
        for i in 0 to split_dig.n_test {
            if kmc_dig_clusters[i] == c {
                let label: i32 = split_dig.y_test[i] as i32
                if label >= 0 && label < n_classes_dig { counts[label] = counts[label] + 1 }
            }
        }
        let mut best_label: i32 = 0
        let mut best_count: i32 = 0
        for k in 0 to n_classes_dig {
            if counts[k] > best_count { best_count = counts[k]; best_label = k }
        }
        kmc_dig_labels[c] = best_label
        free(counts as ptr<void>)
    }
    let mut kmc_dig_correct: i32 = 0
    for i in 0 to split_dig.n_test {
        if kmc_dig_labels[kmc_dig_clusters[i]] == (split_dig.y_test[i] as i32) {
            kmc_dig_correct = kmc_dig_correct + 1
        }
    }
    let kmc_dig_acc: f32 = (kmc_dig_correct as f32) / (split_dig.n_test as f32)
    printf("RESULT|KMeansClassifier|digits|accuracy|%.6f|%.6f|%.6f\n", kmc_dig_acc, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    free(kmc_dig_labels as ptr<void>)
    free(kmc_dig_clusters as ptr<void>)
    kmeans_free(kmc_dig)

    # Cleanup digits classification
    standard_scaler_free(scaler_dig)
    matrix_free(X_train_dig)
    matrix_free(X_test_dig)
    free_split(split_dig)
    free_split(split_dig_raw)

    # ================================================================
    # REGRESSION (diabetes)
    # ================================================================
    printf("\n# === REGRESSION (diabetes) ===\n")
    let ds_dia: Dataset = load_dataset_file("benchmarks/dataset_diabetes.bin")
    let split_dia: SplitResult = split_data_exact(ds_dia.X, ds_dia.y, "benchmarks/split_diabetes.bin")

    let scaler_dia: StandardScaler = standard_scaler_fit(split_dia.X_train)
    let X_train_dia: Matrix = standard_scaler_transform(scaler_dia, split_dia.X_train)
    let X_test_dia: Matrix = standard_scaler_transform(scaler_dia, split_dia.X_test)

    # --- LinearRegression ---
    t0 = clock()
    let linreg_dia: LinearRegression = linear_regression_fit(X_train_dia, split_dia.y_train, no_penalty)
    t1 = clock()
    let linreg_dia_preds: ptr<f32> = linear_regression_predict(linreg_dia, X_test_dia)
    t2 = clock()
    let linreg_dia_r2: f32 = r2_score(split_dia.y_test, linreg_dia_preds, split_dia.n_test)
    printf("RESULT|LinearRegression|diabetes|r2|%.6f|%.6f|%.6f\n", linreg_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(linreg_dia_preds)
    linear_regression_free(linreg_dia)

    # --- Ridge ---
    t0 = clock()
    let ridge_dia: Ridge = ridge_fit(X_train_dia, split_dia.y_train, 1.0, 1000, 0.01)
    t1 = clock()
    let ridge_dia_preds: ptr<f32> = ridge_predict(ridge_dia, X_test_dia)
    t2 = clock()
    let ridge_dia_r2: f32 = r2_score(split_dia.y_test, ridge_dia_preds, split_dia.n_test)
