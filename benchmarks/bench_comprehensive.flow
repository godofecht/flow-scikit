    t1 = clock()
    let svr_dia_preds: ptr<f32> = svr_predict(svr_dia, X_test_dia)
    t2 = clock()
    let svr_dia_r2: f32 = r2_score(split_dia.y_test, svr_dia_preds, split_dia.n_test)
    printf("RESULT|SVR|diabetes|r2|%.6f|%.6f|%.6f\n", svr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(svr_dia_preds)
    svr_free(svr_dia)

    # --- DecisionTreeRegressor ---
    t0 = clock()
    let dtr_dia: DecisionTreeRegressor = decision_tree_regressor_fit(X_train_dia, split_dia.y_train, 5, CRITERION_MSE)
    t1 = clock()
    let dtr_dia_preds: ptr<f32> = decision_tree_regressor_predict(dtr_dia, X_test_dia)
    t2 = clock()
    let dtr_dia_r2: f32 = r2_score(split_dia.y_test, dtr_dia_preds, split_dia.n_test)
    printf("RESULT|DecisionTreeRegressor|diabetes|r2|%.6f|%.6f|%.6f\n", dtr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(dtr_dia_preds)
    decision_tree_regressor_free(dtr_dia)

    # --- RandomForestRegressor ---
    t0 = clock()
    let rfr_dia: RandomForestRegressor = random_forest_regressor_fit(X_train_dia, split_dia.y_train, 10, 5, 42)
    t1 = clock()
    let rfr_dia_preds: ptr<f32> = random_forest_regressor_predict(rfr_dia, X_test_dia)
    t2 = clock()
    let rfr_dia_r2: f32 = r2_score(split_dia.y_test, rfr_dia_preds, split_dia.n_test)
    printf("RESULT|RandomForestRegressor|diabetes|r2|%.6f|%.6f|%.6f\n", rfr_dia_r2, elapsed_ms(t0, t1), elapsed_ms(t1, t2))
    array_free_f32(rfr_dia_preds)
    random_forest_regressor_free(rfr_dia)

    # --- GradientBoostingRegressor ---
    t0 = clock()
    let gbr_dia: GradientBoostingRegressor = gradient_boosting_regressor_fit(X_train_dia, split_dia.y_train, 10, 0.1, 3)
    t1 = clock()
    let gbr_dia_preds: ptr<f32> = gradient_boosting_regressor_predict(gbr_dia, X_test_dia)
    t2 = clock()
    let gbr_dia_r2: f32 = r2_score(split_dia.y_test, gbr_dia_preds, split_dia.n_test)
