# Prediction-only scaling benchmark for GaussianNB (issue #484).
#
# Times gaussian_nb_predict alone, with fit outside the timing window, along
# three axes: query batch size, feature count and class count. Every case is
# generated from integers on a dyadic grid, so bench_predict_gaussian_nb.py
# builds bit-identical float32 inputs and the two sides can be joined row for
# row.
#
#   FLOW_OPT_LEVEL=3 flow run benchmarks/bench_predict_gaussian_nb.flow > flow_predict_gnb.txt
#   python benchmarks/bench_predict_gaussian_nb.py --flow flow_predict_gnb.txt
#
# Each sample is an aggregate window of at least 10 ms, repeated 7 times after
# 2 warmups, and the reported latency is the per-call median, the same scheme
# as benchmarks/timing.py.

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
}

function pgnb_raw(i: i32, j: i32, cls: i32) -> i32 {
    return ((i * 37 + j * 19 + cls * 7) % 128) + cls * (8 + ((j * 5) % 7) * 2)
}

function pgnb_fill(X: Matrix, y: ptr<f32>, first_row: i32, n_classes: i32) -> void {
    let p: i32 = X.cols
    let mut i: i32 = 0
    while i < X.rows {
        let src: i32 = first_row + i
        let cls: i32 = src % n_classes
        y[i] = cls as f32
        let row: ptr<f32> = X.data + i * p
        let mut j: i32 = 0
        while j < p {
            row[j] = ((pgnb_raw(src, j, cls)) as f32) / 64.0
            j = j + 1
        }
        i = i + 1
    }
}

function pgnb_sort(v: ptr<f64>, n: i32) -> void {
    let mut i: i32 = 1
    while i < n {
        let key: f64 = v[i]
        let mut j: i32 = i - 1
        while j >= 0 && v[j] > key {
            v[j + 1] = v[j]
            j = j - 1
        }
        v[j + 1] = key
        i = i + 1
    }
}

function pgnb_percentile(sorted: ptr<f64>, n: i32, q: f64) -> f64 {
    let pos: f64 = ((n - 1) as f64) * q
    let lo: i32 = pos as i32
    let mut hi: i32 = lo + 1
    if hi > n - 1 { hi = n - 1 }
    let frac: f64 = pos - (lo as f64)
    return sorted[lo] * (1.0 - frac) + sorted[hi] * frac
}

function pgnb_window_ms(model: GaussianNB, Q: Matrix, repeats: i32) -> f64 {
    let t0: i64 = flow_now_ns()
    let mut k: i32 = 0
    while k < repeats {
        let pred: ptr<f32> = gaussian_nb_predict(model, Q)
        array_free_f32(pred)
        k = k + 1
    }
    let t1: i64 = flow_now_ns()
    return ((t1 - t0) as f64) / 1000000.0
}

function pgnb_case(axis: string, n_query: i32, p: i32, n_classes: i32) -> void {
    let n_train: i32 = 2000
    let samples: i32 = 7
    let X: Matrix = matrix_new(n_train, p)
    let y: ptr<f32> = array_new_f32(n_train)
    pgnb_fill(X, y, 0, n_classes)
    let Q: Matrix = matrix_new(n_query, p)
    let yq: ptr<f32> = array_new_f32(n_query)
    pgnb_fill(Q, yq, n_train, n_classes)

    let model: GaussianNB = gaussian_nb_fit(X, y, n_classes, 0.000000001)

    let warm: f64 = pgnb_window_ms(model, Q, 2)
    let mut repeats: i32 = 1
    let mut window: f64 = pgnb_window_ms(model, Q, repeats)
    while window < 10.0 && repeats < 1048576 {
        repeats = repeats * 2
        window = pgnb_window_ms(model, Q, repeats)
    }

    let per_call: ptr<f64> = array_new_f64(samples)
    let mut s: i32 = 0
    while s < samples {
        per_call[s] = pgnb_window_ms(model, Q, repeats) / (repeats as f64)
        s = s + 1
    }
    pgnb_sort(per_call, samples)
    let median: f64 = pgnb_percentile(per_call, samples, 0.5)
    let iqr: f64 = pgnb_percentile(per_call, samples, 0.75) - pgnb_percentile(per_call, samples, 0.25)

    let pred: ptr<f32> = gaussian_nb_predict(model, Q)
    let mut correct: i32 = 0
    let mut label_sum: i64 = 0
    let mut i: i32 = 0
    while i < n_query {
        if pred[i] == yq[i] { correct = correct + 1 }
        label_sum = label_sum + ((pred[i]) as i64)
        i = i + 1
    }

    printf("PREDICT|GaussianNB|%s|%d|%d|%d|%.9f|%.9f|%d|%d|%lld\n", axis, n_query, p, n_classes, median, iqr, repeats, correct, label_sum)

    if warm < 0.0 { printf("unreachable\n") }
    array_free_f32(pred)
    array_free_f64(per_call)
    gaussian_nb_free(model)
    matrix_free(Q)
    array_free_f32(yq)
    matrix_free(X)
    array_free_f32(y)
}

function main() -> i32 {
    printf("TIMING_UNIT|ms\n")
    printf("BENCHMARK_MODE|predict_only\n")
    printf("COLUMNS|estimator|axis|n_query|features|classes|median_ms|iqr_ms|repeats|correct|label_sum\n")

    # Batch size at the Digits shape: 64 features, 10 classes.
    pgnb_case("batch", 1, 64, 10)
    pgnb_case("batch", 10, 64, 10)
    pgnb_case("batch", 100, 64, 10)
    pgnb_case("batch", 360, 64, 10)
    pgnb_case("batch", 1000, 64, 10)
    pgnb_case("batch", 10000, 64, 10)

    # Feature count at 1000 queries and 10 classes.
    pgnb_case("features", 1000, 4, 10)
    pgnb_case("features", 1000, 8, 10)
    pgnb_case("features", 1000, 16, 10)
    pgnb_case("features", 1000, 32, 10)
    pgnb_case("features", 1000, 128, 10)
    pgnb_case("features", 1000, 256, 10)

    # Class count at 1000 queries and 64 features.
    pgnb_case("classes", 1000, 64, 2)
    pgnb_case("classes", 1000, 64, 3)
    pgnb_case("classes", 1000, 64, 5)
    pgnb_case("classes", 1000, 64, 20)
    pgnb_case("classes", 1000, 64, 50)
    return 0
}
