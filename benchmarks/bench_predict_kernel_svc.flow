# Prediction-only scaling benchmark for the one-vs-one RBF KernelSVC
# (issue #481).
#
# Times kernel_svc_multi_predict alone, with fit outside the timing window,
# along three axes: query batch size, training-set size and feature count. The
# training-set size is what moves the support-vector count, and each row
# reports the count the fit ended with. Every case is generated from integers
# on a dyadic grid, so bench_predict_kernel_svc.py builds bit-identical
# float32 inputs and the two sides can be joined row for row.
#
#   FLOW_OPT_LEVEL=3 flow run benchmarks/bench_predict_kernel_svc.flow > flow_predict_ksvc.txt
#   python benchmarks/bench_predict_kernel_svc.py --flow flow_predict_ksvc.txt
#
# Each sample is an aggregate window of at least 10 ms, repeated 7 times after
# 2 warmups, and the reported latency is the per-call median, the same scheme
# as benchmarks/timing.py.

import "lib/scikit/scikit.flow"

extern {
    function printf(fmt: string, ...) -> i32
    function flow_now_ns() -> i64
}

function pksvc_raw(i: i32, j: i32, cls: i32) -> i32 {
    return ((i * 37 + j * 19 + cls * 7) % 128) + cls * (8 + ((j * 5) % 7) * 2)
}

function pksvc_fill(X: Matrix, y: ptr<f32>, first_row: i32, n_classes: i32) -> void {
    let p: i32 = X.cols
    let mut i: i32 = 0
    while i < X.rows {
        let src: i32 = first_row + i
        let cls: i32 = src % n_classes
        y[i] = cls as f32
        let row: ptr<f32> = X.data + i * p
        let mut j: i32 = 0
        while j < p {
            row[j] = ((pksvc_raw(src, j, cls)) as f32) / 64.0
            j = j + 1
        }
        i = i + 1
    }
}

function pksvc_sort(v: ptr<f64>, n: i32) -> void {
    let mut i: i32 = 1
    while i < n {
        let key: f64 = v[i]
        let mut j: i32 = i - 1
        while j >= 0 && v[j] > key {
            v[j + 1] = v[j]
            j = j - 1
        }
        v[j + 1] = key
        i = i + 1
    }
}

function pksvc_percentile(sorted: ptr<f64>, n: i32, q: f64) -> f64 {
    let pos: f64 = ((n - 1) as f64) * q
    let lo: i32 = pos as i32
    let mut hi: i32 = lo + 1
    if hi > n - 1 { hi = n - 1 }
    let frac: f64 = pos - (lo as f64)
    return sorted[lo] * (1.0 - frac) + sorted[hi] * frac
}

function pksvc_window_ms(model: KernelSVCMulti, Q: Matrix, repeats: i32) -> f64 {
    let t0: i64 = flow_now_ns()
    let mut k: i32 = 0
    while k < repeats {
        let pred: ptr<f32> = kernel_svc_multi_predict(model, Q)
        array_free_f32(pred)
        k = k + 1
    }
    let t1: i64 = flow_now_ns()
    return ((t1 - t0) as f64) / 1000000.0
}

function pksvc_case(axis: string, n_query: i32, n_train: i32, p: i32) -> void {
    let n_classes: i32 = 3
    let samples: i32 = 7
    let X: Matrix = matrix_new(n_train, p)
    let y: ptr<f32> = array_new_f32(n_train)
    pksvc_fill(X, y, 0, n_classes)
    let Q: Matrix = matrix_new(n_query, p)
    let yq: ptr<f32> = array_new_f32(n_query)
    pksvc_fill(Q, yq, n_train, n_classes)

    # gamma = 1 / n_features, exact in f32 for the power-of-two widths used.
    let gamma: f32 = 1.0 / (p as f32)
    let model: KernelSVCMulti = kernel_svc_multi_fit(X, y, n_classes, gamma, 1.0, 1000)

    let warm: f64 = pksvc_window_ms(model, Q, 2)
    let mut repeats: i32 = 1
    let mut window: f64 = pksvc_window_ms(model, Q, repeats)
    while window < 10.0 && repeats < 1048576 {
        repeats = repeats * 2
        window = pksvc_window_ms(model, Q, repeats)
    }

    let per_call: ptr<f64> = array_new_f64(samples)
    let mut s: i32 = 0
    while s < samples {
        per_call[s] = pksvc_window_ms(model, Q, repeats) / (repeats as f64)
        s = s + 1
    }
    pksvc_sort(per_call, samples)
    let median: f64 = pksvc_percentile(per_call, samples, 0.5)
    let iqr: f64 = pksvc_percentile(per_call, samples, 0.75) - pksvc_percentile(per_call, samples, 0.25)

    let pred: ptr<f32> = kernel_svc_multi_predict(model, Q)
    let mut correct: i32 = 0
    let mut i: i32 = 0
    while i < n_query {
        if pred[i] == yq[i] { correct = correct + 1 }
        i = i + 1
    }

    printf("PREDICT|KernelSVC_RBF|%s|%d|%d|%d|%.9f|%.9f|%d|%d|%d\n", axis, n_query, n_train, p, median, iqr, repeats, model.n_sv, correct)

    if warm < 0.0 { printf("unreachable\n") }
    array_free_f32(pred)
    array_free_f64(per_call)
    kernel_svc_multi_free(model)
    matrix_free(Q)
    array_free_f32(yq)
    matrix_free(X)
    array_free_f32(y)
}

function main() -> i32 {
    printf("TIMING_UNIT|ms\n")
    printf("BENCHMARK_MODE|predict_only\n")
    printf("COLUMNS|estimator|axis|n_query|n_train|features|median_ms|iqr_ms|repeats|n_support|correct\n")

    # Batch size at 300 training rows and 16 features.
    pksvc_case("batch", 1, 300, 16)
    pksvc_case("batch", 10, 300, 16)
    pksvc_case("batch", 100, 300, 16)
    pksvc_case("batch", 1000, 300, 16)
    pksvc_case("batch", 10000, 300, 16)

    # Training-set size, which sets the support-vector count, at 1000 queries
    # and 16 features.
    pksvc_case("train", 1000, 60, 16)
    pksvc_case("train", 1000, 120, 16)
    pksvc_case("train", 1000, 1000, 16)

    # Feature count at 1000 queries and 300 training rows.
    pksvc_case("features", 1000, 300, 4)
    pksvc_case("features", 1000, 300, 64)
    pksvc_case("features", 1000, 300, 256)
    return 0
}
