import "lib/scikit/scikit.flow"

extern {
    function malloc(size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function clock() -> i64
    function printf(fmt: string, ...) -> i32
}

# Per-algorithm parity benchmark: scikit-learn (Flow) side.
# Uses the same deterministic split as bench_per_algorithm.py:
# first 80% train, last 20% test, no shuffle.
# Outputs JSON with algorithm name, output values, and timing.

function fixed_split(X: Matrix, y: ptr<f32>, test_frac: f32) -> TrainTestSplit {
    let n: i32 = X.rows
    let nf: i32 = X.cols
    let n_test: i32 = ((n as f32) * test_frac) as i32
    let n_train: i32 = n - n_test

    let X_train: Matrix = matrix_new(n_train, nf)
    let X_test: Matrix = matrix_new(n_test, nf)
    let y_train: ptr<f32> = array_new_f32(n_train)
    let y_test: ptr<f32> = array_new_f32(n_test)

    for i in 0 to n_train {
        for j in 0 to nf {
            matrix_set(X_train, i, j, matrix_at(X, i, j))
        }
        y_train[i] = y[i]
    }

    for i in 0 to n_test {
        for j in 0 to nf {
            matrix_set(X_test, i, j, matrix_at(X, i + n_train, j))
        }
        y_test[i] = y[i + n_train]
    }

    return TrainTestSplit {
        X_train: X_train,
        X_test: X_test,
        y_train: y_train,
        y_test: y_test,
        n_train: n_train,
        n_test: n_test
    }
}

function elapsed_ms(t0: i64, t1: i64) -> f32 {
    return ((t1 - t0) as f32) / 1000.0
}

function print_array(arr: ptr<f32>, n: i32) -> void {
    printf("[")
    for i in 0 to n {
        if i > 0 {
            printf(", ")
        }
        printf("%.6f", arr[i])
    }
    printf("]")
}

function print_matrix_flat(m: Matrix) -> void {
    let total: i32 = m.rows * m.cols
    printf("[")
    for i in 0 to total {
        if i > 0 {
            printf(", ")
        }
        let r: i32 = i / m.cols
        let c: i32 = i % m.cols
        printf("%.6f", matrix_at(m, r, c))
    }
    printf("]")
}

function print_result(name: string, output: ptr<f32>, n: i32, fit_ms: f32, pred_ms: f32) -> void {
    printf("  {\n")
    printf("    \"algorithm\": \"%s\",\n", name)
    printf("    \"output\": ")
    print_array(output, n)
    printf(",\n")
    printf("    \"fit_ms\": %.4f,\n", fit_ms)
    printf("    \"pred_ms\": %.4f,\n", pred_ms)
    printf("    \"total_ms\": %.4f\n", fit_ms + pred_ms)
    printf("  }")
}

function print_result_matrix(name: string, output: Matrix, fit_ms: f32, pred_ms: f32) -> void {
    printf("  {\n")
    printf("    \"algorithm\": \"%s\",\n", name)
    printf("    \"output\": ")
    print_matrix_flat(output)
    printf(",\n")
    printf("    \"fit_ms\": %.4f,\n", fit_ms)
    printf("    \"pred_ms\": %.4f,\n", pred_ms)
    printf("    \"total_ms\": %.4f\n", fit_ms + pred_ms)
    printf("  }")
}

function main() -> i32 {
    let iris: Dataset = load_iris()
    let diabetes: Dataset = load_diabetes()

    let split_i: TrainTestSplit = fixed_split(iris.X, iris.y, 0.2)
    let split_d: TrainTestSplit = fixed_split(diabetes.X, diabetes.y, 0.2)

    let X_tr_i: Matrix = split_i.X_train
    let X_te_i: Matrix = split_i.X_test
    let y_tr_i: ptr<f32> = split_i.y_train
    let y_te_i: ptr<f32> = split_i.y_test
    let n_te_i: i32 = split_i.n_test

    let X_tr_d: Matrix = split_d.X_train
    let X_te_d: Matrix = split_d.X_test
    let y_tr_d: ptr<f32> = split_d.y_train
    let n_te_d: i32 = split_d.n_test

    let t0: i64 = 0
    let t1: i64 = 0
    let fit_ms: f32 = 0.0
    let pred_ms: f32 = 0.0

    printf("[\n")

    # ---- StandardScaler ----
    t0 = clock()
    let scaler1: StandardScaler = standard_scaler_fit(X_tr_i)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out1: Matrix = standard_scaler_transform(scaler1, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result_matrix("StandardScaler", out1, fit_ms, pred_ms)
    printf(",\n")
    matrix_free(out1)

    # ---- MinMaxScaler ----
    t0 = clock()
    let scaler2: MinMaxScaler = minmax_scaler_fit(X_tr_i)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out2: Matrix = minmax_scaler_transform(scaler2, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result_matrix("MinMaxScaler", out2, fit_ms, pred_ms)
    printf(",\n")
    matrix_free(out2)

    # ---- MaxAbsScaler ----
    t0 = clock()
    let scaler3: MaxAbsScaler = maxabs_scaler_fit(X_tr_i)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out3: Matrix = maxabs_scaler_transform(scaler3, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result_matrix("MaxAbsScaler", out3, fit_ms, pred_ms)
    printf(",\n")
    matrix_free(out3)

    # ---- GaussianNB ----
    t0 = clock()
    let gnb: GaussianNB = gaussian_nb_fit(X_tr_i, y_tr_i, 3, 0.000000001)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out4: ptr<f32> = gaussian_nb_predict(gnb, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("GaussianNB", out4, n_te_i, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out4)
    gaussian_nb_free(gnb)

    # ---- KNNClassifier k=5 ----
    t0 = clock()
    let knn5: KNNClassifier = knn_classifier_fit(X_tr_i, y_tr_i, 3, 5)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out5m: Matrix = knn_classifier_predict(knn5, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    # Extract predicted labels from the probability matrix (argmax per row)
    let out5: ptr<f32> = array_new_f32(n_te_i)
    for i in 0 to n_te_i {
        let mut best_j: i32 = 0
        let mut best_v: f32 = matrix_at(out5m, i, 0)
        for j in 1 to 3 {
            let v: f32 = matrix_at(out5m, i, j)
            if v > best_v {
                best_v = v
                best_j = j
            }
        }
        out5[i] = (best_j as f32)
    }
    print_result("KNNClassifier_k5", out5, n_te_i, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out5)
    matrix_free(out5m)
    knn_classifier_free(knn5)

    # ---- KNNRegressor k=3 ----
    t0 = clock()
    let knn3r: KNNRegressor = knn_regressor_fit(X_tr_d, y_tr_d, 3)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out6: ptr<f32> = knn_regressor_predict(knn3r, X_te_d)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("KNNRegressor_k3", out6, n_te_d, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out6)
    knn_regressor_free(knn3r)

    # ---- NearestCentroid ----
    t0 = clock()
    let nc: NearestCentroid = nearest_centroid_fit(X_tr_i, y_tr_i, 3)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out7: ptr<f32> = nearest_centroid_predict(nc, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("NearestCentroid", out7, n_te_i, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out7)
    nearest_centroid_free(nc)

    # ---- LinearRegression ----
    let no_penalty: Penalty = penalty_none()
    t0 = clock()
    let lr: LinearRegression = linear_regression_fit(X_tr_d, y_tr_d, no_penalty)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out8: ptr<f32> = linear_regression_predict(lr, X_te_d)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("LinearRegression", out8, n_te_d, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out8)
    linear_regression_free(lr)

    # ---- Ridge alpha=1.0 ----
    t0 = clock()
    let ridge: Ridge = ridge_fit(X_tr_d, y_tr_d, 1.0, 1000, 0.01)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out9: ptr<f32> = ridge_predict(ridge, X_te_d)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("Ridge_a1", out9, n_te_d, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out9)
    ridge_free(ridge)

    # ---- Lasso alpha=0.1 ----
    t0 = clock()
    let lasso: Lasso = lasso_fit(X_tr_d, y_tr_d, 0.1, 5000, 0.01)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out10: ptr<f32> = lasso_predict(lasso, X_te_d)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("Lasso_a0.1", out10, n_te_d, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out10)
    lasso_free(lasso)

    # ---- DummyClassifier most_frequent ----
    t0 = clock()
    let dc: DummyClassifier = dummy_classifier_fit(y_tr_i, split_i.n_train, 3, DUMMY_STRATEGY_MOST_FREQUENT, 0.0, 42)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out11: ptr<f32> = dummy_classifier_predict(dc, n_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("DummyClassifier_most_frequent", out11, n_te_i, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out11)
    dummy_classifier_free(dc)

    # ---- DummyRegressor mean ----
    t0 = clock()
    let dr: DummyRegressor = dummy_regressor_fit(y_tr_d, split_d.n_train, 0, 0.0)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out12: ptr<f32> = dummy_regressor_predict(dr, n_te_d)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("DummyRegressor_mean", out12, n_te_d, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out12)
    dummy_regressor_free(dr)

    # ---- PCA 2 components ----
    t0 = clock()
    let pca: PCA = pca_fit(X_tr_i, 2)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out13: Matrix = pca_transform(pca, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result_matrix("PCA_2comp", out13, fit_ms, pred_ms)
    printf(",\n")
    matrix_free(out13)
    pca_free(pca)

    # ---- KMeans k=3 fixed init ----
    # Use first 3 training samples as init centers (matches sklearn init=array)
    let init_centers: Matrix = matrix_new(3, 4)
    for k in 0 to 3 {
        for j in 0 to 4 {
            matrix_set(init_centers, k, j, matrix_at(X_tr_i, k, j))
        }
    }
    t0 = clock()
    let km: KMeans = kmeans_fit_init(X_tr_i, init_centers, 3, 100, 0.000001)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out14i: ptr<i32> = kmeans_predict(km, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    let out14: ptr<f32> = array_new_f32(n_te_i)
    for i in 0 to n_te_i {
        out14[i] = (out14i[i] as f32)
    }
    print_result("KMeans_k3_fixed_init", out14, n_te_i, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out14)
    free(out14i as ptr<void>)
    kmeans_free(km)

    # ---- LDA ----
    t0 = clock()
    let lda: LinearDiscriminantAnalysis = discriminant_lda_fit(X_tr_i, y_tr_i, 3)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out15: ptr<f32> = discriminant_lda_predict(lda, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("LDA", out15, n_te_i, fit_ms, pred_ms)
    printf(",\n")
    array_free_f32(out15)
    discriminant_lda_free(lda)

    # ---- QDA ----
    t0 = clock()
    let qda: QuadraticDiscriminantAnalysis = qda_fit(X_tr_i, y_tr_i, 3)
    t1 = clock()
    fit_ms = elapsed_ms(t0, t1)
    t0 = clock()
    let out16: ptr<f32> = qda_predict(qda, X_te_i)
    t1 = clock()
    pred_ms = elapsed_ms(t0, t1)
    print_result("QDA", out16, n_te_i, fit_ms, pred_ms)
    printf("\n")
    array_free_f32(out16)
    qda_free(qda)

    printf("]\n")

    # Free splits
    matrix_free(split_i.X_train)
    matrix_free(split_i.X_test)
    array_free_f32(split_i.y_train)
    array_free_f32(split_i.y_test)
    matrix_free(split_d.X_train)
    matrix_free(split_d.X_test)
    array_free_f32(split_d.y_train)
    array_free_f32(split_d.y_test)
    dataset_free(iris)
    dataset_free(diabetes)

    return 0
}
