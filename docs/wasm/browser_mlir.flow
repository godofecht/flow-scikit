# Browser ABI facade for the Flow -> MLIR -> WebAssembly path.
#
# These entry points intentionally call the real flow-scikit metric
# implementations. They require no allocation, which makes them suitable for
# the first freestanding wasm32 milestone while the browser allocator/runtime
# is being brought across.

import "lib/scikit/metrics.flow"

export function browser_accuracy(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32) -> f32 {
    return accuracy_score(y_true, y_pred, n)
}

export function browser_precision(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    return precision_score(y_true, y_pred, n, pos_label)
}

export function browser_recall(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    return recall_score(y_true, y_pred, n, pos_label)
}

export function browser_f1(y_true: ptr<f32>, y_pred: ptr<f32>, n: i32, pos_label: f32) -> f32 {
    return f1_score(y_true, y_pred, n, pos_label)
}

function main() -> i32 {
    return 0
}
