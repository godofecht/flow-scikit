# Distance kernel for the browser MNIST demo.
# The browser loads ten centroids trained from the real MNIST training set,
# then calls this Flow-built WASM function once per digit class.

export function mnist_squared_distance(input: ptr<f32>, prototype: ptr<f32>, n: i32) -> f32 {
    let mut total: f32 = 0.0
    for i in 0 to n {
        let delta: f32 = input[i] - prototype[i]
        total = total + delta * delta
    }
    return total
}

# Small transparent scoring kernels for the browser experiment lab.
export function home_price_estimate(area_m2: f32, rooms: f32, age_years: f32) -> f32 {
    return 85000.0 + area_m2 * 3100.0 + rooms * 18000.0 - age_years * 420.0
}

export function payment_risk(utilisation: f32, late_payments: f32, debt_ratio: f32) -> f32 {
    let mut score: f32 = utilisation * 0.42 + late_payments * 12.0 + debt_ratio * 0.46
    if score > 100.0 { score = 100.0 }
    return score
}

export function standardise_value(value: f32, mean: f32, stddev: f32) -> f32 {
    if stddev < 0.001 { return 0.0 }
    return (value - mean) / stddev
}

export function absolute_z_score(value: f32, mean: f32, stddev: f32) -> f32 {
    let mut z: f32 = standardise_value(value, mean, stddev)
    if z < 0.0 { z = 0.0 - z }
    return z
}

export function point_distance(x: f32, y: f32, center_x: f32, center_y: f32) -> f32 {
    let dx: f32 = x - center_x
    let dy: f32 = y - center_y
    return dx * dx + dy * dy
}

function main() -> i32 {
    println("flow-scikit digit demo ready")
    return 0
}
